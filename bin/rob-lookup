#!/bin/bash
# rob-lookup — Linear 이슈 통합 조회 (active + soft-archived + Obsidian 아카이브)
#
# 사용:
#   rob-lookup ROB-1234            # ID 조회: Linear API(삭제분 포함) + Obsidian 아카이브 섹션
#   rob-lookup --search "키워드"    # 내용 검색: Obsidian 아카이브 전문 grep (Linear 내용검색은 삭제분 불가)
#   rob-lookup --count             # 현재 active 이슈 수 (쿼타 미터, 상한 275)
#
# 배경: issueDelete는 soft-archive라 ID 조회는 API로 영구 가능하지만 내용 검색은 불가.
#       full-context 검색은 Obsidian linear-archive가 담당. 이 도구가 두 소스를 묶는다.
set -u

# 아카이브 vault 경로는 기기마다 다르다. ROB_VAULT 로 주입하고, 없으면 조회는
# Linear API 만으로 계속 동작한다(전문 검색만 불가) — 다른 맥북에서 죽지 않게 한다.
VAULT="${ROB_VAULT:-}"
KEY_FILE="${LINEAR_API_KEY_FILE:-$HOME/.config/linear/api-key}"
API="https://api.linear.app/graphql"

gql() {  # $1 = query json
  curl -s -H "Authorization: $(cat "$KEY_FILE")" -H "Content-Type: application/json" -d "$1" "$API"
}

case "${1:-}" in
  --count)
    gql '{"query":"{ teams { nodes { name issueCount } } }"}' | python3 -c '
import json,sys
d=json.load(sys.stdin)["data"]["teams"]["nodes"]
total=sum(t["issueCount"] for t in d)
for t in d:
    name=t["name"]; cnt=t["issueCount"]
    print(f"  {name}: {cnt}")
print(f"TOTAL {total}/275 ({total*100//275}%)")'
    exit 0
    ;;
  --search)
    TERM="${2:?검색어 필요}"
    [ -n "$VAULT" ] || { echo "rob-lookup: 전문 검색에는 ROB_VAULT 가 필요하다 (아카이브 vault 경로)" >&2; exit 2; }
    echo "== Obsidian 아카이브 검색: '$TERM' =="
    grep -rin --include="*.md" -l "$TERM" "$VAULT" 2>/dev/null | sort | while read -r f; do
      echo "--- ${f#$VAULT/}"
      grep -in "$TERM" "$f" | head -5 | sed 's/^/  /'
    done
    echo
    echo "(참고: Linear 내용검색은 active 이슈만 가능 — 삭제분은 위 아카이브가 유일한 검색 소스)"
    exit 0
    ;;
  ROB-*)
    ID="$1"
    ;;
  *)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac

echo "== Linear API ($ID — soft-archived 포함) =="
gql "{\"query\":\"{ issue(id: \\\"$ID\\\") { identifier title url archivedAt completedAt state { name } parent { identifier } children { nodes { identifier } } description } }\"}" | python3 -c '
import json,sys
d=json.load(sys.stdin)
iss=(d.get("data") or {}).get("issue")
if not iss:
    print("  (Linear에 없음 — 30일+ 경과 purge 가능성. Obsidian 아카이브 확인 ↓)"); sys.exit(0)
ident=iss["identifier"]; title=iss["title"]; state=iss["state"]["name"]
arch=iss["archivedAt"] or "-"; comp=iss["completedAt"] or "-"
print(f"  {ident} — {title}")
print(f"  state: {state}  archived: {arch}  completed: {comp}")
if iss.get("parent"):
    p=iss["parent"]["identifier"]; print(f"  parent: {p}")
ch=" ".join(c["identifier"] for c in iss["children"]["nodes"])
if ch: print(f"  children: {ch}")
url=iss["url"]; print(f"  url: {url}")
desc=(iss.get("description") or "").strip()
if desc:
    lines=desc.splitlines()
    print("  --- description (첫 30줄) ---")
    for line in lines[:30]: print(f"  {line}")
    if len(lines)>30: print(f"  ... (+{len(lines)-30}줄 — 전문은 Obsidian 아카이브/Linear)")'

echo
if [ -z "$VAULT" ]; then
  echo "== Obsidian 아카이브 =="
  echo "  (건너뜀 — ROB_VAULT 미설정. Linear API 조회는 위에서 이미 끝났다)"
  exit 0
fi
echo "== Obsidian 아카이브 =="
# 1) 이슈당 개별 파일
for f in "$VAULT"/issues/${ID}-*.md; do
  [ -f "$f" ] && { echo "--- (개별 파일) ${f#$VAULT/}"; cat "$f"; }
done
# 2) 배치 파일 섹션 (최신 배치 우선 — 중복 수록 시 최신이 정본)
FILES=$(grep -l "^#\{2,3\} ${ID}\( \|:\|$\|.—\)\|^#\{2,3\} ${ID} —" "$VAULT"/*.md 2>/dev/null | sort -r)
if [ -z "$FILES" ]; then
  FILES=$(grep -l "^#\{2,3\}.*\b${ID}\b" "$VAULT"/*.md 2>/dev/null | sort -r)
fi
if [ -z "$FILES" ]; then
  echo "  (아카이브 배치에 섹션 없음 — recent-hold 구간이거나 미아카이브)"
else
  LATEST=$(echo "$FILES" | head -1)
  echo "--- (배치 섹션, 최신) ${LATEST#$VAULT/}"
  awk -v id="$ID" '
    $0 ~ "^#{2,3} ([0-9]+\\. )?" id "([ :—-]|$)" {p=1; print; next}
    p && /^#{2,3} ([0-9]+\. )?ROB-[0-9]+/ {exit}
    p {print}' "$LATEST"
  OTHERS=$(echo "$FILES" | tail -n +2)
  [ -n "$OTHERS" ] && { echo; echo "  (이전 배치에도 수록: $(echo "$OTHERS" | xargs -n1 basename | tr '\n' ' '))"; }
fi
