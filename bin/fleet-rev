#!/usr/bin/env python3
"""fleet-rev — read-only fleet install check.

Probes the installed commit of scopefuel, agent-skills, panewire and
handoffkeep on this machine plus every active [hosts.NAME] table in
${WRK_HOSTS_CONFIG:-~/.config/wrk/hosts.toml} and compares each against that
repo's main on GitHub (org mgh3326).  The script never installs, restarts or
writes anything: remote hosts get one fixed POSIX sh probe over
`ssh -o BatchMode=yes -o ConnectTimeout=10 -- ALIAS sh -s` and the probe prints
only key=value lines.

exit code
  0  every probed cell is current
  1  at least one cell is behind or diverged
  2  usage or config error
  3  no stale cell, but at least one cell is unknown, absent or unreachable
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys

PROG = "fleet-rev"
ORG = "mgh3326"
TOOLS = ("scopefuel", "agent-skills", "panewire", "handoffkeep")

EXIT_OK = 0
EXIT_STALE = 1
EXIT_USAGE = 2
EXIT_UNKNOWN = 3

# The remote probe. POSIX sh on purpose: it must run under the remote `sh -s`
# exactly like it runs locally. It prints only key=value lines and reads
# nothing besides the uv receipt, the agent-skills git checkout and the tool
# binaries on PATH. Every tool call goes through run_tool's watchdog so a
# hung version command — even a shell wrapper's process tree — reads
# `unknown` with `tool timed out` while the other tools on that host still
# report, and a whole-probe budget keeps the worst case inside the host
# timeout.
PROBE = r"""
PATH="$HOME/.local/bin:$HOME/go/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH
GIT_OPTIONAL_LOCKS=0
export GIT_OPTIONAL_LOCKS
TOOL_T=3
KILL_GRACE=1
# Whole-probe budget: the sum of every tool call must stay inside the
# host timeout however many calls the probe grows, so each call gets the
# smaller of TOOL_T and the budget still left (KILL_GRACE + 1s reserved
# to reap). A call that cannot start in time is skipped and its cell
# reads unknown with 'probe budget spent'. Worst case stays at
# ~PROBE_BUDGET + KILL_GRACE seconds of tool time, under the default 30s
# host timeout.
PROBE_BUDGET=21
_pb_now=$(date +%s 2>/dev/null || printf '0')
case "$_pb_now" in ''|*[!0-9]*) _pb_now=0 ;; esac
PROBE_DEADLINE=0
if [ "$_pb_now" -gt 0 ]; then PROBE_DEADLINE=$((_pb_now + PROBE_BUDGET)); fi

# descendants PID — every pid below PID, deepest first (a recursive
# pgrep -P walk). With no pgrep the walk is empty and only the direct
# child gets signalled.
descendants() {
  for _d in $(pgrep -P "$1" 2>/dev/null); do
    descendants "$_d"
    printf '%s\n' "$_d"
  done
}

# next_tool_bound — seconds the next tool call may run: TOOL_T, or less
# when the whole-probe budget is nearly spent, or 0 when it is gone. A
# dead clock degrades to the per-tool bound on its own.
next_tool_bound() {
  _nb_now=$(date +%s 2>/dev/null || printf '0')
  case "$_nb_now" in ''|*[!0-9]*) _nb_now=0 ;; esac
  if [ "$PROBE_DEADLINE" -eq 0 ] || [ "$_nb_now" -eq 0 ]; then
    printf '%s\n' "$TOOL_T"
    return
  fi
  _nb_left=$((PROBE_DEADLINE - _nb_now - KILL_GRACE - 1))
  if [ "$_nb_left" -gt "$TOOL_T" ]; then _nb_left=$TOOL_T; fi
  if [ "$_nb_left" -lt 0 ]; then _nb_left=0; fi
  printf '%s\n' "$_nb_left"
}

# budget_unknown TOOL — a tool skipped because the probe budget ran out.
budget_unknown() {
  printf '%s.installed=unknown\n' "$1"
  printf '%s.error=probe budget spent\n' "$1"
}

# run_tool SECONDS CMD... — per-tool bound, portable (POSIX sh, no GNU
# timeout, no setsid) and no temp files. CMD runs as a background job
# with stdin /dev/null. A watchdog subshell sleeps the bound, walks the
# tree while the direct child still lives to pin its descendants, then
# SIGTERMs the child and the listed pids and SIGKILLs them KILL_GRACE
# seconds later; a wrapper's grandchild stays on the saved pid list even
# after the wrapper died and reparented it. A second subshell snapshots
# the tree every second while the child lives (a dead pid has no listed
# children, so once the child exits the saved list is all there is);
# SIGUSR1 wakes it to SIGKILL the last-seen descendants and exit, so a
# grandchild orphaned by a finished wrapper cannot keep the caller's
# output pipe open (the snapshot is at most a second stale — a child
# spawned and detached in that gap is the residual, as is a pid freed
# and reused inside it).
# Both helpers' fds go to /dev/null so neither they nor their sleeps can
# hold the caller's output pipe open. (A separate process group would
# cover all of this, but a non-interactive sh without a tty refuses
# set -m, and command substitution disables it even where one exists.)
# When CMD finishes first the watchdog and its in-flight sleep are
# killed (pgrep -P finds the sleep; without pgrep it exits on its own
# within the bound), the sweeper is woken to do its last kill, then wait
# reaps everything. rc 124 means the watchdog killed the tool (timed
# out); a command killed by one of those signals for another reason
# reports the same, still "not readable".
run_tool() {
  _rt_t=$1; shift
  "$@" </dev/null &
  _rt_p=$!
  ( sleep "$_rt_t"
    _rt_k=$(descendants "$_rt_p")
    kill -TERM "$_rt_p" $_rt_k 2>/dev/null
    sleep "$KILL_GRACE"
    kill -KILL "$_rt_p" $_rt_k $(descendants "$_rt_p") 2>/dev/null ) </dev/null >/dev/null 2>&1 &
  _rt_w=$!
  ( _rt_k=
    _rt_nap=
    trap 'kill -KILL $_rt_k $_rt_nap 2>/dev/null; exit' USR1
    while kill -0 "$_rt_p" 2>/dev/null; do
      _rt_k=$(descendants "$_rt_p")
      sleep 1 &
      _rt_nap=$!
      wait "$_rt_nap" 2>/dev/null
    done
    kill -KILL $_rt_k 2>/dev/null ) </dev/null >/dev/null 2>&1 &
  _rt_s=$!
  wait "$_rt_p" 2>/dev/null
  _rt_rc=$?
  _rt_c=$(pgrep -P "$_rt_w" 2>/dev/null || true)
  kill -KILL "$_rt_w" $_rt_c 2>/dev/null
  wait "$_rt_w" 2>/dev/null
  # wake the sweeper for its last kill; it exits right after (untrapped
  # USR1 would kill it anyway) so this wait is bounded.
  kill -USR1 "$_rt_s" 2>/dev/null
  wait "$_rt_s" 2>/dev/null
  if [ "$_rt_rc" -eq 143 ] || [ "$_rt_rc" -eq 137 ]; then _rt_rc=124; fi
  return "$_rt_rc"
}

f="$HOME/.local/share/uv/tools/scopefuel/uv-receipt.toml"
if [ -f "$f" ]; then
  v=$(sed -n 's/.*name = "scopefuel"[^}]*scopefuel?rev=\([^" }]*\).*/\1/p' "$f" | sed -n '1p' | tr '[:upper:]' '[:lower:]')
  if [ -n "$v" ]; then printf 'scopefuel.installed=%s\n' "$v"; else printf 'scopefuel.installed=unknown\n'; fi
else
  printf 'scopefuel.installed=absent\n'
fi
printf 'scopefuel.source=receipt\n'

d="$HOME/.agents/skills"
if [ -d "$d" ]; then
  _b=$(next_tool_bound)
  if [ "$_b" -gt 0 ]; then
    v=$(run_tool "$_b" git -C "$d" rev-parse HEAD 2>/dev/null)
    vrc=$?
  else
    v=
    vrc=125
  fi
  if [ "$vrc" -eq 124 ]; then
    printf 'agent-skills.installed=unknown\n'
    printf 'agent-skills.error=tool timed out\n'
  elif [ "$vrc" -eq 125 ]; then
    budget_unknown agent-skills
  elif [ -n "$v" ]; then
    printf 'agent-skills.installed=%s\n' "$v"
    _b=$(next_tool_bound)
    if [ "$_b" -gt 0 ]; then
      s=$(run_tool "$_b" git -C "$d" status --porcelain 2>/dev/null)
      src=$?
    else
      s=
      src=125
    fi
    if [ "$src" -eq 0 ]; then
      printf 'agent-skills.dirty=%s\n' "$(printf '%s\n' "$s" | grep -c .)"
    elif [ "$src" -eq 124 ]; then
      printf 'agent-skills.error=tool timed out\n'
    elif [ "$src" -eq 125 ]; then
      printf 'agent-skills.error=probe budget spent\n'
    fi
  else
    printf 'agent-skills.installed=unknown\n'
  fi
else
  printf 'agent-skills.installed=absent\n'
fi
printf 'agent-skills.source=git\n'

if command -v panewire >/dev/null 2>&1; then
  _b=$(next_tool_bound)
  if [ "$_b" -gt 0 ]; then
    v=$(run_tool "$_b" panewire version 2>/dev/null)
    vrc=$?
  else
    v=
    vrc=125
  fi
  if [ "$vrc" -eq 124 ]; then
    printf 'panewire.installed=unknown\n'
    printf 'panewire.error=tool timed out\n'
  elif [ "$vrc" -eq 125 ]; then
    budget_unknown panewire
  else
    v=$(printf '%s\n' "$v" | sed -n '1p')
    case "$v" in
      pw-*)
        r=${v#pw-}
        r=${r%% *}
        if [ -n "$r" ]; then printf 'panewire.installed=%s\n' "$r"; else printf 'panewire.installed=unknown\n'; fi ;;
      *) printf 'panewire.installed=unknown\n' ;;
    esac
  fi
else
  printf 'panewire.installed=absent\n'
fi
printf 'panewire.source=version-cmd\n'

if command -v handoffkeep >/dev/null 2>&1; then
  _b=$(next_tool_bound)
  if [ "$_b" -gt 0 ]; then
    j=$(run_tool "$_b" handoffkeep version --json 2>/dev/null)
    jrc=$?
  else
    j=
    jrc=125
  fi
  if [ "$jrc" -eq 0 ]; then
    printf 'handoffkeep.source=version-cmd\n'
    printf 'handoffkeep.json=%s\n' "$(printf '%s' "$j" | sed -n '1p')"
  else
    if [ "$jrc" -eq 124 ]; then printf 'handoffkeep.error=tool timed out\n'; fi
    if [ "$jrc" -eq 125 ]; then printf 'handoffkeep.error=probe budget spent\n'; fi
    _b=$(next_tool_bound)
    if [ "$_b" -gt 0 ]; then
      o=$(run_tool "$_b" go version -m "$(command -v handoffkeep)" 2>/dev/null)
      orc=$?
    else
      o=
      orc=125
    fi
    if [ "$orc" -eq 124 ]; then printf 'handoffkeep.error=tool timed out\n'; fi
    if [ "$orc" -eq 125 ]; then printf 'handoffkeep.error=probe budget spent\n'; fi
    v=$(printf '%s\n' "$o" | sed -n 's/.*vcs\.revision=\([^ ]*\).*/\1/p' | sed -n '1p')
    m=$(printf '%s\n' "$o" | sed -n 's/.*vcs\.modified=\([^ ]*\).*/\1/p' | sed -n '1p')
    if [ -n "$v" ]; then
      printf 'handoffkeep.installed=%s\n' "$v"
      printf 'handoffkeep.source=go-buildinfo\n'
    else
      printf 'handoffkeep.installed=unknown\n'
      printf 'handoffkeep.source=none\n'
    fi
    printf 'handoffkeep.modified=%s\n' "${m:-false}"
  fi
else
  printf 'handoffkeep.installed=absent\n'
  printf 'handoffkeep.source=none\n'
  printf 'handoffkeep.modified=false\n'
fi
"""

HOSTS_HEADER = re.compile(r"^\[hosts\.([A-Za-z0-9_-]+)\]$")
ANY_HEADER = re.compile(r"^\[([^]]+)\]$")
SSH_KEY = re.compile(r"^ssh[ \t]*=[ \t]*(.*)$")
NAME_RE = re.compile(r"^[A-Za-z0-9_-]+$")
# An installed rev must look like a git commit prefix: at least 7 lowercase
# hex (the panewire pw- form is 7), at most a full sha.
VALID_INSTALLED = re.compile(r"[0-9a-f]{7,40}")
HK_REV40 = re.compile(r"[0-9a-f]{40}")
HK_MODIFIED_VALUES = ("true", "false", "unknown")


def parse_handoffkeep_json(raw: str) -> tuple[str, str] | None:
    """Validate the `handoffkeep version --json` line (#958 contract: every
    field is a JSON string). Returns (rev, modified) or None when the output
    is not an object whose rev is 40 lowercase hex or the literal 'unknown'
    and whose modified is one of 'true', 'false', 'unknown'."""
    try:
        obj = json.loads(raw)
    except (ValueError, TypeError):
        return None
    if not isinstance(obj, dict):
        return None
    rev = obj.get("rev")
    modified = obj.get("modified")
    if not (
        isinstance(rev, str) and (rev == "unknown" or HK_REV40.fullmatch(rev))
    ):
        return None
    if modified not in HK_MODIFIED_VALUES:
        return None
    return rev, modified


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def hosts_config_path() -> str:
    override = os.environ.get("WRK_HOSTS_CONFIG")
    if override:
        return override
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
        os.path.expanduser("~"), ".config"
    )
    return os.path.join(xdg, "wrk", "hosts.toml")


def _toml_value(raw: str) -> str:
    # Mirrors wrk's spillover_value: cut at the first '#', trim, then strip one
    # pair of surrounding double quotes.
    value = raw.split("#", 1)[0].strip()
    if len(value) >= 2 and value.startswith('"') and value.endswith('"'):
        value = value[1:-1]
    return value


def parse_hosts_config(path: str) -> list[tuple[str, str]]:
    """Active [hosts.NAME] tables in file order -> (name, ssh-alias-or-name)."""
    order: list[str] = []
    ssh: dict[str, str] = {}
    current = ""
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return []
    for raw in lines:
        line = _toml_value(raw)
        if not line:
            continue
        header = ANY_HEADER.match(line)
        if header:
            current = header.group(1)
            named = HOSTS_HEADER.match(line)
            if named and named.group(1) not in order:
                order.append(named.group(1))
            continue
        if current.startswith("hosts."):
            key = SSH_KEY.match(line)
            if key:
                name = current[len("hosts."):]
                if name not in ssh:
                    ssh[name] = _toml_value(key.group(1))
    return [(name, ssh.get(name) or name) for name in order]


class Host:
    def __init__(self, name: str, alias: str, local: bool) -> None:
        self.name = name
        self.alias = alias
        self.local = local


def build_hosts(args: argparse.Namespace, parser: argparse.ArgumentParser) -> list[Host]:
    hosts: dict[str, Host] = {"local": Host("local", "local", True)}
    config_path = hosts_config_path()
    readable = os.path.isfile(config_path) and os.access(config_path, os.R_OK)
    if not readable:
        if os.environ.get("WRK_HOSTS_CONFIG"):
            # An explicitly set config that cannot be read is a usage error,
            # not a silent "probe local only".
            parser.exit(
                EXIT_USAGE,
                "%s: error: WRK_HOSTS_CONFIG=%s is missing or unreadable\n"
                % (PROG, config_path),
            )
        eprint(
            "%s: warning: hosts config %s missing or unreadable; probing local only"
            % (PROG, config_path)
        )
    for name, alias in parse_hosts_config(config_path):
        if name in hosts:
            hosts[name].alias = alias
        else:
            hosts[name] = Host(name, alias, False)
    for spec in args.extra or []:
        if "=" not in spec:
            parser.error("--extra expects NAME=ALIAS, got %r" % spec)
        name, alias = spec.split("=", 1)
        if not NAME_RE.match(name) or not alias:
            parser.error("--extra expects NAME=ALIAS, got %r" % spec)
        if name in hosts:
            hosts[name].alias = alias
        else:
            hosts[name] = Host(name, alias, False)

    skip: set[str] = set()
    for item in args.skip or []:
        skip.update(part for part in item.split(",") if part)
    selected = [h for name, h in hosts.items() if name not in skip]

    if args.only:
        wanted: list[str] = []
        for item in args.only:
            wanted.extend(part for part in item.split(",") if part)
        known = {h.name for h in selected}
        missing = [n for n in wanted if n not in known]
        if missing:
            parser.error("--only names unknown hosts: %s" % ", ".join(missing))
        selected = [h for h in selected if h.name in set(wanted)]
    return selected


def probe_host(host: Host, timeout: float) -> tuple[dict[str, str] | None, str]:
    if host.local:
        cmd = ["sh", "-s"]
    else:
        cmd = [
            os.environ.get("FLEET_REV_SSH") or "ssh",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=10",
            "--",
            host.alias,
            "sh",
            "-s",
        ]
    try:
        proc = subprocess.run(
            cmd, input=PROBE, capture_output=True, text=True, timeout=timeout
        )
    except subprocess.TimeoutExpired:
        return None, "timeout after %ss" % timeout
    except OSError as exc:
        return None, "probe failed: %s" % exc
    if proc.returncode != 0:
        return None, "rc=%d" % proc.returncode
    kv: dict[str, str] = {}
    for line in proc.stdout.splitlines():
        match = re.match(r"^([A-Za-z0-9_.-]+)=(.*)$", line)
        if match:
            kv[match.group(1)] = match.group(2)
    return kv, ""


def gh_bin() -> str:
    return os.environ.get("FLEET_REV_GH") or "gh"


def gh_api(endpoint: str, jq: str, timeout: float) -> str | None:
    try:
        proc = subprocess.run(
            [gh_bin(), "api", endpoint, "--jq", jq],
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    return proc.stdout.strip()


def resolve_mains(timeout: float) -> dict[str, str | None]:
    mains: dict[str, str | None] = {}
    for repo in TOOLS:
        sha = gh_api("repos/%s/%s/commits/main" % (ORG, repo), ".sha", timeout)
        mains[repo] = sha or None
        if sha is None:
            eprint("%s: warning: cannot resolve %s main via gh" % (PROG, repo))
    return mains


def gh_compare(repo: str, installed: str, timeout: float) -> tuple[str | None, str]:
    """One gh api compare call -> (line, error). error is '404' when gh
    reports HTTP 404 (installed sha unknown to GitHub), 'failed' for every
    other failure (5xx, rate limit, auth, timeout, launch error)."""
    try:
        proc = subprocess.run(
            [
                gh_bin(),
                "api",
                "repos/%s/%s/compare/%s...main" % (ORG, repo, installed),
                "--jq",
                '.status + " " + (.ahead_by|tostring)',
            ],
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None, "failed"
    if proc.returncode != 0:
        return None, "404" if "HTTP 404" in proc.stderr else "failed"
    return proc.stdout.strip(), ""


def compare_to_main(
    repo: str,
    installed: str,
    timeout: float,
    cache: dict[tuple[str, str], tuple[str, int | None, str]],
) -> tuple[str, int | None, str]:
    key = (repo, installed)
    if key in cache:
        return cache[key]
    out, err = gh_compare(repo, installed, timeout)
    if err == "404":
        result: tuple[str, int | None, str] = (
            "diverged",
            None,
            "installed not found on GitHub",
        )
    elif err:
        result = ("unknown", None, "compare failed")
    else:
        parts = out.split()
        status = parts[0] if parts else ""
        ahead = 0
        if len(parts) > 1:
            try:
                ahead = int(parts[1])
            except ValueError:
                ahead = 0
        if status == "ahead":
            result = ("behind", ahead, "")
        elif status == "identical":
            result = ("current", None, "")
        else:
            result = ("diverged", None, "compare: %s" % (status or "error"))
    cache[key] = result
    return result


def make_cell(
    tool: str,
    kv: dict[str, str],
    main_sha: str | None,
    timeout: float,
    cache: dict[tuple[str, str], tuple[str, int | None, str]],
) -> dict[str, object]:
    installed = kv.get(tool + ".installed", "")
    source = kv.get(tool + ".source", "none")
    probe_err = kv.get(tool + ".error", "")

    mods: list[str] = []
    note = ""
    if tool == "agent-skills":
        dirty = kv.get("agent-skills.dirty", "0")
        if dirty not in ("", "0"):
            mods.append("modified (dirty=%s)" % dirty)
    if tool == "handoffkeep":
        if source == "version-cmd":
            parsed = parse_handoffkeep_json(kv.get("handoffkeep.json", ""))
            if parsed is None:
                installed = "unknown"
                note = "bad version json"
            else:
                installed, hk_modified = parsed
                if installed == "unknown":
                    note = "version json rev unknown"
                if hk_modified == "true":
                    mods.append("modified")
        elif kv.get("handoffkeep.modified") == "true":
            mods.append("modified")

    cell: dict[str, object] = {
        "installed": installed if installed not in ("", "absent", "unknown") else None,
        "status": "unknown",
        "behind": None,
        "source": source,
    }
    detail: list[str] = []
    if probe_err:
        detail.append(probe_err)

    if installed in ("", "unknown"):
        cell["status"] = "unknown"
        if note:
            detail.append(note)
        elif not installed and not probe_err:
            detail.append("probe silent")
    elif installed == "absent":
        cell["status"] = "absent"
    elif not VALID_INSTALLED.fullmatch(installed):
        cell["status"] = "unknown"
        detail.append("bad rev")
    elif main_sha is None:
        cell["status"] = "unknown"
        detail.append("main unresolved")
    elif installed == main_sha or main_sha.startswith(installed):
        cell["status"] = "current"
    else:
        status, ahead, note = compare_to_main(tool, installed, timeout, cache)
        cell["status"] = status
        if status == "behind":
            cell["behind"] = ahead
        if note:
            detail.append(note)

    detail = mods + detail
    cell["detail"] = "; ".join(detail)
    cell["display"] = cell["status"]
    if cell["status"] == "current" and mods:
        cell["display"] = "current+modified"
    elif cell["status"] == "behind":
        cell["display"] = "behind %s" % cell["behind"]
    return cell


def unreachable_cell(error: str) -> dict[str, object]:
    return {
        "installed": None,
        "status": "unreachable",
        "behind": None,
        "source": "none",
        "detail": error,
        "display": "unreachable",
    }


def short(sha: object) -> str:
    if not sha:
        return "-"
    return str(sha)[:7]


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Read-only fleet install check; never installs or writes.",
    )
    parser.add_argument("--extra", action="append", metavar="NAME=ALIAS",
                        help="add host NAME probed over ssh ALIAS (repeatable)")
    parser.add_argument("--skip", action="append", metavar="NAME",
                        help="drop host NAME from the probe set (repeatable)")
    parser.add_argument("--only", action="append", metavar="NAME[,NAME]",
                        help="probe only the named hosts")
    parser.add_argument("--timeout", type=float, default=30, metavar="SECONDS",
                        help="per-host and per-gh-call timeout (default 30)")
    parser.add_argument("--json", action="store_true",
                        help="print one JSON object instead of the table")
    args = parser.parse_args(argv)
    if args.timeout <= 0:
        parser.error("--timeout must be positive")

    hosts = build_hosts(args, parser)
    mains = resolve_mains(args.timeout)
    cache: dict[tuple[str, str], tuple[str, int | None, str]] = {}

    rows: list[dict[str, object]] = []
    cells: list[dict[str, object]] = []
    for host in hosts:
        kv, error = probe_host(host, args.timeout)
        host_cells: dict[str, dict[str, object]] = {}
        for tool in TOOLS:
            if kv is None:
                cell = unreachable_cell(error)
            else:
                cell = make_cell(tool, kv, mains[tool], args.timeout, cache)
            host_cells[tool] = cell
            cells.append(cell)
        rows.append({
            "host": host.name,
            "alias": host.alias,
            "reachable": kv is not None,
            "tools": host_cells,
        })

    stale = [c for c in cells if c["status"] in ("behind", "diverged")]
    other = [c for c in cells if c["status"] in ("unknown", "absent", "unreachable")]
    if stale:
        rc = EXIT_STALE
    elif other:
        rc = EXIT_UNKNOWN
    else:
        rc = EXIT_OK

    if args.json:
        payload = {
            "main": {repo: mains[repo] for repo in TOOLS},
            "hosts": [
                {
                    "host": row["host"],
                    "alias": row["alias"],
                    "reachable": row["reachable"],
                    "tools": {
                        tool: {
                            "installed": cell["installed"],
                            "status": cell["status"],
                            "behind": cell["behind"],
                            "source": cell["source"],
                            "detail": cell["detail"],
                        }
                        for tool, cell in row["tools"].items()
                    },
                }
                for row in rows
            ],
            "rc": rc,
        }
        print(json.dumps(payload))
        return rc

    table = [("host", "tool", "installed", "main", "status", "detail")]
    for row in rows:
        for tool in TOOLS:
            cell = row["tools"][tool]
            table.append((
                str(row["host"]),
                tool,
                short(cell["installed"]),
                short(mains[tool]),
                str(cell["display"]),
                str(cell["detail"]) or "-",
            ))
    widths = [max(len(line[i]) for line in table) for i in range(6)]
    for line in table:
        print("  ".join(part.ljust(widths[i]) for i, part in enumerate(line)).rstrip())

    current = sum(1 for c in cells if c["status"] == "current")
    behind = sum(1 for c in cells if c["status"] == "behind")
    diverged = sum(1 for c in cells if c["status"] == "diverged")
    print(
        "%s: rc=%d current=%d behind=%d diverged=%d other=%d"
        % (PROG, rc, current, behind, diverged, len(other))
    )
    return rc


if __name__ == "__main__":
    sys.exit(main())
