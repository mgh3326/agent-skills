#!/usr/bin/env python3
"""fleet-install — install one tagged fleet-tool release on this host and remotes.

usage: fleet-install <tool> <tag> [--hosts a,b] [--dry-run]
                     [--workflow NAME] [--wait-timeout S] [--poll-interval S]

Replaces the desk's ad-hoc install script:

  1. wait for the release workflow run for headBranch <tag> in
     mgh3326/<tool> to complete (bounded by --wait-timeout, including each
     `gh` call; the run may not exist yet when a tag is fresh, so an empty
     list keeps polling). --workflow restricts the wait to one workflow —
     name it per the tool repo's release workflow (the name is local
     knowledge, not this repo's);
  2. `gh release download <tag> -R mgh3326/<tool> --clobber` into a temp dir;
  3. `shasum -a 256 -c SHA256SUMS` (or `sha256sum -c`) — required, never skipped;
  4. install <tool>-<os>-<arch> for this host's detected arch into
     ~/.local/bin/<tool> (mode 755) and print `<tool> --version`;
  5. per --hosts entry: detect <os>-<arch> over ssh, scp the matching binary
     to .local/bin/<tool>.new, validate it with `<tool>.new --version`, then
     `mv -f` into place (atomic replace — a staged binary that cannot run
     never replaces the working install);
  6. post-install restart hooks from the local config file (below) run for
     every target that installed.

Host names, restart commands and which daemon runs where live ONLY in the
local config — this repo is public. Default path:

  ~/.config/wrk/fleet-install.toml   (override: FLEET_INSTALL_CONFIG)

Config format (TOML subset: `key = ["a", "b"]` string arrays under bracket
sections; see docs/fleet-install.md for an example without real hosts):

  [tool.mergewake.local]          # hooks on the operator host, run via sh -c
  restart = ["launchctl kickstart -k gui/$(id -u)/<label>"]

  [tool.mergewake.host.example-b] # hooks on --hosts entry example-b, via ssh
  restart = ["systemctl --user restart mergewake.service"]

exit code
  0  every target installed (and restarted, where configured)
  1  at least one --hosts entry or the local install failed
  2  usage error
  3  release wait timed out or failed, download/checksum error

env overrides (tests):
  FLEET_INSTALL_GH / FLEET_INSTALL_SSH / FLEET_INSTALL_SCP
  FLEET_INSTALL_CONFIG / FLEET_INSTALL_BIN_DIR
  FLEET_INSTALL_WAIT_TIMEOUT / FLEET_INSTALL_POLL_INTERVAL
"""

from __future__ import annotations

import argparse
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import time

try:
    import tomllib
except ImportError:  # python < 3.11: the documented-subset parser below is used
    tomllib = None

PROG = "fleet-install"
ORG = "mgh3326"

EXIT_HOST_FAILED = 1
EXIT_USAGE = 2
EXIT_FETCH = 3

DEFAULT_WAIT_TIMEOUT = 1800
DEFAULT_POLL_INTERVAL = 15

REMOTE_ARCH_CMD = (
    "echo $(uname -s | tr A-Z a-z)-"
    "$(uname -m | sed -e s/x86_64/amd64/ -e s/aarch64/arm64/)"
)


def run(argv, **kw):
    return subprocess.run(argv, text=True, capture_output=True, **kw)


def die(msg, code):
    print(f"{PROG}: {msg}", file=sys.stderr)
    sys.exit(code)


def local_arch():
    system = platform.system().lower()
    machine = platform.machine().lower()
    machine = {"x86_64": "amd64", "aarch64": "arm64"}.get(machine, machine)
    return f"{system}-{machine}"


def wait_for_release(gh, tool, tag, timeout, interval, dry_run, workflow=None):
    """Poll `gh run list` until the headBranch=<tag> run completes."""
    deadline = time.monotonic() + timeout
    argv = [
        gh, "run", "list", "-R", f"{ORG}/{tool}",
        "--branch", tag, "--limit", "1",
        "--json", "status,conclusion,headBranch",
    ]
    if workflow:
        argv += ["--workflow", workflow]
    while True:
        if dry_run:
            print(f"[dry-run] wait for release run of {ORG}/{tool} headBranch {tag}")
            return
        try:
            proc = run(argv, timeout=max(1, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            die(f"timed out after {timeout}s waiting for the release run of "
                f"{ORG}/{tool} headBranch {tag}", EXIT_FETCH)
        if proc.returncode == 0:
            try:
                runs = json.loads(proc.stdout or "[]")
            except json.JSONDecodeError:
                runs = []
            if runs:
                run_info = runs[0]
                status = run_info.get("status")
                if status == "completed":
                    conclusion = run_info.get("conclusion")
                    if conclusion != "success":
                        die(f"release run for {tag} completed with conclusion "
                            f"{conclusion!r}", EXIT_FETCH)
                    return
        if time.monotonic() + interval > deadline:
            die(f"timed out after {timeout}s waiting for the release run of "
                f"{ORG}/{tool} headBranch {tag}", EXIT_FETCH)
        time.sleep(interval)


def checksum_tool():
    if shutil.which("shasum"):
        return ["shasum", "-a", "256", "-c", "SHA256SUMS"]
    if shutil.which("sha256sum"):
        return ["sha256sum", "-c", "SHA256SUMS"]
    die("neither shasum nor sha256sum found; checksum verification is required",
        EXIT_FETCH)


# --- local config (documented TOML subset) ---------------------------------

_SECTION = re.compile(
    r"^\[tool\.([A-Za-z0-9_-]+)\.(local|host\.[A-Za-z0-9_.-]+)\]\s*$")
_KEY = re.compile(r"^([A-Za-z_]+)\s*=\s*(.*)$")
_STRING = re.compile(r'"(?:[^"\\]|\\.)*"')


def _strip_comment(line):
    """Drop a trailing # comment unless it is inside a "quoted" string."""
    out = []
    in_str = False
    esc = False
    for ch in line:
        if in_str:
            out.append(ch)
            if esc:
                esc = False
            elif ch == "\\":
                esc = True
            elif ch == '"':
                in_str = False
        elif ch == '"':
            in_str = True
            out.append(ch)
        elif ch == "#":
            break
        else:
            out.append(ch)
    return "".join(out)


def _array_strings(value):
    """Extract the quoted strings of a TOML array literal (subset parser)."""
    return [json.loads(m.group(0)) for m in _STRING.finditer(value)]


def _hooks_tomllib(path, tool):
    try:
        with open(path, "rb") as handle:
            data = tomllib.load(handle)
    except FileNotFoundError:
        return {}
    except (OSError, tomllib.TOMLDecodeError) as exc:
        die(f"cannot parse config {path}: {exc}", EXIT_USAGE)
    hooks = {}
    sections = data.get("tool", {}).get(tool, {})
    hooks["local"] = sections.get("local", {}).get("restart", [])
    for name, sub in sections.get("host", {}).items():
        hooks[name] = sub.get("restart", [])
    for target, commands in hooks.items():
        if not isinstance(commands, list) or \
                not all(isinstance(c, str) for c in commands):
            die(f"config {path}: restart for {target} must be an array of "
                f"strings", EXIT_USAGE)
    return {k: list(v) for k, v in hooks.items() if v}


def _hooks_subset(path, tool):
    """Fallback parser for the documented config subset (no tomllib)."""
    hooks = {}
    try:
        with open(path, encoding="utf-8") as handle:
            lines = handle.readlines()
    except FileNotFoundError:
        return hooks
    except OSError as exc:
        die(f"cannot read config {path}: {exc}", EXIT_USAGE)

    section = None
    i = 0
    while i < len(lines):
        line = _strip_comment(lines[i]).strip()
        i += 1
        if not line:
            continue
        match = _SECTION.match(line)
        if match:
            sec_tool, sec_target = match.groups()
            if sec_tool == tool:
                section = "local" if sec_target == "local" else sec_target[len("host."):]
                hooks.setdefault(section, [])
            else:
                section = None
            continue
        if line.startswith("["):
            section = None  # a header this subset does not know ends the section
            continue
        if section is None:
            continue
        kv = _KEY.match(line)
        if not kv:
            continue
        key, value = kv.groups()
        # Continue until the brackets balance outside quoted strings, so a
        # ']' inside a command does not end the value early.
        while value.count("[") - value.count("]") > 0 and i < len(lines):
            value += _strip_comment(lines[i])
            i += 1
        if key == "restart":
            if not value.lstrip().startswith("["):
                die(f"config {path}: restart for {section} must be an array "
                    f"of strings", EXIT_USAGE)
            try:
                commands = _array_strings(value)
            except json.JSONDecodeError as exc:
                die(f"config {path}: bad restart array in section for "
                    f"{section}: {exc}", EXIT_USAGE)
            hooks[section].extend(commands)
    return hooks


def load_restart_hooks(path, tool):
    """Return {"local": [...], "<host>": [...]} restart command lists."""
    if tomllib is not None:
        return _hooks_tomllib(path, tool)
    return _hooks_subset(path, tool)


# --- install steps ----------------------------------------------------------

def install_local(args):
    arch = local_arch()
    artifact = os.path.join(args.dir, f"{args.tool}-{arch}")
    target = os.path.join(args.bin_dir, args.tool)
    if args.sums is not None and f"{args.tool}-{arch}" not in args.sums:
        print(f"{PROG}: {args.tool}-{arch} is not listed in SHA256SUMS; "
              f"refusing to install an unverified artifact", file=sys.stderr)
        return False
    if args.dry_run:
        print(f"[dry-run] install -m 755 {artifact} {target}")
        print(f"[dry-run] {target} --version")
        return True
    if not os.path.isfile(artifact):
        print(f"{PROG}: no artifact for this host's arch: "
              f"{args.tool}-{arch}", file=sys.stderr)
        return False
    try:
        os.makedirs(args.bin_dir, exist_ok=True)
    except OSError as exc:
        print(f"{PROG}: cannot create {args.bin_dir}: {exc}", file=sys.stderr)
        return False
    # Stage to a sibling path and rename: an interrupted install must not
    # leave a truncated binary at the live path.
    staged = target + ".new"
    proc = run(["install", "-m", "755", artifact, staged])
    if proc.returncode != 0:
        print(f"{PROG}: install failed: {proc.stderr.strip()}", file=sys.stderr)
        try:
            os.unlink(staged)
        except OSError:
            pass
        return False
    try:
        os.replace(staged, target)
    except OSError as exc:
        print(f"{PROG}: cannot promote {staged}: {exc}", file=sys.stderr)
        return False
    ver = run([target, "--version"])
    print(ver.stdout.strip() or ver.stderr.strip())
    return ver.returncode == 0


def install_host(args, host):
    """Install on one remote. Returns (ok, arch)."""
    tool = args.tool
    if args.dry_run:
        print(f"[dry-run] ssh -n {host} '{REMOTE_ARCH_CMD}'")
        print(f"[dry-run] scp {tool}-<arch> {host}:.local/bin/{tool}.new; "
              f"chmod+mv+--version over ssh")
        return True, None
    proc = run([args.ssh, "-n", host, REMOTE_ARCH_CMD])
    arch = proc.stdout.strip()
    if proc.returncode != 0 or not arch:
        print(f"{PROG}: {host}: arch probe failed: {proc.stderr.strip()}",
              file=sys.stderr)
        return False, None
    artifact = os.path.join(args.dir, f"{tool}-{arch}")
    if not os.path.isfile(artifact):
        print(f"{PROG}: {host}: no artifact for arch {arch}", file=sys.stderr)
        return False, arch
    if args.sums is not None and f"{tool}-{arch}" not in args.sums:
        print(f"{PROG}: {host}: {tool}-{arch} is not listed in SHA256SUMS; "
              f"refusing to install an unverified artifact", file=sys.stderr)
        return False, arch
    proc = run([args.scp, artifact, f"{host}:.local/bin/{tool}.new"])
    if proc.returncode != 0:
        print(f"{PROG}: {host}: scp failed: {proc.stderr.strip()}",
              file=sys.stderr)
        return False, arch
    # Validate the staged .new before it replaces the working binary: if
    # --version fails the old install stays untouched and .new is dropped.
    remote = (
        f"chmod 755 ~/.local/bin/{tool}.new && "
        f"~/.local/bin/{tool}.new --version && "
        f"mv -f ~/.local/bin/{tool}.new ~/.local/bin/{tool}"
    )
    proc = run([args.ssh, "-n", host, remote])
    out = (proc.stdout + proc.stderr).strip()
    if out:
        print(f"{host}: {out}")
    if proc.returncode != 0:
        print(f"{PROG}: {host}: activate failed", file=sys.stderr)
        return False, arch
    return True, arch


def run_restarts(args, target, commands):
    """Run restart hooks for one target ('local' or a host name)."""
    ok = True
    for cmd in commands:
        if args.dry_run:
            where = "local sh -c" if target == "local" else f"ssh {target}"
            print(f"[dry-run] restart ({where}): {cmd}")
            continue
        if target == "local":
            proc = run(["sh", "-c", cmd])
        else:
            proc = run([args.ssh, "-n", target, cmd])
        if proc.returncode != 0:
            print(f"{PROG}: {target}: restart failed ({cmd}): "
                  f"{proc.stderr.strip()}", file=sys.stderr)
            ok = False
    return ok


def main():
    parser = argparse.ArgumentParser(
        prog=PROG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Install one tagged fleet-tool release on this host and remotes.",
        epilog=__doc__)
    parser.add_argument("tool")
    parser.add_argument("tag")
    parser.add_argument("--hosts", default="",
                        help="comma-separated remote host names")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--workflow", default=os.environ.get(
                            "FLEET_INSTALL_WORKFLOW", ""),
                        help="release workflow name/file to wait on "
                             "(default: any workflow on the tag branch)")
    parser.add_argument("--wait-timeout", type=int,
                        default=int(os.environ.get(
                            "FLEET_INSTALL_WAIT_TIMEOUT", DEFAULT_WAIT_TIMEOUT)))
    parser.add_argument("--poll-interval", type=int,
                        default=int(os.environ.get(
                            "FLEET_INSTALL_POLL_INTERVAL", DEFAULT_POLL_INTERVAL)))
    args = parser.parse_args()

    args.gh = os.environ.get("FLEET_INSTALL_GH", "gh")
    args.ssh = os.environ.get("FLEET_INSTALL_SSH", "ssh")
    args.scp = os.environ.get("FLEET_INSTALL_SCP", "scp")
    args.bin_dir = os.environ.get(
        "FLEET_INSTALL_BIN_DIR", os.path.expanduser("~/.local/bin"))
    config = os.environ.get(
        "FLEET_INSTALL_CONFIG",
        os.path.expanduser("~/.config/wrk/fleet-install.toml"))
    hosts = [h.strip() for h in args.hosts.split(",") if h.strip()]

    # Config errors are usage errors: surface them before the (potentially
    # long) release wait and download.
    hooks = load_restart_hooks(config, args.tool)

    wait_for_release(args.gh, args.tool, args.tag,
                     args.wait_timeout, args.poll_interval, args.dry_run,
                     workflow=args.workflow)

    with tempfile.TemporaryDirectory(prefix=f"{args.tool}-{args.tag}-") as tmp:
        args.dir = tmp
        if args.dry_run:
            print(f"[dry-run] gh release download {args.tag} -R "
                  f"{ORG}/{args.tool} --clobber --dir <tmp>")
            print(f"[dry-run] {' '.join(checksum_tool())}")
            args.sums = None
        else:
            proc = run([args.gh, "release", "download", args.tag,
                        "-R", f"{ORG}/{args.tool}", "--clobber", "--dir", tmp])
            if proc.returncode != 0:
                die(f"gh release download failed: {proc.stderr.strip()}",
                    EXIT_FETCH)
            proc = run(checksum_tool(), cwd=tmp)
            if proc.returncode != 0:
                sys.stderr.write(proc.stdout + proc.stderr)
                die("checksum verification failed", EXIT_FETCH)
            # Every artifact installed must have been covered by SHA256SUMS;
            # `shasum -c` verifies listed files but says nothing about assets
            # missing from the list.
            args.sums = set()
            with open(os.path.join(tmp, "SHA256SUMS"), encoding="utf-8") as sf:
                for line in sf:
                    parts = line.split()
                    if len(parts) >= 2:
                        args.sums.add(parts[-1].lstrip("*"))

        failed = []

        if install_local(args):
            if not run_restarts(args, "local", hooks.get("local", [])):
                failed.append("local")
        else:
            failed.append("local")

        for host in hosts:
            ok, _arch = install_host(args, host)
            if ok and not run_restarts(args, host, hooks.get(host, [])):
                ok = False
            if not ok:
                failed.append(host)

    if failed:
        print(f"{PROG}: failed targets: {', '.join(failed)}", file=sys.stderr)
        sys.exit(EXIT_HOST_FAILED)
    print(f"{PROG}: {args.tool} {args.tag} installed")


if __name__ == "__main__":
    main()
