#!/usr/bin/env python3
"""Narrow, receipt-backed operations for the m1-ops pane."""

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.error
import urllib.request
from datetime import datetime, timezone


HK_REL = (".local", "bin", "handoffkeep")
PANEWIRE_REL = (".local", "bin", "panewire")
REPO_MAP = {"agent-skills": (".agents", "skills")}
ID_RE = re.compile(r"^[0-9]{8}-[0-9]{4}-[a-z0-9-]{1,32}$")
MACHINE_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
SHA_RE = re.compile(r"^[0-9a-f]{40}$")
TAG_RE = re.compile(r"^v[0-9]+\.[0-9]+\.[0-9]+$")
SHA256_RE = re.compile(r"^[0-9a-fA-F]{64}$")
OS_ARCHES = {"darwin_arm64", "darwin_amd64", "linux_arm64", "linux_amd64"}
MAX_DOWNLOAD_BYTES = 64 * 1024 * 1024
RECEIPT_RESULTS = {"ok", "refused", "failed"}


class Refused(Exception):
    """A request or its preconditions do not match the fixed policy."""


class UnsafeRedirect(Refused):
    pass


def home_path():
    home = os.environ.get("HOME")
    if not home:
        raise RuntimeError("HOME is unavailable")
    return os.path.abspath(home)


def fixed_path(home, parts):
    return os.path.join(home, *parts)


def run_argv(argv):
    return subprocess.run(
        argv,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        errors="replace",
        shell=False,
        check=False,
    )


def write_temp_file(home, prefix, contents):
    fd, path = tempfile.mkstemp(prefix=prefix, dir=home)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(contents)
    except Exception:
        try:
            os.unlink(path)
        except OSError:
            pass
        raise
    return path


def decode_json(text):
    try:
        return json.loads(text)
    except (TypeError, ValueError):
        return None


def response_document(stdout):
    payload = decode_json(stdout)
    if isinstance(payload, dict) and isinstance(payload.get("document"), dict):
        return payload["document"]
    return None


def hk_get(home, key):
    completed = run_argv([fixed_path(home, HK_REL), "doc", "get", key])
    if completed.returncode != 0:
        return False, None
    return True, response_document(completed.stdout)


def hk_put(home, key, body):
    body_bytes = body.encode("utf-8")
    path = write_temp_file(home, "node-ops-doc-", body_bytes)
    try:
        return run_argv(
            [
                fixed_path(home, HK_REL),
                "doc",
                "put",
                "--key",
                key,
                "--kind",
                "note",
                "--file",
                path,
            ]
        )
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass


def utc_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def utc_stamp():
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def receipt_line(key, result):
    print("RECEIPT key={} result={}".format(key, result))


def put_receipt(home, key, receipt):
    body = json.dumps(receipt, separators=(",", ":"), ensure_ascii=False)
    try:
        completed = hk_put(home, key, body)
        return completed.returncode == 0
    except Exception as exc:
        del exc
        return False


def parse_instruction_body(value):
    if isinstance(value, str):
        return decode_json(value)
    if isinstance(value, dict):
        return value
    return None


def stored_receipt_result(document):
    if not isinstance(document, dict):
        return "ok"
    body = parse_instruction_body(document.get("body"))
    if isinstance(body, dict) and body.get("result") in RECEIPT_RESULTS:
        return body["result"]
    return "ok"


def new_receipt(identifier, action, result, reason, before, after):
    return {
        "id": identifier,
        "action": action,
        "result": result,
        "reason": reason,
        "before": before,
        "after": after,
        "checked_at": utc_iso(),
    }


def finalize(home, receipt_key, receipt):
    result = receipt["result"]
    if not put_receipt(home, receipt_key, receipt):
        receipt_line(receipt_key, "failed")
        return 1
    receipt_line(receipt_key, result)
    return {"ok": 0, "refused": 2, "failed": 1}[result]


def refusal_receipt(home, receipt_key, identifier, action, reason, before="", after=""):
    return finalize(
        home,
        receipt_key,
        new_receipt(identifier, action, "refused", reason, before, after),
    )


def git_command(path, *args):
    return run_argv(["git", "-C", path] + list(args))


def repo_ff(home, instruction):
    before = ""
    after = ""
    repo_key = instruction.get("repo")
    sha = instruction.get("sha")
    if repo_key != "agent-skills":
        return "refused", "unknown_repo", before, after
    if not isinstance(sha, str) or not SHA_RE.fullmatch(sha):
        return "refused", "invalid_sha", before, after

    path = fixed_path(home, REPO_MAP[repo_key])
    current = git_command(path, "rev-parse", "HEAD")
    if current.returncode != 0:
        return "failed", "rev_parse_head_failed", before, after
    before = current.stdout.strip()
    after = before

    status = git_command(path, "status", "--porcelain")
    if status.returncode != 0:
        return "failed", "status_failed", before, after
    if status.stdout != "":
        return "refused", "dirty_tree", before, after

    branch = git_command(path, "rev-parse", "--abbrev-ref", "HEAD")
    if branch.returncode != 0:
        return "failed", "branch_check_failed", before, after
    if branch.stdout.strip() != "main":
        return "refused", "branch_not_main", before, after

    fetched = git_command(path, "fetch", "origin")
    if fetched.returncode != 0:
        return "failed", "fetch_failed", before, after

    ancestor = git_command(path, "merge-base", "--is-ancestor", sha, "origin/main")
    if ancestor.returncode != 0:
        return "refused", "sha_not_ancestor_of_origin_main", before, after

    merged = git_command(path, "merge", "--ff-only", sha)
    if merged.returncode != 0:
        return "failed", "merge_failed", before, after

    final = git_command(path, "rev-parse", "HEAD")
    if final.returncode != 0:
        return "failed", "final_rev_parse_failed", before, after
    after = final.stdout.strip()
    matches = after == sha
    reason = "after_eq_sha={}".format("true" if matches else "false")
    return ("ok" if matches else "failed"), reason, before, after


def valid_redirect_url(url):
    try:
        parsed = urllib.parse.urlsplit(url)
        host = parsed.hostname
        port = parsed.port
    except (TypeError, ValueError):
        return False
    if parsed.scheme != "https" or parsed.username is not None or parsed.password is not None:
        return False
    if "#" in url or (port is not None and port != 443):
        return False
    if host == "github.com":
        return parsed.query == ""
    if host == "objects.githubusercontent.com":
        return True
    return False


class PolicyRedirectHandler(urllib.request.HTTPRedirectHandler):
    def __init__(self):
        super().__init__()
        self.redirects = 0

    def redirect_request(self, request, fp, code, message, headers, new_url):
        self.redirects += 1
        if self.redirects > 3 or not valid_redirect_url(new_url):
            raise UnsafeRedirect("redirect rejected")
        return super().redirect_request(request, fp, code, message, headers, new_url)


def production_fetcher(url, max_bytes):
    if not valid_redirect_url(url):
        raise UnsafeRedirect("initial URL rejected")
    handler = PolicyRedirectHandler()
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), handler)
    response = opener.open(urllib.request.Request(url, method="GET"), timeout=30)

    def chunks():
        try:
            while True:
                chunk = response.read(min(1024 * 1024, max_bytes + 1))
                if not chunk:
                    break
                yield chunk
        finally:
            response.close()

    return chunks()


def stream_to_file(chunks, path, max_bytes):
    digest = hashlib.sha256()
    total = 0
    with open(path, "wb") as stream:
        for chunk in chunks:
            if not isinstance(chunk, bytes):
                raise RuntimeError("download returned non-bytes")
            total += len(chunk)
            if total > max_bytes:
                raise Refused("download_too_large")
            stream.write(chunk)
            digest.update(chunk)
    return digest.hexdigest()


def action_install(home, instruction, fetcher=None):
    destination = fixed_path(home, HK_REL)
    before = destination if os.path.exists(destination) else ""
    after = ""
    tag = instruction.get("tag")
    os_arch = instruction.get("os_arch")
    expected_sha = instruction.get("sha256")
    if not isinstance(tag, str) or not TAG_RE.fullmatch(tag):
        return "refused", "invalid_tag", before, after
    if not isinstance(os_arch, str) or os_arch not in OS_ARCHES:
        return "refused", "invalid_os_arch", before, after
    if not isinstance(expected_sha, str) or not SHA256_RE.fullmatch(expected_sha):
        return "refused", "invalid_sha256", before, after

    asset = "handoffkeep_" + os_arch
    url = "https://github.com/mgh3326/handoffkeep/releases/download/{}/{}".format(tag, asset)
    selected_fetcher = fetcher or production_fetcher
    directory = os.path.dirname(destination)
    temp_path = None
    try:
        fd, temp_path = tempfile.mkstemp(prefix=".handoffkeep-", suffix=".tmp", dir=directory)
        os.close(fd)
        chunks = selected_fetcher(url, MAX_DOWNLOAD_BYTES)
        actual_sha = stream_to_file(chunks, temp_path, MAX_DOWNLOAD_BYTES)
        if actual_sha.lower() != expected_sha.lower():
            return "refused", "sha256_mismatch release={}".format(tag), before, after
        os.chmod(temp_path, 0o755)
        smoke = run_argv([temp_path, "version"])
        expected_token = "release=" + tag
        if smoke.returncode != 0 or expected_token not in smoke.stdout.split():
            return "refused", "smoke_mismatch release={}".format(tag), before, after

        backup = ""
        if os.path.exists(destination):
            backup = destination + ".bak-" + utc_stamp()
            if os.path.exists(backup):
                return "failed", "backup_exists release={}".format(tag), before, after
            shutil.copy2(destination, backup)
        os.replace(temp_path, destination)
        temp_path = None
        after = destination
        return "ok", "release={}".format(tag), before, after
    except Refused as exc:
        return "refused", "{} release={}".format(str(exc), tag), before, after
    except (OSError, subprocess.SubprocessError, urllib.error.URLError, ValueError) as exc:
        del exc
        return "failed", "install_failed release={}".format(tag), before, after
    except Exception as exc:
        del exc
        return "failed", "install_failed release={}".format(tag), before, after
    finally:
        if temp_path is not None:
            try:
                os.unlink(temp_path)
            except OSError:
                pass


def version_result(home, parts):
    path = fixed_path(home, parts)
    if not os.path.isfile(path):
        return "missing", True
    completed = run_argv([path, "version"])
    return completed.stdout.strip(), completed.returncode == 0


def status_action(home):
    repos = {}
    failed = False
    for name, parts in REPO_MAP.items():
        path = fixed_path(home, parts)
        if not os.path.isdir(path):
            repos[name] = None
            continue
        head = git_command(path, "rev-parse", "HEAD")
        if head.returncode != 0:
            repos[name] = None
            failed = True
        else:
            repos[name] = head.stdout.strip()

    wrk_head = repos.get("agent-skills")
    handoffkeep, hk_ok = version_result(home, HK_REL)
    panewire, panewire_ok = version_result(home, PANEWIRE_REL)
    failed = failed or not hk_ok or not panewire_ok

    panes = []
    pane_result = run_argv(["herdr", "pane", "list"])
    pane_data = decode_json(pane_result.stdout) if pane_result.returncode == 0 else None
    if isinstance(pane_data, dict):
        pane_data = pane_data.get("panes")
    if isinstance(pane_data, list):
        for pane in pane_data:
            if isinstance(pane, dict):
                panes.append({key: pane[key] for key in ("id", "agent", "status", "label") if key in pane})
    else:
        failed = True

    try:
        disk_free = shutil.disk_usage(home).free
    except OSError:
        disk_free = None
        failed = True

    after = {
        "repos": repos,
        "wrk": wrk_head,
        "handoffkeep": handoffkeep,
        "panewire": panewire,
        "panes": panes,
        "disk_free_bytes": disk_free,
    }
    return ("failed" if failed else "ok"), "status_read_complete", None, after


def parse_body_id(body):
    if not isinstance(body, dict):
        return None
    identifier = body.get("id")
    if isinstance(identifier, str) and ID_RE.fullmatch(identifier):
        return identifier
    return None


def apply_instruction(key):
    try:
        home = home_path()
    except RuntimeError:
        receipt_line("-", "failed")
        return 1

    try:
        found, document = hk_get(home, key)
    except Exception as exc:
        del exc
        receipt_line("-", "failed")
        return 1
    if not found or not isinstance(document, dict):
        receipt_line("-", "failed")
        return 1
    # Only these two instruction fields are authoritative inputs.
    created_by = document.get("created_by")
    raw_body = document.get("body")

    try:
        identity_path = write_temp_file(home, "node-ops-identity-", b'{"v":1,"purpose":"identity"}')
    except Exception as exc:
        del exc
        receipt_line("-", "failed")
        return 1
    try:
        try:
            identity_result = run_argv(
                [
                    fixed_path(home, HK_REL),
                    "doc",
                    "put",
                    "--key",
                    "ops/node/_identity",
                    "--kind",
                    "note",
                    "--file",
                    identity_path,
                ]
            )
        except Exception as exc:
            del exc
            receipt_line("-", "failed")
            return 1
    finally:
        try:
            os.unlink(identity_path)
        except OSError:
            pass
    if identity_result.returncode != 0:
        receipt_line("-", "failed")
        return 1
    identity_document = response_document(identity_result.stdout)
    machine = identity_document.get("created_by") if identity_document else None
    if not isinstance(machine, str) or not MACHINE_RE.fullmatch(machine):
        receipt_line("-", "refused")
        return 2

    body = parse_instruction_body(raw_body)
    identifier = parse_body_id(body)
    if identifier is None:
        receipt_line("-", "refused")
        return 2

    receipt_key = "ops/node/{}/receipt/{}".format(machine, identifier)
    try:
        receipt_found, stored = hk_get(home, receipt_key)
    except Exception as exc:
        del exc
        receipt_line(receipt_key, "failed")
        return 1
    if receipt_found:
        result = stored_receipt_result(stored)
        receipt_line(receipt_key, result)
        return 0

    action_value = body.get("action") if isinstance(body, dict) else None
    action_name = action_value if isinstance(action_value, str) else ""
    if created_by not in ("operator-desk", "operator"):
        return refusal_receipt(home, receipt_key, identifier, action_name, "invalid_issuer")
    if not isinstance(body, dict) or type(body.get("v")) is not int or body.get("v") != 1:
        return refusal_receipt(home, receipt_key, identifier, action_name, "invalid_body")
    if body.get("machine") != machine:
        return refusal_receipt(home, receipt_key, identifier, action_name, "machine_mismatch")
    if key != "ops/node/{}/instr/{}".format(machine, identifier):
        return refusal_receipt(home, receipt_key, identifier, action_name, "key_mismatch")
    if action_name not in ("repo-ff", "hk-cli-install", "status"):
        return refusal_receipt(home, receipt_key, identifier, action_name, "unknown_action")

    try:
        if action_name == "repo-ff":
            result, reason, before, after = repo_ff(home, body)
        elif action_name == "hk-cli-install":
            result, reason, before, after = action_install(home, body)
        else:
            result, reason, before, after = status_action(home)
    except Exception as exc:
        del exc
        result, reason, before, after = "failed", "action_failed", "", ""

    return finalize(
        home,
        receipt_key,
        new_receipt(identifier, action_name, result, reason, before, after),
    )


def selfcheck():
    home = home_path()
    print("map agent-skills={}".format(fixed_path(home, REPO_MAP["agent-skills"])))
    for name, parts in (("handoffkeep", HK_REL), ("panewire", PANEWIRE_REL)):
        output, _ = version_result(home, parts)
        print("{}={}".format(name, output))
    print("identity=not-written")
    return 0


def main(argv):
    if len(argv) == 2 and argv[1] == "selfcheck":
        try:
            return selfcheck()
        except Exception as exc:
            del exc
            return 1
    if len(argv) == 3 and argv[1] == "apply":
        return apply_instruction(argv[2])
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
