{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*ai-keys*": "deny",
      "*-auth.env": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*auth.json": "deny",
      "*credentials*": "deny",
      "*/.ssh/*": "deny",
      "*/.aws/*": "deny",
      "*/.gnupg/*": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*ai-keys*": "deny",
      "*-auth.env": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*auth.json": "deny",
      "*credentials*": "deny",
      "*/.ssh/*": "deny",
      "*/.aws/*": "deny",
      "*/.gnupg/*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.*": "deny"
    },
    "bash": {
      "*": "allow",
      "*ai-keys*": "deny",
      "*.env*": "deny",
      "*.ssh*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*auth.json*": "deny",
      "*credentials*": "deny"
