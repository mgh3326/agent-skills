die() { echo "wrk: $*" >&2; exit 2; }
warn() { echo "wrk: warning: $*" >&2; }
sleep_for() { [[ -n "${WRK_NO_SLEEP:-}" ]] || sleep "$1"; }

# hk 1137: bash =~ ranges follow the caller's locale collation — under
# e.g. en_US.UTF-8, [A-Za-z0-9._-] also matches ~2000 non-ASCII letters and
# symbols (e-acute included), so a locale-pinned match is the only way the
# id allowlists below accept the same byte set under any locale. Plain
# ASCII inputs accept and reject exactly as before.
ascii_re() {  # VALUE ERE — the =~ status under LC_ALL=C
  local LC_ALL=C
  [[ $1 =~ $2 ]]
}

# Echo-safe form of a rejected id for die/warn text: ASCII printable bytes
# pass through unchanged; each other byte is rendered '?' so a non-ASCII or
# control byte never reaches stderr (hk 1137).
scrub_id() {
  printf '%s' "$1" | LC_ALL=C tr -c '[:print:]' '?'
}

# Landing is a bounded positive-evidence observation, not a second boot wait.
# The prompt command already owns its normal wait when supported. A 30-second
# window covers the normal hand-off; codex gets 60 seconds because its cold
# boot is explicitly allowed to settle for 20 seconds above and may still take
# tens of seconds before the submitted transcript is readable. Grok gets 150
# seconds: measured on 2026-09-25 (grok 1.0.41) the pane only echoes or reacts
# to the brief 1-2 minutes after injection, so the 30-second window reported
# landed=no for briefs that did land (b685/b699/b700) — a false negative that
# invites a duplicate re-injection. Sampling backs off from 0.5 to 2 seconds
# and stops immediately on evidence.
LANDING_CHECK_DEFAULT_WINDOW_SECONDS=30
LANDING_CHECK_CODEX_WINDOW_SECONDS=60
LANDING_CHECK_GROK_WINDOW_SECONDS=150
LANDING_CHECK_INITIAL_DELAY_SECONDS=0.5
LANDING_CHECK_SECOND_DELAY_SECONDS=1
LANDING_CHECK_MAX_DELAY_SECONDS=2

# #717: `panewire prompt --timeout` is a budget of its own, decoupled from the
# landing window above. It bounds how long the daemon polls for submission
# evidence, and its classifier only knows claude and codex (prompt.go
# classifySubmission) — for every other kind the poll can never succeed, so a
# window-length timeout is dead wait before wrk's own observation even starts
# (grok blocked the full 150s under #701). Codex keeps 60 seconds: its
# cold-booted transcript can take tens of seconds to become readable, and a
# proven result skips the entire landing check.
PANEWIRE_PROMPT_DEFAULT_TIMEOUT_SECONDS=30
PANEWIRE_PROMPT_CODEX_TIMEOUT_SECONDS=60

# run_bounded SECS CMD... — run CMD with a hard wall-clock bound, exiting 124
# on timeout. GNU timeout/gtimeout already run the child in a new process
# group and kill the group; the python fallback must do the same — plain
# subprocess.run kills only the direct child, so an orphaned grandchild keeps
# inherited pipes open and a caller's $( ) still blocks until it exits
# (#770: JE15b on macOS CI blocked 60s under a 2s bound).
run_bounded() {
  local secs="$1"; shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
    return
  fi
  if command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" "$@"
    return
  fi
  python3 -c 'import os, signal, subprocess, sys
proc = subprocess.Popen(sys.argv[2:], start_new_session=True)
try:
    sys.exit(proc.wait(timeout=float(sys.argv[1])))
except subprocess.TimeoutExpired:
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    proc.wait()
    sys.exit(124)' "$secs" "$@"
}

configure_landing_check() {
  local profile_kind="$1"
  LANDING_CHECK_WINDOW_SECONDS="$LANDING_CHECK_DEFAULT_WINDOW_SECONDS"
  # 18 samples: 0.5 + 1 + (14 * 2) + 0.5 = 30 seconds.
  LANDING_CHECK_TIMEOUT_TICKS=18
  SPAWN_PANEWIRE_TIMEOUT_SECONDS="$PANEWIRE_PROMPT_DEFAULT_TIMEOUT_SECONDS"
  if [[ "$profile_kind" == codex ]]; then
    LANDING_CHECK_WINDOW_SECONDS="$LANDING_CHECK_CODEX_WINDOW_SECONDS"
    # 33 samples: 0.5 + 1 + (29 * 2) + 0.5 = 60 seconds.
    LANDING_CHECK_TIMEOUT_TICKS=33
    SPAWN_PANEWIRE_TIMEOUT_SECONDS="$PANEWIRE_PROMPT_CODEX_TIMEOUT_SECONDS"
  elif [[ "$profile_kind" == grok ]]; then
    LANDING_CHECK_WINDOW_SECONDS="$LANDING_CHECK_GROK_WINDOW_SECONDS"
    # 78 samples: 0.5 + 1 + (74 * 2) + 0.5 = 150 seconds.
    LANDING_CHECK_TIMEOUT_TICKS=78
  fi
}

landing_check_delay() {
  local tick="$1"
  if (( tick == 0 || tick == LANDING_CHECK_TIMEOUT_TICKS - 2 )); then
    printf '%s' "$LANDING_CHECK_INITIAL_DELAY_SECONDS"
  elif (( tick == 1 )); then
    printf '%s' "$LANDING_CHECK_SECOND_DELAY_SECONDS"
  else
    printf '%s' "$LANDING_CHECK_MAX_DELAY_SECONDS"
  fi
}

landing_check_detail() {
  printf 'window=%ss checks=%s last_evidence=%s last_status=%s reason=%s' \
    "$LANDING_CHECK_WINDOW_SECONDS" "$LANDING_CHECK_ATTEMPTS" \
    "$LANDING_CHECK_LAST_EVIDENCE" "$LANDING_CHECK_LAST_STATUS" \
    "$LANDING_CHECK_LAST_REASON"
  # A transient ambiguous observation (e.g. a grok queue chip that disappears
  # again) still suppresses re-injection; keep its origin visible in the final
  # report instead of letting a later tick's reason overwrite it.
  [[ -z "${LANDING_CHECK_AMBIGUOUS_REASON:-}" ]] ||
    printf ' first_ambiguous_reason=%s' "$LANDING_CHECK_AMBIGUOUS_REASON"
}

prompt_marker() {
  local prompt_file="$1" line
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "${line//[[:space:]]/}" ]] || continue
    printf '%s' "${line:0:40}"
    return 0
  done <"$prompt_file"
  return 0
}

agent_status_for_pane() {
  local pane="$1"
  "$HERDR" agent list 2>/dev/null |
    python3 -c 'import json,sys; p=sys.argv[1]; a=json.load(sys.stdin)["result"]["agents"]; print(next((x.get("agent_status","unknown") for x in a if x.get("pane_id")==p),"unknown"))' "$pane" \
    2>/dev/null
}

# #568: a folded-marker match must reproduce devin's observed submitted-prompt
# rendering, not just the marker's characters scattered over a transcript.
# The match must (a) contain a wrapped continuation — a newline followed by
# indent, the shape observed in devin's submitted-prompt rendering
# (`❭ <marker start>` + indented continuation) — and (b) start at a line
# boundary or right after devin's `❭` prompt glyph.
# Whitespace-only variants that never wrapped (a UI column tab between the
# same words) and unrelated text carrying the words across a line break are
# not folded markers and must not count as positive evidence.
devin_folded_marker_present() {
  local marker="$1"
  python3 -c '
import re, sys
marker, recent = sys.argv[1], sys.stdin.read()
pat = r"\s*".join(re.escape(c) for c in marker if not c.isspace())
for m in re.finditer(pat, recent):
    if not re.search(r"\n[ \t]", m.group(0)):
        continue
    line_start = recent.rfind("\n", 0, m.start()) + 1
    if recent[line_start:m.start()].strip() in ("", "❭"):
        sys.exit(0)
sys.exit(1)
' "$marker"
}

landing_check_once() {
  local pane="$1" marker="$2" profile_kind="$3" submit="${4:-}" recent visible status
  LANDING_CHECK_LAST_EVIDENCE=none
  if ! recent="$("$HERDR" agent read "$pane" --source recent-unwrapped --lines 200 2>/dev/null)"; then
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_STATUS=unknown
    LANDING_CHECK_LAST_REASON="recent-unwrapped-read-failed"
    return 1
  fi

  # The prompt transcript is the source of truth. Unlike the 40-line visible
  # screen, recent-unwrapped survives subsequent output scrolling the marker
  # away. `working` below is deliberately not evidence: a cold codex boot
  # reports working before the composer has received the payload.
  if [[ -n "$marker" ]] && grep -Fq -- "$marker" <<<"$recent"; then
    LANDING_CHECK_LAST_EVIDENCE=marker
    LANDING_CHECK_LAST_REASON="marker-in-recent-unwrapped"
    return 0
  fi
  # #568: Devin folds long lines at its render width, so the transcript's copy
  # of the marker can carry a line break or indent the raw substring never
  # matches (the 2026-09-22 t502-verify duplicate: rc 6, status=working,
  # marker present but folded → reinjected into a working tester). Devin
  # only; every other kind keeps the raw substring contract.
  if [[ "$profile_kind" == devin && -n "$marker" && "$recent" == *$'\n'* ]] &&
     devin_folded_marker_present "$marker" <<<"$recent"; then
    LANDING_CHECK_LAST_EVIDENCE=devin-marker-folded
    LANDING_CHECK_LAST_REASON="folded-marker-in-recent-unwrapped"
    return 0
  fi
  if ! visible="$("$HERDR" agent read "$pane" --source visible --lines 40 2>/dev/null)"; then
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_STATUS=unknown
    LANDING_CHECK_LAST_REASON="visible-read-failed"
    return 1
  fi

  # The UI chip is an independent positive observation that the payload is
  # queued; keep it as the fallback for prompts whose transcript is delayed.
  if grep -Fq -- "Pasted text" <<<"$visible"; then
    LANDING_CHECK_LAST_EVIDENCE=pasted
    LANDING_CHECK_LAST_REASON=pasted-text-chip
    return 0
  fi
  # Grok's queued footer has no `──` head the way devin's chip does: the
  # observed shape is `○ 1 command still running · 1 queued, Enter to send
  # now` (2026-09-18). On a shared screen the chip cannot be attributed to
  # THIS injection — a stale footer, the brief's own echoed text, and another
  # sender's payload all render identically (task406 verify2). It is an
  # ambiguous signal, never positive evidence: marking ambiguous suppresses
  # the re-injection so a possibly queued payload is not duplicated. The
  # transcript marker above stays the only positive evidence. `0 queued` is
  # not a chip.
  # #568: Devin's queued banner (`── N queued ──` / `○ msg` /
  # `Press Enter to send queued messages now`, relay-handoff §3-2) means a
  # payload is sitting in Devin's queue. Like grok's chip it cannot be
  # attributed to THIS injection, so it is ambiguous evidence that suppresses
  # re-injection — never positive.
  if [[ "$profile_kind" == devin ]] &&
     grep -Eq '── [0-9]+ queued ──|Press Enter to send queued messages now' <<<"$visible"; then
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_EVIDENCE=devin-queued
    LANDING_CHECK_LAST_REASON="devin-queue-banner-unattributable"
    return 1
  fi
  if [[ "$profile_kind" == grok ]] && grep -Eq '[1-9][0-9]* queued, Enter to send now' <<<"$visible"; then
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_EVIDENCE=grok-queued
    LANDING_CHECK_LAST_REASON="grok-queue-chip-unattributable"
    return 1
  fi
  if ! status="$(agent_status_for_pane "$pane")"; then
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_STATUS=unknown
    LANDING_CHECK_LAST_REASON="status-read-failed"
    return 1
  fi
  LANDING_CHECK_LAST_STATUS="$status"
  # Herdr's built-in Devin detector exposes a post-prompt idle/done state after
  # it has accepted the brief. That detector result is profile-specific positive
  # evidence; generic agents still require a transcript marker or Pasted text.
  if [[ "$profile_kind" == devin && "$status" =~ ^(idle|done)$ ]]; then
    LANDING_CHECK_LAST_EVIDENCE=devin-status
    LANDING_CHECK_LAST_REASON="devin-post-prompt-status-${status}"
    return 0
  fi
  # #568: delivery only runs after `agent wait --until idle` already saw the
  # pane idle, so a Devin pane reporting working has consumed the submitted
  # brief — nothing else was ever sent. `working` is positive evidence only
  # for an accepted submit: after an unconfirmed one (a timeout can fall on
  # either side of the send boundary) working cannot be attributed to this
  # brief, so it is ambiguous — landed stays no and the possibly delivered
  # brief is not duplicated. For other kinds the cold-boot caveat keeps
  # `working` non-evidence.
  if [[ "$profile_kind" == devin && "$status" == working ]]; then
    if [[ "$submit" == accepted ]]; then
      LANDING_CHECK_LAST_EVIDENCE=devin-status
      LANDING_CHECK_LAST_REASON=devin-post-prompt-status-working
      return 0
    fi
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_EVIDENCE=devin-status-working
    LANDING_CHECK_LAST_REASON="devin-working-unattributable-submit-${submit:-unknown}"
    return 1
  fi
  if [[ "$status" == working ]]; then
    LANDING_CHECK_LAST_REASON=working-without-positive-evidence
  else
    LANDING_CHECK_LAST_REASON="status-${status}-without-positive-evidence"
  fi
  return 1
}

landing_check() {
  local pane="$1" marker="$2" profile_kind="$3" submit="${4:-}" tick delay
  LANDING_CHECK_CONFIRMED=0
  LANDING_CHECK_AMBIGUOUS=0
  LANDING_CHECK_AMBIGUOUS_REASON=""
  LANDING_CHECK_ATTEMPTS=0
  LANDING_CHECK_LAST_EVIDENCE=none
  LANDING_CHECK_LAST_STATUS=unknown
  LANDING_CHECK_LAST_REASON=not-observed
  for ((tick=0; tick<LANDING_CHECK_TIMEOUT_TICKS; tick++)); do
    LANDING_CHECK_ATTEMPTS=$((tick + 1))
    if landing_check_once "$pane" "$marker" "$profile_kind" "$submit"; then return 0; fi
    if [[ "$LANDING_CHECK_AMBIGUOUS" -ne 0 && -z "$LANDING_CHECK_AMBIGUOUS_REASON" ]]; then
      LANDING_CHECK_AMBIGUOUS_REASON="$LANDING_CHECK_LAST_REASON"
    fi
    [[ "$LANDING_CHECK_AMBIGUOUS" -eq 0 ]] && LANDING_CHECK_CONFIRMED=1
    if [[ "$tick" -lt $((LANDING_CHECK_TIMEOUT_TICKS - 1)) ]]; then
      delay="$(landing_check_delay "$tick")"
      sleep_for "$delay"
    fi
  done
  return 1
}

# #498: the spawn brief reaches the pane only through `panewire prompt`; the
# landing verdict is panewire's first. landing_check above stays as a
# read-only corroboration for what panewire cannot prove (its submission
# classifier only knows claude and codex, and its CLI returns an rc, not the
# delivery record). Corroboration never injects. The one exception to "only
# panewire" is rc 4: the CLI could not reach its daemon socket, so nothing was
# sent and a single direct herdr injection cannot duplicate the brief
# (hk decision/2026-09-21/task498-esc-landing-unify).
PANEWIRE_EXIT_TIMEOUT=3
PANEWIRE_EXIT_DAEMON_UNAVAILABLE=4
PANEWIRE_EXIT_CONDITION_INVALID=5
PANEWIRE_EXIT_DELIVERY_FAILURE=6

# spawn_expect_cwd CWD PANE
#
# panewire compares expect cwd with herdr's cwd string for the pane, byte for
# byte. The pane may report the logical path it was created with or its
# physical one (/tmp vs /private/tmp, a symlinked worktree), so the expect line
# uses herdr's own spelling when it names the same physical directory, and the
# physical path otherwise — a pane that is really somewhere else then fails
# panewire's preflight instead of receiving the brief.
spawn_expect_cwd() {
  local cwd="$1" pane="$2" physical reported reported_physical
  physical="$(cd -- "$cwd" 2>/dev/null && pwd -P)" || physical=""
  reported="$("$HERDR" agent list 2>/dev/null |
    python3 -c 'import json,sys; p=sys.argv[1]; a=json.load(sys.stdin)["result"]["agents"]; v=next((x.get("cwd") for x in a if x.get("pane_id")==p),""); print(v if isinstance(v,str) else "")' "$pane" \
    2>/dev/null)" || reported=""
  if [[ -n "$reported" && -n "$physical" ]]; then
    reported_physical="$(cd -- "$reported" 2>/dev/null && pwd -P)" || reported_physical=""
    if [[ "$reported_physical" == "$physical" ]]; then
      printf '%s' "$reported"
      return 0
    fi
  fi
  printf '%s' "$physical"
}

# spawn_prompt_file ATTEMPT
#
# panewire keys a delivery on sender, target, file path, body hash and uptake,
# and answers a repeated key from its cache without sending again. Every
# attempt therefore gets a fresh absolute path: the one re-injection below must
# be a new delivery, and a re-spawn of the same job must not be served the old
# delivery's cached verdict.
spawn_prompt_file() {
  local attempt="$1" dir file
  dir="$(wrk_jobs_root)/$JOB_ID"
  if ! mkdir -p "$dir" 2>/dev/null || ! dir="$(cd -- "$dir" && pwd -P)" ||
    ! file="$(mktemp "$dir/spawn-brief-$attempt.XXXXXX" 2>/dev/null)"; then
    file="$(mktemp "${TMPDIR:-/tmp}/wrk-spawn-brief-$attempt.XXXXXX")" || return 1
  fi
  {
    # The catalog marker must reach the spawned agent itself, not only wrk's
    # stderr: a brief produced from the launcher's own table instead of the
    # canon has to say so where the work is read. It rides on a `wrk-note:`
    # line in the body, NOT on the expect: header — panewire's parsePromptFile
    # (prompt.go, deployed pw-6d0562e) accepts only name/label/cwd/title~/recent~
    # and rejects an unknown field with rc=5 before the send boundary, which
    # silently dropped the whole brief (#667).
    local catalog_note=""
    [[ "${CATALOG_STALE:-0}" -ne 1 ]] || catalog_note="wrk-note: catalog=stale"$'\n'
    if [[ -n "$SPAWN_EXPECT_CWD" ]]; then
      printf 'expect: name=%s cwd=%s\n%s\n' "$LABEL" "$SPAWN_EXPECT_CWD" "$catalog_note"
    else
      printf 'expect: name=%s\n%s\n' "$LABEL" "$catalog_note"
    fi
    cat -- "$PROMPT"
  } >"$file" || return 1
  printf '%s' "$file"
}

# spawn_panewire_prompt ATTEMPT
#
# One `panewire prompt` delivery. No --uptake: both uptake modes refuse a
# target that is already `working`, and a cold-booting pane can report working
# before its composer is ready. Sets SPAWN_SUBMIT to one of
#   proven       rc 0 — panewire observed the submission
#   accepted     rc 6 after herdr took the prompt (submission unproven or still
#                in the composer): sent; only corroboration may say more
#   unconfirmed  rc 3, 6 (herdr rejected), 124 guard, anything unknown: it may
#                or may not have been sent, so it is never sent again
#   unsent       rc 2 or 5: panewire refused before the send boundary
#   daemon       rc 4 or no panewire binary: nothing was sent
spawn_panewire_prompt() {
  local attempt="$1" panewire file err rc=0 seconds
  SPAWN_SUBMIT=daemon
  SPAWN_PANEWIRE_RC=""
  SPAWN_PANEWIRE_ERR=""
  panewire="$(command -v "${PANEWIRE_BIN:-panewire}" 2>/dev/null || true)"
  if [[ -z "$panewire" ]]; then
    SPAWN_PANEWIRE_RC=missing
    SPAWN_PANEWIRE_ERR="panewire-not-found"
    return 0
  fi
  if ! file="$(spawn_prompt_file "$attempt")"; then
    SPAWN_SUBMIT=unsent
    SPAWN_PANEWIRE_RC="file"
    SPAWN_PANEWIRE_ERR="prompt-file-unwritable"
    return 0
  fi
  SPAWN_PROMPT_FILES+=("$file")
  seconds="$SPAWN_PANEWIRE_TIMEOUT_SECONDS"
  round_ext_builder_recheck
  # The daemon enforces --timeout itself; the outer guard only covers a wedged
  # socket, which would otherwise hang the spawn with the gates already held.
  err="$(run_bounded $((seconds + 15)) "$panewire" prompt --from "wrk-spawn:$JOB_ID" --to "$LABEL" \
    --file "$file" --timeout "${seconds}s" 2>&1 >/dev/null)" || rc=$?
  SPAWN_PANEWIRE_RC="$rc"
  SPAWN_PANEWIRE_ERR="$(printf '%s' "$err" | tr -s '[:space:]' ' ' | cut -c1-160)"
  case "$rc" in
    0) SPAWN_SUBMIT=proven ;;
    "$PANEWIRE_EXIT_DAEMON_UNAVAILABLE") SPAWN_SUBMIT=daemon ;;
    2|"$PANEWIRE_EXIT_CONDITION_INVALID") SPAWN_SUBMIT=unsent ;;
    # A timeout may fall on either side of the send boundary.
    "$PANEWIRE_EXIT_TIMEOUT") SPAWN_SUBMIT=unconfirmed ;;
    "$PANEWIRE_EXIT_DELIVERY_FAILURE")
      # These two messages are only produced after herdr accepted agent.prompt
      # (prompt.go: pollSubmission result), so the brief did leave wrk.
      if grep -Eq 'submission evidence unproven|prompt remains in composer' <<<"$err"; then
        SPAWN_SUBMIT=accepted
      else
        SPAWN_SUBMIT=unconfirmed
      fi
      ;;
    *) SPAWN_SUBMIT=unconfirmed ;;
  esac
  return 0
}

# opencode needs a separate return after the paste to submit (pre-#498
# behavior, kept verbatim). Only after a delivery that may have been pasted.
spawn_opencode_submit() {
  [[ "$PROFILE_KIND" == opencode ]] || return 0
  case "$SPAWN_SUBMIT" in proven|accepted|unconfirmed) ;; *) return 0 ;; esac
  sleep_for 2
  "$HERDR" agent send-keys "$PANE" return >/dev/null 2>&1 || true
}

# spawn_herdr_fallback — the rc 4 path, entered at most once per spawn. It is
# the pre-#498 direct injection, without its re-injection: a second direct
# send would be a second fallback.
spawn_herdr_fallback() {
  round_ext_builder_recheck
  SPAWN_VIA=herdr-fallback
  SPAWN_FALLBACKS=$((SPAWN_FALLBACKS + 1))
  if [[ "$PROFILE_KIND" == opencode ]]; then
    "$HERDR" agent prompt "$PANE" "$PROMPT_PAYLOAD" >/dev/null 2>&1 || true
    sleep_for 2
    "$HERDR" agent send-keys "$PANE" return >/dev/null 2>&1 || true
  elif ! "$HERDR" agent prompt "$PANE" "$PROMPT_PAYLOAD" --wait \
    --until working --until idle --until "done" --until blocked --timeout 40000 >/dev/null 2>&1; then
    "$HERDR" agent send-keys "$PANE" return >/dev/null 2>&1 || true
  fi
}

# spawn_deliver_brief — sets LANDING (yes|retry|no), SPAWN_VIA and, when not
# landed, LANDING_NO_DETAIL.
spawn_deliver_brief() {
  local detail retry_skip_reason
  SPAWN_VIA=panewire
  SPAWN_FALLBACKS=0
  SPAWN_PROMPT_FILES=()
  LANDING=no
  PROMPT_PAYLOAD="$(<"$PROMPT")"
  PROMPT_MARKER="$(prompt_marker "$PROMPT")"
  SPAWN_EXPECT_CWD="$(spawn_expect_cwd "$CWD" "$PANE")"

  spawn_panewire_prompt 1
  spawn_opencode_submit
  local first="panewire_rc=$SPAWN_PANEWIRE_RC submit=$SPAWN_SUBMIT"
  [[ -z "$SPAWN_PANEWIRE_ERR" ]] || first="$first panewire_err=\"$SPAWN_PANEWIRE_ERR\""
  case "$SPAWN_SUBMIT" in
    proven)
      LANDING=yes
      return 0
      ;;
    unsent)
      LANDING_NO_DETAIL="phase=initial $first action=landed-no retry=skipped reason=panewire-refused-before-send"
      return 0
      ;;
    daemon)
      spawn_herdr_fallback
      # The fallback injected through herdr directly, so a post-injection
      # observation attaches to a delivery that definitely happened.
      if landing_check "$PANE" "$PROMPT_MARKER" "$PROFILE_KIND" accepted; then
        LANDING=yes
      else
        detail="$(landing_check_detail)"
        LANDING_NO_DETAIL="phase=initial $first via=herdr-fallback $detail action=landed-no retry=skipped reason=fallback-once"
      fi
      return 0
      ;;
  esac

  # accepted | unconfirmed: panewire could not prove it. Observe only.
  if landing_check "$PANE" "$PROMPT_MARKER" "$PROFILE_KIND" "$SPAWN_SUBMIT"; then
    LANDING=yes
    return 0
  fi
  detail="$(landing_check_detail)"
  # Grok is never re-injected: its echo can outlive even the extended window,
  # so a confirmed-looking non-landing can still be a brief in flight, and a
  # second injection is the duplicate-brief risk this lane exists to avoid.
  if [[ "$SPAWN_SUBMIT" == accepted && "$PROFILE_KIND" != grok &&
        "$LANDING_CHECK_CONFIRMED" -eq 1 && "$LANDING_CHECK_AMBIGUOUS" -eq 0 ]]; then
    # herdr took the first delivery and the whole window found no marker and
    # no queued chip: confirmed non-landing. Exactly one re-injection, again
    # through panewire, as a new delivery.
    warn "landing window expired; pane=$PANE phase=initial $first $detail action=reinject-once"
    spawn_panewire_prompt 2
    spawn_opencode_submit
    local second="panewire_rc=$SPAWN_PANEWIRE_RC submit=$SPAWN_SUBMIT"
    [[ -z "$SPAWN_PANEWIRE_ERR" ]] || second="$second panewire_err=\"$SPAWN_PANEWIRE_ERR\""
    case "$SPAWN_SUBMIT" in
      proven) LANDING=retry; return 0 ;;
      accepted|unconfirmed)
        if landing_check "$PANE" "$PROMPT_MARKER" "$PROFILE_KIND" "$SPAWN_SUBMIT"; then
          LANDING=retry
          return 0
        fi
        detail="$(landing_check_detail)"
        ;;
    esac
    LANDING_NO_DETAIL="phase=retry $second $detail action=landed-no"
    return 0
  fi
  if [[ "$SPAWN_SUBMIT" != accepted ]]; then
    retry_skip_reason='prompt-submission-unconfirmed'
  elif [[ "$LANDING_CHECK_AMBIGUOUS" -ne 0 ]]; then
    retry_skip_reason='ambiguous-observation'
  elif [[ "$PROFILE_KIND" == grok ]]; then
    retry_skip_reason='grok-never-reinjected'
  else
    retry_skip_reason='non-landing-not-confirmed'
  fi
  LANDING_NO_DETAIL="phase=initial $first $detail action=landed-no retry=skipped reason=$retry_skip_reason"
}

# Print the [thinking] effort value of a Kimi CLI home's config.toml (empty
# when absent/unparseable). Used by the #704 E6 kimi rungs to prove the pinned
# clone home actually runs the requested effort — the kimi CLI has no
# --effort flag, so the clone config is the only place the rung exists.
kimi_clone_thinking_effort() {
  kimi_clone_resolved_effort "$1" ""
}

# Print the effort a Kimi home resolves to for a given spawned model id, in
# Kimi Code's documented precedence:
#   1. [thinking].enabled = false resolves to the model's off_effort —
#      Thinking is off, so no configured/default effort applies (a model
#      marked always_thinking ignores the flag).
#   2. KIMI_MODEL_THINKING_EFFORT overlays the effort at runtime and bypasses
#      support_efforts — when exported it is the rung.
#   3. Otherwise the [thinking] effort when the model accepts it (no
#      [models."<id>"] table, or a support_efforts list that contains it),
#      else that model's default_effort — Kimi Code falls back to the model
#      default for a missing or unsupported request. Keys under
#      [models."<id>".overrides] override the base model entry.
# config.toml is real TOML — dotted keys, inline tables, string escapes,
# multiline strings and indented headers are all equivalent spellings — so
# the authoritative read is a python3 tomllib/tomli parse; an awk scan
# covers only the common table forms when no TOML lib is importable. With no
# readable config the bounded env overlay alone resolves (kimi applies it
# with no file); empty when nothing resolves: fail-open — the kimi argv
# carries no rung either way.
kimi_clone_resolved_effort() {
  local cfg="$1" model="$2" out env_eff="${KIMI_MODEL_THINKING_EFFORT:-}"
  if [[ ! -r "$cfg" ]]; then
    # No file to parse, but kimi still applies the env overlay — bound and
    # normalize it exactly like the python/awk paths or "MAX" slips past the
    # case-sensitive seat rule on spelling alone.
    local norm
    norm="${env_eff#"${env_eff%%[![:space:]]*}"}"
    norm="${norm%"${norm##*[![:space:]]}"}"
    norm="$(printf '%s' "$norm" | tr '[:upper:]' '[:lower:]')"
    case "$norm" in
      minimal|low|medium|high|xhigh|max|ultra|off|on) printf '%s\n' "$norm" ;;
    esac
    return 0
  fi
  if out="$(KIMI_EFFORT_ENV="$env_eff" python3 - "$cfg" "$model" 2>/dev/null <<'PY'
import os, sys
try:
    import tomllib
except ImportError:
    import tomli as tomllib
with open(sys.argv[1], "rb") as fh:
    cfg = tomllib.load(fh)
def table(v):
    return v if isinstance(v, dict) else {}
def string(v):
    return v if isinstance(v, str) else None
def truthy(v):
    return v is True or (isinstance(v, str) and v.lower() in ("1", "true", "yes", "on"))
thinking = table(cfg.get("thinking"))
model = table(table(cfg.get("models")).get(sys.argv[2]))
over = table(model.get("overrides"))
def pick(key):
    return over.get(key, model.get(key))
def strings(v):
    return [x for x in v if isinstance(x, str)] if isinstance(v, list) else None
effort = string(thinking.get("effort"))
support = strings(pick("support_efforts"))
default = string(pick("default_effort"))
off = string(pick("off_effort"))
caps = set(strings(pick("capabilities")) or [])
# always-thinking is declared two ways: an always_thinking model field or an
# "always_thinking" capability tag (either can sit under overrides). In both
# shapes enabled=false does not take the model off.
always = truthy(pick("always_thinking")) or "always_thinking" in caps
if thinking.get("enabled") is False and not always:
    print(off or "")
    raise SystemExit(0)
env_eff = (os.environ.get("KIMI_EFFORT_ENV") or "").strip().lower()
if env_eff in {"minimal", "low", "medium", "high", "xhigh", "max", "ultra", "off", "on"}:
    print(env_eff)
    raise SystemExit(0)
if effort == "off" and not always:
    print("off")
    raise SystemExit(0)
resolved = effort
if model and (resolved is None or (support is not None and resolved not in support)):
    resolved = default
print(resolved or "")
PY
)"; then
    printf '%s\n' "$out"
    return 0
  fi
  # awk fallback for hosts with no importable TOML lib: common table forms
  # only — dotted keys, inline tables, string escapes and multiline strings
  # need the real parser above.
  awk -v want_model="$model" -v env_eff="$env_eff" '
    BEGIN { sq = sprintf("%c", 39) }
    function unq(s) {
      sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s)
      if (s ~ /^".*"$/) return substr(s, 2, length(s) - 2)
      if (substr(s, 1, 1) == sq && substr(s, length(s), 1) == sq)
        return substr(s, 2, length(s) - 2)
      return ""
    }
    function rhs(   v) {
      v = $0
      sub(/^[^=]*=[[:space:]]*/, "", v)
      sub(/[[:space:]]+#.*$/, "", v)
      return unq(v)
    }
    function rawrhs(   v) {
      v = $0
      sub(/^[^=]*=[[:space:]]*/, "", v); sub(/[[:space:]]*#.*$/, "", v)
      sub(/^[[:space:]]+/, "", v); sub(/[[:space:]]+$/, "", v)
      return v
    }
    /^[[:space:]]*\[/ {
      h = $0
      sub(/^[[:space:]]*\[/, "", h); sub(/\].*$/, "", h)
      gsub(/[[:space:]]/, "", h)
      in_thinking = (h == "thinking")
      in_model = 0
      if (want_model != "" && h ~ /^models\./) {
        mh = substr(h, 8)
        sub(/\.overrides$/, "", mh)
        if (unq(mh) == want_model) { in_model = 1; m_seen = 1 }
      }
      next
    }
    collecting {
      sup = sup " " $0
      if ($0 ~ /\]/) collecting = 0
      next
    }
    c_collecting {
      caps = caps " " $0
      if ($0 ~ /\]/) c_collecting = 0
      next
    }
    in_thinking && $0 ~ /^[[:space:]]*effort[[:space:]]*=/ { t = rhs(); next }
    in_thinking && $0 ~ /^[[:space:]]*enabled[[:space:]]*=/ { en = rawrhs(); next }
    in_model && $0 ~ /^[[:space:]]*always_thinking[[:space:]]*=/ { at = rawrhs(); next }
    in_model && $0 ~ /^[[:space:]]*capabilities[[:space:]]*=/ {
      caps = $0; c_seen = 1
      if (caps !~ /\]/) c_collecting = 1
      next
    }
    in_model && $0 ~ /^[[:space:]]*off_effort[[:space:]]*=/ { o = rhs(); next }
    in_model && $0 ~ /^[[:space:]]*default_effort[[:space:]]*=/ { d = rhs(); next }
    in_model && $0 ~ /^[[:space:]]*support_efforts[[:space:]]*=/ {
      sup = $0; s_seen = 1
      if (sup !~ /\]/) collecting = 1
      next
    }
    END {
      if (s_seen) {
        rest = sup
        while (match(rest, /"[^"]*"/)) {
          S[substr(rest, RSTART + 1, RLENGTH - 2)] = 1
          rest = substr(rest, RSTART + RLENGTH)
        }
        rest = sup
        while (match(rest, sq "[^" sq "]*" sq)) {
          S[substr(rest, RSTART + 1, RLENGTH - 2)] = 1
          rest = substr(rest, RSTART + RLENGTH)
        }
      }
      if (c_seen) {
        rest = caps
        while (match(rest, /"[^"]*"/)) {
          C[substr(rest, RSTART + 1, RLENGTH - 2)] = 1
          rest = substr(rest, RSTART + RLENGTH)
        }
        rest = caps
        while (match(rest, sq "[^" sq "]*" sq)) {
          C[substr(rest, RSTART + 1, RLENGTH - 2)] = 1
          rest = substr(rest, RSTART + RLENGTH)
        }
      }
      always = (at == "true" || ("always_thinking" in C))
      if (en == "false" && !always) { print o; exit }
      if (env_eff != "") {
        e = tolower(env_eff)
        if (e ~ /^(minimal|low|medium|high|xhigh|max|ultra|off|on)$/) { print e; exit }
      }
      if (t == "off" && !always) { print "off"; exit }
      r = t
      if (m_seen && (t == "" || (s_seen && !(t in S)))) r = d
      print r
    }
  ' "$cfg"
}

# Kimi opens a folder-trust modal for an unregistered CWD. Seed only the
# workspace-trust entry it needs, before the agent starts. This is deliberately
# fail-open: trust seeding is a convenience and must never deny a Kimi spawn.
kimi_seed_workspace_trust() {
  local cwd="$1" kimi_home="$2" abs_cwd basename_path digest trust_dir trust_file trust_json

  if ! abs_cwd="$(cd -- "$cwd" 2>/dev/null && pwd -P)"; then
    warn "Kimi workspace trust seed skipped: cannot resolve absolute CWD: $cwd"
    return 0
  fi
  basename_path="${abs_cwd##*/}"
  # ROB-1307: kimi(0.37.2 실측 2건으로 역공학)는 trust 파일명을
  # wd_<sanitized>_<sha256(abs)[:12]> 로 조회하며, sanitized = basename 소문자화
  # → 앞 40자 절단 → 꼬리의 비영숫자 제거(절단이 '-' 등 구분자에서 끊긴 경우).
  # 원형 basename 으로 시딩하면 대문자/40자 초과 이름에서 미신뢰 판정 → Trust
  # 다이얼로그(기본 Don't trust=종료)가 브리프 주입 Enter 에 눌려 스폰이 죽는다.
  # (미지 문자 처리 규칙은 미관측 — worktree 이름은 [A-Za-z0-9._-] 라 이 범위로 충분)
  basename_path="$(printf '%s' "$basename_path" | tr '[:upper:]' '[:lower:]')"
  basename_path="${basename_path:0:40}"
  while [[ -n "$basename_path" ]] && ! ascii_re "${basename_path: -1}" '[a-z0-9]'; do
    basename_path="${basename_path%?}"
  done
  if ! digest="$(printf '%s' "$abs_cwd" | shasum -a 256 2>/dev/null | awk '{print $1}')" || [[ ${#digest} -lt 12 ]]; then
    warn "Kimi workspace trust seed skipped: cannot hash absolute CWD: $abs_cwd"
    return 0
  fi

  trust_dir="$kimi_home/workspace-trust"
  trust_file="$trust_dir/wd_${basename_path}_${digest:0:12}"
  if [[ -e "$trust_file" ]]; then
    echo "wrk: Kimi workspace trust exists: $trust_file" >&2
    return 0
  fi
  if ! mkdir -p -- "$trust_dir" 2>/dev/null; then
    warn "Kimi workspace trust seed skipped: cannot create $trust_dir"
    return 0
  fi
  if ! trust_json="$(python3 - "$abs_cwd" <<'PY'
import json
import sys
import time

print(json.dumps({"root": sys.argv[1], "trustedAt": int(time.time() * 1000)}, separators=(",", ":")))
PY
)"; then
    warn "Kimi workspace trust seed skipped: cannot encode $trust_file"
    return 0
  fi

  # noclobber keeps an existing entry immutable even if another spawn races
  # between the existence check and this write.
  if ! (umask 077; set -C; printf '%s\n' "$trust_json" >"$trust_file") 2>/dev/null; then
    if [[ -e "$trust_file" ]]; then
      echo "wrk: Kimi workspace trust exists: $trust_file" >&2
    else
      warn "Kimi workspace trust seed skipped: cannot write $trust_file"
    fi
    return 0
  fi
  echo "wrk: Kimi workspace trust seeded: $trust_file" >&2
}

# Devin 3000.11.x enforces workspace trust at startup: an untrusted cwd stops
# at the "Do you trust the contents of this directory?" screen, which the
# readiness window then reports as agent-not-detected (the 2026-09-28 Pi spawn
# failure, task 912). --respect-workspace-trust false in the spawn argv covers
# only non-interactive --print mode (devin docs reference/commands.mdx), so the
# TUI still prompts. wrk therefore registers the resolved spawn cwd — and only
# it — in devin's trusted-workspaces store before the pane exists.
#
# Store: ${XDG_DATA_HOME:-$HOME/.local/share}/devin/cli/trusted_workspaces.json
# — the file devin reads in user-config/src/trusted_workspaces.rs (binary
# strings: trusted_workspaces.json, trusted_paths, XDG_DATA_HOME plus the
# .local/share/devin/cli segments; confirmed live on macOS 3000.11.3, where it
# is NOT under ~/Library/Application Support). Same path rule on macOS and
# Linux. Shape: {"trusted_paths": ["/abs/dir", ...]}; trust inherits into
# subfolders.
#
# Unlike the kimi seed this is fail CLOSED: a missing or corrupt store means
# the operator's trust state is unknown, and the fallback is a modal prompt a
# spawned pane cannot answer — so the spawn is refused before any pane exists
# rather than silently creating or overwriting the file.
devin_seed_workspace_trust() {
  local cwd="$1" abs_cwd trust_file
  if ! abs_cwd="$(cd -- "$cwd" 2>/dev/null && pwd -P)"; then
    die "cannot resolve Devin spawn CWD to an absolute path: $cwd"
  fi
  trust_file="${XDG_DATA_HOME:-$HOME/.local/share}/devin/cli/trusted_workspaces.json"
  python3 - "$abs_cwd" "$trust_file" <<'PY'
import fcntl
import json
import os
import sys
import tempfile
import time

cwd = sys.argv[1]
path = os.path.realpath(sys.argv[2])


def refuse(reason):
    sys.stderr.write("wrk: Devin workspace trust refused: %s\n" % reason)
    sys.exit(1)


if not os.path.isdir(cwd):
    refuse("spawn cwd does not resolve to a directory: %s" % cwd)
# A missing store means devin has never been provisioned on this host (or the
# file was lost): refuse instead of guessing a fresh store.
if not os.path.isfile(path):
    refuse("store missing: %s — trust a directory in devin once or restore the file; not creating it" % path)

# The lock file is created once and never replaced, so flock always serializes
# on one inode. The data file itself is atomically replaced below, so it must
# be read fresh under the lock — a second spawn then sees the first spawn's
# committed entry and keeps it.
lock_path = path + ".wrk.lock"
try:
    lock_fd = open(lock_path, "a+b")
except OSError as exc:
    refuse("cannot open lock %s: %s" % (lock_path, exc))

with lock_fd:
    fcntl.flock(lock_fd, fcntl.LOCK_EX)
    try:
        try:
            with open(path, "rb") as handle:
                raw = handle.read()
        except OSError as exc:
            refuse("cannot read store %s: %s" % (path, exc))
        try:
            data = json.loads(raw)
        except ValueError as exc:
            refuse("store is not valid JSON: %s (%s) — refusing to overwrite a corrupt file" % (path, exc))
        paths = data.get("trusted_paths") if isinstance(data, dict) else None
        if not isinstance(paths, list) or not all(isinstance(entry, str) for entry in paths):
            refuse("store has no trusted_paths string list: %s — refusing to overwrite" % path)

        target = os.path.realpath(cwd)

        def covered():
            for entry in paths:
                base = os.path.realpath(entry) if os.path.isabs(entry) else ""
                if not base:
                    continue
                try:
                    # The entry itself or any ancestor of cwd covers it: devin
                    # inherits trust into subfolders.
                    if os.path.commonpath((base, target)) == base:
                        return True
                except ValueError:
                    continue
            return False

        if covered():
            sys.stderr.write("wrk: Devin workspace trust already covers %s in %s\n" % (cwd, path))
            sys.exit(0)

        # WRK_TEST_TRUST_DELAY_S (tests only) holds the read->write gap open so
        # a lockless or stale-read mutant reliably loses one concurrent entry.
        delay = float(os.environ.get("WRK_TEST_TRUST_DELAY_S") or 0)
        if delay > 0:
            time.sleep(delay)

        backup = "%s.bak-%s" % (path, time.strftime("%Y%m%d"))
        try:
            with open(backup, "wb") as handle:
                handle.write(raw)
        except OSError as exc:
            refuse("cannot write backup %s: %s — store left untouched" % (backup, exc))

        # Append only: never removes, reorders, or widens an entry.
        data["trusted_paths"] = paths + [cwd]
        blob = json.dumps(data, indent=2).encode("utf-8") + b"\n"
        mode = os.stat(path).st_mode & 0o777
        tmp_fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".trusted_workspaces.", suffix=".tmp")
        try:
            with os.fdopen(tmp_fd, "wb") as handle:
                handle.write(blob)
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(tmp, mode)
            os.replace(tmp, path)
            dir_fd = os.open(os.path.dirname(path), os.O_RDONLY)
            try:
                os.fsync(dir_fd)
            finally:
                os.close(dir_fd)
        except OSError as exc:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            refuse("atomic write failed for %s: %s" % (path, exc))
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)

sys.stderr.write("wrk: Devin workspace trust seeded %s in %s (backup %s)\n" % (cwd, path, backup))
PY
}

# #951: an unattended claude-kind spawn (opus/sonnet/haiku/fable/builder-*/cc-*)
# blocks on Claude Code's folder-trust dialog when the spawn cwd has no
# accepted-trust record — --dangerously-skip-permissions does not bypass it
# (m1b spawn blockers, agent_not_ready "blocked during startup"). Claude Code
# records an accepted dialog as projects[<absolute cwd>].hasTrustDialogAccepted
# = true in the config file at ${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json
# (verified live on claude 2.1.284: CLAUDE_CONFIG_DIR relocates .claude.json;
# file mode 0600, json.dumps indent=2). wrk writes exactly that entry — and
# only that entry — before the pane exists.
#
# Deliberately fail OPEN like the kimi seed (unlike the devin one): seeding is
# a convenience and must never deny a spawn — every refusal path warns and the
# spawn continues to whatever the dialog would have done. Writers serialize on
# a persistent flock, re-read under it, and replace the file atomically (temp
# + rename, mode preserved), so concurrent spawns cannot lose each other's
# projects and a corrupt store is never overwritten.
claude_seed_folder_trust() {
  local cwd="$1" abs_cwd cfg_home trust_file
  if ! abs_cwd="$(cd -- "$cwd" 2>/dev/null && pwd -P)"; then
    warn "Claude folder trust seed skipped: cannot resolve absolute CWD: $cwd"
    return 0
  fi
  cfg_home="${CLAUDE_CONFIG_DIR:-${HOME:-}}"
  case "$cfg_home" in
    /*) ;;
    *) warn "Claude folder trust seed skipped: config home is not absolute: $cfg_home"; return 0 ;;
  esac
  trust_file="$cfg_home/.claude.json"
  # The helper exits nonzero on every refusal; the || warn is what makes the
  # seed fail-open — it must never take the spawn down with it.
  python3 - "$abs_cwd" "$trust_file" <<'PY' || warn "Claude folder trust seed failed; spawn continues"
import fcntl
import json
import os
import sys
import tempfile
import time

cwd = sys.argv[1]
path = os.path.realpath(sys.argv[2])


def skip(reason):
    sys.stderr.write("wrk: Claude folder trust seed skipped: %s\n" % reason)
    sys.exit(1)


if not os.path.isdir(cwd):
    skip("spawn cwd does not resolve to a directory: %s" % cwd)
# The projects key is the physical path — the spawned process's getcwd() and
# Claude Code's own records resolve symlinks the same way.
target = os.path.realpath(cwd)
parent = os.path.dirname(path)
try:
    os.makedirs(parent, mode=0o700, exist_ok=True)
except OSError as exc:
    skip("cannot create config dir %s: %s" % (parent, exc))

# The lock file is created once and never replaced, so flock always serializes
# on one inode. The data file itself is atomically replaced below, so it must
# be read fresh under the lock — a second spawn then sees the first spawn's
# committed entry and keeps it.
lock_path = path + ".wrk.lock"
try:
    lock_fd = os.fdopen(os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600), "a+b")
except OSError as exc:
    skip("cannot open lock %s: %s" % (lock_path, exc))

with lock_fd:
    # Poll LOCK_EX|LOCK_NB with a deadline: a wedged holder (or a hung fs)
    # must warn and continue the spawn, not block it forever. The env knob is
    # test-only — production takes the 10s default.
    deadline = time.monotonic() + float(os.environ.get("WRK_TEST_TRUST_LOCK_TIMEOUT_S") or 10.0)
    while True:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            if time.monotonic() >= deadline:
                skip("timed out waiting for lock %s" % lock_path)
            time.sleep(0.05)
    try:
        raw = None
        if os.path.exists(path):
            try:
                with open(path, "rb") as handle:
                    raw = handle.read()
            except OSError as exc:
                skip("cannot read %s: %s" % (path, exc))
        if raw is None:
            data = {}
            mode = 0o600
        else:
            try:
                data = json.loads(raw)
            except ValueError as exc:
                skip("store is not valid JSON: %s (%s) — refusing to overwrite a corrupt file" % (path, exc))
            if not isinstance(data, dict):
                skip("store top level is not an object: %s — refusing to overwrite" % path)
            mode = os.stat(path).st_mode & 0o777

        projects = data.get("projects")
        if projects is None:
            projects = {}
            data["projects"] = projects
        elif not isinstance(projects, dict):
            skip("store projects entry is not an object: %s — refusing to overwrite" % path)

        entry = projects.get(target)
        if isinstance(entry, dict) and entry.get("hasTrustDialogAccepted") is True:
            sys.stderr.write("wrk: Claude folder trust already recorded for %s in %s\n" % (target, path))
            sys.exit(0)
        if entry is None:
            entry = {}
            projects[target] = entry
        elif not isinstance(entry, dict):
            skip("project entry for %s is not an object: %s — refusing to overwrite" % (target, path))
        entry["hasTrustDialogAccepted"] = True

        # WRK_TEST_TRUST_DELAY_S (tests only) holds the read->write gap open so
        # a lockless or stale-read mutant reliably loses one concurrent entry.
        delay = float(os.environ.get("WRK_TEST_TRUST_DELAY_S") or 0)
        if delay > 0:
            time.sleep(delay)

        # Atomic replace: temp in the same dir, fsync, rename, dir fsync —
        # mode preserved exactly, every other key (and project) untouched.
        blob = json.dumps(data, indent=2, ensure_ascii=False).encode("utf-8")
        tmp_fd, tmp = tempfile.mkstemp(dir=parent, prefix=".claude.json.", suffix=".tmp")
        try:
            with os.fdopen(tmp_fd, "wb") as handle:
                handle.write(blob)
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(tmp, mode)
            os.replace(tmp, path)
            dir_fd = os.open(parent, os.O_RDONLY)
            try:
                os.fsync(dir_fd)
            finally:
                os.close(dir_fd)
        except OSError as exc:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            skip("atomic write failed for %s: %s" % (path, exc))
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)

sys.stderr.write("wrk: Claude folder trust recorded for %s in %s\n" % (target, path))
PY
}

# Codex CLI 0.162 blocks at startup for an untrusted project cwd. Project trust
# is a TOML table in the user's config, so wrk appends one entry before the
# pane starts. Accept only a physical root of a linked Git worktree: the
# --show-toplevel equality is wrk's worktree-root rule, and the distinct
# --git-dir/common-dir pair excludes the operator's canonical checkout.
# This is fail-open: malformed config, unsafe paths and every I/O failure warn
# once and never stop the spawn. Writers hold a persistent sidecar flock,
# validate the complete append, then atomically replace the file.
codex_seed_project_trust() {
  local cwd="$1" abs_cwd output
  if ! abs_cwd="$(cd -- "$cwd" 2>/dev/null && pwd -P)"; then
    warn "Codex project trust skipped: cannot resolve absolute CWD: $cwd"
    return 0
  fi
  if ! output="$(python3 - "$abs_cwd" 2>&1 <<'PY'
import fcntl
import os
import re
import stat
import subprocess
import sys
import tempfile
import time

cwd = sys.argv[1]


def log(status, reason, mode="not-run"):
    detail = " (%s)" % reason if reason else ""
    sys.stderr.write("wrk: Codex project trust %s%s [validation=%s]\n" % (status, detail, mode))


def skip(reason, mode="not-run"):
    log("skipped", reason, mode)
    raise SystemExit(0)


if not os.path.isabs(cwd) or not os.path.isdir(cwd):
    skip("spawn cwd is not an absolute directory")
if not re.fullmatch(r"[A-Za-z0-9._/-]+", cwd):
    skip("spawn cwd contains unsupported characters")
if cwd == "/":
    skip("refusing filesystem root")

home = os.environ.get("HOME")
if not home or not os.path.isabs(home):
    skip("cannot resolve HOME")
home = os.path.realpath(home)
try:
    if os.path.commonpath((cwd, home)) == cwd:
        skip("refusing HOME or its parent")
except ValueError:
    skip("cannot compare spawn cwd with HOME")


def git_value(*args):
    try:
        result = subprocess.run(
            ["git", "-C", cwd, "rev-parse", *args],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    value = result.stdout.strip()
    return os.path.realpath(value) if value else None


worktree_root = git_value("--show-toplevel")
git_dir = git_value("--path-format=absolute", "--git-dir")
common_dir = git_value("--path-format=absolute", "--git-common-dir")
if worktree_root != cwd or not git_dir or not common_dir or git_dir == common_dir:
    skip("spawn cwd is not a linked worktree root")

config_home = os.environ.get("CODEX_HOME") or os.path.join(home, ".codex")
if not os.path.isabs(config_home):
    skip("CODEX_HOME is not absolute")
config_path = os.path.join(os.path.abspath(config_home), "config.toml")
parent = os.path.dirname(config_path)

parser = None
parser_name = "header-only"
try:
    import importlib
    parser = importlib.import_module("tomllib")
    parser_name = "tomllib"
except ImportError:
    try:
        parser = importlib.import_module("tomli")
        parser_name = "tomli"
    except ImportError:
        pass


def parse_toml(raw, path, mode):
    try:
        return parser.loads(raw.decode("utf-8"))
    except Exception:
        skip("config does not parse" if path == config_path else "appended config does not parse", mode)


try:
    os.makedirs(parent, mode=0o700, exist_ok=True)
except OSError:
    skip("cannot create config directory", parser_name)

lock_path = config_path + ".wrk.lock"
try:
    lock_fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
except OSError:
    skip("cannot open lock file", parser_name)

with os.fdopen(lock_fd, "a+b") as lock_handle:
    try:
        lock_timeout = float(os.environ.get("WRK_TEST_CODEX_TRUST_LOCK_TIMEOUT_S") or 10.0)
    except ValueError:
        skip("invalid lock timeout", parser_name)
    deadline = time.monotonic() + lock_timeout
    while True:
        try:
            fcntl.flock(lock_handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            if time.monotonic() >= deadline:
                skip("timed out waiting for lock", parser_name)
            time.sleep(0.05)
    try:
        # Replacing a leaf symlink would destroy the link instead of updating
        # its target. Directory symlinks in CODEX_HOME remain supported.
        if os.path.islink(config_path):
            skip("symlinked-config", parser_name)
        raw = None
        try:
            with open(config_path, "rb") as handle:
                raw = handle.read()
        except FileNotFoundError:
            pass
        except OSError:
            skip("cannot read config", parser_name)

        if raw is None:
            mode = 0o600
        else:
            try:
                mode = stat.S_IMODE(os.stat(config_path).st_mode)
            except OSError:
                skip("cannot stat config", parser_name)

        header = ('[projects."%s"]' % cwd).encode("ascii")
        if parser is None:
            # Without a parser, any mention is enough to avoid risking a
            # duplicate table (including alternate quoting and spacing).
            if raw is not None and cwd.encode("ascii") in raw:
                skip("unparsed-mention", parser_name)
        elif raw is not None:
            existing = parse_toml(raw, config_path, parser_name)
            projects = existing.get("projects") if isinstance(existing, dict) else None
            if isinstance(projects, dict) and cwd in projects:
                log("exists", "", parser_name)
                raise SystemExit(0)

        block = ('[projects."%s"]\ntrust_level = "trusted"\n' % cwd).encode("ascii")
        if raw is None or not raw:
            new_raw = (raw or b"") + block
        elif raw.endswith(b"\n"):
            new_raw = raw + b"\n" + block
        else:
            new_raw = raw + b"\n\n" + block

        if parser is None:
            if header not in new_raw.splitlines():
                skip("appended header validation failed", parser_name)
        else:
            updated = parse_toml(new_raw, config_path + ".new", parser_name)
            projects = updated.get("projects") if isinstance(updated, dict) else None
            project = projects.get(cwd) if isinstance(projects, dict) else None
            if not isinstance(project, dict) or project.get("trust_level") != "trusted":
                skip("appended trust validation failed", parser_name)

        try:
            test_delay = float(os.environ.get("WRK_TEST_CODEX_TRUST_DELAY_S") or 0)
        except ValueError:
            skip("invalid test delay", parser_name)
        if test_delay > 0:
            time.sleep(test_delay)

        tmp_path = None
        try:
            tmp_fd, tmp_path = tempfile.mkstemp(dir=parent, prefix=".config.toml.", suffix=".tmp")
            with os.fdopen(tmp_fd, "wb") as handle:
                handle.write(new_raw)
                os.fchmod(handle.fileno(), mode)
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(tmp_path, config_path)
            tmp_path = None
        except OSError:
            skip("atomic config write failed", parser_name)
        finally:
            if tmp_path is not None:
                try:
                    os.unlink(tmp_path)
                except OSError:
                    pass
    finally:
        try:
            fcntl.flock(lock_handle, fcntl.LOCK_UN)
        except OSError:
            pass

log("seeded", "", parser_name)
PY
)"; then
    warn "Codex project trust skipped: helper failed"
    return 0
  fi
  [[ -z "$output" ]] || printf '%s\n' "$output" >&2
}

# Pre-spawn advisory: if -c points at a *canonical* checkout (not a linked worktree)
# that is off its remote default branch, warn. Does not fail the spawn — operators
# sometimes work on canonical on purpose. Worktrees and non-git paths stay silent.
# Default branch is never hard-coded: origin/HEAD; if unresolved, skip (false positives
# would drown real warnings).
warn_if_canonical_off_default() {
  local path="$1"
  [[ -n "$path" && -d "$path" ]] || return 0

  local git_dir common_dir
  # path-format=absolute: relative .git vs absolute common-dir would false-positive.
  if ! git_dir="$(git -C "$path" rev-parse --path-format=absolute --git-dir 2>/dev/null)"; then
    return 0
  fi
  if ! common_dir="$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
    return 0
  fi
  # Linked worktree: git-dir is .../.git/worktrees/<name>, common-dir is the main .git.
  # Canonical main checkout: both resolve to the same directory.
  [[ "$git_dir" == "$common_dir" ]] || return 0

  local origin_head default_branch current_branch
  if ! origin_head="$(git -C "$path" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null)"; then
    return 0
  fi
  default_branch="${origin_head#refs/remotes/origin/}"
  [[ -n "$default_branch" && "$default_branch" != "$origin_head" ]] || return 0

  current_branch="$(git -C "$path" branch --show-current 2>/dev/null || true)"
  # Detached HEAD or empty name: treat as off-default so the operator sees it.
  if [[ -n "$current_branch" && "$current_branch" == "$default_branch" ]]; then
    return 0
  fi

  local shown="${current_branch:-DETACHED}"
  warn "canonical checkout is not on default branch: path=$path current=$shown default=$default_branch — recover: git -C $(printf '%q' "$path") switch $(printf '%q' "$default_branch")"
}

quota_gate() {
  GATE_OUTPUT=""
  GATE_READY=0
  if [[ -z "$SCOPEFUEL" ]]; then
    SCOPEFUEL="$(command -v scopefuel 2>/dev/null || true)"
  fi
  if [[ -z "$SCOPEFUEL" || ! -e "$SCOPEFUEL" ]]; then
    warn "scopefuel unavailable; quota gate skipped during installation transition"
    return 0
  fi
  if [[ ! -x "$SCOPEFUEL" ]]; then
    echo "wrk: scopefuel exists but is not executable: $SCOPEFUEL" >&2
    return 126
  fi
  local probe probe_rc
  set +e
  probe="$("$SCOPEFUEL" gate --help 2>&1)"
  probe_rc=$?
  set -e
  if [[ "$probe_rc" -ne 0 ]]; then
    if grep -Eiq "(unknown (command|subcommand).*gate|invalid choice.*gate|no such command.*gate|unrecognized.*gate|not a valid command.*gate)" <<<"$probe"; then
      warn "installed scopefuel has no gate subcommand; quota gate skipped during installation transition"
      return 0
    fi
    [[ -z "$probe" ]] || printf '%s\n' "$probe" >&2
    return "$probe_rc"
  fi
  # stdout is captured (not swallowed) so arbiter can read the pool that scopefuel
  # itself resolved for this profile. It is re-printed verbatim; stderr is untouched.
  # --operator-request/--requested-by are forwarded verbatim when given — wrk holds
  # no REF format or profile-applicability judgement; the gate's fail-closed
  # refusal exits (0/3/4 vocabulary; 5 = role denial per task #527, remapped
  # to wrk exit 77) are propagated below.
  # --purpose is forwarded verbatim too: it is the gate's role input for the
  # astra profiles (task #527) — without it the gate role-denies them (gate
  # rc 5, surfaced by wrk as exit 77).
  local gate_args=(gate -m "$GATE_PROFILE")
  # #704: only the E6 per-rung builder spellings set GATE_EFFORT_PIN — for them
  # the gate must judge that rung's row (scopefuel #692 --effort), which the
  # matching SCOPEFUEL_E6_ARM marker (enforced in resolve_profile) then opens.
  # Every other profile keeps the exact pre-existing gate argv.
  [[ -z "${GATE_EFFORT_PIN:-}" ]] || gate_args+=(--effort "$GATE_EFFORT_PIN")
  [[ -z "${OPERATOR_REQUEST:-}" ]] || gate_args+=(--operator-request "$OPERATOR_REQUEST")
  [[ -z "${REQUESTED_BY:-}" ]] || gate_args+=(--requested-by "$REQUESTED_BY")
  [[ -z "${PURPOSE:-}" ]] || gate_args+=(--purpose "$PURPOSE")
  if [[ "$MODEL" == codex-astra || "$MODEL" == fable ]]; then
    gate_args+=(--role "$ROLE")
  fi
  local out rc
  set +e
  out="$("$SCOPEFUEL" "${gate_args[@]}")"
  rc=$?
  set -e
  [[ -z "$out" ]] || printf '%s\n' "$out"
  case "$rc" in
    0) GATE_OUTPUT="$out"; GATE_READY=1; return 0 ;;
    # task #527: gate rc 5 is a ROLE denial (e.g. astra without an allowed
    # --purpose) — not a quota refusal; it must never be read as "quota
    # exhausted, retry after reset" (the ARCHITECT.md:6 misread). wrk remaps
    # it to exit 77: exit 5 already belongs to quota_hub_policy_gate's
    # hub-quota-policy denial, and sharing it would let a caller read a role
    # denial as a quota denial — the exact confusion this change exists to end.
    5) echo "wrk: scopefuel gate role-denied (gate exit 5 → wrk exit 77) — purpose not allowed or missing; NOT a quota refusal" >&2; exit 77 ;;
    3|4) exit "$rc" ;;
    *) echo "wrk: scopefuel gate failed (exit $rc)" >&2; return "$rc" ;;
  esac
}

# The local scopefuel gate remains the only profile-to-pool authority. This
# second gate adds hub-owned placement policy only after scopefuel allowed the
# profile and exposed its pool in the stable first stdout line. The panewire
# CLI owns transport/auth/response classification: only exit 4 is eligible for
# the approved local-only fallback.
quota_hub_policy_gate() {
  local hub_url token_env cf_env quota_gate first_line field pool="" panewire rc
  local gate_fields=() args=()
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  token_env="$(spillover_value hub hub_token_env 2>/dev/null || true)"
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"

  # Only the operator credential opts this gate in: a configured
  # hub_token_env means this installation enabled hub quota policy.
  # hub_url/hub_cf_env without it — and a lanes-only lanes_token_env, which
  # this gate never reads (#1037: a node token may serve the lanes routes
  # only) — preserve the exact pre-hub local-only path. A partial operator
  # config is different: hub_token_env without hub_url is an operator error,
  # and silently treating it as absent would turn it into permissive policy.
  #
  # #1138: quota_gate = "local" is the explicit opt-out for a host that keeps
  # a [hub] section without enabling hub quota policy (a lanes-only host such
  # as M1). Both config checks — and the skipped-gate warning — run ahead of
  # the evidence early-returns below so a malformed key fails closed on every
  # spawn that reaches this gate, never silently.
  if quota_gate="$(spillover_value hub quota_gate 2>/dev/null)"; then
    if [[ "$quota_gate" != local ]]; then
      echo "wrk: [hub] quota_gate accepts only \"local\"; refusing spawn" >&2
      return 70
    fi
    if [[ -n "$token_env" ]]; then
      echo "wrk: [hub] quota_gate = \"local\" contradicts hub_token_env; remove one of the two keys" >&2
      return 70
    fi
    return 0
  fi
  if [[ -n "$hub_url" && -z "$token_env" && "${HUB_QUOTA_GATE_WARNED:-0}" -eq 0 ]]; then
    HUB_QUOTA_GATE_WARNED=1
    warn "[hub] hub_url is set but hub_token_env is not; hub quota gate skipped (local scopefuel gate only)"
  fi

  # P5: a durable arbiter registration is the only evidence that permits hub
  # contact. Absent/transitional arbiter keeps the pre-existing local-only path.
  [[ "${ARBITER_JOB_REGISTERED:-0}" -eq 1 ]] || return 0
  [[ "${GATE_READY:-0}" -eq 1 ]] || return 0

  if [[ -z "$token_env" ]]; then
    return 0
  fi
  if [[ -z "$hub_url" ]]; then
    echo "wrk: hub quota gate configuration is incomplete; refusing local fallback" >&2
    return 70
  fi

  IFS= read -r first_line <<<"$GATE_OUTPUT" || true
  read -r -a gate_fields <<<"$first_line"
  for field in "${gate_fields[@]}"; do
    case "$field" in
      pool=*) pool="${field#pool=}"; break ;;
    esac
  done
  if ! ascii_re "$pool" '^[a-z][a-z0-9._-]{0,63}$'; then
    echo "wrk: scopefuel gate output has no valid pool; hub quota gate failed closed" >&2
    return 70
  fi

  panewire="${PANEWIRE_BIN:-panewire}"
  if [[ "$panewire" == */* ]]; then
    [[ -x "$panewire" ]] || {
      echo "wrk: panewire quota gate is unavailable; refusing local fallback" >&2
      return 70
    }
  elif ! command -v "$panewire" >/dev/null 2>&1; then
    echo "wrk: panewire quota gate is unavailable; refusing local fallback" >&2
    return 70
  fi

  args=(place --class worker --cwd "$CWD" --pool "$pool" --hub-url "$hub_url" --hub-token-env "$token_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  set +e
  "$panewire" "${args[@]}" >/dev/null 2>&1
  rc=$?
  set -e
  case "$rc" in
    0) return 0 ;;
    4) warn "hub quota policy unavailable; using local scopefuel result"; return 0 ;;
    5) echo "wrk: hub quota policy denied" >&2; return 5 ;;
    6) echo "wrk: hub quota policy authentication failed" >&2; return 6 ;;
    70) echo "wrk: hub quota policy response rejected" >&2; return 70 ;;
    2) echo "wrk: hub quota policy invocation rejected" >&2; return 2 ;;
    *) echo "wrk: hub quota policy failed closed (panewire exit $rc)" >&2; return 70 ;;
  esac
}

# ROB-1199: admission control. The quota gate answers "how much is left"; arbiter
# answers "who holds it". fail-closed everywhere except a genuinely absent tool.
# ROB-1214: a failed spawn must not leave its tab behind. Every retry used to
# stack another dead tab in the workspace (measured 2026-08-05: 11 shell-only
# panes in w16, krb0-v alone retried into 3 tabs) — invisible to agent-list
# based sweeps because the agent process is gone. Armed after tab create,
# disarmed at the success line alongside ARBITER_HELD=0.
# hk 1895: a failed spawn's screen explains WHY it failed (the 2026-10-24
# agent_not_ready wave was an "Update available" prompt nobody could see —
# the pane was closed on every failure). Before closing, capture what the
# pane still shows into the job directory. The read runs under run_bounded
# so a herdr that never returns cannot hang a spawn EXIT trap. The screen
# can carry account, model or path text, so it is written 0600 and never
# echoed to stdout/stderr. A second failure of the same job writes
# spawn-failure-screen-2.txt, then -3, never overwriting.
spawn_capture_failed_pane_screen() {
  [[ -n "${JOB_ID:-}" && -n "${PANE:-}" ]] || return 0
  local dir screen n=1
  dir="$(wrk_jobs_root)/$JOB_ID"
  mkdir -p "$dir" 2>/dev/null || {
    warn "failed-pane screen capture skipped: job dir $dir could not be created"
    return 0
  }
  screen="$dir/spawn-failure-screen.txt"
  while [[ -e "$screen" ]]; do
    n=$((n + 1))
    screen="$dir/spawn-failure-screen-$n.txt"
  done
  if ( umask 077; run_bounded 5 "$HERDR" pane read "$PANE" --source recent-unwrapped --lines 200 >"$screen" ) 2>/dev/null &&
    [[ -s "$screen" ]]; then
    echo "wrk: saved failed pane screen to $screen" >&2
  else
    warn "failed-pane screen capture failed for pane $PANE"
  fi
}

spawn_pane_cleanup() {
  [[ "${SPAWN_PANE_OPEN:-0}" -eq 1 && -n "${PANE:-}" ]] || return 0
  SPAWN_PANE_OPEN=0
  spawn_capture_failed_pane_screen
  if [[ "${WRK_KEEP_FAILED_PANE:-}" == 1 ]]; then
    echo "wrk: kept failed pane $PANE (WRK_KEEP_FAILED_PANE=1); close it with herdr tab close ${TAB_ID:-its tab}" >&2
    return 0
  fi
  "$HERDR" pane close "$PANE" >/dev/null 2>&1     && echo "wrk: closed leftover pane $PANE after spawn failure" >&2     || echo "wrk: failed to close leftover pane $PANE — close it manually" >&2
}

# Temporary workaround: herdr 0.9.1's `agent start` ownership check fails for
# Devin 3000.11.1. Remove this branch once the following command succeeds with
# rc=0 against 3000.11.1 in an operator-created disposable pane:
#   herdr agent start wrk-devin-probe --kind devin --pane "$PANE_ID" --timeout 30000 -- --model swe-2 --permission-mode dangerous --respect-workspace-trust false
#
# `pane run` deliberately targets the pane id returned by this spawn's own
# `tab create`; no name lookup is allowed between creation and rename. The
# bounded idle wait replaces agent-start's readiness wait, while the observed
# explain envelope (`agent=devin`, `matched_rule.id=welcome_prompt_footer`)
# replaces its agent_kind_mismatch ownership check.
# #604: a failed Devin spawn used to leave one stderr line and a closed pane,
# so the 2026-09-23 'invalid identity envelope' failures could not be diagnosed
# after the fact (hypothesis: a first-open trust screen matched no identity
# rule — unverifiable because nothing was preserved). Before the caller's
# cleanup closes the pane, capture what it still shows into the job directory.
# Every capture is best-effort and read-only: a preservation failure must not
# mask, replace or worsen the spawn failure it documents. Raw captures use the
# .out/.err/.rc extensions, never .json — the jobs root is scanned for event
# envelopes with rglob("*.json"), and a capture holding 'not json at all' would
# break those scans (CI, 2026-09-24).
# explain_rc non-empty means the caller already ran `agent explain` and is
# handing over THAT response — possibly empty stdout — as the response that
# failed. It is preserved verbatim and never re-queried: a second explain
# would capture a later, different response and the artifact would no longer
# show what actually failed (CodeRabbit #122). explain_rc empty means the
# caller never ran explain; detected=1 then re-queries, detected=0 records an
# explicit skip so the absence does not read as "preservation forgot it".
devin_preserve_failure_artifacts() {
  local reason="$1" detected="${2:-0}" explain_rc="${3:-}" explain_json="${4:-}"
  local dir out cap_rc
  dir="$(wrk_jobs_root)/$JOB_ID"
  if ! mkdir -p "$dir" 2>/dev/null; then
    dir="$(mktemp -d "${TMPDIR:-/tmp}/wrk-devin-failure.XXXXXX" 2>/dev/null)" || {
      warn "Devin failure artifact preservation unavailable (job dir and tmpdir both unwritable)"
      return 0
    }
  fi
  out="$(mktemp -d "$dir/devin-spawn-failure-XXXXXXXX" 2>/dev/null)" || {
    warn "Devin failure artifact dir could not be created under $dir"
    return 0
  }
  {
    printf 'reason=%s\n' "$reason"
    printf 'at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'pane=%s\nlabel=%s\ncwd=%s\nmodel=%s\n' "$PANE" "$LABEL" "$CWD" "$MODEL"
  } >"$out/reason.txt" 2>/dev/null ||
    warn "Devin failure reason.txt could not be written under $out"
  if [[ -n "$explain_rc" ]]; then
    printf '%s' "$explain_json" >"$out/explain.out" 2>/dev/null ||
      warn "Devin failure explain.out could not be written under $out"
    printf 'rc=%s\n' "$explain_rc" >"$out/explain.rc" 2>/dev/null || true
  elif [[ "$detected" -eq 1 ]]; then
    set +e
    "$HERDR" agent explain "$PANE" --format json >"$out/explain.out" 2>"$out/explain.err"
    cap_rc=$?
    set -e
    printf 'rc=%s\n' "$cap_rc" >"$out/explain.rc" 2>/dev/null || true
  else
    printf 'rc=skipped\nreason=agent-not-detected\n' >"$out/explain.rc" 2>/dev/null || true
  fi
  # `pane read`/`pane process-info` do not require herdr to have detected an
  # agent, so they also work for pre-detection and shell-only failures.
  set +e
  "$HERDR" pane read "$PANE" --source visible --lines 60 >"$out/screen-visible.txt" 2>"$out/screen-visible.err"
  printf 'rc=%s\n' "$?" >"$out/screen-visible.rc"
  "$HERDR" pane read "$PANE" --source recent-unwrapped --lines 200 >"$out/transcript.txt" 2>"$out/transcript.err"
  printf 'rc=%s\n' "$?" >"$out/transcript.rc"
  "$HERDR" pane process-info --pane "$PANE" >"$out/process-info.out" 2>"$out/process-info.err"
  printf 'rc=%s\n' "$?" >"$out/process-info.rc"
  set -e
  # hk 1541: the unreadable process-info replies the readiness wait saw are
  # part of this failure's evidence — the job's pinfo-bad record is copied
  # verbatim (it may not exist when no reply was ever unreadable).
  if [[ -f "$dir/pinfo-bad" ]]; then
    cp "$dir/pinfo-bad" "$out/pinfo-bad" 2>/dev/null ||
      warn "Devin failure pinfo-bad could not be copied under $out"
  fi
  echo "wrk: Devin spawn failure artifacts preserved under $out" >&2
  printf '%s\n' "$out"
}

devin_spawn_diagnostics() {
  local reason="$1" detected="${2:-0}" explain_rc="${3:-}" explain_json="${4:-}" out source_suffix=""
  if [[ -n "${START_TIMEOUT:-}" && "$reason" == *"${START_TIMEOUT}ms"* ]]; then
    source_suffix="; timeout source: ${START_TIMEOUT_SOURCE:-agent kind default}"
  fi
  echo "wrk: Devin pane startup failed: $reason; pane=$PANE$source_suffix" >&2
  out="$(devin_preserve_failure_artifacts "$reason" "$detected" "$explain_rc" "$explain_json")"
  # The operator-facing process-info dump replays the capture preservation just
  # made: a second live call would change the pane-touch count the readiness
  # failure contract pins (the unreadable-reply run's checks + one diagnostic).
  if [[ -n "$out" && -d "$out" ]]; then
    [[ ! -s "$out/process-info.out" ]] || cat "$out/process-info.out" >&2
    [[ ! -s "$out/process-info.err" ]] || cat "$out/process-info.err" >&2
  else
    "$HERDR" pane process-info --pane "$PANE" >&2 ||
      warn "Devin pane process-info failed for pane=$PANE"
  fi
}

# `agent wait` does not wait for a pane herdr has not yet detected as an agent:
# it fails at once with agent_not_found (2026-09-22 16:44, spawn.out of
# devin-spawn-probe2). Inside the START_TIMEOUT window that code only means "not
# detected yet", so `agent get` is polled until the pane is detected. Measured
# on a disposable 3000.11.1 pane: agent_not_found at 0.07s, detected by
# `agent get` at 0.42s. Any other get failure, or the window running out,
# fails closed before rename. The attempt cap keeps the loop bounded even
# when sleep is disabled.
DEVIN_DETECT_POLL_SECONDS=0.25
DEVIN_DETECT_POLL_MS=250
devin_wait_detected() {
  local started_at="$1" attempts=0 max_attempts get_out get_rc
  max_attempts=$(( START_TIMEOUT / DEVIN_DETECT_POLL_MS ))
  while :; do
    attempts=$(( attempts + 1 ))
    set +e
    get_out="$("$HERDR" agent get "$PANE" 2>&1)"
    get_rc=$?
    set -e
    [[ "$get_rc" -eq 0 ]] && return 0
    if [[ "$get_out" != *'"code":"agent_not_found"'* ]]; then
      devin_spawn_diagnostics "agent get exited $get_rc before detection"
      return 1
    fi
    if (( attempts >= max_attempts || ($(date +%s) - started_at) * 1000 >= START_TIMEOUT )); then
      devin_spawn_diagnostics "agent not detected within ${START_TIMEOUT}ms (agent_not_found x$attempts)"
      return 1
    fi
    sleep_for "$DEVIN_DETECT_POLL_SECONDS"
  done
}

# #606: a fresh pane's shell may still be starting when wrk reaches the agent
# start. herdr treats a pane as an available shell when the shell itself holds
# the foreground with no foreground command (measured 2026-09-23 on herdr 0.9.0:
# `agent start` was accepted 0.07s after tab create, before any prompt). While
# rc files run subprocesses (git rev-parse, git config ... observed) it answers
# agent_pane_busy; under load 13 that lasted most of a 7-13s zsh start. Inside
# the START_TIMEOUT window that code only means "shell not ready yet", so it is
# retried with the Devin detection poll cadence. Every other failure keeps
# failing at once. herdr refuses a start timeout of 3000ms or less, so a window
# with no more than that left fails closed instead of being handed to herdr.
SHELL_READY_POLL_SECONDS=0.25
SHELL_READY_POLL_MS=250
AGENT_START_MIN_TIMEOUT_MS=3000

agent_start_in_pane() {
  local started_at now attempts=0 max_attempts remaining_ms start_err start_rc
  local probe_used_ms
  started_at="$(date +%s)"
  # #1016 (#979 SHOULD S2): `agent start` types the argv into the same fresh
  # pane shell and gates only on agent_pane_busy — the foreground check that
  # cannot see a pending rc-file read. On the Pi that read (omz `read -k 1`)
  # ate the first character of `devin`; for every other kind it eats the
  # first character of the argv herdr types. Run the same retype-only
  # readiness probe before the first start attempt — it shares this spawn's
  # START_TIMEOUT window and fails closed without ever calling agent start.
  if ! devin_wait_shell_ready "$started_at"; then
    spawn_pane_cleanup
    return 1
  fi
  # #1199: the probe shares that window only if its cost is charged to it —
  # re-read the clock at the gate exit so the first `agent start` is handed
  # just the remaining window, and keep the probe share in probe_used_ms so
  # a spent window names the phase that consumed it.
  now="$(date +%s)"
  probe_used_ms=$(( (now - started_at) * 1000 ))
  max_attempts=$(( START_TIMEOUT / SHELL_READY_POLL_MS ))
  while :; do
    attempts=$(( attempts + 1 ))
    remaining_ms=$(( START_TIMEOUT - (now - started_at) * 1000 ))
    if (( remaining_ms <= AGENT_START_MIN_TIMEOUT_MS )); then
      echo "wrk: agent start failed: shell not ready within the ${START_TIMEOUT}ms window (readiness probe used ${probe_used_ms}ms, agent_pane_busy x$(( attempts - 1 ))); pane=$PANE; timeout source: $START_TIMEOUT_SOURCE" >&2
      spawn_pane_cleanup
      return 1
    fi
    round_ext_builder_recheck
    set +e
    start_err="$("$HERDR" agent start "$LABEL" --kind "$PROFILE_KIND" --pane "$PANE" --timeout "$remaining_ms" -- "${ARGS[@]}" 2>&1 >/dev/null)"
    start_rc=$?
    set -e
    [[ "$start_rc" -eq 0 ]] && return 0
    [[ -z "$start_err" ]] || printf '%s\n' "$start_err" >&2
    if [[ "$start_err" != *'"code":"agent_pane_busy"'* ]]; then
      spawn_pane_cleanup
      return "$start_rc"
    fi
    # The wall clock is checked at the top of the loop; the cap bounds it
    # when sleep is disabled.
    if (( attempts >= max_attempts )); then
      echo "wrk: agent start failed: shell not ready within the ${START_TIMEOUT}ms window (readiness probe used ${probe_used_ms}ms, agent_pane_busy x$attempts); pane=$PANE; timeout source: $START_TIMEOUT_SOURCE" >&2
      spawn_pane_cleanup
      return "$start_rc"
    fi
    sleep_for "$SHELL_READY_POLL_SECONDS"
    now="$(date +%s)"
  done
}

# #609: `agent start` (and Devin's `pane run`) can be accepted while the agent
# binary never reaches the pane foreground — the m1b spawn ran `codex` on a
# PATH that lacked it, zsh printed "command not found", and wrk still wrote
# job.spawned and typed the brief into the bare shell. Before any prompt is
# injected, poll process-info until the agent itself holds the foreground:
# some foreground process whose argv0 is one of the kind's canonical
# executable names. herdr's `--kind` is NOT always the executable name —
# measured 2026-09-24 on live panes of this Mac (pane process-info argv0,
# `name` in parentheses):
#   claude   -> "claude"        (name is the version, e.g. "2.1.281")
#   codex    -> node-script leader plus a native child argv0 "codex"
#   devin    -> "devin"         (name "devin")
#   grok     -> "grok"          (native binary ~/.grok/bin/grok)
#   kimi     -> "kimi-code"     (name "kimi"; the ~/.kimi-code/bin/kimi
#               launcher hands the pane to the kimi-code TUI — matching only
#               "kimi" fail-closed every real kimi spawn, the #609 follow-up
#               this table fixes)
#   kiro     -> unmeasured on this host (binary absent); herdr's detector
#               lists the alias "kiro-cli", so both spellings are accepted.
# The other detector aliases herdr knows (claude-code, devin-cli, grok-build,
# open-code, antigravity) are accepted for the same reason. The shell alone, a
# shell child, or an unrelated foreground process all mean "not ours yet"; the
# agent is polled inside a bounded window, anything else fails closed so the
# pane is closed and the quota record released instead of a brief landing in
# zsh.
agent_foreground_exes() {
  case "$1" in
    claude)   echo "claude claude-code" ;;
    devin)    echo "devin devin-cli" ;;
    grok)     echo "grok grok-build" ;;
    kimi)     echo "kimi-code kimi" ;;
    kiro)     echo "kiro-cli kiro" ;;
    opencode) echo "open-code opencode" ;;
    agy)      echo "antigravity agy" ;;
    *)        echo "$1" ;;
  esac
}
AGENT_FOREGROUND_TIMEOUT_MS=10000
agent_foreground_diagnostics() {
  local reason="$1"
  echo "wrk: agent foreground check failed: $reason; pane=$PANE kind=$PROFILE_KIND" >&2
  "$HERDR" pane process-info --pane "$PANE" >&2 ||
    warn "agent foreground process-info failed for pane=$PANE"
}

agent_wait_foreground() {
  local started_at attempts=0 max_attempts info_out info_rc ready
  started_at="$(date +%s)"
  max_attempts=$(( AGENT_FOREGROUND_TIMEOUT_MS / SHELL_READY_POLL_MS ))
  while :; do
    attempts=$(( attempts + 1 ))
    set +e
    info_out="$("$HERDR" pane process-info --pane "$PANE" 2>/dev/null)"
    info_rc=$?
    set -e
    if [[ "$info_rc" -ne 0 ]]; then
      agent_foreground_diagnostics "pane process-info exited $info_rc before brief injection"
      return 1
    fi
    set +e
    ready="$(printf '%s' "$info_out" | python3 -c '
import json, os, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    raise SystemExit(1)
info = d.get("result") or {}
info = info.get("process_info") or d.get("process_info")
if not isinstance(info, dict):
    raise SystemExit(1)
procs = info.get("foreground_processes")
if not isinstance(procs, list):
    raise SystemExit(1)
want = set(sys.argv[1].split())
for p in procs:
    if not isinstance(p, dict):
        continue
    names = [os.path.basename(str(p.get("argv0") or ""))]
    cmd = str(p.get("cmdline") or "").split()
    if cmd:
        names.append(os.path.basename(cmd[0]))
    if want.intersection(names):
        print("yes")
        break
else:
    print("no")
' "$(agent_foreground_exes "$PROFILE_KIND")" 2>/dev/null)"
    info_rc=$?
    set -e
    if [[ "$info_rc" -ne 0 ]]; then
      agent_foreground_diagnostics "pane process-info returned an invalid envelope before brief injection"
      return 1
    fi
    [[ "$ready" == yes ]] && return 0
    if (( attempts >= max_attempts || ($(date +%s) - started_at) * 1000 >= AGENT_FOREGROUND_TIMEOUT_MS )); then
      agent_foreground_diagnostics "agent not foreground within ${AGENT_FOREGROUND_TIMEOUT_MS}ms (not-foreground x$attempts)"
      return 1
    fi
    sleep_for "$SHELL_READY_POLL_SECONDS"
  done
}

# `pane run` has no availability check: it types into whatever holds the
# terminal, and `agent start`'s agent_pane_busy gate is the same foreground
# check (#1016). Before the agent argv is typed — `pane run` for Devin,
# `agent start` for every other kind — poll process-info until herdr's own
# available-shell rule holds (the shell is the foreground process group and the
# only foreground process). "Not ready yet" is polled inside the same window
# that detection and the idle wait then share.
# hk 1541: under load a fresh pane's first process-info reply can come back
# unreadable — a non-zero rc or an envelope the parser cannot read — while a
# re-query seconds later answers a valid one (m1b 2026-10-13 08:18-08:22:
# two spawns failed closed on a transient reply whose re-query held a
# ready shell). Inside the same START_TIMEOUT window an unreadable reply is
# therefore "not ready yet" too, for up to PINFO_BAD_MAX consecutive
# replies; only a run of that length, or the window ending, fails closed
# with the old reason text plus the count. A readable reply — ready or not
# — resets the run. The poll used to discard the raw reply (2>/dev/null,
# stdout never saved), so the transient was never seen: the stdout, stderr
# and rc of the first and last bad reply are now preserved into the job's
# pinfo-bad file, and into the Devin failure artifacts on failure. Nothing
# outside those three streams is ever written there.
# #604/m1b: herdr's process-info shape is not identical everywhere — the m1b
# 0.9.0 reply (hk:doc evidence/2026-09-24/task604-m1b-repro) carries
# process_info without the "result" wrapper and without
# foreground_process_group_id, but still names shell_pid and the foreground
# list. That is a readable "not ready yet" (an rc-file subprocess like
# compinit's grep holding the foreground), not an invalid envelope: readiness
# is judged from shell_pid + foreground pids alone, the group id checked only
# when present. What stays invalid — and fails closed once its run reaches
# PINFO_BAD_MAX — is an envelope whose shell_pid/foreground list cannot be
# read at all.
# #979: the shell holding the foreground alone is not proof of a command-line
# prompt — a fresh pane's zsh can sit in a pending rc-file read (the Pi's
# oh-my-zsh update check holds `read -k 1`; the typed `devin` lost its first
# character to it and the spawn died agent_not_found on `evin`,
# jobs/971-stale-race-20260929-1848). Once the foreground says "shell alone",
# prove the shell executes command lines before the agent argv is typed: run a
# probe whose printf argument is a fresh token and require the token back as
# its own output line. The echoed command carries the token inside the printf
# argument too, so only an exact-line match is proof — a substring match would
# accept an echo from a shell that ran nothing. A probe that goes unanswered
# is retried with a fresh token after DEVIN_PROBE_MISS_POLLS reads — and only
# retyped, never interrupted: a send-keys ctrl+c during a still-sourcing rc
# file SIGINTs the rest of .zshrc/.bashrc and leaves the agent in a truncated
# environment (fix-round-1 tester: 7s rc starts under load, and every earlier
# queued line would have run unharmed once the shell was ready). The output
# of ANY token this spawn typed counts as proof — lines queued behind a slow
# rc all execute when the prompt arrives, and a `read -k 1` that ate the
# leading space still runs the remainder of the line. A probe that never
# lands is a distinct fail-closed reason inside the same START_TIMEOUT
# window.
DEVIN_PROBE_MISS_POLLS=4

# #1016: the same wait guards `agent start` for every non-devin kind —
# herdr types their argv into the same fresh shell. Devin's diagnostics
# contract ("Devin pane startup failed", failure-artifact preservation) is
# pinned by its tests; the other kinds report the same reason on the
# agent-start failure line with the same process-info dump.
shell_ready_diagnostics() {
  local reason="$1" source_suffix=""
  if [[ "$PROFILE_KIND" == devin ]]; then
    devin_spawn_diagnostics "$reason"
    return
  fi
  if [[ -n "${START_TIMEOUT:-}" && "$reason" == *"${START_TIMEOUT}ms"* ]]; then
    source_suffix="; timeout source: ${START_TIMEOUT_SOURCE:-agent kind default}"
  fi
  echo "wrk: agent start failed: $reason; pane=$PANE$source_suffix" >&2
  "$HERDR" pane process-info --pane "$PANE" >&2 ||
    warn "agent start process-info failed for pane=$PANE"
}

# probe_token/probe_tokens/probe_sends/probe_misses/attempts are
# devin_wait_shell_ready locals — dynamic scope is what lets this helper
# update them.
devin_probe_send() {
  probe_token="wrk-ready-$$-${attempts}-${RANDOM}"
  probe_tokens="${probe_tokens:+$probe_tokens }$probe_token"
  probe_sends=$(( probe_sends + 1 ))
  probe_misses=0
  local probe_run_rc
  set +e
  # The leading space keeps the probe out of shell history where the shell
  # honours it; the single argument is the whole typed line.
  "$HERDR" pane run "$PANE" " printf '%s\\n' '$probe_token'" >/dev/null
  probe_run_rc=$?
  set -e
  if [[ "$probe_run_rc" -ne 0 ]]; then
    shell_ready_diagnostics "readiness probe pane run exited $probe_run_rc"
    return 1
  fi
}

# hk 1541: the consecutive-unreadable budget inside the START_TIMEOUT window.
PINFO_BAD_MAX=5

# pinfo_bad/pinfo_bad_total/pinfo_first_*/pinfo_last_* are
# devin_wait_shell_ready locals — dynamic scope is what lets these helpers
# update them (the same contract as devin_probe_send above).
pinfo_note_bad() {
  # $1 class (exit = process-info rc non-zero, envelope = unreadable reply)
  # $2 the reply's own rc   $3 raw stdout   $4 file holding raw stderr
  local class="$1" bad_rc="$2" bad_out="$3" bad_err=""
  if [[ -n "$4" && -f "$4" ]]; then
    bad_err="$(cat "$4" 2>/dev/null || true)"
    # The poll's stderr scratch file is consumed here — delete it or it
    # would leak one tempfile per spawn into TMPDIR (tester D1).
    rm -f "$4" 2>/dev/null || true
    pinfo_err_file=""
  fi
  pinfo_bad=$(( pinfo_bad + 1 ))
  pinfo_bad_total=$(( pinfo_bad_total + 1 ))
  if [[ -z "$pinfo_first_class" ]]; then
    pinfo_first_class="$class" pinfo_first_rc="$bad_rc"
    pinfo_first_out="$bad_out" pinfo_first_err="$bad_err"
  fi
  pinfo_last_class="$class" pinfo_last_rc="$bad_rc"
  pinfo_last_out="$bad_out" pinfo_last_err="$bad_err"
  pinfo_write_bad_file
}

pinfo_write_bad_file() {
  local dir
  [[ -n "${JOB_ID:-}" ]] || return 0
  dir="$(wrk_jobs_root)/$JOB_ID"
  mkdir -p "$dir" 2>/dev/null || return 0
  {
    printf 'pane=%s\njob=%s\nat=%s\n' "$PANE" "$JOB_ID" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'bad_total=%s\nconsecutive_bad=%s\n' "$pinfo_bad_total" "$pinfo_bad"
    printf '=== first class=%s rc=%s ===\n' "$pinfo_first_class" "$pinfo_first_rc"
    printf '%s\n' '--- stdout ---'
    printf '%s\n' "$pinfo_first_out"
    printf '%s\n' '--- stderr ---'
    printf '%s\n' "$pinfo_first_err"
    printf '=== last class=%s rc=%s ===\n' "$pinfo_last_class" "$pinfo_last_rc"
    printf '%s\n' '--- stdout ---'
    printf '%s\n' "$pinfo_last_out"
    printf '%s\n' '--- stderr ---'
    printf '%s\n' "$pinfo_last_err"
  } >"$dir/pinfo-bad" 2>/dev/null ||
    warn "unreadable process-info replies could not be preserved under $dir/pinfo-bad"
}

devin_wait_shell_ready() {
  local started_at="$1" attempts=0 max_attempts info_out info_rc ready
  local probe_token="" probe_tokens="" probe_sends=0 probe_misses=0
  local probe_out probe_rc probe_matched probe_any
  # hk 1541: the unreadable-reply run (pinfo_bad is the consecutive count the
  # budget applies to, pinfo_bad_total the count the diagnostics and the
  # pinfo-bad file report) and its evidence. pinfo_err_file is the poll's
  # stderr scratch file, consumed and deleted by pinfo_note_bad or dropped on
  # a readable reply — it must never outlive the wait.
  local pinfo_bad=0 pinfo_bad_total=0 pinfo_err_file="" parse_rc=0 pinfo_suffix=""
  local pinfo_first_class="" pinfo_first_rc="" pinfo_first_out="" pinfo_first_err=""
  local pinfo_last_class="" pinfo_last_rc="" pinfo_last_out="" pinfo_last_err=""
  # A retry under the same job id replaces the unreadable-reply evidence of
  # its own wait rather than reading a predecessor's as its own.
  [[ -z "${JOB_ID:-}" ]] || rm -f "$(wrk_jobs_root)/$JOB_ID/pinfo-bad" 2>/dev/null || true
  # The command the shell must prove it can run before wrk (or herdr, for
  # `agent start`) types it: `pane run` for devin, `agent start` for every
  # other kind (#1016).
  local start_action=pane\ run
  [[ "$PROFILE_KIND" == devin ]] || start_action=agent\ start
  max_attempts=$(( START_TIMEOUT / SHELL_READY_POLL_MS ))
  while :; do
    attempts=$(( attempts + 1 ))
    if [[ -n "$probe_token" ]]; then
      # A probe is in flight: only output lines prove execution, and the
      # output of ANY token this spawn typed counts — queued lines run in
      # order once the shell reaches its prompt.
      set +e
      probe_out="$("$HERDR" pane read "$PANE" --source recent-unwrapped --lines 60 2>/dev/null)"
      probe_rc=$?
      set -e
      probe_matched=0
      if [[ "$probe_rc" -eq 0 ]]; then
        for probe_any in $probe_tokens; do
          if grep -qxF "$probe_any" <<<"$probe_out"; then probe_matched=1; break; fi
        done
      fi
      [[ "$probe_matched" -eq 1 ]] && return 0
      probe_misses=$(( probe_misses + 1 ))
      (( probe_misses >= DEVIN_PROBE_MISS_POLLS )) && probe_token=""
    else
      if [[ -z "$pinfo_err_file" ]]; then
        pinfo_err_file="$(mktemp "${TMPDIR:-/tmp}/wrk-pinfo-err.XXXXXX" 2>/dev/null)" || pinfo_err_file=""
      fi
      set +e
      if [[ -n "$pinfo_err_file" ]]; then
        info_out="$("$HERDR" pane process-info --pane "$PANE" 2>"$pinfo_err_file")"
      else
        info_out="$("$HERDR" pane process-info --pane "$PANE" 2>/dev/null)"
      fi
      info_rc=$?
      set -e
      if [[ "$info_rc" -ne 0 ]]; then
        pinfo_note_bad exit "$info_rc" "$info_out" "$pinfo_err_file"
        if (( pinfo_bad >= PINFO_BAD_MAX )); then
          shell_ready_diagnostics "pane process-info exited $info_rc before $start_action (consecutive bad replies x$pinfo_bad)"
          return 1
        fi
      else
        set +e
        ready="$(printf '%s' "$info_out" | python3 -c '
import json, sys
d = json.load(sys.stdin)
res = d.get("result")
info = res.get("process_info") if isinstance(res, dict) else d.get("process_info")
if not isinstance(info, dict):
    raise SystemExit(1)
shell = info.get("shell_pid")
group = info.get("foreground_process_group_id")
procs = info.get("foreground_processes")
if type(shell) is not int or not isinstance(procs, list):
    raise SystemExit(1)
if group is not None and type(group) is not int:
    raise SystemExit(1)
pids = [p.get("pid") if isinstance(p, dict) else None for p in procs]
ready = bool(pids) and all(pid == shell for pid in pids)
if group is not None:
    ready = ready and group == shell
print("yes" if ready else "no")
' 2>/dev/null)"
        parse_rc=$?
        set -e
        if [[ "$parse_rc" -ne 0 ]]; then
          pinfo_note_bad envelope 0 "$info_out" "$pinfo_err_file"
          if (( pinfo_bad >= PINFO_BAD_MAX )); then
            shell_ready_diagnostics "pane process-info returned an invalid envelope before $start_action (consecutive bad replies x$pinfo_bad)"
            return 1
          fi
        else
          # A readable reply — ready or not — ends the unreadable run. Its
          # stderr scratch file was never consumed; drop it here.
          pinfo_bad=0
          if [[ -n "$pinfo_err_file" ]]; then
            rm -f "$pinfo_err_file" 2>/dev/null || true
            pinfo_err_file=""
          fi
          if [[ "$ready" == yes ]]; then devin_probe_send || return 1; fi
        fi
      fi
    fi
    if (( attempts >= max_attempts || ($(date +%s) - started_at) * 1000 >= START_TIMEOUT )); then
      pinfo_suffix=""
      (( pinfo_bad_total > 0 )) && pinfo_suffix=", unreadable replies x$pinfo_bad_total"
      if [[ "$probe_sends" -gt 0 ]]; then
        shell_ready_diagnostics "shell did not execute a readiness probe within ${START_TIMEOUT}ms (probes typed x$probe_sends$pinfo_suffix)"
      else
        shell_ready_diagnostics "shell not ready within ${START_TIMEOUT}ms (foreground busy x$attempts$pinfo_suffix)"
      fi
      return 1
    fi
    sleep_for "$SHELL_READY_POLL_SECONDS"
  done
}

# #649: a slow host (m1b) reaches the identity check before devin's TUI is
# painted — the pane still shows only the typed command and every identity
# rule reports unmatched, so a single `agent explain` used to fail the spawn
# with "invalid identity envelope" while the agent was merely starting. Inside
# the START_TIMEOUT window an envelope with no matched rule is "not identified
# yet": explain is re-polled with backoff (the same window that shell
# readiness, detection and the idle wait share). A matched non-welcome rule —
# trust dialog, permission prompt, error screen — is a terminal state and is
# judged at once, as is a non-devin agent or an unreadable envelope. On window
# expiry the failure is the existing fail-closed path plus #604's evidence
# preservation, and the reason names which unmatched shape never resolved.
DEVIN_IDENTITY_POLL_MS=250
DEVIN_IDENTITY_POLL_MAX_MS=2000

# Prints the identity verdict for one `agent explain` envelope, one of:
#   ready                    agent=devin and matched_rule.id=welcome_prompt_footer
#   decided<TAB>agent<TAB>rule  a non-welcome rule matched, or the detected
#                            agent is not devin — judged immediately either way
#   starting                 no rule matched and the evaluated screen region is
#                            only the `devin …` command line wrk typed
#   unmatched                no rule matched but the screen shows something
#                            else (mid-render, or a genuinely unexpected pane)
# Exit 1 = the envelope itself could not be read (the #604 "invalid identity
# envelope" case — never retried, a malformed answer is not startup).
devin_classify_identity() {
  WRK_DEVIN_CMD="devin ${ARGS[*]}" python3 -c '
import json, os, sys
d = json.load(sys.stdin)
agent = d.get("agent")
matched = d.get("matched_rule")
if not isinstance(agent, str):
    sys.exit(1)
if matched is None:
    rule = None
elif isinstance(matched, dict) and isinstance(matched.get("id"), str):
    rule = matched["id"]
else:
    sys.exit(1)
if agent == "devin" and rule == "welcome_prompt_footer":
    print("ready")
elif agent != "devin" or rule is not None:
    print("decided\t%s\t%s" % (agent, rule or ""))
else:
    cmd = "".join(os.environ.get("WRK_DEVIN_CMD", "").split())
    previews = [
        ev["region_preview"]
        for r in d.get("evaluated_rules") or []
        if isinstance(r, dict)
        for ev in [r.get("evidence")]
        if isinstance(ev, dict) and isinstance(ev.get("region_preview"), str)
    ]
    flat = "".join((max(previews, key=len) if previews else "").split())
    idx = flat.rfind(cmd) if cmd else -1
    # A cursor glyph may trail the command; nothing else may.
    print("starting" if idx >= 0 and len(flat) - idx - len(cmd) <= 2 else "unmatched")
'
}

devin_wait_identity() {
  local started_at="$1" attempts=0 max_attempts explain_json explain_rc verdict class_rc
  local detected_agent matched_rule poll_ms="$DEVIN_IDENTITY_POLL_MS"
  max_attempts=$(( START_TIMEOUT / DEVIN_IDENTITY_POLL_MS ))
  while :; do
    attempts=$(( attempts + 1 ))
    set +e
    explain_json="$("$HERDR" agent explain "$PANE" --format json 2>/dev/null)"
    explain_rc=$?
    set -e
    if [[ "$explain_rc" -ne 0 ]]; then
      devin_spawn_diagnostics "agent explain exited $explain_rc" 1 "$explain_rc" "$explain_json"
      return "$explain_rc"
    fi
    set +e
    verdict="$(printf '%s' "$explain_json" | devin_classify_identity)"
    class_rc=$?
    set -e
    if [[ "$class_rc" -ne 0 ]]; then
      devin_spawn_diagnostics "agent explain returned an invalid identity envelope" 1 "$explain_rc" "$explain_json"
      return 1
    fi
    case "$verdict" in
      ready) return 0 ;;
      decided*)
        IFS=$'\t' read -r _ detected_agent matched_rule <<<"$verdict"
        devin_spawn_diagnostics "expected agent=devin rule=welcome_prompt_footer, got agent=$detected_agent rule=$matched_rule" 1 "$explain_rc" "$explain_json"
        return 1 ;;
      starting|unmatched)
        if (( attempts >= max_attempts || ($(date +%s) - started_at) * 1000 >= START_TIMEOUT )); then
          if [[ "$verdict" == starting ]]; then
            devin_spawn_diagnostics "agent explain still starting within ${START_TIMEOUT}ms (command-line-only screen x$attempts)" 1 "$explain_rc" "$explain_json"
          else
            devin_spawn_diagnostics "agent explain matched no identity rule within ${START_TIMEOUT}ms (unmatched screen x$attempts)" 1 "$explain_rc" "$explain_json"
          fi
          return 1
        fi
        sleep_for "$(awk -v ms="$poll_ms" 'BEGIN{printf "%.3f", ms/1000}')"
        (( poll_ms < DEVIN_IDENTITY_POLL_MAX_MS )) && poll_ms=$(( poll_ms * 2 ))
        ;;
    esac
  done
}

devin_start_in_pane() {
  local run_rc wait_rc identity_rc=0 rename_rc
  local started_at remaining_ms

  started_at="$(date +%s)"
  if ! devin_wait_shell_ready "$started_at"; then
    spawn_pane_cleanup
    return 1
  fi
  set +e
  "$HERDR" pane run "$PANE" devin "${ARGS[@]}" >/dev/null
  run_rc=$?
  set -e
  if [[ "$run_rc" -ne 0 ]]; then
    devin_spawn_diagnostics "pane run exited $run_rc"
    spawn_pane_cleanup
    return "$run_rc"
  fi

  if ! devin_wait_detected "$started_at"; then
    spawn_pane_cleanup
    return 1
  fi

  # The 3000.11.1 welcome banner was measured at about 5.3 seconds. Detection
  # and the idle wait share wrk's existing 30-second START_TIMEOUT window, which
  # gives cold starts ample margin while keeping readiness failure bounded.
  # Detection can land on the window edge; never hand agent wait a zero or
  # negative timeout (it must not turn into an unbounded or undefined wait).
  remaining_ms=$(( START_TIMEOUT - ($(date +%s) - started_at) * 1000 ))
  if (( remaining_ms <= 0 )); then
    devin_spawn_diagnostics "agent detected after the ${START_TIMEOUT}ms window" 1
    spawn_pane_cleanup
    return 1
  fi
  set +e
  "$HERDR" agent wait "$PANE" --until idle --timeout "$remaining_ms" >/dev/null
  wait_rc=$?
  set -e
  if [[ "$wait_rc" -ne 0 ]]; then
    devin_spawn_diagnostics "welcome_prompt_footer wait exited $wait_rc" 1
    spawn_pane_cleanup
    return "$wait_rc"
  fi

  # #649: the identity check used to be one shot, which mistook a slow TUI
  # (m1b, MCP servers still starting) for a spawn failure.  Poll explain until
  # a rule matches, the envelope is decided, or the START_TIMEOUT window
  # closes; the preserved rc distinguishes the sub-failures for callers. The
  # `||` capture keeps errexit off through the call — the wait re-enables it
  # internally, so a plain `set +e` bracket would still abort before the rc
  # could be read (the sibling waits get the same shield from `if !`).
  devin_wait_identity "$started_at" || identity_rc=$?
  if [[ "$identity_rc" -ne 0 ]]; then
    spawn_pane_cleanup
    return "$identity_rc"
  fi

  set +e
  "$HERDR" agent rename "$PANE" "$LABEL" >/dev/null
  rename_rc=$?
  set -e
  if [[ "$rename_rc" -ne 0 ]]; then
    devin_spawn_diagnostics "agent rename exited $rename_rc" 1
    spawn_pane_cleanup
    return "$rename_rc"
  fi
}

arbiter_release_held() {
  [[ "${ARBITER_HELD:-0}" -eq 1 ]] || return 0
  ARBITER_HELD=0
  local rc
  set +e
  "$ARBITER" release --job "$JOB_ID" --resource "$ARBITER_RESOURCE" --kind quota_pool >/dev/null 2>&1
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    echo "wrk: arbiter quota-pool record release failed (exit $rc): $ARBITER_RESOURCE job=$JOB_ID" >&2
  else
    echo "wrk: arbiter quota-pool record released after spawn failure: $ARBITER_RESOURCE job=$JOB_ID" >&2
  fi
}

arbiter_get_duplicate_state() {
  # Query the durable receipt surface rather than parsing localized stderr from
  # claim.  The parser rejects malformed/non-string fields, because accepting
  # an ambiguous state would recreate the exact-once failure we are fixing.
  local lookup lookup_rc parsed parse_rc lookup_job lookup_state lookup_owner lookup_created
  set +e
  lookup="$("$ARBITER" job-get --job "$JOB_ID" --json 2>/dev/null)"
  lookup_rc=$?
  set -e
  # job-get's dedicated not-found result is a readable admission answer, not
  # an unavailable arbiter.  Keep it distinct for router preflight.
  [[ "$lookup_rc" -eq 0 ]] || { [[ "$lookup_rc" -eq 7 ]] && return 2; return 1; }
  set +e
  parsed="$(printf '%s' "$lookup" | python3 -c '
import json, sys
d = json.load(sys.stdin)
keys = ("job_id", "state", "owner_lane", "created_at")
values = []
for key in keys:
    value = d.get(key)
    if not isinstance(value, str) or not value or "\t" in value or "\n" in value:
        raise ValueError("invalid job-get field: " + key)
    values.append(value)
print("\t".join(values))
')"
  parse_rc=$?
  set -e
  [[ "$parse_rc" -eq 0 ]] || return 1
  IFS=$'\t' read -r lookup_job lookup_state lookup_owner lookup_created <<<"$parsed"
  [[ "$lookup_job" == "$JOB_ID" && -n "$lookup_state" && -n "$lookup_owner" && -n "$lookup_created" ]] || return 1
  ARBITER_DUP_STATE="$lookup_state"
  ARBITER_DUP_OWNER_LANE="$lookup_owner"
  ARBITER_DUP_CREATED_AT="$lookup_created"
  return 0
}

arbiter_handle_duplicate_claim() {
  # $1 is set only for the one state re-check allowed after a reclaim race.
  # A second released observation is not a license to spin/retry indefinitely.
  local after_reclaim_race="${1:-0}" reclaim_rc
  if ! arbiter_get_duplicate_state; then
    warn "arbiter duplicate job state lookup failed; refusing spawn (fail-closed): job_id=$JOB_ID"
    return "$WRK_EXIT_JOB_STATE_UNREADABLE"
  fi
  case "$ARBITER_DUP_STATE" in
    claimed|leased)
      if [[ "${JOB_DUP_OK:-0}" -eq 1 ]]; then
        warn "active arbiter job duplicate proceeding only because --job-dup-ok override was supplied: job_id=$JOB_ID state=$ARBITER_DUP_STATE owner_lane=$ARBITER_DUP_OWNER_LANE created_at=$ARBITER_DUP_CREATED_AT"
        # The row belongs to this exact job id already, so a later successful
        # spawn receipt can still be written even if its quota record is old.
        ARBITER_JOB_REGISTERED=1
        return 0
      fi
      warn "active arbiter job duplicate refused (fail-closed): job_id=$JOB_ID state=$ARBITER_DUP_STATE owner_lane=$ARBITER_DUP_OWNER_LANE created_at=$ARBITER_DUP_CREATED_AT"
      return "$WRK_EXIT_ACTIVE_JOB_DUPLICATE"
      ;;
    released)
      if [[ "$after_reclaim_race" -eq 1 ]]; then
        warn "arbiter duplicate job changed during released reclaim; refusing spawn (fail-closed): job_id=$JOB_ID state=$ARBITER_DUP_STATE owner_lane=$ARBITER_DUP_OWNER_LANE created_at=$ARBITER_DUP_CREATED_AT"
        return "$WRK_EXIT_JOB_STATE_UNREADABLE"
      fi
      set +e
      "$ARBITER" claim --reclaim-released --job "$JOB_ID" --agent-label "$LABEL" --lane "$JOB_LANE" --t "$JOB_T" "${ARBITER_CLAIM_ROLE_ARGS[@]}" ${ARBITER_CLAIM_TASK_ARGS[@]+"${ARBITER_CLAIM_TASK_ARGS[@]}"} >/dev/null
      reclaim_rc=$?
      set -e
      case "$reclaim_rc" in
        0)
          ARBITER_JOB_REGISTERED=1
          warn "arbiter released job reclaimed: job_id=$JOB_ID owner_lane=$JOB_LANE"
          return 0
          ;;
        4)
          # Another recovery caller may have won between our read and update.
          # Re-observe once; it will fail-closed unless an explicit override is
          # present for the now-active owner.
          arbiter_handle_duplicate_claim 1
          return $?
          ;;
        *)
          warn "arbiter released job reclaim failed (exit $reclaim_rc); refusing spawn (fail-closed): job_id=$JOB_ID"
          return "$WRK_EXIT_JOB_STATE_UNREADABLE"
          ;;
      esac
      ;;
    *)
      warn "arbiter duplicate job has unsupported state; refusing spawn (fail-closed): job_id=$JOB_ID state=$ARBITER_DUP_STATE owner_lane=$ARBITER_DUP_OWNER_LANE created_at=$ARBITER_DUP_CREATED_AT"
      return "$WRK_EXIT_JOB_STATE_UNREADABLE"
      ;;
  esac
}

arbiter_preflight_active_duplicate() {
  # Router placement is allowed to inspect neither Herdr nor the hub for a job
  # that the durable arbiter receipt already proves is actively owned.  This is
  # deliberately a read-only look-up: normal admission below still owns the
  # claim/reclaim transition and its installation-transition handling.
  local job_id="$1" job_dup_ok="$2"
  [[ -n "$ARBITER" ]] || ARBITER="$(command -v arbiter 2>/dev/null || true)"
  # Placement is safe to continue only after a durable lookup was actually
  # readable. An absent/unreadable arbiter remains an installation transition
  # for the local spawn path, but it is never permission to route remotely.
  [[ -n "$ARBITER" && -x "$ARBITER" ]] || return "$WRK_EXIT_JOB_STATE_UNREADABLE"
  JOB_ID="$job_id"
  if arbiter_get_duplicate_state; then
    :
  else
    local lookup_rc=$?
    [[ "$lookup_rc" -eq 2 ]] && return 0
    return "$WRK_EXIT_JOB_STATE_UNREADABLE"
  fi
  case "$ARBITER_DUP_STATE" in
    claimed|leased)
      [[ "$job_dup_ok" -eq 1 ]] && return 0
      warn "active arbiter job duplicate refused (fail-closed): job_id=$JOB_ID state=$ARBITER_DUP_STATE owner_lane=$ARBITER_DUP_OWNER_LANE created_at=$ARBITER_DUP_CREATED_AT"
      return "$WRK_EXIT_ACTIVE_JOB_DUPLICATE"
      ;;
  esac
  return 0
}

arbiter_record_spawn_receipt() {
  # A pane cannot be rolled back once its agent start/prompt succeeded.  This
  # evidence write is therefore deliberately warning-only; job-get renders its
  # absence explicitly for downstream recovery rather than pretending success.
  # #1397/(a) exception: under --lane-defer this receipt is the ONLY record of
  # the lane the ssh initiator is about to `lanes add` — a lost write would
  # leave a hub row no reap can ever attribute. A deferred spawn therefore
  # answers nonzero on receipt failure instead: the remote leg's rc stops the
  # initiator's add (and a 2 sits in the remote stop set, so the auto round
  # ends rather than re-placing the job). The still-armed pane trap closes the
  # pane; a self-registered deferred lane is removed through its machine+pane
  # guard first. An initiator-owned deferred row is never removed here.
  [[ "${ARBITER_JOB_REGISTERED:-0}" -eq 1 ]] || return 0
  local payload receipt_rc lane_role
  # #1438: the role the lane was registered under — the same normalization
  # hub_lane_register applies (captain is already builder by now; tester,
  # reviewer and counsel seats are leaf worker lanes). It rides in the receipt
  # because reap cannot recover it from the claim: claim roles are cumulative,
  # and a job id first claimed as builder then reused by a worker spawn would
  # otherwise remove the worker lane with the builder (operator) credential.
  case "${ROLE:-worker}" in
    builder|captain) lane_role=builder ;;
    *) lane_role=worker ;;
  esac
  if ! payload="$(python3 - "$PANE" "$LABEL" "$MODEL" "$WS" "${TAB_ID:-}" "${KEEP:-0}" "${TASK_ID:-}" "${HUB_LANE:-}" "${HUB_LANE_MACHINE:-}" "$lane_role" <<'PY'
import json, sys
pane_id, label, profile, workspace, tab_id, keep, task_id, hub_lane, hub_lane_machine, lane_role = sys.argv[1:]
receipt = {
    "pane_id": pane_id,
    "label": label,
    "profile": profile,
    "workspace": workspace,
}
# Additive and optional: existing consumers keep reading the four fields above.
if tab_id:
    receipt["tab_id"] = tab_id
# #768: the task binding is receipt evidence too, next to the pane it landed on.
if task_id:
    receipt["task_id"] = int(task_id) if task_id.isdigit() else task_id
# Protection marker, task 603: present only with --keep, so an ordinary spawn
# receipt stays byte-identical; its readers accept only the JSON literal true.
# Keep this heredoc free of quote characters: bash 3.2 misparses them in a command substitution.
if keep == "1":
    receipt["keep"] = True
# #965: the hub lane this spawn registered. wrk reap removes exactly this lane
# — a spawn without one keeps the receipt byte-identical to before.
# #1438: lane_role travels with the lane it describes, so a receipt without a
# hub_lane gains nothing.
if hub_lane:
    receipt["hub_lane"] = hub_lane
    receipt["hub_lane_machine"] = hub_lane_machine
    receipt["lane_role"] = lane_role
print(json.dumps(receipt, ensure_ascii=False, separators=(",", ":")))
PY
)"; then
    if [[ -n "${LANE_DEFER:-}" ]]; then
      warn "arbiter job.spawned receipt preparation failed under --lane-defer; the deferred lane would be untrackable — failing the spawn so the initiator registers nothing: job_id=$JOB_ID pane_id=$PANE"
      hub_lane_orphan_remove
      return 2
    fi
    warn "arbiter job.spawned receipt preparation failed; spawn remains successful: job_id=$JOB_ID pane_id=$PANE"
    hub_lane_orphan_remove
    return 0
  fi
  set +e
  "$ARBITER" event --job "$JOB_ID" --kind job.spawned --payload-json "$payload" >/dev/null
  receipt_rc=$?
  set -e
  if [[ "$receipt_rc" -ne 0 ]]; then
    if [[ -n "${LANE_DEFER:-}" ]]; then
      warn "arbiter job.spawned receipt failed under --lane-defer (exit $receipt_rc); the deferred lane would be untrackable — failing the spawn so the initiator registers nothing: job_id=$JOB_ID pane_id=$PANE"
      hub_lane_orphan_remove
      return 2
    fi
    warn "arbiter job.spawned receipt failed (exit $receipt_rc); spawn remains successful: job_id=$JOB_ID pane_id=$PANE"
    hub_lane_orphan_remove
  fi
}

# #994/S1: a lane whose job.spawned receipt was never written is a row
# `wrk reap` can never attribute to a job — it would sit on the daemon
# forever. Deregister it while the machine and pane are still in hand (same
# credentials and machine+pane guard). An ordinary spawn remains successful
# on receipt failure; a deferred self-add is compensated before its required
# rc 2, with removal failure left for `panewire lanes-audit`.
hub_lane_orphan_remove() {
  [[ -n "${HUB_LANE:-}" ]] || return 0
  # #1397/(a): under --lane-defer the initiator owns the deferred row. Only
  # remove a deferred lane when this execution host set HUB_LANE_SELF after
  # its own lanes-token add; otherwise the row may belong to the initiator.
  if [[ -n "${LANE_DEFER:-}" ]]; then
    [[ "${HUB_LANE_SELF:-0}" -eq 1 ]] || return 0
  fi
  local lane="$HUB_LANE" machine="$HUB_LANE_MACHINE"
  HUB_LANE="" HUB_LANE_MACHINE="" HUB_LANE_SELF=""
  warn "hub lane '$lane' was registered but the job.spawned receipt was not written — deregistering it"
  hub_lane_remove "$lane" "$machine" "$PANE" "${ROLE:-worker}"
}

arbiter_admit() {
  if [[ -z "$ARBITER" ]]; then
    ARBITER="$(command -v arbiter 2>/dev/null || true)"
  fi
  if [[ -z "$ARBITER" || ! -e "$ARBITER" ]]; then
    warn "arbiter unavailable; admission control skipped during installation transition"
    return 0
  fi
  if [[ ! -x "$ARBITER" ]]; then
    warn "arbiter quota-pool record unavailable (not executable: $ARBITER); continuing spawn"
    return 0
  fi
  local probe probe_rc job_get_probe job_get_probe_rc
  set +e
  probe="$("$ARBITER" lease --help 2>&1)"
  probe_rc=$?
  set -e
  if [[ "$probe_rc" -ne 0 ]]; then
    if grep -Eiq "(unknown (command|subcommand).*lease|invalid choice.*lease|no such command.*lease|unrecognized.*lease|not a valid command.*lease)" <<<"$probe"; then
      warn "installed arbiter has no lease subcommand; admission control skipped during installation transition"
      return 0
    fi
    warn "arbiter quota-pool record probe failed (exit $probe_rc); continuing spawn"
    return 0
  fi
  # An arbiter predating the durable lookup is an installation-transition
  # version. Preserve the existing warn+continue contract rather than treating
  # it as a current arbiter that reported an uninspectable duplicate.
  set +e
  job_get_probe="$("$ARBITER" job-get --help 2>&1)"
  job_get_probe_rc=$?
  set -e
  if [[ "$job_get_probe_rc" -ne 0 ]]; then
    if grep -Eiq "(unknown (command|subcommand).*job-get|invalid choice.*job-get|no such command.*job-get|unrecognized.*job-get|not a valid command.*job-get)" <<<"$job_get_probe"; then
      warn "installed arbiter has no job-get subcommand; admission control skipped during installation transition"
      return 0
    fi
    # Keep the pre-existing no-duplicate path observational, but do not skip
    # claim: if this live arbiter subsequently reports a duplicate, the actual
    # lookup failure below must remain fail-closed.
    warn "arbiter job-get probe failed (exit $job_get_probe_rc); duplicate state will fail-closed if observed"
  fi
  # #768: an arbiter predating claim --task-id must not fail the claim on an
  # unknown flag — same installation-transition carve-out as the probes above.
  # The job meta then lacks task_id; the hk link itself is unaffected.
  if [[ "${#ARBITER_CLAIM_TASK_ARGS[@]}" -gt 0 ]]; then
    local claim_probe claim_probe_rc
    set +e
    claim_probe="$("$ARBITER" claim --help 2>&1)"
    claim_probe_rc=$?
    set -e
    if [[ "$claim_probe_rc" -ne 0 ]] || ! grep -q -- "--task-id" <<<"$claim_probe"; then
      warn "installed arbiter lacks claim --task-id; job meta will not record task_id (installation transition)"
      ARBITER_CLAIM_TASK_ARGS=()
    fi
  fi

  if [[ "$GATE_READY" -ne 1 ]]; then
    # No scopefuel result means no authoritative pool. Leasing a guessed pool would
    # be worse than not leasing — the same installation-transition exception applies.
    warn "scopefuel gate did not run; arbiter quota-pool record skipped during installation transition"
    return 0
  fi

  local claim_rc duplicate_rc
  set +e
  "$ARBITER" claim --job "$JOB_ID" --agent-label "$LABEL" --lane "$JOB_LANE" --t "$JOB_T" "${ARBITER_CLAIM_ROLE_ARGS[@]}" ${ARBITER_CLAIM_TASK_ARGS[@]+"${ARBITER_CLAIM_TASK_ARGS[@]}"} >/dev/null
  claim_rc=$?
  set -e
  case "$claim_rc" in
    0) ARBITER_JOB_REGISTERED=1 ;;
    4)
      set +e
      arbiter_handle_duplicate_claim
      duplicate_rc=$?
      set -e
      [[ "$duplicate_rc" -eq 0 ]] || return "$duplicate_rc"
      ;;
    *) warn "arbiter quota-pool claim failed (exit $claim_rc); continuing spawn"; ARBITER_CLAIM_FAILED=1; return 0 ;;
  esac

  local gate_file gate_rc record_json record_rc parsed rc
  set +e
  gate_file="$(mktemp)"
  gate_rc=$?
  set -e
  if [[ "$gate_rc" -ne 0 || -z "$gate_file" ]]; then
    warn "arbiter quota-pool record preparation failed (temporary file); continuing spawn"
    return 0
  fi
  if ! printf '%s\n' "$GATE_OUTPUT" >"$gate_file"; then
    rm -f "$gate_file" || true
    warn "arbiter quota-pool record preparation failed (gate output); continuing spawn"
    return 0
  fi
  set +e
  # ROB-1213: --profile stays the gate-normalized name — arbiter cross-checks it
  # against the gate output (fail-closed, keep). The *actual* launch goes in
  # --launch-profile: GATE_PROFILE collapses effort variants (codex-luna|-hi|-max
  # all gate as codex-luna-max), and recording only that made the ledger lie —
  # 2026-08-04: T3 jobs ran gpt-5.6-luna at *medium* (B, 42) while every record
  # claimed codex-luna-max (A+, 59). Only `ps` told the truth; finished jobs
  # became unauditable.
  #
  # task #677: the launch name is the canonical catalog profile, not the launcher
  # spelling. codex-sol/codex-max/codex/builder-sol/captain-sol all run gpt-6.1-sol
  # — the catalog profile is codex-sol (scopefuel PROFILE_ALIASES: codex-max ->
  # codex-sol), and scopefuel only knows the canonical name (`policy launch
  # builder-sol` is not in the catalog at all). Recording the raw spelling split
  # reps/usage attribution across names the grade table cannot read (2026-09-25:
  # a builder-sol xhigh spawn recorded launch_profile=builder-sol@xhigh while its
  # pane ran gpt-6-sol xhigh). Scoped to codex-kind profiles: every other pool
  # keeps its literal spelling@effort, so no other pool's records change.
  # Rollback spellings (codex-sol56, codex-sol6, builder-sol6) stay literal by
  # design — pinning the superseded model is the point, and the canon does not
  # carry the spellings' own ids (builder-sol6 records codex-sol@high via its
  # grade consult, but its model id never comes back from the canon).
  local launch_name="$MODEL"
  if [[ -n "${GATE_EFFORT_PIN:-}" ]]; then
    # #704: the E6 rung spellings are measurement aliases — record the canonical
    # rung (opus@low, kimi-k3@max, codex-sol@high) so reps attribute to the
    # profile@effort the gate judged, not a launcher-only name the grade table
    # cannot read (the same failure #677 fixed inside the codex pool).
    launch_name="$GATE_PROFILE"
  elif [[ "$PROFILE_KIND" == codex && -n "$CATALOG_PROFILE" ]]; then
    launch_name="$CATALOG_PROFILE"
  elif [[ "$MODEL" == builder-sonnet ]]; then
    # #921: the Sonnet 5.5 builder seat records the canonical catalog rung
    # (sonnet@<effort>) so E1/E2 reps attribute to the gated profile — the
    # same failure shape #677 fixed, applied to the claude pool.
    launch_name="$CATALOG_PROFILE"
  fi
  local launch_profile="$launch_name${EFFECTIVE_EFFORT:+@$EFFECTIVE_EFFORT}"
  record_json="$(SCOPEFUEL_BIN="$SCOPEFUEL" "$ARBITER" lease --job "$JOB_ID" --kind quota_pool \
    --profile "$GATE_PROFILE" --launch-profile "$launch_profile" --gate-output "$gate_file" --json)"
  record_rc=$?
  set -e
  rm -f "$gate_file" || true
  if [[ "$record_rc" -ne 0 ]]; then
    warn "arbiter quota-pool record failed (exit $record_rc); continuing spawn"
    return 0
  fi
  set +e
  parsed="$(printf '%s' "$record_json" |
    python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["pool"]); print(d["profile"]); print(d["started_at"])')"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    warn "arbiter quota-pool record output unreadable; continuing spawn"
    return 0
  fi
  {
    IFS= read -r ARBITER_RESOURCE
    IFS= read -r ARBITER_PROFILE
    IFS= read -r ARBITER_STARTED_AT
  } <<<"$parsed"
  if [[ -z "$ARBITER_RESOURCE" || -z "$ARBITER_PROFILE" || -z "$ARBITER_STARTED_AT" ]]; then
    warn "arbiter quota-pool record returned incomplete fields; continuing spawn"
    return 0
  fi
  ARBITER_HELD=1
  trap 'spawn_pane_cleanup; arbiter_release_held' EXIT
  # task #677: show the launch name next to the gate-normalized profile — the
  # observed line said profile=codex-max while the pane ran gpt-6-sol (the
  # family now runs gpt-6.1-sol, #1026), and the launch identity was only in
  # the event payload.
  echo "wrk: arbiter quota-pool record pool=$ARBITER_RESOURCE profile=$ARBITER_PROFILE launch_profile=$launch_profile job=$JOB_ID" >&2
}

# ROB-1227: a successful spawn is a quota-use event. The pool is already
# authoritative in arbiter's record, or in the scopefuel gate output when
# arbiter is unavailable; wrk deliberately owns no provider mapping.
refresh_quota_pool() {
  local pool="${ARBITER_RESOURCE:-}"
  if [[ -z "$pool" && "${GATE_READY:-0}" -eq 1 ]]; then
    pool="${GATE_OUTPUT#* pool=}"
    pool="${pool%% *}"
  fi
  if [[ -z "$pool" ]]; then
    warn "scopefuel refresh skipped; gate/arbiter did not provide a pool"
    return 0
  fi
  if [[ -z "${SCOPEFUEL:-}" || ! -x "$SCOPEFUEL" ]]; then
    warn "scopefuel refresh skipped; executable unavailable"
    return 0
  fi

  # The CLI's --background contract is itself non-blocking. Start a tiny
  # supervisor detached from wrk; it owns both the refresh child and timeout
  # cleanup in one dedicated process group. Its stderr stays attached so a
  # refresh failure/timeout is user-visible while spawn remains fail-open
  # (the attachment is bounded — callers capturing output wait at most
  # WRK_REFRESH_TIMEOUT_S for the supervisor). #770 gives it a bounded,
  # traceable lifetime: pid/pool/deadline/start in JOB/quota-refresh.pid,
  # the pidfile removed on the way out, and `wrk prune` can recognise a
  # leftover (verified by start time before signalling, so a reused pid is
  # never killed).
  local refresh_pidfile=""
  if [[ -n "${JOB_ID:-}" ]]; then
    refresh_pidfile="$(wrk_jobs_root)/$JOB_ID/quota-refresh.pid"
    mkdir -p "$(dirname "$refresh_pidfile")" 2>/dev/null || refresh_pidfile=""
  fi
  (
    python3 - "$SCOPEFUEL" "$pool" "${WRK_REFRESH_TIMEOUT_S:-5}" "$refresh_pidfile" "${JOB_ID:-}" <<'PY'
import os
import signal
import subprocess
import sys
import time


if os.fork():
    os._exit(0)
os.setsid()
scopefuel, pool, timeout_arg, pidfile, job = sys.argv[1:]
try:
    timeout = max(0.01, float(timeout_arg))
except ValueError:
    timeout = 5.0

if pidfile:
    try:
        with open(pidfile, "w", encoding="utf-8") as handle:
            handle.write("pid=%d pool=%s job=%s timeout=%s deadline=%d started=%d\n" % (
                os.getpid(), pool, job, timeout_arg,
                int(time.time() + timeout), int(time.time())))
    except OSError:
        pidfile = ""


def drop_pidfile():
    if pidfile:
        try:
            os.unlink(pidfile)
        except OSError:
            pass


proc = subprocess.Popen(
    [scopefuel, "refresh", pool, "--background"],
    stdin=subprocess.DEVNULL,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
    close_fds=True,
    # The refresh child gets its own process group so the timeout path can
    # kill the whole tree without the supervisor SIGKILLing itself mid-
    # cleanup (a group kill of its own pgid never reaches drop_pidfile).
    start_new_session=True,
)


def _term(_sig, _frame):
    # wrk prune --apply signals the supervisor's group; cascade to the
    # refresh child's group before going down so no refresh outlives us.
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except OSError:
        pass
    drop_pidfile()
    os._exit(143)


signal.signal(signal.SIGTERM, _term)
signal.signal(signal.SIGINT, _term)

try:
    refresh_rc = proc.wait(timeout=timeout)
except subprocess.TimeoutExpired:
    print(
        f"wrk: warning: scopefuel refresh timed out for pool={pool}; spawn already succeeded",
        file=sys.stderr,
        flush=True,
    )
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except OSError:
        pass
    time.sleep(0.2)
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except OSError:
        pass
    proc.wait()
    drop_pidfile()
    os._exit(124)

drop_pidfile()
if refresh_rc != 0:
    print(
        f"wrk: warning: scopefuel refresh failed for pool={pool}; spawn already succeeded",
        file=sys.stderr,
    )
PY
  ) </dev/null >/dev/null &
}

# resolve_catalog_profile
#
# Maps a launcher spelling to its canonical catalog profile, and to the effort
# rung the spelling pins (empty = take the catalog's default rung). A spelling
# left out of this table keeps its literal model id and effort — that is the
# fail-safe direction, and it is where the deliberate exceptions live:
#
#   * rollback spellings (codex-sol56, codex-luna56, codex-sol6, grok45*,
#     grok46*, agy-flash36) exist precisely to pin a superseded model. An
#     explicit pin outranks the canon, or the rollback lever does nothing.
#   * builder-sol6 is the one split case: it stays in this table because the
#     builder seat still needs the codex-sol@high grade consult (the canon's
#     effort and the quota record's codex-sol@high launch_profile), but
#     CATALOG_KEEP_MODEL keeps its model id literal so the consult can never
#     hand back gpt-6.1-sol.
#   * profiles the catalog does not carry (oc-*, kimi-*, devin-*, the ungraded
#     kiro-* experiments, cc-dsflash/cc-dspro/cc-glm53) keep their literal argv.
#   * profiles whose CLI argument is not the model id (agy encodes the effort
#     into the model name; opus/sonnet/haiku pass a CLI alias) take only the
#     effort from the catalog — the alias itself is argv skeleton and stays here.
#
# The GATE_PROFILE table above is a different mapping and must not be reused:
# kiro-glm gates as kiro-sol but must never launch Sol's model id.
resolve_catalog_profile() {
  case "$MODEL" in
    opus|builder-opus|captain-opus) CATALOG_PROFILE=opus ;;
    sonnet|sonnet-med) CATALOG_PROFILE=sonnet ;;
    # #704 (#594 E6): the per-rung builder spellings consult the catalog at the
    # rung they pin — the suffix is the rung by construction.
    builder-opus-low|builder-opus-medium) CATALOG_PROFILE=opus; CATALOG_EFFORT_PIN="${MODEL##*-}" ;;
    builder-sonnet-xhigh|builder-sonnet-max|builder-sonnet-medium|builder-sonnet-low) CATALOG_PROFILE=sonnet; CATALOG_EFFORT_PIN="${MODEL##*-}" ;;
    # hk 1796: builder-haiku-low (hk 1786 L4 arm) consults haiku@low; hk 1863
    # adds the high/xhigh/max rungs of the same profile.
    builder-haiku-low|builder-haiku-high|builder-haiku-xhigh|builder-haiku-max) CATALOG_PROFILE=haiku; CATALOG_EFFORT_PIN="${MODEL##*-}" ;;
    # #921: the non-rung Sonnet builder consults the canon at the rung it will
    # actually take — an unpinned consult answers sonnet's own high default and
    # apply_catalog would silently overwrite this profile's xhigh default.
    builder-sonnet) CATALOG_PROFILE=sonnet; CATALOG_EFFORT_PIN="${EFFORT:-xhigh}" ;;
    haiku) CATALOG_PROFILE=haiku ;;
    fable) CATALOG_PROFILE=fable ;;

    codex) CATALOG_PROFILE=codex-sol; CATALOG_EFFORT_PIN=high ;;
    codex-sol|codex-max) CATALOG_PROFILE=codex-sol ;;
    # 2026-09-26 (decision 4088 B): builder-sol defaults to the high rung, so
    # builder-sol consults the catalog at the high rung — the same shape the
    # generic `codex` spelling already uses. The worker spellings above keep
    # the catalog's own default.
    builder-sol|captain-sol) CATALOG_PROFILE=codex-sol; CATALOG_EFFORT_PIN=high ;;
    # #1026: builder-sol6 is builder-sol's rollback spelling — same builder-seat
    # consult (codex-sol@high, so the quota record names the graded rung), but
    # CATALOG_KEEP_MODEL pins the literal gpt-6-sol: the consult feeds effort
    # and attribution only, never the model id.
    builder-sol6) CATALOG_PROFILE=codex-sol; CATALOG_EFFORT_PIN=high; CATALOG_KEEP_MODEL=1 ;;
    codex-terra|codex-med) CATALOG_PROFILE=codex-terra; CATALOG_EFFORT_PIN=medium ;;
    codex-terra-max) CATALOG_PROFILE=codex-terra-max ;;
    codex-luna) CATALOG_PROFILE=codex-luna; CATALOG_EFFORT_PIN=medium ;;
    codex-luna-hi) CATALOG_PROFILE=codex-luna; CATALOG_EFFORT_PIN=high ;;
    codex-luna-max) CATALOG_PROFILE=codex-luna-max ;;
    # #633: builder-luna is codex-luna admitted under --role builder at the
    # #594 E3 effort (xhigh) — pinned so the catalog is consulted at the same
    # effort the grade ceiling was rated at.
    builder-luna) CATALOG_PROFILE=codex-luna; CATALOG_EFFORT_PIN=xhigh ;;
    # #704: the E6 codex rungs resolve against the canonical catalog profile at
    # their pinned effort, so the quota record's launch_profile is the exact
    # catalog rung (codex-sol@high, codex-luna@max ...).
    # #737 adds builder-sol-medium (codex-sol@medium) on the same pin rule.
    builder-sol-high|builder-sol-max|builder-sol-medium|builder-sol-low) CATALOG_PROFILE=codex-sol; CATALOG_EFFORT_PIN="${MODEL##*-}" ;;
    builder-luna-max) CATALOG_PROFILE=codex-luna; CATALOG_EFFORT_PIN=max ;;
    # hk 1796: the luna E6 pair consults the canonical codex-luna catalog row
    # at its pinned rung — the model id comes back from that row (today
    # codex-luna@low serves gpt-5.6-luna), never a launcher literal.
    builder-luna-low|builder-luna-medium) CATALOG_PROFILE=codex-luna; CATALOG_EFFORT_PIN="${MODEL##*-}" ;;
    builder-terra-high|builder-terra-xhigh|builder-terra-max) CATALOG_PROFILE=codex-terra; CATALOG_EFFORT_PIN="${MODEL##*-}" ;;
    codex-astra) CATALOG_PROFILE=codex-astra ;;

    kiro-opus) CATALOG_PROFILE=kiro-opus ;;
    kiro-opus-xhigh) CATALOG_PROFILE=kiro-opus; CATALOG_EFFORT_PIN=xhigh ;;
    kiro-opus-max) CATALOG_PROFILE=kiro-opus; CATALOG_EFFORT_PIN=max ;;
    kiro-sonnet) CATALOG_PROFILE=kiro-sonnet ;;
    kiro-sol) CATALOG_PROFILE=kiro-sol ;;
    kiro-sol-xhigh) CATALOG_PROFILE=kiro-sol; CATALOG_EFFORT_PIN=xhigh ;;
    kiro-sol-max) CATALOG_PROFILE=kiro-sol; CATALOG_EFFORT_PIN=max ;;
    kiro-cheap) CATALOG_PROFILE=kiro-cheap ;;
    kiro-haiku) CATALOG_PROFILE=kiro-haiku ;;

    grok|grok-hi) CATALOG_PROFILE=grok-hi ;;
    grok-med) CATALOG_PROFILE=grok; CATALOG_EFFORT_PIN=medium ;;
    builder-grok) CATALOG_PROFILE=grok-hi; CATALOG_EFFORT_PIN=xhigh ;;
    # #737 (decision 4088): the E6 grok rungs consult the catalog at their
    # pinned rung so the quota record's launch_profile is grok-hi@<rung>.
    builder-grok-low|builder-grok-medium|builder-grok-xhigh) CATALOG_PROFILE=grok-hi; CATALOG_EFFORT_PIN="${MODEL##*-}" ;;

    cc-qwen38) CATALOG_PROFILE=cc-qwen38 ;;
    cc-glm) CATALOG_PROFILE=cc-glm ;;
  esac
}

# apply_catalog
#
# Replaces this spelling's model id and default effort with the canonical values
# from `scopefuel policy launch`. Every path that does *not* end in a canonical
# answer sets CATALOG_STALE=1, which the spawn brief carries as a
# `wrk-note: catalog=stale` line — including the ones that look like ordinary tolerance
# (scopefuel absent, too old to have the subcommand, request failed). "We could
# not confirm the canon" is one fact, and a launch that quietly used its own
# table while claiming nothing is exactly the silence this change removes.
#
# rc 3 is the one non-zero rc that is not stale: the canon answered and refused
# (consult_only without an operator request). The quota gate below re-runs that
# judgement and is the thing that stops the spawn, so the launcher keeps its
# literal values and does not mislabel a refusal as a missing canon.
apply_catalog() {
  ROUND_EXT_CATALOG_VERIFIED=0
  [[ -n "$CATALOG_PROFILE" ]] || return 0

  if [[ -z "${SCOPEFUEL:-}" ]]; then
    SCOPEFUEL="$(command -v "${SCOPEFUEL_BIN:-scopefuel}" 2>/dev/null || true)"
  fi
  if [[ -z "$SCOPEFUEL" || ! -x "$SCOPEFUEL" ]]; then
    CATALOG_STALE=1
    warn "scopefuel unavailable; launch catalog not consulted (catalog=stale)"
    return 0
  fi

  local launch_args=(policy launch "$CATALOG_PROFILE" --json)
  [[ -z "$CATALOG_EFFORT_PIN" ]] || launch_args+=(--effort "$CATALOG_EFFORT_PIN")
  if [[ -n "${ROUND_EXT_REF:-}" ]]; then
    launch_args+=(--operator-request "$ROUND_EXT_REF")
  elif [[ -n "${OPERATOR_REQUEST:-}" ]]; then
    launch_args+=(--operator-request "$OPERATOR_REQUEST")
  fi
  # task #527 + #593: the declared purpose reaches the catalog too, not only the
  # quota gate. A bare `-m codex-astra` is the architect counsel path (PURPOSE is
  # defaulted to architect above), the gate admits it, and the catalog marks astra
  # consult_only — without forwarding this, the two restrictions became cumulative
  # and an approved invocation died between them. Forwarded verbatim: which
  # purposes count is scopefuel's judgement, not wrk's, and it applies the rule to
  # astra only.
  [[ -z "${PURPOSE:-}" ]] || launch_args+=(--purpose "$PURPOSE")
  if [[ "$MODEL" == codex-astra || "$MODEL" == fable ]]; then
    launch_args+=(--role "$ROLE")
  fi

  # Keep stderr: rc 3 has several distinct reasons (consult_only, a retired rung,
  # an unknown profile, a gate a stale catalog may not widen) and only scopefuel
  # knows which one applies. Discarding it and hard-coding one remedy sent the
  # operator after --operator-request for refusals that flag cannot fix.
  local out err_file rc=0
  err_file="$(mktemp "${TMPDIR:-/tmp}/wrk-policy-launch.XXXXXX")" || err_file=""
  set +e
  if [[ -n "$err_file" ]]; then
    out="$("$SCOPEFUEL" "${launch_args[@]}" 2>"$err_file")"
  else
    out="$("$SCOPEFUEL" "${launch_args[@]}" 2>/dev/null)"
  fi
  rc=$?
  set -e
  CATALOG_REFUSE_REASON=""
  if [[ -n "$err_file" ]]; then
    # #1045 (scopefuel #1024): a broken config prints a ~190-char
    # "scopefuel: warning:" line ahead of the refusal, and squeezing all of
    # stderr kept the warning while cutting the actual reason away. The
    # warnings are the operator's config signal, not the refusal's — stderr is
    # captured here, so on a failure they are re-emitted verbatim or the
    # operator never sees the broken config at all — and the reason is built
    # from the remaining lines, falling back to the last non-empty line so an
    # all-warning stderr still reports something. The 240-char cap is
    # unchanged. #1226: the re-emit fires only when the launch did not
    # succeed — on rc 0 the quota gate's own scopefuel call already passes the
    # same warning through, so re-printing here showed it twice per spawn. A
    # reason that is whitespace-only (a warning followed by a blank line)
    # counts as empty so the fallback applies, and the fallback never picks a
    # whitespace-only line.
    if [[ "$rc" -ne 0 ]]; then
      grep '^scopefuel: warning:' "$err_file" >&2 || true
    fi
    CATALOG_REFUSE_REASON="$(grep -v '^scopefuel: warning:' "$err_file" | tr -s '[:space:]' ' ' | cut -c1-240 || true)"
    if [[ -z "${CATALOG_REFUSE_REASON//[[:space:]]/}" ]]; then
      CATALOG_REFUSE_REASON="$(grep '[^[:space:]]' "$err_file" | tail -n 1 | tr -s '[:space:]' ' ' | cut -c1-240 || true)"
    fi
    rm -f "$err_file"
  fi

  if [[ "$rc" -eq 3 ]]; then
    # The canon answered and refused. Recorded, not acted on yet — the quota gate
    # runs first because its refusal carries alternatives ("대안(S+): …") that
    # this one cannot. If the gate lets the spawn through, the refusal below
    # stops it: the gate judges quota and escalation, not catalog gates, so a
    # permissive gate must not launch what the canon declined.
    CATALOG_REFUSED=1
    return 0
  fi
  if [[ "$rc" -ne 0 || -z "$out" ]]; then
    CATALOG_STALE=1
    warn "scopefuel policy launch failed (rc=$rc); using the launcher's own values (catalog=stale)"
    return 0
  fi

  local parsed
  if ! parsed="$(printf '%s' "$out" | python3 -c '
import json, sys

try:
    payload = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
catalog = payload.get("catalog")
if not isinstance(catalog, dict) or "stale" not in catalog:
    # No provenance block means the answer cannot be shown to have come from the
    # canon — an old build, a proxy, a truncated write. Treat it exactly like an
    # unreachable catalog rather than trusting the values it did send.
    sys.exit(1)
if sys.argv[1] == "builder" and sys.argv[3]:
    expected = {"policy": "hk1672/v1", "profile": sys.argv[2], "role": "builder",
                "purpose": "round-extension", "ref": sys.argv[3]}
    if payload.get("round_extension_builder") != expected:
        sys.exit(1)
# One field per line, not a tab-joined record: tab is IFS whitespace, so bash
# collapses a leading empty field and every later field shifts up by one. An
# empty model_id is normal (sonnet/haiku launch by CLI alias), and the shift
# silently turned the effort into the catalog source.
print("\n".join([
    str(payload.get("model_id") or ""),
    str(payload.get("effort") or ""),
    str(catalog.get("source") or ""),
    "1" if catalog.get("stale") else "0",
]))
' "${ROLE:-}" "$MODEL" "${ROUND_EXT_REF:-}" 2>/dev/null)"; then
    CATALOG_STALE=1
    warn "scopefuel policy launch returned unreadable JSON; using the launcher's own values (catalog=stale)"
    return 0
  fi

  local model_id effort _source stale
  { read -r model_id; read -r effort; read -r _source; read -r stale; } <<<"$parsed"
  if [[ "${ROLE:-}" == builder && -n "${ROUND_EXT_REF:-}" ]]; then
    case "$MODEL:$model_id:$effort" in
      codex-astra:gpt-6-astra:xhigh|fable:claude-fable-5-1:) ROUND_EXT_CATALOG_VERIFIED=1 ;;
      *) die "--round-ext builder requires the approved model and effort from scopefuel policy launch" ;;
    esac
  fi
  [[ "$stale" != "1" ]] || CATALOG_STALE=1

  # Only the kinds whose CLI argument *is* the model id consume it. For the
  # Claude CLI the argument is an alias ("--model opus"), which stays argv
  # skeleton; fable is the one Claude profile launched by literal model id.
  # #1026: CATALOG_KEEP_MODEL skips this consumption entirely — builder-sol6
  # consults the canon for effort/attribution but pins its literal model id.
  if [[ -n "$model_id" && -z "${CATALOG_KEEP_MODEL:-}" ]]; then
    case "$PROFILE_KIND" in
      codex|kiro) PROFILE_MODEL="$model_id" ;;
      grok) PROFILE_MODEL_ARG="$model_id" ;;
      claude)
        [[ "$MODEL" != fable ]] || ARGS=(--model "$model_id" --dangerously-skip-permissions) ;;
    esac
  fi
  [[ -z "$effort" || "$EFFORT_SUPPORTED" -ne 1 ]] || DEFAULT_EFFORT="$effort"
}

resolve_profile() {
  PROFILE_KIND=""
  PROFILE_MODEL=""
  DEFAULT_EFFORT=""
  EFFORT_SUPPORTED=0
  ARGS=()
  PROFILE_ENV=()
  KIMI_TRUST_HOME=""
  PROFILE_MODEL_ARG=""
  CATALOG_PROFILE=""
  CATALOG_EFFORT_PIN=""
  CATALOG_KEEP_MODEL=""
  CATALOG_STALE=0
  CATALOG_REFUSED=0
  CATALOG_REFUSE_REASON=""
  GATE_EFFORT_PIN=""

  case "$MODEL" in
    # ROB-1191 ⑥: opus/sonnet only — CLI --effort argv (never mutate settings.json).
    # Defaults align with scopefuel Profile.benchmark_effort (opus=high, sonnet=high).
    opus) PROFILE_KIND=claude; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1; ARGS=(--model opus --dangerously-skip-permissions) ;;
    builder-opus|captain-opus) PROFILE_KIND=claude; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1; ARGS=(--model opus --dangerously-skip-permissions) ;;
    # #704 (#594 E6): per-rung builder spellings — the name's last segment IS
    # the pinned rung, and spawn refuses both an off-rung --effort and a
    # missing/mismatched SCOPEFUEL_E6_ARM=<gate profile>@<rung> marker (the
    # marker is the only channel that tells the gate which rung to judge).
    builder-opus-low|builder-opus-medium) PROFILE_KIND=claude; DEFAULT_EFFORT="${MODEL##*-}"; EFFORT_SUPPORTED=1; ARGS=(--model opus --dangerously-skip-permissions) ;;
    builder-sonnet-xhigh|builder-sonnet-max|builder-sonnet-medium|builder-sonnet-low) PROFILE_KIND=claude; DEFAULT_EFFORT="${MODEL##*-}"; EFFORT_SUPPORTED=1; ARGS=(--model sonnet --dangerously-skip-permissions) ;;
    # hk 1796: the haiku builder rung (hk 1786 L4 arm) — the same argv shape
    # as the haiku worker, pinned to low; hk 1863 adds high, xhigh and max.
    builder-haiku-low|builder-haiku-high|builder-haiku-xhigh|builder-haiku-max) PROFILE_KIND=claude; DEFAULT_EFFORT="${MODEL##*-}"; EFFORT_SUPPORTED=1; ARGS=(--model haiku --dangerously-skip-permissions) ;;
    # #921: Sonnet 5.5 builder seat — the builder-opus argv shape on the sonnet
    # alias. The closed effort set (high|xhigh|max) is enforced in the --role
    # builder arm below; default xhigh (E1 rung).
    builder-sonnet) PROFILE_KIND=claude; DEFAULT_EFFORT=xhigh; EFFORT_SUPPORTED=1; ARGS=(--model sonnet --dangerously-skip-permissions) ;;
    sonnet|sonnet-med) PROFILE_KIND=claude; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1; ARGS=(--model sonnet --dangerously-skip-permissions) ;;
    haiku) PROFILE_KIND=claude; DEFAULT_EFFORT=low; EFFORT_SUPPORTED=1; ARGS=(--model haiku --dangerously-skip-permissions) ;;
    fable) PROFILE_KIND=claude; ARGS=(--model claude-fable-5-1 --dangerously-skip-permissions) ;;
    # Devin profile. Herdr owns detection through --kind devin;
    # keep its launch argv exact and do not add a prompt or effort flag.
    # Unattended pane: accept-edits prompts on every shell command and stalls (task201).
    # Task 240 pilot: builder-devin is the same profile admitted under
    # --role builder (operator decision 2026-09-14 §3) — identical argv.
    devin-swe2|builder-devin) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model swe-2 --permission-mode dangerous --respect-workspace-trust false) ;;
    # Operator decision 2026-09-14 (devin-pro-paid-models): three more Devin
    # model profiles — identical unattended argv, only the --model name
    # differs. glm-5-2 and swe-1-7 are free-pool; deepseek-v4-1-flash-high is
    # the only paid spelling ($0.22/1M in). High-priced Devin models
    # (Fable/Astra/Kimi) stay unlisted — they would duplicate the
    # claude/codex subscription spend. The 2026-10-10 operator decision
    # (hk 1380) supersedes the 09-14 no-paid-Devin line for two paid fusion
    # spellings only: devin-fusion-opus55 and devin-fusion-sonnet55 below.
    devin-glm52) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model glm-5-2 --permission-mode dangerous --respect-workspace-trust false) ;;
    devin-swe17) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model swe-1-7 --permission-mode dangerous --respect-workspace-trust false) ;;
    # #666: builder-ds41 admits the paid ds41 rung under --role builder with
    # the identical argv (the operator's ds41-builder policy); the devin-ds41
    # worker spelling itself stays worker-only there.
    devin-ds41|builder-ds41) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model deepseek-v4-1-flash-high --permission-mode dangerous --respect-workspace-trust false) ;;
    # Task #635: devin effort lives inside the model id — there is no --effort
    # flag — so each rung is a named profile on the same unattended argv.
    # devin-swe2 stays the high default; swe-2-medium/max are the free rungs,
    # ds41-max the paid max rung. The swe-2 effort spellings are also admitted
    # under --role builder (that is the builder-devin effort path), and #666
    # adds the named builder spellings builder-devin-medium/-max and
    # builder-ds41-max — same argv as the worker variants.
    devin-swe2-medium|builder-devin-medium) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model swe-2-medium --permission-mode dangerous --respect-workspace-trust false) ;;
    devin-swe2-max|builder-devin-max) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model swe-2-max --permission-mode dangerous --respect-workspace-trust false) ;;
    devin-ds41-max|builder-ds41-max) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model deepseek-v4-1-flash-max --permission-mode dangerous --respect-workspace-trust false) ;;
    # hk 1380 (operator decision 2026-10-10, Devin paid lane): the Claude 5.5
    # fusion spellings — identical unattended argv, only the --model name
    # differs. Worker/tester-only; there are no builder-* spellings and the
    # --role builder allowlist refuses both names (fusion builder use is
    # decided after hk 1382). No Fable or Astra fusion.
    devin-fusion-opus55) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model fusion-claude-opus-5-5-high-sidekick-swe-2-medium --permission-mode dangerous --respect-workspace-trust false) ;;
    devin-fusion-sonnet55) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model fusion-claude-sonnet-5-5-high-sidekick-swe-2-medium --permission-mode dangerous --respect-workspace-trust false) ;;
    # hk 1729: Fusion-Sol uses the Devin launcher but bills against codex.
    # Its pane label does not show lead effort; catalog and job records do.
    devin-fusion-sol61) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model fusion-gpt-6-1-sol-high-sidekick-swe-2-medium --permission-mode dangerous --respect-workspace-trust false) ;;
    devin-fusion-sol61-xhigh) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model fusion-gpt-6-1-sol-xhigh-sidekick-swe-2-medium --permission-mode dangerous --respect-workspace-trust false) ;;
    # hk 1620 (operator decision 2026-10-18 devin-argon-trial, phase 1, approved
    # by operator-desk r1018b953go): the Gemini 4 Argon trial spellings —
    # identical unattended argv, only the --model name differs; the rung is
    # baked into the model id like every devin spelling. Paid ($1/1M in),
    # worker/tester-only; there are no builder-* spellings and the --role
    # builder allowlist refuses all three names. devin-argon is the high rung
    # (the devin-swe2 -> swe-2 default shape). Phase 1 is spawn plumbing only:
    # no grade placement, trial reps pending (2 tester/checker reps by 10-27).
    devin-argon) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model gemini-4-argon-high --permission-mode dangerous --respect-workspace-trust false) ;;
    devin-argon-medium) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model gemini-4-argon-medium --permission-mode dangerous --respect-workspace-trust false) ;;
    devin-argon-low) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model gemini-4-argon-low --permission-mode dangerous --respect-workspace-trust false) ;;

    # cc-qwen38/cc-glm/cc-dsflash/cc-dspro/cc-glm53: Claude Code CLI harness,
    # model traffic redirected via env to CLIProxyAPI(127.0.0.1:8317) -> ClinePass.
    # See CLINEPASS_GATE_* comment above for the wiring rationale (ROB-1252/ROB-1253).
    #
    # 실험 지정 별칭 — reps 축적 전까지 급표 미등재. cc-dspro=V4-Pro 0813(TB 87.9·AA int max 53.2,
    # 단 TB 는 벤더 자체보고), cc-glm53=GLM-5.3(TB 88.2 벤더 자체보고, GLM-5.2 베이스 상방 후보).
    # cc-dsflash=oc-dsflash 의 하네스 A/B 짝.
    cc-qwen38|cc-glm|cc-dsflash|cc-dspro|cc-glm53)
      PROFILE_KIND=claude; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1
      [[ -r "$CLINEPASS_GATE_KEY_FILE" ]] || die "clinepass gate key file not found/readable: $CLINEPASS_GATE_KEY_FILE"
      CLINEPASS_GATE_KEY="$(<"$CLINEPASS_GATE_KEY_FILE")"
      CLINEPASS_GATE_KEY="${CLINEPASS_GATE_KEY//$'\n'/}"
      [[ -n "$CLINEPASS_GATE_KEY" ]] || die "clinepass gate key file is empty: $CLINEPASS_GATE_KEY_FILE"
      ARGS=(--model "$MODEL" --dangerously-skip-permissions)
      # Claude Code 는 이 별칭들을 모르는 모델로 보고 컨텍스트 창을 200k 로 가정한다
      # (경고: "not a model this version of Claude Code recognizes"). 1M 짜리 모델이면
      # 200k 에서 auto-compact 가 돌아 창의 80% 를 버린다.
      #
      # 🔴 값은 **프로필별**로 둔다 — 일괄 1M 금지(ROB-1254 정정). 근거 등급이 다르다:
      #   - models.dev 에 **cline-pass 전용 항목**이 있는 3종만 확정값을 준다:
      #     cline-pass/{deepseek-v4-flash,deepseek-v4-pro,glm-5.2} = 1,000,000.
      #   - qwen3.8-max·glm-5.3 은 cline-pass 항목이 **없다**. 타 제공자 값은 서로 어긋나고
      #     (alibaba 1,000,000 / nano-gpt·aihubmix 991,000 / digitalocean 262,144),
      #     ClinePass 는 qwen 을 자체 배포본 `private/qwen3p8-max-wave` 로 서빙하므로
      #     원 제공자의 창이 그대로일 보장이 없다 → **미설정(Claude Code 기본 200k)**.
      # 🔴 비대칭: 과소가정은 조기 compact 뿐이지만 **과대가정은 작업 중 API 에러**다.
      # 해제 조건: models.dev 에 cline-pass 항목이 생기거나 실측 이분탐색으로 하한 확인.
      # (2026-08-15 초과 프로브로 확인된 별개 한도: `private/*-wave` 배포본은 요청 본문
      #  **6,291,456 바이트** 상한, max_tokens 상한은 5종 모두 131,072.)
      CC_CONTEXT_TOKENS=""
      case "$MODEL" in
        cc-dsflash|cc-dspro|cc-glm) CC_CONTEXT_TOKENS=1000000 ;;
      esac
      PROFILE_ENV=(
        --env "ANTHROPIC_BASE_URL=$CLINEPASS_GATE_URL"
        --env "ANTHROPIC_AUTH_TOKEN=$CLINEPASS_GATE_KEY"
      )
      if [[ -n "$CC_CONTEXT_TOKENS" ]]; then
        PROFILE_ENV+=(--env "CLAUDE_CODE_MAX_CONTEXT_TOKENS=$CC_CONTEXT_TOKENS")
      fi
      ;;

    codex-terra|codex-med) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-terra; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    codex-terra-max) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-terra; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    codex-luna) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6-luna; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    codex-luna-hi) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6-luna; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    codex-luna-max) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6-luna; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    codex) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6.1-sol; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
