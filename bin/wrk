#!/usr/bin/env bash
# wrk — herdr spawn/find/name-sync entrypoint.
set -euo pipefail

HERDR="${HERDR_BIN:-$HOME/.local/bin/herdr}"
SCOPEFUEL="${SCOPEFUEL_BIN:-}"
ARBITER="${ARBITER_BIN:-}"
# #609: one wrk process is one spawn attempt; fixture herdr keys its pane
# foreground state on this so process-info does not depend on a call log.
# Real herdr never reads it.
export WRK_RUN_ID="${WRK_RUN_ID:-$$}"
# A live duplicate is an exact-once violation, distinct from generic CLI
# misuse (2) and the arbiter's own duplicate result (4).  75 means that an
# arbiter duplicate was observed but its state could not be proven safely.
WRK_EXIT_ACTIVE_JOB_DUPLICATE=74
WRK_EXIT_JOB_STATE_UNREADABLE=75
# A pane may be valid even when the submitted brief cannot be positively
# observed. Automation opts into 76 to distinguish that outcome from the
# ROB-1326 duplicate-job contracts above.
WRK_EXIT_LANDING_UNCONFIRMED=76
# #758: a refused tester-round open at the cap. Distinct from generic misuse
# (2) so a builder loop can tell "stop and wait" apart from a bad invocation.
WRK_EXIT_ROUND_CAP=78
# #872: distinguish physical mock MCP isolation refusal from quota/usage errors.
WRK_EXIT_MOCK_MCP_REFUSED=79
# The hub quota gate's fail-closed refusals (a bad [hub] quota_gate value, a
# contradictory or incomplete gate config, a rejected policy response) and,
# since #1163, a malformed [local] table — the spawn flag must never read
# "allowed" on a typo.  A remote wrk answers its delegated spawn with 70,
# and under --host auto that must stop the candidate round (#1154) — never
# fall back to a local spawn.
WRK_EXIT_CONFIG_REFUSED=70
# #1155: this host's own hosts.toml [local] spawn = false forbids local spawns.
# --host local and every local fallback answer 80; a remote wrk answers its
# delegated spawn with it too, and under --host auto that answer must NOT stop
# the round — the next remote candidate is tried.
WRK_EXIT_LOCAL_SPAWN_DISABLED=80
# #1239: a wake attempt on a wake-capable host that was refused, timed out, or
# left the host unreachable ends the spawn with 81 and never falls back to a
# local pane. A remote wrk answering 81 is a capacity-adjacent answer (its own
# wake failed), not an admission refusal — under --host auto it is not in the
# stop set, so the round moves on to the next candidate.
WRK_EXIT_WAKE_FAILED=81
# kimi-k3-low: KIMI_CODE_HOME for the low-thinking-effort clone maintained by
# bin/kimi-clone-home (config.toml [thinking] effort=low; real ~/.kimi-code
# untouched). Scoped to only this profile below, not kimi-k3/kimi-k27.
KIMI_CODE_LOW_HOME="${KIMI_CODE_LOW_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/kimi-code-low}"
# #704 (#594 E6): the kimi builder rungs take their effort from pinned clone
# homes the same way (bin/kimi-clone-home --effort high|max) — the kimi CLI
# has no --effort flag, so the clone's [thinking] effort is the only lever.
KIMI_CODE_HIGH_HOME="${KIMI_CODE_HIGH_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/kimi-code-high}"
KIMI_CODE_MAX_HOME="${KIMI_CODE_MAX_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/kimi-code-max}"
# ROB-1252: cc-qwen38/cc-glm route the Claude Code CLI itself through the
# CLIProxyAPI instance at 127.0.0.1:8317 (openai-compatibility provider
# "cline-pass" registered in ~/.cli-proxy-api/config.yaml, aliases
# cc-qwen38/cc-glm), which translates to Cline's OpenAI-compat chat/completions
# upstream and re-serves native Anthropic /v1/messages — no ClinePass Anthropic
# ingress exists (verified: /anthropic, /api/v1/messages, /v1/messages all 404).
# The gate API key lives only in this file, read fresh at spawn time and passed
# solely into the spawned pane's env — never into ~/.claude/ config.
CLINEPASS_GATE_URL="http://127.0.0.1:8317"
CLINEPASS_GATE_KEY_FILE="${CLINEPASS_GATE_KEY_FILE:-$HOME/.config/cliproxyapi-key.txt}"

# 프로필 이름 전체 목록(resolve_profile 의 case 문과 동기화 유지) — `wrk profiles` 출력 및
# scopefuel 교차검증(추천 프로필 ⊆ wrk 가 띄울 수 있는 프로필)의 근거.
ALL_PROFILES=(
  opus sonnet sonnet-med haiku fable builder-opus captain-opus builder-sonnet
  devin-swe2 devin-swe2-medium devin-swe2-max builder-devin
  builder-devin-medium builder-devin-max
  devin-glm52 devin-swe17 devin-ds41 devin-ds41-max
  builder-ds41 builder-ds41-max
  codex-terra codex-med codex-terra-max codex-luna codex-luna-hi codex-luna-max
  codex codex-sol codex-max builder-sol builder-luna captain-sol codex-astra
  codex-sol56 codex-luna56 codex-sol6 builder-sol6
  builder-opus-low builder-opus-medium builder-sonnet-xhigh builder-sonnet-max
  builder-sol-high builder-sol-max builder-sol-medium builder-luna-max
  builder-terra-high builder-terra-xhigh builder-terra-max
  kiro kiro-opus kiro-sonnet kiro-sol kiro-luna kiro-cheap kiro-glm kiro-deepseek
  kiro-minimax kiro-minimax21 kiro-haiku kiro-opus-xhigh kiro-opus-max
  kiro-sol-xhigh kiro-sol-max
  kimi-k3 kimi-k27 kimi-k27-code kimi-k3-low builder-kimi
  builder-kimi-high builder-kimi-max
  oc-kimi-code oc-glm oc-kimi-k3 oc-dsflash oc-sonnet46 oc-oss oc-omni
  oc-qwen37-max oc-minimax-m3 oc-solar4
  agy-flash agy-flash36 agy-flash37
  grok grok-hi grok-med grok45 grok45-med grok46 grok46-med builder-grok
  builder-grok-low builder-grok-medium builder-grok-xhigh
  cc-qwen38 cc-glm cc-dsflash cc-dspro cc-glm53
)

profiles_help() {
  cat <<'USAGE'
Usage: wrk profiles

Print every model profile name resolve_profile() accepts, one per line
(machine-readable; excludes retired agy-* aliases). Used for
scopefuel-vs-wrk cross-validation (every scopefuel-recommended profile
must be spawnable here).
  -h, --help   show this usage
USAGE
}

profiles_cmd() {
  if [[ $# -gt 0 ]]; then
    if [[ "$1" == "-h" || "$1" == "--help" ]]; then
      [[ $# -eq 1 ]] || die "unexpected argument '$2'"
      profiles_help
      return 0
    fi
    die "unexpected argument '$1'"
  fi
  printf '%s\n' "${ALL_PROFILES[@]}"
}

usage() {
  cat <<'USAGE'
Usage: wrk <spawn|done|escalate|joined|round|reap|find|name-sync|profiles|hosts|heavy> [options]

  wrk spawn -c CWD -m MODEL -p PROMPT_FILE -w WORKSPACE -l LABEL --t T0..T3
            [-L live|mock] [--effort LEVEL] [--job ID] [--report PATH] [--job-dup-ok] [--landing-strict]
            [--operator-request REF] [--requested-by NAME] [--purpose PURPOSE] [--keep]
  wrk done JOB [--report PATH]
  wrk escalate JOB --question TEXT [--report PATH]
  wrk joined JOB --pr URL --head SHA --report PATH
  wrk round open JOB --head SHA [--extend REF]
  wrk round verdict JOB --file PATH
  wrk round status JOB
  wrk reap [--lane LANE] [--grace 10m] [--apply] [--include-builders|--include-captains]
  wrk prune [--apply] [--stale-age AGE] [--job JOB] [--lane LANE]
  wrk find <name-or-label> [--pane-only]
  wrk name-sync [--apply|<label>...]
  wrk profiles
  wrk heavy -- <command> [args...]
  wrk heavy status

Run 'wrk <command> --help' for command-specific usage.
USAGE
}

done_help() {
  cat <<'USAGE'
Usage: wrk done JOB [--report PATH]

Write a job.completed record for JOB, upload the report as a handoffkeep
document, and emit the relay event to the owner lane.

Options:
  --report PATH      existing report file (default: newest report*.md in the
                     job directory). A re-completion with unchanged content is
                     suppressed as a duplicate. When the content changed but
                     PATH already names an earlier completed round, the
                     current content is snapshot to <stem>-r<N>.md (N = 1 +
                     earlier completed rounds) and the record, upload, emit
                     and OK line all name that new path — the relay key stays
                     unique and the original file is untouched.
                     If the emit returns non-zero the OK line ends with
                     relay=file-only.
  -h, --help         show this usage
USAGE
}

escalate_help() {
  cat <<'USAGE'
Usage: wrk escalate JOB --question TEXT [--report PATH]

Write a builder escalation record and relay it to the parent lane.

Options:
  --question TEXT    required escalation question
  --report PATH      optional existing report to attach and upload as a document
  -h, --help         show this usage
USAGE
}

spawn_help() {
  cat <<'USAGE'
Usage: wrk spawn -c CWD -m MODEL -p PROMPT_FILE -w WORKSPACE -l LABEL --t T0..T3
                 [-L live|mock] [--effort LEVEL] [--job ID] [--owner NAME] [--report PATH] [--job-dup-ok]
                 [--landing-strict] [--role builder --lane BUILDER_LANE --parent PARENT_LANE] [--host auto|local|NAME]
                 [--operator-request REF] [--requested-by NAME] [--purpose PURPOSE] [--keep]
                 [--task HK_TASK_ID | --parent-job JOB_ID] [--task-hk-bypass]

Options:
  -c CWD, -m MODEL, -p PROMPT_FILE, -w WORKSPACE, -l LABEL
  --t T0..T3         job scale; required — an unclassified job is not spawned
  -L live|mock       select lane; mock requires MOCK_MCP_PROFILE and
                    WRK_MOCK_MCP_CONFIG (reviewed stdio connection descriptor).
                    Unsupported harnesses and remote mock placement refuse (79).
  --effort LEVEL     override codex/Kiro/Grok/Claude(opus,sonnet) profile effort
  --job ID           arbiter job id (default: LABEL)
  --owner NAME       spawning session name, recorded as the arbiter owner_lane
                     (default: default). Lets that session later run
                     `arbiter status --lane NAME` to find and reclaim its workers,
                     and (--role worker only) is where that worker's own
                     job.completed is delivered directly. It is reclaim/direct-
                     completion only — it does NOT route job.escalate or
                     job.joined; see --parent for that, and note --role builder
                     rejects --owner outright (use --lane instead).
  --role worker|builder (legacy alias: captain)
                     builder requires --lane and --parent, and accepts only
                     builder-opus, builder-sol, builder-sol6, builder-devin,
                     builder-devin-medium, builder-devin-max, builder-ds41,
                     builder-ds41-max, builder-grok, builder-kimi,
                     builder-luna, builder-sonnet, builder-opus-low,
                     builder-opus-medium, builder-sonnet-xhigh,
                     builder-sonnet-max, builder-sol-high,

                     builder-sol-max, builder-sol-medium, builder-luna-max,
                     builder-terra-high, builder-terra-xhigh, builder-terra-max,
                     builder-kimi-high, builder-kimi-max, builder-grok-low,
                     builder-grok-medium or builder-grok-xhigh profiles; legacy
                     captain-opus and captain-sol aliases and the pilot worker
                     spellings devin-swe2, devin-swe2-medium, devin-swe2-max,
                     grok/grok-hi and kimi-k3 remain accepted. The max-rung E6 spellings
                     (builder-sonnet-max, builder-sol-max, builder-luna-max,
                     builder-terra-max, builder-kimi-max) are closed: under
                     --role builder any resolved max or ultra rung is refused
                     before the marker check (2026-09-26 decision), with one
                     named exception — builder-sonnet takes an explicit
                     --effort max (2026-09-29 operator report, experiment E2).
  --lane NAME        builder's own lane; recorded as the claim owner_lane.
                     (The execution lane remains -L live|mock.)
  --parent NAME      required for --role builder (spawn dies without it).
                     A builder's job.escalate and job.joined (PR-submitted)
                     events are routed to this lane, and ONLY this lane — not
                     --owner, which builders cannot even set. If a builder's
                     parent lane isn't registered when the event fires, the
                     notice has nowhere to go and the parent is never told;
                     see also the idle-wake suppression reasons in panewire
                     (parentless_lane, unknown_owner) for the same failure
                     mode on the idle-detection path.
  --task ID          handoffkeep task this job owns (#768 decision
                     doc decision/2026-09-27/task-job-linkage, item 1; new
                     spawns only, no backfill). Required for --role builder
                     and for any worker/tester spawn that cannot inherit —
                     missing it is a usage error before any side effect. On a
                     successful spawn the task is claimed by the spawned label
                     and refs.job_id is set to the job id in one `tasks claim
                     --by --job-id` call (verified from the response; an hk
                     that drops job_id is a loud failure, never a silent
                     half-record). A task already bound to another job is
                     fail-closed, as are closed (merged/dropped), held and
                     needs_decision tasks; hk unreachable refuses the spawn
                     (no job without its task link) unless --task-hk-bypass.
  --parent-job JOB   tester/advisory inheritance: take the task id from the
                     parent job's recorded claim meta instead of --task.
                     Mutually exclusive with --task. When neither is given, a
                     worker spawn tries the calling pane's ARBITER_JOB meta
                     and then the HK_TASK_ID env (propagated into every
                     spawned pane) before the usage error. The inherited task
                     is recorded in job meta (task_id + task_inherited_from)
                     and the child never re-claims it — the owning job's hk
                     record stands.
  --task-hk-bypass   explicit operator override: spawn without a confirmed
                     hk task link when handoffkeep is unreachable. Recorded
                     in the job's claim payload as task_link_override so the
                     audit trail shows exactly which jobs lack the link and
                     why. Never a silent skip: a reachable hk that refuses
                     the claim still fails the spawn.
  --report PATH      report acceptance-criterion path watched by the completion sentinel
  --keep             protection marker: record "keep": true on the job.spawned
                     receipt so no session cleanup ever closes this pane — use it
                     for resident, director, installer and consult sessions.
                     `wrk reap` skips a kept job (reason=protected) and the
                     panewire session-reap report never lists it as a candidate.
                     Without --keep the receipt is byte-identical to before.
                     Local and ssh spawns only; a hub spill-over refuses it.
  --job-dup-ok       explicit operator override: permit an active duplicate job
                     after an auditable warning. Automation/panewire must not use it.
  --landing-strict   automation opt-in: preserve the OK line, then exit 76 if
                     no landing evidence appears (panewire prompt proof, else a
                     read-only marker/Pasted-text/devin-status observation).
                     Without it, landed=no remains a successful spawn with a
                     warning.

The brief is delivered with `panewire prompt` (no uptake; first line
`expect: name=LABEL cwd=CWD`). Only when panewire cannot reach its daemon
(rc 4) or is not installed does wrk inject once directly through herdr; the OK
line then ends with via=herdr-fallback.
  --operator-request REF
                     operator request reference passed verbatim to
                     `scopefuel gate` (the gate accepts only hk:doc/<key>
                     or hk:task/<int>, and only on escalation or
                     consult_only profiles — fable needs it to spawn at
                     all). wrk never validates the REF itself — acceptance,
                     format refusal and the not-applicable refusal are all
                     the gate's own fail-closed decisions, and its rc is
                     propagated.
  --requested-by NAME
                     self-reported requester name accompanying
                     --operator-request, passed verbatim to `scopefuel gate`.
  --purpose PURPOSE  caller-declared spawn purpose passed verbatim to
                     `scopefuel gate` (task #527). For the astra profiles the
                     gate role-denies (gate exit 5; wrk exits 77) unless
                     PURPOSE is director, architect or operator-request; for
                     every other profile it is audit metadata only and never
                     changes the decision.
                     Claude profiles spawn with prompt suggestions off
                     (CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=false in the pane
                     env, #626); PURPOSE director leaves them as configured.
                     This is a purpose axis, distinct from the
                     --operator-request REF format gate above.
  --host auto|local|NAME
                     spawn placement. auto (the default) asks the hub first;
                     when the hub cannot answer, local pressure decides and
                     each configured remote host is tried in order. A remote
                     candidate whose own wrk refuses the spawn with a config
                     error (rc 70 — e.g. a malformed [hub] quota_gate on that
                     host) stops the round immediately: the spawn fails
                     closed with rc 70 and never falls back to local (#1154).
                     A remote wrk answering rc 2, 74 or 75 (usage error,
                     active-job duplicate, unreadable job state) also ends the
                     round, as does a cwd_map miss in a hub-selected round
                     and a via=hub candidate's own outcome. Transport-leg failures (probe, prepare,
                     mktemp, scp — normalized off the admission codes) and
                     every other remote answer move on to the next candidate,
                     and only when every candidate fails does auto fall back
                     to a local spawn. local forces a local spawn; NAME
                     forces one remote host and propagates its exit code with
                     no local fallback.

                     hosts.toml [local] also carries this host's own keys:
                     max_load_ratio/max_active/heavy_max gate the fallback
                     pressure measure and `wrk heavy`, and `spawn = false`
                     (#1155, set by the operator per host) forbids local
                     spawns outright — auto then treats local as unavailable
                     and only tries the remote candidates (an all-fail round
                     exits 80 with one attributed line per host instead of
                     the local fallback), local refuses with rc 80 before any
                     side effect, and a delegated ssh spawn — which arrives
                     as --host local on the execution host — is refused the
                     same way. A via=hub delegated spawn is different: the
                     hub's wrkgate runs `wrk spawn` on the target WITHOUT
                     --host, so a closed via=hub target runs the auto round —
                     it lands no local pane, but it may still place the job
                     on one of that target's own remotes. A remote answering
                     80 does not stop the auto round.

                     The flag is fail-closed (#1163): the only accepted form
                     is '[local]' on its own line with 'spawn = false' (or
                     'spawn = true') written once. Anything else that names
                     the local table or its spawn key — a header like
                     '[local] # comment', '[ local ]' or '["local"]', a
                     second [local] table, a second spawn key, a spawn line
                     that is not a 'spawn = value' assignment ('spawn',
                     'spawn: false', 'spawn == false'), or a value that is
                     not a bare true/false (a quoted spelling is a string,
                     not a boolean) — is a config error refusing every
                     placement with rc 70, naming the file line and reason.
                     So is any content before the first table header (the
                     root table must be empty — 'local.spawn = false' or
                     'local = { spawn = false }' there are root keys, not
                     the flag), a UTF-8 BOM at any line start, a hosts.toml
                     that exists but is unreadable, or a path whose
                     existence cannot be determined because a parent
                     directory is not searchable. No [local] section, a
                     [local] without spawn,
                     or one clean assignment keep the unchanged behavior.
                     `wrk hosts` reports the resolved state as
                     'local spawn=allowed|disabled|error'.

                     hosts.toml [hosts.NAME] may opt a default-off remote
                     into wake-on-demand with wake = "panewire" (#1239).
                     In the hosts.toml-order auto round a candidate with
                     no cwd_map entry for the cwd is skipped before it is
                     probed (a hub-selected round keeps the fail-closed
                     rc 2), and an
                     unreachable wake host is NOT woken on first sight —
                     the round finishes over the other candidates first.
                     The wake runs only when local cannot take the job
                     (pressured, or spawn = false), no candidate landed,
                     the round was not ended by a stop-set answer (a
                     reachable remote wrk answering 2, 70, 74 or 75), and
                     at least one candidate answered remote-full —
                     positive capacity evidence. It is
                     `panewire burst request --target NAME --hold
                     <wake_hold>m --timeout <min(wake_wait,600)>s` using
                     the operator credential — [hub] operator_token_env,
                     falling back to hub_token_env only when unset;
                     hub_token_env is never required because it is also
                     the hub quota gate opt-in (#1138) that a
                     quota_gate = "local" host deliberately leaves off.
                     hub_cf_env stays optional. wake_hold is the burst
                     hold in minutes (default 10 — a configured
                     wake_hold wins; WRK_WAKE_HOLD_MINUTES exists only
                     as a test seam over the default) and wake_wait
                     bounds the wait for the node in seconds (default
                     300) — a granted hold or a cooldown_active (a
                     concurrent spawn's wake already in flight, waited
                     on instead of stacking a second request) re-probes
                     the host until the deadline. A refused wake, a
                     burst error, a timeout, or a host still unreachable
                     after the wait exits 81 naming host, step and
                     reason plus the held per-candidate diagnostics —
                     never a local fallback, whatever [local] spawn says.
                     An explicit --host NAME on an unreachable wake host
                     wakes it the same way; the hosts.toml key is the
                     opt-in.
  -h, --help         show this usage

Hub lane registration (#965): a --role worker spawn whose effective herdr
session (WRK_SENTINEL_HERDR_SESSION, else HERDR_SESSION, else the herdr
default) has an entry in hosts.toml's [hub] session_machine_ids registers a
lane for the pane on that session's daemon —
`panewire lanes add LABEL --machine ID --pane PANE --parent OWNER` with the
[hub] credentials: hub_url plus lanes_token_env when set, else hub_token_env
(hub_cf_env optional). The values are file paths panewire opens; wrk scans
a lanes token file for the HUB_MACHINE_ID value only — to skip a
registration the hub would refuse when it differs from the session's
mapped machine — and never prints file contents (a malformed id warns
once without the value). lanes_token_env (#1037) is a node-scoped token that
may reach only the lanes routes: this registration, reap's `lanes rm`, and
the `lanes ls` confirmation. No other hub path (quota gate, placement,
spill-over wake, hub spawn) reads it, and a [hub] section with hub_url and
lanes_token_env but no hub_token_env does not opt into the hub quota gate —
only a configured hub_token_env switches that on. That skipped gate is never
silent: every spawn warns once that only the local scopefuel gate applies
unless quota_gate = "local" is set, the deliberate opt-out a lanes-only host
uses instead (any other quota_gate value — and "local" combined with
hub_token_env — is a config error that refuses the spawn). The OK line then ends
with lane=LABEL@ID and the job.spawned meta records
hub_lane/hub_lane_machine; `wrk reap --apply` removes the lane with
`panewire lanes rm`. An unmapped session or a missing --owner warns once
and spawns unregistered — as does a panewire failure; the spawn never fails
over it and builder lanes are never touched (they stay the director's).
The label becomes the lane name verbatim, so panewire's own lane rule
^[a-z0-9-]{1,32}$ applies on top of wrk's: a label containing an underscore
is a valid wrk label but not a valid lane name — on a mapped session such a
spawn warns once and lands unregistered (#1010). `panewire lanes-audit`
lists any leftover rows.

session_machine_ids is for NON-fleet herdr sessions only — for example M1's
default session, served by its own panewire daemon. Mapping a fleet session
is not a supported use: it registers every fleet worker as a global lane for
no benefit.

Admission control (ROB-1199): after the scopefuel quota gate passes, wrk claims
the job and records its quota-pool execution in arbiter. arbiter resolves the
pool from scopefuel's own output — wrk holds no pool mapping. A quota-pool
claim/record or preparation failure is warned and does not deny the spawn; a
failed spawn releases a successfully created record. The scopefuel gate remains
fail-closed, while exclusive arbiter leases retain their own fail-closed rules.

Canonical codex profiles: codex-terra, codex-luna, codex-sol.
Existing codex aliases remain valid: codex, codex-med, codex-luna-hi,
codex-luna-max, codex-max, codex-terra-max.
ROB-591/#1026 (2026-09-30 operator decision): codex-sol/codex-max/codex/
builder-sol/captain-sol now run gpt-6.1-sol, and codex-luna/codex-luna-hi/
codex-luna-max run gpt-6-luna. Rollback spellings codex-sol6/builder-sol6 pin
gpt-6-sol; codex-sol56/codex-luna56 run the pre-refresh gpt-5.6-sol/gpt-5.6-luna.
Claude effort wiring (ROB-1191/ROB-1193): opus default=high, sonnet/sonnet-med default=high,
haiku default=low; all support an explicit --effort override.
Builder profiles: builder-opus = Claude Opus at effort high; builder-sol = codex-sol
at effort high (was max before 2026-09-26 — a builder seat never takes a max rung,
operator decision 2026-09-26; the seat rule is enforced on the resolved effort below).
builder-sonnet (#921, operator report 2026-09-29) = the Sonnet 5.5 experiment seat:
Claude Sonnet via --model sonnet + --dangerously-skip-permissions (the builder-opus
argv shape), --effort high|xhigh|max, default xhigh. Its explicit max rung is the
seat rule's only named exception; builder-sonnet records launch_profile
sonnet@<effort> so the E1/E2 reps attribute to the gated catalog rung.
codex-astra = gpt-6-astra is a counsel-only profile for director/architect/operator-requested
advice (hk:doc decision/2026-09-21/astra-allowed-purposes-approved); --role builder rejects it.
It defaults to --effort xhigh and requires --purpose director|architect|operator-request,
which the gate enforces as role denial (gate exit 5, surfaced by wrk as exit 77) when
missing or wrong.
Pilot builders (task 240): builder-devin = devin-swe2 argv; builder-grok = grok 4.7 at effort xhigh; builder-kimi = kimi-k3 argv.
builder-luna (task #633) = codex-luna (gpt-6-luna) at effort xhigh — the #594 E3
sample spelling; --effort is pinned to xhigh because the catalog grades
codex-luna per effort (medium=B, max=A+).
Devin model variants (task 281): devin-glm52, devin-swe17 and devin-ds41 run
the same unattended devin argv with only the model name changed — worker-only
spellings, sharing scopefuel's single `devin` pool (devin-ds41 is the paid
spelling).
Devin effort variants (#635): effort is encoded in the devin model id — there
is no --effort flag — so each rung is its own profile: devin-swe2-medium
(--model swe-2-medium) and devin-swe2-max (--model swe-2-max), both free, and
the paid devin-ds41-max (--model deepseek-v4-1-flash-max). devin-swe2 stays the
high default; the swe-2 effort spellings are also accepted under --role builder.
Devin builder variants (#666): the same rungs exist as builder spellings —
builder-devin-medium and builder-devin-max (the free swe-2 rungs), plus
builder-ds41 and builder-ds41-max for the paid ds41 rung per the operator's
ds41-builder policy. Each reuses its worker variant's argv verbatim; the ds41
worker spellings themselves stay worker-only under --role builder.
E6 measurement builders (#704, #594): builder-opus-low, builder-opus-medium,
builder-sonnet-xhigh, builder-sonnet-max, builder-sol-high, builder-sol-max,
builder-luna-max, builder-terra-high, builder-terra-xhigh, builder-terra-max,
builder-kimi-high and builder-kimi-max each pin exactly one effort rung (the
suffix IS the rung; --effort is refused off-rung, allowed spelled the same).
2026-09-26 (decision 4088 B): the max-rung members (builder-sonnet-max,
builder-sol-max, builder-luna-max, builder-terra-max, builder-kimi-max) are
closed — a builder seat never takes a max rung, marker or not.
They exist only to measure that rung, so the open (non-max) spellings refuse to
spawn without SCOPEFUEL_E6_ARM=<gate profile>@<effort> naming exactly it — e.g.
SCOPEFUEL_E6_ARM=codex-terra@high for builder-terra-high. For these profiles
wrk passes the pinned rung as `scopefuel gate --effort` so the gate judges
that rung's row, and the marker (forwarded through the environment) is what
opens the unmeasured C rungs (#692: sonnet@max, codex-sol@high, kimi-k3@high,

kimi-k3@max, grok-hi@xhigh; #737 adds grok-hi@low, grok-hi@medium and
codex-sol@medium). The @max arms here are inert for builders since the
seat rule fires first; they still describe worker-side measurement.
Rungs the gate marks escalation (sonnet@xhigh) are shown with that tag by
the gate — on an explicit --effort rung it still judges quota rules only,
so no --operator-request REF is enforced there (scopefuel #716). Which
rungs are escalation-marked is the gate's call, not wrk's; wrk forwards a
caller-supplied REF verbatim and never adds one. opus@low lost its
escalation mark in scopefuel #738 (b5b0ad2): post-#738 the gate refuses a
REF on it (operator_request_not_applicable, rc 3), while pre-#738 installs
keep the mark but still accept a REF on it. #737 adds the grok rungs of
decision 4088 — builder-grok-low, builder-grok-medium and
builder-grok-xhigh pin grok-hi@<rung> the same way
(SCOPEFUEL_E6_ARM=grok-hi@<rung>; grok rungs are not escalation-marked, so
no --operator-request) — plus builder-sol-medium pinning codex-sol@medium
(SCOPEFUEL_E6_ARM=codex-sol@medium). The kimi pair takes its effort from
the pinned clone homes KIMI_CODE_HIGH_HOME/KIMI_CODE_MAX_HOME (refresh with
`bin/kimi-clone-home --effort high|max`); everything else carries the effort
in its argv.
Legacy profile aliases captain-opus and captain-sol have the same meaning.
Kimi profiles: kimi-k3 uses `kimi --auto -m kimi-code/k3`; kimi-k27 and
kimi-k27-code use `kimi --auto -m kimi-code/kimi-for-coding`; the CLI has
no --effort option.
kimi-k3-low uses the same argv as kimi-k3 but injects KIMI_CODE_HOME pointing at
the low-thinking-effort clone home from `bin/kimi-clone-home` ([thinking]
effort="low" in that clone's config.toml — kimi has no CLI --effort flag, so this
is the only way to change its thinking effort). Refresh the clone with
`bin/kimi-clone-home` any time the real ~/.kimi-code credentials rotate.
fable does not accept --effort in this scope.
Retired TUI agy profiles are rejected. Emergency headless backup:
  agy -p "$(cat PROMPT_FILE)"
USAGE
}

find_help() {
  cat <<'USAGE'
Usage: wrk find <name-or-label> [--pane-only]

Name is matched exactly first. If absent, the exact tab label is used.
Candidates include pane_id and the last five screen lines.
  --pane-only  print pane_id only when exactly one candidate matches
  -h, --help   show this usage
USAGE
}

name_sync_help() {
  cat <<'USAGE'
Usage: wrk name-sync [--apply|<label>...]

No arguments preview safe matches. --apply applies all safe matches.
Labels apply only the named labels; numeric/short labels stay guarded.
USAGE
}

die() { echo "wrk: $*" >&2; exit 2; }
warn() { echo "wrk: warning: $*" >&2; }
sleep_for() { [[ -n "${WRK_NO_SLEEP:-}" ]] || sleep "$1"; }

# Landing is a bounded positive-evidence observation, not a second boot wait.
# The prompt command already owns its normal wait when supported. A 30-second
# window covers the normal hand-off; codex gets 60 seconds because its cold
# boot is explicitly allowed to settle for 20 seconds above and may still take
# tens of seconds before the submitted transcript is readable. Grok gets 150
# seconds: measured on 2026-09-25 (grok 1.0.41) the pane only echoes or reacts
# to the brief 1-2 minutes after injection, so the 30-second window reported
# landed=no for briefs that did land (b685/b699/b700) — a false negative that
# invites a duplicate re-injection. Sampling backs off from 0.5 to 2 seconds
# and stops immediately on evidence.
LANDING_CHECK_DEFAULT_WINDOW_SECONDS=30
LANDING_CHECK_CODEX_WINDOW_SECONDS=60
LANDING_CHECK_GROK_WINDOW_SECONDS=150
LANDING_CHECK_INITIAL_DELAY_SECONDS=0.5
LANDING_CHECK_SECOND_DELAY_SECONDS=1
LANDING_CHECK_MAX_DELAY_SECONDS=2

# #717: `panewire prompt --timeout` is a budget of its own, decoupled from the
# landing window above. It bounds how long the daemon polls for submission
# evidence, and its classifier only knows claude and codex (prompt.go
# classifySubmission) — for every other kind the poll can never succeed, so a
# window-length timeout is dead wait before wrk's own observation even starts
# (grok blocked the full 150s under #701). Codex keeps 60 seconds: its
# cold-booted transcript can take tens of seconds to become readable, and a
# proven result skips the entire landing check.
PANEWIRE_PROMPT_DEFAULT_TIMEOUT_SECONDS=30
PANEWIRE_PROMPT_CODEX_TIMEOUT_SECONDS=60

# run_bounded SECS CMD... — run CMD with a hard wall-clock bound, exiting 124
# on timeout. GNU timeout/gtimeout already run the child in a new process
# group and kill the group; the python fallback must do the same — plain
# subprocess.run kills only the direct child, so an orphaned grandchild keeps
# inherited pipes open and a caller's $( ) still blocks until it exits
# (#770: JE15b on macOS CI blocked 60s under a 2s bound).
run_bounded() {
  local secs="$1"; shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
    return
  fi
  if command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" "$@"
    return
  fi
  python3 -c 'import os, signal, subprocess, sys
proc = subprocess.Popen(sys.argv[2:], start_new_session=True)
try:
    sys.exit(proc.wait(timeout=float(sys.argv[1])))
except subprocess.TimeoutExpired:
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    proc.wait()
    sys.exit(124)' "$secs" "$@"
}

configure_landing_check() {
  local profile_kind="$1"
  LANDING_CHECK_WINDOW_SECONDS="$LANDING_CHECK_DEFAULT_WINDOW_SECONDS"
  # 18 samples: 0.5 + 1 + (14 * 2) + 0.5 = 30 seconds.
  LANDING_CHECK_TIMEOUT_TICKS=18
  SPAWN_PANEWIRE_TIMEOUT_SECONDS="$PANEWIRE_PROMPT_DEFAULT_TIMEOUT_SECONDS"
  if [[ "$profile_kind" == codex ]]; then
    LANDING_CHECK_WINDOW_SECONDS="$LANDING_CHECK_CODEX_WINDOW_SECONDS"
    # 33 samples: 0.5 + 1 + (29 * 2) + 0.5 = 60 seconds.
    LANDING_CHECK_TIMEOUT_TICKS=33
    SPAWN_PANEWIRE_TIMEOUT_SECONDS="$PANEWIRE_PROMPT_CODEX_TIMEOUT_SECONDS"
  elif [[ "$profile_kind" == grok ]]; then
    LANDING_CHECK_WINDOW_SECONDS="$LANDING_CHECK_GROK_WINDOW_SECONDS"
    # 78 samples: 0.5 + 1 + (74 * 2) + 0.5 = 150 seconds.
    LANDING_CHECK_TIMEOUT_TICKS=78
  fi
}

landing_check_delay() {
  local tick="$1"
  if (( tick == 0 || tick == LANDING_CHECK_TIMEOUT_TICKS - 2 )); then
    printf '%s' "$LANDING_CHECK_INITIAL_DELAY_SECONDS"
  elif (( tick == 1 )); then
    printf '%s' "$LANDING_CHECK_SECOND_DELAY_SECONDS"
  else
    printf '%s' "$LANDING_CHECK_MAX_DELAY_SECONDS"
  fi
}

landing_check_detail() {
  printf 'window=%ss checks=%s last_evidence=%s last_status=%s reason=%s' \
    "$LANDING_CHECK_WINDOW_SECONDS" "$LANDING_CHECK_ATTEMPTS" \
    "$LANDING_CHECK_LAST_EVIDENCE" "$LANDING_CHECK_LAST_STATUS" \
    "$LANDING_CHECK_LAST_REASON"
  # A transient ambiguous observation (e.g. a grok queue chip that disappears
  # again) still suppresses re-injection; keep its origin visible in the final
  # report instead of letting a later tick's reason overwrite it.
  [[ -z "${LANDING_CHECK_AMBIGUOUS_REASON:-}" ]] ||
    printf ' first_ambiguous_reason=%s' "$LANDING_CHECK_AMBIGUOUS_REASON"
}

prompt_marker() {
  local prompt_file="$1" line
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "${line//[[:space:]]/}" ]] || continue
    printf '%s' "${line:0:40}"
    return 0
  done <"$prompt_file"
  return 0
}

agent_status_for_pane() {
  local pane="$1"
  "$HERDR" agent list 2>/dev/null |
    python3 -c 'import json,sys; p=sys.argv[1]; a=json.load(sys.stdin)["result"]["agents"]; print(next((x.get("agent_status","unknown") for x in a if x.get("pane_id")==p),"unknown"))' "$pane" \
    2>/dev/null
}

# #568: a folded-marker match must reproduce devin's observed submitted-prompt
# rendering, not just the marker's characters scattered over a transcript.
# The match must (a) contain a wrapped continuation — a newline followed by
# indent, the shape observed in devin's submitted-prompt rendering
# (`❭ <marker start>` + indented continuation) — and (b) start at a line
# boundary or right after devin's `❭` prompt glyph.
# Whitespace-only variants that never wrapped (a UI column tab between the
# same words) and unrelated text carrying the words across a line break are
# not folded markers and must not count as positive evidence.
devin_folded_marker_present() {
  local marker="$1"
  python3 -c '
import re, sys
marker, recent = sys.argv[1], sys.stdin.read()
pat = r"\s*".join(re.escape(c) for c in marker if not c.isspace())
for m in re.finditer(pat, recent):
    if not re.search(r"\n[ \t]", m.group(0)):
        continue
    line_start = recent.rfind("\n", 0, m.start()) + 1
    if recent[line_start:m.start()].strip() in ("", "❭"):
        sys.exit(0)
sys.exit(1)
' "$marker"
}

landing_check_once() {
  local pane="$1" marker="$2" profile_kind="$3" submit="${4:-}" recent visible status
  LANDING_CHECK_LAST_EVIDENCE=none
  if ! recent="$("$HERDR" agent read "$pane" --source recent-unwrapped --lines 200 2>/dev/null)"; then
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_STATUS=unknown
    LANDING_CHECK_LAST_REASON="recent-unwrapped-read-failed"
    return 1
  fi

  # The prompt transcript is the source of truth. Unlike the 40-line visible
  # screen, recent-unwrapped survives subsequent output scrolling the marker
  # away. `working` below is deliberately not evidence: a cold codex boot
  # reports working before the composer has received the payload.
  if [[ -n "$marker" ]] && grep -Fq -- "$marker" <<<"$recent"; then
    LANDING_CHECK_LAST_EVIDENCE=marker
    LANDING_CHECK_LAST_REASON="marker-in-recent-unwrapped"
    return 0
  fi
  # #568: Devin folds long lines at its render width, so the transcript's copy
  # of the marker can carry a line break or indent the raw substring never
  # matches (the 2026-09-22 t502-verify duplicate: rc 6, status=working,
  # marker present but folded → reinjected into a working tester). Devin
  # only; every other kind keeps the raw substring contract.
  if [[ "$profile_kind" == devin && -n "$marker" && "$recent" == *$'\n'* ]] &&
     devin_folded_marker_present "$marker" <<<"$recent"; then
    LANDING_CHECK_LAST_EVIDENCE=devin-marker-folded
    LANDING_CHECK_LAST_REASON="folded-marker-in-recent-unwrapped"
    return 0
  fi
  if ! visible="$("$HERDR" agent read "$pane" --source visible --lines 40 2>/dev/null)"; then
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_STATUS=unknown
    LANDING_CHECK_LAST_REASON="visible-read-failed"
    return 1
  fi

  # The UI chip is an independent positive observation that the payload is
  # queued; keep it as the fallback for prompts whose transcript is delayed.
  if grep -Fq -- "Pasted text" <<<"$visible"; then
    LANDING_CHECK_LAST_EVIDENCE=pasted
    LANDING_CHECK_LAST_REASON=pasted-text-chip
    return 0
  fi
  # Grok's queued footer has no `──` head the way devin's chip does: the
  # observed shape is `○ 1 command still running · 1 queued, Enter to send
  # now` (2026-09-18). On a shared screen the chip cannot be attributed to
  # THIS injection — a stale footer, the brief's own echoed text, and another
  # sender's payload all render identically (task406 verify2). It is an
  # ambiguous signal, never positive evidence: marking ambiguous suppresses
  # the re-injection so a possibly queued payload is not duplicated. The
  # transcript marker above stays the only positive evidence. `0 queued` is
  # not a chip.
  # #568: Devin's queued banner (`── N queued ──` / `○ msg` /
  # `Press Enter to send queued messages now`, relay-handoff §3-2) means a
  # payload is sitting in Devin's queue. Like grok's chip it cannot be
  # attributed to THIS injection, so it is ambiguous evidence that suppresses
  # re-injection — never positive.
  if [[ "$profile_kind" == devin ]] &&
     grep -Eq '── [0-9]+ queued ──|Press Enter to send queued messages now' <<<"$visible"; then
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_EVIDENCE=devin-queued
    LANDING_CHECK_LAST_REASON="devin-queue-banner-unattributable"
    return 1
  fi
  if [[ "$profile_kind" == grok ]] && grep -Eq '[1-9][0-9]* queued, Enter to send now' <<<"$visible"; then
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_EVIDENCE=grok-queued
    LANDING_CHECK_LAST_REASON="grok-queue-chip-unattributable"
    return 1
  fi
  if ! status="$(agent_status_for_pane "$pane")"; then
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_STATUS=unknown
    LANDING_CHECK_LAST_REASON="status-read-failed"
    return 1
  fi
  LANDING_CHECK_LAST_STATUS="$status"
  # Herdr's built-in Devin detector exposes a post-prompt idle/done state after
  # it has accepted the brief. That detector result is profile-specific positive
  # evidence; generic agents still require a transcript marker or Pasted text.
  if [[ "$profile_kind" == devin && "$status" =~ ^(idle|done)$ ]]; then
    LANDING_CHECK_LAST_EVIDENCE=devin-status
    LANDING_CHECK_LAST_REASON="devin-post-prompt-status-${status}"
    return 0
  fi
  # #568: delivery only runs after `agent wait --until idle` already saw the
  # pane idle, so a Devin pane reporting working has consumed the submitted
  # brief — nothing else was ever sent. `working` is positive evidence only
  # for an accepted submit: after an unconfirmed one (a timeout can fall on
  # either side of the send boundary) working cannot be attributed to this
  # brief, so it is ambiguous — landed stays no and the possibly delivered
  # brief is not duplicated. For other kinds the cold-boot caveat keeps
  # `working` non-evidence.
  if [[ "$profile_kind" == devin && "$status" == working ]]; then
    if [[ "$submit" == accepted ]]; then
      LANDING_CHECK_LAST_EVIDENCE=devin-status
      LANDING_CHECK_LAST_REASON=devin-post-prompt-status-working
      return 0
    fi
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_EVIDENCE=devin-status-working
    LANDING_CHECK_LAST_REASON="devin-working-unattributable-submit-${submit:-unknown}"
    return 1
  fi
  if [[ "$status" == working ]]; then
    LANDING_CHECK_LAST_REASON=working-without-positive-evidence
  else
    LANDING_CHECK_LAST_REASON="status-${status}-without-positive-evidence"
  fi
  return 1
}

landing_check() {
  local pane="$1" marker="$2" profile_kind="$3" submit="${4:-}" tick delay
  LANDING_CHECK_CONFIRMED=0
  LANDING_CHECK_AMBIGUOUS=0
  LANDING_CHECK_AMBIGUOUS_REASON=""
  LANDING_CHECK_ATTEMPTS=0
  LANDING_CHECK_LAST_EVIDENCE=none
  LANDING_CHECK_LAST_STATUS=unknown
  LANDING_CHECK_LAST_REASON=not-observed
  for ((tick=0; tick<LANDING_CHECK_TIMEOUT_TICKS; tick++)); do
    LANDING_CHECK_ATTEMPTS=$((tick + 1))
    if landing_check_once "$pane" "$marker" "$profile_kind" "$submit"; then return 0; fi
    if [[ "$LANDING_CHECK_AMBIGUOUS" -ne 0 && -z "$LANDING_CHECK_AMBIGUOUS_REASON" ]]; then
      LANDING_CHECK_AMBIGUOUS_REASON="$LANDING_CHECK_LAST_REASON"
    fi
    [[ "$LANDING_CHECK_AMBIGUOUS" -eq 0 ]] && LANDING_CHECK_CONFIRMED=1
    if [[ "$tick" -lt $((LANDING_CHECK_TIMEOUT_TICKS - 1)) ]]; then
      delay="$(landing_check_delay "$tick")"
      sleep_for "$delay"
    fi
  done
  return 1
}

# #498: the spawn brief reaches the pane only through `panewire prompt`; the
# landing verdict is panewire's first. landing_check above stays as a
# read-only corroboration for what panewire cannot prove (its submission
# classifier only knows claude and codex, and its CLI returns an rc, not the
# delivery record). Corroboration never injects. The one exception to "only
# panewire" is rc 4: the CLI could not reach its daemon socket, so nothing was
# sent and a single direct herdr injection cannot duplicate the brief
# (hk decision/2026-09-21/task498-esc-landing-unify).
PANEWIRE_EXIT_TIMEOUT=3
PANEWIRE_EXIT_DAEMON_UNAVAILABLE=4
PANEWIRE_EXIT_CONDITION_INVALID=5
PANEWIRE_EXIT_DELIVERY_FAILURE=6

# spawn_expect_cwd CWD PANE
#
# panewire compares expect cwd with herdr's cwd string for the pane, byte for
# byte. The pane may report the logical path it was created with or its
# physical one (/tmp vs /private/tmp, a symlinked worktree), so the expect line
# uses herdr's own spelling when it names the same physical directory, and the
# physical path otherwise — a pane that is really somewhere else then fails
# panewire's preflight instead of receiving the brief.
spawn_expect_cwd() {
  local cwd="$1" pane="$2" physical reported reported_physical
  physical="$(cd -- "$cwd" 2>/dev/null && pwd -P)" || physical=""
  reported="$("$HERDR" agent list 2>/dev/null |
    python3 -c 'import json,sys; p=sys.argv[1]; a=json.load(sys.stdin)["result"]["agents"]; v=next((x.get("cwd") for x in a if x.get("pane_id")==p),""); print(v if isinstance(v,str) else "")' "$pane" \
    2>/dev/null)" || reported=""
  if [[ -n "$reported" && -n "$physical" ]]; then
    reported_physical="$(cd -- "$reported" 2>/dev/null && pwd -P)" || reported_physical=""
    if [[ "$reported_physical" == "$physical" ]]; then
      printf '%s' "$reported"
      return 0
    fi
  fi
  printf '%s' "$physical"
}

# spawn_prompt_file ATTEMPT
#
# panewire keys a delivery on sender, target, file path, body hash and uptake,
# and answers a repeated key from its cache without sending again. Every
# attempt therefore gets a fresh absolute path: the one re-injection below must
# be a new delivery, and a re-spawn of the same job must not be served the old
# delivery's cached verdict.
spawn_prompt_file() {
  local attempt="$1" dir file
  dir="$(wrk_jobs_root)/$JOB_ID"
  if ! mkdir -p "$dir" 2>/dev/null || ! dir="$(cd -- "$dir" && pwd -P)" ||
    ! file="$(mktemp "$dir/spawn-brief-$attempt.XXXXXX" 2>/dev/null)"; then
    file="$(mktemp "${TMPDIR:-/tmp}/wrk-spawn-brief-$attempt.XXXXXX")" || return 1
  fi
  {
    # The catalog marker must reach the spawned agent itself, not only wrk's
    # stderr: a brief produced from the launcher's own table instead of the
    # canon has to say so where the work is read. It rides on a `wrk-note:`
    # line in the body, NOT on the expect: header — panewire's parsePromptFile
    # (prompt.go, deployed pw-6d0562e) accepts only name/label/cwd/title~/recent~
    # and rejects an unknown field with rc=5 before the send boundary, which
    # silently dropped the whole brief (#667).
    local catalog_note=""
    [[ "${CATALOG_STALE:-0}" -ne 1 ]] || catalog_note="wrk-note: catalog=stale"$'\n'
    if [[ -n "$SPAWN_EXPECT_CWD" ]]; then
      printf 'expect: name=%s cwd=%s\n%s\n' "$LABEL" "$SPAWN_EXPECT_CWD" "$catalog_note"
    else
      printf 'expect: name=%s\n%s\n' "$LABEL" "$catalog_note"
    fi
    cat -- "$PROMPT"
  } >"$file" || return 1
  printf '%s' "$file"
}

# spawn_panewire_prompt ATTEMPT
#
# One `panewire prompt` delivery. No --uptake: both uptake modes refuse a
# target that is already `working`, and a cold-booting pane can report working
# before its composer is ready. Sets SPAWN_SUBMIT to one of
#   proven       rc 0 — panewire observed the submission
#   accepted     rc 6 after herdr took the prompt (submission unproven or still
#                in the composer): sent; only corroboration may say more
#   unconfirmed  rc 3, 6 (herdr rejected), 124 guard, anything unknown: it may
#                or may not have been sent, so it is never sent again
#   unsent       rc 2 or 5: panewire refused before the send boundary
#   daemon       rc 4 or no panewire binary: nothing was sent
spawn_panewire_prompt() {
  local attempt="$1" panewire file err rc=0 seconds
  SPAWN_SUBMIT=daemon
  SPAWN_PANEWIRE_RC=""
  SPAWN_PANEWIRE_ERR=""
  panewire="$(command -v "${PANEWIRE_BIN:-panewire}" 2>/dev/null || true)"
  if [[ -z "$panewire" ]]; then
    SPAWN_PANEWIRE_RC=missing
    SPAWN_PANEWIRE_ERR="panewire-not-found"
    return 0
  fi
  if ! file="$(spawn_prompt_file "$attempt")"; then
    SPAWN_SUBMIT=unsent
    SPAWN_PANEWIRE_RC="file"
    SPAWN_PANEWIRE_ERR="prompt-file-unwritable"
    return 0
  fi
  SPAWN_PROMPT_FILES+=("$file")
  seconds="$SPAWN_PANEWIRE_TIMEOUT_SECONDS"
  # The daemon enforces --timeout itself; the outer guard only covers a wedged
  # socket, which would otherwise hang the spawn with the gates already held.
  err="$(run_bounded $((seconds + 15)) "$panewire" prompt --from "wrk-spawn:$JOB_ID" --to "$LABEL" \
    --file "$file" --timeout "${seconds}s" 2>&1 >/dev/null)" || rc=$?
  SPAWN_PANEWIRE_RC="$rc"
  SPAWN_PANEWIRE_ERR="$(printf '%s' "$err" | tr -s '[:space:]' ' ' | cut -c1-160)"
  case "$rc" in
    0) SPAWN_SUBMIT=proven ;;
    "$PANEWIRE_EXIT_DAEMON_UNAVAILABLE") SPAWN_SUBMIT=daemon ;;
    2|"$PANEWIRE_EXIT_CONDITION_INVALID") SPAWN_SUBMIT=unsent ;;
    # A timeout may fall on either side of the send boundary.
    "$PANEWIRE_EXIT_TIMEOUT") SPAWN_SUBMIT=unconfirmed ;;
    "$PANEWIRE_EXIT_DELIVERY_FAILURE")
      # These two messages are only produced after herdr accepted agent.prompt
      # (prompt.go: pollSubmission result), so the brief did leave wrk.
      if grep -Eq 'submission evidence unproven|prompt remains in composer' <<<"$err"; then
        SPAWN_SUBMIT=accepted
      else
        SPAWN_SUBMIT=unconfirmed
      fi
      ;;
    *) SPAWN_SUBMIT=unconfirmed ;;
  esac
  return 0
}

# opencode needs a separate return after the paste to submit (pre-#498
# behavior, kept verbatim). Only after a delivery that may have been pasted.
spawn_opencode_submit() {
  [[ "$PROFILE_KIND" == opencode ]] || return 0
  case "$SPAWN_SUBMIT" in proven|accepted|unconfirmed) ;; *) return 0 ;; esac
  sleep_for 2
  "$HERDR" agent send-keys "$PANE" return >/dev/null 2>&1 || true
}

# spawn_herdr_fallback — the rc 4 path, entered at most once per spawn. It is
# the pre-#498 direct injection, without its re-injection: a second direct
# send would be a second fallback.
spawn_herdr_fallback() {
  SPAWN_VIA=herdr-fallback
  SPAWN_FALLBACKS=$((SPAWN_FALLBACKS + 1))
  if [[ "$PROFILE_KIND" == opencode ]]; then
    "$HERDR" agent prompt "$PANE" "$PROMPT_PAYLOAD" >/dev/null 2>&1 || true
    sleep_for 2
    "$HERDR" agent send-keys "$PANE" return >/dev/null 2>&1 || true
  elif ! "$HERDR" agent prompt "$PANE" "$PROMPT_PAYLOAD" --wait \
    --until working --until idle --until "done" --until blocked --timeout 40000 >/dev/null 2>&1; then
    "$HERDR" agent send-keys "$PANE" return >/dev/null 2>&1 || true
  fi
}

# spawn_deliver_brief — sets LANDING (yes|retry|no), SPAWN_VIA and, when not
# landed, LANDING_NO_DETAIL.
spawn_deliver_brief() {
  local detail retry_skip_reason
  SPAWN_VIA=panewire
  SPAWN_FALLBACKS=0
  SPAWN_PROMPT_FILES=()
  LANDING=no
  PROMPT_PAYLOAD="$(<"$PROMPT")"
  PROMPT_MARKER="$(prompt_marker "$PROMPT")"
  SPAWN_EXPECT_CWD="$(spawn_expect_cwd "$CWD" "$PANE")"

  spawn_panewire_prompt 1
  spawn_opencode_submit
  local first="panewire_rc=$SPAWN_PANEWIRE_RC submit=$SPAWN_SUBMIT"
  [[ -z "$SPAWN_PANEWIRE_ERR" ]] || first="$first panewire_err=\"$SPAWN_PANEWIRE_ERR\""
  case "$SPAWN_SUBMIT" in
    proven)
      LANDING=yes
      return 0
      ;;
    unsent)
      LANDING_NO_DETAIL="phase=initial $first action=landed-no retry=skipped reason=panewire-refused-before-send"
      return 0
      ;;
    daemon)
      spawn_herdr_fallback
      # The fallback injected through herdr directly, so a post-injection
      # observation attaches to a delivery that definitely happened.
      if landing_check "$PANE" "$PROMPT_MARKER" "$PROFILE_KIND" accepted; then
        LANDING=yes
      else
        detail="$(landing_check_detail)"
        LANDING_NO_DETAIL="phase=initial $first via=herdr-fallback $detail action=landed-no retry=skipped reason=fallback-once"
      fi
      return 0
      ;;
  esac

  # accepted | unconfirmed: panewire could not prove it. Observe only.
  if landing_check "$PANE" "$PROMPT_MARKER" "$PROFILE_KIND" "$SPAWN_SUBMIT"; then
    LANDING=yes
    return 0
  fi
  detail="$(landing_check_detail)"
  # Grok is never re-injected: its echo can outlive even the extended window,
  # so a confirmed-looking non-landing can still be a brief in flight, and a
  # second injection is the duplicate-brief risk this lane exists to avoid.
  if [[ "$SPAWN_SUBMIT" == accepted && "$PROFILE_KIND" != grok &&
        "$LANDING_CHECK_CONFIRMED" -eq 1 && "$LANDING_CHECK_AMBIGUOUS" -eq 0 ]]; then
    # herdr took the first delivery and the whole window found no marker and
    # no queued chip: confirmed non-landing. Exactly one re-injection, again
    # through panewire, as a new delivery.
    warn "landing window expired; pane=$PANE phase=initial $first $detail action=reinject-once"
    spawn_panewire_prompt 2
    spawn_opencode_submit
    local second="panewire_rc=$SPAWN_PANEWIRE_RC submit=$SPAWN_SUBMIT"
    [[ -z "$SPAWN_PANEWIRE_ERR" ]] || second="$second panewire_err=\"$SPAWN_PANEWIRE_ERR\""
    case "$SPAWN_SUBMIT" in
      proven) LANDING=retry; return 0 ;;
      accepted|unconfirmed)
        if landing_check "$PANE" "$PROMPT_MARKER" "$PROFILE_KIND" "$SPAWN_SUBMIT"; then
          LANDING=retry
          return 0
        fi
        detail="$(landing_check_detail)"
        ;;
    esac
    LANDING_NO_DETAIL="phase=retry $second $detail action=landed-no"
    return 0
  fi
  if [[ "$SPAWN_SUBMIT" != accepted ]]; then
    retry_skip_reason='prompt-submission-unconfirmed'
  elif [[ "$LANDING_CHECK_AMBIGUOUS" -ne 0 ]]; then
    retry_skip_reason='ambiguous-observation'
  elif [[ "$PROFILE_KIND" == grok ]]; then
    retry_skip_reason='grok-never-reinjected'
  else
    retry_skip_reason='non-landing-not-confirmed'
  fi
  LANDING_NO_DETAIL="phase=initial $first $detail action=landed-no retry=skipped reason=$retry_skip_reason"
}

# Print the [thinking] effort value of a Kimi CLI home's config.toml (empty
# when absent/unparseable). Used by the #704 E6 kimi rungs to prove the pinned
# clone home actually runs the requested effort — the kimi CLI has no
# --effort flag, so the clone config is the only place the rung exists.
kimi_clone_thinking_effort() {
  kimi_clone_resolved_effort "$1" ""
}

# Print the effort a Kimi home resolves to for a given spawned model id, in
# Kimi Code's documented precedence:
#   1. [thinking].enabled = false resolves to the model's off_effort —
#      Thinking is off, so no configured/default effort applies (a model
#      marked always_thinking ignores the flag).
#   2. KIMI_MODEL_THINKING_EFFORT overlays the effort at runtime and bypasses
#      support_efforts — when exported it is the rung.
#   3. Otherwise the [thinking] effort when the model accepts it (no
#      [models."<id>"] table, or a support_efforts list that contains it),
#      else that model's default_effort — Kimi Code falls back to the model
#      default for a missing or unsupported request. Keys under
#      [models."<id>".overrides] override the base model entry.
# config.toml is real TOML — dotted keys, inline tables, string escapes,
# multiline strings and indented headers are all equivalent spellings — so
# the authoritative read is a python3 tomllib/tomli parse; an awk scan
# covers only the common table forms when no TOML lib is importable. With no
# readable config the bounded env overlay alone resolves (kimi applies it
# with no file); empty when nothing resolves: fail-open — the kimi argv
# carries no rung either way.
kimi_clone_resolved_effort() {
  local cfg="$1" model="$2" out env_eff="${KIMI_MODEL_THINKING_EFFORT:-}"
  if [[ ! -r "$cfg" ]]; then
    # No file to parse, but kimi still applies the env overlay — bound and
    # normalize it exactly like the python/awk paths or "MAX" slips past the
    # case-sensitive seat rule on spelling alone.
    local norm
    norm="${env_eff#"${env_eff%%[![:space:]]*}"}"
    norm="${norm%"${norm##*[![:space:]]}"}"
    norm="$(printf '%s' "$norm" | tr '[:upper:]' '[:lower:]')"
    case "$norm" in
      minimal|low|medium|high|xhigh|max|ultra|off|on) printf '%s\n' "$norm" ;;
    esac
    return 0
  fi
  if out="$(KIMI_EFFORT_ENV="$env_eff" python3 - "$cfg" "$model" 2>/dev/null <<'PY'
import os, sys
try:
    import tomllib
except ImportError:
    import tomli as tomllib
with open(sys.argv[1], "rb") as fh:
    cfg = tomllib.load(fh)
def table(v):
    return v if isinstance(v, dict) else {}
def string(v):
    return v if isinstance(v, str) else None
def truthy(v):
    return v is True or (isinstance(v, str) and v.lower() in ("1", "true", "yes", "on"))
thinking = table(cfg.get("thinking"))
model = table(table(cfg.get("models")).get(sys.argv[2]))
over = table(model.get("overrides"))
def pick(key):
    return over.get(key, model.get(key))
def strings(v):
    return [x for x in v if isinstance(x, str)] if isinstance(v, list) else None
effort = string(thinking.get("effort"))
support = strings(pick("support_efforts"))
default = string(pick("default_effort"))
off = string(pick("off_effort"))
caps = set(strings(pick("capabilities")) or [])
# always-thinking is declared two ways: an always_thinking model field or an
# "always_thinking" capability tag (either can sit under overrides). In both
# shapes enabled=false does not take the model off.
always = truthy(pick("always_thinking")) or "always_thinking" in caps
if thinking.get("enabled") is False and not always:
    print(off or "")
    raise SystemExit(0)
env_eff = (os.environ.get("KIMI_EFFORT_ENV") or "").strip().lower()
if env_eff in {"minimal", "low", "medium", "high", "xhigh", "max", "ultra", "off", "on"}:
    print(env_eff)
    raise SystemExit(0)
if effort == "off" and not always:
    print("off")
    raise SystemExit(0)
resolved = effort
if model and (resolved is None or (support is not None and resolved not in support)):
    resolved = default
print(resolved or "")
PY
)"; then
    printf '%s\n' "$out"
    return 0
  fi
  # awk fallback for hosts with no importable TOML lib: common table forms
  # only — dotted keys, inline tables, string escapes and multiline strings
  # need the real parser above.
  awk -v want_model="$model" -v env_eff="$env_eff" '
    BEGIN { sq = sprintf("%c", 39) }
    function unq(s) {
      sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s)
      if (s ~ /^".*"$/) return substr(s, 2, length(s) - 2)
      if (substr(s, 1, 1) == sq && substr(s, length(s), 1) == sq)
        return substr(s, 2, length(s) - 2)
      return ""
    }
    function rhs(   v) {
      v = $0
      sub(/^[^=]*=[[:space:]]*/, "", v)
      sub(/[[:space:]]+#.*$/, "", v)
      return unq(v)
    }
    function rawrhs(   v) {
      v = $0
      sub(/^[^=]*=[[:space:]]*/, "", v); sub(/[[:space:]]*#.*$/, "", v)
      sub(/^[[:space:]]+/, "", v); sub(/[[:space:]]+$/, "", v)
      return v
    }
    /^[[:space:]]*\[/ {
      h = $0
      sub(/^[[:space:]]*\[/, "", h); sub(/\].*$/, "", h)
      gsub(/[[:space:]]/, "", h)
      in_thinking = (h == "thinking")
      in_model = 0
      if (want_model != "" && h ~ /^models\./) {
        mh = substr(h, 8)
        sub(/\.overrides$/, "", mh)
        if (unq(mh) == want_model) { in_model = 1; m_seen = 1 }
      }
      next
    }
    collecting {
      sup = sup " " $0
      if ($0 ~ /\]/) collecting = 0
      next
    }
    c_collecting {
      caps = caps " " $0
      if ($0 ~ /\]/) c_collecting = 0
      next
    }
    in_thinking && $0 ~ /^[[:space:]]*effort[[:space:]]*=/ { t = rhs(); next }
    in_thinking && $0 ~ /^[[:space:]]*enabled[[:space:]]*=/ { en = rawrhs(); next }
    in_model && $0 ~ /^[[:space:]]*always_thinking[[:space:]]*=/ { at = rawrhs(); next }
    in_model && $0 ~ /^[[:space:]]*capabilities[[:space:]]*=/ {
      caps = $0; c_seen = 1
      if (caps !~ /\]/) c_collecting = 1
      next
    }
    in_model && $0 ~ /^[[:space:]]*off_effort[[:space:]]*=/ { o = rhs(); next }
    in_model && $0 ~ /^[[:space:]]*default_effort[[:space:]]*=/ { d = rhs(); next }
    in_model && $0 ~ /^[[:space:]]*support_efforts[[:space:]]*=/ {
      sup = $0; s_seen = 1
      if (sup !~ /\]/) collecting = 1
      next
    }
    END {
      if (s_seen) {
        rest = sup
        while (match(rest, /"[^"]*"/)) {
          S[substr(rest, RSTART + 1, RLENGTH - 2)] = 1
          rest = substr(rest, RSTART + RLENGTH)
        }
        rest = sup
        while (match(rest, sq "[^" sq "]*" sq)) {
          S[substr(rest, RSTART + 1, RLENGTH - 2)] = 1
          rest = substr(rest, RSTART + RLENGTH)
        }
      }
      if (c_seen) {
        rest = caps
        while (match(rest, /"[^"]*"/)) {
          C[substr(rest, RSTART + 1, RLENGTH - 2)] = 1
          rest = substr(rest, RSTART + RLENGTH)
        }
        rest = caps
        while (match(rest, sq "[^" sq "]*" sq)) {
          C[substr(rest, RSTART + 1, RLENGTH - 2)] = 1
          rest = substr(rest, RSTART + RLENGTH)
        }
      }
      always = (at == "true" || ("always_thinking" in C))
      if (en == "false" && !always) { print o; exit }
      if (env_eff != "") {
        e = tolower(env_eff)
        if (e ~ /^(minimal|low|medium|high|xhigh|max|ultra|off|on)$/) { print e; exit }
      }
      if (t == "off" && !always) { print "off"; exit }
      r = t
      if (m_seen && (t == "" || (s_seen && !(t in S)))) r = d
      print r
    }
  ' "$cfg"
}

# Kimi opens a folder-trust modal for an unregistered CWD. Seed only the
# workspace-trust entry it needs, before the agent starts. This is deliberately
# fail-open: trust seeding is a convenience and must never deny a Kimi spawn.
kimi_seed_workspace_trust() {
  local cwd="$1" kimi_home="$2" abs_cwd basename_path digest trust_dir trust_file trust_json

  if ! abs_cwd="$(cd -- "$cwd" 2>/dev/null && pwd -P)"; then
    warn "Kimi workspace trust seed skipped: cannot resolve absolute CWD: $cwd"
    return 0
  fi
  basename_path="${abs_cwd##*/}"
  # ROB-1307: kimi(0.37.2 실측 2건으로 역공학)는 trust 파일명을
  # wd_<sanitized>_<sha256(abs)[:12]> 로 조회하며, sanitized = basename 소문자화
  # → 앞 40자 절단 → 꼬리의 비영숫자 제거(절단이 '-' 등 구분자에서 끊긴 경우).
  # 원형 basename 으로 시딩하면 대문자/40자 초과 이름에서 미신뢰 판정 → Trust
  # 다이얼로그(기본 Don't trust=종료)가 브리프 주입 Enter 에 눌려 스폰이 죽는다.
  # (미지 문자 처리 규칙은 미관측 — worktree 이름은 [A-Za-z0-9._-] 라 이 범위로 충분)
  basename_path="$(printf '%s' "$basename_path" | tr '[:upper:]' '[:lower:]')"
  basename_path="${basename_path:0:40}"
  while [[ -n "$basename_path" && ! "${basename_path: -1}" =~ [a-z0-9] ]]; do
    basename_path="${basename_path%?}"
  done
  if ! digest="$(printf '%s' "$abs_cwd" | shasum -a 256 2>/dev/null | awk '{print $1}')" || [[ ${#digest} -lt 12 ]]; then
    warn "Kimi workspace trust seed skipped: cannot hash absolute CWD: $abs_cwd"
    return 0
  fi

  trust_dir="$kimi_home/workspace-trust"
  trust_file="$trust_dir/wd_${basename_path}_${digest:0:12}"
  if [[ -e "$trust_file" ]]; then
    echo "wrk: Kimi workspace trust exists: $trust_file" >&2
    return 0
  fi
  if ! mkdir -p -- "$trust_dir" 2>/dev/null; then
    warn "Kimi workspace trust seed skipped: cannot create $trust_dir"
    return 0
  fi
  if ! trust_json="$(python3 - "$abs_cwd" <<'PY'
import json
import sys
import time

print(json.dumps({"root": sys.argv[1], "trustedAt": int(time.time() * 1000)}, separators=(",", ":")))
PY
)"; then
    warn "Kimi workspace trust seed skipped: cannot encode $trust_file"
    return 0
  fi

  # noclobber keeps an existing entry immutable even if another spawn races
  # between the existence check and this write.
  if ! (umask 077; set -C; printf '%s\n' "$trust_json" >"$trust_file") 2>/dev/null; then
    if [[ -e "$trust_file" ]]; then
      echo "wrk: Kimi workspace trust exists: $trust_file" >&2
    else
      warn "Kimi workspace trust seed skipped: cannot write $trust_file"
    fi
    return 0
  fi
  echo "wrk: Kimi workspace trust seeded: $trust_file" >&2
}

# Devin 3000.11.x enforces workspace trust at startup: an untrusted cwd stops
# at the "Do you trust the contents of this directory?" screen, which the
# readiness window then reports as agent-not-detected (the 2026-09-28 Pi spawn
# failure, task 912). --respect-workspace-trust false in the spawn argv covers
# only non-interactive --print mode (devin docs reference/commands.mdx), so the
# TUI still prompts. wrk therefore registers the resolved spawn cwd — and only
# it — in devin's trusted-workspaces store before the pane exists.
#
# Store: ${XDG_DATA_HOME:-$HOME/.local/share}/devin/cli/trusted_workspaces.json
# — the file devin reads in user-config/src/trusted_workspaces.rs (binary
# strings: trusted_workspaces.json, trusted_paths, XDG_DATA_HOME plus the
# .local/share/devin/cli segments; confirmed live on macOS 3000.11.3, where it
# is NOT under ~/Library/Application Support). Same path rule on macOS and
# Linux. Shape: {"trusted_paths": ["/abs/dir", ...]}; trust inherits into
# subfolders.
#
# Unlike the kimi seed this is fail CLOSED: a missing or corrupt store means
# the operator's trust state is unknown, and the fallback is a modal prompt a
# spawned pane cannot answer — so the spawn is refused before any pane exists
# rather than silently creating or overwriting the file.
devin_seed_workspace_trust() {
  local cwd="$1" abs_cwd trust_file
  if ! abs_cwd="$(cd -- "$cwd" 2>/dev/null && pwd -P)"; then
    die "cannot resolve Devin spawn CWD to an absolute path: $cwd"
  fi
  trust_file="${XDG_DATA_HOME:-$HOME/.local/share}/devin/cli/trusted_workspaces.json"
  python3 - "$abs_cwd" "$trust_file" <<'PY'
import fcntl
import json
import os
import sys
import tempfile
import time

cwd = sys.argv[1]
path = os.path.realpath(sys.argv[2])


def refuse(reason):
    sys.stderr.write("wrk: Devin workspace trust refused: %s\n" % reason)
    sys.exit(1)


if not os.path.isdir(cwd):
    refuse("spawn cwd does not resolve to a directory: %s" % cwd)
# A missing store means devin has never been provisioned on this host (or the
# file was lost): refuse instead of guessing a fresh store.
if not os.path.isfile(path):
    refuse("store missing: %s — trust a directory in devin once or restore the file; not creating it" % path)

# The lock file is created once and never replaced, so flock always serializes
# on one inode. The data file itself is atomically replaced below, so it must
# be read fresh under the lock — a second spawn then sees the first spawn's
# committed entry and keeps it.
lock_path = path + ".wrk.lock"
try:
    lock_fd = open(lock_path, "a+b")
except OSError as exc:
    refuse("cannot open lock %s: %s" % (lock_path, exc))

with lock_fd:
    fcntl.flock(lock_fd, fcntl.LOCK_EX)
    try:
        try:
            with open(path, "rb") as handle:
                raw = handle.read()
        except OSError as exc:
            refuse("cannot read store %s: %s" % (path, exc))
        try:
            data = json.loads(raw)
        except ValueError as exc:
            refuse("store is not valid JSON: %s (%s) — refusing to overwrite a corrupt file" % (path, exc))
        paths = data.get("trusted_paths") if isinstance(data, dict) else None
        if not isinstance(paths, list) or not all(isinstance(entry, str) for entry in paths):
            refuse("store has no trusted_paths string list: %s — refusing to overwrite" % path)

        target = os.path.realpath(cwd)

        def covered():
            for entry in paths:
                base = os.path.realpath(entry) if os.path.isabs(entry) else ""
                if not base:
                    continue
                try:
                    # The entry itself or any ancestor of cwd covers it: devin
                    # inherits trust into subfolders.
                    if os.path.commonpath((base, target)) == base:
                        return True
                except ValueError:
                    continue
            return False

        if covered():
            sys.stderr.write("wrk: Devin workspace trust already covers %s in %s\n" % (cwd, path))
            sys.exit(0)

        # WRK_TEST_TRUST_DELAY_S (tests only) holds the read->write gap open so
        # a lockless or stale-read mutant reliably loses one concurrent entry.
        delay = float(os.environ.get("WRK_TEST_TRUST_DELAY_S") or 0)
        if delay > 0:
            time.sleep(delay)

        backup = "%s.bak-%s" % (path, time.strftime("%Y%m%d"))
        try:
            with open(backup, "wb") as handle:
                handle.write(raw)
        except OSError as exc:
            refuse("cannot write backup %s: %s — store left untouched" % (backup, exc))

        # Append only: never removes, reorders, or widens an entry.
        data["trusted_paths"] = paths + [cwd]
        blob = json.dumps(data, indent=2).encode("utf-8") + b"\n"
        mode = os.stat(path).st_mode & 0o777
        tmp_fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".trusted_workspaces.", suffix=".tmp")
        try:
            with os.fdopen(tmp_fd, "wb") as handle:
                handle.write(blob)
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(tmp, mode)
            os.replace(tmp, path)
            dir_fd = os.open(os.path.dirname(path), os.O_RDONLY)
            try:
                os.fsync(dir_fd)
            finally:
                os.close(dir_fd)
        except OSError as exc:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            refuse("atomic write failed for %s: %s" % (path, exc))
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)

sys.stderr.write("wrk: Devin workspace trust seeded %s in %s (backup %s)\n" % (cwd, path, backup))
PY
}

# #951: an unattended claude-kind spawn (opus/sonnet/haiku/fable/builder-*/cc-*)
# blocks on Claude Code's folder-trust dialog when the spawn cwd has no
# accepted-trust record — --dangerously-skip-permissions does not bypass it
# (m1b spawn blockers, agent_not_ready "blocked during startup"). Claude Code
# records an accepted dialog as projects[<absolute cwd>].hasTrustDialogAccepted
# = true in the config file at ${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json
# (verified live on claude 2.1.284: CLAUDE_CONFIG_DIR relocates .claude.json;
# file mode 0600, json.dumps indent=2). wrk writes exactly that entry — and
# only that entry — before the pane exists.
#
# Deliberately fail OPEN like the kimi seed (unlike the devin one): seeding is
# a convenience and must never deny a spawn — every refusal path warns and the
# spawn continues to whatever the dialog would have done. Writers serialize on
# a persistent flock, re-read under it, and replace the file atomically (temp
# + rename, mode preserved), so concurrent spawns cannot lose each other's
# projects and a corrupt store is never overwritten.
claude_seed_folder_trust() {
  local cwd="$1" abs_cwd cfg_home trust_file
  if ! abs_cwd="$(cd -- "$cwd" 2>/dev/null && pwd -P)"; then
    warn "Claude folder trust seed skipped: cannot resolve absolute CWD: $cwd"
    return 0
  fi
  cfg_home="${CLAUDE_CONFIG_DIR:-${HOME:-}}"
  case "$cfg_home" in
    /*) ;;
    *) warn "Claude folder trust seed skipped: config home is not absolute: $cfg_home"; return 0 ;;
  esac
  trust_file="$cfg_home/.claude.json"
  # The helper exits nonzero on every refusal; the || warn is what makes the
  # seed fail-open — it must never take the spawn down with it.
  python3 - "$abs_cwd" "$trust_file" <<'PY' || warn "Claude folder trust seed failed; spawn continues"
import fcntl
import json
import os
import sys
import tempfile
import time

cwd = sys.argv[1]
path = os.path.realpath(sys.argv[2])


def skip(reason):
    sys.stderr.write("wrk: Claude folder trust seed skipped: %s\n" % reason)
    sys.exit(1)


if not os.path.isdir(cwd):
    skip("spawn cwd does not resolve to a directory: %s" % cwd)
# The projects key is the physical path — the spawned process's getcwd() and
# Claude Code's own records resolve symlinks the same way.
target = os.path.realpath(cwd)
parent = os.path.dirname(path)
try:
    os.makedirs(parent, mode=0o700, exist_ok=True)
except OSError as exc:
    skip("cannot create config dir %s: %s" % (parent, exc))

# The lock file is created once and never replaced, so flock always serializes
# on one inode. The data file itself is atomically replaced below, so it must
# be read fresh under the lock — a second spawn then sees the first spawn's
# committed entry and keeps it.
lock_path = path + ".wrk.lock"
try:
    lock_fd = os.fdopen(os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600), "a+b")
except OSError as exc:
    skip("cannot open lock %s: %s" % (lock_path, exc))

with lock_fd:
    # Poll LOCK_EX|LOCK_NB with a deadline: a wedged holder (or a hung fs)
    # must warn and continue the spawn, not block it forever. The env knob is
    # test-only — production takes the 10s default.
    deadline = time.monotonic() + float(os.environ.get("WRK_TEST_TRUST_LOCK_TIMEOUT_S") or 10.0)
    while True:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            if time.monotonic() >= deadline:
                skip("timed out waiting for lock %s" % lock_path)
            time.sleep(0.05)
    try:
        raw = None
        if os.path.exists(path):
            try:
                with open(path, "rb") as handle:
                    raw = handle.read()
            except OSError as exc:
                skip("cannot read %s: %s" % (path, exc))
        if raw is None:
            data = {}
            mode = 0o600
        else:
            try:
                data = json.loads(raw)
            except ValueError as exc:
                skip("store is not valid JSON: %s (%s) — refusing to overwrite a corrupt file" % (path, exc))
            if not isinstance(data, dict):
                skip("store top level is not an object: %s — refusing to overwrite" % path)
            mode = os.stat(path).st_mode & 0o777

        projects = data.get("projects")
        if projects is None:
            projects = {}
            data["projects"] = projects
        elif not isinstance(projects, dict):
            skip("store projects entry is not an object: %s — refusing to overwrite" % path)

        entry = projects.get(target)
        if isinstance(entry, dict) and entry.get("hasTrustDialogAccepted") is True:
            sys.stderr.write("wrk: Claude folder trust already recorded for %s in %s\n" % (target, path))
            sys.exit(0)
        if entry is None:
            entry = {}
            projects[target] = entry
        elif not isinstance(entry, dict):
            skip("project entry for %s is not an object: %s — refusing to overwrite" % (target, path))
        entry["hasTrustDialogAccepted"] = True

        # WRK_TEST_TRUST_DELAY_S (tests only) holds the read->write gap open so
        # a lockless or stale-read mutant reliably loses one concurrent entry.
        delay = float(os.environ.get("WRK_TEST_TRUST_DELAY_S") or 0)
        if delay > 0:
            time.sleep(delay)

        # Atomic replace: temp in the same dir, fsync, rename, dir fsync —
        # mode preserved exactly, every other key (and project) untouched.
        blob = json.dumps(data, indent=2, ensure_ascii=False).encode("utf-8")
        tmp_fd, tmp = tempfile.mkstemp(dir=parent, prefix=".claude.json.", suffix=".tmp")
        try:
            with os.fdopen(tmp_fd, "wb") as handle:
                handle.write(blob)
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(tmp, mode)
            os.replace(tmp, path)
            dir_fd = os.open(parent, os.O_RDONLY)
            try:
                os.fsync(dir_fd)
            finally:
                os.close(dir_fd)
        except OSError as exc:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            skip("atomic write failed for %s: %s" % (path, exc))
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)

sys.stderr.write("wrk: Claude folder trust recorded for %s in %s\n" % (target, path))
PY
}

# Pre-spawn advisory: if -c points at a *canonical* checkout (not a linked worktree)
# that is off its remote default branch, warn. Does not fail the spawn — operators
# sometimes work on canonical on purpose. Worktrees and non-git paths stay silent.
# Default branch is never hard-coded: origin/HEAD; if unresolved, skip (false positives
# would drown real warnings).
warn_if_canonical_off_default() {
  local path="$1"
  [[ -n "$path" && -d "$path" ]] || return 0

  local git_dir common_dir
  # path-format=absolute: relative .git vs absolute common-dir would false-positive.
  if ! git_dir="$(git -C "$path" rev-parse --path-format=absolute --git-dir 2>/dev/null)"; then
    return 0
  fi
  if ! common_dir="$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
    return 0
  fi
  # Linked worktree: git-dir is .../.git/worktrees/<name>, common-dir is the main .git.
  # Canonical main checkout: both resolve to the same directory.
  [[ "$git_dir" == "$common_dir" ]] || return 0

  local origin_head default_branch current_branch
  if ! origin_head="$(git -C "$path" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null)"; then
    return 0
  fi
  default_branch="${origin_head#refs/remotes/origin/}"
  [[ -n "$default_branch" && "$default_branch" != "$origin_head" ]] || return 0

  current_branch="$(git -C "$path" branch --show-current 2>/dev/null || true)"
  # Detached HEAD or empty name: treat as off-default so the operator sees it.
  if [[ -n "$current_branch" && "$current_branch" == "$default_branch" ]]; then
    return 0
  fi

  local shown="${current_branch:-DETACHED}"
  warn "canonical checkout is not on default branch: path=$path current=$shown default=$default_branch — recover: git -C $(printf '%q' "$path") switch $(printf '%q' "$default_branch")"
}

quota_gate() {
  GATE_OUTPUT=""
  GATE_READY=0
  if [[ -z "$SCOPEFUEL" ]]; then
    SCOPEFUEL="$(command -v scopefuel 2>/dev/null || true)"
  fi
  if [[ -z "$SCOPEFUEL" || ! -e "$SCOPEFUEL" ]]; then
    warn "scopefuel unavailable; quota gate skipped during installation transition"
    return 0
  fi
  if [[ ! -x "$SCOPEFUEL" ]]; then
    echo "wrk: scopefuel exists but is not executable: $SCOPEFUEL" >&2
    return 126
  fi
  local probe probe_rc
  set +e
  probe="$("$SCOPEFUEL" gate --help 2>&1)"
  probe_rc=$?
  set -e
  if [[ "$probe_rc" -ne 0 ]]; then
    if grep -Eiq "(unknown (command|subcommand).*gate|invalid choice.*gate|no such command.*gate|unrecognized.*gate|not a valid command.*gate)" <<<"$probe"; then
      warn "installed scopefuel has no gate subcommand; quota gate skipped during installation transition"
      return 0
    fi
    [[ -z "$probe" ]] || printf '%s\n' "$probe" >&2
    return "$probe_rc"
  fi
  # stdout is captured (not swallowed) so arbiter can read the pool that scopefuel
  # itself resolved for this profile. It is re-printed verbatim; stderr is untouched.
  # --operator-request/--requested-by are forwarded verbatim when given — wrk holds
  # no REF format or profile-applicability judgement; the gate's fail-closed
  # refusal exits (0/3/4 vocabulary; 5 = role denial per task #527, remapped
  # to wrk exit 77) are propagated below.
  # --purpose is forwarded verbatim too: it is the gate's role input for the
  # astra profiles (task #527) — without it the gate role-denies them (gate
  # rc 5, surfaced by wrk as exit 77).
  local gate_args=(gate -m "$GATE_PROFILE")
  # #704: only the E6 per-rung builder spellings set GATE_EFFORT_PIN — for them
  # the gate must judge that rung's row (scopefuel #692 --effort), which the
  # matching SCOPEFUEL_E6_ARM marker (enforced in resolve_profile) then opens.
  # Every other profile keeps the exact pre-existing gate argv.
  [[ -z "${GATE_EFFORT_PIN:-}" ]] || gate_args+=(--effort "$GATE_EFFORT_PIN")
  [[ -z "${OPERATOR_REQUEST:-}" ]] || gate_args+=(--operator-request "$OPERATOR_REQUEST")
  [[ -z "${REQUESTED_BY:-}" ]] || gate_args+=(--requested-by "$REQUESTED_BY")
  [[ -z "${PURPOSE:-}" ]] || gate_args+=(--purpose "$PURPOSE")
  local out rc
  set +e
  out="$("$SCOPEFUEL" "${gate_args[@]}")"
  rc=$?
  set -e
  [[ -z "$out" ]] || printf '%s\n' "$out"
  case "$rc" in
    0) GATE_OUTPUT="$out"; GATE_READY=1; return 0 ;;
    # task #527: gate rc 5 is a ROLE denial (e.g. astra without an allowed
    # --purpose) — not a quota refusal; it must never be read as "quota
    # exhausted, retry after reset" (the ARCHITECT.md:6 misread). wrk remaps
    # it to exit 77: exit 5 already belongs to quota_hub_policy_gate's
    # hub-quota-policy denial, and sharing it would let a caller read a role
    # denial as a quota denial — the exact confusion this change exists to end.
    5) echo "wrk: scopefuel gate role-denied (gate exit 5 → wrk exit 77) — purpose not allowed or missing; NOT a quota refusal" >&2; exit 77 ;;
    3|4) exit "$rc" ;;
    *) echo "wrk: scopefuel gate failed (exit $rc)" >&2; return "$rc" ;;
  esac
}

# The local scopefuel gate remains the only profile-to-pool authority. This
# second gate adds hub-owned placement policy only after scopefuel allowed the
# profile and exposed its pool in the stable first stdout line. The panewire
# CLI owns transport/auth/response classification: only exit 4 is eligible for
# the approved local-only fallback.
quota_hub_policy_gate() {
  local hub_url token_env cf_env quota_gate first_line field pool="" panewire rc
  local gate_fields=() args=()
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  token_env="$(spillover_value hub hub_token_env 2>/dev/null || true)"
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"

  # Only the operator credential opts this gate in: a configured
  # hub_token_env means this installation enabled hub quota policy.
  # hub_url/hub_cf_env without it — and a lanes-only lanes_token_env, which
  # this gate never reads (#1037: a node token may serve the lanes routes
  # only) — preserve the exact pre-hub local-only path. A partial operator
  # config is different: hub_token_env without hub_url is an operator error,
  # and silently treating it as absent would turn it into permissive policy.
  #
  # #1138: quota_gate = "local" is the explicit opt-out for a host that keeps
  # a [hub] section without enabling hub quota policy (a lanes-only host such
  # as M1). Both config checks — and the skipped-gate warning — run ahead of
  # the evidence early-returns below so a malformed key fails closed on every
  # spawn that reaches this gate, never silently.
  if quota_gate="$(spillover_value hub quota_gate 2>/dev/null)"; then
    if [[ "$quota_gate" != local ]]; then
      echo "wrk: [hub] quota_gate accepts only \"local\"; refusing spawn" >&2
      return 70
    fi
    if [[ -n "$token_env" ]]; then
      echo "wrk: [hub] quota_gate = \"local\" contradicts hub_token_env; remove one of the two keys" >&2
      return 70
    fi
    return 0
  fi
  if [[ -n "$hub_url" && -z "$token_env" && "${HUB_QUOTA_GATE_WARNED:-0}" -eq 0 ]]; then
    HUB_QUOTA_GATE_WARNED=1
    warn "[hub] hub_url is set but hub_token_env is not; hub quota gate skipped (local scopefuel gate only)"
  fi

  # P5: a durable arbiter registration is the only evidence that permits hub
  # contact. Absent/transitional arbiter keeps the pre-existing local-only path.
  [[ "${ARBITER_JOB_REGISTERED:-0}" -eq 1 ]] || return 0
  [[ "${GATE_READY:-0}" -eq 1 ]] || return 0

  if [[ -z "$token_env" ]]; then
    return 0
  fi
  if [[ -z "$hub_url" ]]; then
    echo "wrk: hub quota gate configuration is incomplete; refusing local fallback" >&2
    return 70
  fi

  IFS= read -r first_line <<<"$GATE_OUTPUT" || true
  read -r -a gate_fields <<<"$first_line"
  for field in "${gate_fields[@]}"; do
    case "$field" in
      pool=*) pool="${field#pool=}"; break ;;
    esac
  done
  if [[ ! "$pool" =~ ^[a-z][a-z0-9._-]{0,63}$ ]]; then
    echo "wrk: scopefuel gate output has no valid pool; hub quota gate failed closed" >&2
    return 70
  fi

  panewire="${PANEWIRE_BIN:-panewire}"
  if [[ "$panewire" == */* ]]; then
    [[ -x "$panewire" ]] || {
      echo "wrk: panewire quota gate is unavailable; refusing local fallback" >&2
      return 70
    }
  elif ! command -v "$panewire" >/dev/null 2>&1; then
    echo "wrk: panewire quota gate is unavailable; refusing local fallback" >&2
    return 70
  fi

  args=(place --class worker --cwd "$CWD" --pool "$pool" --hub-url "$hub_url" --hub-token-env "$token_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  set +e
  "$panewire" "${args[@]}" >/dev/null 2>&1
  rc=$?
  set -e
  case "$rc" in
    0) return 0 ;;
    4) warn "hub quota policy unavailable; using local scopefuel result"; return 0 ;;
    5) echo "wrk: hub quota policy denied" >&2; return 5 ;;
    6) echo "wrk: hub quota policy authentication failed" >&2; return 6 ;;
    70) echo "wrk: hub quota policy response rejected" >&2; return 70 ;;
    2) echo "wrk: hub quota policy invocation rejected" >&2; return 2 ;;
    *) echo "wrk: hub quota policy failed closed (panewire exit $rc)" >&2; return 70 ;;
  esac
}

# ROB-1199: admission control. The quota gate answers "how much is left"; arbiter
# answers "who holds it". fail-closed everywhere except a genuinely absent tool.
# ROB-1214: a failed spawn must not leave its tab behind. Every retry used to
# stack another dead tab in the workspace (measured 2026-08-05: 11 shell-only
# panes in w16, krb0-v alone retried into 3 tabs) — invisible to agent-list
# based sweeps because the agent process is gone. Armed after tab create,
# disarmed at the success line alongside ARBITER_HELD=0.
spawn_pane_cleanup() {
  [[ "${SPAWN_PANE_OPEN:-0}" -eq 1 && -n "${PANE:-}" ]] || return 0
  SPAWN_PANE_OPEN=0
  "$HERDR" pane close "$PANE" >/dev/null 2>&1     && echo "wrk: closed leftover pane $PANE after spawn failure" >&2     || echo "wrk: failed to close leftover pane $PANE — close it manually" >&2
}

# Temporary workaround: herdr 0.9.1's `agent start` ownership check fails for
# Devin 3000.11.1. Remove this branch once the following command succeeds with
# rc=0 against 3000.11.1 in an operator-created disposable pane:
#   herdr agent start wrk-devin-probe --kind devin --pane "$PANE_ID" --timeout 30000 -- --model swe-2 --permission-mode dangerous --respect-workspace-trust false
#
# `pane run` deliberately targets the pane id returned by this spawn's own
# `tab create`; no name lookup is allowed between creation and rename. The
# bounded idle wait replaces agent-start's readiness wait, while the observed
# explain envelope (`agent=devin`, `matched_rule.id=welcome_prompt_footer`)
# replaces its agent_kind_mismatch ownership check.
# #604: a failed Devin spawn used to leave one stderr line and a closed pane,
# so the 2026-09-23 'invalid identity envelope' failures could not be diagnosed
# after the fact (hypothesis: a first-open trust screen matched no identity
# rule — unverifiable because nothing was preserved). Before the caller's
# cleanup closes the pane, capture what it still shows into the job directory.
# Every capture is best-effort and read-only: a preservation failure must not
# mask, replace or worsen the spawn failure it documents. Raw captures use the
# .out/.err/.rc extensions, never .json — the jobs root is scanned for event
# envelopes with rglob("*.json"), and a capture holding 'not json at all' would
# break those scans (CI, 2026-09-24).
# explain_rc non-empty means the caller already ran `agent explain` and is
# handing over THAT response — possibly empty stdout — as the response that
# failed. It is preserved verbatim and never re-queried: a second explain
# would capture a later, different response and the artifact would no longer
# show what actually failed (CodeRabbit #122). explain_rc empty means the
# caller never ran explain; detected=1 then re-queries, detected=0 records an
# explicit skip so the absence does not read as "preservation forgot it".
devin_preserve_failure_artifacts() {
  local reason="$1" detected="${2:-0}" explain_rc="${3:-}" explain_json="${4:-}"
  local dir out cap_rc
  dir="$(wrk_jobs_root)/$JOB_ID"
  if ! mkdir -p "$dir" 2>/dev/null; then
    dir="$(mktemp -d "${TMPDIR:-/tmp}/wrk-devin-failure.XXXXXX" 2>/dev/null)" || {
      warn "Devin failure artifact preservation unavailable (job dir and tmpdir both unwritable)"
      return 0
    }
  fi
  out="$(mktemp -d "$dir/devin-spawn-failure-XXXXXXXX" 2>/dev/null)" || {
    warn "Devin failure artifact dir could not be created under $dir"
    return 0
  }
  {
    printf 'reason=%s\n' "$reason"
    printf 'at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'pane=%s\nlabel=%s\ncwd=%s\nmodel=%s\n' "$PANE" "$LABEL" "$CWD" "$MODEL"
  } >"$out/reason.txt" 2>/dev/null ||
    warn "Devin failure reason.txt could not be written under $out"
  if [[ -n "$explain_rc" ]]; then
    printf '%s' "$explain_json" >"$out/explain.out" 2>/dev/null ||
      warn "Devin failure explain.out could not be written under $out"
    printf 'rc=%s\n' "$explain_rc" >"$out/explain.rc" 2>/dev/null || true
  elif [[ "$detected" -eq 1 ]]; then
    set +e
    "$HERDR" agent explain "$PANE" --format json >"$out/explain.out" 2>"$out/explain.err"
    cap_rc=$?
    set -e
    printf 'rc=%s\n' "$cap_rc" >"$out/explain.rc" 2>/dev/null || true
  else
    printf 'rc=skipped\nreason=agent-not-detected\n' >"$out/explain.rc" 2>/dev/null || true
  fi
  # `pane read`/`pane process-info` do not require herdr to have detected an
  # agent, so they also work for pre-detection and shell-only failures.
  set +e
  "$HERDR" pane read "$PANE" --source visible --lines 60 >"$out/screen-visible.txt" 2>"$out/screen-visible.err"
  printf 'rc=%s\n' "$?" >"$out/screen-visible.rc"
  "$HERDR" pane read "$PANE" --source recent-unwrapped --lines 200 >"$out/transcript.txt" 2>"$out/transcript.err"
  printf 'rc=%s\n' "$?" >"$out/transcript.rc"
  "$HERDR" pane process-info --pane "$PANE" >"$out/process-info.out" 2>"$out/process-info.err"
  printf 'rc=%s\n' "$?" >"$out/process-info.rc"
  set -e
  echo "wrk: Devin spawn failure artifacts preserved under $out" >&2
  printf '%s\n' "$out"
}

devin_spawn_diagnostics() {
  local reason="$1" detected="${2:-0}" explain_rc="${3:-}" explain_json="${4:-}" out
  echo "wrk: Devin pane startup failed: $reason; pane=$PANE" >&2
  out="$(devin_preserve_failure_artifacts "$reason" "$detected" "$explain_rc" "$explain_json")"
  # The operator-facing process-info dump replays the capture preservation just
  # made: a second live call would change the pane-touch count the readiness
  # failure contract pins (one check + one diagnostic).
  if [[ -n "$out" && -d "$out" ]]; then
    [[ ! -s "$out/process-info.out" ]] || cat "$out/process-info.out" >&2
    [[ ! -s "$out/process-info.err" ]] || cat "$out/process-info.err" >&2
  else
    "$HERDR" pane process-info --pane "$PANE" >&2 ||
      warn "Devin pane process-info failed for pane=$PANE"
  fi
}

# `agent wait` does not wait for a pane herdr has not yet detected as an agent:
# it fails at once with agent_not_found (2026-09-22 16:44, spawn.out of
# devin-spawn-probe2). Inside the START_TIMEOUT window that code only means "not
# detected yet", so `agent get` is polled until the pane is detected. Measured
# on a disposable 3000.11.1 pane: agent_not_found at 0.07s, detected by
# `agent get` at 0.42s. Any other get failure, or the window running out,
# fails closed before rename. The attempt cap keeps the loop bounded even
# when sleep is disabled.
DEVIN_DETECT_POLL_SECONDS=0.25
DEVIN_DETECT_POLL_MS=250
devin_wait_detected() {
  local started_at="$1" attempts=0 max_attempts get_out get_rc
  max_attempts=$(( START_TIMEOUT / DEVIN_DETECT_POLL_MS ))
  while :; do
    attempts=$(( attempts + 1 ))
    set +e
    get_out="$("$HERDR" agent get "$PANE" 2>&1)"
    get_rc=$?
    set -e
    [[ "$get_rc" -eq 0 ]] && return 0
    if [[ "$get_out" != *'"code":"agent_not_found"'* ]]; then
      devin_spawn_diagnostics "agent get exited $get_rc before detection"
      return 1
    fi
    if (( attempts >= max_attempts || ($(date +%s) - started_at) * 1000 >= START_TIMEOUT )); then
      devin_spawn_diagnostics "agent not detected within ${START_TIMEOUT}ms (agent_not_found x$attempts)"
      return 1
    fi
    sleep_for "$DEVIN_DETECT_POLL_SECONDS"
  done
}

# #606: a fresh pane's shell may still be starting when wrk reaches the agent
# start. herdr treats a pane as an available shell when the shell itself holds
# the foreground with no foreground command (measured 2026-09-23 on herdr 0.9.0:
# `agent start` was accepted 0.07s after tab create, before any prompt). While
# rc files run subprocesses (git rev-parse, git config ... observed) it answers
# agent_pane_busy; under load 13 that lasted most of a 7-13s zsh start. Inside
# the START_TIMEOUT window that code only means "shell not ready yet", so it is
# retried with the Devin detection poll cadence. Every other failure keeps
# failing at once. herdr refuses a start timeout of 3000ms or less, so a window
# with no more than that left fails closed instead of being handed to herdr.
SHELL_READY_POLL_SECONDS=0.25
SHELL_READY_POLL_MS=250
AGENT_START_MIN_TIMEOUT_MS=3000

agent_start_in_pane() {
  local started_at now attempts=0 max_attempts remaining_ms start_err start_rc
  # The first attempt reuses the start reading, so it always hands herdr the
  # full window (the pre-#606 argv) even when a second ticks over here.
  started_at="$(date +%s)"
  now="$started_at"
  # #1016 (#979 SHOULD S2): `agent start` types the argv into the same fresh
  # pane shell and gates only on agent_pane_busy — the foreground check that
  # cannot see a pending rc-file read. On the Pi that read (omz `read -k 1`)
  # ate the first character of `devin`; for every other kind it eats the
  # first character of the argv herdr types. Run the same retype-only
  # readiness probe before the first start attempt — it shares this spawn's
  # START_TIMEOUT window and fails closed without ever calling agent start.
  if ! devin_wait_shell_ready "$started_at"; then
    spawn_pane_cleanup
    return 1
  fi
  max_attempts=$(( START_TIMEOUT / SHELL_READY_POLL_MS ))
  while :; do
    attempts=$(( attempts + 1 ))
    remaining_ms=$(( START_TIMEOUT - (now - started_at) * 1000 ))
    if (( remaining_ms <= AGENT_START_MIN_TIMEOUT_MS )); then
      echo "wrk: agent start failed: shell not ready within the ${START_TIMEOUT}ms window (agent_pane_busy x$(( attempts - 1 ))); pane=$PANE" >&2
      spawn_pane_cleanup
      return 1
    fi
    set +e
    start_err="$("$HERDR" agent start "$LABEL" --kind "$PROFILE_KIND" --pane "$PANE" --timeout "$remaining_ms" -- "${ARGS[@]}" 2>&1 >/dev/null)"
    start_rc=$?
    set -e
    [[ "$start_rc" -eq 0 ]] && return 0
    [[ -z "$start_err" ]] || printf '%s\n' "$start_err" >&2
    if [[ "$start_err" != *'"code":"agent_pane_busy"'* ]]; then
      spawn_pane_cleanup
      return "$start_rc"
    fi
    # The wall clock is checked at the top of the loop; the cap bounds it
    # when sleep is disabled.
    if (( attempts >= max_attempts )); then
      echo "wrk: agent start failed: shell not ready within the ${START_TIMEOUT}ms window (agent_pane_busy x$attempts); pane=$PANE" >&2
      spawn_pane_cleanup
      return "$start_rc"
    fi
    sleep_for "$SHELL_READY_POLL_SECONDS"
    now="$(date +%s)"
  done
}

# #609: `agent start` (and Devin's `pane run`) can be accepted while the agent
# binary never reaches the pane foreground — the m1b spawn ran `codex` on a
# PATH that lacked it, zsh printed "command not found", and wrk still wrote
# job.spawned and typed the brief into the bare shell. Before any prompt is
# injected, poll process-info until the agent itself holds the foreground:
# some foreground process whose argv0 is one of the kind's canonical
# executable names. herdr's `--kind` is NOT always the executable name —
# measured 2026-09-24 on live panes of this Mac (pane process-info argv0,
# `name` in parentheses):
#   claude   -> "claude"        (name is the version, e.g. "2.1.281")
#   codex    -> node-script leader plus a native child argv0 "codex"
#   devin    -> "devin"         (name "devin")
#   grok     -> "grok"          (native binary ~/.grok/bin/grok)
#   kimi     -> "kimi-code"     (name "kimi"; the ~/.kimi-code/bin/kimi
#               launcher hands the pane to the kimi-code TUI — matching only
#               "kimi" fail-closed every real kimi spawn, the #609 follow-up
#               this table fixes)
#   kiro     -> unmeasured on this host (binary absent); herdr's detector
#               lists the alias "kiro-cli", so both spellings are accepted.
# The other detector aliases herdr knows (claude-code, devin-cli, grok-build,
# open-code, antigravity) are accepted for the same reason. The shell alone, a
# shell child, or an unrelated foreground process all mean "not ours yet"; the
# agent is polled inside a bounded window, anything else fails closed so the
# pane is closed and the quota record released instead of a brief landing in
# zsh.
agent_foreground_exes() {
  case "$1" in
    claude)   echo "claude claude-code" ;;
    devin)    echo "devin devin-cli" ;;
    grok)     echo "grok grok-build" ;;
    kimi)     echo "kimi-code kimi" ;;
    kiro)     echo "kiro-cli kiro" ;;
    opencode) echo "open-code opencode" ;;
    agy)      echo "antigravity agy" ;;
    *)        echo "$1" ;;
  esac
}
AGENT_FOREGROUND_TIMEOUT_MS=10000
agent_foreground_diagnostics() {
  local reason="$1"
  echo "wrk: agent foreground check failed: $reason; pane=$PANE kind=$PROFILE_KIND" >&2
  "$HERDR" pane process-info --pane "$PANE" >&2 ||
    warn "agent foreground process-info failed for pane=$PANE"
}

agent_wait_foreground() {
  local started_at attempts=0 max_attempts info_out info_rc ready
  started_at="$(date +%s)"
  max_attempts=$(( AGENT_FOREGROUND_TIMEOUT_MS / SHELL_READY_POLL_MS ))
  while :; do
    attempts=$(( attempts + 1 ))
    set +e
    info_out="$("$HERDR" pane process-info --pane "$PANE" 2>/dev/null)"
    info_rc=$?
    set -e
    if [[ "$info_rc" -ne 0 ]]; then
      agent_foreground_diagnostics "pane process-info exited $info_rc before brief injection"
      return 1
    fi
    set +e
    ready="$(printf '%s' "$info_out" | python3 -c '
import json, os, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    raise SystemExit(1)
info = d.get("result") or {}
info = info.get("process_info") or d.get("process_info")
if not isinstance(info, dict):
    raise SystemExit(1)
procs = info.get("foreground_processes")
if not isinstance(procs, list):
    raise SystemExit(1)
want = set(sys.argv[1].split())
for p in procs:
    if not isinstance(p, dict):
        continue
    names = [os.path.basename(str(p.get("argv0") or ""))]
    cmd = str(p.get("cmdline") or "").split()
    if cmd:
        names.append(os.path.basename(cmd[0]))
    if want.intersection(names):
        print("yes")
        break
else:
    print("no")
' "$(agent_foreground_exes "$PROFILE_KIND")" 2>/dev/null)"
    info_rc=$?
    set -e
    if [[ "$info_rc" -ne 0 ]]; then
      agent_foreground_diagnostics "pane process-info returned an invalid envelope before brief injection"
      return 1
    fi
    [[ "$ready" == yes ]] && return 0
    if (( attempts >= max_attempts || ($(date +%s) - started_at) * 1000 >= AGENT_FOREGROUND_TIMEOUT_MS )); then
      agent_foreground_diagnostics "agent not foreground within ${AGENT_FOREGROUND_TIMEOUT_MS}ms (not-foreground x$attempts)"
      return 1
    fi
    sleep_for "$SHELL_READY_POLL_SECONDS"
  done
}

# `pane run` has no availability check: it types into whatever holds the
# terminal, and `agent start`'s agent_pane_busy gate is the same foreground
# check (#1016). Before the agent argv is typed — `pane run` for Devin,
# `agent start` for every other kind — poll process-info until herdr's own
# available-shell rule holds (the shell is the foreground process group and the
# only foreground process). A process-info failure or an envelope that cannot
# be read fails closed at once; only "not ready yet" is polled, inside the same
# window that detection and the idle wait then share.
# #604/m1b: herdr's process-info shape is not identical everywhere — the m1b
# 0.9.0 reply (hk:doc evidence/2026-09-24/task604-m1b-repro) carries
# process_info without the "result" wrapper and without
# foreground_process_group_id, but still names shell_pid and the foreground
# list. That is a readable "not ready yet" (an rc-file subprocess like
# compinit's grep holding the foreground), not an invalid envelope: readiness
# is judged from shell_pid + foreground pids alone, the group id checked only
# when present. What stays invalid — and fails closed at once — is an envelope
# whose shell_pid/foreground list cannot be read at all.
# #979: the shell holding the foreground alone is not proof of a command-line
# prompt — a fresh pane's zsh can sit in a pending rc-file read (the Pi's
# oh-my-zsh update check holds `read -k 1`; the typed `devin` lost its first
# character to it and the spawn died agent_not_found on `evin`,
# jobs/971-stale-race-20260929-1848). Once the foreground says "shell alone",
# prove the shell executes command lines before the agent argv is typed: run a
# probe whose printf argument is a fresh token and require the token back as
# its own output line. The echoed command carries the token inside the printf
# argument too, so only an exact-line match is proof — a substring match would
# accept an echo from a shell that ran nothing. A probe that goes unanswered
# is retried with a fresh token after DEVIN_PROBE_MISS_POLLS reads — and only
# retyped, never interrupted: a send-keys ctrl+c during a still-sourcing rc
# file SIGINTs the rest of .zshrc/.bashrc and leaves the agent in a truncated
# environment (fix-round-1 tester: 7s rc starts under load, and every earlier
# queued line would have run unharmed once the shell was ready). The output
# of ANY token this spawn typed counts as proof — lines queued behind a slow
# rc all execute when the prompt arrives, and a `read -k 1` that ate the
# leading space still runs the remainder of the line. A probe that never
# lands is a distinct fail-closed reason inside the same START_TIMEOUT
# window.
DEVIN_PROBE_MISS_POLLS=4

# #1016: the same wait guards `agent start` for every non-devin kind —
# herdr types their argv into the same fresh shell. Devin's diagnostics
# contract ("Devin pane startup failed", failure-artifact preservation) is
# pinned by its tests; the other kinds report the same reason on the
# agent-start failure line with the same process-info dump.
shell_ready_diagnostics() {
  local reason="$1"
  if [[ "$PROFILE_KIND" == devin ]]; then
    devin_spawn_diagnostics "$reason"
    return
  fi
  echo "wrk: agent start failed: $reason; pane=$PANE" >&2
  "$HERDR" pane process-info --pane "$PANE" >&2 ||
    warn "agent start process-info failed for pane=$PANE"
}

# probe_token/probe_tokens/probe_sends/probe_misses/attempts are
# devin_wait_shell_ready locals — dynamic scope is what lets this helper
# update them.
devin_probe_send() {
  probe_token="wrk-ready-$$-${attempts}-${RANDOM}"
  probe_tokens="${probe_tokens:+$probe_tokens }$probe_token"
  probe_sends=$(( probe_sends + 1 ))
  probe_misses=0
  local probe_run_rc
  set +e
  # The leading space keeps the probe out of shell history where the shell
  # honours it; the single argument is the whole typed line.
  "$HERDR" pane run "$PANE" " printf '%s\\n' '$probe_token'" >/dev/null
  probe_run_rc=$?
  set -e
  if [[ "$probe_run_rc" -ne 0 ]]; then
    shell_ready_diagnostics "readiness probe pane run exited $probe_run_rc"
    return 1
  fi
}

devin_wait_shell_ready() {
  local started_at="$1" attempts=0 max_attempts info_out info_rc ready
  local probe_token="" probe_tokens="" probe_sends=0 probe_misses=0
  local probe_out probe_rc probe_matched probe_any
  # The command the shell must prove it can run before wrk (or herdr, for
  # `agent start`) types it: `pane run` for devin, `agent start` for every
  # other kind (#1016).
  local start_action=pane\ run
  [[ "$PROFILE_KIND" == devin ]] || start_action=agent\ start
  max_attempts=$(( START_TIMEOUT / SHELL_READY_POLL_MS ))
  while :; do
    attempts=$(( attempts + 1 ))
    if [[ -n "$probe_token" ]]; then
      # A probe is in flight: only output lines prove execution, and the
      # output of ANY token this spawn typed counts — queued lines run in
      # order once the shell reaches its prompt.
      set +e
      probe_out="$("$HERDR" pane read "$PANE" --source recent-unwrapped --lines 60 2>/dev/null)"
      probe_rc=$?
      set -e
      probe_matched=0
      if [[ "$probe_rc" -eq 0 ]]; then
        for probe_any in $probe_tokens; do
          if grep -qxF "$probe_any" <<<"$probe_out"; then probe_matched=1; break; fi
        done
      fi
      [[ "$probe_matched" -eq 1 ]] && return 0
      probe_misses=$(( probe_misses + 1 ))
      (( probe_misses >= DEVIN_PROBE_MISS_POLLS )) && probe_token=""
    else
      set +e
      info_out="$("$HERDR" pane process-info --pane "$PANE" 2>/dev/null)"
      info_rc=$?
      set -e
      if [[ "$info_rc" -ne 0 ]]; then
        shell_ready_diagnostics "pane process-info exited $info_rc before $start_action"
        return 1
      fi
      set +e
      ready="$(printf '%s' "$info_out" | python3 -c '
import json, sys
d = json.load(sys.stdin)
res = d.get("result")
info = res.get("process_info") if isinstance(res, dict) else d.get("process_info")
if not isinstance(info, dict):
    raise SystemExit(1)
shell = info.get("shell_pid")
group = info.get("foreground_process_group_id")
procs = info.get("foreground_processes")
if type(shell) is not int or not isinstance(procs, list):
    raise SystemExit(1)
if group is not None and type(group) is not int:
    raise SystemExit(1)
pids = [p.get("pid") if isinstance(p, dict) else None for p in procs]
ready = bool(pids) and all(pid == shell for pid in pids)
if group is not None:
    ready = ready and group == shell
print("yes" if ready else "no")
' 2>/dev/null)"
      info_rc=$?
      set -e
      if [[ "$info_rc" -ne 0 ]]; then
        shell_ready_diagnostics "pane process-info returned an invalid envelope before $start_action"
        return 1
      fi
      if [[ "$ready" == yes ]]; then devin_probe_send || return 1; fi
    fi
    if (( attempts >= max_attempts || ($(date +%s) - started_at) * 1000 >= START_TIMEOUT )); then
      if [[ "$probe_sends" -gt 0 ]]; then
        shell_ready_diagnostics "shell did not execute a readiness probe within ${START_TIMEOUT}ms (probes typed x$probe_sends)"
      else
        shell_ready_diagnostics "shell not ready within ${START_TIMEOUT}ms (foreground busy x$attempts)"
      fi
      return 1
    fi
    sleep_for "$SHELL_READY_POLL_SECONDS"
  done
}

# #649: a slow host (m1b) reaches the identity check before devin's TUI is
# painted — the pane still shows only the typed command and every identity
# rule reports unmatched, so a single `agent explain` used to fail the spawn
# with "invalid identity envelope" while the agent was merely starting. Inside
# the START_TIMEOUT window an envelope with no matched rule is "not identified
# yet": explain is re-polled with backoff (the same window that shell
# readiness, detection and the idle wait share). A matched non-welcome rule —
# trust dialog, permission prompt, error screen — is a terminal state and is
# judged at once, as is a non-devin agent or an unreadable envelope. On window
# expiry the failure is the existing fail-closed path plus #604's evidence
# preservation, and the reason names which unmatched shape never resolved.
DEVIN_IDENTITY_POLL_MS=250
DEVIN_IDENTITY_POLL_MAX_MS=2000

# Prints the identity verdict for one `agent explain` envelope, one of:
#   ready                    agent=devin and matched_rule.id=welcome_prompt_footer
#   decided<TAB>agent<TAB>rule  a non-welcome rule matched, or the detected
#                            agent is not devin — judged immediately either way
#   starting                 no rule matched and the evaluated screen region is
#                            only the `devin …` command line wrk typed
#   unmatched                no rule matched but the screen shows something
#                            else (mid-render, or a genuinely unexpected pane)
# Exit 1 = the envelope itself could not be read (the #604 "invalid identity
# envelope" case — never retried, a malformed answer is not startup).
devin_classify_identity() {
  WRK_DEVIN_CMD="devin ${ARGS[*]}" python3 -c '
import json, os, sys
d = json.load(sys.stdin)
agent = d.get("agent")
matched = d.get("matched_rule")
if not isinstance(agent, str):
    sys.exit(1)
if matched is None:
    rule = None
elif isinstance(matched, dict) and isinstance(matched.get("id"), str):
    rule = matched["id"]
else:
    sys.exit(1)
if agent == "devin" and rule == "welcome_prompt_footer":
    print("ready")
elif agent != "devin" or rule is not None:
    print("decided\t%s\t%s" % (agent, rule or ""))
else:
    cmd = "".join(os.environ.get("WRK_DEVIN_CMD", "").split())
    previews = [
        ev["region_preview"]
        for r in d.get("evaluated_rules") or []
        if isinstance(r, dict)
        for ev in [r.get("evidence")]
        if isinstance(ev, dict) and isinstance(ev.get("region_preview"), str)
    ]
    flat = "".join((max(previews, key=len) if previews else "").split())
    idx = flat.rfind(cmd) if cmd else -1
    # A cursor glyph may trail the command; nothing else may.
    print("starting" if idx >= 0 and len(flat) - idx - len(cmd) <= 2 else "unmatched")
'
}

devin_wait_identity() {
  local started_at="$1" attempts=0 max_attempts explain_json explain_rc verdict class_rc
  local detected_agent matched_rule poll_ms="$DEVIN_IDENTITY_POLL_MS"
  max_attempts=$(( START_TIMEOUT / DEVIN_IDENTITY_POLL_MS ))
  while :; do
    attempts=$(( attempts + 1 ))
    set +e
    explain_json="$("$HERDR" agent explain "$PANE" --format json 2>/dev/null)"
    explain_rc=$?
    set -e
    if [[ "$explain_rc" -ne 0 ]]; then
      devin_spawn_diagnostics "agent explain exited $explain_rc" 1 "$explain_rc" "$explain_json"
      return "$explain_rc"
    fi
    set +e
    verdict="$(printf '%s' "$explain_json" | devin_classify_identity)"
    class_rc=$?
    set -e
    if [[ "$class_rc" -ne 0 ]]; then
      devin_spawn_diagnostics "agent explain returned an invalid identity envelope" 1 "$explain_rc" "$explain_json"
      return 1
    fi
    case "$verdict" in
      ready) return 0 ;;
      decided*)
        IFS=$'\t' read -r _ detected_agent matched_rule <<<"$verdict"
        devin_spawn_diagnostics "expected agent=devin rule=welcome_prompt_footer, got agent=$detected_agent rule=$matched_rule" 1 "$explain_rc" "$explain_json"
        return 1 ;;
      starting|unmatched)
        if (( attempts >= max_attempts || ($(date +%s) - started_at) * 1000 >= START_TIMEOUT )); then
          if [[ "$verdict" == starting ]]; then
            devin_spawn_diagnostics "agent explain still starting within ${START_TIMEOUT}ms (command-line-only screen x$attempts)" 1 "$explain_rc" "$explain_json"
          else
            devin_spawn_diagnostics "agent explain matched no identity rule within ${START_TIMEOUT}ms (unmatched screen x$attempts)" 1 "$explain_rc" "$explain_json"
          fi
          return 1
        fi
        sleep_for "$(awk -v ms="$poll_ms" 'BEGIN{printf "%.3f", ms/1000}')"
        (( poll_ms < DEVIN_IDENTITY_POLL_MAX_MS )) && poll_ms=$(( poll_ms * 2 ))
        ;;
    esac
  done
}

devin_start_in_pane() {
  local run_rc wait_rc identity_rc=0 rename_rc
  local started_at remaining_ms

  started_at="$(date +%s)"
  if ! devin_wait_shell_ready "$started_at"; then
    spawn_pane_cleanup
    return 1
  fi
  set +e
  "$HERDR" pane run "$PANE" devin "${ARGS[@]}" >/dev/null
  run_rc=$?
  set -e
  if [[ "$run_rc" -ne 0 ]]; then
    devin_spawn_diagnostics "pane run exited $run_rc"
    spawn_pane_cleanup
    return "$run_rc"
  fi

  if ! devin_wait_detected "$started_at"; then
    spawn_pane_cleanup
    return 1
  fi

  # The 3000.11.1 welcome banner was measured at about 5.3 seconds. Detection
  # and the idle wait share wrk's existing 30-second START_TIMEOUT window, which
  # gives cold starts ample margin while keeping readiness failure bounded.
  # Detection can land on the window edge; never hand agent wait a zero or
  # negative timeout (it must not turn into an unbounded or undefined wait).
  remaining_ms=$(( START_TIMEOUT - ($(date +%s) - started_at) * 1000 ))
  if (( remaining_ms <= 0 )); then
    devin_spawn_diagnostics "agent detected after the ${START_TIMEOUT}ms window" 1
    spawn_pane_cleanup
    return 1
  fi
  set +e
  "$HERDR" agent wait "$PANE" --until idle --timeout "$remaining_ms" >/dev/null
  wait_rc=$?
  set -e
  if [[ "$wait_rc" -ne 0 ]]; then
    devin_spawn_diagnostics "welcome_prompt_footer wait exited $wait_rc" 1
    spawn_pane_cleanup
    return "$wait_rc"
  fi

  # #649: the identity check used to be one shot, which mistook a slow TUI
  # (m1b, MCP servers still starting) for a spawn failure.  Poll explain until
  # a rule matches, the envelope is decided, or the START_TIMEOUT window
  # closes; the preserved rc distinguishes the sub-failures for callers. The
  # `||` capture keeps errexit off through the call — the wait re-enables it
  # internally, so a plain `set +e` bracket would still abort before the rc
  # could be read (the sibling waits get the same shield from `if !`).
  devin_wait_identity "$started_at" || identity_rc=$?
  if [[ "$identity_rc" -ne 0 ]]; then
    spawn_pane_cleanup
    return "$identity_rc"
  fi

  set +e
  "$HERDR" agent rename "$PANE" "$LABEL" >/dev/null
  rename_rc=$?
  set -e
  if [[ "$rename_rc" -ne 0 ]]; then
    devin_spawn_diagnostics "agent rename exited $rename_rc" 1
    spawn_pane_cleanup
    return "$rename_rc"
  fi
}

arbiter_release_held() {
  [[ "${ARBITER_HELD:-0}" -eq 1 ]] || return 0
  ARBITER_HELD=0
  local rc
  set +e
  "$ARBITER" release --job "$JOB_ID" --resource "$ARBITER_RESOURCE" --kind quota_pool >/dev/null 2>&1
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    echo "wrk: arbiter quota-pool record release failed (exit $rc): $ARBITER_RESOURCE job=$JOB_ID" >&2
  else
    echo "wrk: arbiter quota-pool record released after spawn failure: $ARBITER_RESOURCE job=$JOB_ID" >&2
  fi
}

arbiter_get_duplicate_state() {
  # Query the durable receipt surface rather than parsing localized stderr from
  # claim.  The parser rejects malformed/non-string fields, because accepting
  # an ambiguous state would recreate the exact-once failure we are fixing.
  local lookup lookup_rc parsed parse_rc lookup_job lookup_state lookup_owner lookup_created
  set +e
  lookup="$("$ARBITER" job-get --job "$JOB_ID" --json 2>/dev/null)"
  lookup_rc=$?
  set -e
  # job-get's dedicated not-found result is a readable admission answer, not
  # an unavailable arbiter.  Keep it distinct for router preflight.
  [[ "$lookup_rc" -eq 0 ]] || { [[ "$lookup_rc" -eq 7 ]] && return 2; return 1; }
  set +e
  parsed="$(printf '%s' "$lookup" | python3 -c '
import json, sys
d = json.load(sys.stdin)
keys = ("job_id", "state", "owner_lane", "created_at")
values = []
for key in keys:
    value = d.get(key)
    if not isinstance(value, str) or not value or "\t" in value or "\n" in value:
        raise ValueError("invalid job-get field: " + key)
    values.append(value)
print("\t".join(values))
')"
  parse_rc=$?
  set -e
  [[ "$parse_rc" -eq 0 ]] || return 1
  IFS=$'\t' read -r lookup_job lookup_state lookup_owner lookup_created <<<"$parsed"
  [[ "$lookup_job" == "$JOB_ID" && -n "$lookup_state" && -n "$lookup_owner" && -n "$lookup_created" ]] || return 1
  ARBITER_DUP_STATE="$lookup_state"
  ARBITER_DUP_OWNER_LANE="$lookup_owner"
  ARBITER_DUP_CREATED_AT="$lookup_created"
  return 0
}

arbiter_handle_duplicate_claim() {
  # $1 is set only for the one state re-check allowed after a reclaim race.
  # A second released observation is not a license to spin/retry indefinitely.
  local after_reclaim_race="${1:-0}" reclaim_rc
  if ! arbiter_get_duplicate_state; then
    warn "arbiter duplicate job state lookup failed; refusing spawn (fail-closed): job_id=$JOB_ID"
    return "$WRK_EXIT_JOB_STATE_UNREADABLE"
  fi
  case "$ARBITER_DUP_STATE" in
    claimed|leased)
      if [[ "${JOB_DUP_OK:-0}" -eq 1 ]]; then
        warn "active arbiter job duplicate proceeding only because --job-dup-ok override was supplied: job_id=$JOB_ID state=$ARBITER_DUP_STATE owner_lane=$ARBITER_DUP_OWNER_LANE created_at=$ARBITER_DUP_CREATED_AT"
        # The row belongs to this exact job id already, so a later successful
        # spawn receipt can still be written even if its quota record is old.
        ARBITER_JOB_REGISTERED=1
        return 0
      fi
      warn "active arbiter job duplicate refused (fail-closed): job_id=$JOB_ID state=$ARBITER_DUP_STATE owner_lane=$ARBITER_DUP_OWNER_LANE created_at=$ARBITER_DUP_CREATED_AT"
      return "$WRK_EXIT_ACTIVE_JOB_DUPLICATE"
      ;;
    released)
      if [[ "$after_reclaim_race" -eq 1 ]]; then
        warn "arbiter duplicate job changed during released reclaim; refusing spawn (fail-closed): job_id=$JOB_ID state=$ARBITER_DUP_STATE owner_lane=$ARBITER_DUP_OWNER_LANE created_at=$ARBITER_DUP_CREATED_AT"
        return "$WRK_EXIT_JOB_STATE_UNREADABLE"
      fi
      set +e
      "$ARBITER" claim --reclaim-released --job "$JOB_ID" --agent-label "$LABEL" --lane "$JOB_LANE" --t "$JOB_T" "${ARBITER_CLAIM_ROLE_ARGS[@]}" ${ARBITER_CLAIM_TASK_ARGS[@]+"${ARBITER_CLAIM_TASK_ARGS[@]}"} >/dev/null
      reclaim_rc=$?
      set -e
      case "$reclaim_rc" in
        0)
          ARBITER_JOB_REGISTERED=1
          warn "arbiter released job reclaimed: job_id=$JOB_ID owner_lane=$JOB_LANE"
          return 0
          ;;
        4)
          # Another recovery caller may have won between our read and update.
          # Re-observe once; it will fail-closed unless an explicit override is
          # present for the now-active owner.
          arbiter_handle_duplicate_claim 1
          return $?
          ;;
        *)
          warn "arbiter released job reclaim failed (exit $reclaim_rc); refusing spawn (fail-closed): job_id=$JOB_ID"
          return "$WRK_EXIT_JOB_STATE_UNREADABLE"
          ;;
      esac
      ;;
    *)
      warn "arbiter duplicate job has unsupported state; refusing spawn (fail-closed): job_id=$JOB_ID state=$ARBITER_DUP_STATE owner_lane=$ARBITER_DUP_OWNER_LANE created_at=$ARBITER_DUP_CREATED_AT"
      return "$WRK_EXIT_JOB_STATE_UNREADABLE"
      ;;
  esac
}

arbiter_preflight_active_duplicate() {
  # Router placement is allowed to inspect neither Herdr nor the hub for a job
  # that the durable arbiter receipt already proves is actively owned.  This is
  # deliberately a read-only look-up: normal admission below still owns the
  # claim/reclaim transition and its installation-transition handling.
  local job_id="$1" job_dup_ok="$2"
  [[ -n "$ARBITER" ]] || ARBITER="$(command -v arbiter 2>/dev/null || true)"
  # Placement is safe to continue only after a durable lookup was actually
  # readable. An absent/unreadable arbiter remains an installation transition
  # for the local spawn path, but it is never permission to route remotely.
  [[ -n "$ARBITER" && -x "$ARBITER" ]] || return "$WRK_EXIT_JOB_STATE_UNREADABLE"
  JOB_ID="$job_id"
  if arbiter_get_duplicate_state; then
    :
  else
    local lookup_rc=$?
    [[ "$lookup_rc" -eq 2 ]] && return 0
    return "$WRK_EXIT_JOB_STATE_UNREADABLE"
  fi
  case "$ARBITER_DUP_STATE" in
    claimed|leased)
      [[ "$job_dup_ok" -eq 1 ]] && return 0
      warn "active arbiter job duplicate refused (fail-closed): job_id=$JOB_ID state=$ARBITER_DUP_STATE owner_lane=$ARBITER_DUP_OWNER_LANE created_at=$ARBITER_DUP_CREATED_AT"
      return "$WRK_EXIT_ACTIVE_JOB_DUPLICATE"
      ;;
  esac
  return 0
}

arbiter_record_spawn_receipt() {
  # A pane cannot be rolled back once its agent start/prompt succeeded.  This
  # evidence write is therefore deliberately warning-only; job-get renders its
  # absence explicitly for downstream recovery rather than pretending success.
  [[ "${ARBITER_JOB_REGISTERED:-0}" -eq 1 ]] || return 0
  local payload receipt_rc
  if ! payload="$(python3 - "$PANE" "$LABEL" "$MODEL" "$WS" "${TAB_ID:-}" "${KEEP:-0}" "${TASK_ID:-}" "${HUB_LANE:-}" "${HUB_LANE_MACHINE:-}" <<'PY'
import json, sys
pane_id, label, profile, workspace, tab_id, keep, task_id, hub_lane, hub_lane_machine = sys.argv[1:]
receipt = {
    "pane_id": pane_id,
    "label": label,
    "profile": profile,
    "workspace": workspace,
}
# Additive and optional: existing consumers keep reading the four fields above.
if tab_id:
    receipt["tab_id"] = tab_id
# #768: the task binding is receipt evidence too, next to the pane it landed on.
if task_id:
    receipt["task_id"] = int(task_id) if task_id.isdigit() else task_id
# Protection marker, task 603: present only with --keep, so an ordinary spawn
# receipt stays byte-identical; its readers accept only the JSON literal true.
# Keep this heredoc free of quote characters: bash 3.2 misparses them in a command substitution.
if keep == "1":
    receipt["keep"] = True
# #965: the hub lane this spawn registered. wrk reap removes exactly this lane
# — a spawn without one keeps the receipt byte-identical to before.
if hub_lane:
    receipt["hub_lane"] = hub_lane
    receipt["hub_lane_machine"] = hub_lane_machine
print(json.dumps(receipt, ensure_ascii=False, separators=(",", ":")))
PY
)"; then
    warn "arbiter job.spawned receipt preparation failed; spawn remains successful: job_id=$JOB_ID pane_id=$PANE"
    hub_lane_orphan_remove
    return 0
  fi
  set +e
  "$ARBITER" event --job "$JOB_ID" --kind job.spawned --payload-json "$payload" >/dev/null
  receipt_rc=$?
  set -e
  if [[ "$receipt_rc" -ne 0 ]]; then
    warn "arbiter job.spawned receipt failed (exit $receipt_rc); spawn remains successful: job_id=$JOB_ID pane_id=$PANE"
    hub_lane_orphan_remove
  fi
}

# #994/S1: a lane whose job.spawned receipt was never written is a row
# `wrk reap` can never attribute to a job — it would sit on the daemon
# forever. Deregister it while the machine and pane are still in hand (same
# credentials, same warn-only contract); the spawn still succeeds, and a
# failed removal is left for `panewire lanes-audit`.
hub_lane_orphan_remove() {
  [[ -n "${HUB_LANE:-}" ]] || return 0
  local lane="$HUB_LANE" machine="$HUB_LANE_MACHINE"
  HUB_LANE="" HUB_LANE_MACHINE=""
  warn "hub lane '$lane' was registered but the job.spawned receipt was not written — deregistering it"
  hub_lane_remove "$lane" "$machine" "$PANE"
}

arbiter_admit() {
  if [[ -z "$ARBITER" ]]; then
    ARBITER="$(command -v arbiter 2>/dev/null || true)"
  fi
  if [[ -z "$ARBITER" || ! -e "$ARBITER" ]]; then
    warn "arbiter unavailable; admission control skipped during installation transition"
    return 0
  fi
  if [[ ! -x "$ARBITER" ]]; then
    warn "arbiter quota-pool record unavailable (not executable: $ARBITER); continuing spawn"
    return 0
  fi
  local probe probe_rc job_get_probe job_get_probe_rc
  set +e
  probe="$("$ARBITER" lease --help 2>&1)"
  probe_rc=$?
  set -e
  if [[ "$probe_rc" -ne 0 ]]; then
    if grep -Eiq "(unknown (command|subcommand).*lease|invalid choice.*lease|no such command.*lease|unrecognized.*lease|not a valid command.*lease)" <<<"$probe"; then
      warn "installed arbiter has no lease subcommand; admission control skipped during installation transition"
      return 0
    fi
    warn "arbiter quota-pool record probe failed (exit $probe_rc); continuing spawn"
    return 0
  fi
  # An arbiter predating the durable lookup is an installation-transition
  # version. Preserve the existing warn+continue contract rather than treating
  # it as a current arbiter that reported an uninspectable duplicate.
  set +e
  job_get_probe="$("$ARBITER" job-get --help 2>&1)"
  job_get_probe_rc=$?
  set -e
  if [[ "$job_get_probe_rc" -ne 0 ]]; then
    if grep -Eiq "(unknown (command|subcommand).*job-get|invalid choice.*job-get|no such command.*job-get|unrecognized.*job-get|not a valid command.*job-get)" <<<"$job_get_probe"; then
      warn "installed arbiter has no job-get subcommand; admission control skipped during installation transition"
      return 0
    fi
    # Keep the pre-existing no-duplicate path observational, but do not skip
    # claim: if this live arbiter subsequently reports a duplicate, the actual
    # lookup failure below must remain fail-closed.
    warn "arbiter job-get probe failed (exit $job_get_probe_rc); duplicate state will fail-closed if observed"
  fi
  # #768: an arbiter predating claim --task-id must not fail the claim on an
  # unknown flag — same installation-transition carve-out as the probes above.
  # The job meta then lacks task_id; the hk link itself is unaffected.
  if [[ "${#ARBITER_CLAIM_TASK_ARGS[@]}" -gt 0 ]]; then
    local claim_probe claim_probe_rc
    set +e
    claim_probe="$("$ARBITER" claim --help 2>&1)"
    claim_probe_rc=$?
    set -e
    if [[ "$claim_probe_rc" -ne 0 ]] || ! grep -q -- "--task-id" <<<"$claim_probe"; then
      warn "installed arbiter lacks claim --task-id; job meta will not record task_id (installation transition)"
      ARBITER_CLAIM_TASK_ARGS=()
    fi
  fi

  if [[ "$GATE_READY" -ne 1 ]]; then
    # No scopefuel result means no authoritative pool. Leasing a guessed pool would
    # be worse than not leasing — the same installation-transition exception applies.
    warn "scopefuel gate did not run; arbiter quota-pool record skipped during installation transition"
    return 0
  fi

  local claim_rc duplicate_rc
  set +e
  "$ARBITER" claim --job "$JOB_ID" --agent-label "$LABEL" --lane "$JOB_LANE" --t "$JOB_T" "${ARBITER_CLAIM_ROLE_ARGS[@]}" ${ARBITER_CLAIM_TASK_ARGS[@]+"${ARBITER_CLAIM_TASK_ARGS[@]}"} >/dev/null
  claim_rc=$?
  set -e
  case "$claim_rc" in
    0) ARBITER_JOB_REGISTERED=1 ;;
    4)
      set +e
      arbiter_handle_duplicate_claim
      duplicate_rc=$?
      set -e
      [[ "$duplicate_rc" -eq 0 ]] || return "$duplicate_rc"
      ;;
    *) warn "arbiter quota-pool claim failed (exit $claim_rc); continuing spawn"; ARBITER_CLAIM_FAILED=1; return 0 ;;
  esac

  local gate_file gate_rc record_json record_rc parsed rc
  set +e
  gate_file="$(mktemp)"
  gate_rc=$?
  set -e
  if [[ "$gate_rc" -ne 0 || -z "$gate_file" ]]; then
    warn "arbiter quota-pool record preparation failed (temporary file); continuing spawn"
    return 0
  fi
  if ! printf '%s\n' "$GATE_OUTPUT" >"$gate_file"; then
    rm -f "$gate_file" || true
    warn "arbiter quota-pool record preparation failed (gate output); continuing spawn"
    return 0
  fi
  set +e
  # ROB-1213: --profile stays the gate-normalized name — arbiter cross-checks it
  # against the gate output (fail-closed, keep). The *actual* launch goes in
  # --launch-profile: GATE_PROFILE collapses effort variants (codex-luna|-hi|-max
  # all gate as codex-luna-max), and recording only that made the ledger lie —
  # 2026-08-04: T3 jobs ran gpt-5.6-luna at *medium* (B, 42) while every record
  # claimed codex-luna-max (A+, 59). Only `ps` told the truth; finished jobs
  # became unauditable.
  #
  # task #677: the launch name is the canonical catalog profile, not the launcher
  # spelling. codex-sol/codex-max/codex/builder-sol/captain-sol all run gpt-6.1-sol
  # — the catalog profile is codex-sol (scopefuel PROFILE_ALIASES: codex-max ->
  # codex-sol), and scopefuel only knows the canonical name (`policy launch
  # builder-sol` is not in the catalog at all). Recording the raw spelling split
  # reps/usage attribution across names the grade table cannot read (2026-09-25:
  # a builder-sol xhigh spawn recorded launch_profile=builder-sol@xhigh while its
  # pane ran gpt-6-sol xhigh). Scoped to codex-kind profiles: every other pool
  # keeps its literal spelling@effort, so no other pool's records change.
  # Rollback spellings (codex-sol56, codex-sol6, builder-sol6) stay literal by
  # design — pinning the superseded model is the point, and the canon does not
  # carry the spellings' own ids (builder-sol6 records codex-sol@high via its
  # grade consult, but its model id never comes back from the canon).
  local launch_name="$MODEL"
  if [[ -n "${GATE_EFFORT_PIN:-}" ]]; then
    # #704: the E6 rung spellings are measurement aliases — record the canonical
    # rung (opus@low, kimi-k3@max, codex-terra@high) so reps attribute to the
    # profile@effort the gate judged, not a launcher-only name the grade table
    # cannot read (the same failure #677 fixed inside the codex pool).
    launch_name="$GATE_PROFILE"
  elif [[ "$PROFILE_KIND" == codex && -n "$CATALOG_PROFILE" ]]; then
    launch_name="$CATALOG_PROFILE"
  elif [[ "$MODEL" == builder-sonnet ]]; then
    # #921: the Sonnet 5.5 builder seat records the canonical catalog rung
    # (sonnet@<effort>) so E1/E2 reps attribute to the gated profile — the
    # same failure shape #677 fixed, applied to the claude pool.
    launch_name="$CATALOG_PROFILE"
  fi
  local launch_profile="$launch_name${EFFECTIVE_EFFORT:+@$EFFECTIVE_EFFORT}"
  record_json="$(SCOPEFUEL_BIN="$SCOPEFUEL" "$ARBITER" lease --job "$JOB_ID" --kind quota_pool \
    --profile "$GATE_PROFILE" --launch-profile "$launch_profile" --gate-output "$gate_file" --json)"
  record_rc=$?
  set -e
  rm -f "$gate_file" || true
  if [[ "$record_rc" -ne 0 ]]; then
    warn "arbiter quota-pool record failed (exit $record_rc); continuing spawn"
    return 0
  fi
  set +e
  parsed="$(printf '%s' "$record_json" |
    python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["pool"]); print(d["profile"]); print(d["started_at"])')"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    warn "arbiter quota-pool record output unreadable; continuing spawn"
    return 0
  fi
  {
    IFS= read -r ARBITER_RESOURCE
    IFS= read -r ARBITER_PROFILE
    IFS= read -r ARBITER_STARTED_AT
  } <<<"$parsed"
  if [[ -z "$ARBITER_RESOURCE" || -z "$ARBITER_PROFILE" || -z "$ARBITER_STARTED_AT" ]]; then
    warn "arbiter quota-pool record returned incomplete fields; continuing spawn"
    return 0
  fi
  ARBITER_HELD=1
  trap 'spawn_pane_cleanup; arbiter_release_held' EXIT
  # task #677: show the launch name next to the gate-normalized profile — the
  # observed line said profile=codex-max while the pane ran gpt-6-sol (the
  # family now runs gpt-6.1-sol, #1026), and the launch identity was only in
  # the event payload.
  echo "wrk: arbiter quota-pool record pool=$ARBITER_RESOURCE profile=$ARBITER_PROFILE launch_profile=$launch_profile job=$JOB_ID" >&2
}

# ROB-1227: a successful spawn is a quota-use event. The pool is already
# authoritative in arbiter's record, or in the scopefuel gate output when
# arbiter is unavailable; wrk deliberately owns no provider mapping.
refresh_quota_pool() {
  local pool="${ARBITER_RESOURCE:-}"
  if [[ -z "$pool" && "${GATE_READY:-0}" -eq 1 ]]; then
    pool="${GATE_OUTPUT#* pool=}"
    pool="${pool%% *}"
  fi
  if [[ -z "$pool" ]]; then
    warn "scopefuel refresh skipped; gate/arbiter did not provide a pool"
    return 0
  fi
  if [[ -z "${SCOPEFUEL:-}" || ! -x "$SCOPEFUEL" ]]; then
    warn "scopefuel refresh skipped; executable unavailable"
    return 0
  fi

  # The CLI's --background contract is itself non-blocking. Start a tiny
  # supervisor detached from wrk; it owns both the refresh child and timeout
  # cleanup in one dedicated process group. Its stderr stays attached so a
  # refresh failure/timeout is user-visible while spawn remains fail-open
  # (the attachment is bounded — callers capturing output wait at most
  # WRK_REFRESH_TIMEOUT_S for the supervisor). #770 gives it a bounded,
  # traceable lifetime: pid/pool/deadline/start in JOB/quota-refresh.pid,
  # the pidfile removed on the way out, and `wrk prune` can recognise a
  # leftover (verified by start time before signalling, so a reused pid is
  # never killed).
  local refresh_pidfile=""
  if [[ -n "${JOB_ID:-}" ]]; then
    refresh_pidfile="$(wrk_jobs_root)/$JOB_ID/quota-refresh.pid"
    mkdir -p "$(dirname "$refresh_pidfile")" 2>/dev/null || refresh_pidfile=""
  fi
  (
    python3 - "$SCOPEFUEL" "$pool" "${WRK_REFRESH_TIMEOUT_S:-5}" "$refresh_pidfile" "${JOB_ID:-}" <<'PY'
import os
import signal
import subprocess
import sys
import time


if os.fork():
    os._exit(0)
os.setsid()
scopefuel, pool, timeout_arg, pidfile, job = sys.argv[1:]
try:
    timeout = max(0.01, float(timeout_arg))
except ValueError:
    timeout = 5.0

if pidfile:
    try:
        with open(pidfile, "w", encoding="utf-8") as handle:
            handle.write("pid=%d pool=%s job=%s timeout=%s deadline=%d started=%d\n" % (
                os.getpid(), pool, job, timeout_arg,
                int(time.time() + timeout), int(time.time())))
    except OSError:
        pidfile = ""


def drop_pidfile():
    if pidfile:
        try:
            os.unlink(pidfile)
        except OSError:
            pass


proc = subprocess.Popen(
    [scopefuel, "refresh", pool, "--background"],
    stdin=subprocess.DEVNULL,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
    close_fds=True,
    # The refresh child gets its own process group so the timeout path can
    # kill the whole tree without the supervisor SIGKILLing itself mid-
    # cleanup (a group kill of its own pgid never reaches drop_pidfile).
    start_new_session=True,
)


def _term(_sig, _frame):
    # wrk prune --apply signals the supervisor's group; cascade to the
    # refresh child's group before going down so no refresh outlives us.
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except OSError:
        pass
    drop_pidfile()
    os._exit(143)


signal.signal(signal.SIGTERM, _term)
signal.signal(signal.SIGINT, _term)

try:
    refresh_rc = proc.wait(timeout=timeout)
except subprocess.TimeoutExpired:
    print(
        f"wrk: warning: scopefuel refresh timed out for pool={pool}; spawn already succeeded",
        file=sys.stderr,
        flush=True,
    )
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except OSError:
        pass
    time.sleep(0.2)
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except OSError:
        pass
    proc.wait()
    drop_pidfile()
    os._exit(124)

drop_pidfile()
if refresh_rc != 0:
    print(
        f"wrk: warning: scopefuel refresh failed for pool={pool}; spawn already succeeded",
        file=sys.stderr,
    )
PY
  ) </dev/null >/dev/null &
}

# resolve_catalog_profile
#
# Maps a launcher spelling to its canonical catalog profile, and to the effort
# rung the spelling pins (empty = take the catalog's default rung). A spelling
# left out of this table keeps its literal model id and effort — that is the
# fail-safe direction, and it is where the deliberate exceptions live:
#
#   * rollback spellings (codex-sol56, codex-luna56, codex-sol6, grok45*,
#     grok46*, agy-flash36) exist precisely to pin a superseded model. An
#     explicit pin outranks the canon, or the rollback lever does nothing.
#   * builder-sol6 is the one split case: it stays in this table because the
#     builder seat still needs the codex-sol@high grade consult (the canon's
#     effort and the quota record's codex-sol@high launch_profile), but
#     CATALOG_KEEP_MODEL keeps its model id literal so the consult can never
#     hand back gpt-6.1-sol.
#   * profiles the catalog does not carry (oc-*, kimi-*, devin-*, the ungraded
#     kiro-* experiments, cc-dsflash/cc-dspro/cc-glm53) keep their literal argv.
#   * profiles whose CLI argument is not the model id (agy encodes the effort
#     into the model name; opus/sonnet/haiku pass a CLI alias) take only the
#     effort from the catalog — the alias itself is argv skeleton and stays here.
#
# The GATE_PROFILE table above is a different mapping and must not be reused:
# kiro-glm gates as kiro-sol but must never launch Sol's model id.
resolve_catalog_profile() {
  case "$MODEL" in
    opus|builder-opus|captain-opus) CATALOG_PROFILE=opus ;;
    sonnet|sonnet-med) CATALOG_PROFILE=sonnet ;;
    # #704 (#594 E6): the per-rung builder spellings consult the catalog at the
    # rung they pin — the suffix is the rung by construction.
    builder-opus-low|builder-opus-medium) CATALOG_PROFILE=opus; CATALOG_EFFORT_PIN="${MODEL##*-}" ;;
    builder-sonnet-xhigh|builder-sonnet-max) CATALOG_PROFILE=sonnet; CATALOG_EFFORT_PIN="${MODEL##*-}" ;;
    # #921: the non-rung Sonnet builder consults the canon at the rung it will
    # actually take — an unpinned consult answers sonnet's own high default and
    # apply_catalog would silently overwrite this profile's xhigh default.
    builder-sonnet) CATALOG_PROFILE=sonnet; CATALOG_EFFORT_PIN="${EFFORT:-xhigh}" ;;
    haiku) CATALOG_PROFILE=haiku ;;
    fable) CATALOG_PROFILE=fable ;;

    codex) CATALOG_PROFILE=codex-sol; CATALOG_EFFORT_PIN=high ;;
    codex-sol|codex-max) CATALOG_PROFILE=codex-sol ;;
    # 2026-09-26 (decision 4088 B): a builder seat never takes a max rung, so
    # builder-sol consults the catalog at the high rung — the same shape the
    # generic `codex` spelling already uses. The worker spellings above keep
    # the catalog's own default.
    builder-sol|captain-sol) CATALOG_PROFILE=codex-sol; CATALOG_EFFORT_PIN=high ;;
    # #1026: builder-sol6 is builder-sol's rollback spelling — same builder-seat
    # consult (codex-sol@high, so the quota record names the graded rung), but
    # CATALOG_KEEP_MODEL pins the literal gpt-6-sol: the consult feeds effort
    # and attribution only, never the model id.
    builder-sol6) CATALOG_PROFILE=codex-sol; CATALOG_EFFORT_PIN=high; CATALOG_KEEP_MODEL=1 ;;
    codex-terra|codex-med) CATALOG_PROFILE=codex-terra; CATALOG_EFFORT_PIN=medium ;;
    codex-terra-max) CATALOG_PROFILE=codex-terra-max ;;
    codex-luna) CATALOG_PROFILE=codex-luna; CATALOG_EFFORT_PIN=medium ;;
    codex-luna-hi) CATALOG_PROFILE=codex-luna; CATALOG_EFFORT_PIN=high ;;
    codex-luna-max) CATALOG_PROFILE=codex-luna-max ;;
    # #633: builder-luna is codex-luna admitted under --role builder at the
    # #594 E3 effort (xhigh) — pinned so the catalog is consulted at the same
    # effort the grade ceiling was rated at.
    builder-luna) CATALOG_PROFILE=codex-luna; CATALOG_EFFORT_PIN=xhigh ;;
    # #704: the E6 codex rungs resolve against the canonical catalog profile at
    # their pinned effort, so the quota record's launch_profile is the exact
    # catalog rung (codex-terra@high, codex-luna@max, codex-sol@high ...).
    # #737 adds builder-sol-medium (codex-sol@medium) on the same pin rule.
    builder-sol-high|builder-sol-max|builder-sol-medium) CATALOG_PROFILE=codex-sol; CATALOG_EFFORT_PIN="${MODEL##*-}" ;;
    builder-luna-max) CATALOG_PROFILE=codex-luna; CATALOG_EFFORT_PIN=max ;;
    builder-terra-high|builder-terra-xhigh|builder-terra-max) CATALOG_PROFILE=codex-terra; CATALOG_EFFORT_PIN="${MODEL##*-}" ;;
    codex-astra) CATALOG_PROFILE=codex-astra ;;

    kiro-opus) CATALOG_PROFILE=kiro-opus ;;
    kiro-opus-xhigh) CATALOG_PROFILE=kiro-opus; CATALOG_EFFORT_PIN=xhigh ;;
    kiro-opus-max) CATALOG_PROFILE=kiro-opus; CATALOG_EFFORT_PIN=max ;;
    kiro-sonnet) CATALOG_PROFILE=kiro-sonnet ;;
    kiro-sol) CATALOG_PROFILE=kiro-sol ;;
    kiro-sol-xhigh) CATALOG_PROFILE=kiro-sol; CATALOG_EFFORT_PIN=xhigh ;;
    kiro-sol-max) CATALOG_PROFILE=kiro-sol; CATALOG_EFFORT_PIN=max ;;
    kiro-cheap) CATALOG_PROFILE=kiro-cheap ;;
    kiro-haiku) CATALOG_PROFILE=kiro-haiku ;;

    grok|grok-hi) CATALOG_PROFILE=grok-hi ;;
    grok-med) CATALOG_PROFILE=grok; CATALOG_EFFORT_PIN=medium ;;
    builder-grok) CATALOG_PROFILE=grok-hi; CATALOG_EFFORT_PIN=xhigh ;;
    # #737 (decision 4088): the E6 grok rungs consult the catalog at their
    # pinned rung so the quota record's launch_profile is grok-hi@<rung>.
    builder-grok-low|builder-grok-medium|builder-grok-xhigh) CATALOG_PROFILE=grok-hi; CATALOG_EFFORT_PIN="${MODEL##*-}" ;;

    cc-qwen38) CATALOG_PROFILE=cc-qwen38 ;;
    cc-glm) CATALOG_PROFILE=cc-glm ;;
  esac
}

# apply_catalog
#
# Replaces this spelling's model id and default effort with the canonical values
# from `scopefuel policy launch`. Every path that does *not* end in a canonical
# answer sets CATALOG_STALE=1, which the spawn brief carries as a
# `wrk-note: catalog=stale` line — including the ones that look like ordinary tolerance
# (scopefuel absent, too old to have the subcommand, request failed). "We could
# not confirm the canon" is one fact, and a launch that quietly used its own
# table while claiming nothing is exactly the silence this change removes.
#
# rc 3 is the one non-zero rc that is not stale: the canon answered and refused
# (consult_only without an operator request). The quota gate below re-runs that
# judgement and is the thing that stops the spawn, so the launcher keeps its
# literal values and does not mislabel a refusal as a missing canon.
apply_catalog() {
  [[ -n "$CATALOG_PROFILE" ]] || return 0

  if [[ -z "${SCOPEFUEL:-}" ]]; then
    SCOPEFUEL="$(command -v "${SCOPEFUEL_BIN:-scopefuel}" 2>/dev/null || true)"
  fi
  if [[ -z "$SCOPEFUEL" || ! -x "$SCOPEFUEL" ]]; then
    CATALOG_STALE=1
    warn "scopefuel unavailable; launch catalog not consulted (catalog=stale)"
    return 0
  fi

  local launch_args=(policy launch "$CATALOG_PROFILE" --json)
  [[ -z "$CATALOG_EFFORT_PIN" ]] || launch_args+=(--effort "$CATALOG_EFFORT_PIN")
  [[ -z "${OPERATOR_REQUEST:-}" ]] || launch_args+=(--operator-request)
  # task #527 + #593: the declared purpose reaches the catalog too, not only the
  # quota gate. A bare `-m codex-astra` is the architect counsel path (PURPOSE is
  # defaulted to architect above), the gate admits it, and the catalog marks astra
  # consult_only — without forwarding this, the two restrictions became cumulative
  # and an approved invocation died between them. Forwarded verbatim: which
  # purposes count is scopefuel's judgement, not wrk's, and it applies the rule to
  # astra only.
  [[ -z "${PURPOSE:-}" ]] || launch_args+=(--purpose "$PURPOSE")

  # Keep stderr: rc 3 has several distinct reasons (consult_only, a retired rung,
  # an unknown profile, a gate a stale catalog may not widen) and only scopefuel
  # knows which one applies. Discarding it and hard-coding one remedy sent the
  # operator after --operator-request for refusals that flag cannot fix.
  local out err_file rc=0
  err_file="$(mktemp "${TMPDIR:-/tmp}/wrk-policy-launch.XXXXXX")" || err_file=""
  set +e
  if [[ -n "$err_file" ]]; then
    out="$("$SCOPEFUEL" "${launch_args[@]}" 2>"$err_file")"
  else
    out="$("$SCOPEFUEL" "${launch_args[@]}" 2>/dev/null)"
  fi
  rc=$?
  set -e
  CATALOG_REFUSE_REASON=""
  if [[ -n "$err_file" ]]; then
    # #1045 (scopefuel #1024): a broken config prints a ~190-char
    # "scopefuel: warning:" line ahead of the refusal, and squeezing all of
    # stderr kept the warning while cutting the actual reason away. The
    # warnings are the operator's config signal, not the refusal's — stderr is
    # captured here, so re-emit them verbatim or the operator never sees the
    # broken config at all — and build the reason from the remaining lines,
    # falling back to the last non-empty line so an all-warning stderr still
    # reports something. The 240-char cap is unchanged.
    grep '^scopefuel: warning:' "$err_file" >&2 || true
    CATALOG_REFUSE_REASON="$(grep -v '^scopefuel: warning:' "$err_file" | tr -s '[:space:]' ' ' | cut -c1-240 || true)"
    if [[ -z "$CATALOG_REFUSE_REASON" ]]; then
      CATALOG_REFUSE_REASON="$(grep . "$err_file" | tail -n 1 | tr -s '[:space:]' ' ' | cut -c1-240 || true)"
    fi
    rm -f "$err_file"
  fi

  if [[ "$rc" -eq 3 ]]; then
    # The canon answered and refused. Recorded, not acted on yet — the quota gate
    # runs first because its refusal carries alternatives ("대안(S+): …") that
    # this one cannot. If the gate lets the spawn through, the refusal below
    # stops it: the gate judges quota and escalation, not catalog gates, so a
    # permissive gate must not launch what the canon declined.
    CATALOG_REFUSED=1
    return 0
  fi
  if [[ "$rc" -ne 0 || -z "$out" ]]; then
    CATALOG_STALE=1
    warn "scopefuel policy launch failed (rc=$rc); using the launcher's own values (catalog=stale)"
    return 0
  fi

  local parsed
  if ! parsed="$(printf '%s' "$out" | python3 -c '
import json, sys

try:
    payload = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
catalog = payload.get("catalog")
if not isinstance(catalog, dict) or "stale" not in catalog:
    # No provenance block means the answer cannot be shown to have come from the
    # canon — an old build, a proxy, a truncated write. Treat it exactly like an
    # unreachable catalog rather than trusting the values it did send.
    sys.exit(1)
# One field per line, not a tab-joined record: tab is IFS whitespace, so bash
# collapses a leading empty field and every later field shifts up by one. An
# empty model_id is normal (sonnet/haiku launch by CLI alias), and the shift
# silently turned the effort into the catalog source.
print("\n".join([
    str(payload.get("model_id") or ""),
    str(payload.get("effort") or ""),
    str(catalog.get("source") or ""),
    "1" if catalog.get("stale") else "0",
]))
' 2>/dev/null)"; then
    CATALOG_STALE=1
    warn "scopefuel policy launch returned unreadable JSON; using the launcher's own values (catalog=stale)"
    return 0
  fi

  local model_id effort _source stale
  { read -r model_id; read -r effort; read -r _source; read -r stale; } <<<"$parsed"
  [[ "$stale" != "1" ]] || CATALOG_STALE=1

  # Only the kinds whose CLI argument *is* the model id consume it. For the
  # Claude CLI the argument is an alias ("--model opus"), which stays argv
  # skeleton; fable is the one Claude profile launched by literal model id.
  # #1026: CATALOG_KEEP_MODEL skips this consumption entirely — builder-sol6
  # consults the canon for effort/attribution but pins its literal model id.
  if [[ -n "$model_id" && -z "${CATALOG_KEEP_MODEL:-}" ]]; then
    case "$PROFILE_KIND" in
      codex|kiro) PROFILE_MODEL="$model_id" ;;
      grok) PROFILE_MODEL_ARG="$model_id" ;;
      claude)
        [[ "$MODEL" != fable ]] || ARGS=(--model "$model_id" --dangerously-skip-permissions) ;;
    esac
  fi
  [[ -z "$effort" || "$EFFORT_SUPPORTED" -ne 1 ]] || DEFAULT_EFFORT="$effort"
}

resolve_profile() {
  PROFILE_KIND=""
  PROFILE_MODEL=""
  DEFAULT_EFFORT=""
  EFFORT_SUPPORTED=0
  ARGS=()
  PROFILE_ENV=()
  KIMI_TRUST_HOME=""
  PROFILE_MODEL_ARG=""
  CATALOG_PROFILE=""
  CATALOG_EFFORT_PIN=""
  CATALOG_KEEP_MODEL=""
  CATALOG_STALE=0
  CATALOG_REFUSED=0
  CATALOG_REFUSE_REASON=""
  GATE_EFFORT_PIN=""

  case "$MODEL" in
    # ROB-1191 ⑥: opus/sonnet only — CLI --effort argv (never mutate settings.json).
    # Defaults align with scopefuel Profile.benchmark_effort (opus=high, sonnet=high).
    opus) PROFILE_KIND=claude; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1; ARGS=(--model opus --dangerously-skip-permissions) ;;
    builder-opus|captain-opus) PROFILE_KIND=claude; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1; ARGS=(--model opus --dangerously-skip-permissions) ;;
    # #704 (#594 E6): per-rung builder spellings — the name's last segment IS
    # the pinned rung, and spawn refuses both an off-rung --effort and a
    # missing/mismatched SCOPEFUEL_E6_ARM=<gate profile>@<rung> marker (the
    # marker is the only channel that tells the gate which rung to judge).
    builder-opus-low|builder-opus-medium) PROFILE_KIND=claude; DEFAULT_EFFORT="${MODEL##*-}"; EFFORT_SUPPORTED=1; ARGS=(--model opus --dangerously-skip-permissions) ;;
    builder-sonnet-xhigh|builder-sonnet-max) PROFILE_KIND=claude; DEFAULT_EFFORT="${MODEL##*-}"; EFFORT_SUPPORTED=1; ARGS=(--model sonnet --dangerously-skip-permissions) ;;
    # #921: Sonnet 5.5 builder seat — the builder-opus argv shape on the sonnet
    # alias. The closed effort set (high|xhigh|max) is enforced in the --role
    # builder arm below; default xhigh (E1 rung).
    builder-sonnet) PROFILE_KIND=claude; DEFAULT_EFFORT=xhigh; EFFORT_SUPPORTED=1; ARGS=(--model sonnet --dangerously-skip-permissions) ;;
    sonnet|sonnet-med) PROFILE_KIND=claude; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1; ARGS=(--model sonnet --dangerously-skip-permissions) ;;
    haiku) PROFILE_KIND=claude; DEFAULT_EFFORT=low; EFFORT_SUPPORTED=1; ARGS=(--model haiku --dangerously-skip-permissions) ;;
    fable) PROFILE_KIND=claude; ARGS=(--model claude-fable-5-1 --dangerously-skip-permissions) ;;
    # Devin profile. Herdr owns detection through --kind devin;
    # keep its launch argv exact and do not add a prompt or effort flag.
    # Unattended pane: accept-edits prompts on every shell command and stalls (task201).
    # Task 240 pilot: builder-devin is the same profile admitted under
    # --role builder (operator decision 2026-09-14 §3) — identical argv.
    devin-swe2|builder-devin) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model swe-2 --permission-mode dangerous --respect-workspace-trust false) ;;
    # Operator decision 2026-09-14 (devin-pro-paid-models): three more Devin
    # model profiles — identical unattended argv, only the --model name
    # differs. glm-5-2 and swe-1-7 are free-pool; deepseek-v4-1-flash-high is
    # the only paid spelling ($0.22/1M in). High-priced Devin models
    # (Opus/Fable/Astra/Sonnet/Kimi) are deliberately not listed — they would
    # duplicate the claude/codex subscription spend.
    devin-glm52) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model glm-5-2 --permission-mode dangerous --respect-workspace-trust false) ;;
    devin-swe17) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model swe-1-7 --permission-mode dangerous --respect-workspace-trust false) ;;
    # #666: builder-ds41 admits the paid ds41 rung under --role builder with
    # the identical argv (the operator's ds41-builder policy); the devin-ds41
    # worker spelling itself stays worker-only there.
    devin-ds41|builder-ds41) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model deepseek-v4-1-flash-high --permission-mode dangerous --respect-workspace-trust false) ;;
    # Task #635: devin effort lives inside the model id — there is no --effort
    # flag — so each rung is a named profile on the same unattended argv.
    # devin-swe2 stays the high default; swe-2-medium/max are the free rungs,
    # ds41-max the paid max rung. The swe-2 effort spellings are also admitted
    # under --role builder (that is the builder-devin effort path), and #666
    # adds the named builder spellings builder-devin-medium/-max and
    # builder-ds41-max — same argv as the worker variants.
    devin-swe2-medium|builder-devin-medium) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model swe-2-medium --permission-mode dangerous --respect-workspace-trust false) ;;
    devin-swe2-max|builder-devin-max) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model swe-2-max --permission-mode dangerous --respect-workspace-trust false) ;;
    devin-ds41-max|builder-ds41-max) PROFILE_KIND=devin; EFFORT_SUPPORTED=0; ARGS=(--model deepseek-v4-1-flash-max --permission-mode dangerous --respect-workspace-trust false) ;;

    # cc-qwen38/cc-glm/cc-dsflash/cc-dspro/cc-glm53: Claude Code CLI harness,
    # model traffic redirected via env to CLIProxyAPI(127.0.0.1:8317) -> ClinePass.
    # See CLINEPASS_GATE_* comment above for the wiring rationale (ROB-1252/ROB-1253).
    #
    # 실험 지정 별칭 — reps 축적 전까지 급표 미등재. cc-dspro=V4-Pro 0813(TB 87.9·AA int max 53.2,
    # 단 TB 는 벤더 자체보고), cc-glm53=GLM-5.3(TB 88.2 벤더 자체보고, GLM-5.2 베이스 상방 후보).
    # cc-dsflash=oc-dsflash 의 하네스 A/B 짝.
    cc-qwen38|cc-glm|cc-dsflash|cc-dspro|cc-glm53)
      PROFILE_KIND=claude; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1
      [[ -r "$CLINEPASS_GATE_KEY_FILE" ]] || die "clinepass gate key file not found/readable: $CLINEPASS_GATE_KEY_FILE"
      CLINEPASS_GATE_KEY="$(<"$CLINEPASS_GATE_KEY_FILE")"
      CLINEPASS_GATE_KEY="${CLINEPASS_GATE_KEY//$'\n'/}"
      [[ -n "$CLINEPASS_GATE_KEY" ]] || die "clinepass gate key file is empty: $CLINEPASS_GATE_KEY_FILE"
      ARGS=(--model "$MODEL" --dangerously-skip-permissions)
      # Claude Code 는 이 별칭들을 모르는 모델로 보고 컨텍스트 창을 200k 로 가정한다
      # (경고: "not a model this version of Claude Code recognizes"). 1M 짜리 모델이면
      # 200k 에서 auto-compact 가 돌아 창의 80% 를 버린다.
      #
      # 🔴 값은 **프로필별**로 둔다 — 일괄 1M 금지(ROB-1254 정정). 근거 등급이 다르다:
      #   - models.dev 에 **cline-pass 전용 항목**이 있는 3종만 확정값을 준다:
      #     cline-pass/{deepseek-v4-flash,deepseek-v4-pro,glm-5.2} = 1,000,000.
      #   - qwen3.8-max·glm-5.3 은 cline-pass 항목이 **없다**. 타 제공자 값은 서로 어긋나고
      #     (alibaba 1,000,000 / nano-gpt·aihubmix 991,000 / digitalocean 262,144),
      #     ClinePass 는 qwen 을 자체 배포본 `private/qwen3p8-max-wave` 로 서빙하므로
      #     원 제공자의 창이 그대로일 보장이 없다 → **미설정(Claude Code 기본 200k)**.
      # 🔴 비대칭: 과소가정은 조기 compact 뿐이지만 **과대가정은 작업 중 API 에러**다.
      # 해제 조건: models.dev 에 cline-pass 항목이 생기거나 실측 이분탐색으로 하한 확인.
      # (2026-08-15 초과 프로브로 확인된 별개 한도: `private/*-wave` 배포본은 요청 본문
      #  **6,291,456 바이트** 상한, max_tokens 상한은 5종 모두 131,072.)
      CC_CONTEXT_TOKENS=""
      case "$MODEL" in
        cc-dsflash|cc-dspro|cc-glm) CC_CONTEXT_TOKENS=1000000 ;;
      esac
      PROFILE_ENV=(
        --env "ANTHROPIC_BASE_URL=$CLINEPASS_GATE_URL"
        --env "ANTHROPIC_AUTH_TOKEN=$CLINEPASS_GATE_KEY"
      )
      if [[ -n "$CC_CONTEXT_TOKENS" ]]; then
        PROFILE_ENV+=(--env "CLAUDE_CODE_MAX_CONTEXT_TOKENS=$CC_CONTEXT_TOKENS")
      fi
      ;;

    codex-terra|codex-med) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-terra; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    codex-terra-max) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-terra; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    codex-luna) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6-luna; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    codex-luna-hi) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6-luna; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    codex-luna-max) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6-luna; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    codex) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6.1-sol; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    codex-sol) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6.1-sol; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    codex-max) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6.1-sol; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    # 2026-09-26 (decision 4088 B): builder seats never take a max rung — the
    # builder-sol default drops to high, and the catalog pin in
    # resolve_catalog_profile consults the same rung when the canon answers.
    builder-sol|captain-sol) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6.1-sol; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    # task #633 (#594 E3): builder-luna is codex-luna under --role builder at
    # xhigh. The literal is the catalog-unreachable fallback; #593 wiring lets
    # `policy launch` replace both fields.
    builder-luna) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6-luna; DEFAULT_EFFORT=xhigh; EFFORT_SUPPORTED=1 ;;
    # #704 (#594 E6): per-rung codex builder spellings. PROFILE_MODEL is the
    # catalog-unreachable literal; apply_catalog replaces it with the canon's
    # model id for that rung (codex-terra@high etc.).
    builder-sol-high|builder-sol-max|builder-sol-medium) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6.1-sol; DEFAULT_EFFORT="${MODEL##*-}"; EFFORT_SUPPORTED=1 ;;
    builder-luna-max) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6-luna; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    builder-terra-high|builder-terra-xhigh|builder-terra-max) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-terra; DEFAULT_EFFORT="${MODEL##*-}"; EFFORT_SUPPORTED=1 ;;
    # task #527 요건 ⑦: codex-astra default effort is xhigh, unified with
    # ARCHITECT.md's spawn command and the consult-advisor SKILL.md note
    # (hk:doc note/2026-09-22/task527-astra-effort-alignment).
    # task #593: the literal below is the fallback only — the rung is owned by the
    # catalog (resolve_catalog_profile maps codex-astra with no pin), so this line
    # is what runs when the canon is out of reach. Both agree on xhigh.
    codex-astra) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6-astra; DEFAULT_EFFORT=xhigh; EFFORT_SUPPORTED=1 ;;
    # ROB-591 rollback spellings: explicit opt-out back to the pre-refresh gpt-5.6-*
    # IDs, same case-block style as grok46 below. codex-sol56/codex-luna56 keep the
    # same efforts as their current default spellings.
    codex-sol56) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-sol; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    codex-luna56) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-luna; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    # #1026 (2026-09-30 operator decision): the codex-sol family moved to
    # gpt-6.1-sol; these are the gpt-6-sol rollback spellings, same ROB-591
    # pattern as codex-sol56 above — the literal pin outranks the canon.
    # codex-sol6 keeps codex-sol's default effort (max) and never consults the
    # catalog; builder-sol6 is the builder-seat shape (high): it still gets the
    # codex-sol@high grade consult via resolve_catalog_profile, but
    # CATALOG_KEEP_MODEL keeps this literal model id.
    codex-sol6) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6-sol; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    builder-sol6) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6-sol; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    # builder-astra/captain-astra removed (task #526): astra is limited to
    # director judgment, architect counsel and operator-requested advice, so the
    # builder spellings have no legal role left.
    builder-astra|captain-astra)
      die "profile '$MODEL' was removed: astra is limited to director judgment, architect counsel and operator-requested advice (hk:doc decision/2026-09-21/astra-allowed-purposes-approved); use codex-astra" ;;

    kiro) PROFILE_KIND=kiro; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    kiro-opus) PROFILE_KIND=kiro; PROFILE_MODEL=claude-opus-5; DEFAULT_EFFORT=xhigh; EFFORT_SUPPORTED=1 ;;
    kiro-sonnet) PROFILE_KIND=kiro; PROFILE_MODEL=claude-sonnet-5; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    kiro-sol) PROFILE_KIND=kiro; PROFILE_MODEL=gpt-5.6-sol; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    kiro-luna) PROFILE_KIND=kiro; PROFILE_MODEL=gpt-5.6-luna; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    kiro-cheap) PROFILE_KIND=kiro; PROFILE_MODEL=qwen3-coder-next; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    kiro-glm) PROFILE_KIND=kiro; PROFILE_MODEL=glm-5; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    kiro-deepseek) PROFILE_KIND=kiro; PROFILE_MODEL=deepseek-v3.2; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    kiro-minimax) PROFILE_KIND=kiro; PROFILE_MODEL=minimax-m2.5; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    kiro-minimax21) PROFILE_KIND=kiro; PROFILE_MODEL=minimax-m2.1; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    kiro-haiku) PROFILE_KIND=kiro; PROFILE_MODEL=claude-haiku-4.5; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    kiro-opus-xhigh) PROFILE_KIND=kiro; PROFILE_MODEL=claude-opus-5; DEFAULT_EFFORT=xhigh; EFFORT_SUPPORTED=1 ;;
    kiro-opus-max) PROFILE_KIND=kiro; PROFILE_MODEL=claude-opus-5; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    kiro-sol-xhigh) PROFILE_KIND=kiro; PROFILE_MODEL=gpt-5.6-sol; DEFAULT_EFFORT=xhigh; EFFORT_SUPPORTED=1 ;;
    kiro-sol-max) PROFILE_KIND=kiro; PROFILE_MODEL=gpt-5.6-sol; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;

    # EFFORT_SUPPORTED=0 for every kimi-* profile: the kimi CLI takes no --effort
    # argv. Thinking effort is config-file-only ([thinking] effort in config.toml,
    # see bin/kimi-clone-home) — do not confuse this with the codex/Kiro/Claude
    # CLI --effort wiring above (ROB-1213 covered those; kimi is a different path).
    # Task 240 pilot: builder-kimi is kimi-k3 admitted under --role builder
    # (operator decision 2026-09-14 §5) — identical argv, still no --effort.
    kimi-k3|builder-kimi) PROFILE_KIND=kimi; KIMI_TRUST_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"; EFFORT_SUPPORTED=0; ARGS=(--auto -m kimi-code/k3) ;;
    kimi-k27|kimi-k27-code) PROFILE_KIND=kimi; KIMI_TRUST_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"; EFFORT_SUPPORTED=0; ARGS=(--auto -m kimi-code/kimi-for-coding) ;;
    # #704 (#594 E6): the kimi E6 rungs follow the kimi-k3-low pattern — same
    # argv, differentiator is the pinned clone home (bin/kimi-clone-home
    # --effort high|max writes [thinking] effort = "<rung>"). The name's last
    # segment is the rung; spawn verifies the clone config matches before
    # admitting (no silent fallback).
    builder-kimi-high)
      PROFILE_KIND=kimi; KIMI_TRUST_HOME="$KIMI_CODE_HIGH_HOME"; EFFORT_SUPPORTED=0; ARGS=(--auto -m kimi-code/k3); DEFAULT_EFFORT=high
      PROFILE_ENV=(--env "KIMI_CODE_HOME=$KIMI_CODE_HIGH_HOME") ;;
    builder-kimi-max)
      PROFILE_KIND=kimi; KIMI_TRUST_HOME="$KIMI_CODE_MAX_HOME"; EFFORT_SUPPORTED=0; ARGS=(--auto -m kimi-code/k3); DEFAULT_EFFORT=max
      PROFILE_ENV=(--env "KIMI_CODE_HOME=$KIMI_CODE_MAX_HOME") ;;
    # kimi-k3-low: same model argv as kimi-k3 — the differentiator is KIMI_CODE_HOME
    # (below), pointed at the low-thinking-effort clone home, not the CLI model arg.
    kimi-k3-low)
      PROFILE_KIND=kimi; KIMI_TRUST_HOME="$KIMI_CODE_LOW_HOME"; EFFORT_SUPPORTED=0; ARGS=(--auto -m kimi-code/k3)
      PROFILE_ENV=(--env "KIMI_CODE_HOME=$KIMI_CODE_LOW_HOME") ;;

    oc-kimi-code) PROFILE_KIND=opencode; ARGS=(--auto --model cline-pass/cline-pass/kimi-k2.7-code) ;;
    oc-glm) PROFILE_KIND=opencode; ARGS=(--auto --model cline-pass/cline-pass/glm-5.2) ;;
    oc-kimi-k3) PROFILE_KIND=opencode; ARGS=(--auto --model cline-pass/cline-pass/kimi-k3) ;;
    oc-dsflash) PROFILE_KIND=opencode; ARGS=(--auto --model cline-pass/cline-pass/deepseek-v4-flash) ;;
    oc-gflash) PROFILE_KIND=opencode; ARGS=(--auto --model cliproxy/gemini-3.6-flash-high) ;;
    oc-sonnet46) PROFILE_KIND=opencode; ARGS=(--auto --model cliproxy/claude-sonnet-4-6) ;;
    oc-oss) PROFILE_KIND=opencode; ARGS=(--auto --model cliproxy/gpt-oss-120b-medium) ;;
    oc-omni) PROFILE_KIND=opencode; ARGS=(--auto --model omniroute/auto/coding) ;;
    # ox-alpha(ROB-1313/1314)는 2026-08-27 무료 프로모 종료와 함께 양 인그레스가 소멸
    # (OpenRouter 목록 제거·Zen 에러 실측). 정체 = GLM-5.3-Flash(Zhipu, 08-26 공개).
    # 별칭은 죽은 pane 양산을 막기 위해 제거 — reps(oc-ox/oc-oxz)는 GLM-5.3-Flash 실적으로
    # 잔존하며, 정식 서빙(ClinePass 등)이 생기면 새 이름으로 재배선한다. 상세=메모리 ox-alpha-lane.
    oc-qwen37-max) PROFILE_KIND=opencode; ARGS=(--auto --model cline-pass/cline-pass/qwen3.7-max) ;;
    oc-minimax-m3) PROFILE_KIND=opencode; ARGS=(--auto --model cline-pass/cline-pass/minimax-m3) ;;
    oc-solar4) PROFILE_KIND=opencode; ARGS=(--auto --model upstage/solar-pro4) ;;

    grok|grok-hi) PROFILE_KIND=grok; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    grok-med) PROFILE_KIND=grok; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    # ROB-1244: 성능 비교(무결점 동률 + 벤치 우세 + 하네스 무이상) 후 기본을 4.6 으로 전환.
    # ROB-591: 기본을 4.7 로 재전환 — grok45*/grok46* 는 이제 둘 다 즉시 롤백용 명시 별칭
    # (grok46* 스펠링은 기존 브리프 호환 목적으로 유지).
    grok45) PROFILE_KIND=grok; PROFILE_MODEL_ARG=grok-4.5; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    grok45-med) PROFILE_KIND=grok; PROFILE_MODEL_ARG=grok-4.5; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    grok46) PROFILE_KIND=grok; PROFILE_MODEL_ARG=grok-4.6; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    grok46-med) PROFILE_KIND=grok; PROFILE_MODEL_ARG=grok-4.6; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    # Task 240 pilot (operator decision 2026-09-14 §4): grok 4.6 builder at
    # effort xhigh — the same kind/argv the generic grok wiring emits.
    builder-grok) PROFILE_KIND=grok; DEFAULT_EFFORT=xhigh; EFFORT_SUPPORTED=1 ;;
    # #737 (decision 4088): the E6 grok measurement rungs — the same grok
    # kind/argv the generic wiring emits, each pinned to the rung in its last
    # segment and marker-gated via GATE_EFFORT_PIN below.
    builder-grok-low|builder-grok-medium|builder-grok-xhigh) PROFILE_KIND=grok; DEFAULT_EFFORT="${MODEL##*-}"; EFFORT_SUPPORTED=1 ;;

    # ROB-1222: agy-flash는 은퇴 목록에서 제외 — agy 네이티브로 실행.
    # 멘리: effort는 모델명에 인코딩(-high). --dangerously-skip-permissions 필수.
    # ROB-1251: AA v1.3 실측 57(opencode)로 A+ 배치 완료 — 기본을 3.7로 전환.
    # agy-flash36은 즉시 롤백용 명시 별칭, agy-flash37은 동의어로 유지(이미 3.7).
    agy-flash) PROFILE_KIND=agy; ARGS=(--model gemini-3.7-flash-high --dangerously-skip-permissions) ;;
    agy-flash36) PROFILE_KIND=agy; ARGS=(--model gemini-3.6-flash-high --dangerously-skip-permissions) ;;
    agy-flash37) PROFILE_KIND=agy; ARGS=(--model gemini-3.7-flash-high --dangerously-skip-permissions) ;;

    agy|agy-flash-med|agy-pro|agy-sonnet|agy-opus|agy-oss)
      die "profile '$MODEL' is retired" ;;
    *) die "unknown model profile '$MODEL'; see 'wrk spawn --help'" ;;
  esac

  # GATE_PROFILE is only scopefuel's accepted profile spelling. Pool/class/
  # usage policy remains solely in scopefuel; runtime MODEL and effort stay
  # exactly as requested.
  case "$MODEL" in
    opus|builder-opus|captain-opus) GATE_PROFILE=opus ;;
    sonnet|sonnet-med|builder-sonnet) GATE_PROFILE=sonnet ;;
    # #704: E6 rungs gate at their own rung (GATE_EFFORT_PIN) — quota_gate
    # forwards it as `scopefuel gate --effort`, and spawn enforces
    # SCOPEFUEL_E6_ARM naming exactly GATE_PROFILE@GATE_EFFORT_PIN.
    builder-opus-low|builder-opus-medium) GATE_PROFILE=opus; GATE_EFFORT_PIN="${MODEL##*-}" ;;
    builder-sonnet-xhigh|builder-sonnet-max) GATE_PROFILE=sonnet; GATE_EFFORT_PIN="${MODEL##*-}" ;;
    haiku) GATE_PROFILE=haiku ;;
    fable) GATE_PROFILE=fable ;;
    devin-swe2|builder-devin) GATE_PROFILE=devin-swe2 ;;
    # All devin-* model profiles share one gate spelling: `devin-swe2` is the
    # only devin profile installed scopefuel accepts (any other spelling is
    # argparse-rejected, rc=2 fail-closed). Per-model attribution survives in
    # the job.spawned payload `profile` and the quota_pool.record
    # `launch_profile`, so reps stay separated per model.
    devin-glm52|devin-swe17|devin-ds41|devin-swe2-medium|devin-swe2-max|devin-ds41-max|builder-devin-medium|builder-devin-max|builder-ds41|builder-ds41-max) GATE_PROFILE=devin-swe2 ;;
    # #1026: the gpt-6-sol rollback spellings gate like the spellings they roll
    # back — codex-sol6 like codex-sol, builder-sol6 like builder-sol (the flat
    # codex-max spelling, not an E6 rung).
    codex|codex-sol|codex-max|builder-sol|captain-sol|codex-sol56|codex-sol6|builder-sol6) GATE_PROFILE=codex-max ;;
    # #704: E6 codex rungs are judged at the canonical catalog profile + pinned
    # effort rung (codex-sol@high, codex-luna@max, codex-terra@*) — not the
    # flat codex-max/codex-luna-max/codex-terra-max spellings the old builders
    # use, because scopefuel #692's E6 marker is profile@effort-exact.
    builder-sol-high|builder-sol-max|builder-sol-medium) GATE_PROFILE=codex-sol; GATE_EFFORT_PIN="${MODEL##*-}" ;;
    builder-luna-max) GATE_PROFILE=codex-luna; GATE_EFFORT_PIN=max ;;
    builder-terra-high|builder-terra-xhigh|builder-terra-max) GATE_PROFILE=codex-terra; GATE_EFFORT_PIN="${MODEL##*-}" ;;
    # task #527: the gate role-denies astra without an allowed --purpose, so the
    # counsel spawn path defaults it to `architect` (the wrk-side counsel use).
    # An explicit --purpose director|operator-request still wins.
    codex-astra) GATE_PROFILE=codex-astra; [[ -n "${PURPOSE:-}" ]] || PURPOSE=architect ;;
    codex-terra|codex-med|codex-terra-max) GATE_PROFILE=codex-terra-max ;;
    codex-luna|codex-luna-hi|codex-luna-max|codex-luna56|builder-luna) GATE_PROFILE=codex-luna-max ;;
    kiro-opus|kiro-opus-xhigh|kiro-opus-max) GATE_PROFILE=kiro-opus ;;
    kiro-sonnet) GATE_PROFILE=kiro-sonnet ;;
    kiro-cheap) GATE_PROFILE=kiro-cheap ;;
    kiro-haiku) GATE_PROFILE=kiro-haiku ;;
    kiro|kiro-sol|kiro-luna|kiro-glm|kiro-deepseek|kiro-minimax|kiro-minimax21|kiro-sol-xhigh|kiro-sol-max)
      GATE_PROFILE=kiro-sol ;;
    kimi-k3|kimi-k27|kimi-k27-code|kimi-k3-low) GATE_PROFILE="$MODEL" ;;
    builder-kimi) GATE_PROFILE=kimi-k3 ;;
    # #704: the kimi E6 rungs gate at their pinned rung like the rest (the
    # --effort goes to `scopefuel gate`, not the kimi CLI — that one takes the
    # rung from its clone home). Both rungs are unmeasured C rows under #692,
    # so without SCOPEFUEL_E6_ARM=kimi-k3@<rung> the gate refuses.
    builder-kimi-high|builder-kimi-max) GATE_PROFILE=kimi-k3; GATE_EFFORT_PIN="${MODEL##*-}" ;;
    oc-kimi-code|oc-glm|oc-kimi-k3|oc-dsflash|oc-gflash|oc-sonnet46|oc-oss|oc-omni|oc-qwen37-max|oc-minimax-m3|oc-solar4)
      GATE_PROFILE="$MODEL" ;;
    agy-flash|agy-flash36|agy-flash37) GATE_PROFILE="agy-flash" ;;
    grok|grok-hi|grok-med|grok45|grok45-med|grok46|grok46-med|builder-grok) GATE_PROFILE=grok-hi ;;
    # #737: the E6 grok rungs gate at their pinned rung (unmeasured C rows
    # under #692/#737 — spawn refuses without SCOPEFUEL_E6_ARM=grok-hi@<rung>).
    builder-grok-low|builder-grok-medium|builder-grok-xhigh) GATE_PROFILE=grok-hi; GATE_EFFORT_PIN="${MODEL##*-}" ;;
    # ROB-1252 / ROB-1253: clinepass 쿼타 풀로 귀속 — PROFILE_KIND=claude(구독 OAuth) 풀과
    # 완전 분리해야 admission/쿼타 집계가 섞이지 않는다.
    # 실험 지정 별칭(cc-dsflash/cc-dspro/cc-glm53)은 reps 축적 전까지 급표 미등재이므로
    # 동일 clinepass 풀의 대표 프로필(cc-qwen38)로 게이트 매핑.
    cc-qwen38|cc-glm) GATE_PROFILE="$MODEL" ;;
    cc-dsflash|cc-dspro|cc-glm53) GATE_PROFILE="cc-qwen38" ;;
  esac

  resolve_catalog_profile
  apply_catalog

  if [[ -n "$EFFORT" ]]; then
    case "$EFFORT" in low|medium|high|xhigh|max|ultra) ;; *) die "unknown effort '$EFFORT'" ;; esac
    [[ "$PROFILE_KIND" != kiro || "$EFFORT" != ultra ]] || die "Kiro does not support --effort ultra"
    [[ "$EFFORT_SUPPORTED" -eq 1 ]] || die "--effort is unsupported for profile '$MODEL'"
    EFFECTIVE_EFFORT="$EFFORT"
  else
    EFFECTIVE_EFFORT="$DEFAULT_EFFORT"
  fi

  # 2026-09-26 (decision 4088 B): a builder seat never takes a max rung — high
  # or below, or a devin profile. codex `ultra` is the max tier plus subagents,
  # so it is refused here as well. This sits ahead of the E6 pin check so the
  # #704 max-rung builder spellings (builder-sonnet-max, builder-sol-max,
  # builder-luna-max, builder-terra-max, builder-kimi-max) are closed by the
  # seat rule itself, not merely by a missing marker. devin profiles carry no
  # --effort at all (EFFORT_SUPPORTED=0 above), so a devin builder's
  # model-encoded rung never reaches this check. The unflagged kimi spellings
  # (builder-kimi, kimi-k3) resolve their rung from the home's config below —
  # the only place it exists for them.
  if [[ "${ROLE:-worker}" == builder ]]; then
    local seat_effort="$EFFECTIVE_EFFORT"
    if [[ -z "$seat_effort" && "$PROFILE_KIND" == kimi ]]; then
      # builder-kimi and kimi-k3 leave EFFECTIVE_EFFORT empty (no --effort
      # flag, no DEFAULT_EFFORT): the only rung they can run is whatever the
      # kimi home resolves for the spawned model — the [thinking] effort, or
      # the model's default_effort when the request is missing/unsupported
      # (Kimi Code's documented fallback), or the KIMI_MODEL_THINKING_EFFORT
      # overlay when exported. Read it or a max-effort home slips a builder
      # seat past this rule unseen. A missing/unparseable config yields
      # empty and stays fail-open here — the E6 rungs below are what fail
      # closed on a missing clone.
      local kimi_model="" i
      for ((i = 0; i + 1 < ${#ARGS[@]}; i++)); do
        [[ "${ARGS[i]}" == -m ]] && kimi_model="${ARGS[i + 1]}"
      done
      seat_effort="$(kimi_clone_resolved_effort "${KIMI_TRUST_HOME:-}/config.toml" "$kimi_model")"
    fi
    case "$seat_effort" in
      max|ultra)
        # #921: builder-sonnet is the operator's named exception (2026-09-29
        # report, experiment E2) — an explicit max rung on exactly this
        # spelling. ultra stays refused (its effort set excludes it), and the
        # E6 max spellings stay closed.
        [[ "$MODEL" == builder-sonnet && "$seat_effort" == max ]] ||
          die "$MODEL at effort $seat_effort is refused for --role builder: builder seats never take a max rung (operator decision 2026-09-26) — use high or below, or a devin profile" ;;
    esac
  fi

  # #704 (#594 E6): the per-rung builder spellings carry GATE_EFFORT_PIN. The
  # rung is pinned by the profile name — an explicit --effort may only restate
  # it (the kimi pair has EFFORT_SUPPORTED=0, so --effort is already refused
  # above). They exist to measure exactly that rung, so spawn is refused
  # unless SCOPEFUEL_E6_ARM names GATE_PROFILE@<rung> verbatim: scopefuel #692
  # opens the unmeasured C rungs only for that marker, and pinning it here
  # keeps an unlabeled or mislabeled launch out of the E6 sample.
  if [[ -n "$GATE_EFFORT_PIN" ]]; then
    [[ "$EFFECTIVE_EFFORT" == "$GATE_EFFORT_PIN" ]] ||
      die "$MODEL is pinned to effort $GATE_EFFORT_PIN (#594 E6 rung); --effort $EFFECTIVE_EFFORT is a different rung"
    [[ "${SCOPEFUEL_E6_ARM:-}" == "$GATE_PROFILE@$GATE_EFFORT_PIN" ]] ||
      die "$MODEL is an E6 measurement profile (#594): spawn requires SCOPEFUEL_E6_ARM=$GATE_PROFILE@$GATE_EFFORT_PIN (got '${SCOPEFUEL_E6_ARM:-<unset>}')"
    if [[ "$PROFILE_KIND" == kimi ]]; then
      # The kimi CLI has no --effort flag: the pinned clone home's
      # [thinking] effort is the only place this rung exists, so a missing or
      # mismatched clone would silently launch the wrong rung. Fail closed —
      # the env overlay must not stand in for a missing clone file.
      [[ -r "$KIMI_TRUST_HOME/config.toml" ]] ||
        die "$MODEL needs a $GATE_EFFORT_PIN-effort Kimi clone at $KIMI_TRUST_HOME (config.toml missing); refresh it with: bin/kimi-clone-home --effort $GATE_EFFORT_PIN"
      local local_clone_effort
      local_clone_effort="$(kimi_clone_thinking_effort "$KIMI_TRUST_HOME/config.toml")"
      [[ "$local_clone_effort" == "$GATE_EFFORT_PIN" ]] ||
        die "$MODEL needs a $GATE_EFFORT_PIN-effort Kimi clone at $KIMI_TRUST_HOME (found '${local_clone_effort:-<none>}'); refresh it with: bin/kimi-clone-home --effort $GATE_EFFORT_PIN"
    fi
  fi

  case "$PROFILE_KIND" in
    codex) ARGS=(--yolo -m "$PROFILE_MODEL" -c "model_reasoning_effort=$EFFECTIVE_EFFORT") ;;
    kiro)
      ARGS=(chat --v3 --trust-all-tools --require-mcp-startup)
      [[ -z "$PROFILE_MODEL" ]] || ARGS+=(--model "$PROFILE_MODEL")
      ARGS+=(--effort "$EFFECTIVE_EFFORT")
      ;;
    grok) ARGS=(--always-approve -m "${PROFILE_MODEL_ARG:-grok-4.7}" --effort "$EFFECTIVE_EFFORT") ;;
    claude)
      # Append only for effort-capable Claude profiles (opus/sonnet). fable stays bare.
      if [[ "$EFFORT_SUPPORTED" -eq 1 && -n "$EFFECTIVE_EFFORT" ]]; then
        ARGS+=(--effort "$EFFECTIVE_EFFORT")
      fi
      # #626 AC2: prompt suggestions prefill the composer with a predicted next
      # prompt; one submitted in a tester pane became a fake operator
      # confirmation (hk:doc task/2026-09-24/phantom-suggestion-submitted).
      # Documented off switch (code.claude.com/docs/en/env-vars): "Set to
      # `false` to turn off prompt suggestions … Takes precedence over the
      # `promptSuggestionEnabled` setting". Pane env only — argv and the
      # user's settings.json stay untouched. A resident session spawned with
      # --purpose director is the operator's call and is left as is.
      if [[ "${PURPOSE:-}" != director ]]; then
        PROFILE_ENV+=(--env "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=false")
      fi
      ;;
  esac
}

# #637: a pane's env and argv die with it — after a reboot herdr restores the
# pane as bare `claude --resume <id>` (hk:doc
# task/2026-09-24/resume-loses-worker-env). For claude-kind workers the durable
# copy of the prompt-suggestion toggle lives in the worker worktree's own
# .claude/settings.local.json, which Claude Code re-reads on every launch,
# resume included (verified: env values from a linked worktree's local file
# reach the session's process env).
#
# The launch permission mode is deliberately NOT written. Per
# settings-reference, "`auto` and `bypassPermissions` don't take effect from
# project or local settings"; the local source is still highest-priority, so
# the session then "starts in Manual mode" — writing bypassPermissions here
# would pin every flagless claude launch in the worktree (a herdr restore
# included) to Manual, overriding user settings and the built-in default.
# Restoring bypass needs the launch flag, or user/--settings/managed scope.
#
# Merge, never clobber: an existing file keeps every unrelated key, and only
# our env key is written. A file that is not a JSON object (or whose `env` is
# not an object — `null` included), or one already tracked by the repo, aborts
# the spawn rather than being silently overwritten — that state needs a human,
# not a rewrite. A symlinked .claude directory or settings file (dangling
# included) is left alone with a warning: writing through it could modify a
# location wrk does not own, and os.replace would destroy a leaf symlink to
# shared settings (CodeRabbit CR2/CR4) — the spawn proceeds without persisted
# settings.
write_claude_local_settings() {
  local cwd="$1"
  # A tracked settings.local.json belongs to the repo; wrk must never modify a
  # target repo's tracked files.
  git -C "$cwd" ls-files --error-unmatch -- .claude/settings.local.json >/dev/null 2>&1 &&
    { printf 'wrk: %s/.claude/settings.local.json is tracked in the repo; refusing to modify a tracked file\n' "$cwd" >&2; return 3; }
  # -L sees the link itself, so a dangling symlink is refused too.
  if [[ -L "$cwd/.claude" || -L "$cwd/.claude/settings.local.json" ]]; then
    warn "$cwd: .claude or .claude/settings.local.json is a symlink; leaving it alone (no local settings written)"
    return 0
  fi
  python3 - "$cwd" <<'PY'
import json, os, sys, tempfile

cwd = sys.argv[1]
path = os.path.join(cwd, ".claude", "settings.local.json")

data = {}
existed = os.path.exists(path)
if existed:
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError) as e:
        print("wrk: %s exists but is not valid JSON; refusing to modify it (%s)" % (path, e), file=sys.stderr)
        sys.exit(3)
    if not isinstance(data, dict):
        print("wrk: %s is not a JSON object; refusing to modify it" % path, file=sys.stderr)
        sys.exit(3)

if "env" in data:
    if not isinstance(data["env"], dict):
        print("wrk: %s: 'env' is not a JSON object; refusing to modify it" % path, file=sys.stderr)
        sys.exit(3)
else:
    data["env"] = {}

data["env"]["CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION"] = "false"

os.makedirs(os.path.dirname(path), exist_ok=True)
fd, tmp = tempfile.mkstemp(prefix=".settings.local.json.", dir=os.path.dirname(path))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")
    if existed:
        os.chmod(tmp, os.stat(path).st_mode & 0o777)
    os.replace(tmp, path)
finally:
    if os.path.exists(tmp):
        os.unlink(tmp)
PY
}

# The worker's local settings must never enter a commit. Claude Code itself
# keeps the file out of git via the user's global excludes; a repo that already
# ignores it needs nothing. When the worker repo does not, the pattern goes to
# the repository's own .git/info/exclude (resolved through --git-common-dir so
# linked worktrees share it) — a tracked file is never touched. A cwd outside
# git, or an exclude write that fails, is a warning, not a failed spawn: the
# file is already on disk and the spawn stands.
ensure_settings_local_ignored() {
  local cwd="$1" common
  git -C "$cwd" rev-parse --git-common-dir >/dev/null 2>&1 || {
    warn "$cwd is not a git worktree; cannot verify .claude/settings.local.json is git-ignored (nothing can commit it there)"
    return 0
  }
  git -C "$cwd" check-ignore -q -- .claude/settings.local.json && return 0
  common="$(git -C "$cwd" rev-parse --git-common-dir)"
  # --git-common-dir is relative for a main checkout (".git"); anchor it to the
  # worktree cwd or the mkdir/append below would land in wrk's own directory.
  [[ "$common" == /* ]] || common="$cwd/$common"
  mkdir -p "$common/info" ||
    { warn "cannot create $common/info; $cwd/.claude/settings.local.json is not git-ignored — do not commit it"; return 0; }
  # A file with no final newline would glue our pattern onto its last line,
  # un-ignoring whatever that rule named (CodeRabbit CR3).
  if [[ -s "$common/info/exclude" ]] && [[ -n "$(tail -c 1 "$common/info/exclude" 2>/dev/null)" ]]; then
    printf '\n' >>"$common/info/exclude" ||
      { warn "cannot append to $common/info/exclude; $cwd/.claude/settings.local.json is not git-ignored — do not commit it"; return 0; }
  fi
  grep -qxF '**/.claude/settings.local.json' "$common/info/exclude" 2>/dev/null ||
    printf '%s\n' '**/.claude/settings.local.json' >>"$common/info/exclude" ||
    { warn "cannot append to $common/info/exclude; $cwd/.claude/settings.local.json is not git-ignored — do not commit it"; return 0; }
  git -C "$cwd" check-ignore -q -- .claude/settings.local.json ||
    warn "$cwd/.claude/settings.local.json is still not git-ignored after updating info/exclude — do not commit it"
}

# completion_event JOB OWNER LABEL PANE REPORT [KIND] [REASON] [MODE]
#
# MODE=record (default) writes the durable event file and prints "created"
# plus the report path the record names, or "duplicate" when an identical
# report was already completed. MODE=resolve runs the same decisions under
# the same lock but writes nothing: it prints "duplicate", or "resolved" plus
# the target path — REPORT itself, or a freshly created <stem>-r<N>.md
# snapshot of its content when REPORT already names an earlier completed
# round. done_cmd resolves first so the document upload, the record, the
# relay emit and the OK line all name one artifact.
completion_event() {
  local job="$1" owner="$2" label="$3" pane="$4" report="$5" kind="${6:-job.completed}" reason="${7:-}" mode="${8:-record}"
  local events host last
  events="$(wrk_jobs_root)/$job/events"
  host="${HOSTNAME:-unknown}"
  mkdir -p "$events"
  if [[ -n "$report" && -f "$report" ]]; then
    last="$(tail -n 1 "$report" 2>/dev/null | tr '\r\n' ' ' | cut -c1-240)"
    last="$(append_document_suffix "$last")"
  else
    last=""
  fi
  python3 - "$events" "$job" "$owner" "$label" "$pane" "$host" "$report" "$last" "$kind" "$reason" "$mode" <<'PY'
import fcntl, hashlib, json, os, re, sys, tempfile, time
events, job, owner, label, pane, host, report, last, kind, reason, mode = sys.argv[1:]


def digest_of(path):
    try:
        with open(path, 'rb') as f:
            return hashlib.sha256(f.read()).hexdigest()
    except OSError:
        return None


# A completed round is identified by the report artifact's content, not by an
# invocation count or epoch (a constant today). `wrk done` and the completion
# sentinel are separate processes racing on this directory, so the membership
# check and the record write run inside one lock; the lockfile lives next to
# events/ because the directory is also a consumer-facing record stream.
# The bytes are read once: the digest and the snapshot below are computed from
# and written with this same payload, so a record never names a snapshot whose
# sha256 differs from report_sha256 even if report.md is rewritten mid-call.
payload = None
digest = None
if kind == "job.completed":
    try:
        with open(report, 'rb') as f:
            payload = f.read()
        digest = hashlib.sha256(payload).hexdigest()
    except OSError:
        pass
lock_path = os.path.join(os.path.dirname(events), ".wrk-events.lock")
with open(lock_path, "w", encoding="utf-8") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    if digest is not None:
        priors = []
        for name in sorted(os.listdir(events)):
            if not name.endswith("-job.completed.json"):
                continue
            try:
                with open(os.path.join(events, name), encoding="utf-8") as f:
                    prior = json.load(f)
            except (OSError, ValueError):
                continue
            if prior.get("kind") != "job.completed":
                continue
            priors.append(prior)
            prior_digest = prior.get("report_sha256")
            # A legacy record carries no content identity, and no filesystem
            # proxy can reconstruct it — a rewritten file can keep an old
            # mtime (touch, cp -p, rsync -a). Absent proof of identity a record
            # can never be a suppression basis: fail toward writing, never
            # toward eating a new round.
            if prior_digest is None:
                continue
            if prior_digest == digest:
                print("duplicate")
                sys.exit(0)
        # panewire's relay outbox key is (kind, job, epoch, report_path,
        # reason): a later round that reuses an earlier record's report path
        # with changed content collides on that key and its emit is refused
        # (rc 6), leaving the completion file-only. Rename the artifact, not
        # the epoch: snapshot the current content to <stem>-r<N><ext> (N = 1 +
        # this job's earlier distinct completed rounds) so the record the
        # daemon rescans and the emit both carry a fresh key. The name is
        # published by hard-link, never overwriting an existing file; an
        # identical-content file already there is this same decision's
        # leftover from a lost race and is adopted as-is.
        used_paths = {p.get("report_path") for p in priors}
        if report in used_paths:
            stem, ext = os.path.splitext(os.path.basename(report))
            stem = re.sub(r"-r[0-9]+$", "", stem)
            rounds = sum(1 for p in priors if not p.get("report_sha256"))
            rounds += len({p["report_sha256"] for p in priors if p.get("report_sha256")})
            directory = os.path.dirname(report) or "."
            n = rounds + 1
            while True:
                candidate = os.path.join(directory, "%s-r%d%s" % (stem, n, ext))
                if candidate in used_paths:
                    n += 1
                    continue
                if os.path.exists(candidate):
                    if digest_of(candidate) == digest:
                        report = candidate
                        break
                    n += 1
                    continue
                temporary = None
                try:
                    fd, temporary = tempfile.mkstemp(prefix='.report-', dir=directory)
                    with os.fdopen(fd, 'wb') as out:
                        out.write(payload)
                    os.link(temporary, candidate)
                    report = candidate
                except FileExistsError:
                    if digest_of(candidate) == digest:
                        report = candidate
                        break
                    n += 1
                    continue
                except OSError:
                    pass  # unsnapshotable dir or unreadable report: keep the path
                finally:
                    if temporary is not None and os.path.exists(temporary):
                        os.unlink(temporary)
                break
    if mode == "resolve":
        print("resolved")
        print(report)
        sys.exit(0)
    highest = 0
    for name in os.listdir(events):
        try: highest = max(highest, int(name.split('-', 1)[0]))
        except (ValueError, IndexError): pass
    record = {"kind": kind, "job_id": job, "owner_lane": owner, "label": label,
              "pane_id": pane, "host": host, "report_path": report,
              "report_last_line": last, "epoch": 1}
    if digest is not None:
        record["report_sha256"] = digest
    # job.lost always states why. Downstream recovery treats agent_not_found as
    # a vanished pane and herdr_unreachable/timeout as an observation gap.
    if reason: record["reason"] = reason
    fd, temporary = tempfile.mkstemp(prefix='.completion-', dir=events)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(record, f, separators=(',', ':'))
            f.write('\n')
        os.chmod(temporary, 0o600)
        os.replace(temporary, os.path.join(events, f'{highest + 1:05d}-{kind}.json'))
    finally:
        if os.path.exists(temporary): os.unlink(temporary)
print("created")
print(report)
PY
}

# A same-report re-completion is a no-op for the record stream but must not be
# silent: leave one durable line per suppressed write, next to the sentinel log.
note_duplicate_completion() {
  local job="$1" report="$2" jobdir
  jobdir="$(wrk_jobs_root)/$job"
  mkdir -p "$jobdir" 2>/dev/null || return 0
  printf '%s suppressed-duplicate report=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$report" >>"$jobdir/completion-suppressed.log" 2>/dev/null || true
  return 0
}

# R20 T3: the record files written above stay the durable contract — the node
# still finds them by rescanning the directory, and the panewire outbox picks
# up anything a live emit missed. `panewire emit` is only an extra, immediate
# notification that removes that rescan delay, so it must never change what
# `wrk` writes, prints, or exits with.
#
# `tr` turns the report's final newline into a trailing space, which plain
# command substitution would then eat along with the newline `cut` appends. The
# record files keep that space, so the value travels through a variable and
# only the trailing newlines are dropped — anything else and the emit payload
# stops being byte-identical to the record file the node also reads.
EMIT_REPORT_LAST_LINE=""
# Non-zero when this invocation's `panewire emit` returned non-zero (the other
# non-delivery modes — missing binary, wedged daemon — keep their warning-only
# shape). done_cmd reads it to mark the OK line relay=file-only.
EMIT_RELAY_RC=0
set_report_last_line() {
  local report="${1:-}"
  EMIT_REPORT_LAST_LINE=""
  [[ -n "$report" && -f "$report" ]] || return 0
  EMIT_REPORT_LAST_LINE="$(tail -n 1 "$report" 2>/dev/null | tr '\r\n' ' ' | cut -c1-240; printf x)"
  EMIT_REPORT_LAST_LINE="${EMIT_REPORT_LAST_LINE%x}"
  while [[ "$EMIT_REPORT_LAST_LINE" == *$'\n' ]]; do
    EMIT_REPORT_LAST_LINE="${EMIT_REPORT_LAST_LINE%$'\n'}"
  done
  EMIT_REPORT_LAST_LINE="$(append_document_suffix "$EMIT_REPORT_LAST_LINE")"
}

# Set only by upload_report_document for the current completion command. The
# same suffix is applied independently to the durable record and relay value,
# preserving their byte-identical report_last_line contract.
REPORT_DOCUMENT_SUFFIX=""
append_document_suffix() {
  local last="$1" limit shortened
  [[ -n "$REPORT_DOCUMENT_SUFFIX" ]] || { printf '%s' "$last"; return 0; }
  limit=$((240 - ${#REPORT_DOCUMENT_SUFFIX}))
  if (( limit > 0 )); then
    shortened="$(printf '%s' "$last" | cut -c1-"$limit")"
    printf '%s' "$shortened"
  fi
  printf '%s' "$REPORT_DOCUMENT_SUFFIX"
}

# Upload a report opportunistically. Its result is deliberately settled before
# the durable record: that lets the record and wire value be written once with
# the same document suffix, rather than rewriting a landed record. The bounded
# (three-second) delay is the trade-off for that consistency.
upload_report_document() {
  local job="$1" report="$2" handoffkeep key base rc=0
  REPORT_DOCUMENT_SUFFIX=""
  handoffkeep="$(command -v "${HANDOFFKEEP_BIN:-handoffkeep}" 2>/dev/null || true)"
  if [[ -z "$handoffkeep" ]]; then
    warn "handoffkeep not found; report document not uploaded (job=$job)"
    return 0
  fi
  base="$(basename "$report")"
  key="reports/$job/$base"
  local command=(run_bounded 3 "$handoffkeep" doc put --key "$key" --kind report --job "$job" --file "$report")
  # Keep handoffkeep output out of wrk's one-line stdout contract; failures
  # below intentionally become one warning and never affect the exit status.
  "${command[@]}" >/dev/null 2>&1 || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    warn "handoffkeep document upload failed (rc=$rc job=$job); continuing without document link"
    return 0
  fi
  REPORT_DOCUMENT_SUFFIX=" doc:$key"
  if (( ${#REPORT_DOCUMENT_SUFFIX} > 240 )); then
    warn "handoffkeep document key is too long for report link (job=$job)"
    REPORT_DOCUMENT_SUFFIX=""
  fi
}

# emit_relay_event KIND JOB OWNER LABEL PANE HOST REPORT LAST REASON QUESTION PR HEAD
#
# Called only after the record file landed, and only for the three kinds
# panewire accepts (job.completed / job.escalate / job.joined). job.lost is not
# one of them, so the sentinel deliberately does not come through here.
# Always returns 0: a missing, failing or wedged panewire is a warning on
# stderr and nothing else.
emit_relay_event() {
  local kind="$1" job="$2" owner="$3" label="$4" pane="$5" host="$6" report="$7"
  local last="$8" reason="$9" question="${10}" pr="${11}" head="${12}"
  local panewire rc=0
  EMIT_RELAY_RC=0
  # #770 round-2: a panewire subprocess that was just killed by its timeout is
  # wedged — re-entering it for emit would stall this call by another full
  # emit guard (tester: sleeping stub made `wrk done` take delegate-timeout +
  # 5s). The record already landed on disk; the daemon rescan picks it up.
  if [[ "${PANEWIRE_WEDGED:-}" == 1 ]]; then
    warn "panewire emit skipped: panewire timed out earlier this invocation (job=$job kind=$kind)"
    record_emit_failure "$job" "$kind" "delegate_timeout"
    return 0
  fi
  panewire="$(command -v "${PANEWIRE_BIN:-panewire}" 2>/dev/null || true)"
  if [[ -z "$panewire" ]]; then
    warn "panewire not found; relay event left as file only (job=$job kind=$kind)"
    record_emit_failure "$job" "$kind" "not_found"
    return 0
  fi
  # A wedged socket must not stall `wrk joined`; that call sits in the builder
  # loop, so a hang there stops the fleet. `timeout` is GNU coreutils and a
  # stock macOS has neither it nor gtimeout, so python3 — already a hard
  # dependency above — carries the same guard there.
  # panewire wants the root containing jobs/<job>/events — the parent of
  # wrk_jobs_root(), since ARBITER_INBOX_ROOT names the jobs directory itself.
  # Without it emit falls back to the daemon's default root and the relay
  # misses the record file wrk just wrote.
  local inbox_root
  inbox_root="$(dirname "$(wrk_jobs_root)")"
  local command=(run_bounded 5 "$panewire" emit --kind "$kind" --job "$job" --report "$report"
    --owner-lane "$owner" --epoch 1 --label "$label" --host "$host" --pane "$pane"
    --report-last-line "$last" --inbox-root "$inbox_root")
  # Empty optionals are omitted rather than passed as empty strings.
  [[ -z "$reason" ]] || command+=(--reason "$reason")
  [[ -z "$question" ]] || command+=(--question "$question")
  [[ -z "$pr" ]] || command+=(--pr "$pr")
  [[ -z "$head" ]] || command+=(--head "$head")
  # `|| rc=$?` keeps a non-zero emit from tripping `set -e`; stdout is swallowed
  # so the caller's single OK line stays the only thing on it.
  "${command[@]}" >/dev/null 2>&1 || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    EMIT_RELAY_RC="$rc"
    warn "panewire emit failed (rc=$rc job=$job kind=$kind report=$report); relay event left as file only"
    record_emit_failure "$job" "$kind" "$rc"
  fi
  return 0
}

# record_emit_failure JOB KIND RC
#
# The record file already landed (emit_relay_event is only ever called after
# that); this durably marks that its *broadcast* to panewire did not, so
# "how many completions never got relayed" is answerable later from files
# alone, without touching panewire's own state. Append-only and best-effort:
# it must never be the thing that makes a fail-open path fail closed, so a
# write failure here is itself swallowed. Zero effect on the success path —
# nothing is written when rc=0.
record_emit_failure() {
  local job="$1" kind="$2" rc="$3" dir
  dir="$(wrk_jobs_root)/$job"
  mkdir -p "$dir" 2>/dev/null || return 0
  printf '%s kind=%s rc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$kind" "$rc" \
    >>"$dir/emit-failures.log" 2>/dev/null || true
  return 0
}

# Keep this exactly aligned with arbiter.inbox_root(): ARBITER_INBOX_ROOT is
# the jobs directory, rather than its parent.
wrk_jobs_root() {
  printf '%s\n' "${ARBITER_INBOX_ROOT:-$HOME/work/herdr-inbox/jobs}"
}

completion_metadata() {
  local job="$1"
  python3 - "$(wrk_jobs_root)/$job/events" <<'PY'
import json, os, sys
owner=label=pane=parent=role=''
try: names=sorted(os.listdir(sys.argv[1]))
except OSError: raise SystemExit(1)
for name in names:
    try: o=json.load(open(os.path.join(sys.argv[1],name), encoding='utf-8'))
    except (OSError,json.JSONDecodeError): continue
    p=o.get('payload',o)
    # Claim/reclaim establishes ownership.  Keep the newest one: a released
    # job can be reclaimed by a different builder and parent.
    if o.get('kind') in ('job.claim', 'job.reclaim'):
        owner=p.get('owner_lane') if isinstance(p.get('owner_lane'), str) else ''
        candidate=p.get('label', p.get('agent_label'))
        label=candidate if isinstance(candidate, str) else ''
        parent=p.get('parent_lane') if isinstance(p.get('parent_lane'), str) else ''
        role=p.get('role') if isinstance(p.get('role'), str) else ''
    pane=p.get('pane_id') if isinstance(p.get('pane_id'), str) else pane
if owner and label and pane: print(owner, label, pane, parent, role, sep='\t')
else: raise SystemExit(1)
PY
}

# Python is already a hard dependency for durable event creation above. Use it
# for report discovery and identity so this works on both GNU and BSD userlands
# (find -printf and stat -c are GNU-only). The identity includes nanosecond
# mtime and size, so an updated report at the same path is a new observation.
find_latest_report() {
  local directory="$1"
  python3 - "$directory" <<'PY'
import glob, os, sys
paths = []
try:
    for path in glob.glob(os.path.join(sys.argv[1], "report*.md")):
        if os.path.isfile(path):
            paths.append(path)
except OSError:
    pass
if paths:
    print(max(paths, key=os.path.getmtime))
PY
}

report_observation_key() {
  local report="$1"
  python3 - "$report" <<'PY'
import os, sys
try:
    info = os.stat(sys.argv[1])
except OSError:
    raise SystemExit(1)
print(f"{info.st_dev}:{info.st_ino}:{info.st_mtime_ns}:{info.st_size}")
PY
}

# #499: `panewire job done|escalate|joined` is the Go form of the three
# commands below and leaves byte-identical records, socket requests and output
# (pinned by panewire testdata/job_golden). wrk hands the call over only when
# the installed panewire proves it has that command: `panewire job probe` must
# print exactly the token below. A missing binary, an older panewire (rc 2, no
# output), any other output, or a probe that hangs keeps wrk's own path — the
# probe has no side effects, so falling back after it can never duplicate an
# event. The delegated call runs as a bounded subprocess — never exec — so
# wrk-side end housekeeping can still run after the record lands, and a
# failed or hung delegation falls back to wrk's own write path instead of
# losing the terminal record (#770 tester BLOCKER 1). WRK_JOB_DELEGATE=0
# forces wrk's own path (golden regeneration, rollback).
JOB_PROBE_TOKEN="panewire-job/1"
delegate_job_cmd() {
  local sub="$1" panewire probe
  shift
  [[ "${WRK_JOB_DELEGATE:-1}" != 0 ]] || return 0
  panewire="$(command -v "${PANEWIRE_BIN:-panewire}" 2>/dev/null || true)"
  [[ -n "$panewire" ]] || return 0
  local run_timeout="${WRK_JOB_DELEGATE_TIMEOUT_S:-30}"
  local prc=0
  probe="$(run_bounded 5 "$panewire" job probe 2>/dev/null </dev/null)" || prc=$?
  if [[ "$prc" -ne 0 ]]; then
    # A probe killed by its own guard means the daemon is wedged, not absent —
    # emit_relay_event must not re-enter it inside this same invocation.
    if [[ "$prc" == 124 ]]; then PANEWIRE_WEDGED=1; fi
    return 0
  fi
  [[ "$probe" == "$JOB_PROBE_TOKEN" ]] || return 0
  # HOSTNAME is a shell variable bash does not necessarily export; the records
  # carry wrk's value, so hand it over explicitly.
  local rc=0
  HOSTNAME="${HOSTNAME:-unknown}" run_bounded "$run_timeout" "$panewire" job "$sub" "$@" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    # #770 tester BLOCKER 1: the probe proved the binary understands the job
    # verbs — it did not prove the delegated call will succeed or even return.
    # A nonzero exit or a hang past the timeout must not take the terminal
    # record down with it: warn and return to the caller so wrk's own path
    # writes the same record. If the delegated write did land before dying,
    # the local path's completion dedup suppresses the second write. On a
    # timeout the daemon is wedged — mark it so emit_relay_event does not
    # stall this invocation on another doomed panewire call.
    if [[ "$rc" == 124 ]]; then PANEWIRE_WEDGED=1; fi
    warn "panewire job $sub delegation failed or timed out (rc=$rc); using wrk's own path"
    return 0
  fi
  # #770: a delegated terminal path still needs wrk-side housekeeping — the
  # delegated binary wrote the record, but only wrk on this host can stop the
  # completion sentinel and release the arbiter quota_pool record. Same as
  # the local path: run it after the record lands, never mask the result.
  if [[ "$sub" == "done" || "$sub" == "joined" ]]; then
    local d_job="${1:-}" d_meta="" d_owner=""
    if [[ -n "$d_job" && "$d_job" != -* ]]; then
      d_meta="$(completion_metadata "$d_job" 2>/dev/null || true)"
      d_owner="${d_meta%%$'\t'*}"
      job_end_housekeeping "$d_job" "$d_owner" "$sub" "panewire job $sub" "wrk $sub (delegated)"
    fi
  fi
  exit "$rc"
}

done_cmd() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    [[ $# -eq 1 ]] || die "unexpected argument '$2'"
    done_help
    return 0
  fi
  local job="${1:-}" report=""
  [[ -n "$job" && "$job" != -* ]] || die "done requires a job id"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --report) [[ $# -ge 2 && -n "$2" ]] || die "--report requires a path"; report="$2"; shift 2 ;;
      *) die "unknown done option '$1'" ;;
    esac
  done
  local metadata owner label pane jobs_root
  metadata="$(completion_metadata "$job")" || die "done cannot find job.claim/job.spawned metadata: $job"
  # completion_metadata prints five tab-separated fields; reading into three
  # lets pane_id swallow parent_lane and role ("w1:p1\t\tworker" was recorded
  # on 2026-09-05), which is also what panewire routes on.
  IFS=$'\t' read -r owner label pane _ <<<"$metadata"
  jobs_root="$(wrk_jobs_root)"
  if [[ -z "$report" ]]; then
    report="$(find_latest_report "$jobs_root/$job")"
  fi
  [[ -n "$report" && -f "$report" ]] || die "done requires an existing --report or report*.md in the job directory"
  # Decide the artifact path before delegating or uploading: a changed report
  # that reuses an earlier round's path is snapshot to <stem>-r<N>.md so its
  # outbox key is fresh. Delegation comes after resolution because
  # `panewire job done` records and emits whatever --report it is handed —
  # forwarding the caller's unchanged path would collide on the earlier
  # round's outbox key all over again (#1014 fix round).
  local resolution
  resolution="$(completion_event "$job" "$owner" "$label" "$pane" "$report" job.completed "" resolve)"
  if [[ "$resolution" == duplicate ]]; then
    note_duplicate_completion "$job" "$report"
    warn "job.completed already recorded for this report; suppressed duplicate (job=$job)"
    # #770: duplicate or not, done means the job is over — stop the sentinel
    # and settle the hub/arbiter records before returning.
    job_end_housekeeping "$job" "$owner" completed "wrk done (duplicate report)" "wrk done"
    echo "OK job=$job report=$report"
    return 0
  fi
  [[ "$resolution" == resolved*$'\n'* ]] || die "done: unexpected resolve output: $resolution"
  report="${resolution#*$'\n'}"
  delegate_job_cmd 'done' "$job" --report "$report"
  upload_report_document "$job" "$report"
  local completion_out completion_status
  completion_out="$(completion_event "$job" "$owner" "$label" "$pane" "$report")"
  completion_status="${completion_out%%$'\n'*}"
  if [[ "$completion_status" == duplicate ]]; then
    # A racer (the completion sentinel, or a second done) recorded this exact
    # report between the resolve above and this write; its record stands.
    note_duplicate_completion "$job" "$report"
    warn "job.completed already recorded for this report; suppressed duplicate (job=$job)"
    job_end_housekeeping "$job" "$owner" completed "wrk done (duplicate report)" "wrk done"
    echo "OK job=$job report=$report"
    return 0
  fi
  report="${completion_out#*$'\n'}"
  set_report_last_line "$report"
  emit_relay_event job.completed "$job" "$owner" "$label" "$pane" "${HOSTNAME:-unknown}" \
    "$report" "$EMIT_REPORT_LAST_LINE" "" "" "" ""
  local relay_suffix=""
  [[ "${EMIT_RELAY_RC:-0}" == 0 ]] || relay_suffix=" relay=file-only"
  # #770: end the hub job, release quota, and stop + wait on the completion
  # sentinel. Runs after the relay emit so the completed record is the first
  # thing panewire sees.
  job_end_housekeeping "$job" "$owner" completed "wrk done" "wrk done"
  echo "OK job=$job report=$report$relay_suffix"
}

builder_flat_event() {
  local job="$1" owner="$2" label="$3" pane="$4" parent="$5" kind="$6" report="$7" reason="$8" question="$9" pr="${10}" head="${11}"
  local events host="${HOSTNAME:-unknown}" last
  events="$(wrk_jobs_root)/$job/events"
  mkdir -p "$events"
  if [[ -n "$report" && -f "$report" ]]; then
    last="$(tail -n 1 "$report" 2>/dev/null | tr '\r\n' ' ' | cut -c1-240)"
    last="$(append_document_suffix "$last")"
  else
    last=""
  fi
  python3 - "$events" "$job" "$owner" "$label" "$pane" "$parent" "$host" "$report" "$last" "$kind" "$reason" "$question" "$pr" "$head" <<'PY'
import json, os, sys, tempfile
events, job, owner, label, pane, parent, host, report, last, kind, reason, question, pr, head = sys.argv[1:]
highest = 0
for name in os.listdir(events):
    try: highest = max(highest, int(name.split('-', 1)[0]))
    except (ValueError, IndexError): pass
record = {"kind": kind, "job_id": job, "owner_lane": owner, "label": label,
          "pane_id": pane, "host": host, "report_path": report,
          "report_last_line": last, "reason": reason, "parent_lane": parent, "epoch": 1}
if question: record["question"] = question
if pr: record["pr"] = pr
if head: record["head"] = head
fd, temporary = tempfile.mkstemp(prefix='.completion-', dir=events)
try:
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        json.dump(record, f, separators=(',', ':'))
        f.write('\n')
    os.chmod(temporary, 0o600)
    os.replace(temporary, os.path.join(events, f'{highest + 1:05d}-{kind}.json'))
finally:
    if os.path.exists(temporary): os.unlink(temporary)
PY
}

builder_metadata() {
  local job="$1" metadata owner label pane parent role
  metadata="$(completion_metadata "$job")" || die "cannot find job.claim/job.spawned metadata: $job"
  IFS=$'\t' read -r owner label pane parent role <<<"$metadata"
  case "$role" in builder|captain) ;; *) die "$job is not a builder claim with a parent lane (legacy captain alias is accepted)" ;; esac
  [[ -n "$parent" ]] || die "$job is not a builder claim with a parent lane (legacy captain alias is accepted)"
  # owner_lane is the builder's own lane. parent_lane is informational only;
  # panewire resolves the parent relationship from lanes.json.
  printf '%s\t%s\t%s\t%s\t%s\n' "$owner" "$label" "$pane" "$parent" "$role"
}

escalate_cmd() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    [[ $# -eq 1 ]] || die "unexpected argument '$2'"
    escalate_help
    return 0
  fi
  delegate_job_cmd escalate "$@"
  local job="${1:-}" question="" report="" metadata owner label pane parent role reason
  [[ -n "$job" && "$job" != -* ]] || die "escalate requires a job id"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --question) [[ $# -ge 2 && -n "$2" ]] || die "--question requires text"; question="$2"; shift 2 ;;
      --report) [[ $# -ge 2 && -n "$2" ]] || die "--report requires a path"; report="$2"; shift 2 ;;
      *) die "unknown escalate option '$1'" ;;
    esac
  done
  [[ -n "$question" ]] || die "escalate requires --question"
  [[ -z "$report" || -f "$report" ]] || die "escalate requires an existing --report"
  metadata="$(builder_metadata "$job")"
  IFS=$'\t' read -r owner label pane parent role <<<"$metadata"
  reason="builder escalation"
  [[ "$role" == captain ]] && reason="captain escalation"
  [[ -z "$report" ]] || upload_report_document "$job" "$report"
  builder_flat_event "$job" "$owner" "$label" "$pane" "$parent" job.escalate "$report" "$reason" "$question" "" ""
  set_report_last_line "$report"
  emit_relay_event job.escalate "$job" "$owner" "$label" "$pane" "${HOSTNAME:-unknown}" \
    "$report" "$EMIT_REPORT_LAST_LINE" "$reason" "$question" "" ""
  echo "OK job=$job owner_lane=$owner kind=job.escalate"
}

joined_cmd() {
  delegate_job_cmd joined "$@"
  local job="${1:-}" pr="" head="" report="" metadata owner label pane parent role reason
  [[ -n "$job" && "$job" != -* ]] || die "joined requires a job id"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pr) [[ $# -ge 2 && -n "$2" ]] || die "--pr requires a URL"; pr="$2"; shift 2 ;;
      --head) [[ $# -ge 2 && -n "$2" ]] || die "--head requires a SHA"; head="$2"; shift 2 ;;
      --report) [[ $# -ge 2 && -n "$2" ]] || die "--report requires a path"; report="$2"; shift 2 ;;
      *) die "unknown joined option '$1'" ;;
    esac
  done
  [[ -n "$pr" && -n "$head" && -n "$report" && -f "$report" ]] || die "joined requires --pr, --head and an existing --report"
  metadata="$(builder_metadata "$job")"
  IFS=$'\t' read -r owner label pane parent role <<<"$metadata"
  reason="builder joined PR"
  [[ "$role" == captain ]] && reason="captain joined PR"
  upload_report_document "$job" "$report"
  # #770 tester BLOCKER 1: when the delegated `panewire job joined` landed the
  # record and then failed, the fallback arrives with job.joined already the
  # newest work-terminal — appending again would duplicate it. Same shape as
  # done's duplicate branch: warn, skip the write+emit, still settle the job.
  local joined_term
  joined_term="$(job_events_scan "$(wrk_jobs_root)/$job/events" 2>/dev/null | awk -F'\t' '{print $4}')"
  if [[ "$joined_term" == "job.joined" ]]; then
    warn "job.joined already recorded for $job; suppressed duplicate"
    job_end_housekeeping "$job" "$owner" joined "wrk joined (duplicate)" "wrk joined"
    echo "OK job=$job owner_lane=$owner kind=job.joined pr=$pr head=$head report=$report"
    return 0
  fi
  builder_flat_event "$job" "$owner" "$label" "$pane" "$parent" job.joined "$report" "$reason" "" "$pr" "$head"
  set_report_last_line "$report"
  emit_relay_event job.joined "$job" "$owner" "$label" "$pane" "${HOSTNAME:-unknown}" \
    "$report" "$EMIT_REPORT_LAST_LINE" "$reason" "" "$pr" "$head"
  # #770: job.joined is a work-terminal but not a hub-terminal — the hub keeps
  # counting the job until the end declaration lands, and the completion
  # sentinel must not outlive the join.
  job_end_housekeeping "$job" "$owner" joined "wrk joined" "wrk joined"
  echo "OK job=$job owner_lane=$owner kind=job.joined pr=$pr head=$head report=$report"
}

# ── #758: formal tester-round counting and the per-job round cap ────────────
#
# One formal tester round is one tester verdict recorded for one head. The
# count lives ONLY in the job's events/ stream: a round starts with a
# `job.round` record (wrk round open) and its verdict lands as a `job.verdict`
# record bound to it (wrk round verdict). Rounds are numbered by wrk, so
# sub-round names like r5b cannot exist — every open increments the count,
# and a verdict that binds to no open round still counts as a round of its
# own. The builder's head does not reset the count: rounds are per job, not
# per head.
ROUND_CAP_DEFAULT=3
# Operator identities allowed to issue a round-cap extension approval.
# Space-separated; the job's parent lane is always accepted on top of these.
# Fixed in the source: a builder must not be able to widen the trusted issuer
# set through its own environment, or it could approve its own records.
ROUND_CAP_OPERATORS="operator operator-desk mac-personal"
ROUND_CAP_REASON="tester round cap reached"

round_help() {
  cat <<'USAGE'
Usage: wrk round <open|verdict|status> JOB [options]

Formal tester-round bookkeeping for a builder job (#758). A formal round is
one tester verdict recorded for one head. The count is taken only from the
job's events/ stream (job.round and job.verdict records), so renamed or
sub-rounds (r5b) cannot hide: wrk numbers every round itself.

  wrk round open JOB --head SHA [--extend REF]
      Open the next tester round for JOB (a builder job). At the cap
      (default 3 rounds per job) the open is refused with exit 78 and one
      job.escalate naming the job, head, last verdict and findings path is
      emitted to the parent lane; the builder must stop and wait. Past the
      cap an open is allowed only with --extend REF, where REF is
      hk:doc/<key> or hk:task/<id> of an approval record fetched from
      handoffkeep that names the job and the number of extra rounds on a
      grant line:

        round-extension: job=JOB extra=N by=ISSUER

      ISSUER must be the job's parent lane or an operator identity and must
      equal the record's server-side session (doc) or comment author (task).
      Each grant covers <extra> more opens and each open consumes exactly one.
  wrk round verdict JOB --file PATH
      Record the tester's verdict file for the oldest open round that has
      none. PATH must contain a line 'VERDICT: PASS|BLOCKER @<40-hex sha>'.
      A verdict that binds to no open round still counts as a round, so
      verdict files written elsewhere or recorded without an open cannot
      dodge the cap.
  wrk round status JOB
      Print one line: job=… rounds=N cap=N open=… last_verdict=…
USAGE
}

# Scan the job's events stream once and emit one TSV line of key=value fields
# the round commands need:
#   rounds=<N>\topen=<csv|->\tlast_verdict=<V@SHA|->\tlast_findings=<path|->
round_scan() {
  local job="$1"
  python3 - "$(wrk_jobs_root)/$job/events" <<'PY'
import json, os, sys
events = sys.argv[1]
rounds = []          # job.round records in file order
verdicts = []        # job.verdict records in file order
try:
    names = sorted(os.listdir(events))
except OSError:
    names = []
for name in names:
    if not name.endswith(".json"):
        continue
    try:
        with open(os.path.join(events, name), encoding="utf-8") as f:
            o = json.load(f)
    except (OSError, ValueError):
        continue
    if o.get("kind") == "job.round":
        rounds.append(o)
    elif o.get("kind") == "job.verdict":
        verdicts.append(o)
bound = {v.get("round") for v in verdicts if isinstance(v.get("round"), int)}
open_rounds = [str(r.get("round")) for r in rounds
               if isinstance(r.get("round"), int) and r.get("round") not in bound]
used = len(rounds) + sum(1 for v in verdicts if not isinstance(v.get("round"), int))
last = verdicts[-1] if verdicts else {}
lv = "-"
if last.get("verdict") and last.get("head"):
    lv = "%s@%s" % (last["verdict"], last["head"])
lf = last.get("path") or "-"
print("rounds=%d\topen=%s\tlast_verdict=%s\tlast_findings=%s" %
      (used, ",".join(open_rounds) if open_rounds else "-", lv, lf))
PY
}

# Fetch an approval record from handoffkeep. Echoes the raw record text
# (JSON) on stdout; non-zero when the record is absent or handoffkeep fails.
round_approval_fetch() {
  local ref="$1" handoffkeep out rc=0
  handoffkeep="$(command -v "${HANDOFFKEEP_BIN:-handoffkeep}" 2>/dev/null || true)"
  [[ -n "$handoffkeep" ]] || return 1
  case "$ref" in
    hk:doc/?*)  out="$("$handoffkeep" doc get "${ref#hk:doc/}" 2>/dev/null)" || rc=$? ;;
    hk:task/?*) out="$("$handoffkeep" tasks comments "${ref#hk:task/}" 2>/dev/null)" || rc=$? ;;
    *) return 2 ;;
  esac
  [[ "$rc" -eq 0 && -n "$out" && "$out" != not_found ]] || return 1
  printf '%s' "$out"
}

# Verify a fetched approval record and print the granted extra-round count.
# Args: ref, job, parent lane, operators (space separated), record file.
# Prints "granted=<N> issuer=<name>" — nothing else — on success.
round_approval_verify() {
  local ref="$1" job="$2" parent="$3" operators="$4" record="$5"
  python3 - "$ref" "$job" "$parent" "$operators" "$record" <<'PY'
import json, re, sys
ref, job, parent, operators, path = sys.argv[1:]
ops = set(operators.split())
try:
    with open(path, encoding="utf-8") as f:
        raw = f.read()
except OSError:
    raise SystemExit(1)
try:
    doc = json.loads(raw)
except ValueError:
    raise SystemExit(1)
# A grant line names the job, the extra-round count and its issuer, in one
# canonical form — whitespace variants are malformed and rejected.
GRANT = re.compile(
    r"^round-extension: job=(\S+) extra=(\d+) by=(\S+)$")
# The issuer written into the grant line must equal the record's server-side
# identity — a doc's session or a task comment's author — so a builder writing
# 'by=director-1' into its own record cannot pass, and one operator identity
# cannot claim another.
sources = []
if ref.startswith("hk:doc/"):
    if isinstance(doc, dict):
        sources.append((doc.get("session") or "", doc.get("body") or ""))
elif ref.startswith("hk:task/"):
    for c in (doc.get("comments") if isinstance(doc, dict) else None) or []:
        if isinstance(c, dict):
            sources.append((c.get("author") or "", c.get("body") or ""))
allowed_issuers = {parent} | ops
for identity, body in sources:
    for line in body.splitlines():
        m = GRANT.match(line)
        if not m or m.group(1) != job:
            continue
        extra, issuer = int(m.group(2)), m.group(3)
        if extra < 1 or issuer not in allowed_issuers or issuer != identity:
            continue
        print("granted=%d issuer=%s" % (extra, issuer))
        raise SystemExit(0)
raise SystemExit(1)
PY
}

# Emit the round-cap job.escalate (once per job — a repeated refusal must not
# spam the parent lane; #745 was a STOP that sat unread). Prints TSV:
#   emitted\trounds=<N>\tlast_verdict=<v@sha|->\tfindings=<path|->
# or the single token 'duplicate'.
round_cap_event() {
  local job="$1" owner="$2" label="$3" pane="$4" parent="$5" head="$6" cap="$7"
  local events
  events="$(wrk_jobs_root)/$job/events"
  mkdir -p "$events"
  python3 - "$events" "$job" "$owner" "$label" "$pane" "$parent" "${HOSTNAME:-unknown}" "$head" "$cap" <<'PY'
import fcntl, json, os, sys, tempfile
events, job, owner, label, pane, parent, host, head, cap = sys.argv[1:]
cap = int(cap)
lock_path = os.path.join(os.path.dirname(events), ".wrk-events.lock")
with open(lock_path, "w", encoding="utf-8") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    # All state is read under the lock: a stale snapshot would let two racing
    # refusals each think they are first, and a rounds count read before the
    # lock could hide that an extension grant added rounds since.
    records = []
    try:
        names = sorted(os.listdir(events))
    except OSError:
        names = []
    for name in names:
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(events, name), encoding="utf-8") as f:
                records.append(json.load(f))
        except (OSError, ValueError):
            continue
    verdicts = [r for r in records if r.get("kind") == "job.verdict"]
    used = sum(1 for r in records if r.get("kind") == "job.round")
    used += sum(1 for r in verdicts if not isinstance(r.get("round"), int))
    last = verdicts[-1] if verdicts else {}
    lv = "-"
    if last.get("verdict") and last.get("head"):
        lv = "%s@%s" % (last["verdict"], last["head"])
    findings = last.get("path") or ""
    # Dedupe is scoped to the rounds count: a repeated refusal at the same
    # count is a duplicate, but a refusal at a higher count — rounds an
    # extension grant added since the last escalate — is a new signal the
    # parent must see. #745 was a stop nobody read.
    for r in records:
        if (r.get("kind") == "job.escalate"
                and r.get("reason") == "tester round cap reached"
                and isinstance(r.get("rounds"), int) and r["rounds"] >= used):
            print("duplicate")
            raise SystemExit(0)
    highest = 0
    for name in names:
        try:
            highest = max(highest, int(name.split("-", 1)[0]))
        except (ValueError, IndexError):
            pass
    question = ("tester round cap %d reached at %d rounds; builder must stop "
                "and wait for the parent; extension needs a hk approval "
                "record naming this job (wrk round open --extend REF)"
                % (cap, used))
    record = {"kind": "job.escalate", "job_id": job, "owner_lane": owner,
              "label": label, "pane_id": pane, "host": host,
              "report_path": findings, "report_last_line": lv,
              "reason": "tester round cap reached", "question": question,
              "parent_lane": parent, "head": head, "rounds": used,
              "cap": cap, "last_verdict": lv, "findings_path": findings,
              "epoch": 1}
    fd, temporary = tempfile.mkstemp(prefix=".completion-", dir=events)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(record, f, separators=(",", ":"))
            f.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, os.path.join(events, "%05d-job.escalate.json" % (highest + 1)))
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
print("emitted\trounds=%d\tlast_verdict=%s\tfindings=%s" % (used, lv, findings or "-"))
PY
}

round_open_cmd() {
  local job="${1:-}" head="" extend="" metadata owner label pane parent role
  [[ -n "$job" && "$job" != -* ]] || die "round open requires a job id"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --head) [[ $# -ge 2 && -n "$2" ]] || die "--head requires a SHA"; head="$2"; shift 2 ;;
      --extend) [[ $# -ge 2 && -n "$2" ]] || die "--extend requires a hk:doc/<key> or hk:task/<id> ref"; extend="$2"; shift 2 ;;
      *) die "unknown round open option '$1'" ;;
    esac
  done
  [[ "$head" =~ ^[0-9a-fA-F]{40}$ ]] || die "round open --head requires a full 40-hex SHA"
  head="$(printf '%s' "$head" | tr '[:upper:]' '[:lower:]')"
  metadata="$(builder_metadata "$job")"
  IFS=$'\t' read -r owner label pane parent role <<<"$metadata"

  # An extension is approved before the count is consulted: the fetched hk
  # record must carry a valid grant line for this job from an allowed issuer.
  local grant="" grant_extra=0 grant_issuer=""
  if [[ -n "$extend" ]]; then
    local tmp_approval
    tmp_approval="$(mktemp)"
    if ! round_approval_fetch "$extend" >"$tmp_approval"; then
      rm -f "$tmp_approval"
      die "round open --extend: approval record not found in handoffkeep: $extend"
    fi
    grant="$(round_approval_verify "$extend" "$job" "$parent" "$ROUND_CAP_OPERATORS" "$tmp_approval" || true)"
    rm -f "$tmp_approval"
    [[ -n "$grant" ]] ||
      die "round open --extend: $extend holds no 'round-extension: job=$job extra=N by=<parent-lane|operator>' grant backed by the record's session/author"
    grant_extra="${grant#granted=}"; grant_extra="${grant_extra%% *}"
    grant_issuer="${grant##*issuer=}"
  fi

  # Round count and decision run under the events lock so a verdict landing
  # concurrently cannot slip a second open past the cap.
  local outcome rc=0
  set +e
  outcome="$(python3 - "$(wrk_jobs_root)/$job/events" "$job" "$owner" "$label" "$pane" "$parent" "$head" "$ROUND_CAP_DEFAULT" "$extend" "$grant_extra" "$grant_issuer" <<'PY'
import fcntl, json, os, sys, tempfile
(events, job, owner, label, pane, parent, head, cap,
 extend_ref, grant_extra, grant_issuer) = sys.argv[1:]
cap, grant_extra = int(cap), int(grant_extra)
os.makedirs(events, exist_ok=True)
lock_path = os.path.join(os.path.dirname(events), ".wrk-events.lock")
with open(lock_path, "w", encoding="utf-8") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    records = []
    for name in sorted(os.listdir(events)):
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(events, name), encoding="utf-8") as f:
                records.append(json.load(f))
        except (OSError, ValueError):
            continue
    rounds = [r for r in records if r.get("kind") == "job.round"]
    verdicts = [r for r in records if r.get("kind") == "job.verdict"]
    used = len(rounds) + sum(1 for v in verdicts if not isinstance(v.get("round"), int))
    approval = None
    if used >= cap:
        if not extend_ref:
            print("CAP rounds=%d" % used)
            raise SystemExit(0)
        # Each grant covers <extra> opens past the cap; one open consumes one.
        consumed = sum(1 for r in rounds
                       if (r.get("approval") or {}).get("ref") == extend_ref)
        if consumed >= grant_extra:
            print("CAP rounds=%d" % used)
            raise SystemExit(0)
        approval = {"ref": extend_ref, "issuer": grant_issuer, "extra": grant_extra}
    elif extend_ref:
        print("EXTEND_BEFORE_CAP")
        raise SystemExit(0)
    highest = 0
    for name in os.listdir(events):
        try:
            highest = max(highest, int(name.split("-", 1)[0]))
        except (ValueError, IndexError):
            pass
    record = {"kind": "job.round", "job_id": job, "owner_lane": owner,
              "label": label, "pane_id": pane, "parent_lane": parent,
              "head": head.lower(), "round": used + 1, "epoch": 1}
    if approval:
        record["approval"] = approval
    fd, temporary = tempfile.mkstemp(prefix=".completion-", dir=events)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(record, f, separators=(",", ":"))
            f.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, os.path.join(events, "%05d-job.round.json" % (highest + 1)))
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print("OPENED round=%d" % (used + 1))
PY
)"
  rc=$?
  set -e
  [[ "$rc" -eq 0 ]] || die "round open failed to inspect $job"
  case "$outcome" in
    OPENED\ round=*)
      echo "OK job=$job ${outcome#OPENED } cap=$ROUND_CAP_DEFAULT head=$head"
      ;;
    EXTEND_BEFORE_CAP)
      die "round open --extend is only valid once the cap ($ROUND_CAP_DEFAULT) is reached"
      ;;
    CAP\ rounds=*)
      # The refusal is itself an event the parent must see: emit the
      # escalate (deduped per job) and then stop the caller with rc 78.
      local rounds last_v findings status question
      status="$(round_cap_event "$job" "$owner" "$label" "$pane" "$parent" "$head" "$ROUND_CAP_DEFAULT")"
      if [[ "$status" == emitted* ]]; then
        IFS=$'\t' read -r _ rounds last_v findings <<<"$status"
        findings="${findings#findings=}"
        [[ "$findings" == "-" ]] && findings=""
        question="tester round cap $ROUND_CAP_DEFAULT reached at ${rounds#rounds=} rounds; builder must stop and wait for the parent; extension needs a hk approval record naming this job (wrk round open --extend REF)"
        emit_relay_event job.escalate "$job" "$owner" "$label" "$pane" "${HOSTNAME:-unknown}" \
          "$findings" "${last_v#last_verdict=}" "$ROUND_CAP_REASON" "$question" "" "$head"
        warn "round cap $ROUND_CAP_DEFAULT reached for $job (${rounds#rounds=} rounds); emitted job.escalate to parent $parent"
      else
        warn "round cap $ROUND_CAP_DEFAULT still reached for $job; job.escalate already recorded"
      fi
      exit "$WRK_EXIT_ROUND_CAP"
      ;;
    *) die "round open unexpected outcome: $outcome" ;;
  esac
}

round_verdict_cmd() {
  local job="${1:-}" file="" metadata owner label pane parent role
  [[ -n "$job" && "$job" != -* ]] || die "round verdict requires a job id"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --file) [[ $# -ge 2 && -n "$2" ]] || die "--file requires a path"; file="$2"; shift 2 ;;
      *) die "unknown round verdict option '$1'" ;;
    esac
  done
  [[ -n "$file" && -f "$file" ]] || die "round verdict requires an existing --file"
  metadata="$(builder_metadata "$job")"
  IFS=$'\t' read -r owner label pane parent role <<<"$metadata"
  local outcome rc=0
  set +e
  outcome="$(python3 - "$(wrk_jobs_root)/$job/events" "$job" "$owner" "$label" "$pane" "$parent" "$file" "$ROUND_CAP_DEFAULT" <<'PY'
import fcntl, json, os, re, sys, tempfile
events, job, owner, label, pane, parent, vfile, cap = sys.argv[1:]
cap = int(cap)
os.makedirs(events, exist_ok=True)
verdict = vsha = None
VERDICT = re.compile(r"^VERDICT: (PASS|BLOCKER) @([0-9a-fA-F]{40})\s*$")
matches = []
try:
    with open(vfile, encoding="utf-8") as f:
        for line in f:
            m = VERDICT.match(line)
            if m:
                matches.append(m)
except OSError:
    pass
if not matches:
    print("NO_VERDICT")
    raise SystemExit(0)
if len(matches) > 1:
    print("AMBIGUOUS")
    raise SystemExit(0)
verdict, vsha = matches[0].group(1), matches[0].group(2).lower()
lock_path = os.path.join(os.path.dirname(events), ".wrk-events.lock")
with open(lock_path, "w", encoding="utf-8") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    records = []
    for name in sorted(os.listdir(events)):
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(events, name), encoding="utf-8") as f:
                records.append(json.load(f))
        except (OSError, ValueError):
            continue
    rounds = [r for r in records if r.get("kind") == "job.round"]
    verdicts = [r for r in records if r.get("kind") == "job.verdict"]
    bound = {v.get("round") for v in verdicts if isinstance(v.get("round"), int)}
    target = None
    for r in rounds:
        if isinstance(r.get("round"), int) and r.get("round") not in bound:
            target = r["round"]
            break
    used = len(rounds) + sum(1 for v in verdicts if not isinstance(v.get("round"), int))
    if target is None:
        used += 1  # this unbound verdict is itself a round
    highest = 0
    for name in os.listdir(events):
        try:
            highest = max(highest, int(name.split("-", 1)[0]))
        except (ValueError, IndexError):
            pass
    record = {"kind": "job.verdict", "job_id": job, "owner_lane": owner,
              "label": label, "pane_id": pane, "parent_lane": parent,
              "verdict": verdict, "head": vsha, "path": os.path.abspath(vfile),
              "round": target, "epoch": 1}
    if target is None:
        record["unopened"] = True
    fd, temporary = tempfile.mkstemp(prefix=".completion-", dir=events)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(record, f, separators=(",", ":"))
            f.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, os.path.join(events, "%05d-job.verdict.json" % (highest + 1)))
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    over = target is None and used > cap
    print("RECORDED round=%s verdict=%s head=%s used=%d over=%d" %
          (target if target is not None else "unopened", verdict, vsha, used, int(over)))
PY
)"
  rc=$?
  set -e
  [[ "$rc" -eq 0 ]] || die "round verdict failed to inspect $job"
  case "$outcome" in
    NO_VERDICT)
      die "round verdict --file has no 'VERDICT: PASS|BLOCKER @<40-hex sha>' line: $file" ;;
    AMBIGUOUS)
      die "round verdict --file has more than one VERDICT line: $file" ;;
    RECORDED*)
      local round_no="" verdict_v="" head_v="" used_v="" over_v="" status question tok
      for tok in $outcome; do
        case "$tok" in
          round=*) round_no="${tok#round=}" ;;
          verdict=*) verdict_v="${tok#verdict=}" ;;
          head=*) head_v="${tok#head=}" ;;
          used=*) used_v="${tok#used=}" ;;
          over=*) over_v="${tok#over=}" ;;
        esac
      done
      if [[ "$round_no" == unopened ]]; then
        warn "verdict bound to no open round; counted as a round itself (job=$job rounds=$used_v)"
        if [[ "$over_v" == 1 ]]; then
          status="$(round_cap_event "$job" "$owner" "$label" "$pane" "$parent" "$head_v" "$ROUND_CAP_DEFAULT")"
          if [[ "$status" == emitted* ]]; then
            question="tester round cap $ROUND_CAP_DEFAULT reached at $used_v rounds; builder must stop and wait for the parent; extension needs a hk approval record naming this job (wrk round open --extend REF)"
            emit_relay_event job.escalate "$job" "$owner" "$label" "$pane" "${HOSTNAME:-unknown}" \
              "$file" "$verdict_v@$head_v" "$ROUND_CAP_REASON" "$question" "" "$head_v"
            warn "round cap $ROUND_CAP_DEFAULT reached for $job ($used_v rounds); emitted job.escalate to parent $parent"
          fi
          echo "OK job=$job verdict=$verdict_v head=$head_v round=unopened rounds=$used_v cap=$ROUND_CAP_DEFAULT"
          exit "$WRK_EXIT_ROUND_CAP"
        fi
      fi
      echo "OK job=$job verdict=$verdict_v head=$head_v round=$round_no rounds=$used_v cap=$ROUND_CAP_DEFAULT"
      ;;
    *) die "round verdict unexpected outcome: $outcome" ;;
  esac
}

round_status_cmd() {
  local job="${1:-}"
  [[ -n "$job" && "$job" != -* ]] || die "round status requires a job id"
  [[ $# -eq 1 ]] || die "round status accepts only a job id"
  local scan
  scan="$(round_scan "$job")"
  echo "job=$job cap=$ROUND_CAP_DEFAULT $scan"
}

round_cmd() {
  local sub="${1:-}"
  case "$sub" in
    -h|--help|"") round_help ;;
    open) shift; round_open_cmd "$@" ;;
    verdict) shift; round_verdict_cmd "$@" ;;
    status) shift; round_status_cmd "$@" ;;
    *) die "unknown round subcommand '$sub' (see 'wrk round --help')" ;;
  esac
}

# herdr 관측 3분류. 확정 소멸(gone)만 job.lost 로 이어지고, 나머지 장애는 일시
# 장애(transient)로 재시도한다. 빈 출력은 소멸의 증거가 아니다 — 소켓 일시 정지,
# 서버가 다른 세션에 있는 호스트, 타임아웃 모두 빈 출력을 낸다(2026-09-04: 그날
# 스폰한 거의 모든 잡이 30초 만에 job.lost 로 찍히고 센티널이 죽어, 워커가 정상
# 완료해도 job.completed 를 아무도 쓰지 못했다).
SENTINEL_GONE_CODES="agent_not_found pane_not_found tab_not_found terminal_not_found no_such_agent no_such_pane"

# "<class><TAB><token><TAB><tab_id>" 를 출력한다.
#   class ∈ ok|transient|gone
#   token = 로그의 status 필드(상태 이름 | empty | err:<code>)
herdr_agent_probe() {
  local pane="$1" out="" rc=0
  set +e
  # 🔴 두 스트림을 함께 읽는다. herdr 는 에러 봉투를 **stderr** 로 내보내고 1 로
  # 끝낸다(2026-09-05 실측: `{"error":{"code":"agent_not_found",…}}` 가 stderr).
  # stdout 만 보면 확정 소멸이 영원히 "빈 값" 으로 보인다.
  out="$("$HERDR" agent get "$pane" 2>&1)"
  rc=$?
  set -e
  python3 - "$rc" "$SENTINEL_GONE_CODES" "$out" <<'PY' 2>/dev/null || printf 'transient\terr:probe\t\n'
import json, sys

rc, gone_codes, raw = sys.argv[1], set(sys.argv[2].split()), sys.argv[3].strip()


def emit(kind, token, tab=""):
    print(kind, token, tab, sep="\t")
    raise SystemExit(0)


def documents(text):
    """봉투가 로그 줄과 섞여 와도 JSON 만 골라낸다."""
    try:
        yield json.loads(text)
        return
    except ValueError:
        pass
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            yield json.loads(line)
        except ValueError:
            continue


def status_and_tab(document):
    # 실 herdr: {"result":{"agent":{"agent_status":…,"tab_id":…}}}.
    # 옛 응답(result 바로 아래)과 agent_info 변형도 함께 받는다.
    result = document.get("result", document)
    if not isinstance(result, dict):
        return "", ""
    scopes = [result]
    for key in ("agent", "agent_info", "pane"):
        value = result.get(key)
        if isinstance(value, dict):
            scopes.append(value)
    for scope in scopes:
        status = scope.get("agent_status")
        if isinstance(status, str) and status.strip():
            tab = scope.get("tab_id") or result.get("tab_id") or ""
            return status.strip(), tab if isinstance(tab, str) else ""
    return "", ""


if not raw:
    emit("transient", "empty" if rc == "0" else "err:exit%s" % rc)
for document in documents(raw):
    if not isinstance(document, dict):
        continue
    error = document.get("error")
    if isinstance(error, str):
        error = {"code": error}
    if isinstance(error, dict):
        code = error.get("code") or error.get("message") or "unknown"
        code = "_".join(str(code).split())[:64]
        emit("gone" if code in gone_codes else "transient", "err:%s" % code)
    status, tab = status_and_tab(document)
    if status:
        emit("ok", status, tab)
emit("transient", "err:parse")
PY
}

# 판정 1건 = 로그 1줄. 회전은 없다(잡 디렉토리 수명과 같다).
sentinel_log() {
  local logfile="$1" token="$2" transient="$3" action="$4"
  printf '%s status=%s transient=%s action=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$token" "$transient" "$action" >>"$logfile" 2>/dev/null || true
}

# ── #770: job-end housekeeping ────────────────────────────────────────────
# A job that ended must not leave three things behind: an "active" hub/arbiter
# record, a live completion sentinel, or the sentinel's interval sleep child.
# The helpers below are shared by every end path (wrk done / joined, the
# sentinel's own completed/lost judgements, wrk reap, wrk prune).
#
# Terminal vocabulary here is deliberately narrower than "work is over":
#   WORK_TERMINAL = what ends this job's lifecycle (completed, completion,
#                   joined, revoked, reaped — job.lost is NOT one: the record
#                   is an observation gap, and a lost job may still complete)
#   HUB_TERMINAL  = what the hub and the node active-scan actually end on
#                   (completed, completion, revoked — joined relays but keeps
#                   the job counted, lost is explicitly not terminal)
#   REVIVE        = a record that proves the job was picked up again
#                   (claim/claimed/reclaim/spawned/reprompted after a terminal
#                   un-ends it — the newest record wins, as in wrk reap)

# job_events_scan EVENTS_DIR... — one TSV row per job:
#   job \t ended \t hub_ended \t terminal_kind \t last_event_age_s \t last_kind
#       \t completed_n \t owner \t label \t pane \t tab
# ended         a work-terminal record exists after the newest revive
# hub_ended     a hub-terminal record exists after the newest revive
# terminal_kind the newest work-terminal kind ("-" when not ended)
# completed_n   completed/completion records written after the newest revive
# pane/tab      the newest job.spawned receipt's values — same source of truth
#               as wrk reap; "-" when the job never spawned
job_events_scan() {
  python3 - "$@" <<'PY'
import datetime, json, os, sys, time

WORK_TERMINAL = {"job.completed", "job.completion", "job.joined", "job.revoked", "job.reaped"}
HUB_TERMINAL = {"job.completed", "job.completion", "job.revoked"}
REVIVE = {"job.claim", "job.claimed", "job.reclaim", "job.spawned", "job.reprompted"}
now = time.time()


def moment(value, fallback):
    if isinstance(value, str) and value.strip():
        try:
            parsed = datetime.datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
            if parsed.tzinfo is None:
                parsed = parsed.astimezone()
            return parsed.timestamp()
        except ValueError:
            pass
    return fallback


def field(doc, payload, key):
    for source in (doc, payload):
        value = source.get(key)
        if isinstance(value, str) and value:
            return value
    return ""


for events in sys.argv[1:]:
    job = os.path.basename(os.path.dirname(os.path.normpath(events)))
    owner = label = pane = tab = ""
    kinds = []
    last_t = 0.0
    last_kind = ""
    try:
        names = sorted(os.listdir(events))
    except OSError:
        names = []
    for name in names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(events, name)
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            mtime = now
        try:
            with open(path, encoding="utf-8") as handle:
                doc = json.load(handle)
        except (OSError, ValueError):
            doc = None
        if not isinstance(doc, dict):
            # An unreadable event file is still activity evidence for aging,
            # but contributes nothing else.
            last_t = max(last_t, mtime)
            continue
        payload = doc.get("payload")
        if not isinstance(payload, dict):
            payload = {}
        kind = doc.get("kind") or doc.get("type") or doc.get("event") or ""
        when = moment(doc.get("created_at") or payload.get("at"), mtime)
        if when >= last_t:
            last_t, last_kind = when, kind or last_kind
        kinds.append(kind)
        if kind in ("job.claim", "job.claimed", "job.reclaim"):
            owner = field(doc, payload, "owner_lane") or owner
            label = field(doc, payload, "label") or field(doc, payload, "agent_label") or label
        if kind == "job.spawned":
            pane = field(doc, payload, "pane_id")
            tab = field(doc, payload, "tab_id")
    last_revive = -1
    for index, kind in enumerate(kinds):
        if kind in REVIVE:
            last_revive = index
    term_kind = ""
    hub_ended = 0
    completed_n = 0
    for index, kind in enumerate(kinds):
        if index <= last_revive:
            continue
        if kind in WORK_TERMINAL:
            term_kind = kind
        if kind in HUB_TERMINAL:
            hub_ended = 1
        if kind in ("job.completed", "job.completion"):
            completed_n += 1
    ended = 1 if term_kind else 0
    age = int(now - last_t) if last_t else -1
    print(job, ended, hub_ended, term_kind or "-", age, last_kind or "-",
          completed_n, owner or "-", label or "-", pane or "-", tab or "-", sep="\t")
PY
}

# job_end_record JOB OWNER OUTCOME REASON SOURCE — append the flat job.revoked
# end declaration. The hub ends a job only on job.completed/job.revoked, so a
# job whose newest terminal is joined or lost still counts "active" until this
# marker lands. Skips when a hub-terminal record already follows the newest
# revive (already-ended) or when a revive is newest (the job is live again —
# ending it would be wrong). Prints created|already-ended|active.
job_end_record() {
  local job="$1" owner="$2" outcome="$3" reason="$4" source="$5" events
  events="$(wrk_jobs_root)/$job/events"
  mkdir -p "$events" || return 1
  python3 - "$events" "$job" "$owner" "$outcome" "$reason" "$source" "${HOSTNAME:-unknown}" <<'PY'
import datetime, fcntl, json, os, sys, tempfile

events, job, owner, outcome, reason, source, host = sys.argv[1:]
WORK_TERMINAL = {"job.completed", "job.completion", "job.joined", "job.revoked", "job.reaped"}
HUB_TERMINAL = {"job.completed", "job.completion", "job.revoked"}
REVIVE = {"job.claim", "job.claimed", "job.reclaim", "job.spawned", "job.reprompted"}

# The events lock is shared with completion_event so the "is it already
# ended" check and the append are one atomic step — `wrk done`, the sentinel
# and prune race on this directory.
lock_path = os.path.join(os.path.dirname(events), ".wrk-events.lock")
with open(lock_path, "w", encoding="utf-8") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    highest = 0
    kinds = []
    try:
        names = sorted(os.listdir(events))
    except OSError:
        names = []
    for name in names:
        if not name.endswith(".json"):
            continue
        try:
            highest = max(highest, int(name.split("-", 1)[0]))
        except (ValueError, IndexError):
            pass
        try:
            with open(os.path.join(events, name), encoding="utf-8") as handle:
                doc = json.load(handle)
        except (OSError, ValueError):
            continue
        if not isinstance(doc, dict):
            continue
        kinds.append(doc.get("kind") or doc.get("type") or doc.get("event") or "")
    last_revive = -1
    last_term = -1
    last_hub = -1
    for index, kind in enumerate(kinds):
        if kind in REVIVE:
            last_revive = index
        if kind in WORK_TERMINAL:
            last_term = index
        if kind in HUB_TERMINAL:
            last_hub = index
    if last_hub > -1 and last_hub > last_revive:
        print("already-ended")
        raise SystemExit(0)
    if last_term > -1 and last_revive > last_term:
        # Terminal first, then a claim/spawned again — the job was picked up
        # after it ended and is live work; never end it from housekeeping.
        print("active")
        raise SystemExit(0)
    record = {"kind": "job.revoked", "job_id": job, "epoch": 1,
              "owner_lane": owner, "outcome": outcome, "reason": reason,
              "source": source, "host": host,
              "created_at": datetime.datetime.now(datetime.timezone.utc)
              .isoformat(timespec="seconds").replace("+00:00", "Z")}
    fd, temporary = tempfile.mkstemp(prefix=".ended-", dir=events)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(record, handle, separators=(",", ":"))
            handle.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, os.path.join(events, "%05d-job.revoked.json" % (highest + 1)))
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print("created")
PY
}

# release_job_quota_pool JOB — release every quota_pool record this job still
# holds so the arbiter-side job record flips to released. Best-effort: an
# unavailable arbiter, an empty status, or a missing record only costs a
# retained row, never a failed end path.
release_job_quota_pool() {
  local job="$1" arb out pool
  arb="${ARBITER:-}"
  [[ -n "$arb" ]] || arb="$(command -v arbiter 2>/dev/null || true)"
  [[ -n "$arb" && -x "$arb" ]] || return 0
  out="$("$arb" status --job "$job" --json 2>/dev/null)" || return 0
  while IFS= read -r pool; do
    [[ -n "$pool" ]] || continue
    "$arb" release --job "$job" --resource "$pool" --kind quota_pool >/dev/null 2>&1 || true
  done < <(python3 -c 'import json, sys
try:
    doc = json.loads(sys.argv[1])
except ValueError:
    raise SystemExit(0)
for row in doc.get("quota_pool_records") or []:
    pool = row.get("pool")
    if isinstance(pool, str) and pool:
        print(pool)' "$out" 2>/dev/null || true)
  return 0
}

# PID-reuse guard, part 1: the recorded pid is only ever this job's sentinel
# when its argv is literally `…/wrk sentinel JOB OWNER LABEL PANE [REPORT …]`.
# The token before `sentinel` must be the wrk program itself — argv[0], or
# argv[1] behind the interpreter the kernel inserts for the shebang — and the
# full owner/label/pane tail must be present. `wrk sentinel JOB` appearing as
# mere arguments inside an unrelated command line (a python fixture carrying
# a fake triple, an editor buffer, a log line) never matches.
sentinel_pid_matches() {
  local pid="$1" job="$2"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  ps -p "$pid" -o args= 2>/dev/null | awk -v job="$job" '
    function is_shell(tok) { sub(/^.*\//, "", tok); return tok ~ /^(sh|bash|zsh|dash|ksh)$/ }
    {
      for (i = 1; i <= NF; i++)
        if ($i ~ /(^|\/)wrk$/ && $(i + 1) == "sentinel" && $(i + 2) == job &&
            NF >= i + 5 && (i == 1 || (i == 2 && is_shell($1)))) { found = 1; break }
    }
    END { exit(found ? 0 : 1) }'
}

# sentinel_pidfile_fields FILE — print "pid<TAB>started" parsed from a
# completion-sentinel pidfile. Current files are two lines ("PID" then
# "started=EPOCH"); bare numeric legacy pidfiles and flat "pid=N started=E"
# forms parse identically. Missing or unparseable fields print empty — an
# empty field never proves identity.
sentinel_pidfile_fields() {
  local file="$1" line="" extra="" tok pid="" started=""
  if [[ -s "$file" ]]; then
    { IFS= read -r line; IFS= read -r extra || extra=""; } <"$file" 2>/dev/null || true
    for tok in $line $extra; do
      case "$tok" in
        pid=*) pid="${tok#pid=}" ;;
        started=*) started="${tok#started=}" ;;
        *)
          if [[ -z "$pid" && "$tok" =~ ^[0-9]+$ ]]; then pid="$tok"; fi ;;
      esac
    done
  fi
  printf '%s\t%s\n' "$pid" "$started"
}

# PID-reuse guard, part 2: when a pidfile recorded the sentinel's spawn time,
# the live process's real elapsed age must agree with it (±120s skew window —
# the file is written a moment after fork). No recorded start, no verdict;
# a malformed recorded start is never positive identity.
sentinel_start_matches() {
  local pid="$1" started="${2:-}"
  [[ -n "$started" ]] || return 0
  [[ "$started" =~ ^[0-9]+$ ]] || return 1
  local el skew
  el="$(proc_elapsed_s "$pid" 2>/dev/null)" || return 1
  skew=$(( $(date +%s) - started - el ))
  (( skew >= -120 && skew <= 120 ))
}

# kill -0 alone reports zombies as alive; the sentinel is reparented to launchd
# so its post-TERM zombie window is short but real.
sentinel_pid_alive() {
  local pid="$1" state
  kill -0 "$pid" 2>/dev/null || return 1
  state="$(ps -p "$pid" -o stat= 2>/dev/null || true)"
  state="${state//[[:space:]]/}"
  [[ "$state" == Z* ]] && return 1
  return 0
}

# sentinel_sweep — one TSV row per live `wrk sentinel …` process on the host:
#   pid \t job \t owner \t label \t pane \t report
# The process sweep is the only way to find a sentinel that has no pidfile
# (respawned or second instance) — prune uses it to list, end paths use it
# so no copy survives the job (tester BLOCKER 2).
sentinel_sweep() {
  ps axo pid=,args= 2>/dev/null | awk '
    function is_shell(tok) { sub(/^.*\//, "", tok); return tok ~ /^(sh|bash|zsh|dash|ksh)$/ }
    {
      pid = $1
      for (i = 2; i <= NF; i++)
        if ($i ~ /(^|\/)wrk$/ && $(i + 1) == "sentinel" && $(i + 2) != "" &&
            NF >= i + 5 && (i == 2 || (i == 3 && is_shell($2)))) {
          print pid "\t" $(i+2) "\t" $(i+3) "\t" $(i+4) "\t" $(i+5) "\t" $(i+6)
          break
        }
    }' | sort -k2,2 -k1,1n
}

# stop_completion_sentinel JOB [PID] — stop and wait on the job's completion
# sentinel and its interval sleep child. With an explicit PID only that
# (argv-verified) process is signalled — prune uses it for one orphan row.
# Without one, the pidfile pid AND every live `wrk sentinel JOB` the process
# sweep finds are stopped: a respawned or second sentinel has no pidfile and
# would otherwise outlive the end path (tester BLOCKER 2). The pidfile is
# removed regardless of outcome so a dead handle never looks live.
stop_completion_sentinel() {
  local job="$1" explicit_pid="${2:-}" jobdir pidfile pid child deadline
  jobdir="$(wrk_jobs_root)/$job"
  pidfile="$jobdir/completion-sentinel.pid"
  local -a pids=()
  local pidfile_pid="" pidfile_started=""
  if [[ -n "$explicit_pid" ]]; then
    pids=("$explicit_pid")
  else
    if [[ -s "$pidfile" ]]; then
      IFS=$'\t' read -r pidfile_pid pidfile_started <<<"$(sentinel_pidfile_fields "$pidfile")"
      [[ "$pidfile_pid" =~ ^[0-9]+$ ]] && pids+=("$pidfile_pid")
    fi
    local _p _j _seen _dup
    while IFS=$'\t' read -r _p _j _rest; do
      [[ "$_j" == "$job" ]] || continue
      _dup=0
      for _seen in ${pids[@]+"${pids[@]}"}; do
        [[ "$_seen" == "$_p" ]] && { _dup=1; break; }
      done
      (( _dup )) || pids+=("$_p")
    done < <(sentinel_sweep)
  fi
  for pid in ${pids[@]+"${pids[@]}"}; do
    local _st=""
    if [[ "$pid" == "$pidfile_pid" ]]; then _st="$pidfile_started"; fi
    if [[ "$pid" =~ ^[0-9]+$ ]] && sentinel_pid_matches "$pid" "$job" && sentinel_start_matches "$pid" "$_st"; then
      # Freeze first so a sentinel waking mid-stop cannot fork a new sleep
      # between the child enumeration and the signal batch (the test suites'
      # cleanup uses this same STOP → kill children → TERM → CONT order).
      kill -STOP "$pid" 2>/dev/null || true
      while IFS= read -r child; do
        kill "$child" 2>/dev/null || true
      done < <(pgrep -P "$pid" 2>/dev/null || true)
      kill "$pid" 2>/dev/null || true
      kill -CONT "$pid" 2>/dev/null || true
      deadline=$(( $(date +%s) + ${WRK_SENTINEL_STOP_WAIT_S:-5} ))
      while sentinel_pid_alive "$pid"; do
        if (( $(date +%s) >= deadline )); then
          kill -9 "$pid" 2>/dev/null || true
          deadline=$(( $(date +%s) + 2 ))
          while sentinel_pid_alive "$pid" && (( $(date +%s) < deadline )); do
            sleep 0.1
          done
          break
        fi
        sleep 0.1
      done
    fi
  done
  rm -f "$pidfile" 2>/dev/null || true
  return 0
}

# job_end_housekeeping JOB OWNER OUTCOME REASON SOURCE — one call at every end
# path: declare the job ended to the hub when its terminal record is not
# hub-terminal on its own, release the quota_pool record, and stop + wait on
# the completion sentinel. Every step is best-effort; a housekeeping failure
# must never mask the record the caller just wrote.
job_end_housekeeping() {
  local job="$1" owner="$2" outcome="$3" reason="$4" source="$5"
  job_end_record "$job" "$owner" "$outcome" "$reason" "$source" >/dev/null ||
    warn "job end declaration write failed for $job; the records stay file-only"
  release_job_quota_pool "$job"
  stop_completion_sentinel "$job"
  return 0
}

# sentinel_job_ended JOBDIR — the job's event stream already carries a
# work-terminal record newer than every revive: some other end path (done,
# joined, reap, prune — or a second sentinel) finished the job while this
# sentinel was asleep, so the sentinel itself is now an orphan.
sentinel_job_ended() {
  job_events_scan "$1/events" | awk -F'\t' '$2 == 1 { found = 1 } END { exit(found ? 0 : 1) }'
}

# sentinel_self_exit JOB [RC] — remove our own pidfile only when it still
# names us (a respawned sentinel may already have overwritten it), then exit.
sentinel_self_exit() {
  local job="$1" code="${2:-0}" pidfile pf
  pidfile="$(wrk_jobs_root)/$job/completion-sentinel.pid"
  read -r pf <"$pidfile" 2>/dev/null || pf=""
  [[ "$pf" == "$$" ]] && rm -f "$pidfile"
  exit "$code"
}

sentinel_cmd() {
  local job="${1:-}" owner="${2:-}" label="${3:-}" pane="${4:-}" report="${5:-}" resource="${6:-}"
  local timeout="${WRK_COMPLETION_TIMEOUT_S:-21600}"
  local interval="${WRK_COMPLETION_INTERVAL_S:-30}"
  local transient_max="${WRK_SENTINEL_TRANSIENT_MAX:-10}"
  local lost_grace="${WRK_SENTINEL_LOST_GRACE:-1800}"
  [[ -n "$job" && -n "$owner" && -n "$label" && -n "$pane" ]] || exit 2
  local jobdir logfile started seen pending transient lost lost_at
  jobdir="$(wrk_jobs_root)/$job"
  mkdir -p "$jobdir"
  logfile="$jobdir/completion-sentinel.log"
  started="$(date +%s)"
  seen=""
  pending=""
  transient=0
  lost=0
  lost_at=0
  while :; do
    local now probe class token candidate key action
    now="$(date +%s)"
    probe="$(herdr_agent_probe "$pane")"
    IFS=$'\t' read -r class token _ <<<"$probe"
    action=none
    candidate=""
    key=""
    case "$class" in
      gone)
        transient=0
        if [[ "$lost" -eq 0 ]]; then action="lost:agent_not_found"; fi
        ;;
      ok)
        transient=0
        candidate="$report"
        if [[ -z "$candidate" || ! -f "$candidate" ]]; then
          candidate="$(find_latest_report "$jobdir")"
        fi
        key="$(report_observation_key "$candidate" 2>/dev/null || true)"
        if [[ ( "$token" == "done" || "$token" == "idle" ) && -n "$candidate" && -f "$candidate" && -n "$key" && "$key" != "$seen" ]]; then
          # 부분 작성된 report 로 먼저 나가지 않는다: observation key 가 한
          # interval 동안 그대로일 때만 완료로 판정한다. 첫 관측은 pending.
          if [[ "$key" == "$pending" ]]; then
            action=completed
          else
            pending="$key"
            action=pending
          fi
        fi
        ;;
      *)
        # 일시 장애. 연속 관측 실패가 임계를 넘을 때에만 소멸로 판정한다.
        transient=$(( transient + 1 ))
        if [[ "$lost" -eq 0 ]] && (( transient > transient_max )); then
          action="lost:herdr_unreachable"
        fi
        ;;
    esac
    if [[ "$action" == none && "$lost" -eq 0 ]] && (( now - started >= timeout )); then
      action="lost:timeout"
    fi
    sentinel_log "$logfile" "$token" "$transient" "$action"
    # #770: the job may have ended by another path while the sentinel slept —
    # done/joined/reap/prune all leave a work-terminal record. A terminal is
    # only honoured when it is newer than every revive, so a job claimed back
    # keeps its watcher.
    if sentinel_job_ended "$jobdir"; then
      sentinel_log "$logfile" "$token" "$transient" "watch-exit"
      sentinel_self_exit "$job" 0
    fi
    case "$action" in
      completed)
        local completion_status
        completion_status="$(completion_event "$job" "$owner" "$label" "$pane" "$candidate")"
        seen="$key"
        if [[ "$completion_status" == duplicate ]]; then
          note_duplicate_completion "$job" "$candidate"
          warn "job.completed already recorded for this report; suppressed duplicate (job=$job)"
        fi
        [[ -z "$resource" || ! -x "$ARBITER" ]] || "$ARBITER" release --job "$job" --resource "$resource" --kind quota_pool >/dev/null 2>&1 || true
        # #770: completed — including post-loss completion — ends the job, so
        # the sentinel leaves with it instead of becoming the leftover process
        # this task exists to remove.
        sentinel_self_exit "$job" 0
        ;;
      lost:*)
        completion_event "$job" "$owner" "$label" "$pane" "${report:-/dev/null}" job.lost "${action#lost:}" >/dev/null
        lost=1
        lost_at="$now"
        ;;
    esac
    if [[ "$lost" -eq 1 ]] && (( now - lost_at >= lost_grace )); then
      # #770: the grace expired without a completion. job.lost is not a hub
      # terminal, so declare the end (newest-revive wins, so a respawned job
      # is left alone) before the sentinel leaves.
      job_end_record "$job" "$owner" abandoned "sentinel lost grace expired" "wrk sentinel" >/dev/null || true
      release_job_quota_pool "$job"
      sentinel_self_exit "$job" 0
    fi
    sleep "$interval"
  done
}

# 스폰 시점의 herdr 컨텍스트를 센티널 환경에 명시적으로 박아 넣는다. 분리된
# 센티널은 터미널에서 유도되는 세션 컨텍스트를 잃고, 서버가 비기본 세션에 있는
# 호스트에서는 기본 소켓을 물어 `agent get` 이 항상 빈 값을 냈다.
# WRK_SENTINEL_HERDR_SESSION/WRK_SENTINEL_HERDR_SOCKET 로 스폰 측이 명시 지정할
# 수 있고, 없으면 wrk 자신이 쓰던 값을 그대로 물려준다.
build_sentinel_env() {
  SENTINEL_ENV=()
  local session socket
  session="${WRK_SENTINEL_HERDR_SESSION:-${HERDR_SESSION:-}}"
  socket="${WRK_SENTINEL_HERDR_SOCKET:-${HERDR_SOCKET_PATH:-}}"
  [[ -z "$session" ]] || SENTINEL_ENV+=("HERDR_SESSION=$session")
  [[ -z "$socket" ]] || SENTINEL_ENV+=("HERDR_SOCKET_PATH=$socket")
  [[ -z "${HERDR_BIN_PATH:-}" ]] || SENTINEL_ENV+=("HERDR_BIN_PATH=$HERDR_BIN_PATH")
  [[ -z "$HERDR" ]] || SENTINEL_ENV+=("HERDR_BIN=$HERDR")
}

start_completion_sentinel() {
  local pidfile="$1"; shift
  local job="${1:-}"
  mkdir -p "$(dirname "$pidfile")"
  local existing="" existing_started=""
  if [[ -s "$pidfile" ]]; then
    IFS=$'\t' read -r existing existing_started <<<"$(sentinel_pidfile_fields "$pidfile")"
    # kill -0 alone proves nothing: a reused pid belongs to whatever unrelated
    # process took it, and letting that answer suppress this call would leave
    # the job without a sentinel (director-1 measured reused pids on this box
    # belonging to system daemons and to the director's own process). Only an
    # argv-verified sentinel for this job — start time agreeing when the file
    # recorded one — suppresses a new start.
    if [[ "$existing" =~ ^[0-9]+$ ]] && sentinel_pid_matches "$existing" "$job" && sentinel_start_matches "$existing" "$existing_started"; then
      return 0
    fi
  fi
  rm -f "$pidfile"
  build_sentinel_env
  # The pidfile's second line records the spawn instant so a later reader can
  # prove the pid still belongs to the process it launched — a bare pid is
  # silently recyclable by the kernel.
  if [[ "${#SENTINEL_ENV[@]}" -gt 0 ]]; then
    ( nohup env "${SENTINEL_ENV[@]}" "$0" sentinel "$@" >>"${pidfile%.pid}.log" 2>&1 & printf '%s\nstarted=%s\n' "$!" "$(date +%s)" >"$pidfile" )
  else
    ( nohup "$0" sentinel "$@" >>"${pidfile%.pid}.log" 2>&1 & printf '%s\nstarted=%s\n' "$!" "$(date +%s)" >"$pidfile" )
  fi
}

# Spill-over placement is intentionally implemented outside spawn_cmd(): once a
# remote host is selected, its own wrk instance owns quota admission, pane
# creation, and landing verification. Keeping that boundary avoids duplicating
# the scopefuel/arbiter protocol across machines.
spillover_config() {
  printf '%s' "${WRK_HOSTS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/wrk/hosts.toml}"
}

spillover_trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

# This deliberately supports the small, documented hosts.toml surface rather
# than pretending to be a general TOML interpreter. Unknown keys remain future
# compatible and quoted values keep paths/SSH aliases free of shell evaluation.
spillover_value() {
  # A nonempty third argument keeps the raw lexeme (no quote stripping) — the
  # one caller that needs it is the [local] spawn boolean check, where the
  # accepted values are the bare TOML literals true/false and a quoted
  # spelling is a type error.
  local section="$1" key="$2" keep_quotes="${3:-}" config line current="" value=""
  config="$(spillover_config)"
  [[ -r "$config" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(spillover_trim "$line")"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" =~ ^\[([^]]+)\]$ ]]; then
      current="${BASH_REMATCH[1]}"
      continue
    fi
    [[ "$current" == "$section" && "$line" =~ ^${key}[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
    value="${BASH_REMATCH[1]}"
    value="${value%%#*}"
    value="$(spillover_trim "$value")"
    if [[ -z "$keep_quotes" && "$value" == \"*\" && "$value" == *\" ]]; then value="${value:1:${#value}-2}"; fi
    printf '%s' "$value"
    return 0
  done <"$config"
  return 1
}

spillover_hosts() {
  local config line
  config="$(spillover_config)"
  [[ -r "$config" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(spillover_trim "$line")"
    if [[ "$line" =~ ^\[hosts\.([A-Za-z0-9_-]+)\]$ ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
    fi
  done <"$config"
}

# cwd_map and cwd_keys share one matcher.  A cwd equal to a key maps to the
# value; a sibling-worktree cwd <key>.<suffix> (suffix is [A-Za-z0-9._-]+) maps
# to <value>.<suffix>; a subpath cwd <key>/<rest> maps to <value>/<rest>.  A
# boundary-less prefix such as <key>foo never matches, and the longest
# matching key wins so nested keys stay reachable.
spillover_prefix_lookup() {
  python3 - "$1" "$2" <<'PY'
import re, sys
cwd, raw = sys.argv[1:]
def unq(s):
    return s.replace(r'\"', '"').replace(r'\\', '\\')
best = None
for local, remote in re.findall(r'"([^"\\]*(?:\\.[^"\\]*)*)"\s*=\s*"([^"\\]*(?:\\.[^"\\]*)*)"', raw):
    local, remote = unq(local), unq(remote)
    if cwd == local:
        kind, mapped = "exact", remote
    elif cwd.startswith(local + ".") and re.fullmatch(r"[A-Za-z0-9._-]+", cwd[len(local) + 1:]):
        kind, mapped = "suffix", remote + cwd[len(local):]
    elif cwd.startswith(local + "/"):
        kind, mapped = "subpath", remote + cwd[len(local):]
    else:
        continue
    if best is None or len(local) > best[0]:
        best = (len(local), kind, remote, mapped)
if best:
    print("\t".join(best[1:]))
PY
}

# Sets SPILL_CWD_KIND (exact|suffix|subpath), SPILL_CWD_BASE (the matched
# key's remote value) and SPILL_CWD_REMOTE (the derived remote path).
spillover_cwd_map() {
  local host="$1" cwd="$2" raw parsed
  SPILL_CWD_KIND="" SPILL_CWD_BASE="" SPILL_CWD_REMOTE=""
  raw="$(spillover_value "hosts.$host" cwd_map 2>/dev/null || true)"
  [[ -n "$raw" ]] || return 1
  parsed="$(spillover_prefix_lookup "$cwd" "$raw")"
  [[ -n "$parsed" ]] || return 1
  IFS=$'\t' read -r SPILL_CWD_KIND SPILL_CWD_BASE SPILL_CWD_REMOTE <<<"$parsed"
}

spillover_cwd_key() {
  local host="$1" cwd="$2" raw parsed
  raw="$(spillover_value "hosts.$host" cwd_keys 2>/dev/null || true)"
  [[ -n "$raw" ]] || return 1
  parsed="$(spillover_prefix_lookup "$cwd" "$raw")"
  [[ -n "$parsed" ]] || return 1
  printf '%s' "${parsed##*$'\t'}"
}

spillover_host_via() {
  local host="$1" via
  via="$(spillover_value "hosts.$host" via 2>/dev/null || true)"
  case "${via:-ssh}" in
    ssh|hub) printf '%s' "${via:-ssh}" ;;
    *) return 1 ;;
  esac
}

# [hub] session_machine_ids names the hub machine id of the panewire daemon
# serving each NON-fleet herdr session on this host (#965: a host can run a
# second daemon for a non-fleet session — M1's default session is the
# example — and only that daemon may carry the session's lane rows). Mapping
# a fleet session is not a supported use: every fleet worker would be
# registered as a global lane (#994). The value is a one-line inline table,
# read with the same quoted-pair matcher as cwd_map — still no TOML library.
hub_session_machine_id() {
  # rc 0: the machine id on stdout. rc 1: the map parsed but has no entry for
  # the session. rc 2: content the one-line matcher cannot read — a missing
  # closing brace (multi-line table), single-quoted keys, a bare value, or
  # any residue left between the quoted pairs (a partially parsed map) —
  # which the caller must warn about differently from "no entry" (#994/N4).
  python3 - "$1" "$2" <<'PY'
import re, sys
session, raw = sys.argv[1:]
def unq(s):
    return s.replace(r'\"', '"').replace(r'\\', '\\')
body = raw.strip()
if not (body[:1] == "{" and body[-1:] == "}"):
    raise SystemExit(2)
inner = body[1:-1]
pair = re.compile(r'"([^"\\]*(?:\\.[^"\\]*)*)"\s*=\s*"([^"\\]*(?:\\.[^"\\]*)*)"')
pairs = pair.findall(inner)
# Anything the pair matcher left behind — an unquoted key, a bare value, a
# second table — is a map we only partially read; that is a parse failure,
# never a missing entry (#1010/N5).
if pair.sub("", inner).strip(" \t,"):
    raise SystemExit(2)
for key, value in pairs:
    if unq(key) == session:
        print(unq(value))
        raise SystemExit(0)
raise SystemExit(2 if (not pairs and inner.strip()) else 1)
PY
}

# panewire's own lane-name rule — lanes_write.go laneNamePattern
# ^[a-z0-9-]{1,32}$, enforced on the lanes add/rm operand (lanes_cli.go).
# A value outside it must never reach panewire argv (#994/N2).
hub_lane_name_valid() {
  [[ "$1" =~ ^[a-z0-9-]{1,32}$ ]]
}

# Print one verdict line for LANE's row in a `panewire lanes ls` envelope,
# compared against the recorded machine+pane: "match" when both fields equal
# the recorded values, "mismatch OBSERVED" with the observed machine:pane
# (control characters backslash-escaped so the verdict stays a single line),
# and nothing when the lane is absent. The compare happens here, on the
# parsed fields: piping the row back through an IFS=tab read collapses empty
# fields and truncates at an embedded newline, which can slide another
# machine's row into a false match (#1010/N2). Exit 1 when the listing is
# not the JSON the CLI emits — a row we could not read is a row we may not
# remove (#994/N3).
hub_lane_lookup() {
  python3 - "$1" "$2" "$3" "$4" <<'PY'
import json, sys
lane, want_machine, want_pane, raw = sys.argv[1:]
try:
    doc = json.loads(raw)
except ValueError:
    raise SystemExit(1)
rows = doc.get("lanes") if isinstance(doc, dict) else None
if not isinstance(rows, list):
    raise SystemExit(1)
def disp(s):
    return s.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t")
for row in rows:
    if isinstance(row, dict) and row.get("lane") == lane:
        machine = row.get("machine")
        pane = row.get("pane")
        machine = machine if isinstance(machine, str) else ""
        pane = pane if isinstance(pane, str) else ""
        if machine == want_machine and pane == want_pane:
            print("match")
        else:
            print("mismatch %s:%s" % (disp(machine), disp(pane)))
        break
PY
}

# #965: a worker/tester spawned into a herdr session served by its own
# panewire daemon needs a hub lane row on that daemon's machine id — without
# one the daemon suppresses the pane's idle-wakes as parentless_lane /
# unknown_owner (2026-09-29: a default-session worker had no lane and its
# builder stalled until the desk relayed by hand). The session→machine map is
# hosts.toml's [hub] session_machine_ids; the effective session is
# WRK_SENTINEL_HERDR_SESSION, else HERDR_SESSION, else the herdr default.
# Runs only once the pane is provably up, and before the spawn receipt so
# hub_lane/hub_lane_machine land in the same job meta as task_id/keep.
# Best-effort at every step: an unmapped session, a missing --owner, absent
# hub credentials or a panewire refusal warn once and leave the spawn
# standing — a missing lane is the pre-#965 behavior, not a new failure, so
# this never fails the spawn and never retries silently. Builder spawns never
# reach here: a builder's lane stays the director's. Sets HUB_LANE and
# HUB_LANE_MACHINE for the receipt payload and the OK line.
hub_lane_register() {
  HUB_LANE="" HUB_LANE_MACHINE=""
  [[ "$ROLE" == worker ]] || return 0
  local session raw machine machine_rc=0 panewire hub_url token_env cf_env rc=0
  local lanes_env lanes_machine
  local args=()
  session="${WRK_SENTINEL_HERDR_SESSION:-${HERDR_SESSION:-default}}"
  raw="$(spillover_value hub session_machine_ids 2>/dev/null || true)"
  # No map at all means this installation has not opted in; stay silent like
  # the hub quota gate does on absent hub keys.
  [[ -n "$raw" ]] || return 0
  set +e
  machine="$(hub_session_machine_id "$session" "$raw" 2>/dev/null)"
  machine_rc=$?
  set -e
  # #1010/N5: any rc beyond 0/1 — the matcher's own 2, a crashed interpreter,
  # anything in between — is a parse failure, not a missing entry; stderr is
  # silenced above so a traceback never leaks into the spawn's.
  if [[ "$machine_rc" -ne 0 && "$machine_rc" -ne 1 ]]; then
    warn "hub lane not registered (the [hub] session_machine_ids value could not be parsed; use the one-line {\"session\" = \"machine\"} inline table)"
    return 0
  fi
  if [[ -z "$machine" ]]; then
    warn "hub lane not registered (herdr session '$session' has no session_machine_ids entry)"
    return 0
  fi
  # #994/S1: no lane without its job.spawned receipt — a registration the job
  # record never carries is a row `wrk reap` can never remove. The same gate
  # quota_hub_policy_gate uses.
  if [[ "${ARBITER_JOB_REGISTERED:-0}" -ne 1 ]]; then
    warn "hub lane not registered (no arbiter job record; a lane without a spawn receipt is unreapable)"
    return 0
  fi
  if [[ -z "$OWNER" ]]; then
    warn "hub lane not registered (--owner is unset; the spawning builder's lane is required as parent)"
    return 0
  fi
  # #994/N2: the label becomes panewire argv verbatim — refuse names outside
  # the daemon's own lane rule before the value can reach the command line.
  if ! hub_lane_name_valid "$LABEL"; then
    warn "hub lane not registered (label '$LABEL' is not a valid panewire lane name)"
    return 0
  fi
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  # #1037: a dedicated lanes credential — a node token bound to this host's
  # own machine id — wins over the shared operator file. It may reach only
  # the lanes routes; every other hub path keeps hub_token_env.
  token_env="$(spillover_value hub lanes_token_env 2>/dev/null || true)"
  lanes_env="$token_env"
  [[ -n "$token_env" ]] || token_env="$(spillover_value hub hub_token_env 2>/dev/null || true)"
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  if [[ -z "$hub_url" || -z "$token_env" ]]; then
    warn "hub lane not registered (hub_url missing or neither hub_token_env nor lanes_token_env set in hosts.toml [hub])"
    return 0
  fi
  # A lanes credential authorizes lanes on its own HUB_MACHINE_ID only — with
  # a different machine the hub refuses the add (lane_machine_mismatch), so
  # compare first and skip. The file is scanned for that one key through
  # spillover_env_key, never sourced; HUB_TOKEN is never matched or printed.
  # The extracted value may reach the compare — and any warning — only as a
  # bare machine id: spillover_env_key returns the whole post-= tail, so an
  # unparsed remainder like a same-line HUB_TOKEN would otherwise echo into
  # the warning. Fail closed: anything outside ^[A-Za-z0-9._-]{1,64}$ warns
  # once WITHOUT the value and skips. An unreadable file or unset/empty key
  # still falls through to panewire's own loader error.
  if [[ -n "$lanes_env" ]]; then
    lanes_machine="$(spillover_env_key "$lanes_env" HUB_MACHINE_ID 2>/dev/null || true)"
    if [[ -n "$lanes_machine" ]]; then
      if [[ ! "$lanes_machine" =~ ^[A-Za-z0-9._-]{1,64}$ ]]; then
        warn "hub lane not registered (lanes_token_env HUB_MACHINE_ID is malformed)"
        return 0
      fi
      if [[ "$lanes_machine" != "$machine" ]]; then
        warn "hub lane not registered (lanes_token_env HUB_MACHINE_ID '$lanes_machine' does not match the session's machine '$machine')"
        return 0
      fi
    fi
  fi
  panewire="${PANEWIRE_BIN:-panewire}"
  if [[ "$panewire" == */* ]]; then
    [[ -x "$panewire" ]] || {
      warn "hub lane not registered (panewire unavailable: $panewire)"
      return 0
    }
  elif ! command -v "$panewire" >/dev/null 2>&1; then
    warn "hub lane not registered (panewire unavailable)"
    return 0
  fi
  # The token env values go to panewire as FILE PATHS; wrk itself opens only
  # the lanes token's HUB_MACHINE_ID line, for the mismatch check above.
  args=(lanes add "$LABEL" --machine "$machine" --pane "$PANE" --parent "$OWNER"
        --hub-url "$hub_url" --hub-token-env "$token_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  set +e
  "$panewire" "${args[@]}" >/dev/null 2>&1
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    warn "hub lane not registered (panewire lanes add exited $rc)"
    return 0
  fi
  HUB_LANE="$LABEL" HUB_LANE_MACHINE="$machine"
}

# The reverse of hub_lane_register for `wrk reap --apply` and for the
# receipt-failure compensation in the spawn path: remove the lane only when
# `panewire lanes ls` still shows it bound to the machine and pane the job's
# receipt recorded. Lanes are keyed by label in one global namespace — a
# label reused by a later spawn must never lose that spawn's live row to the
# earlier job's reap (#994/N3). The lane value is validated against
# panewire's own lane-name rule before it may reach argv (#994/N2), and a
# `lanes ls` that cannot confirm the row — refusal, unreadable output, no
# such lane, or a row belonging to another machine/pane — skips the removal:
# never remove blind. A removal failure warns and the close still stands;
# `panewire lanes-audit` is where leftovers surface.
hub_lane_remove() {
  local lane="$1" want_machine="${2:-}" want_pane="${3:-}" panewire hub_url token_env cf_env rc=0
  local listing verdict
  local args=()
  if ! hub_lane_name_valid "$lane"; then
    warn "hub lane '$lane' not removed (not a valid panewire lane name)"
    return 0
  fi
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  # Same credential rule as registration (#1037): lanes_token_env when set,
  # else hub_token_env. The node token's own `lanes ls` is already
  # machine-scoped hub-side, so no further check is needed here.
  token_env="$(spillover_value hub lanes_token_env 2>/dev/null || true)"
  [[ -n "$token_env" ]] || token_env="$(spillover_value hub hub_token_env 2>/dev/null || true)"
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  if [[ -z "$hub_url" || -z "$token_env" ]]; then
    warn "hub lane '$lane' not removed (hub_url missing or neither hub_token_env nor lanes_token_env set in hosts.toml [hub])"
    return 0
  fi
  panewire="${PANEWIRE_BIN:-panewire}"
  args=(lanes ls --hub-url "$hub_url" --hub-token-env "$token_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  set +e
  listing="$("$panewire" "${args[@]}" 2>/dev/null)"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    warn "hub lane '$lane' not removed (panewire lanes ls exited $rc)"
    return 0
  fi
  set +e
  verdict="$(hub_lane_lookup "$lane" "$want_machine" "$want_pane" "$listing")"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    warn "hub lane '$lane' not removed (panewire lanes ls output was not parseable)"
    return 0
  fi
  if [[ -z "$verdict" ]]; then
    warn "hub lane '$lane' not removed (no such lane on the hub)"
    return 0
  fi
  if [[ "$verdict" != match ]]; then
    warn "hub lane '$lane' not removed (the lane now belongs to ${verdict#mismatch }, not the recorded $want_machine:$want_pane)"
    return 0
  fi
  args=(lanes rm "$lane" --hub-url "$hub_url" --hub-token-env "$token_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  set +e
  "$panewire" "${args[@]}" >/dev/null 2>&1
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    warn "hub lane '$lane' not removed (panewire lanes rm exited $rc)"
    return 0
  fi
}

# Read precisely one shell-style assignment without sourcing an env file.  The
# host configuration points at operator-managed files, so neither arbitrary
# expansion nor their contents may reach this process's logs.
spillover_env_key() {
  local file="$1" key="$2"
  [[ -r "$file" ]] || return 1
  python3 - "$file" "$key" <<'PY'
import re, sys

path, key = sys.argv[1:]
assignment = re.compile(r"^\s*(?:export\s+)?" + re.escape(key) + r"\s*=\s*(.*?)\s*$")
with open(path, encoding="utf-8") as env_file:
    for line in env_file:
        match = assignment.match(line)
        if not match:
            continue
        value = match.group(1)
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if value:
            print(value)
            raise SystemExit(0)
raise SystemExit(1)
PY
}

spillover_hub_http_base() {
  local hub_url="$1"
  case "$hub_url" in
    wss://*) printf 'https://%s' "${hub_url#wss://}" ;;
    ws://*) printf 'http://%s' "${hub_url#ws://}" ;;
    https://*|http://*) printf '%s' "$hub_url" ;;
    *) return 1 ;;
  esac
}

spillover_load5() {
  local proc="${WRK_PROC_LOADAVG:-/proc/loadavg}" load
  if [[ -r "$proc" ]]; then
    awk '{print $2}' "$proc"
    return 0
  fi
  if command -v sysctl >/dev/null 2>&1; then
    load="$(sysctl -n vm.loadavg 2>/dev/null || true)"
    awk '{gsub(/[{}]/, ""); print $2}' <<<"$load"
    return 0
  fi
  return 1
}

spillover_ncpu() {
  if [[ -n "${WRK_TEST_NCPU:-}" ]]; then printf '%s' "$WRK_TEST_NCPU"; return 0; fi
  if [[ -r /proc/cpuinfo ]]; then
    getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || true
  else
    sysctl -n hw.ncpu 2>/dev/null || true
  fi
}

spillover_active_workers() {
  local output
  if ! output="$("$HERDR" agent list 2>/dev/null)"; then return 1; fi
  python3 -c 'import json,sys; d=json.load(sys.stdin); a=d.get("result",d).get("agents",[]); print(sum(x.get("agent_status")=="working" for x in a))' <<<"$output" 2>/dev/null
}

spillover_throttled() {
  local therm limit
  if [[ -n "${WRK_TEST_THROTTLED:-}" ]]; then
    [[ "$WRK_TEST_THROTTLED" == 1 ]]
    return
  fi
  command -v pmset >/dev/null 2>&1 || return 1
  therm="$(pmset -g therm 2>/dev/null || true)"
  limit="$(sed -nE 's/.*CPU_Speed_Limit[[:space:]]*=[[:space:]]*([0-9]+).*/\1/p' <<<"$therm" | head -1)"
  [[ "$limit" =~ ^[0-9]+$ && "$limit" -lt 100 ]]
}

spillover_local_measure() {
  SPILL_LOAD="$(spillover_load5 2>/dev/null || true)"
  SPILL_NCPU="$(spillover_ncpu 2>/dev/null || true)"
  SPILL_ACTIVE="$(spillover_active_workers 2>/dev/null || true)"
  SPILL_RATIO="unknown"
  if [[ "$SPILL_LOAD" =~ ^[0-9]+([.][0-9]+)?$ && "$SPILL_NCPU" =~ ^[1-9][0-9]*$ ]]; then
    SPILL_RATIO="$(awk -v l="$SPILL_LOAD" -v n="$SPILL_NCPU" 'BEGIN { printf "%.3f", l/n }')"
  fi
}

spillover_local_is_pressured() {
  local max_ratio max_active
  spillover_local_measure
  SPILL_REASON="local-healthy"
  max_ratio="$(spillover_value local max_load_ratio 2>/dev/null || true)"
  max_active="$(spillover_value local max_active 2>/dev/null || true)"
  if [[ "$max_ratio" =~ ^[0-9]+([.][0-9]+)?$ && "$SPILL_RATIO" != unknown ]] &&
    awk -v actual="$SPILL_RATIO" -v max="$max_ratio" 'BEGIN { exit !(actual >= max) }'; then
    SPILL_REASON="load-ratio=${SPILL_RATIO}>=${max_ratio}"
    return 0
  fi
  if [[ "$max_active" =~ ^[0-9]+$ && "$SPILL_ACTIVE" =~ ^[0-9]+$ && "$SPILL_ACTIVE" -ge "$max_active" ]]; then
    SPILL_REASON="active=${SPILL_ACTIVE}>=${max_active}"
    return 0
  fi
  if spillover_throttled; then
    SPILL_REASON="cpu-throttled"
    return 0
  fi
  return 1
}

spillover_log() {
  local host="$1" reason="$2" log
  log="${WRK_SPILLOVER_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/wrk/spillover.log}"
  mkdir -p "$(dirname "$log")" 2>/dev/null || { warn "spill-over log directory unavailable: $log"; return 0; }
  printf '%s source=%s load5=%s ncpu=%s ratio=%s active=%s host=%s reason=%s\n' \
    "$(date -Iseconds)" "${SPILL_DECISION_SOURCE:-unknown}" "${SPILL_LOAD:-unknown}" "${SPILL_NCPU:-unknown}" \
    "${SPILL_RATIO:-unknown}" "${SPILL_ACTIVE:-unknown}" "$host" "$reason" >>"$log" 2>/dev/null ||
    warn "spill-over log unavailable: $log"
}

# The hub owns placement policy. This adapter is deliberately narrow because
# its contract lives with panewire: wrk consumes only decision/candidates/reason
# from `panewire place`, then performs the selected spawn. No URL, token, IP,
# or machine name is embedded in this public CLI.
spillover_hub_placement() {
  local reply parsed panewire hub_url token_env cf_env args
  SPILL_HUB_STATUS=unavailable
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  token_env="$(spillover_value hub hub_token_env 2>/dev/null || true)"
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  [[ -n "$hub_url" && -n "$token_env" ]] || return 1
  panewire="${PANEWIRE_BIN:-panewire}"
  args=(place --class worker --cwd "$1" --hub-url "$hub_url" --hub-token-env "$token_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  if ! reply="$("$panewire" "${args[@]}" 2>/dev/null)"; then
    return 1
  fi
  if ! parsed="$(python3 -c '
import json, sys
d = json.load(sys.stdin)
decision = d.get("decision")
reason = d.get("reason", "")
if decision is not None and not isinstance(decision, str):
    raise ValueError("invalid placement decision")
decision_host = decision or ""
eligible = []
for candidate in d.get("candidates", []):
    if isinstance(candidate, str):
        value, candidate_reason, connected = candidate, "", True
    elif isinstance(candidate, dict):
        # PlacementCandidate canonical key is machine.  host/target remain
        # accepted only for backward-compatible hub fixtures/responses.
        value = candidate.get("machine") or candidate.get("host") or candidate.get("target") or ""
        candidate_reason = candidate.get("reason", "")
        connected = candidate.get("connected", True)
    else:
        continue
    if not isinstance(value, str) or not value or connected is False or "not_accepting" in str(candidate_reason):
        continue
    if value not in eligible: eligible.append(value)
if isinstance(decision_host, str) and decision_host and decision_host in eligible:
    eligible.remove(decision_host)
    eligible.insert(0, decision_host)
print(eligible[0] if eligible else "")
print(str(reason).replace("\n", " "))
print(*eligible[1:], sep="\n")
' <<<"$reply")"; then
    SPILL_HUB_STATUS=invalid
    return 1
  fi
  {
    IFS= read -r SPILL_HUB_HOST
    IFS= read -r SPILL_HUB_REASON || true
  } <<<"$parsed"
  SPILL_HUB_CANDIDATES=()
  while IFS= read -r candidate; do [[ -z "$candidate" ]] || SPILL_HUB_CANDIDATES+=("$candidate"); done < <(tail -n +3 <<<"$parsed")
  # Fixture-only observability: lets the contract test assert the exact hub
  # ordering after eligibility filtering without contacting a live hub.
  if [[ -n "${WRK_SPILLOVER_CANDIDATES_LOG:-}" ]]; then
    {
      printf '%s\n' "$SPILL_HUB_HOST"
      for candidate in "${SPILL_HUB_CANDIDATES[@]:-}"; do
        [[ -z "$candidate" ]] || printf '%s\n' "$candidate"
      done
    } >"$WRK_SPILLOVER_CANDIDATES_LOG"
  fi
  SPILL_HUB_STATUS=ok
  return 0
}

spillover_probe_host() {
  local host="$1" ssh_name output capacity load probe_err rc
  ssh_name="$(spillover_value "hosts.$host" ssh 2>/dev/null || true)"
  [[ -n "$ssh_name" ]] || ssh_name="$host"
  SPILL_PROBE_ERR=""
  SPILL_PROBE_RC=1
  SPILL_PROBE_DETAIL=""
  probe_err="$(mktemp)"
  set +e
  output="$("${WRK_SSH_BIN:-ssh}" -o BatchMode=yes "$ssh_name" 'uptime; herdr agent list' 2>"$probe_err")"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    SPILL_PROBE_REASON="ssh-unreachable"
    SPILL_PROBE_ERR="$(cat "$probe_err" 2>/dev/null)"
    # The real ssh rc (255 for a dead host, 2 for a remote-side refusal) is
    # what the probe line reports; try_candidate normalizes it for the router.
    SPILL_PROBE_RC="$rc"
    rm -f "$probe_err"
    return 1
  fi
  SPILL_REMOTE_LOAD="$(sed -nE 's/.*load averages?:[[:space:]]*([0-9.]+).*/\1/p' <<<"$output" | head -1)"
  SPILL_REMOTE_ACTIVE="$(python3 -c 'import json,re,sys; s=sys.stdin.read(); m=re.search(r"\{.*\}",s,re.S); d=json.loads(m.group(0)); a=d.get("result",d).get("agents",[]); print(sum(x.get("agent_status")=="working" for x in a))' <<<"$output" 2>/dev/null || true)"
  capacity="$(spillover_value "hosts.$host" capacity 2>/dev/null || true)"
  [[ "$capacity" =~ ^[1-9][0-9]*$ ]] || capacity=1
  if [[ "$SPILL_REMOTE_ACTIVE" =~ ^[0-9]+$ && "$SPILL_REMOTE_ACTIVE" -lt "$capacity" ]]; then
    SPILL_PROBE_REASON="remote-active=${SPILL_REMOTE_ACTIVE}<${capacity}"
    rm -f "$probe_err"
    return 0
  fi
  SPILL_PROBE_REASON="remote-full active=${SPILL_REMOTE_ACTIVE:-unknown} capacity=${capacity} load5=${SPILL_REMOTE_LOAD:-unknown}"
  SPILL_PROBE_DETAIL="active ${SPILL_REMOTE_ACTIVE:-unknown} capacity ${capacity}"
  # A probe that connected but could not produce a parseable agent list usually
  # left its reason on the remote stderr (herdr missing from the
  # non-interactive PATH is the classic case) — keep it for the caller.
  SPILL_PROBE_ERR="$(cat "$probe_err" 2>/dev/null)"
  rm -f "$probe_err"
  return 1
}

# #1239: deferred panewire wake. A wake-capable host is never woken on first
# sight — spawn_router_cmd finishes the candidate round first, then calls
# this once it knows no other placement is possible. The request itself
# carries the OPERATOR credential: [hub] operator_token_env (the same file
# the hub-spawn path uses) with hub_token_env as the fallback only — never a
# requirement, because hub_token_env is also the hub quota gate opt-in
# (#1138) and a quota_gate = "local" host deliberately leaves it unset.
# `panewire burst request` waits hub-side for the node's connection up to
# --timeout (server cap 10 minutes); a granted hold, or cooldown_active
# (someone else's wake is already in flight — waiting on it instead of
# stacking a second request is the concurrency story), then waits on the
# probe loop below for the ssh side to come up, bounded by the hosts.toml
# [hosts.<host>] wake_wait seconds (default 300). On refusal, CLI failure or
# timeout the reason is left in SPILL_WAKE_ERR and the caller answers with
# WRK_EXIT_WAKE_FAILED — never a local pane.
spillover_wake_request() {
  local host="$1" wake hub_url token_env cf_env hold wait_s panewire cli_timeout
  local out rc reason cli_err deadline poll_s wait_note burst_err
  wake="$(spillover_value "hosts.$host" wake 2>/dev/null || true)"
  if [[ "$wake" != panewire ]]; then
    SPILL_WAKE_ERR="remote host '$host' has no wake = \"panewire\" setting"
    return 1
  fi
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  # The burst operator client wants an HTTPS/HTTP base — reuse the same
  # wss:// -> https:// conversion the other hub paths apply.
  if [[ -n "$hub_url" ]]; then
    hub_url="$(spillover_hub_http_base "$hub_url" 2>/dev/null || true)"
  fi
  token_env="$(spillover_value hub operator_token_env 2>/dev/null || true)"
  if [[ -z "$token_env" ]]; then
    token_env="$(spillover_value hub hub_token_env 2>/dev/null || true)"
  fi
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  if [[ -z "$hub_url" || -z "$token_env" ]]; then
    SPILL_WAKE_ERR="remote host '$host' wake skipped ([hub] needs hub_url plus an operator credential: operator_token_env, else hub_token_env)"
    return 1
  fi
  # wake_hold/wake_wait follow the other numeric hosts.toml keys: a missing
  # or malformed value falls back to the default, never a refusal.
  hold="$(spillover_value "hosts.$host" wake_hold 2>/dev/null || true)"
  if [[ ! "$hold" =~ ^[1-9][0-9]*$ ]]; then hold="${WRK_WAKE_HOLD_MINUTES:-10}"; fi
  if [[ ! "$hold" =~ ^[1-9][0-9]*$ ]]; then hold=10; fi
  wait_s="$(spillover_value "hosts.$host" wake_wait 2>/dev/null || true)"
  if [[ ! "$wait_s" =~ ^[1-9][0-9]*$ ]]; then wait_s=300; fi
  # The hub caps a request's confirm timeout at 10 minutes; a longer
  # wake_wait is honored by the re-probe loop below.
  cli_timeout="$wait_s"
  if (( cli_timeout > 600 )); then cli_timeout=600; fi
  panewire="${PANEWIRE_BIN:-panewire}"
  echo "wrk: waking remote host '$host' via panewire burst (hold ${hold}m, wait ${wait_s}s)" >&2
  burst_err="$(mktemp)"
  set +e
  out="$("$panewire" burst request --target "$host" --hold "${hold}m" --timeout "${cli_timeout}s" \
    --reason "wrk spill-over: every candidate at capacity" \
    --hub-url "$hub_url" --hub-token-env "$token_env" ${cf_env:+--hub-cf-env "$cf_env"} 2>"$burst_err")"
  rc=$?
  set -e
  cli_err="$(tail -n 1 "$burst_err" 2>/dev/null || true)"
  rm -f "$burst_err"
  reason=""
  if [[ "$rc" -eq 3 ]]; then
    reason="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("reason",""))' <<<"$out" 2>/dev/null || true)"
  fi
  wait_note="burst hold requested, node not connected"
  case "$rc:$reason" in
    0:*)
      : ;;  # hold granted — the hub already saw the node connect
    3:cooldown_active)
      wait_note="cooldown_active: a wake is already in progress, node not connected" ;;
    3:target_timeout)
      SPILL_WAKE_ERR="remote host '$host' wake timed out after ${wait_s}s ($wait_note)"
      return 1 ;;
    3:*)
      if [[ -n "$reason" ]]; then
        SPILL_WAKE_ERR="remote host '$host' wake refused ($reason)"
      else
        SPILL_WAKE_ERR="remote host '$host' wake failed (${cli_err:-panewire burst request unavailable})"
      fi
      return 1 ;;
    *)
      SPILL_WAKE_ERR="remote host '$host' wake failed (panewire burst request exited $rc${cli_err:+: $cli_err})"
      return 1 ;;
  esac
  # Bounded re-probe: a granted hold means the node reached the hub, but its
  # sshd can lag a few seconds; the cooldown arm waits out the full budget.
  poll_s="${WRK_WAKE_POLL_S:-5}"
  deadline=$((SECONDS + wait_s))
  while :; do
    spillover_probe_host "$host" || true
    if [[ "$SPILL_PROBE_REASON" != ssh-unreachable ]]; then return 0; fi
    if (( SECONDS >= deadline )); then break; fi
    sleep "$poll_s"
  done
  SPILL_WAKE_ERR="remote host '$host' wake timed out after ${wait_s}s ($wait_note)"
  return 1
}

# A value-taking spawn option must not silently swallow the next option token:
# `--operator-request --requested-by` used to store "--requested-by" as the
# REF, skipping the missing-value rc=2 and forwarding the mangled pair
# downstream. Only spellings wrk itself recognizes count — "-operator" is not
# a flag and remains a perfectly valid --requested-by value.
wrk_option_token() {
  case "$1" in
    -c|-m|-p|-w|-l|-L|--effort|--job|--t|--owner|--role|--lane|--parent|--report|--operator-request|--requested-by|--purpose|--task|--parent-job|--task-hk-bypass|--job-dup-ok|--landing-strict|--keep|--host|-h|--help) return 0 ;;
    *) return 1 ;;
  esac
}

# The hub endpoint accepts only spawn metadata. In particular, the local cwd
# and brief path are translated to cwd_key and brief.inline, and duplicate-job
# overrides are deliberately not representable on this boundary.
spillover_hub_args() {
  SPILL_HUB_ARGS=()
  local arg i=0 args=("$@")
  while [[ "$i" -lt "${#args[@]}" ]]; do
    arg="${args[$i]}"
    case "$arg" in
      -c|-p)
        i=$((i + 1))
        { [[ "$i" -lt "${#args[@]}" ]] && ! wrk_option_token "${args[$i]:-}"; } ||
          { echo "wrk: $arg requires a value" >&2; return 2; }
        ;;
      --job-dup-ok)
        echo "wrk: --job-dup-ok is not permitted for a hub spawn" >&2; return 2 ;;
      -m|-w|-l|--t|--effort|--job|--owner|--report|--role|--lane|--parent|-L|--operator-request|--requested-by|--purpose|--task|--parent-job)
        i=$((i + 1))
        { [[ "$i" -lt "${#args[@]}" && -n "${args[$i]}" ]] && ! wrk_option_token "${args[$i]}"; } ||
          { echo "wrk: $arg requires a value" >&2; return 2; }
        SPILL_HUB_ARGS+=("$arg" "${args[$i]}")
        ;;
      --task-hk-bypass)
        SPILL_HUB_ARGS+=("$arg") ;;
      *)
        echo "wrk: option '$arg' is not permitted for a hub spawn" >&2; return 2 ;;
    esac
    i=$((i + 1))
  done
}

spillover_hub_emit_ok() {
  local host="$1" pane="$2" job_id="$3" status="$4" landed="$5"; shift 5
  local model=unknown label=unknown arg i=0 args=("$@")
  while [[ "$i" -lt "${#args[@]}" ]]; do
    arg="${args[$i]}"
    case "$arg" in
      -m) model="${args[$((i + 1))]:-unknown}" ;;
      -l) label="${args[$((i + 1))]:-unknown}" ;;
    esac
    i=$((i + 1))
  done
  printf 'OK pane=%s host=%s model=%s label=%s status=%s landed=%s job=%s\n' \
    "$pane" "$host" "$model" "$label" "$status" "$landed" "$job_id"
}

spillover_hub_curl_run() {
  local method="$1" url="$2" request_body="$3" operator_token="$4" cf_client_id="$5" cf_client_secret="$6" response_file="$7"
  local curl_bin headers_file request_file=""

  (
    umask 077
    headers_file="$(mktemp)" || exit 1
    trap 'rm -f "$headers_file" "$request_file"' EXIT HUP INT TERM
    if ! {
      printf 'Authorization: Bearer %s\n' "$operator_token"
      printf 'CF-Access-Client-Id: %s\n' "$cf_client_id"
      printf 'CF-Access-Client-Secret: %s\n' "$cf_client_secret"
      printf '%s\n' 'Content-Type: application/json'
    } >"$headers_file"; then
      exit 1
    fi
    curl_bin="${WRK_CURL_BIN:-curl}"
    if [[ "$method" == POST ]]; then
      request_file="$(mktemp)" || exit 1
      printf '%s' "$request_body" >"$request_file" || exit 1
      "$curl_bin" --silent --show-error --output "$response_file" --write-out '%{http_code}' \
        --request POST "$url" --header "@$headers_file" --data-binary "@$request_file"
    else
      "$curl_bin" --silent --show-error --output "$response_file" --write-out '%{http_code}' \
        --request GET "$url" --header "@$headers_file"
    fi
  )
}

spillover_hub_http_request() {
  local method="$1" url="$2" request_body="$3" operator_token="$4" cf_client_id="$5" cf_client_secret="$6"
  local response_file old_umask curl_rc

  old_umask="$(umask)"
  umask 077
  response_file="$(mktemp)" || { umask "$old_umask"; return 1; }
  umask "$old_umask"
  set +e
  SPILL_HUB_HTTP_CODE="$(spillover_hub_curl_run "$method" "$url" "$request_body" "$operator_token" "$cf_client_id" "$cf_client_secret" "$response_file")"
  curl_rc=$?
  set -e
  if [[ -r "$response_file" ]]; then
    SPILL_HUB_HTTP_BODY="$(<"$response_file")"
  else
    SPILL_HUB_HTTP_BODY=""
  fi
  rm -f "$response_file" || true
  [[ "$curl_rc" -eq 0 && "$SPILL_HUB_HTTP_CODE" =~ ^[0-9]{3}$ ]]
}

spillover_hub_response_state() {
  local body="$1" request_id="$2"
  python3 -c '
import json, sys
request_id = sys.argv[1]
d = json.load(sys.stdin)
if d.get("request_id") != request_id:
    raise SystemExit(1)
state = d.get("status")
if not isinstance(state, str):
    raise SystemExit(1)
print(state)
' "$request_id" <<<"$body"
}

spillover_hub_result() {
  local body="$1" request_id="$2" host="$3"
  python3 -c '
import json, sys
request_id, host = sys.argv[1:]
d = json.load(sys.stdin)
if d.get("request_id") != request_id or d.get("machine") != host or d.get("rc") != 0:
    raise SystemExit(1)
pane, job_id = d.get("pane"), d.get("job_id")
if not isinstance(pane, str) or not pane or not isinstance(job_id, str) or not job_id:
    raise SystemExit(1)
status, landed = "unknown", "no"
tail = d.get("stdout_tail")
if isinstance(tail, str):
    ok_lines = [line for line in tail.splitlines() if line.startswith("OK pane=")]
    if ok_lines:
        fields = dict(part.split("=", 1) for part in ok_lines[-1].split() if "=" in part)
        status = fields.get("status", status)
        landed = fields.get("landed", landed)
print(pane)
print(job_id)
print(status)
print(landed)
' "$request_id" "$host" <<<"$body"
}

spillover_hub_http_error() {
  local host="$1" status="$2"
  case "$status" in
    400) echo "wrk: hub spawn rejected for host '$host' (400 invalid request)" >&2 ;;
    401) echo "wrk: hub spawn authentication failed for host '$host' (401)" >&2 ;;
    409) echo "wrk: hub spawn conflicts with an existing request for host '$host' (409)" >&2 ;;
    503) echo "wrk: hub spawn unavailable for host '$host' (503); $(spillover_local_advice "retry")" >&2 ;;
    *) echo "wrk: hub spawn returned unexpected HTTP status $status for host '$host'" >&2 ;;
  esac
}

spillover_hub_poll() {
  local base="$1" request_id="$2" host="$3" operator_token="$4" cf_client_id="$5" cf_client_secret="$6"; shift 6
  local limit interval elapsed=0 state parsed
  limit="${WRK_HUB_POLL_MAX_SECONDS:-3600}"
  interval="${WRK_HUB_POLL_INTERVAL_SECONDS:-2}"
  [[ "$limit" =~ ^[1-9][0-9]*$ && "$interval" =~ ^[1-9][0-9]*$ ]] || {
    echo "wrk: invalid hub polling limit or interval" >&2; return 2;
  }
  while [[ "$elapsed" -lt "$limit" ]]; do
    if ! spillover_hub_http_request GET "${base%/}/v1/spawn/$request_id" '' "$operator_token" "$cf_client_id" "$cf_client_secret"; then
      echo "wrk: hub spawn poll failed for host '$host'; no local fallback" >&2
      return 1
    fi
    case "$SPILL_HUB_HTTP_CODE" in
      200)
        state="$(spillover_hub_response_state "$SPILL_HUB_HTTP_BODY" "$request_id" 2>/dev/null || true)"
        if [[ "$state" == lost ]]; then
          echo "wrk: hub spawn lost for host '$host'; no local fallback" >&2
          return 1
        fi
        if parsed="$(spillover_hub_result "$SPILL_HUB_HTTP_BODY" "$request_id" "$host" 2>/dev/null)"; then
          local pane job_id status landed
          pane="$(sed -n '1p' <<<"$parsed")"; job_id="$(sed -n '2p' <<<"$parsed")"
          status="$(sed -n '3p' <<<"$parsed")"; landed="$(sed -n '4p' <<<"$parsed")"
          spillover_hub_emit_ok "$host" "$pane" "$job_id" "$status" "$landed" "$@"
          return 0
        fi
        [[ "$state" == pending ]] || { echo "wrk: hub spawn returned an invalid poll response for host '$host'" >&2; return 1; }
        ;;
      504)
        state="$(spillover_hub_response_state "$SPILL_HUB_HTTP_BODY" "$request_id" 2>/dev/null || true)"
        [[ "$state" == pending ]] || { echo "wrk: hub spawn returned an invalid pending response for host '$host'" >&2; return 1; }
        ;;
      *) spillover_hub_http_error "$host" "$SPILL_HUB_HTTP_CODE"; return 1 ;;
    esac
    sleep_for "$interval"
    elapsed=$((elapsed + interval))
  done
  echo "wrk: hub spawn poll timed out for host '$host'; no local fallback" >&2
  return 1
}

spillover_hub_spawn() {
  local host="$1" cwd="$2" prompt="$3"; shift 3
  local cwd_key operator_env cf_env operator_token cf_client_id cf_client_secret hub_url base request_id request_body state parsed
  if ! cwd_key="$(spillover_cwd_key "$host" "$cwd")"; then
    echo "wrk: remote host '$host' has no cwd_keys entry for '$cwd'; $(spillover_local_advice "configure hosts.toml")" >&2
    return 2
  fi
  local hub_args_rc
  if spillover_hub_args "$@"; then :; else
    hub_args_rc=$?
    return "$hub_args_rc"
  fi
  [[ -r "$prompt" ]] || { echo "wrk: hub spawn brief is not readable: $prompt" >&2; return 2; }
  [[ "$(wc -c <"$prompt")" -le 65536 ]] || { echo "wrk: hub spawn brief exceeds 65536 UTF-8 bytes" >&2; return 2; }
  operator_env="$(spillover_value hub operator_token_env 2>/dev/null || true)"
  [[ -n "$operator_env" ]] || { echo "wrk: hub spawn requires hub.operator_token_env; $(spillover_local_advice "configure hosts.toml")" >&2; return 2; }
  if ! operator_token="$(spillover_env_key "$operator_env" PANEWIRE_OPERATOR_TOKEN 2>/dev/null)"; then
    echo "wrk: hub spawn operator token is unavailable; $(spillover_local_advice "configure hosts.toml")" >&2
    return 2
  fi
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  if ! cf_client_id="$(spillover_env_key "$cf_env" CF_ACCESS_CLIENT_ID 2>/dev/null)" ||
     ! cf_client_secret="$(spillover_env_key "$cf_env" CF_ACCESS_CLIENT_SECRET 2>/dev/null)"; then
    echo "wrk: hub spawn CF service token is unavailable; $(spillover_local_advice "configure hosts.toml")" >&2
    return 2
  fi
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  if ! base="$(spillover_hub_http_base "$hub_url")"; then
    echo "wrk: hub spawn has an invalid hub_url; $(spillover_local_advice "configure hosts.toml")" >&2
    return 2
  fi
  request_id="$(python3 -c 'import uuid; print(uuid.uuid4())')"
  if ! request_body="$(python3 - "$request_id" "$host" "$cwd_key" "$prompt" "${SPILL_HUB_ARGS[@]}" <<'PY'
import json, sys
request_id, machine, cwd_key, prompt, *args = sys.argv[1:]
with open(prompt, "rb") as brief_file:
    brief = brief_file.read()
if len(brief) > 65536:
    raise SystemExit(1)
inline = brief.decode("utf-8")
print(json.dumps({
    "request_id": request_id,
    "machine": machine,
    "cwd_key": cwd_key,
    "brief": {"inline": inline},
    "args": args,
    "wait_seconds": 120,
}, ensure_ascii=False, separators=(",", ":")))
PY
)"; then
    echo "wrk: hub spawn brief must be UTF-8 and at most 65536 bytes" >&2
    return 2
  fi
  if ! spillover_hub_http_request POST "${base%/}/v1/spawn" "$request_body" "$operator_token" "$cf_client_id" "$cf_client_secret"; then
    echo "wrk: hub spawn request failed for host '$host'; no local fallback" >&2
    return 1
  fi
  case "$SPILL_HUB_HTTP_CODE" in
    200)
      if ! parsed="$(spillover_hub_result "$SPILL_HUB_HTTP_BODY" "$request_id" "$host" 2>/dev/null)"; then
        echo "wrk: hub spawn returned an invalid success response for host '$host'" >&2
        return 1
      fi
      local pane job_id status landed
      pane="$(sed -n '1p' <<<"$parsed")"; job_id="$(sed -n '2p' <<<"$parsed")"
      status="$(sed -n '3p' <<<"$parsed")"; landed="$(sed -n '4p' <<<"$parsed")"
      spillover_hub_emit_ok "$host" "$pane" "$job_id" "$status" "$landed" "${SPILL_HUB_ARGS[@]}"
      ;;
    504)
      state="$(spillover_hub_response_state "$SPILL_HUB_HTTP_BODY" "$request_id" 2>/dev/null || true)"
      [[ "$state" == pending ]] || { echo "wrk: hub spawn returned an invalid pending response for host '$host'" >&2; return 1; }
      spillover_hub_poll "$base" "$request_id" "$host" "$operator_token" "$cf_client_id" "$cf_client_secret" "${SPILL_HUB_ARGS[@]}"
      ;;
    *) spillover_hub_http_error "$host" "$SPILL_HUB_HTTP_CODE"; return 1 ;;
  esac
}


spillover_emit_host() {
  local host="$1" file="$2" remote_rc="${3:-0}"
  # The OK pane line is the success contract: it stays on stdout even when the
  # remote leg failed after printing it.  On failure every other captured line
  # is diagnostic and belongs on stderr, never on the OK line's stream.
  awk -v host="$host" -v failed="$remote_rc" '
    /^OK pane=/ { sub(/ host=[^ ]+/, ""); sub(/^OK pane=[^ ]+/, "& host=" host); print; next }
    failed != 0 { print > "/dev/stderr"; next }
    { print }
  ' "$file"
}

# A delegated leg captures the remote stderr separately so transport noise
# (ssh banners, remote shell errors) and the remote wrk's own die lines reach
# the operator verbatim instead of dying inside a temp file or /dev/null.
spillover_relay_remote_err() {
  local err_file="$1"
  if [[ -s "$err_file" ]]; then cat "$err_file" >&2; fi
}

# Transport legs (probe, prepare, mktemp, scp) must never answer the router
# with an admission code: 2/74/75 belong to the remote wrk and the cwd map,
# and 70 to the remote wrk's own config refusal — fail-closed answers that
# stop auto failover.  A transport exit landing in that set is remapped to 1
# so failover proceeds exactly as it did when every leg returned a flat 1;
# it also means a 70 the router sees can only be the remote wrk's own answer
# from the delegated-spawn leg, which is never normalized (#1154).
spillover_transport_rc() {
  case "$1" in
    2|"$WRK_EXIT_ACTIVE_JOB_DUPLICATE"|"$WRK_EXIT_JOB_STATE_UNREADABLE"|"$WRK_EXIT_CONFIG_REFUSED") printf '1' ;;
    *) printf '%s' "$1" ;;
  esac
}

# Creates the derived remote worktree on the selected host.  Local-only
# branches and commits that origin does not have are terminal: the remote
# side can only check out what its own origin fetch can see, so spawning
# anyway would silently run different code.
spillover_remote_worktree_create() {
  local host="$1" ssh_name="$2" cwd="$3" remote_cwd="$4" remote_base="$5" branch="$6" sha="$7"
  if [[ -n "$branch" ]]; then
    if ! git -C "$cwd" rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null; then
      echo "wrk: local branch '$branch' is not pushed to origin; push it before spawning on '$host'" >&2
      return 2
    fi
    if [[ "$(git -C "$cwd" rev-parse "origin/$branch")" != "$sha" ]]; then
      echo "wrk: local HEAD of '$branch' differs from origin/$branch; push or pull before spawning on '$host'" >&2
      return 2
    fi
  elif ! git -C "$cwd" branch -r --contains "$sha" 2>/dev/null | grep -q 'origin/'; then
    echo "wrk: detached HEAD $sha of '$cwd' is not reachable from origin; push it before spawning on '$host'" >&2
    return 2
  fi
  local out rc
  set +e
  out="$("${WRK_SSH_BIN:-ssh}" -o BatchMode=yes "$ssh_name" \
    "BASE=$(printf '%q' "$remote_base") TARGET=$(printf '%q' "$remote_cwd") BRANCH=$(printf '%q' "$branch") SHA=$(printf '%q' "$sha") sh -s" <<'PREP' 2>&1
git -C "$BASE" rev-parse --git-dir >/dev/null 2>&1 || { echo "no git repo at $BASE" >&2; exit 3; }
created_branch=0
if [ -n "$BRANCH" ]; then
  git -C "$BASE" fetch origin "$BRANCH" || exit 4
  if git -C "$BASE" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    cur=$(git -C "$BASE" rev-parse "refs/heads/$BRANCH")
    [ "$cur" = "$SHA" ] || { echo "remote branch $BRANCH is at $cur" >&2; exit 5; }
    git -C "$BASE" worktree add "$TARGET" "$BRANCH" || exit 6
  else
    git -C "$BASE" worktree add -b "$BRANCH" "$TARGET" "origin/$BRANCH" || exit 6
    created_branch=1
  fi
else
  git -C "$BASE" fetch origin || exit 4
  git -C "$BASE" worktree add --detach "$TARGET" "$SHA" || exit 6
fi
s=$(git -C "$TARGET" rev-parse HEAD 2>/dev/null) || { git -C "$BASE" worktree remove --force "$TARGET" 2>/dev/null; [ "$created_branch" = 1 ] && git -C "$BASE" branch -D "$BRANCH" >/dev/null 2>&1; exit 7; }
[ "$s" = "$SHA" ] || { git -C "$BASE" worktree remove --force "$TARGET"; [ "$created_branch" = 1 ] && git -C "$BASE" branch -D "$BRANCH" >/dev/null 2>&1; echo "created worktree HEAD $s" >&2; exit 8; }
PREP
)"
  rc=$?
  set -e
  case "$rc" in
    0) return 0 ;;
    3) echo "wrk: remote repo '$remote_base' on '$host' is missing or not a git repo; create it first" >&2 ;;
    *) echo "wrk: remote worktree preparation failed on '$host' (rc=$rc): $(tail -n 1 <<<"$out")" >&2 ;;
  esac
  return 2
}

# A derived remote path (sibling-worktree or subpath mapping) must name the
# same commit as the local cwd before the spawn is delegated.  Missing
# worktrees are created remotely; an existing directory whose branch or HEAD
# disagrees is terminal — never overwrite or force a remote checkout.  Exact
# repo-root mappings keep the historical pass-through contract.
spillover_remote_prepare() {
  local host="$1" ssh_name="$2" cwd="$3" remote_cwd="$4" remote_base="$5" kind="$6"
  [[ "$kind" == exact ]] && return 0
  local branch="" sha="" has_git=0
  if branch="$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null)" &&
     sha="$(git -C "$cwd" rev-parse HEAD 2>/dev/null)"; then
    has_git=1
    [[ "$branch" == HEAD ]] && branch=""
  fi
  local out rc prep_err
  prep_err="$(mktemp)"
  set +e
  out="$("${WRK_SSH_BIN:-ssh}" -o BatchMode=yes "$ssh_name" \
    "TARGET=$(printf '%q' "$remote_cwd") sh -s" <<'PREP' 2>"$prep_err"
if [ -d "$TARGET" ]; then
  b=$(git -C "$TARGET" rev-parse --abbrev-ref HEAD 2>/dev/null) &&
    s=$(git -C "$TARGET" rev-parse HEAD 2>/dev/null) &&
    printf 'EXISTS\n%s\n%s\n' "$b" "$s" || echo NOTGIT
else
  echo MISSING
fi
PREP
)"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    spillover_relay_remote_err "$prep_err"
    echo "wrk: remote host '$host' is unreachable during worktree check (prepare rc=$rc); retry when it is available" >&2
    rm -f "$prep_err"
    return "$(spillover_transport_rc "$rc")"
  fi
  rm -f "$prep_err"
  case "$out" in
    MISSING)
      if [[ "$has_git" -eq 0 ]]; then
        echo "wrk: remote path '$remote_cwd' is missing on '$host' and '$cwd' is not a git worktree; create it first" >&2
        return 2
      fi
      [[ "$kind" == suffix ]] || {
        echo "wrk: remote path '$remote_cwd' is missing on '$host'; sync the remote repository first" >&2
        return 2
      }
      spillover_remote_worktree_create "$host" "$ssh_name" "$cwd" "$remote_cwd" "$remote_base" "$branch" "$sha"
      ;;
    NOTGIT)
      [[ "$has_git" -eq 0 ]] && return 0
      echo "wrk: remote path '$remote_cwd' on '$host' is not a git worktree; refusing to use it" >&2
      return 2
      ;;
    EXISTS*)
      [[ "$has_git" -eq 1 ]] || return 0
      local remote_branch remote_sha
      remote_branch="$(sed -n '2p' <<<"$out")"
      remote_sha="$(sed -n '3p' <<<"$out")"
      if [[ "$remote_branch" != "${branch:-HEAD}" || "$remote_sha" != "$sha" ]]; then
        echo "wrk: remote path '$remote_cwd' on '$host' is at ${remote_branch}@${remote_sha} but local '$cwd' is at ${branch:-HEAD}@${sha}; refusing to overwrite — align or remove it" >&2
        return 2
      fi
      return 0
      ;;
    *)
      echo "wrk: remote worktree check on '$host' returned an unexpected result" >&2
      return 1
      ;;
  esac
}

spillover_remote_spawn() {
  local host="$1" cwd="$2" prompt="$3"; shift 3
  local ssh_name session remote_prompt remote_cwd workspace remote_cmd rc out remote_err
  ssh_name="$(spillover_value "hosts.$host" ssh 2>/dev/null || true)"; [[ -n "$ssh_name" ]] || ssh_name="$host"
  session="$(spillover_value "hosts.$host" herdr_session 2>/dev/null || true)"; [[ -n "$session" ]] || session=worker
  workspace="$(spillover_value "hosts.$host" workspace 2>/dev/null || true)"; [[ -n "$workspace" ]] || workspace=worker
  # SPILL_REMOTE_STEP names the leg currently in flight so the router's final
  # failure line can say which step's rc it carries.
  SPILL_REMOTE_STEP="cwd-map"
  if ! spillover_cwd_map "$host" "$cwd"; then
    echo "wrk: remote host '$host' has no cwd_map entry for '$cwd'; $(spillover_local_advice "configure hosts.toml")" >&2
    return 2
  fi
  remote_cwd="$SPILL_CWD_REMOTE"
  SPILL_REMOTE_STEP="prepare"
  spillover_remote_prepare "$host" "$ssh_name" "$cwd" "$remote_cwd" "$SPILL_CWD_BASE" "$SPILL_CWD_KIND" || return
  SPILL_REMOTE_STEP="mktemp"
  remote_err="$(mktemp)"
  set +e
  # shellcheck disable=SC2016 # ${TMPDIR} must expand on the selected remote host.
  remote_prompt="$("${WRK_SSH_BIN:-ssh}" -o BatchMode=yes "$ssh_name" 'umask 077; mktemp "${TMPDIR:-/tmp}/wrk-spillover.XXXXXX.md"' 2>"$remote_err")"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    spillover_relay_remote_err "$remote_err"
    echo "wrk: remote host '$host' is unreachable or its mktemp failed (mktemp rc=$rc); $(spillover_local_advice "retry after it is available")" >&2
    rm -f "$remote_err"
    return "$(spillover_transport_rc "$rc")"
  fi
  rm -f "$remote_err"
  SPILL_REMOTE_STEP="scp"
  set +e
  "${WRK_SCP_BIN:-scp}" "$prompt" "$ssh_name:$remote_prompt"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    echo "wrk: failed to copy brief to remote host '$host' (scp rc=$rc)" >&2
    return "$(spillover_transport_rc "$rc")"
  fi
  local remote_args=(env "HERDR_SESSION=$session" wrk spawn -c "$remote_cwd" -p "$remote_prompt" --host local)
  local arg saw_workspace=0 i=0 args=("$@")
  while [[ "$i" -lt "${#args[@]}" ]]; do
    arg="${args[$i]}"
    case "$arg" in
      -c|-p|--host)
        # The remote path and copied brief above are authoritative.  Removing
        # both their values prevents a duplicate option from overriding them.
        ((i+=1))
        { [[ "$i" -lt "${#args[@]}" ]] && ! wrk_option_token "${args[$i]:-}"; } ||
          die "$arg requires a value"
        ;;
      -w)
        ((i+=1))
        { [[ "$i" -lt "${#args[@]}" ]] && ! wrk_option_token "${args[$i]:-}"; } ||
          die "-w requires a value"
        remote_args+=(-w "${args[$i]}")
        saw_workspace=1
        ;;
      *) remote_args+=("$arg") ;;
    esac
    ((i+=1))
  done
  # The normal argument loop preserves an explicit -w; remote defaults come
  # from hosts.toml when callers omit it.
  if [[ "$saw_workspace" -eq 0 ]]; then remote_args+=(-w "$workspace"); fi
  printf -v remote_cmd '%q ' "${remote_args[@]}"
  SPILL_REMOTE_STEP="remote wrk"
  out="$(mktemp)"
  remote_err="$(mktemp)"
  set +e
  "${WRK_SSH_BIN:-ssh}" -o BatchMode=yes "$ssh_name" "$remote_cmd; rc=\$?; rm -f -- $(printf '%q' "$remote_prompt"); exit \$rc" >"$out" 2>"$remote_err"
  rc=$?
  set -e
  # A failed remote spawn must answer with the remote's own words: stderr is
  # relayed verbatim and non-OK stdout follows it onto the local stderr.
  spillover_relay_remote_err "$remote_err"
  spillover_emit_host "$host" "$out" "$rc"
  rm -f "$out" "$remote_err"
  return "$rc"
}

# One remote candidate end to end: probe, then the delegated spawn.  Every
# per-candidate diagnostic is written to this function's stderr.  Under
# --host auto the router runs it in a subshell (so even a die() inside the
# remote legs is survivable) with stderr captured per candidate; the captured
# block is replayed only if no candidate produced a spawn, so a skipped host
# stays silent on success.  hold_diag=1 makes a failure end with one
# attributed "failed (rc=N) at step 'S'" line inside the captured block.
spillover_try_candidate() {
  local hold_diag="$1" candidate="$2" cwd="$3" prompt="$4"; shift 4
  local rc
  SPILL_REMOTE_STEP="probe"
  SPILL_PROBE_ERR=""; SPILL_PROBE_RC=1; SPILL_PROBE_DETAIL=""
  if ! spillover_probe_host "$candidate"; then
    # #1239: a wake-capable host is NOT woken here, on first sight — the
    # router finishes the candidate round and decides. It learns the verdict
    # through this one-token class file because the auto loop ran this
    # function in a subshell: remote-full / ssh-unreachable / refused
    # (anything else — probe noise, a refused remote admission, ...).
    if [[ -n "${SPILL_CANDIDATE_CLASS_FILE:-}" ]]; then
      case "$SPILL_PROBE_REASON" in
        remote-full*) printf 'remote-full\n' ;;
        ssh-unreachable) printf 'ssh-unreachable\n' ;;
        *) printf 'refused\n' ;;
      esac >"$SPILL_CANDIDATE_CLASS_FILE"
    fi
    # The remote's own words first (banner noise, missing herdr), then the
    # attribution line: a refused host is "skipped", a dead one "failed".
    [[ -n "$SPILL_PROBE_ERR" ]] && printf '%s\n' "$SPILL_PROBE_ERR" >&2
    if [[ "$SPILL_PROBE_REASON" == remote-full* ]]; then
      echo "wrk: remote host '$candidate' skipped: remote-full (${SPILL_PROBE_DETAIL:-$SPILL_PROBE_REASON})" >&2
    else
      echo "wrk: remote host '$candidate' probe failed (${SPILL_PROBE_REASON}, rc=$SPILL_PROBE_RC)" >&2
    fi
    # The probe is a transport leg: report the real ssh rc above, return a
    # normalized rc so 2/74/75 cannot collide with the router's fail-closed
    # admission codes.
    rc="$(spillover_transport_rc "$SPILL_PROBE_RC")"
  else
    if spillover_remote_spawn "$candidate" "$cwd" "$prompt" "$@"; then rc=0; else rc=$?; fi
    if [[ "$rc" -ne 0 && -n "${SPILL_CANDIDATE_CLASS_FILE:-}" ]]; then
      printf 'refused\n' >"$SPILL_CANDIDATE_CLASS_FILE"
    fi
  fi
  if [[ "$rc" -ne 0 && "$hold_diag" == 1 ]]; then
    echo "wrk: remote host '$candidate' failed (rc=$rc) at step '${SPILL_REMOTE_STEP:-unknown}'" >&2
  fi
  return "$rc"
}

spawn_router_cmd() {
  local requested=auto cwd="" prompt="" selected="" arg next=0 out rc host
  for arg in "$@"; do
    if [[ "$next" -eq 1 ]]; then cwd="$arg"; next=0; continue; fi
    if [[ "$next" -eq 2 ]]; then prompt="$arg"; next=0; continue; fi
    case "$arg" in
      -c) next=1 ;; -p) next=2 ;;
    esac
  done
  local filtered=() i=0 args=("$@")
  while [[ "$i" -lt "${#args[@]}" ]]; do
    arg="${args[$i]}"
    if [[ "$arg" == --host ]]; then
      ((i+=1))
      { [[ "$i" -lt "${#args[@]}" ]] && ! wrk_option_token "${args[$i]:-}"; } ||
        die "--host requires a value"
      requested="${args[$i]}"
    else
      filtered+=("$arg")
    fi
    ((i+=1))
  done
  # #1163 N1: help wins over config resolution — on a malformed [local] the
  # resolve below is a refusal, but `wrk spawn --help`/-h must still print
  # rc 0. The scan is value-aware (skips option arguments) so `-c --help`
  # still dies in spawn_cmd as a usage error; an unknown or non-option token
  # ends the scan — spawn_cmd dies on it before reaching any later --help.
  for ((i = 0; i < ${#args[@]}; i++)); do
    case "${args[$i]}" in
      -h|--help) spawn_help; return 0 ;;
      -c|-m|-p|-w|-l|-L|--effort|--job|--t|--owner|--role|--lane|--parent|--report|--operator-request|--requested-by|--purpose|--task|--parent-job|--host) ((i += 1)) ;;
      --task-hk-bypass|--job-dup-ok|--landing-strict|--keep) ;;
      *) break ;;
    esac
  done
  # #1155: this host's own [local] spawn = false forbids local spawns here.
  # Resolve once, before any admission work: a malformed value is a config
  # error (70) on every placement, and --host local refuses before any pane,
  # arbiter or hk side effect. A delegated ssh spawn arrives on the
  # execution host as this same --host local, so the refusal is also what
  # closes a remote host to ssh-delegated spawns. A via=hub delegated spawn
  # is different — the hub runs `wrk spawn` on the target without --host,
  # which is this auto path: a closed target lands no local pane, but the
  # round may still place on that target's own remotes.
  local_spawn_resolve || return
  if [[ "$LOCAL_SPAWN_ALLOWED" -eq 0 && "$requested" == local ]]; then
    echo "wrk: local spawns are disabled on this host ([local] spawn = false); refusing --host local" >&2
    return "$WRK_EXIT_LOCAL_SPAWN_DISABLED"
  fi
  # #872: explicit remote mock placement cannot become an unguarded delegation
  # or an admission-error local fallback. Auto placement is checked again after
  # its final host decision below.
  local requested_lane=""
  for ((i=0; i<${#filtered[@]}; i++)); do
    [[ "${filtered[$i]}" != -L ]] || requested_lane="${filtered[$((i + 1))]:-}"
  done
  if [[ "$requested" != auto && "$requested" != local && "$requested_lane" == mock ]]; then
    echo "wrk: mock MCP isolation refused: remote execution host guard/config cannot be attested; use execution-host local spawn" >&2
    return "$WRK_EXIT_MOCK_MCP_REFUSED"
  fi
  # Classification and an active durable duplicate are admission invariants,
  # not placement work. Preserve their fail-closed boundary before asking
  # hub/local telemetry anything.
  local has_t=0 t_value="" job_id="" label="" job_dup_ok=0
  for ((i=0; i<${#filtered[@]}; i++)); do
    case "${filtered[$i]}" in
      --t) has_t=1; t_value="${filtered[$((i + 1))]:-}" ;;
      --job) job_id="${filtered[$((i + 1))]:-}" ;;
      -l) label="${filtered[$((i + 1))]:-}" ;;
      --job-dup-ok) job_dup_ok=1 ;;
    esac
  done
  if [[ "$has_t" -eq 0 || ! "$t_value" =~ ^T[0-3]$ ]]; then
    spawn_cmd "${filtered[@]}"
    return $?
  fi
  [[ -n "$job_id" ]] || job_id="$label"
  if arbiter_preflight_active_duplicate "$job_id" "$job_dup_ok"; then
    :
  else
    rc=$?
    # A router must never use an unavailable placement-admission lookup to
    # launch remotely. Let the local spawn own the final admission outcome.
    [[ "$rc" -eq "$WRK_EXIT_ACTIVE_JOB_DUPLICATE" ]] && return "$rc"
    out="$(mktemp)"
    set +e
    ( set -e; spawn_cmd "${filtered[@]}" ) >"$out"
    rc=$?
    set -e
    spillover_emit_host local "$out"
    rm -f "$out"
    return "$rc"
  fi
  # Without spill-over configuration, retain the ordinary local spawn path.
  # Besides avoiding pointless telemetry, this keeps spawn_cmd's quota gate as
  # the first side-effecting boundary for installations that have not opted in.
  if [[ "$requested" == auto && ! -r "$(spillover_config)" ]]; then
    spawn_cmd "${filtered[@]}"
    return $?
  fi
  case "$requested" in
    local)
      spillover_local_measure; selected=local; SPILL_REASON=forced-local; SPILL_DECISION_SOURCE=forced
      ;;
    auto)
      if spillover_hub_placement "$cwd"; then
        SPILL_DECISION_SOURCE=hub
        selected="$SPILL_HUB_HOST"
        SPILL_REASON="${SPILL_HUB_REASON:-hub-decision}"
        # A valid placement reply may deliberately contain no eligible
        # candidates (for example every machine is disconnected or
        # not_accepting).  That is safe to fail open only to this local spawn.
        if [[ -z "$selected" ]]; then
          selected=local
          SPILL_REASON="${SPILL_REASON};no-eligible-candidates"
        fi
        [[ "$selected" == local ]] || grep -qx "$selected" <<<"$(spillover_hosts)" || {
          spillover_log none "hub-unconfigured-host=${selected};${SPILL_REASON}"
          if [[ "$LOCAL_SPAWN_ALLOWED" -eq 1 ]]; then
            echo "wrk: hub selected unconfigured host '$selected'; configure hosts.toml or use --host local" >&2
          else
            echo "wrk: hub selected unconfigured host '$selected'; configure hosts.toml (local spawns are disabled on this host: [local] spawn = false)" >&2
          fi
          return 2
        }
        if [[ "$selected" == local && "$LOCAL_SPAWN_ALLOWED" -eq 0 ]]; then
          # #1155: the hub may still pick this host, but local spawns are
          # refused — the round runs the reply's remaining eligible
          # candidates instead. Defense in depth only: spillover_hub_placement
          # answers the first eligible candidate, so decision=local arrives
          # here as 'local' solely when the reply lists local itself as an
          # eligible candidate — the tested replies never do.
          SPILL_REASON="${SPILL_REASON};local-spawn-disabled"
          selected="${SPILL_HUB_CANDIDATES[0]:-}"
          if [[ -z "$selected" ]]; then
            spillover_log none "${SPILL_REASON};no-remote-candidate"
            echo "wrk: local spawns are disabled on this host ([local] spawn = false); no remote candidate completed." >&2
            return "$WRK_EXIT_LOCAL_SPAWN_DISABLED"
          fi
        fi
      elif [[ "$SPILL_HUB_STATUS" == invalid ]]; then
        spillover_local_measure
        SPILL_DECISION_SOURCE=hub
        spillover_log none "hub-invalid-response"
        echo "wrk: panewire placement response is invalid; refusing local fallback" >&2
        return 2
      else
        SPILL_DECISION_SOURCE=local-fallback
        if [[ "$LOCAL_SPAWN_ALLOWED" -eq 1 ]] && ! spillover_local_is_pressured; then
          selected=local
        else
          if [[ "${LOCAL_SPAWN_ALLOWED:-1}" -eq 0 ]]; then
            # #1155: a disabled local is not a candidate — this arm behaves as
            # if spill-over were required whatever the measured pressure is.
            spillover_local_measure
            SPILL_REASON=local-spawn-disabled
          fi
          SPILL_HUB_CANDIDATES=()
          while IFS= read -r candidate; do
            [[ -z "$candidate" ]] || SPILL_HUB_CANDIDATES+=("$candidate")
          done < <(spillover_hosts)
          selected="${SPILL_HUB_CANDIDATES[0]:-}"
          if [[ -z "$selected" ]]; then
            spillover_log none "${SPILL_REASON};no-remote-capacity"
            if [[ "$LOCAL_SPAWN_ALLOWED" -eq 1 ]]; then
              echo "wrk: spill-over required (${SPILL_REASON}) but no configured remote host has capacity; use --host local to override" >&2
              return 1
            fi
            echo "wrk: local spawns are disabled on this host ([local] spawn = false); no remote candidate completed." >&2
            return "$WRK_EXIT_LOCAL_SPAWN_DISABLED"
          fi
        fi
      fi
      ;;
    *)
      if ! spillover_value "hosts.$requested" ssh >/dev/null 2>&1 && ! grep -qx "$requested" <<<"$(spillover_hosts)"; then
        die "unknown spill-over host '$requested'; use wrk hosts"
      fi
      spillover_local_measure; selected="$requested"; SPILL_REASON=forced-remote; SPILL_DECISION_SOURCE=forced
      ;;
  esac
  # #872: neither the current hub contract nor ssh delegation attests which
  # guard/config version the execution host will load. Refuse before copying
  # a brief, probing/waking a host, or submitting a spawn. Never silently drop
  # the descriptor or downgrade the mock lane on spill-over.
  local execution_lane=""
  for ((i=0; i<${#filtered[@]}; i++)); do
    [[ "${filtered[$i]}" != -L ]] || execution_lane="${filtered[$((i + 1))]:-}"
  done
  if [[ "$selected" != local && "$execution_lane" == mock ]]; then
    echo "wrk: mock MCP isolation refused: remote execution host guard/config cannot be attested; use execution-host local spawn" >&2
    return "$WRK_EXIT_MOCK_MCP_REFUSED"
  fi
  if [[ "$selected" != local && "$(spillover_host_via "$selected" 2>/dev/null || true)" == hub ]]; then
    spillover_log "$selected" "${SPILL_REASON};via=hub"
  else
    spillover_log "$selected" "$SPILL_REASON"
  fi
  if [[ "$selected" == local ]]; then
    out="$(mktemp)"
    # Keep spawn_cmd's errexit semantics (notably a blocked quota gate) in an
    # isolated shell, while retaining strict landing's exit 76 and its emitted
    # OK pane line for host annotation.
    set +e
    ( set -e; spawn_cmd "${filtered[@]}" ) >"$out"
    rc=$?
    set -e
    spillover_emit_host local "$out"
    rm -f "$out"
    return "$rc"
  fi
  [[ -n "$cwd" && -n "$prompt" ]] || die "-c CWD and -p PROMPT_FILE are required"
  local candidates=("$selected") candidate candidate_via last_rc=1 seen_candidates=""
  local cand_err auto_diag="" cand_class
  # #1239 deferred-wake bookkeeping: wake_pending collects the wake-capable
  # candidates that probed ssh-unreachable (round order), and
  # remote_full_seen latches the positive capacity evidence the post-round
  # wake requires — a round with no remote-full answer never wakes.
  local wake_pending="" remote_full_seen=0 wake_target=""
  # --host auto holds every per-candidate diagnostic until the round settles:
  # a successful spawn must print nothing about the hosts it skipped, while an
  # all-fail round owes the operator one attributed line per host plus whatever
  # the remote legs said.  An explicit --host keeps the live stream.
  [[ "$requested" == auto ]] && auto_diag="$(mktemp)"
  if [[ "$requested" == auto ]]; then candidates+=("${SPILL_HUB_CANDIDATES[@]:-}"); fi
  for candidate in "${candidates[@]}"; do
    [[ " $seen_candidates " == *" $candidate "* ]] && continue
    seen_candidates+=" $candidate"
    if ! candidate_via="$(spillover_host_via "$candidate")"; then
      [[ -s "$auto_diag" ]] && cat "$auto_diag" >&2
      echo "wrk: remote host '$candidate' has invalid via setting; use ssh or hub" >&2
      rm -f "$auto_diag"
      return 2
    fi
    if [[ "$candidate_via" == hub ]]; then
      [[ "$candidate" == "$selected" ]] || spillover_log "$candidate" "${SPILL_REASON};via=hub"
      # The spawn helpers toggle set -e internally, so the return code must be
      # read in an if-context: a plain-command call would abort on the rc.
      if spillover_hub_spawn "$candidate" "$cwd" "$prompt" "${filtered[@]}"; then
        last_rc=0
      else
        last_rc=$?
      fi
      if [[ "$last_rc" -ne 0 && -s "$auto_diag" ]]; then cat "$auto_diag" >&2; fi
      rm -f "$auto_diag"
      return "$last_rc"
    fi
    if [[ -n "$auto_diag" ]]; then
      # #1239: under --host auto a candidate with no cwd_map entry for this
      # cwd can never accept the job — its remote would refuse rc 2 at the
      # cwd-map step, which sits in the stop set below and would end the
      # round before the post-round wake. The candidate is skipped BEFORE
      # the probe: silent when a later candidate lands, one held
      # diagnostic line on an all-fail round, and neutral for the wake
      # decision — it neither ends the round nor counts as remote-full
      # evidence. The skip applies only to the hosts.toml-order round
      # (local-fallback): a hub-selected round keeps the fail-closed
      # cwd-map rc 2 contract — the placement decision is authoritative,
      # and quietly moving past it would hide a broken config. An
      # explicit --host NAME keeps the cwd-map rc 2 too.
      if [[ "$SPILL_DECISION_SOURCE" == local-fallback ]] &&
         ! spillover_cwd_map "$candidate" "$cwd"; then
        printf "wrk: remote host '%s' skipped: no cwd_map entry for '%s'\n" "$candidate" "$cwd" >>"$auto_diag"
        continue
      fi
      cand_err="$(mktemp)"
      cand_class="$(mktemp)"
      # A subshell keeps a die() inside the remote legs survivable, and the
      # if-context keeps the callee's internal set -e toggles from arming
      # errexit on its nonzero return.
      if ( SPILL_CANDIDATE_CLASS_FILE="$cand_class" spillover_try_candidate 1 "$candidate" "$cwd" "$prompt" "${filtered[@]}" ) 2>"$cand_err"; then
        # Only the skipped candidates' diagnostics are dropped: the winner's
        # own stderr (remote wrk warnings, scp chatter) replays verbatim, as
        # it streamed live on main.
        cat "$cand_err" >&2
        rm -f "$cand_err" "$cand_class" "$auto_diag"
        return 0
      else
        last_rc=$?
      fi
      case "$(cat "$cand_class" 2>/dev/null || true)" in
        remote-full) remote_full_seen=1 ;;
        ssh-unreachable)
          if [[ "$(spillover_value "hosts.$candidate" wake 2>/dev/null || true)" == panewire ]]; then
            wake_pending+="$candidate "
          fi ;;
      esac
      cat "$cand_err" >>"$auto_diag"
      rm -f "$cand_err" "$cand_class"
    else
      if spillover_try_candidate 0 "$candidate" "$cwd" "$prompt" "${filtered[@]}"; then
        return 0
      else
        last_rc=$?
      fi
    fi
    # Admission refusals and cwd mapping stay fail-closed: transport legs are
    # normalized away from this set, so a 2/74/75 here is the remote wrk's own
    # answer or a config refusal — stop instead of trying the next host.
    case "$last_rc" in
      2|"$WRK_EXIT_ACTIVE_JOB_DUPLICATE"|"$WRK_EXIT_JOB_STATE_UNREADABLE")
        [[ -s "$auto_diag" ]] && cat "$auto_diag" >&2
        rm -f "$auto_diag"
        return "$last_rc" ;;
      "$WRK_EXIT_CONFIG_REFUSED")
        # #1154: a remote wrk's config refusal (its own quota gate answering
        # 70) stops the auto round like the admission refusals above — the
        # round must never reach the local fallback, which could land the job
        # on a host closed to spawns. Transport legs cannot produce 70
        # (spillover_transport_rc maps it to 1), so this rc is always the
        # remote wrk's own answer. An explicit --host NAME keeps its contract:
        # it falls through to the named-host failure line below.
        if [[ "$requested" == auto ]]; then
          [[ -s "$auto_diag" ]] && cat "$auto_diag" >&2
          echo "wrk: remote host '$candidate' refused the spawn with a config error (rc=$last_rc); not falling back to local" >&2
          rm -f "$auto_diag"
          return "$last_rc"
        fi ;;
    esac
  done
  # #1239: the deferred wake decision, made only once the candidate round is
  # over. Under --host auto a wake-capable candidate that probed
  # ssh-unreachable is owed a wake when (a) local cannot take the job
  # ([local] spawn = false, or the same measured pressure that started this
  # round still holds), (b) no candidate landed the job — reaching here
  # proves it, (c) the round was not ended by a stop-set answer — a
  # reachable remote wrk answering 2, 70, 74 or 75 returns inside the loop
  # and never gets here — and (d) at least one candidate answered
  # remote-full, the positive capacity evidence that the fleet really is
  # short. Unmapped candidates were skipped before probing, and transport
  # failures or remote rc 80/81 answers no longer suppress the wake. An
  # explicit --host NAME is the operator forcing that host, so an
  # unreachable wake-capable target wakes unconditionally — wake =
  # "panewire" on that hosts.toml entry is itself the opt-in.
  if [[ "$requested" == auto ]]; then
    if [[ -n "$wake_pending" && "$remote_full_seen" -eq 1 ]] &&
       { [[ "$LOCAL_SPAWN_ALLOWED" -eq 0 ]] || spillover_local_is_pressured; }; then
      wake_target="${wake_pending%% *}"
    fi
  elif [[ "${SPILL_PROBE_REASON:-}" == ssh-unreachable ]] &&
       [[ "$(spillover_value "hosts.$requested" wake 2>/dev/null || true)" == panewire ]]; then
    wake_target="$requested"
  fi
  if [[ -n "$wake_target" ]]; then
    if spillover_wake_request "$wake_target"; then
      # The node answered: place the job through the same legs as any other
      # candidate. A spawn that still fails propagates that rc — the wake
      # already committed this round to the remote answer.
      if [[ -n "$auto_diag" ]]; then
        cand_err="$(mktemp)"
        if ( spillover_try_candidate 1 "$wake_target" "$cwd" "$prompt" "${filtered[@]}" ) 2>"$cand_err"; then
          cat "$cand_err" >&2
          rm -f "$cand_err" "$auto_diag"
          return 0
        else
          last_rc=$?
        fi
        cat "$cand_err" >>"$auto_diag"
        rm -f "$cand_err"
      elif spillover_try_candidate 0 "$wake_target" "$cwd" "$prompt" "${filtered[@]}"; then
        return 0
      else
        last_rc=$?
      fi
      [[ -n "$auto_diag" && -s "$auto_diag" ]] && cat "$auto_diag" >&2
      [[ -n "$auto_diag" ]] && rm -f "$auto_diag"
      echo "wrk: remote host '$wake_target' answered its wake but the spawn still failed (rc=$last_rc); not falling back to local" >&2
      return "$last_rc"
    fi
    [[ -n "$auto_diag" && -s "$auto_diag" ]] && cat "$auto_diag" >&2
    [[ -n "$auto_diag" ]] && rm -f "$auto_diag"
    echo "wrk: $SPILL_WAKE_ERR; not falling back to local" >&2
    return "$WRK_EXIT_WAKE_FAILED"
  fi
  # An explicit --host NAME is an operator forcing one remote: propagate the
  # remote exit instead of quietly landing the pane locally (#571).  The local
  # fallback below exists for --host auto only.
  if [[ "$requested" != auto ]]; then
    if [[ "$LOCAL_SPAWN_ALLOWED" -eq 1 ]]; then
      echo "wrk: remote spawn on explicit host '$requested' failed (rc=$last_rc) at step '${SPILL_REMOTE_STEP:-unknown}'; no local fallback — fix the remote or use --host local" >&2
    else
      echo "wrk: remote spawn on explicit host '$requested' failed (rc=$last_rc) at step '${SPILL_REMOTE_STEP:-unknown}'; no local fallback — fix the remote (local spawns are disabled on this host: [local] spawn = false)" >&2
    fi
    return "$last_rc"
  fi
  [[ -s "$auto_diag" ]] && cat "$auto_diag" >&2
  rm -f "$auto_diag"
  if [[ "$LOCAL_SPAWN_ALLOWED" -eq 0 ]]; then
    echo "wrk: local spawns are disabled on this host ([local] spawn = false); no remote candidate completed." >&2
    return "$WRK_EXIT_LOCAL_SPAWN_DISABLED"
  fi
  warn "no remote spill-over candidate completed; falling back to local"
  out="$(mktemp)"
  set +e
  ( set -e; spawn_cmd "${filtered[@]}" ) >"$out"
  rc=$?
  set -e
  spillover_emit_host local "$out"
  rm -f "$out"
  return "$rc"
}

# #1155: this host's own [local] spawn key decides whether local spawns may
# run here at all. Sets LOCAL_SPAWN_ALLOWED (1 allowed, 0 forbidden). Absent
# or `spawn = true` is the historical behavior and byte-identical to before;
# `spawn = false` forbids every local spawn path — --host auto treats local
# as an unavailable candidate, --host local refuses, and a delegated ssh
# spawn (which arrives as --host local on the execution host) refuses too.
# Accepted values are the bare TOML booleans true/false — a quoted spelling
# such as "false" is a string, not a boolean, so it refuses like any other
# value (fail-closed, the same boundary quota_gate uses).
#
# #1163: the resolution is fail-closed — a safety switch that reads
# "allowed" on a typo is worse than none. local_spawn_scan refuses (rc 70,
# reason in LOCAL_SPAWN_ERROR as "<config> line N: ...") when the [local]
# surface is not in the one accepted shape:
#   - a header that names the local table but is not exactly '[local]' on
#     its own line: '[local] # note', '[ local ]', '["local"]', '[[local]]',
#     a truncated '[local', or '[local]' with trailing text;
#   - a second [local] table header;
#   - inside [local], a second spawn key whatever its value, or a line
#     starting a would-be spawn key that is not 'spawn = <value>' (bare
#     'spawn', 'spawn: false', 'spawn == false', a quoted "spawn" key);
#   - a spawn value other than bare true/false after stripping a trailing
#     '#' comment and whitespace;
#   - any content before the first table header — the root table must be
#     empty, so 'local.spawn = false', '"local".spawn = false' or
#     'local = { spawn = false }' there are root keys, not the flag;
#   - a UTF-8 BOM at any line start (including line 1).
# A hosts.toml that exists but is not a readable regular file also refuses,
# and so does a path whose existence cannot be determined because a parent
# directory is not searchable (stat EACCES) — a truly absent file stays
# allowed. Everything else — no [local], [local] without spawn, one clean
# spawn = true/false, every other key and every other section (a
# 'local.spawn' under [hosts.x] is hosts.x.local.spawn and is ignored) —
# behaves exactly as before; other readers keep going through
# spillover_value, whose behavior this does not change.
local_spawn_table_name() {
  # Canonical name a bracketed line would give its table: trim, drop one
  # bracket layer ('[[x]]' arrives as inner '[x'), then one quoting layer
  # ('"local"'/'\'local\'' -> local). Callers compare against 'local'.
  local name
  name="$(spillover_trim "$1")"
  name="${name#\[}"
  name="${name%\]}"
  name="$(spillover_trim "$name")"
  if [[ "${#name}" -ge 2 ]] &&
    { [[ "$name" == \"*\" && "$name" == *\" ]] ||
      [[ "$name" == \'* && "$name" == *\' ]]; }; then
    name="${name:1:${#name}-2}"
  fi
  printf '%s' "$name"
}

local_spawn_scan() {
  LOCAL_SPAWN_ALLOWED=1
  LOCAL_SPAWN_ERROR=""
  local config line="" current="" inner rest name value
  local n=0 local_seen=0 spawn_seen=0
  config="$(spillover_config)"
  if [[ ! -e "$config" && ! -L "$config" ]]; then
    # The stat failed: a real ENOENT means no flag, but an unsearchable
    # parent (EACCES) makes "absent" unprovable. Walk up to the nearest
    # ancestor that stats; refuse unless it is a searchable directory —
    # anything shallower under it cannot hide a config either way.
    local dir
    dir="$(dirname -- "$config")"
    while [[ ! -e "$dir" && ! -L "$dir" && "$dir" != / && "$dir" != . ]]; do
      dir="$(dirname -- "$dir")"
    done
    if [[ -d "$dir" && ! -x "$dir" ]]; then
      LOCAL_SPAWN_ERROR="$config: existence cannot be determined (a parent directory is not searchable)"
      return "$WRK_EXIT_CONFIG_REFUSED"
    fi
    return 0
  fi
  if [[ ! -f "$config" || ! -r "$config" ]]; then
    LOCAL_SPAWN_ERROR="$config: exists but is not a readable regular file"
    return "$WRK_EXIT_CONFIG_REFUSED"
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    if [[ "$line" == $'\xef\xbb\xbf'* ]]; then
      LOCAL_SPAWN_ERROR="$config line $n: UTF-8 BOM at a line start is not valid hosts.toml"
      return "$WRK_EXIT_CONFIG_REFUSED"
    fi
    line="$(spillover_trim "$line")"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == \[* ]]; then
      if [[ "$line" =~ ^\[([^]]*)\](.*)$ ]]; then
        inner="${BASH_REMATCH[1]}" rest="${BASH_REMATCH[2]}"
      else
        # No ']' anywhere — e.g. a truncated '[local'.
        inner="${line#\[}" rest=unterminated
      fi
      name="$(local_spawn_table_name "$inner")"
      if [[ "$name" == local && "$line" == '[local]' ]]; then
        local_seen=$((local_seen + 1))
        if [[ "$local_seen" -gt 1 ]]; then
          LOCAL_SPAWN_ERROR="$config line $n: duplicate [local] table header"
          return "$WRK_EXIT_CONFIG_REFUSED"
        fi
        current=local
      elif [[ "$name" == local ]]; then
        LOCAL_SPAWN_ERROR="$config line $n: [local] table header must be exactly '[local]' on its own line"
        return "$WRK_EXIT_CONFIG_REFUSED"
      elif [[ -z "$rest" ]]; then
        current="$inner"
      elif [[ -z "$current" ]]; then
        # A bracketed line that names no local table and is not a clean
        # header ('[x] junk', an unclosed '[x') cannot end the root table —
        # as root content it violates the empty-root rule below. Under a
        # table it keeps the same ignore spillover_value gives it.
        LOCAL_SPAWN_ERROR="$config line $n: root table must be empty in hosts.toml (keys belong under a [table] header)"
        return "$WRK_EXIT_CONFIG_REFUSED"
      fi
      continue
    fi
    if [[ -z "$current" ]]; then
      # The root table must be empty: every line before the first table
      # header that is not blank or a comment — 'local.spawn = false',
      # '"local".spawn = false', 'local = { spawn = false }', any other key
      # or stray text — is refused rather than read or ignored.
      LOCAL_SPAWN_ERROR="$config line $n: root table must be empty in hosts.toml (keys belong under a [table] header)"
      return "$WRK_EXIT_CONFIG_REFUSED"
    fi
    [[ "$current" == local ]] || continue
    case "$line" in
      spawn[A-Za-z0-9_-]*) continue ;;   # a different bare key
      spawn* | '"spawn"'* | "'spawn'"*) ;;   # a would-be spawn key
      *) continue ;;
    esac
    if [[ "$line" =~ ^spawn[[:space:]]*=[[:space:]]*(.*)$ ]] && [[ "${BASH_REMATCH[1]}" != =* ]]; then
      value="${BASH_REMATCH[1]}"
    else
      LOCAL_SPAWN_ERROR="$config line $n: malformed spawn assignment in [local] (expected 'spawn = true|false')"
      return "$WRK_EXIT_CONFIG_REFUSED"
    fi
    value="${value%%#*}"
    value="$(spillover_trim "$value")"
    spawn_seen=$((spawn_seen + 1))
    if [[ "$spawn_seen" -gt 1 ]]; then
      LOCAL_SPAWN_ERROR="$config line $n: duplicate spawn key in [local]"
      return "$WRK_EXIT_CONFIG_REFUSED"
    fi
    case "$value" in
      true) ;;
      false) LOCAL_SPAWN_ALLOWED=0 ;;
      *) LOCAL_SPAWN_ERROR="$config line $n: [local] spawn accepts only the bare TOML booleans true or false (got '$value')"
         return "$WRK_EXIT_CONFIG_REFUSED" ;;
    esac
  done <"$config" || {
    # -f/-r passed but the open still failed (vanished, ACL) — fail closed.
    LOCAL_SPAWN_ERROR="$config: exists but is not a readable regular file"
    return "$WRK_EXIT_CONFIG_REFUSED"
  }
  return 0
}

local_spawn_resolve() {
  local rc=0
  local_spawn_scan || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "wrk: ${LOCAL_SPAWN_ERROR}; refusing spawn" >&2
    return "$rc"
  fi
}

# The "use --host local" tail on failure lines is only advice while this host
# accepts local spawns; with [local] spawn = false the tail names the flag
# instead of an override that would be refused. $1 is the non-local
# alternative the line also suggests (configure hosts.toml, retry, ...).
spillover_local_advice() {
  if [[ "${LOCAL_SPAWN_ALLOWED:-1}" -eq 0 ]]; then
    printf 'local spawns are disabled on this host ([local] spawn = false)%s' "${1:+; }$1"
  else
    printf 'use --host local%s' "${1:+ or }$1"
  fi
}

hosts_help() {
  cat <<'USAGE'
Usage: wrk hosts

Print the resolved hosts.toml path, this host's [local] spawn flag state
(local spawn=allowed|disabled|error — an error means the file refuses
spawns with rc 70; hosts is a reporting command and stays rc 0), this
host's measured load (load5/ncpu ratio and active spawn count), then probe
every configured spill-over host and print a status table (available, or
the probe failure reason, with the remote load/active counts when
reachable).

  -h, --help   show this usage
USAGE
}

hosts_cmd() {
  local host config
  if [[ $# -gt 0 ]]; then
    if [[ "$1" == "-h" || "$1" == "--help" ]]; then
      [[ $# -eq 1 ]] || die "unexpected argument '$2'"
      hosts_help
      return 0
    fi
    die "unexpected argument '$1'"
  fi
  config="$(spillover_config)"
  spillover_local_measure
  printf 'config=%s\n' "$config"
  # #1163: surface the [local] spawn switch so a mistyped closure is visible
  # on the reporting path. hosts is read-only — a config error shows as
  # `error (...)` here and must not change this command's exit code.
  local_spawn_scan || true
  if [[ -n "${LOCAL_SPAWN_ERROR:-}" ]]; then
    printf 'local spawn=error (%s)\n' "$LOCAL_SPAWN_ERROR"
  elif [[ "${LOCAL_SPAWN_ALLOWED:-1}" -eq 0 ]]; then
    printf 'local spawn=disabled\n'
  else
    printf 'local spawn=allowed\n'
  fi
  printf 'local load5=%s ncpu=%s ratio=%s active=%s\n' "${SPILL_LOAD:-unknown}" "${SPILL_NCPU:-unknown}" "${SPILL_RATIO:-unknown}" "${SPILL_ACTIVE:-unknown}"
  printf 'host\tstatus\tload5\tactive\n'
  for host in $(spillover_hosts); do
    if spillover_probe_host "$host"; then
      printf '%s\tavailable\t%s\t%s\n' "$host" "${SPILL_REMOTE_LOAD:-unknown}" "${SPILL_REMOTE_ACTIVE:-unknown}"
    else
      printf '%s\t%s\t%s\t%s\n' "$host" "$SPILL_PROBE_REASON" "${SPILL_REMOTE_LOAD:-unknown}" "${SPILL_REMOTE_ACTIVE:-unknown}"
    fi
  done
}


# ---------------------------------------------------------------- hk task link
# #768 / hk:doc decision/2026-09-27/task-job-linkage item 1: every spawned job
# is bound to a handoffkeep task. --task names the task the new job owns;
# tester/advisory (child) spawns inherit the parent task instead — explicit
# --parent-job, else the calling session's ARBITER_JOB claim, else HK_TASK_ID
# env. The hk write is a single `tasks claim <id> --by <label> --job-id <job>`
# on the success path only; a failed spawn must leave hk untouched, so the
# probe below is read-only and the claim is the last side effect before the
# OK line. Deployed hk predating claim+job_id support drops --job-id silently:
# the post-claim verify turns that into a loud spawn failure instead of a
# record that looks linked but is not (never two calls — see the report).

HK_CMD_TIMEOUT="${HK_CMD_TIMEOUT:-15}"

hk_bin() {
  command -v "${HANDOFFKEEP_BIN:-handoffkeep}" 2>/dev/null || true
}

# A wedged handoffkeep must not stall a spawn. `timeout` is GNU coreutils and
# a stock macOS has neither it nor gtimeout, so python3 — already a hard
# dependency — carries the same guard there (same pattern as the panewire
# guard above).
hk_cmd() {
  local bin="$1"; shift
  run_bounded "$HK_CMD_TIMEOUT" "$bin" "$@"
}

# task_resolve_parent — TASK_INHERITED_FROM is set by the caller to a parent
# job id; fill TASK_ID from its newest claim/reclaim payload. Local read only:
# the job registry under wrk_jobs_root is the same one the claim landed in.
# The newest claim/reclaim event is authoritative: an unreadable one dies
# rather than letting a stale older task_id through (tester finding).
task_resolve_parent() {
  local parent="$1" dir rc
  dir="$(wrk_jobs_root)/$parent/events"
  if TASK_ID="$(python3 - "$dir" <<'PY'
import json, os, sys
try:
    names = sorted(n for n in os.listdir(sys.argv[1])
                   if n.endswith(("claim.json", "reclaim.json")))
except OSError:
    raise SystemExit(1)
if not names:
    raise SystemExit(0)
# Seq-prefixed names sort newest-last; only that event is authoritative.
try:
    o = json.load(open(os.path.join(sys.argv[1], names[-1]), encoding="utf-8"))
except (OSError, json.JSONDecodeError):
    raise SystemExit(2)
p = o.get("payload", o)
v = p.get("task_id")
print(v if isinstance(v, int) else (v if isinstance(v, str) else ""))
PY
)"; then
    :
  else
    rc=$?
    if [[ "$rc" -eq 2 ]]; then
      die "parent job '$parent' newest claim/reclaim event is unreadable — refusing to guess the task from older events"
    fi
    TASK_ID=""
  fi
}

# task_validate — usage-error stage: resolve TASK_ID or die before any side
# effect (gates, pane, hk writes all come later). Sets TASK_LINK_MODE to
# owner (--task) or inherited (tester/advisory path) and TASK_INHERITED_FROM.
task_validate() {
  TASK_LINK_MODE="" TASK_INHERITED_FROM=""
  if [[ -n "$TASK_ID" && ! "$TASK_ID" =~ ^[0-9]+$ ]]; then
    die "--task must be a positive handoffkeep task id (got '$TASK_ID')"
  fi
  if [[ -n "$TASK_ID" ]] && (( 10#$TASK_ID < 1 )); then
    die "--task must be a positive handoffkeep task id (got '$TASK_ID')"
  fi
  if [[ -n "$PARENT_JOB" ]] && [[ ! "$PARENT_JOB" =~ ^[A-Za-z0-9._-]+$ ]]; then
    die "--parent-job must be a job id (got '$PARENT_JOB')"
  fi
  if [[ "$ROLE" == builder ]]; then
    [[ -z "$PARENT_JOB" ]] ||
      die "--role builder links its own task with --task; --parent-job is the tester/advisory inheritance path"
    [[ -n "$TASK_ID" ]] ||
      die "--role builder requires --task <hk task id> (decision/2026-09-27/task-job-linkage: every job binds its task)"
    TASK_LINK_MODE="owner"
    return 0
  fi
  if [[ -n "$TASK_ID" && -n "$PARENT_JOB" ]]; then
    die "--task and --parent-job are alternatives — a worker names either its own task or the parent job it inherits from, not both"
  fi
  if [[ -n "$TASK_ID" ]]; then
    TASK_LINK_MODE="owner"
    return 0
  fi
  # Worker/tester/advisory inheritance: the task comes from the parent job's
  # recorded meta, never guessed. Explicit --parent-job first, then the
  # calling session's own arbiter job (spawned panes carry ARBITER_JOB), then
  # the propagated HK_TASK_ID env. For remote/hub spawns none of the local
  # sources may exist — pass --task there (documented in wrk spawn --help).
  local env_task=""
  if [[ -z "$PARENT_JOB" && -n "${ARBITER_JOB:-}" ]]; then
    PARENT_JOB="$ARBITER_JOB"
  fi
  if [[ -n "${HK_TASK_ID:-}" ]]; then
    env_task="$HK_TASK_ID"
  fi
  if [[ -n "$PARENT_JOB" ]]; then
    task_resolve_parent "$PARENT_JOB"
    if [[ -z "$TASK_ID" && -n "$env_task" ]]; then
      TASK_ID="$env_task"
      TASK_INHERITED_FROM="env:HK_TASK_ID"
    elif [[ -n "$TASK_ID" && -n "$env_task" && "$TASK_ID" != "$env_task" ]]; then
      die "parent job '$PARENT_JOB' recorded task_id=$TASK_ID but HK_TASK_ID=$env_task — refusing to guess; pass --task explicitly"
    else
      TASK_INHERITED_FROM="$PARENT_JOB"
    fi
    [[ -n "$TASK_ID" ]] ||
      die "parent job '$PARENT_JOB' has no task_id in its claim/reclaim meta — pass --task explicitly or re-register the parent with --task"
    { [[ "$TASK_ID" =~ ^[0-9]+$ ]] && (( 10#$TASK_ID >= 1 )); } ||
      die "task id '$TASK_ID' resolved from parent job '$PARENT_JOB' is not a positive task id — pass --task explicitly"
    TASK_LINK_MODE="inherited"
    return 0
  fi
  if [[ -n "$env_task" ]]; then
    { [[ "$env_task" =~ ^[0-9]+$ ]] && (( 10#$env_task >= 1 )); } ||
      die "HK_TASK_ID env is not a positive task id ('$env_task') — pass --task explicitly"
    TASK_ID="$env_task"
    TASK_LINK_MODE="inherited"
    TASK_INHERITED_FROM="env:HK_TASK_ID"
    return 0
  fi
  die "--task <hk task id> is required for --role worker (decision/2026-09-27/task-job-linkage). Tester/advisory spawns may instead inherit the parent task: pass --parent-job <job>, or spawn from a registered job's pane where ARBITER_JOB/HK_TASK_ID is set"
}

# hk_task_gate_failure — the hk-unreachable/undecidable funnel. The override
# flag converts refusal into a recorded bypass; without it the spawn dies
# here, before gates and pane: no job without its task link (AC3).
hk_task_gate_failure() {
  local reason="$1"
  if [[ "$TASK_HK_BYPASS" -eq 1 ]]; then
    warn "hk task precheck unavailable ($reason) — --task-hk-bypass override engaged; spawn proceeds, the link write will be retried after landing and the override recorded in job meta"
    TASK_LINK_STATUS="bypassed:precheck"
    return 0
  fi
  die "hk task precheck failed ($reason) — spawn refused: no job without its task link (pass --task-hk-bypass to override, recorded in job meta)"
}

# hk_task_precheck — read-only `tasks show` classification. Sets
# TASK_LINK_STATUS: link (owner, needs the claim write), already_linked
# (refs.job_id already this job — idempotent re-spawn), inherited (child job:
# meta link only, the owner's claim stands), or bypassed:<reason> under the
# override. Every refusal is a die before any side effect.
hk_task_precheck() {
  TASK_LINK_STATUS=""
  [[ -n "$TASK_ID" ]] || die "internal: task_validate must run before hk_task_precheck"
  local handoffkeep out rc=0 fields t_state="" t_claimed="" t_job=""
  handoffkeep="$(hk_bin)"
  if [[ -z "$handoffkeep" ]]; then
    hk_task_gate_failure "handoffkeep binary not found (set HANDOFFKEEP_BIN)"
    return 0
  fi
  set +e
  out="$(hk_cmd "$handoffkeep" tasks show "$TASK_ID" 2>&1)"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    if grep -q "not_found" <<<"$out"; then
      die "hk task $TASK_ID does not exist (not_found) — a job binds only an existing task"
    fi
    hk_task_gate_failure "handoffkeep tasks show rc=$rc: ${out:0:200}"
    return 0
  fi
  set +e
  # One tab-separated line: per-line prints would lose trailing empty fields
  # to command-substitution stripping and the third `read` would hit EOF.
  fields="$(printf '%s' "$out" | python3 -c '
import json, sys
try: d = json.loads(sys.stdin.read())
except ValueError: raise SystemExit(1)
refs = d.get("refs") or {}
print("\t".join([d.get("state") or "", d.get("claimed_by") or "",
                 refs.get("job_id") or ""]))')"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    hk_task_gate_failure "handoffkeep tasks show returned unreadable JSON"
    return 0
  fi
  IFS=$'\t' read -r t_state t_claimed t_job <<<"$fields"
  if [[ "$TASK_LINK_MODE" == inherited ]]; then
    # Child jobs never claim: the owner's record stands. Existence is the
    # only requirement; state is observational.
    TASK_LINK_STATUS="inherited"
    return 0
  fi
  case "$t_state" in
    merged|dropped)
      die "hk task $TASK_ID is '$t_state' — a closed task is not a spawn target" ;;
    needs_decision)
      die "hk task $TASK_ID awaits an operator decision (needs_decision) — resolve it before spawning" ;;
    hold)
      die "hk task $TASK_ID is on hold — release it before spawning" ;;
  esac
  if [[ -n "$t_job" && "$t_job" != "$JOB_ID" ]]; then
    die "hk task $TASK_ID is already bound to job '$t_job' (state=$t_state claimed_by=${t_claimed:-none}) — a task linked to another job cannot be re-spawned (fail-closed)"
  fi
  if [[ "$t_job" == "$JOB_ID" ]]; then
    TASK_LINK_STATUS="already_linked"
    return 0
  fi
  # Unbound. A claim recorded under a different label is a half-record wrk
  # must not merge into; the same label is the repair path (a claim that
  # landed without job_id, e.g. a bypassed spawn being re-run).
  if [[ -n "$t_claimed" && "$t_claimed" != "$LABEL" ]]; then
    die "hk task $TASK_ID is claimed by '$t_claimed' but bound to no job — a half-record; refusing to merge into another lane's claim"
  fi
  TASK_LINK_STATUS="link"
  return 0
}

# hk_task_link_event — durable link outcome in the job's own events, next to
# claim/reclaim. Best-effort: the claim payload already carries task_id; this
# record answers "did the hk side land" from files alone.
hk_task_link_event() {
  local status="$1" detail="${2:-}"
  [[ "${ARBITER_JOB_REGISTERED:-0}" -eq 1 && -n "${ARBITER:-}" && -x "${ARBITER:-}" ]] || return 0
  local payload
  payload="$(python3 - "$TASK_ID" "$status" "$LABEL" "$JOB_ID" "$TASK_LINK_MODE" "$TASK_INHERITED_FROM" "$detail" <<'PY'
import json, sys
task_id, status, label, job, mode, inherited, detail = sys.argv[1:]
x = {"task_id": int(task_id) if task_id.isdigit() else task_id,
     "status": status, "claimed_by": label, "job_id": job, "mode": mode}
if inherited: x["inherited_from"] = inherited
if detail: x["detail"] = detail[:200]
print(json.dumps(x, separators=(",", ":")))
PY
)" || return 0
  "$ARBITER" event --job "$JOB_ID" --kind job.task_link --payload-json "$payload" >/dev/null 2>&1 ||
    warn "arbiter job.task_link event failed (job=$JOB_ID task=$TASK_ID status=$status)"
  return 0
}

# hk_task_link — the only hk write in the spawn path, and deliberately the
# last side effect before the OK line: a failed spawn changes nothing in hk.
# One `tasks claim` call must land claimed_by=<spawned label> AND
# refs.job_id=<job> together; the response verify turns a hk that drops
# job_id (predates claim+job_id support) into a loud refusal rather than a
# silently half-written record. claim's own conflict keeps a concurrent
# winner: the losing spawn dies here and its pane is cleaned by the EXIT trap.
hk_task_link() {
  [[ -n "$TASK_ID" ]] || return 0
  # A claim that attempted and failed runs under the installation-transition
  # contract: the spawn continued without registration, so bind the task
  # through hk anyway — it is the durable record — and say so loudly rather
  # than silently leaving the bind unevidenced in the arbiter events.
  if [[ "${ARBITER_CLAIM_FAILED:-0}" -eq 1 ]]; then
    warn "arbiter claim failed for job $JOB_ID; binding task $TASK_ID via hk as the durable record — the job events will not carry a task_link entry (unregistered job)"
  fi
  # Inherited children never claim: the owner's record stands. Even when a
  # bypass flag degraded the precheck to bypassed:*, the link write stays
  # owner-only — the outcome is recorded, the task is untouched.
  if [[ "$TASK_LINK_MODE" == "inherited" ]]; then
    local st="$TASK_LINK_STATUS"
    [[ "$st" == bypassed:* ]] || st="inherited"
    hk_task_link_event "$st" ""
    return 0
  fi
  case "$TASK_LINK_STATUS" in
    link|bypassed:*) ;;
    already_linked|inherited) hk_task_link_event "$TASK_LINK_STATUS" ""; return 0 ;;
    *) warn "hk task link skipped: unknown status '$TASK_LINK_STATUS'"; return 0 ;;
  esac
  local handoffkeep out rc=0
  handoffkeep="$(hk_bin)"
  if [[ -n "$handoffkeep" ]]; then
    set +e
    out="$(hk_cmd "$handoffkeep" tasks claim "$TASK_ID" --by "$LABEL" --job-id "$JOB_ID" 2>&1)"
    rc=$?
    set -e
  else
    rc=127 out="handoffkeep binary not found (set HANDOFFKEEP_BIN)"
  fi
  if [[ "$rc" -eq 0 ]] &&
    printf '%s' "$out" | python3 -c '
import json, sys
try: d = json.loads(sys.stdin.read())
except ValueError: raise SystemExit(1)
refs = d.get("refs") or {}
ok = d.get("claimed_by") == sys.argv[1] and refs.get("job_id") == sys.argv[2]
raise SystemExit(0 if ok else 1)' "$LABEL" "$JOB_ID"; then
    hk_task_link_event "linked" ""
    return 0
  fi
  # The bypass covers only what it was declared for: hk unreachable at
  # precheck (bypassed:*) plus a nonzero claim rc. A reachable refusal and a
  # response that drops refs.job_id stay fail-closed — they are half-record
  # evidence, not unavailability.
  if [[ "$rc" -ne 0 && "$TASK_HK_BYPASS" -eq 1 && "$TASK_LINK_STATUS" == bypassed:* ]]; then
    warn "hk task link write failed (rc=$rc) but --task-hk-bypass was given — job $JOB_ID proceeds without the hk link; override recorded in job meta"
    hk_task_link_event "bypassed:link_write_failed" "$out"
    return 0
  fi
  die "hk task link failed for task $TASK_ID job $JOB_ID (rc=$rc: ${out:0:300}) — spawn refused after landing; pane and quota record are being released. The claim must set claimed_by and refs.job_id in one call; on an hk predating claim+job_id the task may be left claimed without job_id — repair with 'handoffkeep tasks transition $TASK_ID --to in_progress --job-id $JOB_ID'"
}


# #872: this helper is part of this wrk checkout, never a PATH-selected guard.
# Artifacts live outside the worktree. No guard override or bypass is offered.
mock_mcp_prepare() {
  [[ "$LANE" == mock ]] || return 0
  MOCK_MCP_HELPER="$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve().parent / "wrk-mock-mcp")' "$0")"
  [[ -x "$MOCK_MCP_HELPER" ]] || { echo "wrk: mock MCP isolation helper missing" >&2; return "$WRK_EXIT_MOCK_MCP_REFUSED"; }
  local rc=0
  MOCK_MCP_PLAN="$("$MOCK_MCP_HELPER" prepare --kind "$PROFILE_KIND" --cwd "$CWD" \
    --profile "${MOCK_MCP_PROFILE:-}" --config "${WRK_MOCK_MCP_CONFIG:-}" -- "${ARGS[@]}")" || rc=$?
  [[ "$rc" -eq 0 ]] || return "$WRK_EXIT_MOCK_MCP_REFUSED"
  CWD="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["cwd"])' "$MOCK_MCP_PLAN")"
  ARGS=()
  while IFS= read -r -d '' value; do ARGS+=("$value"); done < <(
    python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.stdout.buffer.write(b"".join(x.encode()+b"\0" for x in d["argv"]))' "$MOCK_MCP_PLAN")
  while IFS= read -r -d '' value; do TAB_ENV+=(--env "$value"); done < <(
    python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.stdout.buffer.write(b"".join((k+"="+v).encode()+b"\0" for k,v in d["env"].items()))' "$MOCK_MCP_PLAN")
  mock_mcp_verify
}

mock_mcp_verify() {
  [[ "$LANE" == mock ]] || return 0
  [[ -n "${MOCK_MCP_PLAN:-}" ]] || { echo "wrk: mock MCP connection was not prepared" >&2; return "$WRK_EXIT_MOCK_MCP_REFUSED"; }
  local verify_args=(verify --plan "$MOCK_MCP_PLAN" --cwd "$CWD")
  [[ "${1:-}" != --require-attached ]] || verify_args+=(--require-attached)
  "$MOCK_MCP_HELPER" "${verify_args[@]}" -- "${ARGS[@]}" --wrk-pane-env "${TAB_ENV[@]}" ||
    return "$WRK_EXIT_MOCK_MCP_REFUSED"
}

mock_mcp_cleanup() {
  if [[ "${SPAWN_MOCK_MCP_RETAIN:-0}" != 1 && -n "${MOCK_MCP_PLAN:-}" ]]; then
    "$MOCK_MCP_HELPER" stop --plan "$MOCK_MCP_PLAN" >/dev/null 2>&1 || true
  fi
}

spawn_cmd() {
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { spawn_help; return 0; }
  CWD="" MODEL="" PROMPT="" WS="" LABEL="" LANE="" EFFORT="" JOB_ID="" JOB_T="" OWNER="" ROLE="worker" BUILDER_LANE="" PARENT_LANE="" REPORT_PATH="" JOB_DUP_OK=0 LANDING_STRICT=0 LANDING_NO_DETAIL="" KEEP=0
  OPERATOR_REQUEST="" REQUESTED_BY="" PURPOSE="" TASK_ID="" PARENT_JOB="" TASK_HK_BYPASS=0 TASK_LINK_MODE="" TASK_INHERITED_FROM="" TASK_LINK_STATUS="" ARBITER_CLAIM_FAILED=0
  ARBITER_HELD=0 ARBITER_RESOURCE="" ARBITER_PROFILE="" ARBITER_STARTED_AT="" GATE_OUTPUT="" GATE_READY=0 ARBITER_JOB_REGISTERED=0 HUB_QUOTA_GATE_WARNED=0
  TAB_CREATE_JSON="" TAB_ID=""
  MOCK_MCP_PLAN="" MOCK_MCP_HELPER="" SPAWN_MOCK_MCP_RETAIN=0
  # Armed once for the whole spawn: both cleanup actions are guarded (pane
  # only when SPAWN_PANE_OPEN/PANE are set, quota release only when
  # ARBITER_HELD=1), so a die anywhere after the pane opens cannot leak it —
  # including the no-lease path where the arbiter claim or record failed.
  trap 'spawn_pane_cleanup; arbiter_release_held; mock_mcp_cleanup' EXIT
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) spawn_help; return 0 ;;
      -c|-m|-p|-w|-l|-L|--effort|--job|--t|--owner|--role|--lane|--parent|--report|--operator-request|--requested-by|--purpose|--task|--parent-job)
        { [[ $# -ge 2 && -n "$2" ]] && ! wrk_option_token "$2"; } || die "$1 requires a value"
        case "$1" in
          -c) CWD="$2" ;; -m) MODEL="$2" ;; -p) PROMPT="$2" ;; -w) WS="$2" ;;
          -l) LABEL="$2" ;; -L) LANE="$2" ;; --effort) EFFORT="$2" ;;
          --job) JOB_ID="$2" ;; --t) JOB_T="$2" ;; --owner) OWNER="$2" ;;
          --role) ROLE="$2" ;; --lane) BUILDER_LANE="$2" ;; --parent) PARENT_LANE="$2" ;;
          --report) REPORT_PATH="$2" ;;
          --operator-request) OPERATOR_REQUEST="$2" ;; --requested-by) REQUESTED_BY="$2" ;;
          --purpose) PURPOSE="$2" ;; --task) TASK_ID="$2" ;; --parent-job) PARENT_JOB="$2" ;;
        esac
        shift 2 ;;
      --task-hk-bypass) TASK_HK_BYPASS=1; shift ;;
      --job-dup-ok) JOB_DUP_OK=1; shift ;;
      --landing-strict) LANDING_STRICT=1; shift ;;
      --keep) KEEP=1; shift ;;
      -*) die "unknown option '$1'" ;;
      *) die "unexpected argument '$1'" ;;
    esac
  done
  # #1155: several router paths reach spawn_cmd directly (an unclassified
  # spawn, an unreadable arbiter, a hosts.toml-less auto). The flag gate
  # repeats here so no local spawn path runs on a host whose own [local]
  # spawn = false — before any usage check, gate, claim or pane.
  local_spawn_resolve || return
  if [[ "${LOCAL_SPAWN_ALLOWED:-1}" -eq 0 ]]; then
    echo "wrk: local spawns are disabled on this host ([local] spawn = false); refusing spawn" >&2
    return "$WRK_EXIT_LOCAL_SPAWN_DISABLED"
  fi
  [[ -n "$CWD" ]] || die "-c CWD is required"
  [[ -n "$MODEL" ]] || die "-m MODEL is required"
  [[ -n "$PROMPT" ]] || die "-p PROMPT_FILE is required"
  [[ -n "$WS" ]] || die "-w WORKSPACE is required"
  [[ -n "$LABEL" ]] || die "-l LABEL is required"
  # ROB-1215 (herdr 0.8 bundled skill): agent names must match [a-z][a-z0-9_-]{0,31}
  # — lowercase, ≤32 chars, unique among live agents. herdr rejects violations late
  # and cryptically; retries then mutate the label (2026-08-03: legA-alpha-live vs
  # lega-alpha — one job forked into two ids over the uppercase 'A'). Fail early.
  [[ "$LABEL" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "invalid label '$LABEL' — herdr agent names must match [a-z][a-z0-9_-]{0,31} (lowercase, ≤32 chars)"
  [[ -r "$PROMPT" ]] || die "prompt file is not readable: $PROMPT"

  [[ -n "$JOB_ID" ]] || JOB_ID="$LABEL"

  case "$ROLE" in
    worker|builder) ;;
    captain)
      warn "--role captain is deprecated; use --role builder"
      ROLE="builder"
      ;;
    *) die "--role accepts only worker or builder (legacy alias: captain)" ;;
  esac
  case "$BUILDER_LANE" in
    director-*|admiral-*) die "--lane '$BUILDER_LANE' is reserved for director lanes; --role builder/worker cannot claim it" ;;
  esac
  if [[ "$ROLE" == builder ]]; then
    [[ -n "$BUILDER_LANE" ]] || die "--role builder requires --lane BUILDER_LANE (legacy alias: captain)"
    [[ -n "$PARENT_LANE" ]] || die "--role builder requires --parent PARENT_LANE (legacy alias: captain)"
    [[ -z "$OWNER" ]] || die "--role builder uses --lane; do not combine it with --owner"
    [[ "$BUILDER_LANE" != "$PARENT_LANE" ]] || die "--role builder forbids --lane and --parent being the same (self parent)"
    case "$MODEL" in
      builder-astra|codex-astra|captain-astra)
        die "--role builder rejects astra profile '$MODEL': astra is limited to director judgment, architect counsel and operator-requested advice (hk:doc decision/2026-09-21/astra-allowed-purposes-approved)" ;;
      builder-opus|builder-sol|builder-sol6|builder-devin|builder-devin-medium|builder-devin-max|builder-ds41|builder-ds41-max|builder-grok|builder-kimi|builder-luna|builder-sonnet|builder-opus-low|builder-opus-medium|builder-sonnet-xhigh|builder-sonnet-max|builder-sol-high|builder-sol-max|builder-sol-medium|builder-luna-max|builder-terra-high|builder-terra-xhigh|builder-terra-max|builder-kimi-high|builder-kimi-max|builder-grok-low|builder-grok-medium|builder-grok-xhigh|devin-swe2|devin-swe2-medium|devin-swe2-max|grok|grok-hi|kimi-k3|captain-opus|captain-sol) ;;
      *) die "--role builder accepts only builder-opus, builder-sol, builder-sol6 (#1026 rollback), builder-devin, builder-devin-medium, builder-devin-max, builder-ds41, builder-ds41-max, builder-grok, builder-kimi, builder-luna, builder-sonnet or the E6 rungs builder-opus-low, builder-opus-medium, builder-sonnet-xhigh, builder-sonnet-max, builder-sol-high, builder-sol-max, builder-luna-max, builder-terra-high, builder-terra-xhigh, builder-terra-max, builder-kimi-high, builder-kimi-max (#704), builder-grok-low, builder-grok-medium, builder-grok-xhigh, builder-sol-medium (#737) (pilot worker spellings devin-swe2, devin-swe2-medium, devin-swe2-max, grok/grok-hi, kimi-k3 and legacy captain-* aliases accepted; astra spellings rejected per hk:doc decision/2026-09-21/astra-allowed-purposes-approved; codex-terra, the worker codex-luna spellings and devin-glm52/devin-swe17/devin-ds41/devin-ds41-max are worker-only — the ds41 builder path is builder-ds41/builder-ds41-max; the max-rung E6 spellings resolve but are refused by the builder-seat no-max rule, operator decision 2026-09-26 — builder-sonnet's explicit max is the named exception, 2026-09-29)" ;;
    esac
    case "$MODEL" in
      builder-opus|captain-opus)
        [[ -z "$EFFORT" || "$EFFORT" == high ]] || die "builder-opus (legacy captain-opus alias) requires effort high"
        ;;
      # #633: the catalog grades codex-luna per effort (medium=B, max=A+). The
      # E3 sample is defined at xhigh only — a lower or higher --effort would
      # move the rung the ceiling was rated at, so the guard reuses the
      # builder-opus pin and refuses rather than silently relaunch.
      builder-luna)
        [[ -z "$EFFORT" || "$EFFORT" == xhigh ]] || die "builder-luna requires effort xhigh (#594 E3 sample profile)"
        ;;
      # #921: the Sonnet 5.5 experiment seat takes a closed effort set —
      # high|xhigh|max (default xhigh). max is admitted for this spelling only
      # (seat-rule exemption in resolve_profile); low/medium/ultra die here.
      builder-sonnet)
        case "${EFFORT:-xhigh}" in
          high|xhigh|max) ;;
          *) die "builder-sonnet accepts only --effort high|xhigh|max (default xhigh; #921)" ;;
        esac
        ;;
      # #704: the E6 rungs pin their effort in the name's last segment.
      # resolve_profile repeats the check against GATE_EFFORT_PIN and enforces
      # the SCOPEFUEL_E6_ARM marker; refusing here too keeps the failure on the
      # same die path the other pinned builders use.
      builder-opus-low|builder-opus-medium|builder-sonnet-xhigh|builder-sonnet-max|builder-sol-high|builder-sol-max|builder-sol-medium|builder-luna-max|builder-terra-high|builder-terra-xhigh|builder-terra-max|builder-grok-low|builder-grok-medium|builder-grok-xhigh)
        [[ -z "$EFFORT" || "$EFFORT" == "${MODEL##*-}" ]] || die "$MODEL is pinned to effort ${MODEL##*-} (#594 E6 rung)"
        ;;
    esac
  else
    [[ -z "$BUILDER_LANE" && -z "$PARENT_LANE" ]] || die "--lane/--parent require --role builder (legacy alias: captain)"
    case "$MODEL" in
      builder-opus|builder-sol|builder-sol6|builder-devin|builder-devin-medium|builder-devin-max|builder-ds41|builder-ds41-max|builder-grok|builder-kimi|builder-luna|builder-sonnet|builder-opus-low|builder-opus-medium|builder-sonnet-xhigh|builder-sonnet-max|builder-sol-high|builder-sol-max|builder-sol-medium|builder-luna-max|builder-terra-high|builder-terra-xhigh|builder-terra-max|builder-kimi-high|builder-kimi-max|builder-grok-low|builder-grok-medium|builder-grok-xhigh|captain-opus|captain-sol)
        die "builder profiles (legacy captain-* aliases accepted) require --role builder"
        ;;
    esac
  fi

  # #768: task binding is decided here, still before any side effect — a
  # missing/unresolvable task id is a usage error, never a partial spawn.
  task_validate

  resolve_profile
  configure_landing_check "$PROFILE_KIND"
  LANE_ENV=()
  if [[ -n "$LANE" ]]; then
    case "$LANE" in
      live|mock)
        if [[ -d "$CWD/$LANE" ]]; then CWD="$CWD/$LANE";
        else warn "-L $LANE: $CWD/$LANE absent; cwd unchanged"; fi ;;
      *) die "-L accepts only live or mock" ;;
    esac
    if [[ "$LANE" == mock ]]; then
      LANE_ENV+=(--env "MCP_PROFILE=${MOCK_MCP_PROFILE:-}")
    fi
  fi
  # ROB-1206: arbiter owner_lane is *who spawned this*, not the execution lane.
  # Conflating them made every record `default` (or `mock`), so an orch could not
  # query `arbiter status --lane <itself>` to find and reclaim its own workers.
  # -L live|mock stays the execution lane; --owner names the spawning session.
  JOB_LANE="${BUILDER_LANE:-${OWNER:-default}}"
  ARBITER_CLAIM_ROLE_ARGS=(--role "$ROLE")
  if [[ "$ROLE" == builder ]]; then
    ARBITER_CLAIM_ROLE_ARGS+=(--parent-lane "$PARENT_LANE")
  fi

  # ROB-1198 §③ / ROB-1199 claim contract: an unclassified job is not spawned.
  # There is no default T — a blank one would be recorded as fact by arbiter.
  # Checked before the quota gate, so nothing is measured, claimed or spawned.
  [[ -n "$JOB_T" ]] ||
    die "NEEDS_CLASSIFICATION: --t T0..T3 is required (job '$JOB_ID'); classify it, do not guess"
  case "$JOB_T" in T0|T1|T2|T3) ;; *) die "--t accepts only T0, T1, T2 or T3" ;; esac

  # #768: read-only hk task probe — fail closed before the quota gate measures
  # anything, before any pane, before any hk write. Sets TASK_LINK_STATUS.
  hk_task_precheck

  # #768: the job's own meta carries the task binding (job.claim/job.reclaim
  # payload); the override marker is recorded only when the flag was passed —
  # declared use is auditable even when the bypass turned out unnecessary.
  ARBITER_CLAIM_TASK_ARGS=(--task-id "$TASK_ID")
  if [[ "$TASK_HK_BYPASS" -eq 1 ]]; then
    if [[ "$TASK_LINK_STATUS" == bypassed:* ]]; then
      ARBITER_CLAIM_TASK_ARGS+=(--task-link-override "hk_unreachable")
    else
      ARBITER_CLAIM_TASK_ARGS+=(--task-link-override "declared")
    fi
  fi
  if [[ "$TASK_LINK_MODE" == inherited ]]; then
    ARBITER_CLAIM_TASK_ARGS+=(--task-inherited-from "$TASK_INHERITED_FROM")
  fi

  # Advisory only (never fails spawn). After -L may have rewritten CWD.
  warn_if_canonical_off_default "$CWD"

  quota_gate
  # The catalog's own refusal, held back so the quota gate could speak first.
  [[ "${CATALOG_REFUSED:-0}" -ne 1 ]] ||
    die "scopefuel policy launch refused profile '$MODEL' (catalog profile '$CATALOG_PROFILE'): ${CATALOG_REFUSE_REASON:-no reason reported}"
  arbiter_admit
  quota_hub_policy_gate
  [[ -x "$HERDR" ]] || die "herdr unavailable: $HERDR"

  if [[ "$PROFILE_KIND" == kimi ]]; then
    if ! CWD="$(cd -- "$CWD" 2>/dev/null && pwd -P)"; then
      die "cannot resolve Kimi CWD to an absolute path: $CWD"
    fi
    kimi_seed_workspace_trust "$CWD" "$KIMI_TRUST_HOME"
  fi

  # #912: devin enforces workspace trust on the TUI path (the
  # --respect-workspace-trust false argv covers --print only), so the resolved
  # spawn cwd must be in its store before pane run — fail closed otherwise.
  # Remote spawns re-enter this same function on the execution host, so the
  # store seeded is always the host devin actually runs on.
  if [[ "$PROFILE_KIND" == devin ]]; then
    devin_seed_workspace_trust "$CWD"
  fi

  # #951: unattended claude-kind spawns block on Claude Code's folder-trust
  # dialog for an unrecorded cwd — --dangerously-skip-permissions does not
  # bypass it. Record the accepted-trust flag in claude's own config ahead of
  # the pane; fail-open like the kimi seed. Remote spawns re-enter this same
  # function on the execution host, so the seeded config is the host claude
  # actually runs on.
  if [[ "$PROFILE_KIND" == claude ]]; then
    claude_seed_folder_trust "$CWD"
  fi

  # #637: persist what the pane would otherwise lose on a herdr reboot restore
  # (bare `claude --resume <id>`): the prompt-suggestion-off env, in the worker
  # worktree's .claude/settings.local.json. The permission mode is not
  # persisted — local-file bypassPermissions cannot take effect (settings-ref)
  # and would force Manual on every flagless launch in the worktree. Runs after
  # every gate and before tab create, so a malformed or tracked existing file
  # fails the spawn closed with no pane left behind. Same resident carve-out
  # as the pane env: --purpose director is left as is.
  if [[ "$PROFILE_KIND" == claude && "${PURPOSE:-}" != director ]]; then
    write_claude_local_settings "$CWD" ||
      die "claude worker local settings not written for $CWD; spawn aborted before any pane (nothing was clobbered)"
    ensure_settings_local_ignored "$CWD"
  fi

  TAB_ENV=()
  if [[ "${#LANE_ENV[@]}" -gt 0 ]]; then TAB_ENV+=("${LANE_ENV[@]}"); fi
  if [[ "${#PROFILE_ENV[@]}" -gt 0 ]]; then TAB_ENV+=("${PROFILE_ENV[@]}"); fi
  if [[ "$ARBITER_HELD" -eq 1 ]]; then
    # The worker needs its own record identity to release or prove it later.
    TAB_ENV+=(--env "ARBITER_JOB=$JOB_ID" --env "ARBITER_RESOURCE=$ARBITER_RESOURCE"
              --env "ARBITER_KIND=quota_pool" --env "ARBITER_PROFILE=$ARBITER_PROFILE"
              --env "ARBITER_STARTED_AT=$ARBITER_STARTED_AT")
  fi
  # #768: the pane carries its task identity so a tester/advisory spawn made
  # from inside it inherits the task via HK_TASK_ID even without --parent-job.
  TAB_ENV+=(--env "HK_TASK_ID=$TASK_ID")
  # Final kind/cwd/host and generated TAB_ENV are authoritative here. No pane
  # exists and no brief has been injected if catalog/config verification fails.
  mock_mcp_prepare || return "$WRK_EXIT_MOCK_MCP_REFUSED"
  if [[ "${#TAB_ENV[@]}" -gt 0 ]]; then
    TAB_CREATE_JSON=$("$HERDR" tab create --workspace "$WS" --cwd "$CWD" --label "$LABEL" --no-focus "${TAB_ENV[@]}")
  else
    TAB_CREATE_JSON=$("$HERDR" tab create --workspace "$WS" --cwd "$CWD" --label "$LABEL" --no-focus)
  fi
  PANE=$(printf '%s' "$TAB_CREATE_JSON" |
    python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["root_pane"]["pane_id"])')
  # tab_id is what `wrk reap` later closes. It is recorded as evidence, never as
  # a requirement: an older herdr that omits it leaves reap to resolve the tab
  # from `agent get` instead.
  TAB_ID=$(printf '%s' "$TAB_CREATE_JSON" | python3 -c '
import json, sys
try:
    result = json.load(sys.stdin).get("result", {})
except (ValueError, AttributeError):
    raise SystemExit(0)
pane = result.get("root_pane") if isinstance(result.get("root_pane"), dict) else {}
tab = result.get("tab") if isinstance(result.get("tab"), dict) else {}
value = result.get("tab_id") or tab.get("tab_id") or pane.get("tab_id") or ""
print(value if isinstance(value, str) else "")
' 2>/dev/null || true)
  SPAWN_PANE_OPEN=1   # ROB-1214: disarmed only at the success line
  sleep_for 5
  START_TIMEOUT=30000; BOOT_SETTLE=12
  [[ "$PROFILE_KIND" == kiro ]] && START_TIMEOUT=120000 && BOOT_SETTLE=25
  [[ "$PROFILE_KIND" == kimi ]] && START_TIMEOUT=90000 && BOOT_SETTLE=20
  [[ "$PROFILE_KIND" == codex ]] && START_TIMEOUT=120000 && BOOT_SETTLE=20

  mock_mcp_verify || return "$WRK_EXIT_MOCK_MCP_REFUSED"

  if [[ "$PROFILE_KIND" == devin ]]; then
    devin_start_in_pane
  else
    agent_start_in_pane
  fi
  sleep_for "$BOOT_SETTLE"
  # #609: no prompt reaches the pane until the agent itself is observed in the
  # foreground — an accepted start whose binary never ran (command not found)
  # must close the pane, not receive a brief at the shell.
  if ! agent_wait_foreground; then
    spawn_pane_cleanup
    return 1
  fi
  if [[ "$PROFILE_KIND" == kimi ]]; then
    VISIBLE_SCREEN=""
    VISIBLE_SCREEN="$($HERDR agent read "$PANE" --lines 40 --source visible 2>/dev/null || true)"
    if grep -Fq "Trust this folder?" <<<"$VISIBLE_SCREEN"; then
      warn "KIMI TRUST WARNING: workspace trust seeding may have been neutralized — format change suspected; 'Trust this folder?' remains visible. Spawn continues."
    fi
  fi
  if [[ "$PROFILE_KIND" == kiro ]]; then
    "$HERDR" agent prompt "$PANE" "/effort $EFFECTIVE_EFFORT" >/dev/null 2>&1
    sleep_for 2
  fi
  # #498: injection happens only here — after every gate above, tab create and
  # agent start (or Devin's temporary run/wait/rename branch). Nothing about it
  # may move ahead of quota_gate/arbiter_admit.
  mock_mcp_verify --require-attached || return "$WRK_EXIT_MOCK_MCP_REFUSED"
  spawn_deliver_brief
  STATUS="unknown"
  if STATUS="$(agent_status_for_pane "$PANE")"; then :; else STATUS=unknown; fi
  # An older herdr may not report the tab in `tab create`; the agent knows it.
  if [[ -z "$TAB_ID" ]]; then
    IFS=$'\t' read -r _ _ TAB_ID <<<"$(herdr_agent_probe "$PANE")" || TAB_ID=""
  fi
  # #768: the hk task claim+link — the single hk write of the spawn, placed on
  # the success side only (pane landed, prompt delivered) so a failed spawn
  # never touches hk. A refusal here dies before the success receipt and while
  # SPAWN_PANE_OPEN is still armed: the EXIT trap closes the pane and releases
  # the quota record — no job without its task link.
  hk_task_link
  # #965: with the pane provably up and the spawn committed to its OK line,
  # register the worker's hub lane on the daemon serving this herdr session —
  # before the spawn receipt so hub_lane/hub_lane_machine land in the same job
  # meta as task_id/keep. Warn-only inside: never fails the spawn.
  hub_lane_register
  # The spawn stands; the execution record now belongs to the worker, not to this process.
  arbiter_record_spawn_receipt
  # A sentinel requires the durable claim/spawn metadata it later reads. During
  # an installation transition the old fail-open spawn contract remains intact.
  if [[ "$ARBITER_JOB_REGISTERED" -eq 1 ]]; then
    start_completion_sentinel "$(wrk_jobs_root)/$JOB_ID/completion-sentinel.pid" "$JOB_ID" "$JOB_LANE" "$LABEL" "$PANE" "$REPORT_PATH" "$ARBITER_RESOURCE"
  fi
  SPAWN_PANE_OPEN=0
  SPAWN_MOCK_MCP_RETAIN=1
  refresh_quota_pool
  # #770: optional periodic prune, off by default until director-1 enables it
  # (WRK_PRUNE_ON_SPAWN=1). Detached so the spawn path never waits on it; it
  # runs the same `wrk prune --apply` an operator would.
  if [[ "${WRK_PRUNE_ON_SPAWN:-0}" == 1 ]]; then
    ( nohup "$0" prune --apply >>"$(wrk_jobs_root)/prune.log" 2>&1 & ) || true
  fi
  ARBITER_HELD=0
  if [[ -n "$ARBITER_RESOURCE" ]]; then
    OK_LINE="OK pane=$PANE model=$MODEL label=$LABEL status=$STATUS landed=$LANDING job=$JOB_ID quota_record=$ARBITER_RESOURCE/quota_pool"
  else
    OK_LINE="OK pane=$PANE model=$MODEL label=$LABEL status=$STATUS landed=$LANDING"
  fi
  # Appended, never inserted: OK-line parsers read key=value pairs.
  [[ "$SPAWN_VIA" != herdr-fallback ]] || OK_LINE="$OK_LINE via=herdr-fallback"
  [[ -z "${HUB_LANE:-}" ]] || OK_LINE="$OK_LINE lane=$HUB_LANE@$HUB_LANE_MACHINE"
  echo "$OK_LINE"
  if [[ "$LANDING" == no ]]; then
    # Grok's echo can arrive 1-2 minutes after injection — past even its
    # extended window — so an unproven landing is not proof of non-delivery.
    [[ "$PROFILE_KIND" == grok ]] &&
      LANDING_NO_DETAIL="$LANDING_NO_DETAIL hint=\"re-check the pane after 2 minutes\""
    if [[ "$LANDING_STRICT" -eq 1 ]]; then
      warn "spawn succeeded but brief landed=no; pane=$PANE remains valid; $LANDING_NO_DETAIL strict_exit=$WRK_EXIT_LANDING_UNCONFIRMED"
      return "$WRK_EXIT_LANDING_UNCONFIRMED"
    fi
    warn "spawn succeeded but brief landed=no; pane=$PANE remains valid; $LANDING_NO_DETAIL"
  fi
}

reap_help() {
  cat <<'USAGE'
Usage: wrk reap [--lane LANE] [--grace DURATION] [--apply] [--include-builders|--include-captains]

Close the herdr tabs of jobs that already reported a terminal event, so that
finished worker/tester panes stop accumulating on the herdr server.

A job is a candidate only when all of these hold:
  · it has a terminal event (job.completed, job.joined or job.revoked)
  · no job.claim, job.reclaim, job.spawned or job.reprompted follows that
    terminal event (a job picked up again after it finished is live work;
    skip reason=reclaimed-after-terminal)
  · that terminal event is older than --grace (default 10m)
  · the pane of its newest job.spawned receipt still exists in herdr and its
    status is idle or done (pane and tab come from that one receipt as a unit;
    a malformed newest receipt is skipped, never patched from older ones)
  · the tab herdr reports for that pane is the recorded tab
    (skip reason=tab-mismatch otherwise)
  · herdr tab list, read again right before the close, confirms its tab holds
    exactly one pane. A failed or unparsable tab list, a tab missing from it,
    or a pane_count that is not an integer is treated as possibly shared
    (skip reason=tab-count-unknown)
  · it has not been reaped before (no job.reaped event)
  · it is not protected: no claim, reclaim or job.spawned receipt carries
    "keep": true (`wrk spawn --keep`; skip reason=protected)

working/blocked panes, jobs without a terminal event and jobs whose pane herdr
cannot resolve are never touched. Builder panes (claim role=builder, or legacy
role=captain) are excluded unless --include-builders is given.

Options:
  --lane LANE        only jobs whose claim owner_lane is LANE
  --grace DURATION   minimum age of the terminal event (10m, 600s, 2h, 600)
  --apply            actually close the tabs; without it reap only lists them.
                     Requires --lane: a lane-less --apply is refused (nonzero,
                     nothing closed). Reap one lane at a time.
  --include-builders also reap builder panes (canonical)
  --include-captains legacy alias for --include-builders
  -h, --help         show this usage

The default is a dry run: nothing is closed and no event is written. Each
closed job records a flat job.reaped event (pane_id, tab_id, at).

A job whose newest job.spawned receipt records a hub lane (hub_lane; spawned
under a session mapped in hosts.toml's [hub] session_machine_ids, #965) is
additionally deregistered on --apply: `panewire lanes rm LANE` with the [hub]
lane credentials (lanes_token_env when set, else hub_token_env) runs once
the tab close is confirmed — and only while `panewire lanes ls` still shows
the row bound to the recorded machine+pane (a reused label's newer row is
never removed). A removal failure warns and the close still stands;
`panewire lanes-audit` lists any leftover rows.
USAGE
}

# 10m / 600s / 2h / 600 → 초. 알 수 없는 형식은 실패한다(조용히 0 으로 떨어지면
# grace 없는 회수가 되어버린다).
parse_duration_s() {
  local value="$1"
  python3 - "$value" <<'PY'
import re, sys
text = sys.argv[1].strip()
match = re.fullmatch(r"(\d+)([smhd]?)", text)
if not match:
    raise SystemExit(1)
scale = {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[match.group(2)]
print(int(match.group(1)) * scale)
PY
}

# 회수 후보를 "job<TAB>owner<TAB>pane<TAB>tab<TAB>age_s<TAB>skip_reason" 로 출력한다
# (skip_reason 이 "-" 가 아니면 그 잡은 후보가 아니고 이유만 알린다). herdr 는
# 여기서 묻지 않는다 — 인박스만 읽는 순수 판정이다.
#
# 🔴 빈 필드는 자리표시자 "-" 로 낸다. 탭은 IFS 공백류라서 `IFS=$'\t' read` 가 연속
# 구분자를 하나로 접고, 그러면 뒤 필드가 앞으로 당겨진다. tab_id 없는 잡(이 PR 이전
# 스폰 전량)에서 age(초)가 tab_id 자리에 들어가 `herdr tab close <초>` 가 될 뻔했다
# (2026-09-05 검증 실증: `would-close … tab=1928`).
reap_candidates() {
  local root="$1" lane="$2" grace="$3" include_builders="$4"
  python3 - "$root" "$lane" "$grace" "$include_builders" <<'PY'
import datetime, json, os, sys, time

root, lane, grace, include_builders = sys.argv[1:5]
grace = int(grace)
include_builders = include_builders == "1"
TERMINAL = {"job.completed", "job.joined", "job.revoked"}
# 종료 뒤에 이 중 하나가 오면 그 잡은 다시 살아난 것이다(완료 → 재클레임 → 작업 중
# 잠깐 idle). 상태 검사(idle|done)는 긴 턴 중 오표시가 실측돼 있어 마지막 방어선이
# 못 된다 — 판정은 인박스 순서로 한다. job.lost·quota_pool.* 는 되살림이 아니다
# (넣으면 completed → lost 인 정상 종결 잡이 영구히 빠진다). job.reprompted 는 아직
# 없는 종류지만(#113 ①) 생기면 같은 뜻이다.
REVIVE = {"job.claim", "job.reclaim", "job.spawned", "job.reprompted"}
now = time.time()


def moment_of(value, fallback):
    if not isinstance(value, str) or not value.strip():
        return fallback
    text = value.strip().replace("Z", "+00:00")
    try:
        parsed = datetime.datetime.fromisoformat(text)
    except ValueError:
        return fallback
    if parsed.tzinfo is None:
        parsed = parsed.astimezone()
    return parsed.timestamp()


try:
    jobs = sorted(os.listdir(root))
except OSError:
    raise SystemExit(0)

for job in jobs:
    events_dir = os.path.join(root, job, "events")
    if not os.path.isdir(events_dir):
        continue
    owner = pane = tab = role = ""
    spawned_pane = spawned_tab = spawned_hub_lane = spawned_hub_lane_machine = ""
    saw_spawn = False
    terminal_at = None
    revived = False
    reaped = False
    keep = False
    try:
        names = sorted(os.listdir(events_dir))
    except OSError:
        continue
    for name in names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(events_dir, name)
        try:
            with open(path, encoding="utf-8") as handle:
                document = json.load(handle)
        except (OSError, ValueError):
            continue
        if not isinstance(document, dict):
            continue
        payload = document.get("payload", document)
        if not isinstance(payload, dict):
            payload = {}
        kind = document.get("kind")
        if kind in ("job.claim", "job.reclaim"):
            # 소유는 최신 claim 이 정한다(released 된 잡을 다른 레인이 다시 잡는다).
            owner = payload.get("owner_lane") if isinstance(payload.get("owner_lane"), str) else ""
            # 역할은 누적이다: `--role` 없는 reclaim 은 기본값 worker 를 payload 에
            # 남기므로, 덮어쓰면 재클레임 한 번에 빌더 표식이 지워진다. 디스크에
            # 남은 legacy captain claim도 동일한 builder 급 pane으로 보호한다.
            if payload.get("role") in ("builder", "captain"):
                role = "builder"
        for key in ("pane_id", "tab_id"):
            value = payload.get(key)
            if isinstance(value, str) and value:
                if key == "pane_id":
                    pane = value
                else:
                    tab = value
        if kind == "job.spawned":
            # 가장 늦은 스폰 영수증이 pane·tab 을 **한 벌로** 정한다. 필드별로 마지막
            # 값을 남기면 재스폰 영수증(tab_id 없음)의 pane 과 이전 스폰의 tab 이 섞여
            # 엉뚱한 탭을 닫는다(#508 tester 실증: pane=w1:p9 인데 tab close w1:t1).
            saw_spawn = True
            spawned_pane = payload.get("pane_id") if isinstance(payload.get("pane_id"), str) else ""
            spawned_tab = payload.get("tab_id") if isinstance(payload.get("tab_id"), str) else ""
            # #965: the hub lane travels in the same one receipt as pane/tab —
            # a lane an older spawn registered is not this pane's to remove.
            # #994: its machine too — `lanes rm` fires only while the daemon's
            # row still matches the recorded machine+pane pair.
            spawned_hub_lane = payload.get("hub_lane") if isinstance(payload.get("hub_lane"), str) else ""
            spawned_hub_lane_machine = payload.get("hub_lane_machine") if isinstance(payload.get("hub_lane_machine"), str) else ""
        if kind == "job.reaped":
            reaped = True
        # 보호 표시(`wrk spawn --keep`, #603)는 누적이다: claim·reclaim·spawn 영수증 중
        # 하나라도 JSON true 를 남겼으면 그 잡의 pane 은 닫지 않는다.
        if kind in ("job.claim", "job.reclaim", "job.spawned") and payload.get("keep") is True:
            keep = True
        if kind in REVIVE and terminal_at is not None:
            terminal_at = None
            revived = True
        if kind in TERMINAL:
            revived = False
            try:
                fallback = os.path.getmtime(path)
            except OSError:
                fallback = now
            terminal_at = moment_of(document.get("created_at") or payload.get("at"), fallback)
    # 스폰 영수증이 pane/tab 의 정본이다. 완료 이벤트의 pane_id 를 그대로 믿으면
    # be4dad1 이전 `wrk done` 이 남긴 오염 레코드("w1:p1\t\tworker")를 집는다 —
    # 실 인박스에 23건 남아 있다.
    # 영수증이 하나라도 있으면 가장 늦은 영수증만 믿는다 — 그 영수증이 깨졌으면 앞선
    # 영수증이나 완료 이벤트의 값으로 되돌아가지 않고 malformed 로 건너뛴다.
    malformed_receipt = False
    if saw_spawn:
        pane, tab = spawned_pane, spawned_tab
        malformed_receipt = not pane
    if reaped or (not pane and not malformed_receipt):
        continue
    if lane and owner != lane:
        continue
    if role == "builder" and not include_builders:
        continue
    if terminal_at is None:
        # 종료 뒤에 되살아난 잡은 이유를 남기고 건너뛴다. 종료가 아예 없던 잡은
        # 지금처럼 출력하지 않는다.
        if revived and not any(c.isspace() for c in job):
            print(job, "-", "-", "-", "-", "reclaimed-after-terminal", sep="\t")
        continue
    age = int(now - terminal_at)
    if age < grace:
        continue
    # 보호된 잡은 유예를 넘겨 원래라면 닫혔을 때만 이유를 남기고 건너뛴다. 유예 안이거나
    # 종료 전인 잡은 위에서 지금처럼 조용히 빠진다.
    if keep:
        print(job.split()[0] if job.split() else job, "-", "-", "-", age, "protected", sep="\t")
        continue
    # 어떤 필드에도 공백이 있어서는 안 된다. 있으면 그 잡의 증거가 깨진 것이고,
    # 회수는 추측하지 않는다 — pane 을 자리표시자로 내보내 skip 으로 남긴다.
    if malformed_receipt or any(any(c.isspace() for c in value) for value in (job, owner, pane, tab)):
        print(job.split()[0] if job.split() else job, "-", "-", "-", age, "-", sep="\t")
        continue
    # #965: a lane id carrying whitespace is corrupt evidence — never an rm
    # target. The pane itself still closes; the row is left for lanes-audit.
    # Same for its recorded machine (#994): a blanked machine can never match
    # a live row, so the removal is skipped rather than aimed.
    if any(c.isspace() for c in spawned_hub_lane):
        spawned_hub_lane = ""
    if any(c.isspace() for c in spawned_hub_lane_machine):
        spawned_hub_lane_machine = ""
    print(job, owner or "-", pane, tab or "-", age, "-", spawned_hub_lane or "-", spawned_hub_lane_machine or "-", sep="\t")
PY
}

# "tab_id<TAB>pane_count" 목록. 회수는 잡의 탭만 닫아야 하고, pane 이 분할된 탭을
# 닫으면 옆 pane 이 함께 죽는다(2026-07-20 실사고: 수동 스폰한 캡틴 pane 동반 사망).
#
# 🔴 fail-closed 다. 조회 실패·JSON 파손이면 아무 줄도 내지 않고(→ 모든 탭이
# "모름"), pane_count 가 정수가 아니면(부재·문자열·bool) "?" 를 낸다. 예전에는 둘 다
# "공유 아님" 으로 통과해 조회가 실패하는 날 조용히 닫았다. 판정은 reap_tab_verdict.
reap_tab_pane_counts() {
  local out
  out="$("$HERDR" tab list 2>/dev/null)" || return 0
  python3 -c '
import json, sys
try:
    tabs = json.loads(sys.argv[1])["result"]["tabs"]
except (ValueError, KeyError, TypeError):
    raise SystemExit(0)
if not isinstance(tabs, list):
    raise SystemExit(0)
for tab in tabs:
    if isinstance(tab, dict) and isinstance(tab.get("tab_id"), str):
        count = tab.get("pane_count")
        ok = isinstance(count, int) and not isinstance(count, bool)
        print(tab["tab_id"], count if ok else "?", sep="\t")
' "$out" 2>/dev/null || true
}

# 탭 하나의 판정: single(정확히 pane 1개로 확인됨) / shared:N / unknown.
# 닫아도 되는 것은 single 뿐이다 — 목록에 없거나, 같은 tab_id 가 두 번 나오거나,
# 값이 1 이상의 정수가 아니면 unknown 이다.
reap_tab_verdict() {
  local tab="$1" counts="$2" rows
  rows="$(awk -v want="$tab" -F'\t' '$1==want{print $2}' <<<"$counts")"
  if [[ -z "$rows" || "$rows" == *$'\n'* || ! "$rows" =~ ^[0-9]+$ ]]; then
    echo unknown
  elif [[ "$rows" == 1 ]]; then
    echo single
  elif (( 10#$rows > 1 )); then
    echo "shared:$((10#$rows))"
  else
    echo unknown
  fi
}

reap_event() {
  local job="$1" owner="$2" pane="$3" tab="$4"
  local events
  events="$(wrk_jobs_root)/$job/events"
  mkdir -p "$events"
  python3 - "$events" "$job" "$owner" "$pane" "$tab" "${HOSTNAME:-unknown}" <<'PY'
import datetime, json, os, sys, tempfile
events, job, owner, pane, tab, host = sys.argv[1:]
highest = 0
for name in os.listdir(events):
    try: highest = max(highest, int(name.split('-', 1)[0]))
    except (ValueError, IndexError): pass
record = {"kind": "job.reaped", "job_id": job, "owner_lane": owner,
          "pane_id": pane, "tab_id": tab, "host": host,
          "at": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
          "epoch": 1}
fd, temporary = tempfile.mkstemp(prefix='.reaped-', dir=events)
try:
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        json.dump(record, f, separators=(',', ':'))
        f.write('\n')
    os.chmod(temporary, 0o600)
    os.replace(temporary, os.path.join(events, f'{highest + 1:05d}-job.reaped.json'))
finally:
    if os.path.exists(temporary): os.unlink(temporary)
PY
}

reap_cmd() {
  local lane="" grace="10m" apply=0 include_builders=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) reap_help; return 0 ;;
      --lane) [[ $# -ge 2 && -n "$2" ]] || die "--lane requires a value"; lane="$2"; shift 2 ;;
      --grace) [[ $# -ge 2 && -n "$2" ]] || die "--grace requires a value"; grace="$2"; shift 2 ;;
      --apply) apply=1; shift ;;
      --include-builders|--include-captains) include_builders=1; shift ;;
      -*) die "unknown reap option '$1'" ;;
      *) die "unexpected argument '$1'" ;;
    esac
  done
  # 전역 --apply 는 거부한다(#113 ④). 인박스·herdr 를 보기 전에, 즉 아무것도 닫기
  # 전에 끝낸다 — 루프 안에서 검사하면 부분 회수가 난다.
  if [[ "$apply" -eq 1 && -z "$lane" ]]; then
    die "reap --apply requires --lane LANE (a lane-less --apply would close every lane's tabs); run it once per lane"
  fi
  local grace_s jobs_root candidates
  grace_s="$(parse_duration_s "$grace")" || die "invalid --grace '$grace' (use 600, 600s, 10m, 2h or 1d)"
  jobs_root="$(wrk_jobs_root)"
  if [[ ! -d "$jobs_root" ]]; then
    echo "reap: no job inbox at $jobs_root"
    return 0
  fi
  [[ -x "$HERDR" ]] || die "herdr unavailable: $HERDR"
  candidates="$(reap_candidates "$jobs_root" "$lane" "$grace_s" "$include_builders")"
  local tab_counts
  local job owner pane tab age note hub_lane hub_lane_machine probe class token probe_tab verdict acted=0
  while IFS=$'\t' read -r job owner pane tab age note hub_lane hub_lane_machine; do
    [[ -n "$job" ]] || continue
    if [[ -n "$note" && "$note" != - ]]; then
      echo "skip job=$job reason=$note"
      continue
    fi
    # 자리표시자를 되돌린다(위 reap_candidates 주석 참고).
    [[ "$owner" != - ]] || owner=""
    [[ "$tab" != - ]] || tab=""
    [[ "$hub_lane" != - ]] || hub_lane=""
    [[ "$hub_lane_machine" != - ]] || hub_lane_machine=""
    if [[ "$pane" == - ]]; then
      echo "skip job=$job reason=malformed-record"
      continue
    fi
    probe="$(herdr_agent_probe "$pane")"
    IFS=$'\t' read -r class token probe_tab <<<"$probe"
    if [[ "$class" != ok ]]; then
      # An unresolvable pane is not a reapable pane: it may be a paused socket
      # rather than a closed tab, and closing a tab id nobody confirmed is worse
      # than leaving it. `wrk reap` never guesses.
      echo "skip job=$job pane=$pane reason=pane-unresolved($token)"
      continue
    fi
    case "$token" in
      idle|done) ;;
      *) echo "skip job=$job pane=$pane reason=status=$token"; continue ;;
    esac
    [[ -n "$tab" ]] || tab="$probe_tab"
    if [[ -z "$tab" ]]; then
      echo "skip job=$job pane=$pane reason=tab-unresolved"
      continue
    fi
    # 기록된 탭과 herdr 가 지금 말하는 pane 의 탭이 다르면(pane 이동·tab id 재사용)
    # 기록된 탭은 이 pane 의 탭이 아니다. 어느 쪽도 닫지 않는다.
    if [[ -n "$probe_tab" && "$probe_tab" != "$tab" ]]; then
      echo "skip job=$job pane=$pane tab=$tab reason=tab-mismatch(pane-in=$probe_tab)"
      continue
    fi
    # 탭 목록은 후보마다, pane 상태를 본 **뒤** close 직전에 새로 읽는다. 루프 앞에서
    # 한 번 찍은 스냅숏은 그 사이 합류한 pane 을 못 본다(#508 tester 실증: snapshot=1
    # → 합류 → tab close). herdr 에 조건부 close 가 없어 창을 0 으로 만들지는 못한다.
    tab_counts="$(reap_tab_pane_counts)"
    verdict="$(reap_tab_verdict "$tab" "$tab_counts")"
    case "$verdict" in
      single) ;;
      shared:*)
        echo "skip job=$job pane=$pane tab=$tab reason=tab-shared(panes=${verdict#shared:})"
        continue ;;
      *)
        echo "skip job=$job pane=$pane tab=$tab reason=tab-count-unknown"
        continue ;;
    esac
    if [[ "$apply" -eq 1 ]]; then
      if "$HERDR" tab close "$tab" >/dev/null 2>&1; then
        reap_event "$job" "$owner" "$pane" "$tab"
        # #770: a reaped job is ended — declare it to the hub (job.reaped is a
        # work terminal but not one the hub ends on), release quota, and stop
        # + wait on the completion sentinel before moving on.
        job_end_housekeeping "$job" "$owner" abandoned "pane reaped" "wrk reap"
        # #965: the lane this pane's spawn registered goes with it — only the
        # recorded lane, only on a confirmed close, and (#994) only while the
        # daemon still shows that row bound to the recorded machine+pane.
        # Failure warns; the pane stays closed and lanes-audit lists what is
        # left behind.
        [[ -z "$hub_lane" ]] || hub_lane_remove "$hub_lane" "$hub_lane_machine" "$pane"
        echo "closed job=$job pane=$pane tab=$tab status=$token age=${age}s"
        acted=$(( acted + 1 ))
      else
        echo "skip job=$job pane=$pane tab=$tab reason=tab-close-failed"
      fi
    else
      echo "would-close job=$job pane=$pane tab=$tab status=$token age=${age}s"
      acted=$(( acted + 1 ))
    fi
  done <<<"$candidates"
  if [[ "$apply" -eq 1 ]]; then
    echo "reap: closed $acted tab(s)"
  else
    echo "reap: $acted candidate(s) (dry-run; re-run with --apply to close)"
  fi
}

# ── #770: wrk prune — report-only-by-default cleanup of what ended jobs
# leave behind: orphan completion sentinels, stale jobs and detached
# quota-refresh supervisors.
#
# The hard rule mirrors wrk reap: nothing is stopped on ambiguous evidence.
# A pid is only ever signalled when its argv is verified to be this job's
# `wrk sentinel JOB …` (pid reuse guard), and a live sentinel is only ever
# stopped when the job's own records prove it ended or its pane is provably
# gone — never on "looks old".

# proc_elapsed_s PID — process age in seconds from ps etime (macOS has no
# etimes); empty output or an unparseable field fails the call.
proc_elapsed_s() {
  local pid="$1" etime
  etime="$(ps -p "$pid" -o etime= 2>/dev/null | tr -d ' ')" || return 1
  [[ -n "$etime" ]] || return 1
  python3 - "$etime" <<'PY'
import re, sys
match = re.fullmatch(r"(?:(\d+)-)?(?:(\d+):)?(\d+):(\d+)", sys.argv[1])
if not match:
    raise SystemExit(1)
days, hours, minutes, seconds = (int(g) if g else 0 for g in match.groups())
print(days * 86400 + hours * 3600 + minutes * 60 + seconds)
PY
}

# refresh_supervisor_argv_matches PID PIDFILE — the refresh supervisor's real
# argv is `python3 - <scopefuel> <pool> <timeout> THIS-PIDFILE <job>`: the
# pidfile path it babysits sits at argv[5]. A bare `python` substring match is
# not identity — a plain `python3 -c 'sleep forever'` never carries this job's
# pidfile path there, and that is the difference between pruning a leftover
# and killing an unrelated process whose pid was recycled.
refresh_supervisor_argv_matches() {
  local pid="$1" pidfile="$2" args
  args="$(ps -p "$pid" -o args= 2>/dev/null)" || return 1
  [[ -n "$args" ]] || return 1
  python3 - "$args" "$pidfile" <<'PY'
import shlex, sys
args, pidfile = sys.argv[1], sys.argv[2]
try:
    toks = shlex.split(args)
except ValueError:
    toks = args.split()
ok = (len(toks) >= 6 and "python" in toks[0].rsplit("/", 1)[-1].lower()
      and toks[1] == "-" and toks[5] == pidfile)
sys.exit(0 if ok else 1)
PY
}

prune_help() {
  cat <<'USAGE'
Usage: wrk prune [--apply] [--stale-age AGE] [--job JOB] [--lane LANE]

Report — and with --apply, remove — what ended or stale jobs leave behind:
  * orphan completion sentinels (pidfile or a live `wrk sentinel JOB`
    process whose job ended, or whose pane is provably gone)
  * stale jobs (events silent past --stale-age AND pane absent; records are
    never deleted — --apply appends a job.revoked end declaration so the
    hub stops counting them)
  * quota-refresh supervisor leftovers (quota-refresh.pid pointing at a
    dead/reused pid, or a live supervisor past its recorded deadline or
    whose job already ended)

Dry-run is the default and prints one line per item with job id, pid, age,
pane state and the exact reason it is or is not an orphan. --apply stops
only verified orphans: a sentinel whose job is still active (pane alive, or
job not ended, or pane state unverifiable) is never stopped, and a stale
pidfile pointing at an unrelated process only loses the file, never the
process.

Options:
  --apply          actually stop orphans / mark stale jobs / reap leftovers
  --stale-age AGE  stale threshold, e.g. 86400, 12h, 1d (default 24h)
  --job JOB        restrict every pass to one job id
  --lane LANE      restrict every pass to jobs owned by LANE
  -h, --help       show this usage

Periodic hook: WRK_PRUNE_ON_SPAWN=1 runs this same --apply pass detached at
the end of every `wrk spawn`. Off by default; enable only after director-1
approves. Output appends to <jobs-root>/prune.log.
USAGE
}

# prune_sentinel_row JOB PID PIDFILE ARGV_PANE ARGV_OWNER STARTED — classify
# one completion sentinel (pidfile-sourced or process-sweep-sourced) and print
# exactly one verdict line. STARTED is the pidfile's recorded spawn time;
# sweep rows pass "" (argv alone proves those). Uses PRUNE_APPLY, PRUNE_LANE
# and the precomputed PRUNE_SCAN table; bumps PRUNE_ORPHANS on verified
# orphans.
prune_sentinel_row() {
  local job="$1" pid="$2" pidfile="$3" argv_pane="${4:-}" argv_owner="${5:-}" started="${6:-}"
  local row ended="" terminal="" owner="" j_pane=""
  [[ -z "$PRUNE_LANE" ]] || {
    owner="$(awk -v j="$job" -F'\t' '$1==j {print $8; exit}' <<<"$PRUNE_SCAN")"
    [[ "${owner:--}" == "$PRUNE_LANE" || "$argv_owner" == "$PRUNE_LANE" ]] || return 0
  }
  row="$(awk -v j="$job" -F'\t' '$1==j {print; exit}' <<<"$PRUNE_SCAN")"
  if [[ -n "$row" ]]; then
    IFS=$'\t' read -r _ ended _ terminal _ _ _ owner _ j_pane _ <<<"$row"
  fi
  local live=0 pidkind="absent" age="-"
  if [[ "$pid" =~ ^[0-9]+$ ]]; then
    if sentinel_pid_matches "$pid" "$job" && sentinel_start_matches "$pid" "$started"; then
      live=1; pidkind="live"; age="$(proc_elapsed_s "$pid" 2>/dev/null || echo '?')"
    elif kill -0 "$pid" 2>/dev/null; then
      pidkind="reused"
      # argv proved this pid is our sentinel but the recorded start disagrees
      # with its real age — the pidfile was stale, not the process.
      if sentinel_pid_matches "$pid" "$job"; then
        pidkind="start-mismatch"
      fi
    else
      pidkind="dead"
    fi
  else
    pidkind="invalid"
  fi
  if [[ "$live" -eq 0 ]]; then
    # No live sentinel — only a pidfile can be stale here.
    [[ "$pidfile" != - ]] || return 0
    echo "sentinel job=$job pid=${pid:-?} pidfile=$pidfile stale=yes reason=pid-$pidkind"
    if [[ "$PRUNE_APPLY" -eq 1 ]]; then
      rm -f "$pidfile" && echo "  action=removed-pidfile"
    fi
    return 0
  fi
  if [[ ! -d "$PRUNE_ROOT/$job" ]]; then
    # Outside the jobs root there is no event stream to prove anything with —
    # list it, never touch it.
    echo "sentinel job=$job pid=$pid age=${age}s state=protected reason=outside-jobs-root"
    return 0
  fi
  if [[ "$ended" == 1 ]]; then
    PRUNE_ORPHANS=$(( PRUNE_ORPHANS + 1 ))
    echo "sentinel job=$job pid=$pid age=${age}s orphan=yes reason=job-ended($terminal)"
    if [[ "$PRUNE_APPLY" -eq 1 ]]; then
      stop_completion_sentinel "$job" "$pid" && echo "  action=stopped"
    fi
    return 0
  fi
  local pane="${argv_pane:-$j_pane}" probe pclass ptoken
  if [[ -z "$pane" || "$pane" == - ]]; then
    echo "sentinel job=$job pid=$pid age=${age}s state=protected reason=no-pane-evidence"
    return 0
  fi
  probe="$(herdr_agent_probe "$pane")"
  IFS=$'\t' read -r pclass ptoken _ <<<"$probe"
  case "$pclass" in
    gone)
      PRUNE_ORPHANS=$(( PRUNE_ORPHANS + 1 ))
      echo "sentinel job=$job pid=$pid age=${age}s pane=$pane orphan=yes reason=pane-gone($ptoken)"
      if [[ "$PRUNE_APPLY" -eq 1 ]]; then
        job_end_record "$job" "$owner" abandoned "pane gone; sentinel orphaned" "wrk prune" >/dev/null || true
        stop_completion_sentinel "$job" "$pid" && echo "  action=stopped+ended"
      fi ;;
    ok)
      echo "sentinel job=$job pid=$pid age=${age}s pane=$pane state=protected reason=pane-alive($ptoken)" ;;
    *)
      echo "sentinel job=$job pid=$pid age=${age}s pane=$pane state=protected reason=pane-unverifiable($ptoken)" ;;
  esac
}

prune_cmd() {
  local apply=0 stale_age="${WRK_PRUNE_STALE_AGE:-24h}" lane="" only_job=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) prune_help; return 0 ;;
      --apply) apply=1; shift ;;
      --stale-age) [[ $# -ge 2 && -n "$2" ]] || die "--stale-age requires a value"; stale_age="$2"; shift 2 ;;
      --lane) [[ $# -ge 2 && -n "$2" ]] || die "--lane requires a value"; lane="$2"; shift 2 ;;
      --job) [[ $# -ge 2 && -n "$2" ]] || die "--job requires a value"; only_job="$2"; shift 2 ;;
      -*) die "unknown prune option '$1'" ;;
      *) die "unexpected argument '$1'" ;;
    esac
  done
  local stale_s jobs_root
  stale_s="$(parse_duration_s "$stale_age")" || die "invalid --stale-age '$stale_age' (use 86400, 24h or 1d)"
  jobs_root="$(wrk_jobs_root)"
  if [[ ! -d "$jobs_root" ]]; then
    echo "prune: no job inbox at $jobs_root"
    return 0
  fi
  [[ -x "$HERDR" ]] || die "herdr unavailable: $HERDR"
  PRUNE_APPLY="$apply" PRUNE_LANE="$lane" PRUNE_ROOT="$jobs_root" PRUNE_ORPHANS=0

  # One python pass over every job's event stream — ended/hub_ended, newest
  # terminal, silence age and the spawned pane — shared by all three passes.
  local scan_dirs=() _d
  for _d in "$jobs_root"/*/; do
    [[ -d "$_d" ]] || continue
    scan_dirs+=("${_d%/}/events")
  done
  PRUNE_SCAN=""
  (( ${#scan_dirs[@]} )) && PRUNE_SCAN="$(job_events_scan "${scan_dirs[@]}")"

  local _mode="dry-run" pf job pid jdir
  (( apply )) && _mode="apply"
  echo "prune ($_mode) root=$jobs_root stale_age=${stale_age}$( [[ -n "$lane" ]] && printf ' lane=%s' "$lane" )"

  # Pass 1 — pidfile-sourced sentinels.
  while IFS= read -r pf; do
    [[ -n "$pf" ]] || continue
    jdir="${pf%/completion-sentinel.pid}"; job="${jdir##*/}"
    [[ -z "$only_job" || "$job" == "$only_job" ]] || continue
    pid=""; started=""
    IFS=$'\t' read -r pid started <<<"$(sentinel_pidfile_fields "$pf")"
    prune_sentinel_row "$job" "$pid" "$pf" "" "" "$started"
  done < <(find "$jobs_root" -maxdepth 2 -name completion-sentinel.pid -type f 2>/dev/null | sort)

  # Pass 2 — process sweep: live `wrk sentinel JOB …` processes, including
  # ones that never had (or lost) a pidfile. A pidfile pass already covers
  # the pair when its pid matches; a different live pid for the same job is
  # a second sentinel and is judged on its own.
  local _pid _job _owner _label _pane _report _pfpid
  while IFS=$'\t' read -r _pid _job _owner _label _pane _report; do
    [[ -n "$_job" ]] || continue
    [[ -z "$only_job" || "$_job" == "$only_job" ]] || continue
    if [[ -f "$jobs_root/$_job/completion-sentinel.pid" ]]; then
      read -r _pfpid <"$jobs_root/$_job/completion-sentinel.pid" 2>/dev/null || _pfpid=""
      [[ "$_pfpid" == "$_pid" ]] && continue
    fi
    prune_sentinel_row "$_job" "$_pid" - "$_pane" "$_owner"
  done < <(sentinel_sweep)

  # Pass 3 — stale jobs: silent past --stale-age AND pane absent. Records are
  # kept; --apply only appends the hub-visible end declaration.
  local stale_n=0 _ended _hub _term _age _last _comp _label _tab _pstate
  while IFS=$'\t' read -r job _ended _hub _term _age _last _comp _owner _label _pane _tab; do
    [[ -n "$job" ]] || continue
    [[ -z "$only_job" || "$job" == "$only_job" ]] || continue
    [[ -z "$lane" || "$_owner" == "$lane" ]] || continue
    [[ "$_ended" == 0 && "$_age" =~ ^[0-9]+$ && "$_age" -ge "$stale_s" ]] || continue
    _pstate="no-pane-recorded"
    if [[ "$_pane" != - ]]; then
      local _probe _pclass _ptoken
      _probe="$(herdr_agent_probe "$_pane")"
      IFS=$'\t' read -r _pclass _ptoken _ <<<"$_probe"
      [[ "$_pclass" == gone ]] || continue
      _pstate="gone:$_ptoken"
    fi
    stale_n=$(( stale_n + 1 ))
    echo "job $job stale=yes last_event_age=${_age}s owner=$_owner pane=$_pane pane_state=$_pstate"
    if (( apply )); then
      job_end_record "$job" "$_owner" abandoned "stale: silent ${_age}s, pane absent" "wrk prune" >/dev/null &&
        echo "  action=end-declaration" || echo "  action=end-declaration-failed"
    fi
  done <<<"$PRUNE_SCAN"

  # Pass 4 — quota-refresh supervisors (quota-refresh.pid written by
  # refresh_quota_pool). A live pid is only a leftover when it verifies
  # (start time matches the record within the pid-reuse window) AND the job
  # ended or the recorded deadline passed.
  local left_n=0 _rpf _rjob _rpid="" _rdeadline=0 _rstarted=0 _rpool="" _rfields _kv _elapsed _row _rended
  while IFS= read -r _rpf; do
    [[ -n "$_rpf" ]] || continue
    jdir="${_rpf%/quota-refresh.pid}"; _rjob="${jdir##*/}"
    [[ -z "$only_job" || "$_rjob" == "$only_job" ]] || continue
    _rpid=""; _rdeadline=0; _rstarted=0; _rpool=""
    _rfields="$(cat "$_rpf" 2>/dev/null || true)"
    local -a _farr=()
    read -r -a _farr <<<"$_rfields"
    for _kv in "${_farr[@]}"; do
      case "$_kv" in
        pid=*) _rpid="${_kv#pid=}" ;;
        deadline=*) _rdeadline="${_kv#deadline=}" ;;
        started=*) _rstarted="${_kv#started=}" ;;
        pool=*) _rpool="${_kv#pool=}" ;;
      esac
    done
    if [[ ! "$_rpid" =~ ^[0-9]+$ ]] || ! kill -0 "$_rpid" 2>/dev/null; then
      left_n=$(( left_n + 1 ))
      echo "refresh job=$_rjob pid=${_rpid:-?} pool=${_rpool:--} leftover=yes reason=pid-stale"
      (( apply )) && { rm -f "$_rpf" && echo "  action=removed-pidfile"; }
      continue
    fi
    # Live pid: prove it is our supervisor — recorded start vs real elapsed
    # must agree AND the argv must be the supervisor command itself carrying
    # THIS pidfile path (a reused pid, or a bare `python3 -c …` that merely
    # greps as "python", points at an unrelated process and is never
    # signalled).
    _elapsed="$(proc_elapsed_s "$_rpid" 2>/dev/null || echo "")"
    if [[ -z "$_elapsed" || "$_rstarted" =~ [^0-9] || -z "$_rstarted" ]] ||
       (( ( $(date +%s) - _rstarted - _elapsed ) > 120 || ( $(date +%s) - _rstarted - _elapsed ) < -120 )) ||
       ! refresh_supervisor_argv_matches "$_rpid" "$_rpf"; then
      echo "refresh job=$_rjob pid=$_rpid pool=${_rpool:--} state=protected reason=pid-unverified"
      continue
    fi
    _row="$(awk -v j="$_rjob" -F'\t' '$1==j {print $2; exit}' <<<"$PRUNE_SCAN")"
    _rended="${_row:-0}"
    if [[ "$_rended" == 1 ]] || (( $(date +%s) > _rdeadline + 60 )); then
      left_n=$(( left_n + 1 ))
      echo "refresh job=$_rjob pid=$_rpid pool=${_rpool:--} leftover=yes reason=deadline-passed-or-job-ended"
      if (( apply )); then
        # Supervisor did setsid: its pgid equals its pid, and the group owns
        # the scopefuel refresh child too.
        kill -- "-$_rpid" 2>/dev/null || kill "$_rpid" 2>/dev/null || true
        rm -f "$_rpf"
        echo "  action=killed-group"
      fi
    else
      echo "refresh job=$_rjob pid=$_rpid pool=${_rpool:--} state=alive deadline=${_rdeadline}"
    fi
  done < <(find "$jobs_root" -maxdepth 2 -name quota-refresh.pid -type f 2>/dev/null | sort)

  echo "prune: orphans=$PRUNE_ORPHANS stale_jobs=$stale_n refresh_leftovers=$left_n ($_mode)"
}

find_cmd() {
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { find_help; return 0; }
  local target="" pane_only=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) find_help; return 0 ;;
      --pane-only) pane_only=1 ;;
      -*) die "unknown option '$1'" ;;
      *) [[ -z "$target" ]] || die "find accepts exactly one target"; target="$1" ;;
    esac
    shift
  done
  [[ -n "$target" ]] || die "find requires a name or label"
  [[ -x "$HERDR" ]] || die "herdr unavailable: $HERDR"
  local af tf rc
  af="$(mktemp)"; tf="$(mktemp)"
  "$HERDR" agent list >"$af"
  "$HERDR" tab list >"$tf"
  set +e
  python3 - "$target" "$pane_only" "$HERDR" "$af" "$tf" <<'PY'
import json, subprocess, sys
target, pane_only, herdr, af, tf = sys.argv[1:]
def load(path, key):
    with open(path, encoding="utf-8") as f:
        p = json.load(f)
    r = p.get("result", p)
    v = r.get(key) if isinstance(r, dict) else None
    if not isinstance(v, list):
        raise ValueError("invalid herdr JSON: " + key)
    return v
agents, tabs = load(af, "agents"), load(tf, "tabs")
labels = {t.get("tab_id"): t.get("label") for t in tabs}
def unique(items):
    out, seen = [], set()
    for item in items:
        pane = item.get("pane_id")
        if pane and pane not in seen:
            out.append(item); seen.add(pane)
    return out
matches = unique([a for a in agents if a.get("name") == target])
kind = "name"
if not matches:
    ids = {t.get("tab_id") for t in tabs if t.get("label") == target}
    matches = unique([a for a in agents if a.get("tab_id") in ids])
    kind = "label"
if not matches:
    print("wrk find: no exact name or label match: " + target, file=sys.stderr)
    raise SystemExit(1)
def desc(a):
    return ("pane_id=" + a.get("pane_id","?") + " name=" + (a.get("name") or "-") +
            " label=" + (labels.get(a.get("tab_id")) or "-") +
            " agent=" + a.get("agent","-") + " status=" + a.get("agent_status","-"))
if pane_only == "1":
    if len(matches) != 1:
        print("wrk find: ambiguous " + str(len(matches)) + " " + kind + " matches", file=sys.stderr)
        raise SystemExit(1)
    print(matches[0].get("pane_id",""))
    raise SystemExit(0)
print("match=" + kind + " target=" + repr(target) + " candidates=" + str(len(matches)))
read_failed = False
for a in matches:
    print(desc(a))
    p = subprocess.run([herdr, "pane", "read", a["pane_id"], "--source", "recent",
                        "--lines", "5", "--format", "text"], capture_output=True, text=True)
    lines = p.stdout.rstrip("\n").splitlines()[-5:] if p.returncode == 0 else ["(pane read failed)"]
    for line in lines or ["(no screen output)"]:
        print("  " + line)
    read_failed = read_failed or p.returncode != 0
if len(matches) != 1:
    print("wrk find: multiple panes matched; refusing automatic selection", file=sys.stderr)
    raise SystemExit(1)
raise SystemExit(1 if read_failed else 0)
PY
  rc=$?
  set -e
  rm -f "$af" "$tf"
  return "$rc"
}

name_sync_cmd() {
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { name_sync_help; return 0; }
  local mode=preview labels=() arg
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "$arg" in
      -h|--help) name_sync_help; return 0 ;;
      --apply) mode=apply ;;
      --*) die "unknown option '$arg'" ;;
      *) mode=apply; labels+=("$arg") ;;
    esac
    shift
  done
  HERDR_BIN="$HERDR" python3 - "$mode" "${labels[@]:-}" <<'PY'
import json, os, subprocess, sys
H = os.environ["HERDR_BIN"]
mode = sys.argv[1]
want = [x for x in sys.argv[2:] if x]
def run(*args):
    return json.loads(subprocess.run([H, *args], capture_output=True, text=True).stdout)["result"]
labels = {}
for ws in run("workspace", "list").get("workspaces", []):
    for t in run("tab", "list", "--workspace", ws["workspace_id"]).get("tabs", []):
        if t.get("label"): labels[t["tab_id"]] = t["label"]
agents = run("agent", "list")["agents"]
taken = {a["name"] for a in agents if a.get("name")}
by_tab = {}
for a in agents: by_tab.setdefault(a.get("tab_id"), []).append(a)
acted = skipped = 0
for tab, label in sorted(labels.items()):
    if want and label not in want: continue
    members = by_tab.get(tab, [])
    unnamed = [a for a in members if not a.get("name")]
    if not unnamed: continue
    if len(members) > 1:
        print(f"  △ SKIP  {tab} '{label}' — 탭에 agent {len(members)}개(모호). 수동: herdr agent rename <pane> <이름>")
        skipped += 1; continue
    a = unnamed[0]
    if label in taken:
        print(f"  △ SKIP  {tab} '{label}' — 이름 이미 사용 중(agent_name_taken)")
        skipped += 1; continue
    if not want and (label.isdigit() or len(label) < 3):
        print(f"  △ SKIP  {tab} '{label}' — 잡라벨 추정(숫자/3자 미만). 원하면 라벨 명시 지정으로")
        skipped += 1; continue
    if mode == "apply":
        r = subprocess.run([H, "agent", "rename", a["pane_id"], label], capture_output=True, text=True)
        ok = '"agent_info"' in r.stdout or "agent_info" in r.stdout
        print(f"  {'✓' if ok else '✗'} {a['pane_id']} ({a['agent']}) → name '{label}'")
        taken.add(label); acted += 1
    else:
        print(f"  · 후보  {a['pane_id']} ({a['agent']}, 이름 없음) → '{label}'")
        acted += 1
if mode == "preview":
    print(f"\n후보 {acted}건, 스킵 {skipped}건 — 적용: herdr-name-sync --apply (또는 라벨 지정)")
else:
    print(f"\n적용 {acted}건, 스킵 {skipped}건")
PY
}

heavy_help() {
  cat <<'USAGE'
Usage: wrk heavy -- <command> [args...]
       wrk heavy status

Serialize heavy (>1 minute) local test/build runs: up to `heavy_max` holders
per host (default 1) via fcntl.flock on per-host slot files (works the same
on macOS and Linux — macOS has no `flock` command, and flock releases a dead
holder's slot automatically, unlike shlock pid-files). Slot 0 is the lock
file itself; slots 1..N-1 are <lock>.slot<i>. The command runs under
`nice -n 10` and only starts once load5/ncpu < 1.0. Total wait (slot +
load) is capped at 20 minutes; on expiry the command is NOT run and wrk
exits 75 (EX_TEMPFAIL). The command inherits the slot fd (nested detection
needs it — see WRK_HEAVY_HELD_FD), so an orphaned child keeps the slot while
it lives; the kernel frees the slot when the whole holder tree is gone.

The limit comes from hosts.toml `[local] heavy_max` (WRK_HOSTS_CONFIG or
~/.config/wrk/hosts.toml): unset = 1, 0 = refuse every heavy run on this
host with rc 78 (EX_CONFIG) and a message naming the host and pointing at
desktop, N>1 = N concurrent holders. `WRK_HEAVY_MAX` overrides the
configured value for one invocation. A non-integer or negative limit also
refuses rc 78 — a config typo must not silently allow runs. Lowering the
limit does not kill extra holders minted under a larger one; they drain.

`wrk heavy status` prints the lock path, this host, the effective limit,
one `holder` line per occupied slot, and queued waiters (holder pids are the
wrk heavy python processes; killing one frees its slot once the command
tree that inherited the slot fd is also gone). status never creates slot
files and is never refused.

Every acquisition appends one JSON record to the heavy log (default
~/.local/state/wrk/heavy.log): ts, kind=run, host, job (ARBITER_JOB or -),
task (HK_TASK_ID or -), pid, slot, limit, cmd, wait_s, wait_lock_s,
wait_load_s, hold_s, rc. Nested runs are logged as kind=nested, refusals as
kind=refused and wait-cap expiries as kind=wait_cap, so wait times stay
aggregable and no execution path evades the log.

Notes: the command's own exit 75 is indistinguishable from a wait-cap 75 —
check stderr. stdin is not forwarded (the command sees EOF). A nested
`wrk heavy` on the same lock is detected and run directly under nice — the
outer invocation already holds a slot, so nesting never deadlocks. Because
the command inherits the slot descriptor, the slot stays held for as long
as any inheriting descendant lives: a crashed wrapper's slot is reclaimed
by the kernel only once the whole holder process tree is gone.

Environment:
  WRK_HEAVY_HELD        <lock path>:<holder pid>, set by wrk heavy for its
                        command; informational only — nested detection uses
                        WRK_HEAVY_HELD_FD
  WRK_HEAVY_HELD_FD     <fd>:<slot path>, set by wrk heavy for its command
                        so a nested wrk heavy is detected; honored only when
                        the fd is an inherited descriptor of the open file
                        description that owns that slot's flock right now,
                        and the slot is acquirable under the current limit —
                        forged env values and rewritten slot text cannot pass
  WRK_HEAVY_LOCK        lock file path
                        (default /tmp/wrk-heavy-<hostname>.lock)
  WRK_HEAVY_MAX         override the hosts.toml heavy_max for this run
  WRK_HEAVY_WAIT_CAP    total wait cap in seconds (default 1200)
  WRK_HEAVY_LOAD_FILE   file re-read each poll whose first field is used as
                        load5/ncpu (default: os.getloadavg()[1]/cpu_count)
  WRK_HEAVY_LOG         acquisition log path
                        (default ~/.local/state/wrk/heavy.log)
  -h, --help            show this usage
USAGE
}

heavy_cmd() {
  case "${1:-}" in
    -h|--help) heavy_help; return 0 ;;
  esac
  # Per-host heavy concurrency limit (#772): WRK_HEAVY_MAX wins for one
  # invocation, then hosts.toml [local] heavy_max via the same
  # spillover_value reader that owns the documented TOML surface, else 1.
  # The python half validates and enforces it.
  local heavy_limit heavy_limit_src
  if [[ -n "${WRK_HEAVY_MAX:-}" ]]; then
    heavy_limit="$WRK_HEAVY_MAX"
    heavy_limit_src="WRK_HEAVY_MAX"
  elif heavy_limit="$(spillover_value local heavy_max 2>/dev/null)"; then
    heavy_limit_src="$(spillover_config) [local] heavy_max"
  else
    heavy_limit=1
    heavy_limit_src="default"
  fi
  WRK_HEAVY_LIMIT="$heavy_limit" WRK_HEAVY_LIMIT_SRC="$heavy_limit_src" \
    python3 - "$@" <<'PY'
import datetime, fcntl, glob, json, os, re, socket, subprocess, sys, time

EXIT_WAIT_CAP = 75  # EX_TEMPFAIL: transient, worth reporting and retrying later
EXIT_REFUSED = 78   # EX_CONFIG: this host's configuration forbids the run


def fail(msg, rc):
    print("wrk heavy: " + msg, file=sys.stderr)
    raise SystemExit(rc)


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        return True
    return True


def read_text(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


args = sys.argv[1:]
if not args:
    fail("usage: wrk heavy -- <command> [args...] | wrk heavy status", 2)

host = socket.gethostname()
lock_path = os.environ.get("WRK_HEAVY_LOCK") or (
    "/tmp/wrk-heavy-%s.lock" % host)
waiters_dir = lock_path + ".waiters"

# The bash half resolves the limit from WRK_HEAVY_MAX or hosts.toml [local]
# heavy_max. Invalid (non-integer or negative) refuses the run rc 78; status
# stays tolerant so a broken config can still be inspected.
limit_raw = os.environ.get("WRK_HEAVY_LIMIT", "1")
limit_src = os.environ.get("WRK_HEAVY_LIMIT_SRC", "default")
try:
    limit = int(limit_raw)
    limit_ok = limit >= 0
except ValueError:
    limit, limit_ok = -1, False

slot_re = re.compile(re.escape(lock_path) + r"\.slot(\d+)$")


def slot_index(path):
    if path == lock_path:
        return 0
    return int(slot_re.match(path).group(1))


def limit_slots():
    # Acquirable slots under the current limit. The base lock file stays
    # slot 0 so a limit-1 host keeps byte-identical semantics (and stays
    # mutually exclusive with older wrk versions that only know that file).
    if not limit_ok:
        return [lock_path]
    return [lock_path] + [
        "%s.slot%d" % (lock_path, i) for i in range(1, limit)]


def known_slots():
    # Slots a status/nested-holder probe must inspect: acquirable ones plus
    # files minted under an earlier larger limit — their holders still
    # serialize even though new runs may not take them.
    paths = list(limit_slots())
    extras = [p for p in glob.glob(lock_path + ".slot*")
              if slot_re.match(p) and p not in paths]
    return paths + sorted(extras, key=slot_index)


log_path = os.environ.get("WRK_HEAVY_LOG") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "wrk", "heavy.log")


def log_event(rec):
    # One JSONL record per event the director aggregates: runs (with
    # wait/hold seconds), refusals and wait-cap expiries. Best-effort — a
    # lost record must not fail the run.
    rec.update({
        "ts": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
        "host": host,
        "job": os.environ.get("ARBITER_JOB") or "-",
        "task": os.environ.get("HK_TASK_ID") or "-",
        "pid": os.getpid(),
    })
    try:
        os.makedirs(os.path.dirname(log_path), exist_ok=True)
        with open(log_path, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, sort_keys=True) + "\n")
    except OSError as e:
        print("wrk heavy: cannot write heavy log %s: %s" % (log_path, e),
              file=sys.stderr)


def flock_held(path):
    # NB flock probe: True iff another process holds the file. Never mints
    # the slot — a missing file cannot be held.
    try:
        fd = os.open(path, os.O_RDWR)
    except OSError:
        return False
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        return False
    finally:
        os.close(fd)  # close also releases a probe that did acquire


if args[0] == "status":
    if len(args) != 1:
        fail("status takes no arguments", 2)
    print("lock " + lock_path)
    print("host " + host)
    if limit_ok:
        print("limit %d (%s)" % (limit, limit_src))
    else:
        print("limit %s (invalid, %s)" % (limit_raw, limit_src))
    paths = known_slots()
    holders = []
    for p in paths:
        if flock_held(p):
            holders.append((slot_index(p), read_text(p) or "(info unreadable)"))
    for i, hinfo in holders:
        print("holder " + (("slot=%d " % i) if len(paths) > 1 else "") + hinfo)
    if not holders:
        print("holder none")
    waiters = []
    try:
        names = sorted(os.listdir(waiters_dir))
    except OSError:
        names = []
    for name in names:
        path = os.path.join(waiters_dir, name)
        info = read_text(path)
        # The pid is the first field of the record we write — never scan
        # later fields, or a `pid=` token inside the command text would make
        # a live waiter look dead here.
        pid = -1
        first = info.split(None, 1)[0] if info else ""
        if first.startswith("pid="):
            try:
                pid = int(first[4:])
            except ValueError:
                pass
        if pid > 0 and not alive(pid):
            try:
                os.remove(path)
            except OSError:
                pass
            continue
        waiters.append(info or name)
    for w in waiters:
        print("waiter " + w)
    if not waiters:
        print("waiters none")
    raise SystemExit(0)

if args[0] != "--":
    fail("expected '--' before the command (see 'wrk heavy --help')", 2)
cmd = args[1:]
if not cmd:
    fail("no command after '--'", 2)

try:
    cap = float(os.environ.get("WRK_HEAVY_WAIT_CAP", "1200"))
except ValueError:
    fail("WRK_HEAVY_WAIT_CAP is not a number", 2)
deadline = time.monotonic() + cap
cmd_summary = " ".join(cmd)
info = "pid=%d since=%s job=%s cmd=%s" % (
    os.getpid(), datetime.datetime.now().isoformat(timespec="seconds"),
    os.environ.get("ARBITER_JOB") or "-", cmd_summary)
started_at = time.monotonic()

if not limit_ok:
    fail("invalid heavy limit '%s' from %s (want an integer >= 0)"
         % (limit_raw, limit_src), EXIT_REFUSED)
if limit == 0:
    log_event({"kind": "refused", "cmd": cmd_summary[:200],
               "limit": 0, "limit_src": limit_src})
    fail("host '%s' is configured heavy_max=0 (%s) -- refusing; run heavy "
         "commands on desktop instead" % (host, limit_src), EXIT_REFUSED)


def load_ratio():
    load_file = os.environ.get("WRK_HEAVY_LOAD_FILE")
    if load_file:
        try:
            return float(read_text(load_file).split()[0])
        except (ValueError, IndexError):
            return None
    try:
        return os.getloadavg()[1] / (os.cpu_count() or 1)
    except OSError:
        return None


def fd_is_open(fd):
    try:
        os.fstat(fd)
    except OSError:
        return False
    return True


slot_env_re = re.compile(
    re.escape(os.path.realpath(lock_path)) + r"\.slot(\d+)$")


def nested_held_fd(fd_s, env_path):
    # WRK_HEAVY_HELD_FD=<fd>:<slot path> is honored only when every kernel
    # check lines up: fd is an open descriptor on a slot acquirable under the
    # current limit, that file is flock-held right now, AND fd belongs to the
    # open file description that owns the lock (relocking an inherited
    # descriptor of the held OFD succeeds; a fresh open on a file held by
    # another fails). The proof object is the slot itself — no env text,
    # slot text, pid, side file, or PATH helper is trusted, because anything
    # a same-uid caller can name or rewrite it can also fake (#772 tester
    # rounds 1-3). A `.slotN` outside the current limit is just a caller-made
    # file — honoring it would let a self-flocked phantom slot forge nesting.
    rp = os.path.realpath(env_path)
    if rp != os.path.realpath(lock_path):
        m = slot_env_re.match(rp)
        if m is None or not 0 < int(m.group(1)) < limit:
            return None
    try:
        env_fd = int(fd_s)
        fst = os.fstat(env_fd)
        lst = os.stat(env_path)
    except (OSError, ValueError):
        return None
    if (fst.st_dev, fst.st_ino) != (lst.st_dev, lst.st_ino):
        return None
    if not flock_held(env_path):
        return None  # the slot it claims is free — stale or forged
    try:
        fcntl.flock(env_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return None  # a different OFD than the holder's
    return env_fd


held_fd = None
held_path = None
nested_fd = None
nested_path = None


def run_command():
    try:
        env = dict(os.environ)
        env["WRK_HEAVY_HELD"] = "%s:%d" % (
            os.path.abspath(lock_path), os.getpid())
        hfd = held_fd if held_fd is not None else nested_fd
        hpath = held_path if held_fd is not None else nested_path
        if hfd is not None and hpath and fd_is_open(hfd):
            # hand the slot fd down so a nested wrk heavy can prove it is
            # inside this holder's process tree (see nested_held_fd)
            env["WRK_HEAVY_HELD_FD"] = "%d:%s" % (hfd, hpath)
            pfds = {hfd}
        else:
            env.pop("WRK_HEAVY_HELD_FD", None)
            pfds = ()
        rc = subprocess.call(["nice", "-n", "10"] + cmd, env=env,
                             pass_fds=pfds)
        if rc < 0:
            rc = 128 - rc
        return rc
    except FileNotFoundError as e:
        fail("cannot run command: %s" % e, 127)
    except KeyboardInterrupt:
        return 130


# A nested `wrk heavy` on the same lock would deadlock against itself for the
# full cap — the outer invocation already holds a slot on this host, so run
# the inner command directly (still under nice) and log it as a nested run.
# Detection is by inherited slot fd, not the pid env: the holder hands its
# slot descriptor to the command, and only a process that actually received
# that descriptor can relock it.
held_fd_env = os.environ.get("WRK_HEAVY_HELD_FD", "")
held_fd_s, sep, held_fd_path = held_fd_env.partition(":")
if sep and held_fd_s.isdigit():
    nested_fd = nested_held_fd(held_fd_s, held_fd_path)
    if nested_fd is not None:
        nested_path = os.path.realpath(held_fd_path)
if nested_fd is not None:
    print("wrk heavy: already holding %s in this process tree -- "
          "running nested command without re-locking" % lock_path,
          file=sys.stderr)
    nested_at = time.monotonic()
    nrc = run_command()
    log_event({"kind": "nested", "cmd": cmd_summary[:200], "limit": limit,
               "wait_s": 0.0, "hold_s": round(time.monotonic() - nested_at, 3),
               "rc": nrc})
    raise SystemExit(nrc)

os.makedirs(waiters_dir, exist_ok=True)
me = os.path.join(waiters_dir, str(os.getpid()))
held_slot = -1
acquired_at = None
run_at = None
rc = None
# PEP 446: os.open returns non-inheritable fds; the acquired slot fd is
# re-inherited into the command only via run_command's pass_fds so nested
# runs can prove they are inside the holder's tree (nested_held_fd). A slot
# therefore stays held for as long as any inheriting descendant lives — the
# lock's lifetime is the holder's process tree, not just this wrapper.
slot_paths = limit_slots()
slot_fds = [os.open(p, os.O_RDWR | os.O_CREAT, 0o644) for p in slot_paths]
try:
    with open(me, "w", encoding="utf-8") as f:
        f.write(info)
    while True:
        try:
            for i, sfd in enumerate(slot_fds):
                try:
                    fcntl.flock(sfd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    held_fd, held_slot, held_path = sfd, i, slot_paths[i]
                    break
                except BlockingIOError:
                    pass
            if held_fd is not None:
                break
            if time.monotonic() >= deadline:
                log_event({"kind": "wait_cap", "phase": "slot",
                           "cmd": cmd_summary[:200], "limit": limit,
                           "wait_s": round(time.monotonic() - started_at, 3)})
                fail("wait cap %.0fs exceeded waiting for a heavy slot on %s "
                     "-- command not run" % (cap, lock_path), EXIT_WAIT_CAP)
            time.sleep(0.5)
        except KeyboardInterrupt:
            fail("interrupted while waiting for a heavy slot on %s "
                 "-- command not run" % lock_path, 130)
    acquired_at = time.monotonic()
    try:
        os.remove(me)
    except OSError:
        pass
    os.ftruncate(held_fd, 0)
    os.write(held_fd, (info + "\n").encode())
    while True:
        try:
            ratio = load_ratio()
            if ratio is None or ratio < 1.0:
                break
            if time.monotonic() >= deadline:
                log_event({"kind": "wait_cap", "phase": "load",
                           "cmd": cmd_summary[:200], "limit": limit,
                           "wait_s": round(time.monotonic() - started_at, 3)})
                fail("wait cap %.0fs exceeded waiting for load5/ncpu %.2f "
                     "< 1.0 -- command not run" % (cap, ratio), EXIT_WAIT_CAP)
            time.sleep(1)
        except KeyboardInterrupt:
            fail("interrupted while waiting for load to drop "
                 "-- command not run", 130)
    run_at = time.monotonic()
    try:
        rc = run_command()
    except SystemExit as e:
        rc = e.code if isinstance(e.code, int) else 1
        raise
    raise SystemExit(rc)
finally:
    try:
        os.remove(me)
    except OSError:
        pass
    if held_fd is not None:
        if run_at is not None:
            log_event({"kind": "run", "cmd": cmd_summary[:200],
                       "slot": held_slot, "limit": limit,
                       "wait_s": round(run_at - started_at, 3),
                       "wait_lock_s": round(acquired_at - started_at, 3),
                       "wait_load_s": round(run_at - acquired_at, 3),
                       "hold_s": round(time.monotonic() - acquired_at, 3),
                       "rc": rc})
        os.ftruncate(held_fd, 0)
    for sfd in slot_fds:
        os.close(sfd)
PY
}

case "${1:-}" in
  -h|--help) usage ;;
  spawn) shift; spawn_router_cmd "$@" ;;
  done) shift; done_cmd "$@" ;;
  escalate) shift; escalate_cmd "$@" ;;
  joined) shift; joined_cmd "$@" ;;
  round) shift; round_cmd "$@" ;;
  sentinel) shift; sentinel_cmd "$@" ;;
  reap) shift; reap_cmd "$@" ;;
  prune) shift; prune_cmd "$@" ;;
  find) shift; find_cmd "$@" ;;
  name-sync) shift; name_sync_cmd "$@" ;;
  profiles) shift; profiles_cmd "$@" ;;
  hosts) shift; hosts_cmd "$@" ;;
  heavy) shift; heavy_cmd "$@" ;;
  "") usage >&2; exit 2 ;;
  *) die "unknown command '$1' (see 'wrk --help')" ;;
esac
