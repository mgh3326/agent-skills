    agy-flash36) PROFILE_KIND=agy; ARGS=(--model gemini-3.6-flash-high --dangerously-skip-permissions) ;;
    agy-flash37) PROFILE_KIND=agy; ARGS=(--model gemini-3.7-flash-high --dangerously-skip-permissions) ;;

    agy|agy-flash-med|agy-pro|agy-sonnet|agy-opus|agy-oss)
      die "profile '$MODEL' is retired" ;;
    *) die "unknown model profile '$MODEL'; see 'wrk spawn --help'" ;;
  esac

  # GATE_PROFILE is only scopefuel's accepted profile spelling. Pool/class/
  # usage policy remains solely in scopefuel; runtime MODEL and effort stay
  # exactly as requested.
  case "$MODEL" in
    opus|builder-opus|captain-opus) GATE_PROFILE=opus ;;
    sonnet|sonnet-med|builder-sonnet) GATE_PROFILE=sonnet ;;
    # #704: E6 rungs gate at their own rung (GATE_EFFORT_PIN) — quota_gate
    # forwards it as `scopefuel gate --effort`, and spawn enforces
    # SCOPEFUEL_E6_ARM naming exactly GATE_PROFILE@GATE_EFFORT_PIN.
    builder-opus-low|builder-opus-medium) GATE_PROFILE=opus; GATE_EFFORT_PIN="${MODEL##*-}" ;;
    builder-sonnet-xhigh|builder-sonnet-max|builder-sonnet-medium|builder-sonnet-low) GATE_PROFILE=sonnet; GATE_EFFORT_PIN="${MODEL##*-}" ;;
    haiku) GATE_PROFILE=haiku ;;
    # hk 1796: builder-haiku-low gates at the placed haiku@low row — same pin
    # rule as the other E6 rungs (SCOPEFUEL_E6_ARM=haiku@low); hk 1863 adds
    # the high, xhigh and max rungs (haiku@<rung>).
    builder-haiku-low|builder-haiku-high|builder-haiku-xhigh|builder-haiku-max) GATE_PROFILE=haiku; GATE_EFFORT_PIN="${MODEL##*-}" ;;
    fable) GATE_PROFILE=fable ;;
    devin-swe2|builder-devin) GATE_PROFILE=devin-swe2 ;;
    # hk 1604: scopefuel gate -m accepts every GRADE_TABLE profile, so each
    # devin spelling is judged as itself. Collapsing them onto devin-swe2
    # put the paid DeepSeek rungs (ds41, ds41-max) on the SWE-2 Free bucket.
    # Paid rungs must never be judged on the SWE-2 Free bucket. Builder seats
    # take the runtime profile from scopefuel grades.py _BUILDER_RUNGS
    # (builder-devin-medium -> devin-swe2-medium, and the same shape for
    # -max / ds41 / ds41-max). This case does not set GATE_EFFORT_PIN, so
    # quota_pool.record launch_profile stays the launcher spelling. An
    # installed scopefuel that rejects a name (argparse rc 2) still refuses
    # the spawn.
    devin-swe2-medium|devin-swe2-max|devin-swe17|devin-glm52|devin-ds41|devin-ds41-max) GATE_PROFILE="$MODEL" ;;
    builder-devin-medium) GATE_PROFILE=devin-swe2-medium ;;
    builder-devin-max) GATE_PROFILE=devin-swe2-max ;;
    builder-ds41) GATE_PROFILE=devin-ds41 ;;
    builder-ds41-max) GATE_PROFILE=devin-ds41-max ;;
    # hk 1380: the fusion spellings gate at their OWN gate_policy.json entries,
    # never at devin-swe2 — their family is the Claude family (anthropic), and
    # folding them into devin-swe2 would make a fusion tester look
    # cross-family against a claude builder and break the §2-4 separation.
    # The quota pool is still scopefuel's single `devin` pool — wrk owns no
    # pool mapping, the gate answer names the pool.
    devin-fusion-opus55|devin-fusion-sonnet55) GATE_PROFILE="$MODEL" ;;
    # hk 1729: Fusion-Sol profiles also gate at their exact catalog rows;
    # scopefuel supplies the codex pool recorded by arbiter.
    devin-fusion-sol61|devin-fusion-sol61-xhigh) GATE_PROFILE="$MODEL" ;;
    # hk 1620: the Argon trial spellings gate at their OWN gate_policy.json
    # entries, never at devin-swe2 (hk 1604 rule — each devin spelling gates
    # as itself). Their family is google (Gemini), and folding them into a
    # SWE-2 spelling would route a paid spelling onto a Free model-scope
    # bucket. The quota pool is still scopefuel's single `devin` pool — wrk
    # owns no pool mapping, the gate answer names the pool.
    devin-argon|devin-argon-medium|devin-argon-low) GATE_PROFILE="$MODEL" ;;
    # #1026: the gpt-6-sol rollback spellings gate like the spellings they roll
    # back — codex-sol6 like codex-sol, builder-sol6 like builder-sol (the flat
    # codex-max spelling, not an E6 rung).
    codex|codex-sol|codex-max|builder-sol|captain-sol|codex-sol56|codex-sol6|builder-sol6) GATE_PROFILE=codex-max ;;
    # #704: E6 codex rungs are judged at the canonical catalog profile + pinned
    # effort rung (codex-sol@high, codex-luna@max) — not the
    # flat codex-max/codex-luna-max spellings the old builders
    # use, because scopefuel #692's E6 marker is profile@effort-exact.
    builder-sol-high|builder-sol-max|builder-sol-medium|builder-sol-low) GATE_PROFILE=codex-sol; GATE_EFFORT_PIN="${MODEL##*-}" ;;
    builder-luna-max) GATE_PROFILE=codex-luna; GATE_EFFORT_PIN=max ;;
    # hk 1796: the luna pair gates at codex-luna@<rung> like builder-luna-max —
    # NOT the flat codex-luna-max gate profile the worker spellings below use.
    builder-luna-low|builder-luna-medium) GATE_PROFILE=codex-luna; GATE_EFFORT_PIN="${MODEL##*-}" ;;
    builder-terra-high|builder-terra-xhigh|builder-terra-max) GATE_PROFILE=codex-terra; GATE_EFFORT_PIN="${MODEL##*-}" ;;
    # task #527: the gate role-denies astra without an allowed --purpose, so the
    # counsel spawn path defaults it to `architect` (the wrk-side counsel use).
    # An explicit --purpose director|operator-request still wins.
    codex-astra) GATE_PROFILE=codex-astra; [[ -n "${PURPOSE:-}" ]] || PURPOSE=architect ;;
    codex-terra|codex-med|codex-terra-max) GATE_PROFILE=codex-terra-max ;;
    codex-luna|codex-luna-hi|codex-luna-max|codex-luna56|builder-luna) GATE_PROFILE=codex-luna-max ;;
    kiro-opus|kiro-opus-xhigh|kiro-opus-max) GATE_PROFILE=kiro-opus ;;
    kiro-sonnet) GATE_PROFILE=kiro-sonnet ;;
    kiro-cheap) GATE_PROFILE=kiro-cheap ;;
    kiro-haiku) GATE_PROFILE=kiro-haiku ;;
    kiro|kiro-sol|kiro-luna|kiro-glm|kiro-deepseek|kiro-minimax|kiro-minimax21|kiro-sol-xhigh|kiro-sol-max)
      GATE_PROFILE=kiro-sol ;;
    kimi-k3|kimi-k27|kimi-k27-code|kimi-k3-low) GATE_PROFILE="$MODEL" ;;
    builder-kimi) GATE_PROFILE=kimi-k3 ;;
    # #704: the kimi E6 rungs gate at their pinned rung like the rest (the
    # --effort goes to `scopefuel gate`, not the kimi CLI — that one takes the
    # rung from its clone home). Both rungs are unmeasured C rows under #692,
    # so without SCOPEFUEL_E6_ARM=kimi-k3@<rung> the gate refuses.
    builder-kimi-high|builder-kimi-max) GATE_PROFILE=kimi-k3; GATE_EFFORT_PIN="${MODEL##*-}" ;;
    oc-kimi-code|oc-glm|oc-kimi-k3|oc-dsflash|oc-gflash|oc-sonnet46|oc-oss|oc-omni|oc-qwen37-max|oc-minimax-m3|oc-solar4)
      GATE_PROFILE="$MODEL" ;;
    agy-flash|agy-flash36|agy-flash37) GATE_PROFILE="agy-flash" ;;
    grok|grok-hi|grok-med|grok45|grok45-med|grok46|grok46-med|builder-grok) GATE_PROFILE=grok-hi ;;
    # #737: the E6 grok rungs gate at their pinned rung (unmeasured C rows
    # under #692/#737 — spawn refuses without SCOPEFUEL_E6_ARM=grok-hi@<rung>).
    builder-grok-low|builder-grok-medium|builder-grok-xhigh) GATE_PROFILE=grok-hi; GATE_EFFORT_PIN="${MODEL##*-}" ;;
    # ROB-1252 / ROB-1253: clinepass 쿼타 풀로 귀속 — PROFILE_KIND=claude(구독 OAuth) 풀과
    # 완전 분리해야 admission/쿼타 집계가 섞이지 않는다.
    # 실험 지정 별칭(cc-dsflash/cc-dspro/cc-glm53)은 reps 축적 전까지 급표 미등재이므로
    # 동일 clinepass 풀의 대표 프로필(cc-qwen38)로 게이트 매핑.
    cc-qwen38|cc-glm) GATE_PROFILE="$MODEL" ;;
    cc-dsflash|cc-dspro|cc-glm53) GATE_PROFILE="cc-qwen38" ;;
  esac

  resolve_catalog_profile
  apply_catalog
  if [[ "${ROLE:-}" == builder && -n "${ROUND_EXT_REF:-}" ]]; then
    [[ "${ROUND_EXT_CATALOG_VERIFIED:-0}" == 1 ]] ||
      die "--round-ext builder requires readable hk1672/v1 support evidence from scopefuel policy launch (check installed scopefuel version)"
  fi

  if [[ -n "$EFFORT" ]]; then
    case "$EFFORT" in low|medium|high|xhigh|max|ultra) ;; *) die "unknown effort '$EFFORT'" ;; esac
    [[ "$PROFILE_KIND" != kiro || "$EFFORT" != ultra ]] || die "Kiro does not support --effort ultra"
    [[ "$EFFORT_SUPPORTED" -eq 1 ]] || die "--effort is unsupported for profile '$MODEL'"
    EFFECTIVE_EFFORT="$EFFORT"
  else
    EFFECTIVE_EFFORT="$DEFAULT_EFFORT"
  fi

  # hk 1863 (operator decision on hk 1864, recorded on hk 1863): the
  # 2026-09-26 no-max builder-seat refusal (decision 4088 B) is removed for
  # every model — max is a legal builder rung, so builder-sonnet-max,
  # builder-sol-max, builder-luna-max, builder-kimi-max and builder-haiku-max
  # reach the E6 pin check below and need their exact SCOPEFUEL_E6_ARM
  # marker like every other pinned rung. codex `ultra` is the max tier plus
  # subagents, a different rung the decision did not open, so it stays
  # refused here. devin profiles carry no --effort at all
  # (EFFORT_SUPPORTED=0 above), so a devin builder's model-encoded rung never
  # reaches this check. The unflagged kimi spellings (builder-kimi, kimi-k3)
  # resolve their rung from the home's config below — the only place it
  # exists for them.
  if [[ "${ROLE:-worker}" == builder ]]; then
    local seat_effort="$EFFECTIVE_EFFORT"
    if [[ -z "$seat_effort" && "$PROFILE_KIND" == kimi ]]; then
      # builder-kimi and kimi-k3 leave EFFECTIVE_EFFORT empty (no --effort
      # flag, no DEFAULT_EFFORT): the only rung they can run is whatever the
      # kimi home resolves for the spawned model — the [thinking] effort, or
      # the model's default_effort when the request is missing/unsupported
      # (Kimi Code's documented fallback), or the KIMI_MODEL_THINKING_EFFORT
      # overlay when exported. Read it or an ultra-effort home slips a builder
      # seat past this rule unseen. A missing/unparseable config yields
      # empty and stays fail-open here — the E6 rungs below are what fail
      # closed on a missing clone.
      local kimi_model="" i
      for ((i = 0; i + 1 < ${#ARGS[@]}; i++)); do
        [[ "${ARGS[i]}" == -m ]] && kimi_model="${ARGS[i + 1]}"
      done
      seat_effort="$(kimi_clone_resolved_effort "${KIMI_TRUST_HOME:-}/config.toml" "$kimi_model")"
    fi
    case "$seat_effort" in
      ultra)
        die "$MODEL at effort $seat_effort is refused for --role builder: builder seats never take an ultra rung (max is allowed since hk 1863) — use max or below, or a devin profile" ;;
    esac
  fi

  # #704 (#594 E6): the per-rung builder spellings carry GATE_EFFORT_PIN. The
  # rung is pinned by the profile name — an explicit --effort may only restate
  # it (the kimi pair has EFFORT_SUPPORTED=0, so --effort is already refused
  # above). They exist to measure exactly that rung, so spawn is refused
  # unless SCOPEFUEL_E6_ARM names GATE_PROFILE@<rung> verbatim: scopefuel #692
  # opens the unmeasured C rungs only for that marker, and pinning it here
  # keeps an unlabeled or mislabeled launch out of the E6 sample.
  if [[ -n "$GATE_EFFORT_PIN" ]]; then
    [[ "$EFFECTIVE_EFFORT" == "$GATE_EFFORT_PIN" ]] ||
      die "$MODEL is pinned to effort $GATE_EFFORT_PIN (#594 E6 rung); --effort $EFFECTIVE_EFFORT is a different rung"
    [[ "${SCOPEFUEL_E6_ARM:-}" == "$GATE_PROFILE@$GATE_EFFORT_PIN" ]] ||
      die "$MODEL is an E6 measurement profile (#594): spawn requires SCOPEFUEL_E6_ARM=$GATE_PROFILE@$GATE_EFFORT_PIN (got '${SCOPEFUEL_E6_ARM:-<unset>}')"
    if [[ "$PROFILE_KIND" == kimi ]]; then
      # The kimi CLI has no --effort flag: the pinned clone home's
      # [thinking] effort is the only place this rung exists, so a missing or
      # mismatched clone would silently launch the wrong rung. Fail closed —
      # the env overlay must not stand in for a missing clone file.
      [[ -r "$KIMI_TRUST_HOME/config.toml" ]] ||
        die "$MODEL needs a $GATE_EFFORT_PIN-effort Kimi clone at $KIMI_TRUST_HOME (config.toml missing); refresh it with: bin/kimi-clone-home --effort $GATE_EFFORT_PIN"
      local local_clone_effort
      local_clone_effort="$(kimi_clone_thinking_effort "$KIMI_TRUST_HOME/config.toml")"
      [[ "$local_clone_effort" == "$GATE_EFFORT_PIN" ]] ||
        die "$MODEL needs a $GATE_EFFORT_PIN-effort Kimi clone at $KIMI_TRUST_HOME (found '${local_clone_effort:-<none>}'); refresh it with: bin/kimi-clone-home --effort $GATE_EFFORT_PIN"
    fi
  fi

  case "$PROFILE_KIND" in
    codex) ARGS=(--yolo -m "$PROFILE_MODEL" -c "model_reasoning_effort=$EFFECTIVE_EFFORT") ;;
    kiro)
      ARGS=(chat --v3 --trust-all-tools --require-mcp-startup)
      [[ -z "$PROFILE_MODEL" ]] || ARGS+=(--model "$PROFILE_MODEL")
      ARGS+=(--effort "$EFFECTIVE_EFFORT")
      ;;
    grok) ARGS=(--always-approve -m "${PROFILE_MODEL_ARG:-grok-4.7}" --effort "$EFFECTIVE_EFFORT") ;;
    claude)
      # Append only for effort-capable Claude profiles (opus/sonnet). fable stays bare.
      if [[ "$EFFORT_SUPPORTED" -eq 1 && -n "$EFFECTIVE_EFFORT" ]]; then
        ARGS+=(--effort "$EFFECTIVE_EFFORT")
      fi
      # #626 AC2: prompt suggestions prefill the composer with a predicted next
      # prompt; one submitted in a tester pane became a fake operator
      # confirmation (hk:doc task/2026-09-24/phantom-suggestion-submitted).
      # Documented off switch (code.claude.com/docs/en/env-vars): "Set to
      # `false` to turn off prompt suggestions … Takes precedence over the
      # `promptSuggestionEnabled` setting". Pane env only — argv and the
      # user's settings.json stay untouched. A resident session spawned with
      # --purpose director is the operator's call and is left as is.
      if [[ "${PURPOSE:-}" != director ]]; then
        PROFILE_ENV+=(--env "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=false")
      fi
      ;;
  esac
}

# #637: a pane's env and argv die with it — after a reboot herdr restores the
# pane as bare `claude --resume <id>` (hk:doc
# task/2026-09-24/resume-loses-worker-env). For claude-kind workers the durable
# copy of the prompt-suggestion toggle lives in the worker worktree's own
# .claude/settings.local.json, which Claude Code re-reads on every launch,
# resume included (verified: env values from a linked worktree's local file
# reach the session's process env).
#
# The launch permission mode is deliberately NOT written. Per
# settings-reference, "`auto` and `bypassPermissions` don't take effect from
# project or local settings"; the local source is still highest-priority, so
# the session then "starts in Manual mode" — writing bypassPermissions here
# would pin every flagless claude launch in the worktree (a herdr restore
# included) to Manual, overriding user settings and the built-in default.
# Restoring bypass needs the launch flag, or user/--settings/managed scope.
#
# Merge, never clobber: an existing file keeps every unrelated key, and only
# our env key is written. A file that is not a JSON object (or whose `env` is
# not an object — `null` included), or one already tracked by the repo, aborts
# the spawn rather than being silently overwritten — that state needs a human,
# not a rewrite. A symlinked .claude directory or settings file (dangling
# included) is left alone with a warning: writing through it could modify a
# location wrk does not own, and os.replace would destroy a leaf symlink to
# shared settings (CodeRabbit CR2/CR4) — the spawn proceeds without persisted
# settings.
write_claude_local_settings() {
  local cwd="$1"
  # A tracked settings.local.json belongs to the repo; wrk must never modify a
  # target repo's tracked files.
  git -C "$cwd" ls-files --error-unmatch -- .claude/settings.local.json >/dev/null 2>&1 &&
    { printf 'wrk: %s/.claude/settings.local.json is tracked in the repo; refusing to modify a tracked file\n' "$cwd" >&2; return 3; }
  # -L sees the link itself, so a dangling symlink is refused too.
  if [[ -L "$cwd/.claude" || -L "$cwd/.claude/settings.local.json" ]]; then
    warn "$cwd: .claude or .claude/settings.local.json is a symlink; leaving it alone (no local settings written)"
    return 0
  fi
  python3 - "$cwd" <<'PY'
import json, os, sys, tempfile

cwd = sys.argv[1]
path = os.path.join(cwd, ".claude", "settings.local.json")

data = {}
existed = os.path.exists(path)
if existed:
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError) as e:
        print("wrk: %s exists but is not valid JSON; refusing to modify it (%s)" % (path, e), file=sys.stderr)
        sys.exit(3)
    if not isinstance(data, dict):
        print("wrk: %s is not a JSON object; refusing to modify it" % path, file=sys.stderr)
        sys.exit(3)

if "env" in data:
    if not isinstance(data["env"], dict):
        print("wrk: %s: 'env' is not a JSON object; refusing to modify it" % path, file=sys.stderr)
        sys.exit(3)
else:
    data["env"] = {}

data["env"]["CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION"] = "false"

os.makedirs(os.path.dirname(path), exist_ok=True)
fd, tmp = tempfile.mkstemp(prefix=".settings.local.json.", dir=os.path.dirname(path))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")
    if existed:
        os.chmod(tmp, os.stat(path).st_mode & 0o777)
    os.replace(tmp, path)
finally:
    if os.path.exists(tmp):
        os.unlink(tmp)
PY
}

# The worker's local settings must never enter a commit. Claude Code itself
# keeps the file out of git via the user's global excludes; a repo that already
# ignores it needs nothing. When the worker repo does not, the pattern goes to
# the repository's own .git/info/exclude (resolved through --git-common-dir so
# linked worktrees share it) — a tracked file is never touched. A cwd outside
# git, or an exclude write that fails, is a warning, not a failed spawn: the
# file is already on disk and the spawn stands.
ensure_settings_local_ignored() {
  local cwd="$1" common
  git -C "$cwd" rev-parse --git-common-dir >/dev/null 2>&1 || {
    warn "$cwd is not a git worktree; cannot verify .claude/settings.local.json is git-ignored (nothing can commit it there)"
    return 0
  }
  git -C "$cwd" check-ignore -q -- .claude/settings.local.json && return 0
  common="$(git -C "$cwd" rev-parse --git-common-dir)"
  # --git-common-dir is relative for a main checkout (".git"); anchor it to the
  # worktree cwd or the mkdir/append below would land in wrk's own directory.
  [[ "$common" == /* ]] || common="$cwd/$common"
  mkdir -p "$common/info" ||
    { warn "cannot create $common/info; $cwd/.claude/settings.local.json is not git-ignored — do not commit it"; return 0; }
  # A file with no final newline would glue our pattern onto its last line,
  # un-ignoring whatever that rule named (CodeRabbit CR3).
  if [[ -s "$common/info/exclude" ]] && [[ -n "$(tail -c 1 "$common/info/exclude" 2>/dev/null)" ]]; then
    printf '\n' >>"$common/info/exclude" ||
      { warn "cannot append to $common/info/exclude; $cwd/.claude/settings.local.json is not git-ignored — do not commit it"; return 0; }
  fi
  grep -qxF '**/.claude/settings.local.json' "$common/info/exclude" 2>/dev/null ||
    printf '%s\n' '**/.claude/settings.local.json' >>"$common/info/exclude" ||
    { warn "cannot append to $common/info/exclude; $cwd/.claude/settings.local.json is not git-ignored — do not commit it"; return 0; }
  git -C "$cwd" check-ignore -q -- .claude/settings.local.json ||
    warn "$cwd/.claude/settings.local.json is still not git-ignored after updating info/exclude — do not commit it"
}

# ── job event order and publication (hk 1750) ─────────────────────────────
# bin/arbiter numbers its event files from its own SQLite seq and wrk numbers
# from the directory's highest prefix, so the two writers interleave: the same
# directory holds 00011-job.completed and then 00009-job.spawned. File name
# order alone therefore never decides terminal vs revive. Every reader that
# decides order and every writer that publishes a record uses this one
# definition. The order key is (event time, file mtime, name): event time is
# the record's created_at or at when present, otherwise the file mtime, and
# the name is only the final tie-break.
#
# Snippets run `exec(os.environ["WRK_EVENTS_PY"])`; wrk_py hands them the code
# per invocation, so the helper never leaks into a spawned pane's environment.
WRK_EVENTS_PY='
import datetime as _dt
import json as _json
import os as _os
import tempfile as _tempfile


def wrk_event_moment(value):
    if not isinstance(value, str) or not value.strip():
        return None
    try:
        parsed = _dt.datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            parsed = parsed.astimezone()
        return parsed.timestamp()
    except (ValueError, OverflowError, OSError):
        return None


def wrk_event_time(document, mtime):
    """The record time: created_at or at when present, else the file mtime."""
    if isinstance(document, dict):
        payload = document.get("payload")
        if not isinstance(payload, dict):
            payload = document
        for value in (document.get("created_at"), document.get("at"),
                      payload.get("created_at"), payload.get("at")):
            moment = wrk_event_moment(value)
            if moment is not None:
                return moment
    return mtime


def wrk_events_ordered(events):
    """[(name, document-or-None, mtime)] sorted by (event time, mtime, name).

    Event time is compared at whole-second precision. Writers stamp different
    precisions (wrk at is milliseconds, the arbiter envelope created_at is
    whole seconds), so comparing the raw values would sort a terminal at
    hh:mm:ss.429 after a revive written 300 ms later at hh:mm:ss.000 — the
    incident shape again, one second wide. Within a second the file mtime,
    the actual write time, breaks the tie; the name stays the last resort.
    """
    rows = []
    try:
        names = _os.listdir(events)
    except OSError:
        return rows
    for name in names:
        if name.startswith(".") or not name.endswith(".json"):
            continue
        path = _os.path.join(events, name)
        try:
            mtime = _os.path.getmtime(path)
        except OSError:
            mtime = 0.0
        try:
            with open(path, encoding="utf-8") as handle:
                document = _json.load(handle)
        except (OSError, ValueError):
            document = None
        if not isinstance(document, dict):
            document = None
        rows.append((int(wrk_event_time(document, mtime)), mtime, name, document))
    rows.sort(key=lambda row: (row[0], row[1], row[2]))
    return [(name, document, mtime) for _, mtime, name, document in rows]


def wrk_takeover_rounds(events):
    """Round count inherited by this job from its newest takeover record."""
    inherited = 0
    for _, document, _ in wrk_events_ordered(events):
        if document is None or document.get("kind") != "job.takeover":
            continue
        payload = document.get("payload", document)
        value = payload.get("rounds_used") if isinstance(payload, dict) else None
        if isinstance(value, int) and not isinstance(value, bool):
            inherited = max(inherited, value)
    return inherited


def wrk_event_highest(events):
    highest = 0
    try:
        names = _os.listdir(events)
    except OSError:
        return 0
    for name in names:
        try:
            highest = max(highest, int(name.split("-", 1)[0]))
        except (ValueError, IndexError):
            pass
    return highest


def wrk_event_at():
    return (_dt.datetime.now(_dt.timezone.utc)
            .isoformat(timespec="milliseconds").replace("+00:00", "Z"))


def wrk_events_locked(events):
    """The events lock shared with bin/arbiter and the other wrk writers."""
    import fcntl
    lock = open(_os.path.join(_os.path.dirname(events), ".wrk-events.lock"),
                "w", encoding="utf-8")
    fcntl.flock(lock, fcntl.LOCK_EX)
    return lock


def wrk_event_commit(events, kind, record, attempts=100):
    """Publish one record at a name no other event owns.

    The final name is created by hard-linking the fully written temp file, so
    a collision with a concurrent writer (or with the arbiter) is
    FileExistsError, never an overwrite; the writer then retries at the next
    directory number, bounded.
    """
    record.setdefault("at", wrk_event_at())
    fd, temporary = _tempfile.mkstemp(prefix=".event-", dir=events)
    try:
        with _os.fdopen(fd, "w", encoding="utf-8") as handle:
            _json.dump(record, handle, separators=(",", ":"))
            handle.write("\n")
        _os.chmod(temporary, 0o600)
        for _ in range(attempts):
            final = _os.path.join(
                events, "%05d-%s.json" % (wrk_event_highest(events) + 1, kind))
            try:
                _os.link(temporary, final)
                return final
            except FileExistsError:
                continue
            except OSError:
                # A filesystem without hard links still must not overwrite:
                # create the same final name exclusively and write the bytes.
                try:
                    out = _os.open(
                        final, _os.O_WRONLY | _os.O_CREAT | _os.O_EXCL, 0o600)
                except FileExistsError:
                    continue
                with _os.fdopen(out, "w", encoding="utf-8") as handle:
                    _json.dump(record, handle, separators=(",", ":"))
                    handle.write("\n")
                return final
        raise OSError("event numbering exhausted after %d attempts" % attempts)
    finally:
        if _os.path.exists(temporary):
            _os.unlink(temporary)


def wrk_end_declaration(events):
    """Filename of the newest end declaration when it is later than the newest revive.

    End kinds are job.revoked, job.reaped and job.handed_off. Revive kinds are
    job.claim, job.reclaim and job.spawned. Later means a higher index in
    wrk_events_ordered. An end with no revive is later.
    """
    last_end = ""
    last_end_at = -1
    last_revive_at = -1
    for index, (name, document, _mtime) in enumerate(wrk_events_ordered(events)):
        if not isinstance(document, dict):
            continue
        kind = document.get("kind")
        if kind in ("job.revoked", "job.reaped", "job.handed_off"):
            last_end = name
            last_end_at = index
        elif kind in ("job.claim", "job.reclaim", "job.spawned"):
            last_revive_at = index
    if last_end and last_end_at > last_revive_at:
        return last_end
    return ""


def wrk_precommit_test_hook(events, job):
    """Test seam for the joined recheck, never a production path.

    Runs the script named by WRK_TEST_JOINED_PRECOMMIT_HOOK with the events
    directory and the job id, under the events lock, but only when
    WRK_TEST_MODE is exactly 1. Otherwise it does nothing.
    """
    hook = _os.environ.get("WRK_TEST_JOINED_PRECOMMIT_HOOK", "")
    if hook and _os.environ.get("WRK_TEST_MODE") == "1":
        import subprocess
        subprocess.run([hook, events, job], check=True, stdout=subprocess.DEVNULL)


def wrk_joined_claim_change(events, parent, task_id, version):
    """Newest claim fact that moved since a join waiver was verified.

    Re-reads the newest job.claim/job.reclaim under the events lock and
    returns "field OLD -> NEW" for the first of parent_lane, task_id and the
    claim event name that differs from the verified values, else "".
    """
    name, document = "", None
    for cand, doc, _mtime in wrk_events_ordered(events):
        if isinstance(doc, dict) and doc.get("kind") in ("job.claim", "job.reclaim"):
            name, document = cand, doc
    payload = document.get("payload") if isinstance(document, dict) else None
    if not isinstance(payload, dict):
        payload = document if isinstance(document, dict) else {}
    now_parent = payload.get("parent_lane")
    now_parent = now_parent if isinstance(now_parent, str) else ""
    now_task = payload.get("task_id")
    now_task = (str(now_task)
                if isinstance(now_task, (int, str))
                and not isinstance(now_task, bool) else "")
    if now_parent != parent:
        return "parent_lane %s -> %s" % (parent or "-", now_parent or "-")
    if now_task != task_id:
        return "task_id %s -> %s" % (task_id or "-", now_task or "-")
    if name != version:
        return "claim_version %s -> %s" % (version or "-", name or "-")
    return ""


def wrk_round_census(events, job):
    """Return (recorded, nonvoid) round evidence for one job.

    recorded counts every job.round, every unbound job.verdict and inherited
    takeover rounds; it is the round-cap count. nonvoid is the join gate: a
    job.round counts only when a job.verdict is bound to its number, plus
    unbound verdicts and inherited takeover rounds. An open round with no
    verdict does not count, and neither does a voided one, because a void only
    takes effect on a round that holds no verdict.
    """
    records = [document for _name, document, _mtime in wrk_events_ordered(events)
               if isinstance(document, dict)]
    rounds = [record for record in records if record.get("kind") == "job.round"]
    verdicts = [record for record in records if record.get("kind") == "job.verdict"]
    bound = set()
    for verdict in verdicts:
        number = verdict.get("round")
        if isinstance(number, int):
            bound.add(number)
    unbound = 0
    for verdict in verdicts:
        if not isinstance(verdict.get("round"), int):
            unbound += 1
    inherited = wrk_takeover_rounds(events)
    recorded = len(rounds) + unbound + inherited
    nonvoid = sum(1 for r in rounds if isinstance(r.get("round"), int) and r.get("round") in bound)  # hk1449-nonvoid-rounds
    nonvoid += unbound + inherited
    return recorded, nonvoid


def wrk_claim_role(events):
    role = ""
    for _name, document, _mtime in wrk_events_ordered(events):
        if not isinstance(document, dict):
            continue
        if document.get("kind") not in ("job.claim", "job.reclaim"):
            continue
        payload = document.get("payload")
        if not isinstance(payload, dict):
            payload = document
        value = payload.get("role")
        if isinstance(value, str):
            role = value
    return role

import re as _re
# Shared by round verdict and the join/audit file scan. The sha-boundary
# mutant replaces this one anchor, so a second copy would miss the parser.
wrk_verdict_line = _re.compile(r"^VERDICT: (PASS|BLOCKER) @([0-9a-fA-F]{40})\s*$")
'
wrk_py() {
  WRK_EVENTS_PY="$WRK_EVENTS_PY" python3 "$@"
}

# completion_event JOB OWNER LABEL PANE REPORT [KIND] [REASON] [MODE]
#
# MODE=record (default) writes the durable event file and prints "created"
# plus the report path the record names, or "duplicate" when an identical
# report was already completed. MODE=resolve runs the same decisions under
# the same lock but writes nothing: it prints "duplicate", or "resolved" plus
# the target path — REPORT itself, or a freshly created <stem>-r<N>.md
# snapshot of its content when REPORT already names an earlier completed
# round. done_cmd resolves first so the document upload, the record, the
# relay emit and the OK line all name one artifact.
completion_event() {
  local job="$1" owner="$2" label="$3" pane="$4" report="$5" kind="${6:-job.completed}" reason="${7:-}" mode="${8:-record}"
  local events host last
  events="$(wrk_jobs_root)/$job/events"
  host="${HOSTNAME:-unknown}"
  mkdir -p "$events"
  if [[ -n "$report" && -f "$report" ]]; then
    last="$(tail -n 1 "$report" 2>/dev/null | tr '\r\n' ' ' | cut -c1-240)"
    last="$(append_document_suffix "$last")"
  else
    last=""
  fi
  wrk_py - "$events" "$job" "$owner" "$label" "$pane" "$host" "$report" "$last" "$kind" "$reason" "$mode" <<'PY'
import fcntl, hashlib, json, os, re, sys, tempfile, time
exec(os.environ["WRK_EVENTS_PY"])
events, job, owner, label, pane, host, report, last, kind, reason, mode = sys.argv[1:]


def digest_of(path):
    try:
        with open(path, 'rb') as f:
            return hashlib.sha256(f.read()).hexdigest()
    except OSError:
        return None


# A completed round is identified by the report artifact's content, not by an
# invocation count or epoch (a constant today). `wrk done` and the completion
# sentinel are separate processes racing on this directory, so the membership
# check and the record write run inside one lock; the lockfile lives next to
# events/ because the directory is also a consumer-facing record stream.
# The bytes are read once: the digest and the snapshot below are computed from
# and written with this same payload, so a record never names a snapshot whose
# sha256 differs from report_sha256 even if report.md is rewritten mid-call.
payload = None
digest = None
if kind == "job.completed":
    try:
        with open(report, 'rb') as f:
            payload = f.read()
        digest = hashlib.sha256(payload).hexdigest()
    except OSError:
        pass
lock_path = os.path.join(os.path.dirname(events), ".wrk-events.lock")
with open(lock_path, "w", encoding="utf-8") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    if digest is not None:
        priors = []
        for name, prior, _ in wrk_events_ordered(events):
            if not name.endswith("-job.completed.json"):
                continue
            if prior is None or prior.get("kind") != "job.completed":
                continue
            priors.append(prior)
            prior_digest = prior.get("report_sha256")
            # A legacy record carries no content identity, and no filesystem
            # proxy can reconstruct it — a rewritten file can keep an old
            # mtime (touch, cp -p, rsync -a). Absent proof of identity a record
            # can never be a suppression basis: fail toward writing, never
            # toward eating a new round.
            if prior_digest is None:
                continue
            if prior_digest == digest:
                print("duplicate")
                sys.exit(0)
        # panewire's relay outbox key is (kind, job, epoch, report_path,
        # reason): a later round that reuses an earlier record's report path
        # with changed content collides on that key and its emit is refused
        # (rc 6), leaving the completion file-only. Rename the artifact, not
        # the epoch: snapshot the current content to <stem>-r<N><ext> (N = 1 +
        # this job's earlier distinct completed rounds) so the record the
        # daemon rescans and the emit both carry a fresh key. The name is
        # published by hard-link, never overwriting an existing file; an
        # identical-content file already there is this same decision's
        # leftover from a lost race and is adopted as-is.
        used_paths = {p.get("report_path") for p in priors}
        if report in used_paths:
            stem, ext = os.path.splitext(os.path.basename(report))
            stem = re.sub(r"-r[0-9]+$", "", stem)
            rounds = sum(1 for p in priors if not p.get("report_sha256"))
            rounds += len({p["report_sha256"] for p in priors if p.get("report_sha256")})
            directory = os.path.dirname(report) or "."
            n = rounds + 1
            while True:
                candidate = os.path.join(directory, "%s-r%d%s" % (stem, n, ext))
                if candidate in used_paths:
                    n += 1
                    continue
                if os.path.exists(candidate):
                    if digest_of(candidate) == digest:
                        report = candidate
                        break
                    n += 1
                    continue
                temporary = None
                try:
                    fd, temporary = tempfile.mkstemp(prefix='.report-', dir=directory)
                    with os.fdopen(fd, 'wb') as out:
                        out.write(payload)
                    os.link(temporary, candidate)
                    report = candidate
                except FileExistsError:
                    if digest_of(candidate) == digest:
                        report = candidate
                        break
                    n += 1
                    continue
                except OSError:
                    pass  # unsnapshotable dir or unreadable report: keep the path
                finally:
                    if temporary is not None and os.path.exists(temporary):
                        os.unlink(temporary)
                break
    if mode == "resolve":
        print("resolved")
        print(report)
        sys.exit(0)
    record = {"kind": kind, "job_id": job, "owner_lane": owner, "label": label,
              "pane_id": pane, "host": host, "report_path": report,
              "report_last_line": last, "epoch": 1}
    if digest is not None:
        record["report_sha256"] = digest
    # job.lost always states why. Downstream recovery treats agent_not_found as
    # a vanished pane and herdr_unreachable/timeout as an observation gap.
    if reason: record["reason"] = reason
    wrk_event_commit(events, kind, record)
print("created")
print(report)
PY
}

# A same-report re-completion is a no-op for the record stream but must not be
# silent: leave one durable line per suppressed write, next to the sentinel log.
note_duplicate_completion() {
  local job="$1" report="$2" jobdir
  jobdir="$(wrk_jobs_root)/$job"
  mkdir -p "$jobdir" 2>/dev/null || return 0
  printf '%s suppressed-duplicate report=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$report" >>"$jobdir/completion-suppressed.log" 2>/dev/null || true
  return 0
}

# R20 T3: the record files written above stay the durable contract — the node
# still finds them by rescanning the directory, and the panewire outbox picks
# up anything a live emit missed. `panewire emit` is only an extra, immediate
# notification that removes that rescan delay, so it must never change what
# `wrk` writes, prints, or exits with.
#
# `tr` turns the report's final newline into a trailing space, which plain
# command substitution would then eat along with the newline `cut` appends. The
# record files keep that space, so the value travels through a variable and
# only the trailing newlines are dropped — anything else and the emit payload
# stops being byte-identical to the record file the node also reads.
EMIT_REPORT_LAST_LINE=""
# Non-zero when this invocation's `panewire emit` returned non-zero (the other
# non-delivery modes — missing binary, wedged daemon — keep their warning-only
# shape). done_cmd reads it to mark the OK line relay=file-only.
EMIT_RELAY_RC=0
set_report_last_line() {
  local report="${1:-}"
  EMIT_REPORT_LAST_LINE=""
  [[ -n "$report" && -f "$report" ]] || return 0
  EMIT_REPORT_LAST_LINE="$(tail -n 1 "$report" 2>/dev/null | tr '\r\n' ' ' | cut -c1-240; printf x)"
  EMIT_REPORT_LAST_LINE="${EMIT_REPORT_LAST_LINE%x}"
  while [[ "$EMIT_REPORT_LAST_LINE" == *$'\n' ]]; do
    EMIT_REPORT_LAST_LINE="${EMIT_REPORT_LAST_LINE%$'\n'}"
  done
  EMIT_REPORT_LAST_LINE="$(append_document_suffix "$EMIT_REPORT_LAST_LINE")"
}

# Set only by upload_report_document for the current completion command. The
# same suffix is applied independently to the durable record and relay value,
# preserving their byte-identical report_last_line contract.
REPORT_DOCUMENT_SUFFIX=""
append_document_suffix() {
  local last="$1" limit shortened
  [[ -n "$REPORT_DOCUMENT_SUFFIX" ]] || { printf '%s' "$last"; return 0; }
  limit=$((240 - ${#REPORT_DOCUMENT_SUFFIX}))
  if (( limit > 0 )); then
    shortened="$(printf '%s' "$last" | cut -c1-"$limit")"
    printf '%s' "$shortened"
  fi
  printf '%s' "$REPORT_DOCUMENT_SUFFIX"
}

# Upload a report opportunistically. Its result is deliberately settled before
# the durable record: that lets the record and wire value be written once with
# the same document suffix, rather than rewriting a landed record. The bounded
# (three-second) delay is the trade-off for that consistency.
upload_report_document() {
  local job="$1" report="$2" handoffkeep key base rc=0
  REPORT_DOCUMENT_SUFFIX=""
  handoffkeep="$(command -v "${HANDOFFKEEP_BIN:-handoffkeep}" 2>/dev/null || true)"
  if [[ -z "$handoffkeep" ]]; then
    warn "handoffkeep not found; report document not uploaded (job=$job)"
    return 0
  fi
  base="$(basename "$report")"
  key="reports/$job/$base"
  local command=(run_bounded 3 "$handoffkeep" doc put --key "$key" --kind report --job "$job" --file "$report")
  # Keep handoffkeep output out of wrk's one-line stdout contract; failures
  # below intentionally become one warning and never affect the exit status.
  "${command[@]}" >/dev/null 2>&1 || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    warn "handoffkeep document upload failed (rc=$rc job=$job); continuing without document link"
    return 0
  fi
  REPORT_DOCUMENT_SUFFIX=" doc:$key"
  if (( ${#REPORT_DOCUMENT_SUFFIX} > 240 )); then
    warn "handoffkeep document key is too long for report link (job=$job)"
    REPORT_DOCUMENT_SUFFIX=""
  fi
}

# emit_relay_event KIND JOB OWNER LABEL PANE HOST REPORT LAST REASON QUESTION PR HEAD
#
# Called only after the record file landed, and only for the three kinds
# panewire accepts (job.completed / job.escalate / job.joined). job.lost is not
# one of them, so the sentinel deliberately does not come through here.
# Always returns 0: a missing, failing or wedged panewire is a warning on
# stderr and nothing else.
emit_relay_event() {
  local kind="$1" job="$2" owner="$3" label="$4" pane="$5" host="$6" report="$7"
  local last="$8" reason="$9" question="${10}" pr="${11}" head="${12}"
  local panewire rc=0
  EMIT_RELAY_RC=0
  # #770 round-2: a panewire subprocess that was just killed by its timeout is
  # wedged — re-entering it for emit would stall this call by another full
  # emit guard (tester: sleeping stub made `wrk done` take delegate-timeout +
  # 5s). The record already landed on disk; the daemon rescan picks it up.
  if [[ "${PANEWIRE_WEDGED:-}" == 1 ]]; then
    warn "panewire emit skipped: panewire timed out earlier this invocation (job=$job kind=$kind)"
    record_emit_failure "$job" "$kind" "delegate_timeout"
    return 0
  fi
  panewire="$(command -v "${PANEWIRE_BIN:-panewire}" 2>/dev/null || true)"
  if [[ -z "$panewire" ]]; then
    warn "panewire not found; relay event left as file only (job=$job kind=$kind)"
    record_emit_failure "$job" "$kind" "not_found"
    return 0
  fi
  # A wedged socket must not stall `wrk joined`; that call sits in the builder
  # loop, so a hang there stops the fleet. `timeout` is GNU coreutils and a
  # stock macOS has neither it nor gtimeout, so python3 — already a hard
  # dependency above — carries the same guard there.
  # panewire wants the root containing jobs/<job>/events — the parent of
  # wrk_jobs_root(), since ARBITER_INBOX_ROOT names the jobs directory itself.
  # Without it emit falls back to the daemon's default root and the relay
  # misses the record file wrk just wrote.
  local inbox_root
  inbox_root="$(dirname "$(wrk_jobs_root)")"
  local command=(run_bounded 5 "$panewire" emit --kind "$kind" --job "$job" --report "$report"
    --owner-lane "$owner" --epoch 1 --label "$label" --host "$host" --pane "$pane"
    --report-last-line "$last" --inbox-root "$inbox_root")
  # Empty optionals are omitted rather than passed as empty strings.
  [[ -z "$reason" ]] || command+=(--reason "$reason")
  [[ -z "$question" ]] || command+=(--question "$question")
  [[ -z "$pr" ]] || command+=(--pr "$pr")
  [[ -z "$head" ]] || command+=(--head "$head")
  # `|| rc=$?` keeps a non-zero emit from tripping `set -e`; stdout is swallowed
  # so the caller's single OK line stays the only thing on it.
  "${command[@]}" >/dev/null 2>&1 || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    EMIT_RELAY_RC="$rc"
    warn "panewire emit failed (rc=$rc job=$job kind=$kind report=$report); relay event left as file only"
    record_emit_failure "$job" "$kind" "$rc"
  fi
  return 0
}

# record_emit_failure JOB KIND RC
#
# The record file already landed (emit_relay_event is only ever called after
# that); this durably marks that its *broadcast* to panewire did not, so
# "how many completions never got relayed" is answerable later from files
# alone, without touching panewire's own state. Append-only and best-effort:
# it must never be the thing that makes a fail-open path fail closed, so a
# write failure here is itself swallowed. Zero effect on the success path —
# nothing is written when rc=0.
record_emit_failure() {
  local job="$1" kind="$2" rc="$3" dir
  dir="$(wrk_jobs_root)/$job"
  mkdir -p "$dir" 2>/dev/null || return 0
  printf '%s kind=%s rc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$kind" "$rc" \
    >>"$dir/emit-failures.log" 2>/dev/null || true
  return 0
}

# Keep this exactly aligned with arbiter.inbox_root(): ARBITER_INBOX_ROOT is
# the jobs directory, rather than its parent. This is the environment-following
# root of everything outside the trust path (spawn, done, reap, prune, the
# sentinel); trust-bearing operations use wrk_trust_guard instead.
wrk_jobs_root() {
  printf '%s\n' "${ARBITER_INBOX_ROOT:-$HOME/work/herdr-inbox/jobs}"
}

# ── hk 1894: canonical trust paths ───────────────────────────────────────────
# The round cap, the grant check and the inherited-round read are only as
# trustworthy as the events inbox and the handoffkeep binary they read, and both
# used to follow the caller's environment: one variable redirected them (hk 1447
# r1 N3, r2 S3). A trust-bearing operation (wrk round open/verdict/void/status/
# audit, wrk joined, round_ext_precheck and its recheck, the takeover round
# read) calls wrk_trust_guard before its first read. The guard takes the inbox
# and the grant binary from the passwd home of the current uid, never from HOME,
# and refuses (rc 2, one stderr line naming the variable and the canonical path)
# when HOME, ARBITER_INBOX_ROOT, XDG_DATA_HOME or HANDOFFKEEP_BIN names anything
# else; the PATH lookup of handoffkeep is never used. WRK_TEST_MODE=1 (test
# suites only) honours overrides that resolve under a temp root and prints one
# warning line. This narrows, it does not bound: the same OS user can still edit
# files under the real home or set WRK_TEST_MODE with temp paths.
# The block between the markers is byte-identical in bin/arbiter (the shared
# test tests/test_wrk_trust_paths.py compares them), so one rule stands on both
# sides. It must hold no single quote: it lives in a single-quoted string.
WRK_TRUST_PY='
import os, pwd, shutil, stat, sys
# --- trust paths: begin (byte-identical in bin/wrk and bin/arbiter; tests/test_wrk_trust_paths.py compares them) ---
# hk 1894: where one trust-bearing operation may read its events inbox and its
# grant evidence. Needs os, shutil and stat from the host module. The canonical
# home is an argument (the passwd home of the uid, never HOME), so the unit tests
# decide without touching the real one.
TRUST_SYSTEM_TEMP_ROOTS = ("/tmp", "/private/tmp", "/var/folders")


class TrustRefusal(Exception):
    def __init__(self, var, canonical, detail):
        Exception.__init__(self, "%s; canonical path: %s" % (detail, canonical))
        self.var = var
        self.canonical = canonical
        self.detail = detail


def trust_value(env, name):
    value = env.get(name)
    return value if isinstance(value, str) and value else ""


def trust_under(path, root):
    return path == root or path.startswith(root.rstrip("/") + "/")


def trust_canonical(home):
    return {
        "inbox": os.path.join(home, "work", "herdr-inbox", "jobs"),
        "db": os.path.join(home, ".local", "share", "arbiter", "state.db"),
        "hk": os.path.join(home, ".local", "bin", "handoffkeep"),
    }


def trust_homes(home):
    # The passwd home as spelled and through realpath: a symlinked home reaches
    # the same places under both names.
    forms = [home] if home else []
    if home and os.path.realpath(home) != home:
        forms.append(os.path.realpath(home))
    return forms


def trust_temp_roots(env, home):
    roots = []
    tmpdir = trust_value(env, "TMPDIR")
    if tmpdir:
        resolved = os.path.realpath(tmpdir)
        # TMPDIR naming the filesystem root, the home or a parent of it would
        # make every path a temp path.
        if resolved != "/" and not any(trust_under(form, resolved) for form in trust_homes(home)):
            roots.append(resolved)
    for fixed in TRUST_SYSTEM_TEMP_ROOTS:
        for form in (fixed, os.path.realpath(fixed)):
            if form not in roots:
                roots.append(form)
    return roots


def trust_secure_binary(canonical, uid):
    resolved = os.path.realpath(canonical)
    try:
        info = os.stat(resolved)
    except OSError as exc:
        raise TrustRefusal("handoffkeep", canonical, "the canonical handoffkeep is unusable (%s): %s" % (resolved, exc.strerror or exc))
    if not stat.S_ISREG(info.st_mode):
        raise TrustRefusal("handoffkeep", canonical, "the canonical handoffkeep %s is not a regular file" % resolved)
    if info.st_uid != uid:
        raise TrustRefusal("handoffkeep", canonical, "the canonical handoffkeep %s is owned by uid %d, not uid %d" % (resolved, info.st_uid, uid))
    if info.st_mode & 0o022:
        raise TrustRefusal("handoffkeep", canonical, "the canonical handoffkeep %s is group- or world-writable (mode %04o)" % (resolved, info.st_mode & 0o7777))
    return resolved


def trust_resolve(env, home, uid, test_mode, need_hk, fixtures=""):
    """Return {"inbox", "db", "hk", "overrides"} or raise TrustRefusal.

    Outside test mode each lever (HOME, ARBITER_INBOX_ROOT, XDG_DATA_HOME,
    HANDOFFKEEP_BIN) must resolve to its canonical path under home, and the PATH
    lookup of handoffkeep is never used: the canonical binary must be a regular
    file owned by uid and not group- or world-writable. In test mode (a test
    suite only) no canonical path is consulted or resolved: every path in use
    must resolve under a temp root, the handoffkeep binary also under fixtures.
    """
    home_env = trust_value(env, "HOME")
    inbox_env = trust_value(env, "ARBITER_INBOX_ROOT")
    data_env = trust_value(env, "XDG_DATA_HOME")
    hk_env = trust_value(env, "HANDOFFKEEP_BIN")
    known = bool(home) and os.path.isabs(home)
    if not known and not test_mode:
        raise TrustRefusal("HOME", "(unknown)", "the passwd home of uid %d cannot be determined, so there is no canonical path to compare with" % uid)
    canon = trust_canonical(home) if known else {"inbox": None, "db": None, "hk": None}
    roots = trust_temp_roots(env, home if known else "") if test_mode else []
    hk_roots = list(roots)
    if test_mode and fixtures:
        hk_roots.append(os.path.realpath(fixtures))
    overrides = []

    def judge(var, effective, canonical, label, allowed):
        if any(ord(ch) < 32 or ord(ch) == 127 for ch in effective):
            raise TrustRefusal(var, canonical, "%s selects a %s path holding a control character" % (var, label))
        resolved = os.path.realpath(effective)
        if not test_mode:
            if resolved == os.path.realpath(canonical):
                return canonical
            raise TrustRefusal(var, canonical, "%s selects %s, which is not the canonical %s" % (var, effective, label))
        if not any(trust_under(resolved, root) for root in allowed):
            raise TrustRefusal(var, canonical, "%s selects %s, which resolves outside the temp roots (%s)" % (var, effective, " ".join(allowed)))
        if var not in overrides:
            overrides.append(var)
        return effective if os.path.isabs(effective) else resolved

    def under_home(*parts):
        if home_env:
            return os.path.join(home_env, *parts)
        if test_mode:
            raise TrustRefusal("HOME", canon["inbox"], "HOME is unset, so the default location would be the canonical path, which test mode never uses")
        return os.path.join(home, *parts)

    if home_env and not test_mode:
        judge("HOME", home_env, home, "home", ())
    inbox = judge("ARBITER_INBOX_ROOT" if inbox_env else "HOME",
                  inbox_env or under_home("work", "herdr-inbox", "jobs"), canon["inbox"], "inbox", roots)
    db = judge("XDG_DATA_HOME" if data_env else "HOME",
               os.path.join(data_env or under_home(".local", "share"), "arbiter", "state.db"), canon["db"], "arbiter DB", roots)
    hk = ""
    if need_hk:
        search = env.get("PATH") or os.defpath
        if test_mode:
            wanted = hk_env or "handoffkeep"
            found = wanted if "/" in wanted else (shutil.which(wanted, path=search) or "")
            if found:
                hk = judge("HANDOFFKEEP_BIN" if hk_env else "PATH", found, canon["hk"], "handoffkeep", hk_roots)
        else:
            if hk_env:
                found = hk_env if "/" in hk_env else (shutil.which(hk_env, path=search) or hk_env)
                judge("HANDOFFKEEP_BIN", found, canon["hk"], "handoffkeep", ())
            hk = trust_secure_binary(canon["hk"], uid)
    return {"inbox": inbox, "db": db, "hk": hk, "overrides": overrides}
# --- trust paths: end ---


def trust_main(argv):
    need_hk = len(argv) > 1 and argv[1] == "hk"
    test_mode = os.environ.get("WRK_TEST_MODE") == "1"
    try:
        home = pwd.getpwuid(os.getuid()).pw_dir
    except (KeyError, OSError):
        home = ""
    fixtures = ""
    if test_mode and len(argv) > 2 and argv[2]:
        candidate = os.path.join(os.path.dirname(os.path.realpath(argv[2])), "..", "tests", "fixtures")
        if os.path.isdir(candidate):
            fixtures = os.path.realpath(candidate)
    try:
        decision = trust_resolve(os.environ, home, os.getuid(), test_mode, need_hk, fixtures)
    except TrustRefusal as exc:
        sys.stderr.write("wrk: refusing a trust-bearing operation: %s\n" % exc)
        return 2
    sys.stdout.write("inbox=%s\nhk=%s\noverrides=%s\n" % (decision["inbox"], decision["hk"], " ".join(decision["overrides"])))
    return 0


if __name__ == "__main__":
    sys.exit(trust_main(sys.argv))
'

# Internal guard state. Assigned at load so a value inherited from the caller's
# environment can neither stand in for the guard (WRK_TRUST_JOBS_ROOT,
# WRK_TRUST_HK) nor silence the test-mode warning (WRK_TRUST_WARNED).
WRK_TRUST_JOBS_ROOT="" WRK_TRUST_HK="" WRK_TRUST_WARNED=""

# wrk_trust_guard [hk] — sets WRK_TRUST_JOBS_ROOT (and WRK_TRUST_HK when "hk" is
# passed: the operation will run handoffkeep) or exits 2. Trust-bearing reads use
# ${WRK_TRUST_JOBS_ROOT:?...} and WRK_TRUST_HK, never wrk_jobs_root or hk_bin, so a
# forgotten guard fails closed instead of following the environment. Call it from
# the main shell flow, not from inside a command substitution (the exit would only
# leave the subshell).
wrk_trust_guard() {
  local out line
  WRK_TRUST_JOBS_ROOT="" WRK_TRUST_HK=""
  out="$(python3 -c "$WRK_TRUST_PY" "${1:-}" "${BASH_SOURCE[0]}")" || exit 2
  while IFS= read -r line; do
    case "$line" in
      inbox=*) WRK_TRUST_JOBS_ROOT="${line#inbox=}" ;;
      hk=*) WRK_TRUST_HK="${line#hk=}" ;;
      overrides=?*)
        if [[ -z "${WRK_TRUST_WARNED:-}" ]]; then
          WRK_TRUST_WARNED=1
          warn "test mode honours overridden ${line#overrides=}; the canonical paths are not used"
        fi ;;
    esac
  done <<<"$out"
  [[ -n "$WRK_TRUST_JOBS_ROOT" ]] || exit 2
}

completion_metadata() {
  local job="$1" root
  # "trusted" (round open/verdict/void and joined, after wrk_trust_guard) reads the
  # guarded root; done and escalate keep following the environment.
  if [[ "${2:-}" == trusted ]]; then
    root="${WRK_TRUST_JOBS_ROOT:?trust guard did not run}"
  else
    root="$(wrk_jobs_root)"
  fi
  wrk_py - "$root/$job/events" <<'PY'
import json, os, sys
exec(os.environ["WRK_EVENTS_PY"])
owner=label=pane=parent=role=spawn_pane=''
for name, o, _ in wrk_events_ordered(sys.argv[1]):
    if o is None: continue
    p=o.get('payload',o)
    # Claim/reclaim establishes ownership.  Keep the newest one: a released
    # job can be reclaimed by a different builder and parent.
    if o.get('kind') in ('job.claim', 'job.reclaim'):
        owner=p.get('owner_lane') if isinstance(p.get('owner_lane'), str) else ''
        candidate=p.get('label', p.get('agent_label'))
        label=candidate if isinstance(candidate, str) else ''
        parent=p.get('parent_lane') if isinstance(p.get('parent_lane'), str) else ''
        role=p.get('role') if isinstance(p.get('role'), str) else ''
    pane=p.get('pane_id') if isinstance(p.get('pane_id'), str) else pane
    # hk1860: the newest job.spawned names this job's pane. A later stale
    # watcher's job.lost names an older pane, so it must not win. Any pane_id
    # stays the fallback for a stream with no usable spawn receipt.
    if o.get('kind') == 'job.spawned':
        candidate=p.get('pane_id')
        spawn_pane=candidate if isinstance(candidate, str) and candidate else ''
pane=spawn_pane or pane
if owner and label and pane: print(owner, label, pane, parent, role, sep='\t')
else: raise SystemExit(1)
PY
}

# Python is already a hard dependency for durable event creation above. Use it
# for report discovery and identity so this works on both GNU and BSD userlands
# (find -printf and stat -c are GNU-only). The identity includes nanosecond
# mtime and size, so an updated report at the same path is a new observation.
find_latest_report() {
  local directory="$1"
  python3 - "$directory" <<'PY'
import glob, os, sys
paths = []
try:
    for path in glob.glob(os.path.join(sys.argv[1], "report*.md")):
        if os.path.isfile(path):
            paths.append(path)
except OSError:
    pass
if paths:
    print(max(paths, key=os.path.getmtime))
PY
}

report_observation_key() {
  local report="$1"
  python3 - "$report" <<'PY'
import os, sys
try:
    info = os.stat(sys.argv[1])
except OSError:
    raise SystemExit(1)
print(f"{info.st_dev}:{info.st_ino}:{info.st_mtime_ns}:{info.st_size}")
PY
}

# #499: `panewire job done|escalate|joined` is the Go form of the three
# commands below and leaves byte-identical records, socket requests and output
# (pinned by panewire testdata/job_golden). wrk hands the call over only when
# the installed panewire proves it has that command: `panewire job probe` must
# print exactly the token below. A missing binary, an older panewire (rc 2, no
# output), any other output, or a probe that hangs keeps wrk's own path — the
# probe has no side effects, so falling back after it can never duplicate an
# event. The delegated call runs as a bounded subprocess — never exec — so
# wrk-side end housekeeping can still run after the record lands, and a
# failed or hung delegation falls back to wrk's own write path instead of
# losing the terminal record (#770 tester BLOCKER 1). WRK_JOB_DELEGATE=0
# forces wrk's own path (golden regeneration, rollback).
JOB_PROBE_TOKEN="panewire-job/1"
delegate_job_cmd() {
  local sub="$1" panewire probe
  shift
  [[ "${WRK_JOB_DELEGATE:-1}" != 0 ]] || return 0
  panewire="$(command -v "${PANEWIRE_BIN:-panewire}" 2>/dev/null || true)"
  [[ -n "$panewire" ]] || return 0
  local run_timeout="${WRK_JOB_DELEGATE_TIMEOUT_S:-30}"
  local prc=0
  probe="$(run_bounded 5 "$panewire" job probe 2>/dev/null </dev/null)" || prc=$?
  if [[ "$prc" -ne 0 ]]; then
    # A probe killed by its own guard means the daemon is wedged, not absent —
    # emit_relay_event must not re-enter it inside this same invocation.
    if [[ "$prc" == 124 ]]; then PANEWIRE_WEDGED=1; fi
    return 0
  fi
  [[ "$probe" == "$JOB_PROBE_TOKEN" ]] || return 0
  # HOSTNAME is a shell variable bash does not necessarily export; the records
  # carry wrk's value, so hand it over explicitly.
  local rc=0
  HOSTNAME="${HOSTNAME:-unknown}" run_bounded "$run_timeout" "$panewire" job "$sub" "$@" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    # #770 tester BLOCKER 1: the probe proved the binary understands the job
    # verbs — it did not prove the delegated call will succeed or even return.
    # A nonzero exit or a hang past the timeout must not take the terminal
    # record down with it: warn and return to the caller so wrk's own path
    # writes the same record. If the delegated write did land before dying,
    # the local path's completion dedup suppresses the second write. On a
    # timeout the daemon is wedged — mark it so emit_relay_event does not
    # stall this invocation on another doomed panewire call.
    if [[ "$rc" == 124 ]]; then PANEWIRE_WEDGED=1; fi
    warn "panewire job $sub delegation failed or timed out (rc=$rc); using wrk's own path"
    return 0
  fi
  # #770: a delegated terminal path still needs wrk-side housekeeping — the
  # delegated binary wrote the record, but only wrk on this host can stop the
  # completion sentinel and release the arbiter quota_pool record. Same as
  # the local path: run it after the record lands, never mask the result.
  if [[ "$sub" == "done" || "$sub" == "joined" ]]; then
    local d_job="${1:-}" d_meta="" d_owner="" d_pane=""
    if [[ -n "$d_job" && "$d_job" != -* ]]; then
      d_meta="$(completion_metadata "$d_job" 2>/dev/null || true)"
      IFS=$'\t' read -r d_owner _ d_pane _ _ <<<"$d_meta"
      job_end_housekeeping "$d_job" "$d_owner" "$sub" "panewire job $sub" "wrk $sub (delegated)" "$d_pane"
    fi
  fi
  exit "$rc"
}

# hk 1449: the filename of an end declaration that is later than the newest
# revive, or empty when the job is still open. End kinds are job.revoked,
# job.reaped and job.handed_off. Revive kinds are job.claim, job.reclaim and
# job.spawned. Order is wrk_events_ordered.
# hk 1894: ROOT is the checked inbox root. Trust-bearing callers (wrk joined,
# round open, void, verdict) pass ${WRK_TRUST_JOBS_ROOT:?}; with no ROOT the
# environment-following wrk_jobs_root is used, as before.
wrk_newer_end_record() {
  local job="$1" root="${2:-}"
  [[ -n "$root" ]] || root="$(wrk_jobs_root)"
  wrk_py - "$root/$job/events" <<'PY'
import os, sys
exec(os.environ["WRK_EVENTS_PY"])
print(wrk_end_declaration(sys.argv[1]))
PY
}

wrk_refuse_ended() {
  local what="$1" job="$2" root="${3:-}" end
  end="$(wrk_newer_end_record "$job" "$root")"
  [[ -z "$end" ]] || die "$what: refused after end record $end"
}

# Print zero-nonvoid-rounds, then unmatched<TAB>abspath lines. A tester
# verdict file is a regular file directly in the job directory whose first
# line is a round-verdict VERDICT line. A later line does not count.
# Symlinks and subdirectories are ignored.
# A job.verdict matches by absolute path or by content sha256.
wrk_join_blocks() {
  local job="$1" root="${2:-}"
  [[ -n "$root" ]] || root="$(wrk_jobs_root)"
  wrk_py - "$root/$job/events" "$root/$job" "$job" <<'PY'
import hashlib, os, stat, sys
exec(os.environ["WRK_EVENTS_PY"])
events, job_dir, job = sys.argv[1:]
_recorded, nonvoid = wrk_round_census(events, job)
if nonvoid <= 0:
    print("zero-nonvoid-rounds")
paths = set()
digests = set()
for _name, document, _mtime in wrk_events_ordered(events):
    if not isinstance(document, dict) or document.get("kind") != "job.verdict":
        continue
    recorded_path = document.get("path")
    if isinstance(recorded_path, str) and recorded_path:
        paths.add(os.path.abspath(recorded_path))
    recorded_digest = document.get("content_sha256")
    if isinstance(recorded_digest, str) and recorded_digest:
        digests.add(recorded_digest)
try:
    names = sorted(os.listdir(job_dir))
except OSError:
    names = []
for name in names:
    path = os.path.join(job_dir, name)
    try:
        info = os.lstat(path)
    except OSError:
        continue
    if not stat.S_ISREG(info.st_mode):
        continue
    try:
        data = open(path, "rb").read()
    except OSError:
        continue
    text = data.decode("utf-8", errors="replace")  # hk1900-utf8-replace
    lines = text.splitlines()
    if not lines or wrk_verdict_line.match(lines[0]) is None:  # hk1449-verdict-first-line
        continue
    digest = hashlib.sha256(data).hexdigest()
    absolute = os.path.abspath(path)
    if absolute in paths or digest in digests:
        continue
    print("unmatched\t" + absolute)
PY
}

wrk_joined_refuse_blocks() {
  local job="$1" root="${2:-}" blocks line tag rest zero=0
  local -a files=()
  blocks="$(wrk_join_blocks "$job" "$root")"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    tag="${line%%$'\t'*}"
    rest="${line#*$'\t'}"
    if [[ "$tag" == zero-nonvoid-rounds ]]; then
      zero=1
    elif [[ "$tag" == unmatched ]]; then
      files+=("$rest")
    fi
  done <<<"$blocks"
  [[ "$zero" -eq 0 && ${#files[@]} -eq 0 ]] && return 0
  local msg="" file
  if [[ "$zero" -eq 1 ]]; then
    msg="job $job has zero non-voided recorded rounds"
  fi
  # bash 3.2 with set -u rejects "${files[@]}" when the array is empty.
  for file in ${files[@]+"${files[@]}"}; do
    if [[ -n "$msg" ]]; then
      msg="$msg; unmatched tester verdict file $file"
    else
      msg="unmatched tester verdict file $file"
    fi
  done
  die "joined: $msg"
}

# One loud warning, once per done invocation, for a builder or captain whose
# wrk joined would refuse. Worker done stays silent. The command still succeeds.
wrk_builder_rounds_warning() {
  local job="$1" role="$2"
  case "$role" in
    builder|captain) ;;
    *) return 0 ;;
  esac
  local blocks line tag rest zero=0
  local -a files=()
  blocks="$(wrk_join_blocks "$job")"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    tag="${line%%$'\t'*}"
    rest="${line#*$'\t'}"
    if [[ "$tag" == zero-nonvoid-rounds ]]; then
      zero=1
    elif [[ "$tag" == unmatched ]]; then
      files+=("$rest")
    fi
  done <<<"$blocks"
  [[ "$zero" -eq 0 && ${#files[@]} -eq 0 ]] && return 0
  local msg="ROUNDS job=$job" file
  if [[ "$zero" -eq 1 ]]; then
    msg="$msg has zero non-voided recorded rounds"
  fi
  # Same bash 3.2 empty-array constraint as wrk_joined_refuse_blocks.
  for file in ${files[@]+"${files[@]}"}; do
    if [[ "$zero" -eq 1 || "$msg" == *"unmatched tester verdict file"* ]]; then
      msg="$msg; unmatched tester verdict file $file"
    else
      msg="$msg unmatched tester verdict file $file"
    fi
  done
  warn "$msg; wrk joined would refuse"
}

wrk_recorded_rounds() {
  local job="$1" root="${2:-}"
  [[ -n "$root" ]] || root="$(wrk_jobs_root)"
  wrk_py - "$root/$job/events" "$job" <<'PY'
import os, sys
exec(os.environ["WRK_EVENTS_PY"])
events, job = sys.argv[1:]
recorded, _nonvoid = wrk_round_census(events, job)
print(recorded)
PY
}

wrk_job_role() {
  local job="$1" root="${2:-}"
  [[ -n "$root" ]] || root="$(wrk_jobs_root)"
  wrk_py - "$root/$job/events" <<'PY'
import os, sys
exec(os.environ["WRK_EVENTS_PY"])
print(wrk_claim_role(sys.argv[1]))
PY
}

wrk_verdict_refusal() {
  local tag fname rest
  IFS=$'\t' read -r tag fname rest <<<"$1"
  case "$tag" in
    ENDED) die "round verdict: refused after end record $fname" ;;
    DUP_PATH) die "round verdict: verdict path already recorded as $fname: $rest" ;;
    DUP_CONTENT) die "round verdict: verdict content $rest already recorded as $fname" ;;
    DUP_HEAD) die "round verdict: head $rest already recorded as $fname" ;;
    *) die "round verdict unexpected outcome: $1" ;;
  esac
}

done_cmd() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    [[ $# -eq 1 ]] || die "unexpected argument '$2'"
    done_help
    return 0
  fi
  local job="${1:-}" report=""
  [[ -n "$job" && "$job" != -* ]] || die "done requires a job id"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --report) [[ $# -ge 2 && -n "$2" ]] || die "--report requires a path"; report="$2"; shift 2 ;;
      *) die "unknown done option '$1'" ;;
    esac
  done
  local metadata owner label pane role jobs_root
  metadata="$(completion_metadata "$job")" || die "done cannot find job.claim/job.spawned metadata: $job"
  # completion_metadata prints five tab-separated fields; reading into three
  # lets pane_id swallow parent_lane and role ("w1:p1\t\tworker" was recorded
  # on 2026-09-05), which is also what panewire routes on.
  IFS=$'\t' read -r owner label pane _ role <<<"$metadata"
  jobs_root="$(wrk_jobs_root)"
  if [[ -z "$report" ]]; then
    report="$(find_latest_report "$jobs_root/$job")"
  fi
  [[ -n "$report" && -f "$report" ]] || die "done requires an existing --report or report*.md in the job directory"
  # Warn once, before the duplicate branch and before delegation, so both
  # success paths say it exactly once. A builder done does not refuse.
  wrk_builder_rounds_warning "$job" "$role"
  # Decide the artifact path before delegating or uploading: a changed report
  # that reuses an earlier round's path is snapshot to <stem>-r<N>.md so its
  # outbox key is fresh. Delegation comes after resolution because
  # `panewire job done` records and emits whatever --report it is handed —
  # forwarding the caller's unchanged path would collide on the earlier
  # round's outbox key all over again (#1014 fix round).
  local resolution
  resolution="$(completion_event "$job" "$owner" "$label" "$pane" "$report" job.completed "" resolve)"
  if [[ "$resolution" == duplicate ]]; then
    note_duplicate_completion "$job" "$report"
    warn "job.completed already recorded for this report; suppressed duplicate (job=$job)"
    # #770: duplicate or not, done means the job is over — stop the sentinel
    # and settle the hub/arbiter records before returning.
    job_end_housekeeping "$job" "$owner" completed "wrk done (duplicate report)" "wrk done" "$pane"
    echo "OK job=$job report=$report"
    return 0
  fi
  [[ "$resolution" == resolved*$'\n'* ]] || die "done: unexpected resolve output: $resolution"
  report="${resolution#*$'\n'}"
  delegate_job_cmd 'done' "$job" --report "$report"
  upload_report_document "$job" "$report"
  local completion_out completion_status
  completion_out="$(completion_event "$job" "$owner" "$label" "$pane" "$report")"
  completion_status="${completion_out%%$'\n'*}"
  if [[ "$completion_status" == duplicate ]]; then
    # A racer (the completion sentinel, or a second done) recorded this exact
    # report between the resolve above and this write; its record stands.
    note_duplicate_completion "$job" "$report"
    warn "job.completed already recorded for this report; suppressed duplicate (job=$job)"
    job_end_housekeeping "$job" "$owner" completed "wrk done (duplicate report)" "wrk done" "$pane"
    echo "OK job=$job report=$report"
    return 0
  fi
  report="${completion_out#*$'\n'}"
  set_report_last_line "$report"
  emit_relay_event job.completed "$job" "$owner" "$label" "$pane" "${HOSTNAME:-unknown}" \
    "$report" "$EMIT_REPORT_LAST_LINE" "" "" "" ""
  local relay_suffix=""
  [[ "${EMIT_RELAY_RC:-0}" == 0 ]] || relay_suffix=" relay=file-only"
  # #770: end the hub job, release quota, and stop + wait on the completion
  # sentinel. Runs after the relay emit so the completed record is the first
  # thing panewire sees.
  job_end_housekeeping "$job" "$owner" completed "wrk done" "wrk done" "$pane"
  echo "OK job=$job report=$report$relay_suffix"
}

builder_flat_event() {
  local job="$1" owner="$2" label="$3" pane="$4" parent="$5" kind="$6" report="$7" reason="$8" question="$9" pr="${10}" head="${11}" waived="${12:-}" waiver_issuer="${13:-}" check_parent="${14:-}" check_task="${15:-}" check_version="${16:-}"
  local events host="${HOSTNAME:-unknown}" last
  events="$(wrk_jobs_root)/$job/events"
  mkdir -p "$events"
  if [[ -n "$report" && -f "$report" ]]; then
    last="$(tail -n 1 "$report" 2>/dev/null | tr '\r\n' ' ' | cut -c1-240)"
    last="$(append_document_suffix "$last")"
  else
    last=""
  fi
  # hk 1900: a refused job.joined prints its reason on stdout and exits 3 (end
  # record) or 4 (zero non-voided rounds) before it writes anything. Bash 3.2
  # scans this heredoc for quotes because it sits inside a command substitution.
  # Do not put an unmatched single quote in this body.
  local outcome rc=0
  outcome="$(wrk_py - "$events" "$job" "$owner" "$label" "$pane" "$parent" "$host" "$report" "$last" "$kind" "$reason" "$question" "$pr" "$head" "$waived" "$waiver_issuer" "$check_parent" "$check_task" "$check_version" <<'PY'
import json, os, sys, tempfile
exec(os.environ["WRK_EVENTS_PY"])
events, job, owner, label, pane, parent, host, report, last, kind, reason, question, pr, head, waived, waiver_issuer, check_parent, check_task, check_version = sys.argv[1:]
# wrk escalate/joined publish outside the round writer lock: take the shared
# events lock so numbering is serialized with bin/arbiter and wrk done too.
lock = wrk_events_locked(events)
if kind == "job.joined":
    # The pre-check in joined_cmd ran before this lock; recheck under it.
    wrk_precommit_test_hook(events, job)
    ended = wrk_end_declaration(events)
    if ended:  # hk1900-inlock-end
        print("ENDED\t" + ended)
        sys.exit(3)
    if waived:  # hk2024-claim-recheck
        changed = wrk_joined_claim_change(events, check_parent, check_task, check_version)
        if changed:
            print("CLAIM\t" + changed)
            sys.exit(5)
    if not waived and wrk_round_census(events, job)[1] <= 0:  # hk1900-inlock-zero
        print("ZERO")
        sys.exit(4)
record = {"kind": kind, "job_id": job, "owner_lane": owner, "label": label,
          "pane_id": pane, "host": host, "report_path": report,
          "report_last_line": last, "reason": reason, "parent_lane": parent, "epoch": 1}
if question: record["question"] = question
if pr: record["pr"] = pr
if head: record["head"] = head
if waived: record["rounds_waived"] = waived
if waiver_issuer: record["rounds_waived_issuer"] = waiver_issuer
wrk_event_commit(events, kind, record)
PY
)" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    [[ -z "$outcome" ]] || printf '%s\n' "$outcome"
    return "$rc"
  fi
}

builder_metadata() {
  local job="$1" metadata owner label pane parent role
  metadata="$(completion_metadata "$job" "${2:-}")" || die "cannot find job.claim/job.spawned metadata: $job"
  IFS=$'\t' read -r owner label pane parent role <<<"$metadata"
  case "$role" in builder|captain) ;; *) die "$job is not a builder claim with a parent lane (legacy captain alias is accepted)" ;; esac
  [[ -n "$parent" ]] || die "$job is not a builder claim with a parent lane (legacy captain alias is accepted)"
  # owner_lane is the builder's own lane. parent_lane is informational only;
  # panewire resolves the parent relationship from lanes.json.
  printf '%s\t%s\t%s\t%s\t%s\n' "$owner" "$label" "$pane" "$parent" "$role"
}

escalate_cmd() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    [[ $# -eq 1 ]] || die "unexpected argument '$2'"
    escalate_help
    return 0
  fi
  delegate_job_cmd escalate "$@"
  local job="${1:-}" question="" report="" metadata owner label pane parent role reason
  [[ -n "$job" && "$job" != -* ]] || die "escalate requires a job id"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --question) [[ $# -ge 2 && -n "$2" ]] || die "--question requires text"; question="$2"; shift 2 ;;
      --report) [[ $# -ge 2 && -n "$2" ]] || die "--report requires a path"; report="$2"; shift 2 ;;
      *) die "unknown escalate option '$1'" ;;
    esac
  done
  [[ -n "$question" ]] || die "escalate requires --question"
  [[ -z "$report" || -f "$report" ]] || die "escalate requires an existing --report"
  metadata="$(builder_metadata "$job")"
  IFS=$'\t' read -r owner label pane parent role <<<"$metadata"
  reason="builder escalation"
  [[ "$role" == captain ]] && reason="captain escalation"
  [[ -z "$report" ]] || upload_report_document "$job" "$report"
  builder_flat_event "$job" "$owner" "$label" "$pane" "$parent" job.escalate "$report" "$reason" "$question" "" ""
  set_report_last_line "$report"
  emit_relay_event job.escalate "$job" "$owner" "$label" "$pane" "${HOSTNAME:-unknown}" \
    "$report" "$EMIT_REPORT_LAST_LINE" "$reason" "$question" "" ""
  echo "OK job=$job owner_lane=$owner kind=job.escalate"
}

joined_cmd() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    [[ $# -eq 1 ]] || die "unexpected argument '$2'"
    joined_help
    return 0
  fi
  local job="${1:-}" pr="" head="" report="" waived=""
  [[ -n "$job" && "$job" != -* ]] || die "joined requires a job id"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pr) [[ $# -ge 2 && -n "$2" ]] || die "--pr requires a URL"; pr="$2"; shift 2 ;;
      --head) [[ $# -ge 2 && -n "$2" ]] || die "--head requires a SHA"; head="$2"; shift 2 ;;
      --report) [[ $# -ge 2 && -n "$2" ]] || die "--report requires a path"; report="$2"; shift 2 ;;
      --rounds-waived)
        [[ $# -ge 2 && -n "$2" ]] || die "joined: --rounds-waived requires hk:doc/<key> or hk:task/<id>"
        waived="$2"; shift 2 ;;
      -h|--help) die "unexpected argument '$1'" ;;
      *) die "unknown joined option '$1'" ;;
    esac
  done
  [[ -n "$pr" && -n "$head" && -n "$report" && -f "$report" ]] || die "joined requires --pr, --head and an existing --report"
  if [[ -n "$waived" ]]; then
    [[ "$waived" =~ ^hk:doc/[^[:space:]]+$ || "$waived" =~ ^hk:task/[0-9]+$ ]] || die "joined: --rounds-waived requires hk:doc/<key> or hk:task/<id>"  # hk1899-waiver-shape
  fi
  local metadata owner label pane parent role reason joined_end
  local waiver_issuer="" waiver_grant tmp_waiver task_id tmp_task
  local claim_parent="" claim_task="" claim_version=""
  # hk 1894: the join gate (end record, rounds, verdict files) and the parent
  # lane are read from the checked inbox, never from the environment. hk 1899:
  # a waiver is fetched from handoffkeep, so that guard also judges the binary.
  if [[ -n "$waived" ]]; then wrk_trust_guard hk; else wrk_trust_guard; fi
  metadata="$(builder_metadata "$job" trusted)"
  IFS=$'\t' read -r owner label pane parent role <<<"$metadata"
  reason="builder joined PR"
  [[ "$role" == captain ]] && reason="captain joined PR"
  # hk1449-joined-end
  joined_end="$(wrk_newer_end_record "$job" "${WRK_TRUST_JOBS_ROOT:?trust guard did not run}")"
  [[ -z "$joined_end" ]] || die "joined: refused after end record $joined_end"
  # hk 1899: a waiver counts only with a join-waiver grant for this job in a
  # record fetched from handoffkeep, issued by the parent lane or an operator
  # and equal to the record's server-set identity. Verified here, before the
  # refusals are skipped and before the events lock is taken.
  if [[ -n "$waived" ]]; then
    # hk 2024: keep the claim facts the waiver is verified against — parent
    # lane, task_id and the newest claim/reclaim event — so the commit under
    # the events lock can refuse a job released and reclaimed in between.
    claim_parent="$parent"  # hk2024-claim-facts
    claim_task="$(round_job_task_id "$job" || true)"
    claim_version="$(joined_claim_version "$job")"
    tmp_waiver="$(mktemp)"
    if ! round_approval_fetch "$waived" >"$tmp_waiver"; then
      rm -f "$tmp_waiver"
      die "joined: waiver record not found in handoffkeep: $waived"
    fi
    waiver_grant="$(round_approval_verify "$waived" "$job" "$parent" "$ROUND_CAP_OPERATORS" "$ROUND_CAP_PARENT_ISSUERS" "$tmp_waiver" join-waiver || true)"  # hk1899-waiver-fetch
    rm -f "$tmp_waiver"
    [[ -n "$waiver_grant" ]] ||
      die "joined: $waived has no 'join-waiver: job=$job by=<parent-lane|operator>' grant backed by the record's server-set created_by (doc) or comment author (task)"
    waiver_issuer="${waiver_grant##*issuer=}"
    if [[ "$waiver_issuer" == "pa-integrator" ]]; then
      task_id="$claim_task"
      [[ -n "$task_id" ]] ||
        die "joined: pa-integrator grants need the job's hk task on the server; $job records no task_id"
      tmp_task="$(mktemp)"
      if ! round_pa_task_fetch "$task_id" >"$tmp_task"; then
        rm -f "$tmp_task"
        die "joined: pa-integrator grants need the job's hk task on the server; cannot fetch task $task_id"
      fi
      if ! round_pa_task_verify "$job" "$tmp_task"; then
        rm -f "$tmp_task"
        die "joined: pa-integrator grants count only when the server task for $job is project ParkingArcade with refs.job_id=$job"
      fi
      rm -f "$tmp_task"
    fi
  fi
  # A waiver is recorded on wrk's own job.joined, so it must not be forwarded
  # and must not take the delegated path. Without it, delegate exactly as before.
  if [[ -z "$waived" ]]; then
    wrk_joined_refuse_blocks "$job" "${WRK_TRUST_JOBS_ROOT:?trust guard did not run}"
    delegate_job_cmd joined "$job" --pr "$pr" --head "$head" --report "$report"
  fi
  upload_report_document "$job" "$report"
  # #770 tester BLOCKER 1: when the delegated `panewire job joined` landed the
  # record and then failed, the fallback arrives with job.joined already the
  # newest work-terminal — appending again would duplicate it. Same shape as
  # done's duplicate branch: warn, skip the write+emit, still settle the job.
  local joined_term
  joined_term="$(job_events_scan "${WRK_TRUST_JOBS_ROOT:?trust guard did not run}/$job/events" 2>/dev/null | awk -F'\t' '{print $4}')"
  if [[ "$joined_term" == "job.joined" ]]; then
    warn "job.joined already recorded for $job; suppressed duplicate"
    job_end_housekeeping "$job" "$owner" joined "wrk joined (duplicate)" "wrk joined" "$pane"
    echo "OK job=$job owner_lane=$owner kind=job.joined pr=$pr head=$head report=$report"
    return 0
  fi
  local flat_out flat_rc=0
  flat_out="$(builder_flat_event "$job" "$owner" "$label" "$pane" "$parent" job.joined "$report" "$reason" "" "$pr" "$head" "$waived" "$waiver_issuer" "$claim_parent" "$claim_task" "$claim_version")" || flat_rc=$?
  case "$flat_rc" in
    0) ;;
    3) die "joined: refused after end record ${flat_out#*$'\t'}" ;;
    4) die "joined: job $job has zero non-voided recorded rounds" ;;
    5) die "joined: claim changed since the waiver was verified (${flat_out#*$'\t'}); re-run wrk joined" ;;
    *) exit "$flat_rc" ;;
  esac
  set_report_last_line "$report"
  emit_relay_event job.joined "$job" "$owner" "$label" "$pane" "${HOSTNAME:-unknown}" \
    "$report" "$EMIT_REPORT_LAST_LINE" "$reason" "" "$pr" "$head"
  # #770: job.joined is a work-terminal but not a hub-terminal — the hub keeps
  # counting the job until the end declaration lands, and the completion
  # sentinel must not outlive the join.
  job_end_housekeeping "$job" "$owner" joined "wrk joined" "wrk joined" "$pane"
  echo "OK job=$job owner_lane=$owner kind=job.joined pr=$pr head=$head report=$report"
}

# ── #758: formal tester-round counting and the per-job round cap ────────────
#
# One formal tester round is one tester verdict recorded for one head. The
# count lives ONLY in the job's events/ stream: a round starts with a
# `job.round` record (wrk round open) and its verdict lands as a `job.verdict`
# record bound to it (wrk round verdict). Rounds are numbered by wrk, so
# sub-round names like r5b cannot exist — every open increments the count,
# and a verdict that binds to no open round still counts as a round of its
# own. The builder's head does not reset the count: rounds are per job, not
# per head.
ROUND_CAP_DEFAULT=3
# Operator identities allowed to issue a round-cap extension approval.
# Space-separated; the job's parent lane is accepted on top of these only
# when it is in ROUND_CAP_PARENT_ISSUERS.
# Fixed in the source: a builder must not be able to widen the trusted issuer
# set through its own environment, or it could approve its own records.
ROUND_CAP_OPERATORS="operator operator-desk"
# Parent lanes accepted as the job's parent issuer on top of the operator
# set. The recorded parent lane is builder-writable through
# job.claim/job.reclaim events, so it is honoured only inside this fixed
# set — a rewritten parent, a host or client id, or a builder lane never
# grants. Fixed in the source for the same reason as the operator set.
ROUND_CAP_PARENT_ISSUERS="director-1 pa-integrator"
ROUND_CAP_REASON="tester round cap reached"

round_help() {
  cat <<'USAGE'
Usage: wrk round <open|verdict|void|status|audit> [JOB] [options]

Formal tester-round bookkeeping for a builder job (#758). A formal round is
one tester verdict recorded for one head. The count is taken only from the
job's events/ stream (job.round, job.verdict and job.round_void records), so renamed or
sub-rounds (r5b) cannot hide: wrk numbers every round itself.

  wrk round open JOB --head SHA [--extend REF] [--repo PATH]
      Open the next tester round for JOB (a builder job). At the cap
      (default 3 rounds per job) the open is refused with exit 78 and one
      job.escalate naming the job, head, last verdict and findings path is
      emitted to the parent lane; the builder must stop and wait. Past the
      cap an open is allowed only with --extend REF, where REF is
      hk:doc/<key> or hk:task/<id> of an approval record fetched from
      handoffkeep that names the job and the number of extra rounds on a
      grant line:

        round-extension: job=JOB extra=N by=ISSUER

      ISSUER must equal the record's server-set identity: created_by for an
      hk:doc (the client-supplied session field is never trusted) or the
      comment author for an hk:task. A doc with no created_by cannot grant.
      Grants need the server-set identity of operator, operator-desk,
      director-1 or pa-integrator — the last two only as the job's parent
      lane — whose tokens live only in the mbp lane wrappers. The job's
      recorded parent lane is not trusted beyond that fixed set.
      A by=pa-integrator grant counts only on ParkingArcade tasks bound to
      the job on the server (refs.job_id must equal the job); task project
      and refs are writable by any hk client, so this narrows, not bounds.
      Caveat: the mbp lane wrappers run as the same OS user as every mbp
      pane, so this narrows grant forgery to mbp-resident sessions but is
      not a boundary; hk 525 is the long-term fix.
      Each grant covers <extra> more opens and each open consumes exactly one.
      Before opening, wrk checks HEAD^{commit} in the repo from the newest
      job.claim/job.reclaim repo, worktree or cwd field. If none is usable,
      pass --repo PATH. A missing commit triggers one bounded fetch of origin.
  wrk round verdict JOB --file PATH
      Record the tester's verdict file. It binds to the oldest open round on its own head and is refused when there is none.
      PATH must contain a line 'VERDICT: PASS|BLOCKER @<40-hex sha>'.
      The record stores that file's content sha256 beside its path. A later
      verdict is refused when the path, those exact bytes, or that head was
      already recorded for this job. A repeated head is allowed only when
      the round that held the earlier verdict was voided.
  wrk round status JOB
      Print one line: job=… rounds=N cap=N open=… last_verdict=… and any
      voided rounds as 'round N void (hk:doc/…)' or 'round N void (hk:task/…)'.
  wrk round audit [--lane LANE]
      Read-only. Print one line per builder job that is not ended and has
      zero recorded rounds, and one line per job directory that holds a
      tester verdict file with no matching job.verdict. --lane keeps only
      that owner lane. Writes nothing.
  wrk round void JOB N --by REF [--reason TEXT]
      Void an existing round without a verdict, using a matching round-void
      grant in hk:doc/<key> or hk:task/<id>. The grant line is the default
      reason; --reason overrides it. Voids release one cap slot.

Trust paths (hk 1894). These commands, wrk joined (its end check and round
gate), the --round-ext prechecks and the takeover round read take the events
inbox (<home>/work/herdr-inbox/jobs), the arbiter DB
(<home>/.local/share/arbiter/state.db) and the grant-fetching handoffkeep
(<home>/.local/bin/handoffkeep: a regular file owned by the user, not group- or
world-writable) from the passwd home of the current user, never from $HOME.
HOME, ARBITER_INBOX_ROOT, XDG_DATA_HOME or HANDOFFKEEP_BIN naming anything else
is refused with exit 2 (one line naming the variable and the canonical path);
PATH is never searched for handoffkeep. WRK_TEST_MODE=1 is for
the test suites: it honours overrides that resolve under a temp root and warns
once. This narrows, it does not bound: the same OS user can still edit files
under the real home or set WRK_TEST_MODE with temp paths.
USAGE
}

# Resolve the job repository from its newest claim/reclaim metadata. A usable
# recorded repo/worktree/cwd takes precedence over the command-line fallback.
round_repo_resolve() {
  local job="$1" fallback="$2"
  wrk_py - "${WRK_TRUST_JOBS_ROOT:?trust guard did not run}/$job/events" "$fallback" <<'PY'
import json, os, subprocess, sys
exec(os.environ["WRK_EVENTS_PY"])
events, fallback = sys.argv[1:]
latest = None
for name, o, _ in wrk_events_ordered(events):
    if o is None:
        continue
    if o.get('kind') in ('job.claim', 'job.reclaim'):
        latest = o.get('payload', o)

def repo_root(path):
    try:
        result = subprocess.run(
            ['git', '-C', path, 'rev-parse', '--show-toplevel'],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            text=True, timeout=5, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    root = result.stdout.strip()
    return os.path.realpath(root) if root else None

if isinstance(latest, dict):
    for field in ('repo', 'worktree', 'cwd'):
        value = latest.get(field)
        if isinstance(value, str) and value.strip():
            root = repo_root(os.path.expanduser(value.strip()))
            if root:
                print(root)
                raise SystemExit(0)
if fallback:
    root = repo_root(os.path.expanduser(fallback))
    if root:
        print(root)
        raise SystemExit(0)
raise SystemExit(1)
PY
}

# Check a full SHA as a commit. A missing local object gets one bounded fetch
# from origin, then one final check. argv is fixed and no shell evaluates SHA.
round_head_check() {
  local repo="$1" head="$2"
  python3 - "$repo" "$head" <<'PY'
import os, subprocess, sys
repo, head = sys.argv[1:]
env = os.environ.copy()
env['GIT_TERMINAL_PROMPT'] = '0'

def run(args, timeout):
    try:
        return subprocess.run(args, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, env=env,
                              timeout=timeout, check=False).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False

check = ['git', '-C', repo, 'cat-file', '-e', head + '^{commit}']
if run(check, 10):
    raise SystemExit(0)
run(['git', '-C', repo, 'fetch', 'origin'], 30)
raise SystemExit(0 if run(check, 10) else 1)
PY
}

# Scan the job's events stream once and emit one TSV line of key=value fields
# the round commands need, including the effective voids and their refs.
round_scan() {
  local job="$1"
  wrk_py - "${WRK_TRUST_JOBS_ROOT:?trust guard did not run}/$job/events" <<'PY'
import json, os, sys
exec(os.environ["WRK_EVENTS_PY"])
events = sys.argv[1]
rounds = []          # job.round records in event-time order
verdicts = []        # job.verdict records in event-time order
voids = []            # job.round_void records in event-time order
for name, o, _ in wrk_events_ordered(events):
    if o is None:
        continue
    if o.get("kind") == "job.round":
        rounds.append(o)
    elif o.get("kind") == "job.verdict":
        verdicts.append(o)
    elif o.get("kind") == "job.round_void":
        voids.append(o)
bound = {v.get("round") for v in verdicts if isinstance(v.get("round"), int)}
round_numbers = {r.get("round") for r in rounds
                 if isinstance(r.get("round"), int)}
voided = {}
for v in voids:
    n, ref = v.get("round"), v.get("ref")
    if (v.get("job_id") == os.path.basename(os.path.dirname(events))
            and isinstance(n, int) and n in round_numbers and n not in bound
            and isinstance(ref, str) and ref.startswith(("hk:doc/", "hk:task/"))):
        voided[n] = ref
open_rounds = [str(r.get("round")) for r in rounds
               if isinstance(r.get("round"), int) and r.get("round") not in bound
               and r.get("round") not in voided]
used = sum(1 for r in rounds
           if not (isinstance(r.get("round"), int) and r.get("round") in voided))
used += sum(1 for v in verdicts if not isinstance(v.get("round"), int))
used += wrk_takeover_rounds(events)
last = verdicts[-1] if verdicts else {}
lv = "-"
if last.get("verdict") and last.get("head"):
    lv = "%s@%s" % (last["verdict"], last["head"])
lf = last.get("path") or "-"
voided_text = ",".join("round %d void (%s)" % item for item in sorted(voided.items())) or "-"
print("rounds=%d\topen=%s\tlast_verdict=%s\tlast_findings=%s\tvoided=%s" %
      (used, ",".join(open_rounds) if open_rounds else "-", lv, lf, voided_text))
PY
}

# Fetch an approval record from handoffkeep. Echoes the raw record text
# (JSON) on stdout; non-zero when the record is absent or handoffkeep fails.
round_approval_fetch() {
  local ref="$1" handoffkeep out rc=0
  # hk 1894: the binary wrk_trust_guard chose (the canonical one outside test
  # mode); never HANDOFFKEEP_BIN or a PATH lookup.
  handoffkeep="${WRK_TRUST_HK:-}"
  [[ -n "$handoffkeep" && -x "$handoffkeep" ]] || return 1
  case "$ref" in
    hk:doc/?*)  out="$("$handoffkeep" doc get "${ref#hk:doc/}" 2>/dev/null)" || rc=$? ;;
    hk:task/?*) out="$("$handoffkeep" tasks comments "${ref#hk:task/}" 2>/dev/null)" || rc=$? ;;
    *) return 2 ;;
  esac
  [[ "$rc" -eq 0 && -n "$out" && "$out" != not_found ]] || return 1
  printf '%s' "$out"
}

# Verify a fetched round approval record for the grant type and optional round.
# Args: ref, job, parent lane, operators, trusted parent lanes (both space
# separated), record file, grant type (default round-extension), round number.
# Prints "granted=<N> issuer=<name>" — nothing else — on success.
round_approval_verify() {
  local ref="$1" job="$2" parent="$3" operators="$4" parent_issuers="$5" record="$6"
  local grant_kind="${7:-round-extension}" round_number="${8:-}"
  python3 - "$ref" "$job" "$parent" "$operators" "$parent_issuers" "$record" "$grant_kind" "$round_number" <<'PY'
import json, re, sys
ref, job, parent, operators, parent_issuers, path, grant_kind, round_number = sys.argv[1:]
ops = set(operators.split())
trusted_parents = set(parent_issuers.split())
try:
    with open(path, encoding="utf-8") as f:
        raw = f.read()
except OSError:
    raise SystemExit(1)
try:
    doc = json.loads(raw)
except ValueError:
    raise SystemExit(1)
# Each grant type has one canonical line form; whitespace variants are
# malformed and rejected. The identity and parent-lane checks below are
# shared by round extensions, voids and join waivers.
if grant_kind == "round-extension":
    GRANT = re.compile(r"^round-extension: job=(\S+) extra=(\d+) by=(\S+)$")
elif grant_kind == "round-void":
    GRANT = re.compile(r"^round-void: job=(\S+) round=(\d+) by=(\S+)$")
elif grant_kind == "join-waiver":
    GRANT = re.compile(r"^join-waiver: job=(\S+) by=(\S+)$")
else:
    raise SystemExit(1)
# The issuer written into the grant line must equal the record's server-set
# identity — a doc's created_by (stamped from the bearer token; the
# client-supplied session field is ignored) or a task comment's author — so a
# builder writing 'by=director-1' into its own record cannot pass, and one
# identity cannot claim another. A doc with no created_by yields an empty
# identity and can never grant.
sources = []
if ref.startswith("hk:doc/"):
    if isinstance(doc, dict):
        sources.append((doc.get("created_by") or "", doc.get("body") or ""))
elif ref.startswith("hk:task/"):
    for c in (doc.get("comments") if isinstance(doc, dict) else None) or []:
        if isinstance(c, dict):
            sources.append((c.get("author") or "", c.get("body") or ""))
# The recorded parent lane counts only inside the fixed parent set:
# claim/reclaim events are builder-writable, so any other value — a host or
# client id included — is not a trusted issuer even when it matches the
# grant's server-set identity.
allowed_issuers = ({parent} & trusted_parents) | ops
for identity, body in sources:
    for line in body.splitlines():
        m = GRANT.match(line)
        if not m or m.group(1) != job:
            continue
        if grant_kind == "join-waiver":
            amount, issuer = 1, m.group(2)
        else:
            amount, issuer = int(m.group(2)), m.group(3)
        if (grant_kind == "round-extension" and amount < 1) or (
                grant_kind == "round-void" and str(amount) != round_number):
            continue
        if issuer not in allowed_issuers or issuer != identity:
            continue
        print("granted=%d issuer=%s" %
              (amount if grant_kind == "round-extension" else 1, issuer))
        raise SystemExit(0)
raise SystemExit(1)
PY
}

# The job's recorded task id, taken the same way as task linkage: the newest
# claim/reclaim payload.task_id. Prints it or nothing; rc 1 when the meta is
# unreadable so a broken record fails closed instead of falling back to an
# older claim the newest event superseded.
round_job_task_id() {
  wrk_py - "${WRK_TRUST_JOBS_ROOT:?trust guard did not run}/$1/events" <<'PY'
import json, os, sys
exec(os.environ["WRK_EVENTS_PY"])
names = [name for name, _, _ in wrk_events_ordered(sys.argv[1])
         if name.endswith(("claim.json", "reclaim.json"))]
if not names:
    raise SystemExit(0)
try:
    with open(os.path.join(sys.argv[1], names[-1]), encoding="utf-8") as f:
        o = json.load(f)
except (OSError, ValueError):
    raise SystemExit(1)
p = o.get("payload", o)
v = p.get("task_id")
print(v if isinstance(v, (int, str)) else "")
PY
}

# The job's newest claim/reclaim event file name, taken the same way as
# round_job_task_id: the claim version a verified join waiver binds to.
# Prints it or nothing when there is no claim.
joined_claim_version() {
  wrk_py - "${WRK_TRUST_JOBS_ROOT:?trust guard did not run}/$1/events" <<'PY'
import os, sys
exec(os.environ["WRK_EVENTS_PY"])
names = [name for name, _, _ in wrk_events_ordered(sys.argv[1])
         if name.endswith(("claim.json", "reclaim.json"))]
print(names[-1] if names else "")
PY
}

# Fetch the job's hk task record from the server. Echoes the raw record text
# (JSON) on stdout; non-zero when the record is absent or handoffkeep fails.
round_pa_task_fetch() {
  local task_id="$1" handoffkeep out rc=0
  handoffkeep="${WRK_TRUST_HK:-}"
  [[ -n "$handoffkeep" && -x "$handoffkeep" ]] || return 1
  out="$("$handoffkeep" tasks show "$task_id" 2>/dev/null)" || rc=$?
  [[ "$rc" -eq 0 && -n "$out" && "$out" != not_found ]] || return 1
  printf '%s' "$out"
}

# Verify a fetched task record pins a pa-integrator grant to ParkingArcade
# work: project must be exactly "ParkingArcade" and refs.job_id exactly the
# job being extended. Prints nothing; rc 0 only when both hold.
round_pa_task_verify() {
  local job="$1" record="$2"
  python3 - "$job" "$record" <<'PY'
import json, sys
job, path = sys.argv[1:]
try:
    with open(path, encoding="utf-8") as f:
        t = json.load(f)
except (OSError, ValueError):
    raise SystemExit(1)
refs = t.get("refs") if isinstance(t, dict) else None
if (isinstance(t, dict) and t.get("project") == "ParkingArcade"
        and isinstance(refs, dict) and refs.get("job_id") == job):
    raise SystemExit(0)
raise SystemExit(1)
PY
}

# Emit the round-cap job.escalate (once per job — a repeated refusal must not
# spam the parent lane; #745 was a STOP that sat unread). Prints TSV:
#   emitted\trounds=<N>\tlast_verdict=<v@sha|->\tfindings=<path|->
# or the single token 'duplicate'.
round_cap_event() {
  local job="$1" owner="$2" label="$3" pane="$4" parent="$5" head="$6" cap="$7"
  local events
  events="${WRK_TRUST_JOBS_ROOT:?trust guard did not run}/$job/events"
  mkdir -p "$events"
  wrk_py - "$events" "$job" "$owner" "$label" "$pane" "$parent" "${HOSTNAME:-unknown}" "$head" "$cap" <<'PY'
import fcntl, json, os, sys, tempfile
exec(os.environ["WRK_EVENTS_PY"])
events, job, owner, label, pane, parent, host, head, cap = sys.argv[1:]
cap = int(cap)
lock_path = os.path.join(os.path.dirname(events), ".wrk-events.lock")
with open(lock_path, "w", encoding="utf-8") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    # All state is read under the lock: a stale snapshot would let two racing
    # refusals each think they are first, and a rounds count read before the
    # lock could hide that an extension grant added rounds since.
    records = [o for _, o, _ in wrk_events_ordered(events) if o is not None]
    rounds = [r for r in records if r.get("kind") == "job.round"]
    verdicts = [r for r in records if r.get("kind") == "job.verdict"]
    voids = [r for r in records if r.get("kind") == "job.round_void"]
    bound = {v.get("round") for v in verdicts if isinstance(v.get("round"), int)}
    round_numbers = {r.get("round") for r in rounds
                     if isinstance(r.get("round"), int)}
    voided = {v.get("round") for v in voids
              if (v.get("job_id") == job and isinstance(v.get("round"), int)
                  and v.get("round") in round_numbers and v.get("round") not in bound
                  and isinstance(v.get("ref"), str)
                  and v["ref"].startswith(("hk:doc/", "hk:task/")))}
    used = sum(1 for r in rounds
               if not (isinstance(r.get("round"), int) and r.get("round") in voided))
    used += sum(1 for r in verdicts if not isinstance(r.get("round"), int))
    used += wrk_takeover_rounds(events)
    last = verdicts[-1] if verdicts else {}
    lv = "-"
    if last.get("verdict") and last.get("head"):
        lv = "%s@%s" % (last["verdict"], last["head"])
    findings = last.get("path") or ""
    # Dedupe is scoped to the rounds count: a repeated refusal at the same
    # count is a duplicate, but a refusal at a higher count — rounds an
    # extension grant added since the last escalate — is a new signal the
    # parent must see. #745 was a stop nobody read.
    for r in records:
        if (r.get("kind") == "job.escalate"
                and r.get("reason") == "tester round cap reached"
                and isinstance(r.get("rounds"), int) and r["rounds"] >= used):
            print("duplicate")
            raise SystemExit(0)
    question = ("tester round cap %d reached at %d rounds; builder must stop "
                "and wait for the parent; extension needs a hk approval "
                "record naming this job (wrk round open --extend REF)"
                % (cap, used))
    record = {"kind": "job.escalate", "job_id": job, "owner_lane": owner,
              "label": label, "pane_id": pane, "host": host,
              "report_path": findings, "report_last_line": lv,
              "reason": "tester round cap reached", "question": question,
              "parent_lane": parent, "head": head, "rounds": used,
              "cap": cap, "last_verdict": lv, "findings_path": findings,
              "epoch": 1}
    wrk_event_commit(events, "job.escalate", record)
print("emitted\trounds=%d\tlast_verdict=%s\tfindings=%s" % (used, lv, findings or "-"))
PY
}

round_open_cmd() {
  local job="${1:-}" head="" extend="" repo_override="" repo="" metadata owner label pane parent role
  [[ -n "$job" && "$job" != -* ]] || die "round open requires a job id"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --head) [[ $# -ge 2 && -n "$2" ]] || die "--head requires a SHA"; head="$2"; shift 2 ;;
      --extend) [[ $# -ge 2 && -n "$2" ]] || die "--extend requires a hk:doc/<key> or hk:task/<id> ref"; extend="$2"; shift 2 ;;
      --repo) [[ $# -ge 2 && -n "$2" ]] || die "--repo requires a path"; repo_override="$2"; shift 2 ;;
      *) die "unknown round open option '$1'" ;;
    esac
  done
  [[ "$head" =~ ^[0-9a-fA-F]{40}$ ]] || die "round open --head requires a full 40-hex SHA"
  head="$(printf '%s' "$head" | tr '[:upper:]' '[:lower:]')"
  if [[ -n "$extend" ]]; then wrk_trust_guard hk; else wrk_trust_guard; fi
  metadata="$(builder_metadata "$job" trusted)"
  IFS=$'\t' read -r owner label pane parent role <<<"$metadata"
  wrk_refuse_ended "round open" "$job" "${WRK_TRUST_JOBS_ROOT:?trust guard did not run}"
  if ! repo="$(round_repo_resolve "$job" "$repo_override")"; then
    if [[ -n "$repo_override" ]]; then
      die "round open: --repo $repo_override is not a usable git repository"
    fi
    die "round open: job $job has no usable repo, worktree or cwd in job.claim/job.reclaim; pass --repo PATH"
  fi
  if ! round_head_check "$repo" "$head"; then
    die "round open: --head $head is not a commit in $repo"
  fi

  # An extension is approved before the count is consulted: the fetched hk
  # record must carry a valid grant line for this job from an allowed issuer.
  local grant="" grant_extra=0 grant_issuer=""
  if [[ -n "$extend" ]]; then
    local tmp_approval
    tmp_approval="$(mktemp)"
    if ! round_approval_fetch "$extend" >"$tmp_approval"; then
      rm -f "$tmp_approval"
      die "round open --extend: approval record not found in handoffkeep: $extend"
    fi
    grant="$(round_approval_verify "$extend" "$job" "$parent" "$ROUND_CAP_OPERATORS" "$ROUND_CAP_PARENT_ISSUERS" "$tmp_approval" || true)"
    rm -f "$tmp_approval"
    [[ -n "$grant" ]] ||
      die "round open --extend: $extend holds no 'round-extension: job=$job extra=N by=<parent-lane|operator>' grant backed by the record's server-set created_by (doc) or comment author (task)"
    grant_extra="${grant#granted=}"; grant_extra="${grant_extra%% *}"
    grant_issuer="${grant##*issuer=}"
    # A pa-integrator grant counts only on ParkingArcade work, checked on the
    # server — never from local event files: the task id recorded in the job
    # meta must fetch to a task whose project is exactly ParkingArcade and
    # whose refs.job_id is exactly this job. Every other outcome (no task id,
    # fetch failure, malformed record, wrong project, refs mismatch) fails
    # closed. director-1, operator and operator-desk grants skip this check.
    if [[ "$grant_issuer" == "pa-integrator" ]]; then
      local task_id tmp_task
      task_id="$(round_job_task_id "$job" || true)"
      [[ -n "$task_id" ]] ||
        die "round open --extend: pa-integrator grants need the job's hk task on the server; $job records no task_id"
      tmp_task="$(mktemp)"
      if ! round_pa_task_fetch "$task_id" >"$tmp_task"; then
        rm -f "$tmp_task"
        die "round open --extend: pa-integrator grants need the job's hk task on the server; cannot fetch task $task_id"
      fi
      if ! round_pa_task_verify "$job" "$tmp_task"; then
        rm -f "$tmp_task"
        die "round open --extend: pa-integrator grants count only when the server task for $job is project ParkingArcade with refs.job_id=$job"
      fi
      rm -f "$tmp_task"
    fi
  fi

  # Round count and decision run under the events lock so a verdict landing
  # concurrently cannot slip a second open past the cap.
  local outcome rc=0
  set +e
  outcome="$(wrk_py - "${WRK_TRUST_JOBS_ROOT:?trust guard did not run}/$job/events" "$job" "$owner" "$label" "$pane" "$parent" "$head" "$ROUND_CAP_DEFAULT" "$extend" "$grant_extra" "$grant_issuer" <<'PY'
import fcntl, json, os, sys, tempfile
exec(os.environ["WRK_EVENTS_PY"])
(events, job, owner, label, pane, parent, head, cap,
 extend_ref, grant_extra, grant_issuer) = sys.argv[1:]
cap, grant_extra = int(cap), int(grant_extra)
os.makedirs(events, exist_ok=True)
lock_path = os.path.join(os.path.dirname(events), ".wrk-events.lock")
with open(lock_path, "w", encoding="utf-8") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    end_name = wrk_end_declaration(events)
    if end_name:
        print("ENDED\t%s" % end_name)
        raise SystemExit(0)
    records = [o for _, o, _ in wrk_events_ordered(events) if o is not None]
    rounds = [r for r in records if r.get("kind") == "job.round"]
    verdicts = [r for r in records if r.get("kind") == "job.verdict"]
    voids = [r for r in records if r.get("kind") == "job.round_void"]
    bound = {v.get("round") for v in verdicts if isinstance(v.get("round"), int)}
    round_numbers = {r.get("round") for r in rounds
                     if isinstance(r.get("round"), int)}
    voided = {v.get("round") for v in voids
              if (v.get("job_id") == job and isinstance(v.get("round"), int)
                  and v.get("round") in round_numbers and v.get("round") not in bound
                  and isinstance(v.get("ref"), str)
                  and v["ref"].startswith(("hk:doc/", "hk:task/")))}
    used = sum(1 for r in rounds
               if not (isinstance(r.get("round"), int) and r.get("round") in voided))
    used += sum(1 for v in verdicts if not isinstance(v.get("round"), int))
    used += wrk_takeover_rounds(events)
    approval = None
    if used >= cap:
        if not extend_ref:
            print("CAP rounds=%d" % used)
            raise SystemExit(0)
        # Each grant covers <extra> opens past the cap; one open consumes one.
        consumed = sum(1 for r in rounds
                       if (r.get("approval") or {}).get("ref") == extend_ref)
        if consumed >= grant_extra:
            print("CAP rounds=%d" % used)
            raise SystemExit(0)
        approval = {"ref": extend_ref, "issuer": grant_issuer, "extra": grant_extra}
    elif extend_ref:
        print("EXTEND_BEFORE_CAP")
        raise SystemExit(0)
    highest_round = max(round_numbers) if round_numbers else 0
    next_round = max(used, highest_round) + 1
    record = {"kind": "job.round", "job_id": job, "owner_lane": owner,
              "label": label, "pane_id": pane, "parent_lane": parent,
              "head": head.lower(), "round": next_round, "epoch": 1}
    if approval:
        record["approval"] = approval
    wrk_event_commit(events, "job.round", record)
    print("OPENED round=%d" % next_round)
PY
)"
  rc=$?
  set -e
  [[ "$rc" -eq 0 ]] || die "round open failed to inspect $job"
  case "$outcome" in
    ENDED$'\t'*)
      die "round open: refused after end record ${outcome#ENDED$'\t'}"
      ;;
    OPENED\ round=*)
      echo "OK job=$job ${outcome#OPENED } cap=$ROUND_CAP_DEFAULT head=$head"
      ;;
    EXTEND_BEFORE_CAP)
      die "round open --extend is only valid once the cap ($ROUND_CAP_DEFAULT) is reached"
      ;;
    CAP\ rounds=*)
      # The refusal is itself an event the parent must see: emit the
      # escalate (deduped per job) and then stop the caller with rc 78.
      local rounds last_v findings status question
      status="$(round_cap_event "$job" "$owner" "$label" "$pane" "$parent" "$head" "$ROUND_CAP_DEFAULT")"
      if [[ "$status" == emitted* ]]; then
        IFS=$'\t' read -r _ rounds last_v findings <<<"$status"
        findings="${findings#findings=}"
        [[ "$findings" == "-" ]] && findings=""
        question="tester round cap $ROUND_CAP_DEFAULT reached at ${rounds#rounds=} rounds; builder must stop and wait for the parent; extension needs a hk approval record naming this job (wrk round open --extend REF)"
        emit_relay_event job.escalate "$job" "$owner" "$label" "$pane" "${HOSTNAME:-unknown}" \
          "$findings" "${last_v#last_verdict=}" "$ROUND_CAP_REASON" "$question" "" "$head"
        warn "round cap $ROUND_CAP_DEFAULT reached for $job (${rounds#rounds=} rounds); emitted job.escalate to parent $parent"
      else
        warn "round cap $ROUND_CAP_DEFAULT still reached for $job; job.escalate already recorded"
      fi
      exit "$WRK_EXIT_ROUND_CAP"
      ;;
    *) die "round open unexpected outcome: $outcome" ;;
  esac
}

round_void_cmd() {
  local job="${1:-}" round_number="${2:-}" ref="" reason="" metadata owner label pane parent role
  [[ -n "$job" && "$job" != -* ]] || die "round void requires a job id"
  [[ "$round_number" =~ ^[1-9][0-9]*$ ]] || die "round void requires a positive round number"
  shift 2 || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --by) [[ $# -ge 2 && -n "$2" ]] || die "--by requires a hk:doc/<key> or hk:task/<id> ref"; ref="$2"; shift 2 ;;
      --reason) [[ $# -ge 2 && -n "$2" ]] || die "--reason requires text"; reason="$2"; shift 2 ;;
      *) die "unknown round void option '$1'" ;;
    esac
  done
  [[ -n "$ref" ]] || die "round void requires --by REF"
  wrk_trust_guard hk
  metadata="$(builder_metadata "$job" trusted)"
  IFS=$'\t' read -r owner label pane parent role <<<"$metadata"
  wrk_refuse_ended "round void" "$job" "${WRK_TRUST_JOBS_ROOT:?trust guard did not run}"

  local tmp_approval grant grant_issuer
  tmp_approval="$(mktemp)"
  if ! round_approval_fetch "$ref" >"$tmp_approval"; then
    rm -f "$tmp_approval"
    die "round void --by: approval record not found in handoffkeep: $ref"
  fi
  grant="$(round_approval_verify "$ref" "$job" "$parent" "$ROUND_CAP_OPERATORS" "$ROUND_CAP_PARENT_ISSUERS" "$tmp_approval" round-void "$round_number" || true)"
  rm -f "$tmp_approval"
  [[ -n "$grant" ]] ||
    die "round void --by: $ref has no matching 'round-void: job=$job round=$round_number by=<parent-lane|operator>' grant backed by the record's server-set created_by (doc) or comment author (task)"
  grant_issuer="${grant##*issuer=}"
  if [[ "$grant_issuer" == "pa-integrator" ]]; then
    local task_id tmp_task
    task_id="$(round_job_task_id "$job" || true)"
    [[ -n "$task_id" ]] ||
      die "round void --by: pa-integrator grants need the job's hk task on the server; $job records no task_id"
    tmp_task="$(mktemp)"
    if ! round_pa_task_fetch "$task_id" >"$tmp_task"; then
      rm -f "$tmp_task"
      die "round void --by: pa-integrator grants need the job's hk task on the server; cannot fetch task $task_id"
    fi
    if ! round_pa_task_verify "$job" "$tmp_task"; then
      rm -f "$tmp_task"
      die "round void --by: pa-integrator grants count only when the server task for $job is project ParkingArcade with refs.job_id=$job"
    fi
    rm -f "$tmp_task"
  fi
  [[ -n "$reason" ]] || reason="round-void: job=$job round=$round_number by=$grant_issuer"

  local outcome rc=0
  set +e
  outcome="$(wrk_py - "${WRK_TRUST_JOBS_ROOT:?trust guard did not run}/$job/events" "$job" "$round_number" "$ref" "$reason" "$grant_issuer" <<'PY'
import fcntl, json, os, sys, tempfile
exec(os.environ["WRK_EVENTS_PY"])
events, job, round_text, ref, reason, issuer = sys.argv[1:]
round_number = int(round_text)
os.makedirs(events, exist_ok=True)
lock_path = os.path.join(os.path.dirname(events), ".wrk-events.lock")
with open(lock_path, "w", encoding="utf-8") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    end_name = wrk_end_declaration(events)
    if end_name:
        print("ENDED\t%s" % end_name)
        raise SystemExit(0)
    records = [o for _, o, _ in wrk_events_ordered(events) if o is not None]
    rounds = [r for r in records if r.get("kind") == "job.round"
              and r.get("job_id") == job and r.get("round") == round_number]
    if not rounds:
        print("NO_ROUND")
        raise SystemExit(0)
    if any(r.get("kind") == "job.verdict" and r.get("job_id") == job
           and r.get("round") == round_number for r in records):
        print("HAS_VERDICT")
        raise SystemExit(0)
    if any(r.get("kind") == "job.round_void" and r.get("job_id") == job
           and r.get("round") == round_number for r in records):
        print("ALREADY_VOID")
        raise SystemExit(0)
    record = {"kind": "job.round_void", "job_id": job, "round": round_number,
              "reason": reason, "ref": ref, "issuer": issuer, "epoch": 1}
    wrk_event_commit(events, "job.round_void", record)
    print("VOIDED round=%d" % round_number)
PY
  )"
  rc=$?
  set -e
  [[ "$rc" -eq 0 ]] || die "round void failed to inspect $job"
  case "$outcome" in
    ENDED$'\t'*)
      die "round void: refused after end record ${outcome#ENDED$'\t'}"
      ;;
    VOIDED\ round=*) echo "OK job=$job $outcome ref=$ref" ;;
    NO_ROUND) die "round void: round $round_number does not exist for job $job" ;;
    HAS_VERDICT) die "round void: round $round_number already has a job.verdict" ;;
    ALREADY_VOID) die "round void: round $round_number is already voided" ;;
    *) die "round void unexpected outcome: $outcome" ;;
  esac
}

round_verdict_cmd() {
  local job="${1:-}" file="" metadata owner label pane parent role
  [[ -n "$job" && "$job" != -* ]] || die "round verdict requires a job id"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --file) [[ $# -ge 2 && -n "$2" ]] || die "--file requires a path"; file="$2"; shift 2 ;;
      *) die "unknown round verdict option '$1'" ;;
    esac
  done
  [[ -n "$file" && -f "$file" ]] || die "round verdict requires an existing --file"
  wrk_trust_guard
  metadata="$(builder_metadata "$job" trusted)"
  IFS=$'\t' read -r owner label pane parent role <<<"$metadata"
  wrk_refuse_ended "round verdict" "$job" "${WRK_TRUST_JOBS_ROOT:?trust guard did not run}"
  local outcome rc=0
  set +e
  outcome="$(wrk_py - "${WRK_TRUST_JOBS_ROOT:?trust guard did not run}/$job/events" "$job" "$owner" "$label" "$pane" "$parent" "$file" <<'PY'
import fcntl, hashlib, io, json, os, sys, tempfile
exec(os.environ["WRK_EVENTS_PY"])
events, job, owner, label, pane, parent, vfile = sys.argv[1:]
os.makedirs(events, exist_ok=True)
verdict = vsha = None
matches = []
try:
    with open(vfile, "rb") as raw:
        data = raw.read()
    for line in io.TextIOWrapper(io.BytesIO(data), encoding="utf-8", errors="replace"):  # hk1900-verdict-decode
        m = wrk_verdict_line.match(line)
        if m:
            matches.append(m)
except OSError:
    pass
if not matches:
    print("NO_VERDICT")
    raise SystemExit(0)
if len(matches) > 1:
    print("AMBIGUOUS")
    raise SystemExit(0)
verdict, vsha = matches[0].group(1), matches[0].group(2).lower()
digest = ""
try:
    with open(vfile, "rb") as raw:
        digest = hashlib.sha256(raw.read()).hexdigest()
except OSError:
    digest = ""
abspath = os.path.abspath(vfile)
lock_path = os.path.join(os.path.dirname(events), ".wrk-events.lock")
with open(lock_path, "w", encoding="utf-8") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    end_name = wrk_end_declaration(events)
    if end_name:
        print("ENDED\t%s" % end_name)
        raise SystemExit(0)
    ordered = wrk_events_ordered(events)
    records = [o for _, o, _ in ordered if o is not None]
    rounds = [r for r in records if r.get("kind") == "job.round"]
    verdicts = [r for r in records if r.get("kind") == "job.verdict"]
    voids = [r for r in records if r.get("kind") == "job.round_void"]
    bound = {v.get("round") for v in verdicts if isinstance(v.get("round"), int)}
    round_numbers = {r.get("round") for r in rounds
                     if isinstance(r.get("round"), int)}
    voided = {v.get("round") for v in voids
              if (v.get("job_id") == job and isinstance(v.get("round"), int)
                  and v.get("round") in round_numbers and v.get("round") not in bound
                  and isinstance(v.get("ref"), str)
                  and v["ref"].startswith(("hk:doc/", "hk:task/")))}
    # Identity refusals name the earliest blocking job.verdict. Path, then
    # exact bytes, then head. A void releases the head even when that round
    # also carries a verdict. The cap void set above is unchanged.
    # Bash 3.2 scans this heredoc for quotes because it sits inside a
    # command substitution. Do not put an unmatched single quote in this body.
    path_hit = ""
    content_hit = ""
    digests = set()
    head_hit = ""
    for name, document, _mtime in ordered:
        if not isinstance(document, dict) or document.get("kind") != "job.verdict":
            continue
        vid = document.get("job_id")
        if isinstance(vid, str) and vid != job:
            continue
        recorded_path = document.get("path")
        if (path_hit == "" and isinstance(recorded_path, str)
                and os.path.abspath(recorded_path) == abspath):
            path_hit = name
        recorded_digest = document.get("content_sha256")
        if isinstance(recorded_digest, str) and recorded_digest:
            digests.add(recorded_digest)
            if content_hit == "" and recorded_digest == digest:
                content_hit = name
        recorded_head = document.get("head")
        if (head_hit == "" and isinstance(recorded_head, str)
                and recorded_head.lower() == vsha):
            number = document.get("round")
            released = False
            if isinstance(number, int):
                for void in voids:
                    vjob = void.get("job_id")
                    ref = void.get("ref")
                    if ((not isinstance(vjob, str) or vjob == job)
                            and void.get("round") == number
                            and isinstance(ref, str)
                            and ref.startswith(("hk:doc/", "hk:task/"))):
                        released = True
                        break
            if not released:
                head_hit = name
    if path_hit:
        print("DUP_PATH\t%s\t%s" % (path_hit, abspath))
        raise SystemExit(0)
    if digest in digests:  # hk1449-content-sha
        print("DUP_CONTENT\t%s\t%s" % (content_hit, digest))
        raise SystemExit(0)
    if head_hit:
        print("DUP_HEAD\t%s\t%s" % (head_hit, vsha))
        raise SystemExit(0)
    open_rounds = [r for r in rounds
                   if (isinstance(r.get("round"), int) and r.get("round") not in bound
                       and r.get("round") not in voided)]
    target = None
    for r in open_rounds:
        round_head = r.get("head")
        if (isinstance(r.get("round"), int) and r.get("round") not in bound
                and r.get("round") not in voided and isinstance(round_head, str)
                and round_head.lower() == vsha):  # hk1506-head-bind
            target = r["round"]
            break
    if target is None:
        if open_rounds:
            labels = []
            for r in open_rounds:
                round_head = r.get("head")
                if isinstance(round_head, str) and round_head:
                    short_head = round_head[:7].lower()
                    if any(ch in short_head for ch in "\t\r\n,"):
                        short_head = "<invalid-head>"
                else:
                    short_head = "<no-head>"
                labels.append("%s@%s" % (r["round"], short_head))
            print("NO_HEAD_ROUND\t%s\t%s" % (vsha, ", ".join(labels)))
        else:
            print("NO_OPEN_ROUND\t%s" % vsha)
        raise SystemExit(0)
    used = sum(1 for r in rounds
               if not (isinstance(r.get("round"), int) and r.get("round") in voided))
    used += sum(1 for v in verdicts if not isinstance(v.get("round"), int))
    used += wrk_takeover_rounds(events)
    record = {"kind": "job.verdict", "job_id": job, "owner_lane": owner,
              "label": label, "pane_id": pane, "parent_lane": parent,
              "verdict": verdict, "head": vsha, "path": os.path.abspath(vfile),
              "content_sha256": digest, "round": target, "epoch": 1}
    wrk_event_commit(events, "job.verdict", record)
    print("RECORDED round=%s verdict=%s head=%s used=%d" %
          (target, verdict, vsha, used))
PY
)"
  rc=$?
  set -e
  [[ "$rc" -eq 0 ]] || die "round verdict failed to inspect $job"
  case "$outcome" in
    NO_VERDICT)
      die "round verdict --file has no 'VERDICT: PASS|BLOCKER @<40-hex sha>' line: $file" ;;
    AMBIGUOUS)
      die "round verdict --file has more than one VERDICT line: $file" ;;
    ENDED$'\t'*|DUP_PATH$'\t'*|DUP_CONTENT$'\t'*|DUP_HEAD$'\t'*)
      wrk_verdict_refusal "$outcome" ;;
    NO_HEAD_ROUND$'\t'*)
      local no_head_v no_open_list
      IFS=$'\t' read -r _ no_head_v no_open_list <<<"$outcome"
      die "round verdict: no open round for head $no_head_v on job $job (open: $no_open_list); open one with wrk round open $job --head $no_head_v" ;;
    NO_OPEN_ROUND$'\t'*)
      local no_open_head
      IFS=$'\t' read -r _ no_open_head <<<"$outcome"
      die "round verdict: job $job has no open round; open one with wrk round open $job --head $no_open_head" ;;
    RECORDED*)
      local round_no="" verdict_v="" head_v="" used_v="" tok
      for tok in $outcome; do
        case "$tok" in
          round=*) round_no="${tok#round=}" ;;
          verdict=*) verdict_v="${tok#verdict=}" ;;
          head=*) head_v="${tok#head=}" ;;
          used=*) used_v="${tok#used=}" ;;
        esac
      done
      echo "OK job=$job verdict=$verdict_v head=$head_v round=$round_no rounds=$used_v cap=$ROUND_CAP_DEFAULT"
      ;;
    *) die "round verdict unexpected outcome: $outcome" ;;
  esac
}

round_status_cmd() {
  local job="${1:-}"
  [[ -n "$job" && "$job" != -* ]] || die "round status requires a job id"
  [[ $# -eq 1 ]] || die "round status accepts only a job id"
  wrk_trust_guard
  local scan
  scan="$(round_scan "$job")"
  echo "job=$job cap=$ROUND_CAP_DEFAULT $scan"
}

round_audit_cmd() {
  local lane=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) round_help; return 0 ;;
      --lane)
        [[ $# -ge 2 && -n "$2" ]] || die "--lane requires a lane"
        lane="$2"
        shift 2
        ;;
      *) die "unknown round audit option '$1'" ;;
    esac
  done
  # hk 1894: the audit reads the canonical inbox, so a redirected inbox cannot
  # make a builder with no recorded rounds look clean.
  wrk_trust_guard
  local jobs_root
  jobs_root="${WRK_TRUST_JOBS_ROOT:?trust guard did not run}"
  [[ -d "$jobs_root" ]] || return 0
  local job_dir job scan ended owner lane_ok role recorded blocks line tag rest
  # find -H below: the checked inbox may itself be a symlink (the guard returns the
  # canonical spelling); without -H find walks nothing and the audit looks clean.
  while IFS= read -r job_dir; do
    [[ -n "$job_dir" && -d "$job_dir" ]] || continue
    job="$(basename "$job_dir")"
    scan="$(job_events_scan "$job_dir/events")"
    ended=""
    owner=""
    IFS=$'\t' read -r _ ended _ _ _ _ _ owner _ <<<"$scan"
    [[ -n "${owner:-}" ]] || owner="-"
    lane_ok=0
    if [[ -z "$lane" || "$owner" == "$lane" ]]; then
      lane_ok=1
    fi
    if [[ "$lane_ok" -ne 1 ]]; then
      continue
    fi
    role="$(wrk_job_role "$job" "$jobs_root")"
    recorded="$(wrk_recorded_rounds "$job" "$jobs_root")"
    case "$role" in
      builder|captain)
        if [[ "$ended" == "0" && "$recorded" == "0" ]]; then
          printf 'zero-rounds job=%s lane=%s\n' "$job" "$owner"
        fi
        ;;
    esac
    blocks="$(wrk_join_blocks "$job" "$jobs_root")"
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      tag="${line%%$'\t'*}"
      rest="${line#*$'\t'}"
      if [[ "$tag" == unmatched ]]; then
        printf 'unmatched-verdict job=%s file=%s\n' "$job" "$rest"
      fi
    done <<<"$blocks"
  done < <(find -H "$jobs_root" -mindepth 1 -maxdepth 1 -type d | LC_ALL=C sort)
}

round_cmd() {
  local sub="${1:-}"
  case "$sub" in
    -h|--help|"") round_help ;;
    open) shift; round_open_cmd "$@" ;;
    verdict) shift; round_verdict_cmd "$@" ;;
    void) shift; round_void_cmd "$@" ;;
    status) shift; round_status_cmd "$@" ;;
    audit) shift; round_audit_cmd "$@" ;;
    *) die "unknown round subcommand '$sub' (see 'wrk round --help')" ;;
  esac
}

# herdr 관측 3분류. 확정 소멸(gone)만 job.lost 로 이어지고, 나머지 장애는 일시
# 장애(transient)로 재시도한다. 빈 출력은 소멸의 증거가 아니다 — 소켓 일시 정지,
# 서버가 다른 세션에 있는 호스트, 타임아웃 모두 빈 출력을 낸다(2026-09-04: 그날
# 스폰한 거의 모든 잡이 30초 만에 job.lost 로 찍히고 센티널이 죽어, 워커가 정상
# 완료해도 job.completed 를 아무도 쓰지 못했다).
SENTINEL_GONE_CODES="agent_not_found pane_not_found tab_not_found terminal_not_found no_such_agent no_such_pane"

# "<class><TAB><token><TAB><tab_id>" 를 출력한다.
#   class ∈ ok|transient|gone
#   token = 로그의 status 필드(상태 이름 | empty | err:<code>)
herdr_agent_probe() {
  local pane="$1" out="" rc=0
  set +e
  # 🔴 두 스트림을 함께 읽는다. herdr 는 에러 봉투를 **stderr** 로 내보내고 1 로
  # 끝낸다(2026-09-05 실측: `{"error":{"code":"agent_not_found",…}}` 가 stderr).
  # stdout 만 보면 확정 소멸이 영원히 "빈 값" 으로 보인다.
  out="$("$HERDR" agent get "$pane" 2>&1)"
  rc=$?
  set -e
  python3 - "$rc" "$SENTINEL_GONE_CODES" "$out" <<'PY' 2>/dev/null || printf 'transient\terr:probe\t\n'
import json, sys

rc, gone_codes, raw = sys.argv[1], set(sys.argv[2].split()), sys.argv[3].strip()


def emit(kind, token, tab=""):
    print(kind, token, tab, sep="\t")
    raise SystemExit(0)


def documents(text):
    """봉투가 로그 줄과 섞여 와도 JSON 만 골라낸다."""
    try:
        yield json.loads(text)
        return
    except ValueError:
        pass
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            yield json.loads(line)
        except ValueError:
            continue


def status_and_tab(document):
    # 실 herdr: {"result":{"agent":{"agent_status":…,"tab_id":…}}}.
    # 옛 응답(result 바로 아래)과 agent_info 변형도 함께 받는다.
    result = document.get("result", document)
    if not isinstance(result, dict):
        return "", ""
    scopes = [result]
    for key in ("agent", "agent_info", "pane"):
        value = result.get(key)
        if isinstance(value, dict):
            scopes.append(value)
    for scope in scopes:
        status = scope.get("agent_status")
        if isinstance(status, str) and status.strip():
            tab = scope.get("tab_id") or result.get("tab_id") or ""
            return status.strip(), tab if isinstance(tab, str) else ""
    return "", ""


if not raw:
    emit("transient", "empty" if rc == "0" else "err:exit%s" % rc)
for document in documents(raw):
    if not isinstance(document, dict):
        continue
    error = document.get("error")
    if isinstance(error, str):
        error = {"code": error}
    if isinstance(error, dict):
        code = error.get("code") or error.get("message") or "unknown"
        code = "_".join(str(code).split())[:64]
        emit("gone" if code in gone_codes else "transient", "err:%s" % code)
    status, tab = status_and_tab(document)
    if status:
        emit("ok", status, tab)
emit("transient", "err:parse")
PY
}

# 판정 1건 = 로그 1줄. 회전은 없다(잡 디렉토리 수명과 같다).
# extra 가 비어 있으면 줄은 네 칸 그대로다. 회복이 pending·completed 와 같은
# 폴에 겹치면 action 은 그 판정을 유지하고 끝에 recovered=<reason> 만 붙는다.
# 감시 창이 에이전트가 살아 있는 폴에서 만료되면 action=watch-expired
# elapsed=<n>s 한 줄을 남기고 센티널만 끝난다(job.lost·종료 기록·쿼타 해제 없음).
# 마감 뒤에 처음 관측된 report 는 확인 폴 한 번을 받는다 — 그 폴은 action=pending late=1 이다.
sentinel_log() {
  local logfile="$1" token="$2" transient="$3" action="$4" extra="${5:-}"
  if [[ -n "$extra" ]]; then
    printf '%s status=%s transient=%s action=%s %s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$token" "$transient" "$action" "$extra" >>"$logfile" 2>/dev/null || true
  else
    printf '%s status=%s transient=%s action=%s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$token" "$transient" "$action" >>"$logfile" 2>/dev/null || true
  fi
}

# ── #770: job-end housekeeping ────────────────────────────────────────────
# A job that ended must not leave three things behind: an "active" hub/arbiter
# record, a live completion sentinel, or the sentinel's interval sleep child.
# The helpers below are shared by every end path (wrk done / joined, the
# sentinel's own completed/lost judgements, wrk reap, wrk prune).
#
# Terminal vocabulary here is deliberately narrower than "work is over":
#   WORK_TERMINAL = what ends this job's lifecycle (completed, completion,
#                   joined, revoked, reaped — job.lost is NOT one: the record
#                   is an observation gap, and a lost job may still complete.
#                   job.recovered is NOT one either: it only closes that gap)
#   HUB_TERMINAL  = what the hub and the node active-scan actually end on
#                   (completed, completion, revoked — joined relays but keeps
#                   the job counted; lost and recovered are explicitly not
#                   terminal)
#   REVIVE        = a record that proves the job was picked up again
#                   (claim/claimed/reclaim/spawned/reprompted after a terminal
#                   un-ends it — the newest record wins, as in wrk reap.
#                   job.recovered is not a revive)

# job_events_scan EVENTS_DIR... — one TSV row per job:
#   job \t ended \t hub_ended \t terminal_kind \t last_event_age_s \t last_kind
#       \t completed_n \t owner \t label \t pane \t tab
# ended         a work-terminal record exists after the newest revive
# hub_ended     a hub-terminal record exists after the newest revive
# terminal_kind the newest work-terminal kind ("-" when not ended)
# completed_n   completed/completion records written after the newest revive
# pane/tab      the newest job.spawned receipt's values — same source of truth
#               as wrk reap; "-" when the job never spawned
job_events_scan() {
  wrk_py - "$@" <<'PY'
import json, os, sys, time
exec(os.environ["WRK_EVENTS_PY"])

WORK_TERMINAL = {"job.completed", "job.completion", "job.joined", "job.revoked", "job.reaped", "job.handed_off"}
HUB_TERMINAL = {"job.completed", "job.completion", "job.revoked"}
REVIVE = {"job.claim", "job.claimed", "job.reclaim", "job.spawned", "job.reprompted"}
NEUTRAL = {"job.lost", "job.recovered"}
if NEUTRAL & (WORK_TERMINAL | HUB_TERMINAL | REVIVE):
    raise SystemExit("neutral event kind is also terminal or revive")
now = time.time()


def field(doc, payload, key):
    for source in (doc, payload):
        value = source.get(key)
        if isinstance(value, str) and value:
            return value
    return ""


for events in sys.argv[1:]:
    job = os.path.basename(os.path.dirname(os.path.normpath(events)))
    owner = label = pane = tab = ""
    kinds = []
    last_t = 0.0
    last_kind = ""
    # Event-time order, not file-name order: terminal/revive below walks this
    # list by index, and two writers number the directory independently.
    for name, doc, mtime in wrk_events_ordered(events):
        when = wrk_event_time(doc, mtime if mtime else now)
        if doc is None:
            # An unreadable event file is still activity evidence for aging,
            # but contributes nothing else.
            last_t = max(last_t, when)
            continue
        payload = doc.get("payload")
        if not isinstance(payload, dict):
            payload = {}
        kind = doc.get("kind") or doc.get("type") or doc.get("event") or ""
        # The loop is already in the shared order, so the last readable row is
        # the newest kind; only the raw time is a max for the age field.
        last_t = max(last_t, when)
        last_kind = kind or last_kind
        kinds.append(kind)
        if kind in ("job.claim", "job.claimed", "job.reclaim"):
            owner = field(doc, payload, "owner_lane") or owner
            label = field(doc, payload, "label") or field(doc, payload, "agent_label") or label
        if kind == "job.spawned":
            pane = field(doc, payload, "pane_id")
            tab = field(doc, payload, "tab_id")
    last_revive = -1
    for index, kind in enumerate(kinds):
        if kind in REVIVE:
            last_revive = index
    term_kind = ""
    hub_ended = 0
    completed_n = 0
    for index, kind in enumerate(kinds):
        if index <= last_revive:
            continue
        if kind in WORK_TERMINAL:
            term_kind = kind
        if kind in HUB_TERMINAL:
            hub_ended = 1
        if kind in ("job.completed", "job.completion"):
            completed_n += 1
    ended = 1 if term_kind else 0
    age = int(now - last_t) if last_t else -1
    print(job, ended, hub_ended, term_kind or "-", age, last_kind or "-",
          completed_n, owner or "-", label or "-", pane or "-", tab or "-", sep="\t")
PY
}

# job_watch_current EVENTS PANE — exit 0 when PANE is the job's current watch:
# the newest job.spawned names it AND no job.claim, job.claimed or job.reclaim
# follows that spawn. A reclaim that lands before its own job.spawned receipt
# — a respawn still in flight, new record already leased — keeps an older
# watcher superseded even while the scan's newest spawned pane still equals
# the pane it watches. job.reprompted deliberately does not count: it reuses
# the same pane.
job_watch_current() {
  wrk_py - "$1" "$2" <<'PY'
import os, sys
exec(os.environ["WRK_EVENTS_PY"])

events, pane = sys.argv[1:]
CLAIM = {"job.claim", "job.claimed", "job.reclaim"}
last_claim = last_spawn = -1
claim_count = 0
spawn_pane = ""
for index, (name, doc, _mtime) in enumerate(wrk_events_ordered(events)):
    if doc is None:
        continue
    payload = doc.get("payload")
    if not isinstance(payload, dict):
        payload = {}
    kind = doc.get("kind") or doc.get("type") or doc.get("event") or ""
    if kind == "job.spawned":
        last_spawn = index
        spawn_pane = "" # hk1813-spawn-pane-reset
        candidate = payload.get("pane_id") or doc.get("pane_id")
        if isinstance(candidate, str) and candidate:
            spawn_pane = candidate
    elif kind in CLAIM:
        last_claim = index
        claim_count += 1
# Current when the newest spawn names this pane and no claim follows it, or
# when a receipt-less stream is still at its initial claim. A second claim
# without an intervening spawned receipt means a reclaimed round is in flight,
# so the older pane watcher is superseded. A claim newer than the newest spawn
# is likewise an in-flight respawn: superseded even when the panes still match.
current = (last_spawn != -1 and spawn_pane == pane and last_claim < last_spawn) or \
          (last_spawn == -1 and claim_count <= 1) # hk1813-t4-no-spawn-current
sys.exit(0 if current else 1)
PY
}

# job_end_record JOB OWNER OUTCOME REASON SOURCE — append the flat job.revoked
# end declaration. The hub ends a job only on job.completed/job.revoked, so a
# job whose newest terminal is joined or lost still counts "active" until this
# marker lands. Skips when a hub-terminal record already follows the newest
# revive (already-ended) or when a revive is newest (the job is live again —
# ending it would be wrong). Prints created|already-ended|active.
job_end_record() {
  local job="$1" owner="$2" outcome="$3" reason="$4" source="$5" pane="${6:-}" allow_dead_current="${7:-0}" events
  events="$(wrk_jobs_root)/$job/events"
  mkdir -p "$events" || return 1
  wrk_py - "$events" "$job" "$owner" "$outcome" "$reason" "$source" "${HOSTNAME:-unknown}" "$pane" "$allow_dead_current" <<'PY'
import datetime, fcntl, json, os, sys, tempfile
exec(os.environ["WRK_EVENTS_PY"])

events, job, owner, outcome, reason, source, host, dead_pane, allow_dead_current = sys.argv[1:]
allow_dead_current = allow_dead_current == "1"
WORK_TERMINAL = {"job.completed", "job.completion", "job.joined", "job.revoked", "job.reaped", "job.handed_off"}
HUB_TERMINAL = {"job.completed", "job.completion", "job.revoked"}
REVIVE = {"job.claim", "job.claimed", "job.reclaim", "job.spawned", "job.reprompted"}
NEUTRAL = {"job.lost", "job.recovered"}
if NEUTRAL & (WORK_TERMINAL | HUB_TERMINAL | REVIVE):
    raise SystemExit("neutral event kind is also terminal or revive")

# The events lock is shared with completion_event so the "is it already
# ended" check and the append are one atomic step — `wrk done`, the sentinel
# and prune race on this directory.
lock_path = os.path.join(os.path.dirname(events), ".wrk-events.lock")
with open(lock_path, "w", encoding="utf-8") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    kinds = []
    # Event-time order: "already ended" and "revived after a terminal" are
    # index comparisons below, and file names do not order the two writers.
    for name, doc, _ in wrk_events_ordered(events):
        if doc is None:
            continue
        kinds.append(doc.get("kind") or doc.get("type") or doc.get("event") or "")
    last_revive = -1
    last_term = -1
    last_term_kind = ""
    last_hub = -1
    for index, kind in enumerate(kinds):
        if kind in REVIVE:
            last_revive = index
        if kind in WORK_TERMINAL:
            last_term = index
            last_term_kind = kind
        if kind in HUB_TERMINAL:
            last_hub = index
    if last_hub > -1 and last_hub > last_revive:
        print("already-ended")
        raise SystemExit(0)
    if last_term > last_revive and last_term_kind == "job.handed_off":
        print("already-ended")
        raise SystemExit(0)
    if last_term > -1 and last_revive > last_term:
        # Terminal first, then a revive normally means the job was picked up
        # again. Prune may end that round only after its newest spawned pane
        # has been confirmed gone past the grace; the locked event reread must
        # still name the same pane and have no claim after its spawn.
        last_spawn = last_claim = -1
        spawn_pane = ""
        for index, (name, doc, _mtime) in enumerate(wrk_events_ordered(events)):
            if doc is None:
                continue
            kind = doc.get("kind") or doc.get("type") or doc.get("event") or ""
            payload = doc.get("payload")
            if not isinstance(payload, dict):
                payload = {}
            if kind == "job.spawned":
                last_spawn = index
                spawn_pane = ""
                candidate = payload.get("pane_id") or doc.get("pane_id")
                if isinstance(candidate, str) and candidate:
                    spawn_pane = candidate
            elif kind in ("job.claim", "job.claimed", "job.reclaim"):
                last_claim = index
        allow_dead_terminal_then_revive = (
            allow_dead_current and dead_pane and last_spawn > last_term and
            spawn_pane == dead_pane and last_claim < last_spawn)
        if not allow_dead_terminal_then_revive: # hk1813-allow-dead-current-round
            print("active")
            raise SystemExit(0)
    record = {"kind": "job.revoked", "job_id": job, "epoch": 1,
              "owner_lane": owner, "outcome": outcome, "reason": reason,
              "source": source, "host": host,
              "created_at": datetime.datetime.now(datetime.timezone.utc)
              .isoformat(timespec="seconds").replace("+00:00", "Z")}
    wrk_event_commit(events, "job.revoked", record)
    print("created")
PY
}

# quota_release_log JOB POOL REASON — one durable line per release failure.
# A detached sentinel's stderr is redirected to its job log, so durable logging
# alone avoids duplicate lines there. Foreground callers also warn on stderr;
# if the job log cannot be written, all modes fall back to stderr.
quota_release_log() {
  local job="$1" pool="$2" reason="$3" jobdir line
  jobdir="$(wrk_jobs_root)/$job"
  if [[ -d "$jobdir" ]]; then
    line="$(date -u +%Y-%m-%dT%H:%M:%SZ) status=- transient=0 action=quota-release-failed $reason job=$job pool=$pool"
    if printf '%s\n' "$line" >>"$jobdir/completion-sentinel.log" 2>/dev/null; then
      if [[ "${WRK_COMPLETION_SENTINEL:-0}" != 1 ]]; then # hk1813-foreground-release-warning
        warn "arbiter quota_pool release failed (job=$job pool=$pool $reason)"
      fi
      return 0
    fi
  fi
  warn "arbiter quota_pool release failed (job=$job pool=$pool $reason)"
  return 0
}

# quota_release_round_current JOB PANE [MODE] — prove that the latest terminal
# still authorizes this release. The default mode requires the candidate's
# observed pane to be the current watch round. ended-no-sentinel is reserved
# for prune pass 4: terminal ordering must prove the job ended and no live
# completion sentinel may still own cleanup.
quota_release_round_current() {
  local job="$1" pane="${2:-}" mode="${3:-current}" jobdir
  jobdir="$(wrk_jobs_root)/$job"
  if [[ -z "$pane" || "$pane" == - ]]; then
    pane="$(job_events_scan "$jobdir/events" 2>/dev/null | awk -F '\t' -v j="$job" '$1==j {print $10; exit}')"
    [[ "$pane" == - ]] && pane=""
  fi
  if ! sentinel_job_ended "$jobdir"; then
    echo "skip job=$job reason=revived-since-scan"
    return 2
  fi
  if [[ "$mode" == ended-no-sentinel ]]; then # hk1813-ended-no-sentinel-mode
    if job_has_live_completion_sentinel "$job"; then # hk1813-ended-quota-live-sentinel-check
      echo "skip job=$job reason=live-sentinel"
      return 2
    fi
    return 0
  fi
  if [[ "$mode" != current ]] || ! job_watch_current "$jobdir/events" "$pane"; then
    echo "skip job=$job reason=revived-since-scan"
    return 2
  fi
}

# release_job_quota_pool JOB [PANE] — release every live quota_pool record this job
# still holds (any pool) so the arbiter-side job record flips to released.
# The table holds only unreleased rows, so every row it lists is a record
# whose last quota_pool.record is newer than its last release — a record
# released once and re-recorded later (respawn, takeover, a later round) is
# released here too. Idempotent: a second call finds no rows. Best-effort:
# an unavailable arbiter, a failed status, or a failed release is logged once
# (rc, job, pool) via quota_release_log and never fails the end path. Before
# each release, re-read the terminal and the selected release-mode evidence; a
# scan snapshot cannot authorize releasing a row after a same-id reclaim or
# respawn.
release_job_quota_pool() {
  local job="$1" pane="${2:-}" mode="${3:-current}" arb out pool rc
  arb="${ARBITER:-}"
  if [[ -z "$arb" || ! -x "$arb" ]]; then
    arb="$(command -v arbiter 2>/dev/null || true)"
  fi
  if [[ -z "$arb" || ! -x "$arb" ]]; then
    quota_release_log "$job" "-" "rc=- reason=arbiter-unavailable"
    return 0
  fi
  out="$("$arb" status --job "$job" --json 2>/dev/null)" || {
    rc=$?
    quota_release_log "$job" "-" "rc=$rc reason=status-failed"
    return 0
  }
  while IFS= read -r pool; do
    [[ -n "$pool" ]] || continue
    # This check must follow status and sit immediately before each arbiter
    # release. A revive after the command's earlier candidate scan leaves the
    # live round's row untouched and makes the caller leave its paired action.
    quota_release_round_current "$job" "$pane" "$mode" || return $? # hk1813-release-time-check
    "$arb" release --job "$job" --resource "$pool" --kind quota_pool >/dev/null 2>&1 || {
      rc=$?
      quota_release_log "$job" "$pool" "rc=$rc"
    }
  done < <(python3 -c 'import json, sys
try:
    doc = json.loads(sys.argv[1])
except ValueError:
    raise SystemExit(0)
for row in doc.get("quota_pool_records") or []:
    pool = row.get("pool")
    if isinstance(pool, str) and pool:
        print(pool)' "$out" 2>/dev/null || true)
  return 0
}

# PID-reuse guard, part 1: the recorded pid is only ever this job's sentinel
# when its argv is literally `…/wrk sentinel JOB OWNER LABEL PANE [REPORT …]`.
# The token before `sentinel` must be the wrk program itself — argv[0], or
# argv[1] behind the interpreter the kernel inserts for the shebang — and the
# full owner/label/pane tail must be present. `wrk sentinel JOB` appearing as
# mere arguments inside an unrelated command line (a python fixture carrying
# a fake triple, an editor buffer, a log line) never matches.
sentinel_pid_matches() {
  local pid="$1" job="$2"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  ps -p "$pid" -o args= 2>/dev/null | awk -v job="$job" '
    function is_shell(tok) { sub(/^.*\//, "", tok); return tok ~ /^(sh|bash|zsh|dash|ksh)$/ }
    {
      for (i = 1; i <= NF; i++)
        if ($i ~ /(^|\/)wrk$/ && $(i + 1) == "sentinel" && $(i + 2) == job &&
            NF >= i + 5 && (i == 1 || (i == 2 && is_shell($1)))) { found = 1; break }
    }
    END { exit(found ? 0 : 1) }'
}

# sentinel_argv_pane PID JOB — the pane argument of a live
# `wrk sentinel JOB OWNER LABEL PANE …` process, empty when the argv does not
# prove this job's sentinel. Same argv shape as sentinel_pid_matches; the
# pane the process watches is evidence, not the job's newest job.spawned.
sentinel_argv_pane() {
  local pid="$1" job="$2" owner="${3:-}"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 0
  ps -p "$pid" -o args= 2>/dev/null | awk -v job="$job" -v owner="$owner" '
    function is_shell(tok) { sub(/^.*\//, "", tok); return tok ~ /^(sh|bash|zsh|dash|ksh)$/ }
    function paneish(tok) { return tok ~ /^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$/ }
    {
      for (i = 1; i <= NF; i++)
        if ($i ~ /(^|\/)wrk$/ && $(i + 1) == "sentinel" && $(i + 2) == job &&
            NF >= i + 5 && (i == 1 || (i == 2 && is_shell($1)))) {
          # The owner may itself contain spaces; when the caller knows the
          # expected owner string, match its word count so the pane offset
          # stays exact. No match, or a non-pane token at that offset, means
          # the argv layout cannot be trusted — print nothing so the caller
          # falls back to the scan newest spawned pane.
          w = 1
          if (owner != "" && owner != "-") {
            w = 0
            for (k = 1; k <= 4 && i + 2 + k <= NF; k++) {
              joined = $(i + 3)
              for (m = i + 4; m < i + 3 + k; m++) joined = joined " " $m
              if (joined == owner) { w = k; break }
            }
            if (w == 0) exit
          }
          pane = $(i + 4 + w)
          if (paneish(pane)) { print pane; exit }
          exit
        }
    }'
}

# sentinel_pidfile_fields FILE — print "pid<TAB>started" parsed from a
# completion-sentinel pidfile. Current files are two lines ("PID" then
# "started=EPOCH"); bare numeric legacy pidfiles and flat "pid=N started=E"
# forms parse identically. Missing or unparseable fields print empty — an
# empty field never proves identity.
sentinel_pidfile_fields() {
  local file="$1" line="" extra="" tok pid="" started=""
  if [[ -s "$file" ]]; then
    { IFS= read -r line; IFS= read -r extra || extra=""; } <"$file" 2>/dev/null || true
    for tok in $line $extra; do
      case "$tok" in
        pid=*) pid="${tok#pid=}" ;;
        started=*) started="${tok#started=}" ;;
        *)
          if [[ -z "$pid" && "$tok" =~ ^[0-9]+$ ]]; then pid="$tok"; fi ;;
      esac
    done
  fi
  printf '%s\t%s\n' "$pid" "$started"
}

# PID-reuse guard, part 2: when a pidfile recorded the sentinel's spawn time,
# the live process's real elapsed age must agree with it (±120s skew window —
# the file is written a moment after fork). No recorded start, no verdict;
# a malformed recorded start is never positive identity.
sentinel_start_matches() {
  local pid="$1" started="${2:-}"
  [[ -n "$started" ]] || return 0
  [[ "$started" =~ ^[0-9]+$ ]] || return 1
  local el skew
  el="$(proc_elapsed_s "$pid" 2>/dev/null)" || return 1
  skew=$(( $(date +%s) - started - el ))
  (( skew >= -120 && skew <= 120 ))
}

# kill -0 alone reports zombies as alive; the sentinel is reparented to launchd
# so its post-TERM zombie window is short but real.
sentinel_pid_alive() {
  local pid="$1" state
  kill -0 "$pid" 2>/dev/null || return 1
  state="$(ps -p "$pid" -o stat= 2>/dev/null || true)"
  state="${state//[[:space:]]/}"
  [[ "$state" == Z* ]] && return 1
  return 0
}

# sentinel_sweep — one TSV row per live `wrk sentinel …` process on the host:
#   pid \t job \t owner \t label \t pane \t report
# The process sweep is the only way to find a sentinel that has no pidfile
# (respawned or second instance) — prune uses it to list, end paths use it
# so no copy survives the job (tester BLOCKER 2).
sentinel_sweep() {
  ps axo pid=,args= 2>/dev/null | awk '
    function is_shell(tok) { sub(/^.*\//, "", tok); return tok ~ /^(sh|bash|zsh|dash|ksh)$/ }
    {
      pid = $1
      for (i = 2; i <= NF; i++)
        if ($i ~ /(^|\/)wrk$/ && $(i + 1) == "sentinel" && $(i + 2) != "" &&
            NF >= i + 5 && (i == 2 || (i == 3 && is_shell($2)))) {
          print pid "\t" $(i+2) "\t" $(i+3) "\t" $(i+4) "\t" $(i+5) "\t" $(i+6)
          break
        }
    }' | sort -k2,2 -k1,1n
}

# stop_completion_sentinel JOB [PID] — stop and wait on the job's completion
# sentinel and its interval sleep child. With an explicit PID only that
# (argv-verified) process is signalled — prune uses it for one orphan row.
# Without one, the pidfile pid AND every live `wrk sentinel JOB` the process
# sweep finds are stopped: a respawned or second sentinel has no pidfile and
# would otherwise outlive the end path (tester BLOCKER 2). The pidfile is
# removed regardless of outcome so a dead handle never looks live.
stop_completion_sentinel() {
  local job="$1" explicit_pid="${2:-}" jobdir pidfile pid child deadline
  jobdir="$(wrk_jobs_root)/$job"
  pidfile="$jobdir/completion-sentinel.pid"
  local -a pids=()
  local pidfile_pid="" pidfile_started=""
  if [[ -n "$explicit_pid" ]]; then
    pids=("$explicit_pid")
  else
    if [[ -s "$pidfile" ]]; then
      IFS=$'\t' read -r pidfile_pid pidfile_started <<<"$(sentinel_pidfile_fields "$pidfile")"
      [[ "$pidfile_pid" =~ ^[0-9]+$ ]] && pids+=("$pidfile_pid")
    fi
    local _p _j _seen _dup
    while IFS=$'\t' read -r _p _j _rest; do
      [[ "$_j" == "$job" ]] || continue
      _dup=0
      for _seen in ${pids[@]+"${pids[@]}"}; do
        [[ "$_seen" == "$_p" ]] && { _dup=1; break; }
      done
      (( _dup )) || pids+=("$_p")
    done < <(sentinel_sweep)
  fi
  for pid in ${pids[@]+"${pids[@]}"}; do
    local _st=""
    if [[ "$pid" == "$pidfile_pid" ]]; then _st="$pidfile_started"; fi
    if [[ "$pid" =~ ^[0-9]+$ ]] && sentinel_pid_matches "$pid" "$job" && sentinel_start_matches "$pid" "$_st"; then
      # Freeze first so a sentinel waking mid-stop cannot fork a new sleep
      # between the child enumeration and the signal batch (the test suites'
      # cleanup uses this same STOP → kill children → TERM → CONT order).
      kill -STOP "$pid" 2>/dev/null || true
      while IFS= read -r child; do
        kill "$child" 2>/dev/null || true
      done < <(pgrep -P "$pid" 2>/dev/null || true)
      kill "$pid" 2>/dev/null || true
      kill -CONT "$pid" 2>/dev/null || true
      deadline=$(( $(date +%s) + ${WRK_SENTINEL_STOP_WAIT_S:-5} ))
      while sentinel_pid_alive "$pid"; do
        if (( $(date +%s) >= deadline )); then
          kill -9 "$pid" 2>/dev/null || true
          deadline=$(( $(date +%s) + 2 ))
          while sentinel_pid_alive "$pid" && (( $(date +%s) < deadline )); do
            sleep 0.1
          done
          break
        fi
        sleep 0.1
      done
    fi
  done
  if [[ -z "$explicit_pid" ]]; then
    rm -f "$pidfile" 2>/dev/null || true
  else
    local current_pid=""
    IFS=$'\t' read -r current_pid _ <<<"$(sentinel_pidfile_fields "$pidfile")"
    [[ "$current_pid" != "$explicit_pid" ]] || rm -f "$pidfile" 2>/dev/null || true
  fi
  return 0
}

# job_end_housekeeping JOB OWNER OUTCOME REASON SOURCE — one call at every end
# path: declare the job ended to the hub when its terminal record is not
# hub-terminal on its own, release the quota_pool record, and stop + wait on
# the completion sentinel. Every step is best-effort; a housekeeping failure
# must never mask the record the caller just wrote.
job_end_housekeeping() {
  local job="$1" owner="$2" outcome="$3" reason="$4" source="$5" pane="${6:-}" end_out release_rc=0
  end_out="$(job_end_record "$job" "$owner" "$outcome" "$reason" "$source" 2>/dev/null)" || {
    warn "job end declaration write failed for $job; the records stay file-only"
    return 0
  }
  case "$end_out" in
    created|already-ended)
      # hk1860: the release's skip diagnostics go to stderr, so wrk done and
      # wrk joined keep their one OK line on stdout.
      release_job_quota_pool "$job" "$pane" >&2 || release_rc=$? # hk1798-housekeeping-release
      [[ "$release_rc" != 2 ]] || return 0 # hk1813-housekeeping-release-current
      stop_completion_sentinel "$job"
      ;;
    active) return 0 ;; # hk1798-housekeeping-active-guard
    *)
      warn "job end declaration returned an unknown result for $job"
      return 0 ;;
  esac
  return 0
}

# sentinel_job_ended JOBDIR — the job's event stream already carries a
# work-terminal record newer than every revive: some other end path (done,
# joined, reap, prune — or a second sentinel) finished the job while this
# sentinel was asleep, so the sentinel itself is now an orphan.
sentinel_job_ended() {
  job_events_scan "$1/events" | awk -F'\t' '$2 == 1 { found = 1 } END { exit(found ? 0 : 1) }'
}

# sentinel_self_exit JOB [RC] — remove our own pidfile only when it still
# names us (a respawned sentinel may already have overwritten it), then exit.
sentinel_self_exit() {
  local job="$1" code="${2:-0}" pidfile pf
  pidfile="$(wrk_jobs_root)/$job/completion-sentinel.pid"
  read -r pf <"$pidfile" 2>/dev/null || pf=""
  [[ "$pf" == "$$" ]] && rm -f "$pidfile"
  exit "$code"
}

# job_recovered_record JOB OWNER LABEL PANE REASON LOST_DURATION_S
# One flat job.recovered for the end of a lost episode. Not a terminal and
# not a revive. Not emitted through panewire, same as job.lost.
job_recovered_record() {
  local job="$1" owner="$2" label="$3" pane="$4" reason="$5" duration="$6"
  local events
  events="$(wrk_jobs_root)/$job/events"
  mkdir -p "$events" || return 1
  wrk_py - "$events" "$job" "$owner" "$label" "$pane" "${HOSTNAME:-unknown}" "$reason" "$duration" <<'PY'
import os, sys
exec(os.environ["WRK_EVENTS_PY"])

events, job, owner, label, pane, host, reason, duration = sys.argv[1:]
try:
    duration_s = int(duration)
except ValueError:
    duration_s = 0
if duration_s < 0:
    duration_s = 0
record = {"kind": "job.recovered", "job_id": job, "owner_lane": owner,
          "label": label, "pane_id": pane, "host": host, "epoch": 1,
          "reason": reason, "lost_duration_s": duration_s}
lock = wrk_events_locked(events)
try:
    wrk_event_commit(events, "job.recovered", record)
finally:
    lock.close()
PY
}

sentinel_cmd() {
  WRK_COMPLETION_SENTINEL=1
  export WRK_COMPLETION_SENTINEL
  local job="${1:-}" owner="${2:-}" label="${3:-}" pane="${4:-}" report="${5:-}"
  local pane_kind="${7:-}" observed_rung="${8:-}" scopefuel_bin="${9:-}"
  local timeout="${WRK_COMPLETION_TIMEOUT_S:-21600}"
  local interval="${WRK_COMPLETION_INTERVAL_S:-30}"
  local transient_max="${WRK_SENTINEL_TRANSIENT_MAX:-10}"
  local lost_grace="${WRK_SENTINEL_LOST_GRACE:-1800}"
  [[ -n "$job" && -n "$owner" && -n "$label" && -n "$pane" ]] || exit 2
  local jobdir logfile started seen pending transient lost lost_at lost_reason observer_script wrk_path
  jobdir="$(wrk_jobs_root)/$job"
  mkdir -p "$jobdir"
  logfile="$jobdir/completion-sentinel.log"
  if [[ "$pane_kind" == devin && -n "$observed_rung" ]]; then
    wrk_path="$(python3 - "$0" <<'PY'
from pathlib import Path
import shutil, sys

entry = sys.argv[1]
print(Path(shutil.which(entry) or entry).resolve())
PY
)"
    observer_script="$(dirname "$wrk_path")/wrk_free_limit_observer.py"
  else
    pane_kind=""
  fi
  started="$(date +%s)"
  seen=""
  pending=""
  late_pending=""
  transient=0
  lost=0
  lost_at=0
  lost_reason=""
  while :; do
    local now probe class token candidate key action recover_reason rearm_loss log_extra watch_expired
    now="$(date +%s)"
    probe="$(herdr_agent_probe "$pane")"
    IFS=$'\t' read -r class token _ <<<"$probe"
    action=none
    candidate=""
    key=""
    recover_reason=""
    rearm_loss=""
    watch_expired=""
    case "$class" in
      gone)
        transient=0
        if [[ "$lost" -eq 0 ]]; then
          action="lost:agent_not_found"
        elif [[ "$lost_reason" == herdr_unreachable ]]; then
          # herdr answered. The unreachable episode ends, and a fresh
          # agent_not_found episode starts on this same poll.
          recover_reason="herdr_unreachable"
          rearm_loss="agent_not_found"
        fi
        ;;
      ok)
        transient=0
        # Same classification that produced agent_not_found: class=ok means
        # agent_status is present. A pane envelope without it stays transient
        # and does not recover. timeout is a watch window, not an absence.
        if [[ "$lost" -eq 1 ]]; then
          case "$lost_reason" in
            agent_not_found|herdr_unreachable) recover_reason="$lost_reason" ;;
          esac
        fi
        candidate="$report"
        if [[ -z "$candidate" || ! -f "$candidate" ]]; then
          candidate="$(find_latest_report "$jobdir")"
        fi
        key="$(report_observation_key "$candidate" 2>/dev/null || true)"
        if [[ ( "$token" == "done" || "$token" == "idle" ) && -n "$candidate" && -f "$candidate" && -n "$key" && "$key" != "$seen" ]]; then
          # 부분 작성된 report 로 먼저 나가지 않는다: observation key 가 한
          # interval 동안 그대로일 때만 완료로 판정한다. 첫 관측은 pending.
          if [[ "$key" == "$pending" ]]; then
            action=completed
          else
            pending="$key"
            action=pending
          fi
        fi
        ;;
      *)
        # 일시 장애. 연속 관측 실패가 임계를 넘을 때에만 소멸로 판정한다.
        transient=$(( transient + 1 ))
        if [[ "$lost" -eq 0 ]] && (( transient > transient_max )); then
          action="lost:herdr_unreachable"
        fi
        ;;
    esac
    # One bounded, read-only transcript observation is allowed for Devin-kind
    # panes. The helper validates and records the actual Devin rung; admission
    # denial covers only scopefuel's hold members (the six free SWE-2 profiles
    # and, since hk 1729 r2, the two Fusion-Sol profiles).
    if [[ "$pane_kind" == devin && -n "$observed_rung" && "$class" == ok ]]; then
      local recent observer_result
      if recent="$("$HERDR" agent read "$pane" --source recent-unwrapped --lines 200 2>/dev/null)"; then
        observer_result="$(printf '%s\n' "$recent" | python3 "$observer_script" \
          --pane-kind "$pane_kind" --job "$job" --rung "$observed_rung" \
          --owner-lane "$owner" --state "$jobdir/free-limit-observer.json" --scopefuel "$scopefuel_bin" 2>/dev/null || true)"
        if [[ -n "$observer_result" ]]; then
          sentinel_log "$logfile" "$token" "$transient" "$observer_result"
        fi
      fi
    fi
    # The clear is below this check, so a recovery poll still has lost=1.
    # Count that poll toward the watch window. Otherwise a gone/ok flap
    # never has action=none while lost=0, the window never expires, and
    # the grace never accumulates either.
    # hk1888: the window is a watch window, not an absence. A poll that sees
    # the agent present (class=ok) ends the watch without a verdict: no
    # job.lost, no end record, no quota release. Anything else keeps the old
    # lost:timeout so a dead job is still cleaned up through the grace.
    if [[ ( "$action" == none || "$action" == pending ) && ( "$lost" -eq 0 || -n "$recover_reason" ) ]] && (( now - started >= timeout )); then
      if [[ "$class" == ok ]]; then # hk1888-watch-expired-live-guard
        if [[ "$action" == pending && -z "$late_pending" ]]; then # hk1959-late-pending
          late_pending=1
        else
          watch_expired=1
          [[ -n "$recover_reason" ]] || action="watch-expired"
        fi
      else
        action="lost:timeout"
      fi
    fi
    # Recovery is applied after this poll's classification and after the
    # record-watch, and before the grace check. A wake that slept across the
    # grace boundary still recovers when the agent is present. A job another
    # path already ended does not also get job.recovered.
    if [[ -n "$recover_reason" && "$action" == none ]]; then
      action="recovered:$recover_reason"
    fi
    log_extra=""
    if [[ -n "$recover_reason" && "$action" != recovered:* ]]; then
      log_extra="recovered=$recover_reason"
    fi
    if [[ "$action" == pending && -n "$late_pending" ]]; then
      log_extra="${log_extra:+$log_extra }late=1"
    fi
    if [[ "$action" == watch-expired ]]; then
      log_extra="elapsed=$(( now - started ))s"
    fi
    sentinel_log "$logfile" "$token" "$transient" "$action" "$log_extra"
    # #770: the job may have ended by another path while the sentinel slept —
    # done/joined/reap/prune all leave a work-terminal record. A terminal is
    # only honoured when it is newer than every revive, so a job claimed back
    # keeps its watcher.
    if sentinel_job_ended "$jobdir"; then
      # hk1798: another path ended this job; if it left a live quota record
      # behind, this waking sentinel is the last thing that can return it.
      local watch_release_rc=0
      release_job_quota_pool "$job" "$pane" || watch_release_rc=$? # hk1798-sentinel-watch-exit-release
      [[ "$watch_release_rc" != 2 ]] || sentinel_self_exit "$job" 0
      sentinel_log "$logfile" "$token" "$transient" "watch-exit"
      sentinel_self_exit "$job" 0
    fi
    if [[ -n "$recover_reason" ]]; then
      job_recovered_record "$job" "$owner" "$label" "$pane" "$recover_reason" "$(( now - lost_at ))"
      lost=0 # hk1770 clear
      lost_reason=""
      lost_at=0
    fi
    if [[ -n "$watch_expired" ]]; then # hk1888-watch-expired-exit
      # A recovery poll already logged recovered:*; the watch end gets its own
      # line. The job stays live: done, joined, reap and prune end it as usual.
      [[ "$action" == watch-expired ]] ||
        sentinel_log "$logfile" "$token" "$transient" "watch-expired" "elapsed=$(( now - started ))s"
      sentinel_self_exit "$job" 0
    fi
    case "$action" in
      completed)
        local completion_status
        if ! job_watch_current "$jobdir/events" "$pane"; then # hk1813-sentinel-completed-current-gate
          sentinel_log "$logfile" "$token" "$transient" "superseded" "watched-pane=$pane"
          sentinel_self_exit "$job" 0
        fi
        completion_status="$(completion_event "$job" "$owner" "$label" "$pane" "$candidate")"
        seen="$key"
        if [[ "$completion_status" == duplicate ]]; then
          note_duplicate_completion "$job" "$candidate"
          warn "job.completed already recorded for this report; suppressed duplicate (job=$job)"
        fi
        # hk1798: every live record of the job goes back through the shared
        # helper — the $resource-only release missed re-recorded pools and
        # silently skipped whenever ARBITER never reached the sentinel env.
        local release_rc=0
        release_job_quota_pool "$job" "$pane" || release_rc=$? # hk1798-sentinel-completed-release
        if [[ "$release_rc" == 2 ]]; then
          sentinel_log "$logfile" "$token" "$transient" "superseded" "watched-pane=$pane"
          sentinel_self_exit "$job" 0
        fi
        # #770: completed — including post-loss completion — ends the job, so
        # the sentinel leaves with it instead of becoming the leftover process
        # this task exists to remove.
        sentinel_self_exit "$job" 0
        ;;
      lost:*)
        completion_event "$job" "$owner" "$label" "$pane" "${report:-/dev/null}" job.lost "${action#lost:}" >/dev/null
        lost=1
        lost_reason="${action#lost:}"
        lost_at="$now" # hk1770 episode start
        ;;
    esac
    if [[ -n "$rearm_loss" ]]; then
      completion_event "$job" "$owner" "$label" "$pane" "${report:-/dev/null}" job.lost "$rearm_loss" >/dev/null
      lost=1
      lost_reason="$rearm_loss"
      lost_at="$now" # hk1770 rearm start
    fi
    if [[ "$lost" -eq 1 ]] && (( now - lost_at >= lost_grace )); then
      # #770: the grace expired without a completion. job.lost is not a hub
      # terminal, so declare the end (newest-revive wins, so a respawned job
      # is left alone) before the sentinel leaves.
      # hk1798: a revive without a work-terminal — a released-record reclaim
      # or a --job-dup-ok respawn — never trips the revive check, and a
      # reclaim still in flight has no job.spawned at all yet. job_watch_current
      # answers whether this watcher's pane is the live round's; when it is
      # not, declaring the end would release that round's records, so the
      # stale sentinel leaves quietly instead.
      if ! job_watch_current "$jobdir/events" "$pane"; then # hk1798-lost-grace-superseded
        sentinel_log "$logfile" "$token" "$transient" "superseded" "watched-pane=$pane"
        sentinel_self_exit "$job" 0
      fi
      local end_out=""
      end_out="$(job_end_record "$job" "$owner" abandoned "sentinel lost grace expired" "wrk sentinel" 2>/dev/null)" || true
      # The end declaration may lose a race to a revive; only a terminal result
      # authorizes releasing that job's quota rows.
      case "$end_out" in
        created|already-ended) release_job_quota_pool "$job" "$pane" || : ;; # hk1798-lost-grace-release
      esac
      sentinel_self_exit "$job" 0
    fi
    sleep "$interval"
  done
}

# 스폰 시점의 herdr 컨텍스트를 센티널 환경에 명시적으로 박아 넣는다. 분리된
# 센티널은 터미널에서 유도되는 세션 컨텍스트를 잃고, 서버가 비기본 세션에 있는
# 호스트에서는 기본 소켓을 물어 `agent get` 이 항상 빈 값을 냈다.
# WRK_SENTINEL_HERDR_SESSION/WRK_SENTINEL_HERDR_SOCKET 로 스폰 측이 명시 지정할
# 수 있고, 없으면 wrk 자신이 쓰던 값을 그대로 물려준다.
build_sentinel_env() {
  SENTINEL_ENV=()
  local session socket
  session="${WRK_SENTINEL_HERDR_SESSION:-${HERDR_SESSION:-}}"
  socket="${WRK_SENTINEL_HERDR_SOCKET:-${HERDR_SOCKET_PATH:-}}"
  [[ -z "$session" ]] || SENTINEL_ENV+=("HERDR_SESSION=$session")
  [[ -z "$socket" ]] || SENTINEL_ENV+=("HERDR_SOCKET_PATH=$socket")
  [[ -z "${HERDR_BIN_PATH:-}" ]] || SENTINEL_ENV+=("HERDR_BIN_PATH=$HERDR_BIN_PATH")
  [[ -z "$HERDR" ]] || SENTINEL_ENV+=("HERDR_BIN=$HERDR")
}

start_completion_sentinel() {
  local pidfile="$1"; shift
  local job="${1:-}"
  local requested_owner="${2:-}" requested_pane="${4:-}" existing_pane=""
  mkdir -p "$(dirname "$pidfile")"
  local existing="" existing_started=""
  if [[ -s "$pidfile" ]]; then
    IFS=$'\t' read -r existing existing_started <<<"$(sentinel_pidfile_fields "$pidfile")"
    # kill -0 alone proves nothing: a reused pid belongs to whatever unrelated
    # process took it, and letting that answer suppress this call would leave
    # the job without a sentinel (director-1 measured reused pids on this box
    # belonging to system daemons and to the director's own process). Only an
    # argv-verified sentinel for this job — start time agreeing when the file
    # recorded one — suppresses a new start.
    if [[ "$existing" =~ ^[0-9]+$ ]] && sentinel_pid_matches "$existing" "$job" && sentinel_start_matches "$existing" "$existing_started"; then
      existing_pane="$(sentinel_argv_pane "$existing" "$job" "$requested_owner")"
      if [[ -z "$existing_pane" || -z "$requested_pane" || "$existing_pane" == "$requested_pane" ]]; then
        return 0
      fi
      # hk1813 N6: the old watcher is proven to belong to this job, but it is
      # watching a different round. Stop only that pid before installing the
      # watcher for the new spawn; never sweep or pattern-match here.
      stop_completion_sentinel "$job" "$existing" # hk1813-replace-sentinel-pane-check
    fi
  fi
  rm -f "$pidfile"
  build_sentinel_env
  # The pidfile's second line records the spawn instant so a later reader can
  # prove the pid still belongs to the process it launched — a bare pid is
  # silently recyclable by the kernel.
  if [[ "${#SENTINEL_ENV[@]}" -gt 0 ]]; then
    ( nohup env "${SENTINEL_ENV[@]}" "$0" sentinel "$@" >>"${pidfile%.pid}.log" 2>&1 & printf '%s\nstarted=%s\n' "$!" "$(date +%s)" >"$pidfile" )
  else
    ( nohup "$0" sentinel "$@" >>"${pidfile%.pid}.log" 2>&1 & printf '%s\nstarted=%s\n' "$!" "$(date +%s)" >"$pidfile" )
  fi
}

# Spill-over placement is intentionally implemented outside spawn_cmd(): once a
# remote host is selected, its own wrk instance owns quota admission, pane
# creation, and landing verification. Keeping that boundary avoids duplicating
# the scopefuel/arbiter protocol across machines.
spillover_config() {
  printf '%s' "${WRK_HOSTS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/wrk/hosts.toml}"
}

spillover_trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

# This deliberately supports the small, documented hosts.toml surface rather
# than pretending to be a general TOML interpreter. Unknown keys remain future
# compatible and quoted values keep paths/SSH aliases free of shell evaluation.
spillover_value() {
  # A nonempty third argument keeps the raw lexeme (no quote stripping) — the
  # one caller that needs it is the [local] spawn boolean check, where the
  # accepted values are the bare TOML literals true/false and a quoted
  # spelling is a type error.
  local section="$1" key="$2" keep_quotes="${3:-}" config line current="" value=""
  config="$(spillover_config)"
  [[ -r "$config" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(spillover_trim "$line")"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" =~ ^\[([^]]+)\]$ ]]; then
      current="${BASH_REMATCH[1]}"
      continue
    fi
    [[ "$current" == "$section" && "$line" =~ ^${key}[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
    value="${BASH_REMATCH[1]}"
    value="${value%%#*}"
    value="$(spillover_trim "$value")"
    if [[ -z "$keep_quotes" && "$value" == \"*\" && "$value" == *\" ]]; then value="${value:1:${#value}-2}"; fi
    printf '%s' "$value"
    return 0
  done <"$config"
  return 1
}

spillover_hosts() {
  local config line
  config="$(spillover_config)"
  [[ -r "$config" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(spillover_trim "$line")"
    if ascii_re "$line" '^\[hosts\.([A-Za-z0-9_-]+)\]$'; then
      printf '%s\n' "${BASH_REMATCH[1]}"
    fi
  done <"$config"
}

# cwd_map and cwd_keys share one matcher.  A cwd equal to a key maps to the
# value; a sibling-worktree cwd <key>.<suffix> (suffix is [A-Za-z0-9._-]+) maps
# to <value>.<suffix>; a subpath cwd <key>/<rest> maps to <value>/<rest>.  A
# boundary-less prefix such as <key>foo never matches, and the longest
# matching key wins so nested keys stay reachable.
spillover_prefix_lookup() {
  python3 - "$1" "$2" <<'PY'
import re, sys
cwd, raw = sys.argv[1:]
def unq(s):
    return s.replace(r'\"', '"').replace(r'\\', '\\')
best = None
for local, remote in re.findall(r'"([^"\\]*(?:\\.[^"\\]*)*)"\s*=\s*"([^"\\]*(?:\\.[^"\\]*)*)"', raw):
    local, remote = unq(local), unq(remote)
    if cwd == local:
        kind, mapped = "exact", remote
    elif cwd.startswith(local + ".") and re.fullmatch(r"[A-Za-z0-9._-]+", cwd[len(local) + 1:]):
        kind, mapped = "suffix", remote + cwd[len(local):]
    elif cwd.startswith(local + "/"):
        kind, mapped = "subpath", remote + cwd[len(local):]
    else:
        continue
    if best is None or len(local) > best[0]:
        best = (len(local), kind, remote, mapped)
if best:
    print("\t".join(best[1:]))
PY
}

# Sets SPILL_CWD_KIND (exact|suffix|subpath), SPILL_CWD_BASE (the matched
# key's remote value) and SPILL_CWD_REMOTE (the derived remote path).
spillover_cwd_map() {
  local host="$1" cwd="$2" raw parsed
  SPILL_CWD_KIND="" SPILL_CWD_BASE="" SPILL_CWD_REMOTE=""
  raw="$(spillover_value "hosts.$host" cwd_map 2>/dev/null || true)"
  [[ -n "$raw" ]] || return 1
  parsed="$(spillover_prefix_lookup "$cwd" "$raw")"
  [[ -n "$parsed" ]] || return 1
  IFS=$'\t' read -r SPILL_CWD_KIND SPILL_CWD_BASE SPILL_CWD_REMOTE <<<"$parsed"
}

spillover_cwd_key() {
  local host="$1" cwd="$2" raw parsed
  raw="$(spillover_value "hosts.$host" cwd_keys 2>/dev/null || true)"
  [[ -n "$raw" ]] || return 1
  parsed="$(spillover_prefix_lookup "$cwd" "$raw")"
  [[ -n "$parsed" ]] || return 1
  printf '%s' "${parsed##*$'\t'}"
}

spillover_host_via() {
  local host="$1" via
  via="$(spillover_value "hosts.$host" via 2>/dev/null || true)"
  case "${via:-ssh}" in
    ssh|hub) printf '%s' "${via:-ssh}" ;;
    *) return 1 ;;
  esac
}

# [hub] session_machine_ids names the hub machine id of the panewire daemon
# serving each NON-fleet herdr session on this host (#965: a host can run a
# second daemon for a non-fleet session — M1's default session is the
# example — and only that daemon may carry the session's lane rows). Mapping
# a fleet session is not a supported use: every fleet worker would be
# registered as a global lane (#994). The value is a one-line inline table,
# read with the same quoted-pair matcher as cwd_map — still no TOML library.
hub_session_machine_id() {
  # rc 0: the machine id on stdout. rc 1: the map parsed but has no entry for
  # the session. rc 2: content the one-line matcher cannot read — a missing
  # closing brace (multi-line table), single-quoted keys, a bare value, or
  # any residue left between the quoted pairs (a partially parsed map) —
  # which the caller must warn about differently from "no entry" (#994/N4).
  python3 - "$1" "$2" <<'PY'
import re, sys
session, raw = sys.argv[1:]
def unq(s):
    return s.replace(r'\"', '"').replace(r'\\', '\\')
body = raw.strip()
if not (body[:1] == "{" and body[-1:] == "}"):
    raise SystemExit(2)
inner = body[1:-1]
pair = re.compile(r'"([^"\\]*(?:\\.[^"\\]*)*)"\s*=\s*"([^"\\]*(?:\\.[^"\\]*)*)"')
pairs = pair.findall(inner)
# Anything the pair matcher left behind — an unquoted key, a bare value, a
# second table — is a map we only partially read; that is a parse failure,
# never a missing entry (#1010/N5).
if pair.sub("", inner).strip(" \t,"):
    raise SystemExit(2)
for key, value in pairs:
    if unq(key) == session:
        print(unq(value))
        raise SystemExit(0)
raise SystemExit(2 if (not pairs and inner.strip()) else 1)
PY
}

# panewire's own lane-name rule — lanes_write.go laneNamePattern
# ^[a-z0-9-]{1,32}$, enforced on the lanes add/rm operand (lanes_cli.go).
# A value outside it must never reach panewire argv (#994/N2).
hub_lane_name_valid() {
  ascii_re "$1" '^[a-z0-9-]{1,32}$'
}

# Print one verdict line for LANE's row in a `panewire lanes ls` envelope,
# compared against the recorded machine+pane: "match" when both fields equal
# the recorded values, "mismatch OBSERVED" with the observed machine:pane
# (control characters backslash-escaped so the verdict stays a single line),
# and nothing when the lane is absent. The compare happens here, on the
# parsed fields: piping the row back through an IFS=tab read collapses empty
# fields and truncates at an embedded newline, which can slide another
# machine's row into a false match (#1010/N2). Exit 1 when the listing is
# not the JSON the CLI emits — a row we could not read is a row we may not
# remove (#994/N3).
hub_lane_lookup() {
  python3 - "$1" "$2" "$3" "$4" <<'PY'
import json, sys
lane, want_machine, want_pane, raw = sys.argv[1:]
try:
    doc = json.loads(raw)
except ValueError:
    raise SystemExit(1)
rows = doc.get("lanes") if isinstance(doc, dict) else None
if not isinstance(rows, list):
    raise SystemExit(1)
def disp(s):
    return s.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t")
for row in rows:
    if isinstance(row, dict) and row.get("lane") == lane:
        machine = row.get("machine")
        pane = row.get("pane")
        machine = machine if isinstance(machine, str) else ""
        pane = pane if isinstance(pane, str) else ""
        if machine == want_machine and pane == want_pane:
            print("match")
        else:
            print("mismatch %s:%s" % (disp(machine), disp(pane)))
        break
PY
}

# #965: a worker/tester spawned into a herdr session served by its own
# panewire daemon needs a hub lane row on that daemon's machine id — without
# one the daemon suppresses the pane's idle-wakes as parentless_lane /
# unknown_owner (2026-09-29: a default-session worker had no lane and its
# builder stalled until the desk relayed by hand). The session→machine map is
# hosts.toml's [hub] session_machine_ids; the effective session is
# WRK_SENTINEL_HERDR_SESSION, else HERDR_SESSION, else the herdr default.
# #1397: --role builder joins this path. A builder NEEDS its own lane with a
# parent — job.joined and job.escalate route to the owner lane's parent, so
# an unregistered builder loses exactly the events the parent waits on
# (workers get by without one: the hub falls back to the node heartbeat's
# active jobs). The builder lane is --lane, parented on --parent; its machine
# is the mapped session daemon when the effective session is in the map, else
# [hub] machine_id — this host's own hub machine id, the id a remote spawner
# names the host by in its hosts.toml. A fleet session must still never be
# mapped (#994), and workers keep the map-only rule — a fleet worker must not
# become a global lane — so machine_id is builder fallback only.
# Runs only once the pane is provably up, and before the spawn receipt so
# hub_lane/hub_lane_machine land in the same job meta as task_id/keep.
# Best-effort at every step: an unmapped session, an unconfigured machine, a
# missing --owner, absent hub credentials or a panewire refusal warn once and
# leave the spawn standing — a missing lane is the pre-#965 behavior, not a
# new failure, so this never fails the spawn and never retries silently.
# Sets HUB_LANE and HUB_LANE_MACHINE for the receipt payload and the OK line;
# the caller turns an empty HUB_LANE on a builder into lane=UNREGISTERED and,
# under WRK_LANE_STRICT=1, exit 82 — which is why every builder early-return
# here warns exactly once.
hub_lane_register() {
  HUB_LANE="" HUB_LANE_MACHINE="" HUB_LANE_SELF=""
  # Child seats use the worker lane/credential topology inside this helper.
  local ROLE="$ROLE"
  case "$ROLE" in tester|reviewer|counsel) ROLE=worker ;; esac
  [[ "$ROLE" == worker || "$ROLE" == builder ]] || return 0
  # #1397/(a): a delegated remote spawn defers its lane row to the ssh
  # initiator — unless the execution host holds a lanes token bound to the
  # deferred machine id, in which case hk 1446 self-registers below.
  # --lane-defer carries the
  # hub machine id the initiator names this host by (its hosts.toml key).
  # Without a matching lanes token this wrk performs no `lanes add`; it records hub_lane/hub_lane_machine in
  # the job.spawned receipt as the claim of what the initiator will register,
  # so `wrk reap` on THIS host — the only place the pane check can pass —
  # removes the row through the same machine+pane guard. If the initiator's
  # add fails, the receipt names a lane that is not there and the guarded
  # removal harmlessly skips it. The flag (not an env var) is deliberate:
  # wrk's env propagates into the spawned pane, where an inherited defer
  # would mute every spawn that pane later makes.
  if [[ -n "${LANE_DEFER:-}" ]]; then
    local defer_lane
    if [[ "$ROLE" == builder ]]; then defer_lane="$BUILDER_LANE"; else defer_lane="$LABEL"; fi
    if hub_lane_name_valid "$defer_lane"; then
      HUB_LANE="$defer_lane" HUB_LANE_MACHINE="$LANE_DEFER"
      # hk 1446: a builder whose execution host holds a lanes token bound to
      # the very machine id --lane-defer carries registers its own lane right
      # here — the receipt already names lane+machine, so the same machine+
      # pane guard reaps it. The marker on the OK line tells the initiator
      # its add is unnecessary. Every other shape — no lanes token, a token
      # naming another machine, a refused or failed add — keeps the
      # deferral untouched (the add only warns, never fails the spawn).
      if [[ "$ROLE" == builder && "${ARBITER_JOB_REGISTERED:-0}" -eq 1 ]] &&
         hub_lane_self_register; then
        HUB_LANE_SELF=1
      fi
    fi
    return 0
  fi
  local session raw machine="" machine_rc=0 panewire hub_url token_env cf_env rc=0
  local lanes_env lanes_machine lane_name parent_lane
  local args=()
  session="${WRK_SENTINEL_HERDR_SESSION:-${HERDR_SESSION:-default}}"
  raw="$(spillover_value hub session_machine_ids 2>/dev/null || true)"
  # No map at all means this installation has not opted in; a worker stays
  # silent like the hub quota gate does on absent hub keys. A builder still
  # has its [hub] machine_id fallback below.
  if [[ -z "$raw" && "$ROLE" != builder ]]; then return 0; fi
  if [[ -n "$raw" ]]; then
    set +e
    machine="$(hub_session_machine_id "$session" "$raw" 2>/dev/null)"
    machine_rc=$?
    set -e
    # #1010/N5: any rc beyond 0/1 — the matcher's own 2, a crashed interpreter,
    # anything in between — is a parse failure, not a missing entry; stderr is
    # silenced above so a traceback never leaks into the spawn's. A builder
    # must not fall back to machine_id here: the session might sit in the map
    # we could not read, which would put the lane on the wrong daemon.
    if [[ "$machine_rc" -ne 0 && "$machine_rc" -ne 1 ]]; then
      warn "hub lane not registered (the [hub] session_machine_ids value could not be parsed; use the one-line {\"session\" = \"machine\"} inline table)"
      return 0
    fi
  fi
  # hk 1137: a machine id resolved from session_machine_ids must be ASCII
  # before it can reach a mismatch warning or a `lanes add` argv — refuse
  # closed without echoing the value.
  if [[ -n "$machine" ]] && ! ascii_re "$machine" '^[A-Za-z0-9._-]{1,64}$'; then
    warn "hub lane not registered (the session's machine id is malformed)"
    return 0
  fi
  if [[ -z "$machine" && "$ROLE" == builder ]]; then
    machine="$(spillover_value hub machine_id 2>/dev/null || true)"
    # Same allowlist the lanes-token HUB_MACHINE_ID scan enforces — a
    # malformed value warns once WITHOUT it and skips, never reaching argv.
    if [[ -n "$machine" ]] && ! ascii_re "$machine" '^[A-Za-z0-9._-]{1,64}$'; then
      warn "hub lane not registered ([hub] machine_id is malformed)"
      return 0
    fi
  fi
  if [[ -z "$machine" ]]; then
    if [[ "$ROLE" == builder ]]; then
      warn "hub lane not registered (herdr session '$session' has no session_machine_ids entry and [hub] machine_id is unset)"
    else
      warn "hub lane not registered (herdr session '$session' has no session_machine_ids entry)"
    fi
    return 0
  fi
  # #994/S1: no lane without its job.spawned receipt — a registration the job
  # record never carries is a row `wrk reap` can never remove. The same gate
  # quota_hub_policy_gate uses.
  if [[ "${ARBITER_JOB_REGISTERED:-0}" -ne 1 ]]; then
    warn "hub lane not registered (no arbiter job record; a lane without a spawn receipt is unreapable)"
    return 0
  fi
  # What gets registered differs by role: a worker lane is its own label,
  # parented on the spawning builder's lane (--owner); a builder lane is its
  # own --lane, parented on --parent — the route job.joined/job.escalate
  # take. --parent is die-required earlier for builders, but an empty parent
  # stays a warn-and-skip either way.
  if [[ "$ROLE" == builder ]]; then
    lane_name="$BUILDER_LANE" parent_lane="$PARENT_LANE"
  else
    lane_name="$LABEL" parent_lane="$OWNER"
  fi
  if [[ -z "$parent_lane" ]]; then
    if [[ "$ROLE" == builder ]]; then
      warn "hub lane not registered (--parent is unset; the builder lane's parent is required)"
    else
      warn "hub lane not registered (--owner is unset; the spawning builder's lane is required as parent)"
    fi
    return 0
  fi
  # #994/N2: the lane name becomes panewire argv verbatim — refuse names
  # outside the daemon's own lane rule before the value can reach the
  # command line.
  if ! hub_lane_name_valid "$lane_name"; then
    warn "hub lane not registered (lane '$lane_name' is not a valid panewire lane name)"
    return 0
  fi
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  # #1037: a dedicated lanes credential — a node token bound to this host's
  # own machine id — wins over the operator file. It may reach only the lanes
  # routes; every other hub path keeps its own credential. #1397: the
  # operator file itself (operator_token_env) authorizes lanes too, ahead of
  # the legacy hub_token_env fallback — but only for a builder lane. A worker
  # lane keeps the pre-#1397 chain (lanes_token_env, then hub_token_env):
  # operator_token_env is never read for a worker, and hub_token_env doubles
  # as the quota-gate opt-in a lanes-only host deliberately leaves unset.
  token_env="$(hub_lanes_credential "$ROLE" 2>/dev/null || true)"
  lanes_env="$(spillover_value hub lanes_token_env 2>/dev/null || true)"
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  if [[ -z "$hub_url" || -z "$token_env" ]]; then
    if [[ "$ROLE" == builder ]]; then
      warn "hub lane not registered (hub_url missing or none of lanes_token_env, operator_token_env or hub_token_env set in hosts.toml [hub])"
    else
      warn "hub lane not registered (hub_url missing or neither hub_token_env nor lanes_token_env set in hosts.toml [hub])"
    fi
    return 0
  fi
  # A lanes credential authorizes lanes on its own HUB_MACHINE_ID only — with
  # a different machine the hub refuses the add (lane_machine_mismatch), so
  # compare first and skip. The file is scanned for only HUB_MACHINE_ID,
  # never sourced; HUB_TOKEN is never matched or printed. Preserve whitespace
  # in the value so the ASCII check rejects a near-match instead of silently
  # normalizing it into the target machine id. Fail closed: anything outside
  # ^[A-Za-z0-9._-]{1,64}$ warns once WITHOUT the value and skips. An unreadable
  # file or unset/empty key still falls through to panewire's own loader error.
  if [[ -n "$lanes_env" ]]; then
    lanes_machine="$(spillover_env_machine_id "$lanes_env" 2>/dev/null || true)"
    if [[ -n "$lanes_machine" ]]; then
      if ! ascii_re "$lanes_machine" '^[A-Za-z0-9._-]{1,64}$'; then
        warn "hub lane not registered (lanes_token_env HUB_MACHINE_ID is malformed)"
        return 0
      fi
      if [[ "$lanes_machine" != "$machine" ]]; then
        warn "hub lane not registered (lanes_token_env HUB_MACHINE_ID '$lanes_machine' does not match the session's machine '$machine')"
        return 0
      fi
    fi
  fi
  panewire="${PANEWIRE_BIN:-panewire}"
  if [[ "$panewire" == */* ]]; then
    [[ -x "$panewire" ]] || {
      warn "hub lane not registered (panewire unavailable: $panewire)"
      return 0
    }
  elif ! command -v "$panewire" >/dev/null 2>&1; then
    warn "hub lane not registered (panewire unavailable)"
    return 0
  fi
  # The token env values go to panewire as FILE PATHS; wrk itself opens only
  # the lanes token's HUB_MACHINE_ID line, for the mismatch check above.
  args=(lanes add "$lane_name" --machine "$machine" --pane "$PANE" --parent "$parent_lane"
        --hub-url "$hub_url" --hub-token-env "$token_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  set +e
  "$panewire" "${args[@]}" >/dev/null 2>&1
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    warn "hub lane not registered (panewire lanes add exited $rc)"
    return 0
  fi
  HUB_LANE="$lane_name" HUB_LANE_MACHINE="$machine"
}

# hk 1446: the execution host's half of a delegated remote builder spawn
# when it holds its own lanes token. Runs only under --lane-defer for a
# builder lane: a lanes_token_env file whose HUB_MACHINE_ID IS the deferred
# machine id (byte equality after the same ascii check the non-deferred
# path applies) authorizes this host's own machine's lanes, so the lane the
# initiator would have added is added here instead — same lane name, same
# --parent, the deferred id as machine, and the spawned pane. Returns 0
# only on a confirmed add. Anything else — no lanes token, an unreadable
# file, an unset or mismatched HUB_MACHINE_ID, a missing hub_url or
# panewire, a refused add — returns 1 and the caller defers exactly as
# before. operator_token_env and hub_token_env never count: a remote wrk
# has no business presenting the initiator's credential topology, and a
# node token bound to another machine would be refused anyway. The scan
# reads the HUB_MACHINE_ID line only; the token file still reaches panewire
# as a path, and a malformed id warns once without the value. The parser
# preserves all value whitespace (stripping only the assignment's line
# ending and optional surrounding quotes) so a near-match cannot pass.
hub_lane_self_register() {
  local hub_url lanes_env lanes_machine cf_env panewire rc=0
  local args=()
  lanes_env="$(spillover_value hub lanes_token_env 2>/dev/null || true)"
  [[ -n "$lanes_env" ]] || return 1
  lanes_machine="$(spillover_env_machine_id "$lanes_env" 2>/dev/null || true)"
  [[ -n "$lanes_machine" ]] || return 1
  if ! ascii_re "$lanes_machine" '^[A-Za-z0-9._-]{1,64}$'; then
    warn "hub lane self-registration skipped (lanes_token_env HUB_MACHINE_ID is malformed)"
    return 1
  fi
  [[ "$lanes_machine" == "$LANE_DEFER" ]] || return 1
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  [[ -n "$hub_url" ]] || return 1
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  panewire="${PANEWIRE_BIN:-panewire}"
  if [[ "$panewire" == */* ]]; then
    [[ -x "$panewire" ]] || return 1
  elif ! command -v "$panewire" >/dev/null 2>&1; then
    return 1
  fi
  args=(lanes add "$BUILDER_LANE" --machine "$LANE_DEFER" --pane "$PANE" --parent "$PARENT_LANE"
        --hub-url "$hub_url" --hub-token-env "$lanes_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  set +e
  "$panewire" "${args[@]}" >/dev/null 2>&1
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    warn "hub lane self-registration failed (panewire lanes add exited $rc); deferring to the initiator"
    return 1
  fi
  return 0
}

# #1397/(a): the ssh initiator's half of a delegated remote spawn. An
# execution host without its own lanes token cannot register its own lane —
# PUT /v1/lanes wants the operator credential, which lives on the
# initiating host — so the initiator runs
# `panewire lanes add` itself once the remote spawn answers rc 0, with
# machine = the hosts.toml key it reached the host by (that key IS the
# host's hub machine id: mac-dev, rpi, desktop). The remote wrk already
# recorded lane+machine in its job.spawned receipt through --lane-defer, so
# `wrk reap` on the execution host removes the row through the same
# machine+pane-guarded `lanes rm` — symmetric, and `lanes rm` is a hub call
# any operator-credentialed host can make.
# Sets HUB_REMOTE_LANE to the lane name on a confirmed add; every failure is
# one warning and a skip — the pane is already up on the remote, so a
# registration failure must never fail the spawn (the builder's strict exit
# is decided by the caller).
hub_lane_register_remote() {
  HUB_REMOTE_LANE=""
  local host="$1" pane="$2" lane="$3" parent="$4"
  local hub_url token_env cf_env panewire rc=0
  local args=()
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  # The remote add writes a lane on ANOTHER machine — a node-scoped
  # lanes_token_env is only known to authorize this host's own lanes, so the
  # operator credential wins here even when a lanes token is also configured.
  # Without an operator credential the shared lanes chain is still the
  # fallback (a lanes-only initiator stays warn-only, never hard-refused).
  token_env="$(spillover_value hub operator_token_env 2>/dev/null || true)"
  [[ -n "$token_env" ]] || token_env="$(hub_lanes_credential builder 2>/dev/null || true)"
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  # Only builders reach here — a remote worker keeps the #965 contract and
  # this host never names its lane. A builder always names why its lane is
  # missing — that is the #1397 fail-loud rule.
  if [[ -z "$hub_url" ]]; then
    warn "hub lane not registered for remote host '$host' (hub_url unset in hosts.toml [hub])"
    return 0
  fi
  if [[ -z "$token_env" ]]; then
    warn "hub lane not registered for remote host '$host' (none of lanes_token_env, operator_token_env or hub_token_env set in hosts.toml [hub])"
    return 0
  fi
  if [[ -z "$pane" ]]; then
    warn "hub lane not registered for remote host '$host' (the remote OK line carried no pane=; the pane is up but the lane could not be targeted)"
    return 0
  fi
  if ! hub_lane_name_valid "$lane"; then
    warn "hub lane not registered for remote host '$host' (lane '$lane' is not a valid panewire lane name)"
    return 0
  fi
  if [[ -z "$parent" ]]; then
    warn "hub lane not registered for remote host '$host' (--parent is unset; the builder lane's parent is required)"
    return 0
  fi
  panewire="${PANEWIRE_BIN:-panewire}"
  if [[ "$panewire" == */* ]]; then
    [[ -x "$panewire" ]] || {
      warn "hub lane not registered for remote host '$host' (panewire unavailable: $panewire)"
      return 0
    }
  elif ! command -v "$panewire" >/dev/null 2>&1; then
    warn "hub lane not registered for remote host '$host' (panewire unavailable)"
    return 0
  fi
  # Credentials reach panewire as FILE PATHS, same as hub_lane_register —
  # wrk never opens them.
  args=(lanes add "$lane" --machine "$host" --pane "$pane" --parent "$parent"
        --hub-url "$hub_url" --hub-token-env "$token_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  set +e
  "$panewire" "${args[@]}" >/dev/null 2>&1
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    warn "hub lane not registered for remote host '$host' (panewire lanes add exited $rc)"
    return 0
  fi
  HUB_REMOTE_LANE="$lane"
}

# #1397: the credential chain a lanes route resolves — `panewire lanes
# add/ls/rm` here, in hub_lane_remove, and the lanes-missing audit. The chain
# is per-role: a BUILDER lane resolves lanes_token_env (#1037, a node token
# bound to this host's machine id), then operator_token_env (the operator
# file PUT /v1/lanes requires), then hub_token_env (the legacy fallback that
# is also the quota gate's opt-in, #1138). A WORKER lane keeps the pre-#1397
# contract: lanes_token_env then hub_token_env — operator_token_env is never
# read for a worker, so a mapped worker on an operator-only host registers
# nothing exactly as on main. The default is the worker chain; callers that
# speak for builders (remote registration, the all-roles audit) pass it.
hub_lanes_credential() {
  local role="${1:-worker}" v
  v="$(spillover_value hub lanes_token_env 2>/dev/null || true)"
  if [[ "$role" == builder && -z "$v" ]]; then
    v="$(spillover_value hub operator_token_env 2>/dev/null || true)"
  fi
  [[ -n "$v" ]] || v="$(spillover_value hub hub_token_env 2>/dev/null || true)"
  [[ -n "$v" ]] || return 1
  printf '%s' "$v"
}

# The reverse of hub_lane_register for `wrk reap --apply` and for the
# receipt-failure compensation in the spawn path: remove the lane only when
# `panewire lanes ls` still shows it bound to the machine and pane the job's
# receipt recorded. Lanes are keyed by label in one global namespace — a
# label reused by a later spawn must never lose that spawn's live row to the
# earlier job's reap (#994/N3). The lane value is validated against
# panewire's own lane-name rule before it may reach argv (#994/N2), and a
# `lanes ls` that cannot confirm the row — refusal, unreadable output, no
# such lane, or a row belonging to another machine/pane — skips the removal:
# never remove blind. A removal failure warns and the close still stands;
# `panewire lanes-audit` is where leftovers surface.
hub_lane_remove() {
  local lane="$1" want_machine="${2:-}" want_pane="${3:-}" lane_role="${4:-worker}" panewire hub_url token_env cf_env rc=0
  local listing verdict
  local args=()
  if ! hub_lane_name_valid "$lane"; then
    warn "hub lane '$lane' not removed (not a valid panewire lane name)"
    return 0
  fi
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  # The credential chain follows the lane's own role (#1397): a worker lane
  # resolves lanes_token_env then hub_token_env exactly as on main —
  # operator_token_env is never read for it — while a builder lane also
  # accepts the operator file in between. An unknown role defaults to the
  # worker chain: it can only ever see less, never more. A lanes
  # credential's own `lanes ls` is already machine-scoped hub-side, so no
  # further check is needed here.
  token_env="$(hub_lanes_credential "$lane_role" 2>/dev/null || true)"
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  if [[ -z "$hub_url" || -z "$token_env" ]]; then
    if [[ "$lane_role" == builder ]]; then
      warn "hub lane '$lane' not removed (hub_url missing or none of lanes_token_env, operator_token_env or hub_token_env set in hosts.toml [hub])"
    else
      warn "hub lane '$lane' not removed (hub_url missing or neither hub_token_env nor lanes_token_env set in hosts.toml [hub])"
    fi
    return 0
  fi
  panewire="${PANEWIRE_BIN:-panewire}"
  args=(lanes ls --hub-url "$hub_url" --hub-token-env "$token_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  set +e
  listing="$("$panewire" "${args[@]}" 2>/dev/null)"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    warn "hub lane '$lane' not removed (panewire lanes ls exited $rc)"
    return 0
  fi
  set +e
  verdict="$(hub_lane_lookup "$lane" "$want_machine" "$want_pane" "$listing")"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    warn "hub lane '$lane' not removed (panewire lanes ls output was not parseable)"
    return 0
  fi
  if [[ -z "$verdict" ]]; then
    warn "hub lane '$lane' not removed (no such lane on the hub)"
    return 0
  fi
  if [[ "$verdict" != match ]]; then
    warn "hub lane '$lane' not removed (the lane now belongs to ${verdict#mismatch }, not the recorded $want_machine:$want_pane)"
    return 0
  fi
  args=(lanes rm "$lane" --hub-url "$hub_url" --hub-token-env "$token_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  set +e
  "$panewire" "${args[@]}" >/dev/null 2>&1
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    warn "hub lane '$lane' not removed (panewire lanes rm exited $rc)"
    return 0
  fi
}

# Read precisely one shell-style assignment without sourcing an env file.  The
# host configuration points at operator-managed files, so neither arbitrary
# expansion nor their contents may reach this process's logs.
spillover_env_key() {
  local file="$1" key="$2"
  [[ -r "$file" ]] || return 1
  python3 - "$file" "$key" <<'PY'
import re, sys

path, key = sys.argv[1:]
assignment = re.compile(r"^\s*(?:export\s+)?" + re.escape(key) + r"\s*=\s*(.*?)\s*$")
with open(path, encoding="utf-8") as env_file:
    for line in env_file:
        match = assignment.match(line)
        if not match:
            continue
        value = match.group(1)
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if value:
            print(value)
            raise SystemExit(0)
raise SystemExit(1)
PY
}

# Read HUB_MACHINE_ID without trimming the value. Unlike the general
# credential-key reader above, lane authorization compares this value to a
# machine id byte-for-byte: only the line ending and optional outer quotes
# are syntax. A trailing or leading space must fail the ASCII allowlist.
spillover_env_machine_id() {
  local file="$1"
  [[ -r "$file" ]] || return 1
  python3 - "$file" <<'PY'
import re, sys

path = sys.argv[1]
assignment = re.compile(r"^[ \t]*(?:export[ \t]+)?HUB_MACHINE_ID[ \t]*=(.*)$")
with open(path, encoding="utf-8", newline="") as env_file:
    for line in env_file:
        if line.endswith("\n"):
            line = line[:-1]
        if line.endswith("\r"):
            line = line[:-1]
        match = assignment.match(line)
        if not match:
            continue
        value = match.group(1)
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if value:
            print(value)
            raise SystemExit(0)
raise SystemExit(1)
PY
}

spillover_hub_http_base() {
  local hub_url="$1"
  case "$hub_url" in
    wss://*) printf 'https://%s' "${hub_url#wss://}" ;;
    ws://*) printf 'http://%s' "${hub_url#ws://}" ;;
    https://*|http://*) printf '%s' "$hub_url" ;;
    *) return 1 ;;
  esac
}

spillover_load5() {
  local proc="${WRK_PROC_LOADAVG:-/proc/loadavg}" load
  if [[ -r "$proc" ]]; then
    awk '{print $2}' "$proc"
    return 0
  fi
  if command -v sysctl >/dev/null 2>&1; then
    load="$(sysctl -n vm.loadavg 2>/dev/null || true)"
    awk '{gsub(/[{}]/, ""); print $2}' <<<"$load"
    return 0
  fi
  return 1
}

spillover_ncpu() {
  if [[ -n "${WRK_TEST_NCPU:-}" ]]; then printf '%s' "$WRK_TEST_NCPU"; return 0; fi
  if [[ -r /proc/cpuinfo ]]; then
    getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || true
  else
    sysctl -n hw.ncpu 2>/dev/null || true
  fi
}

spillover_active_workers() {
  local output
  if ! output="$("$HERDR" agent list 2>/dev/null)"; then return 1; fi
  python3 -c 'import json,sys; d=json.load(sys.stdin); a=d.get("result",d).get("agents",[]); print(sum(x.get("agent_status")=="working" for x in a))' <<<"$output" 2>/dev/null
}

spillover_throttled() {
  local therm limit
  if [[ -n "${WRK_TEST_THROTTLED:-}" ]]; then
    [[ "$WRK_TEST_THROTTLED" == 1 ]]
    return
  fi
  command -v pmset >/dev/null 2>&1 || return 1
  therm="$(pmset -g therm 2>/dev/null || true)"
  limit="$(sed -nE 's/.*CPU_Speed_Limit[[:space:]]*=[[:space:]]*([0-9]+).*/\1/p' <<<"$therm" | head -1)"
  [[ "$limit" =~ ^[0-9]+$ && "$limit" -lt 100 ]]
}

spillover_local_measure() {
  SPILL_LOAD="$(spillover_load5 2>/dev/null || true)"
  SPILL_NCPU="$(spillover_ncpu 2>/dev/null || true)"
  SPILL_ACTIVE="$(spillover_active_workers 2>/dev/null || true)"
  SPILL_RATIO="unknown"
  if [[ "$SPILL_LOAD" =~ ^[0-9]+([.][0-9]+)?$ && "$SPILL_NCPU" =~ ^[1-9][0-9]*$ ]]; then
    SPILL_RATIO="$(awk -v l="$SPILL_LOAD" -v n="$SPILL_NCPU" 'BEGIN { printf "%.3f", l/n }')"
  fi
}

spillover_local_is_pressured() {
  local max_ratio max_active
  spillover_local_measure
  SPILL_REASON="local-healthy"
  max_ratio="$(spillover_value local max_load_ratio 2>/dev/null || true)"
  max_active="$(spillover_value local max_active 2>/dev/null || true)"
  if [[ "$max_ratio" =~ ^[0-9]+([.][0-9]+)?$ && "$SPILL_RATIO" != unknown ]] &&
    awk -v actual="$SPILL_RATIO" -v max="$max_ratio" 'BEGIN { exit !(actual >= max) }'; then
    SPILL_REASON="load-ratio=${SPILL_RATIO}>=${max_ratio}"
    return 0
  fi
  if [[ "$max_active" =~ ^[0-9]+$ && "$SPILL_ACTIVE" =~ ^[0-9]+$ && "$SPILL_ACTIVE" -ge "$max_active" ]]; then
    SPILL_REASON="active=${SPILL_ACTIVE}>=${max_active}"
    return 0
  fi
  if spillover_throttled; then
    SPILL_REASON="cpu-throttled"
    return 0
  fi
  return 1
}

spillover_log() {
  local host="$1" reason="$2" log
  log="${WRK_SPILLOVER_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/wrk/spillover.log}"
  mkdir -p "$(dirname "$log")" 2>/dev/null || { warn "spill-over log directory unavailable: $log"; return 0; }
  printf '%s source=%s load5=%s ncpu=%s ratio=%s active=%s host=%s reason=%s\n' \
    "$(date -Iseconds)" "${SPILL_DECISION_SOURCE:-unknown}" "${SPILL_LOAD:-unknown}" "${SPILL_NCPU:-unknown}" \
    "${SPILL_RATIO:-unknown}" "${SPILL_ACTIVE:-unknown}" "$host" "$reason" >>"$log" 2>/dev/null ||
    warn "spill-over log unavailable: $log"
}

# The hub owns placement policy. This adapter is deliberately narrow because
# its contract lives with panewire: wrk consumes only decision/candidates/reason
# from `panewire place`, then performs the selected spawn. No URL, token, IP,
# or machine name is embedded in this public CLI.
spillover_hub_placement() {
  local reply parsed panewire hub_url token_env cf_env args
  SPILL_HUB_STATUS=unavailable
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  token_env="$(spillover_value hub hub_token_env 2>/dev/null || true)"
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  [[ -n "$hub_url" && -n "$token_env" ]] || return 1
  panewire="${PANEWIRE_BIN:-panewire}"
  args=(place --class worker --cwd "$1" --hub-url "$hub_url" --hub-token-env "$token_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  if ! reply="$("$panewire" "${args[@]}" 2>/dev/null)"; then
    return 1
  fi
  if ! parsed="$(python3 -c '
import json, sys
d = json.load(sys.stdin)
decision = d.get("decision")
reason = d.get("reason", "")
if decision is not None and not isinstance(decision, str):
    raise ValueError("invalid placement decision")
decision_host = decision or ""
eligible = []
for candidate in d.get("candidates", []):
    if isinstance(candidate, str):
        value, candidate_reason, connected = candidate, "", True
    elif isinstance(candidate, dict):
        # PlacementCandidate canonical key is machine.  host/target remain
        # accepted only for backward-compatible hub fixtures/responses.
        value = candidate.get("machine") or candidate.get("host") or candidate.get("target") or ""
        candidate_reason = candidate.get("reason", "")
        connected = candidate.get("connected", True)
    else:
        continue
    if not isinstance(value, str) or not value or connected is False or "not_accepting" in str(candidate_reason):
        continue
    if value not in eligible: eligible.append(value)
if isinstance(decision_host, str) and decision_host and decision_host in eligible:
    eligible.remove(decision_host)
    eligible.insert(0, decision_host)
print(eligible[0] if eligible else "")
print(str(reason).replace("\n", " "))
print(*eligible[1:], sep="\n")
' <<<"$reply")"; then
    SPILL_HUB_STATUS=invalid
    return 1
  fi
  {
    IFS= read -r SPILL_HUB_HOST
    IFS= read -r SPILL_HUB_REASON || true
  } <<<"$parsed"
  SPILL_HUB_CANDIDATES=()
  while IFS= read -r candidate; do [[ -z "$candidate" ]] || SPILL_HUB_CANDIDATES+=("$candidate"); done < <(tail -n +3 <<<"$parsed")
  # Fixture-only observability: lets the contract test assert the exact hub
  # ordering after eligibility filtering without contacting a live hub.
  if [[ -n "${WRK_SPILLOVER_CANDIDATES_LOG:-}" ]]; then
    {
      printf '%s\n' "$SPILL_HUB_HOST"
      for candidate in "${SPILL_HUB_CANDIDATES[@]:-}"; do
        [[ -z "$candidate" ]] || printf '%s\n' "$candidate"
      done
    } >"$WRK_SPILLOVER_CANDIDATES_LOG"
  fi
  SPILL_HUB_STATUS=ok
  return 0
}

spillover_probe_host() {
  local host="$1" ssh_name output capacity load probe_err rc
  ssh_name="$(spillover_value "hosts.$host" ssh 2>/dev/null || true)"
  [[ -n "$ssh_name" ]] || ssh_name="$host"
  SPILL_PROBE_ERR=""
  SPILL_PROBE_RC=1
  SPILL_PROBE_DETAIL=""
  probe_err="$(mktemp)"
  set +e
  output="$("${WRK_SSH_BIN:-ssh}" -o BatchMode=yes "$ssh_name" 'uptime; herdr agent list' 2>"$probe_err")"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    SPILL_PROBE_REASON="ssh-unreachable"
    SPILL_PROBE_ERR="$(cat "$probe_err" 2>/dev/null)"
    # The real ssh rc (255 for a dead host, 2 for a remote-side refusal) is
    # what the probe line reports; try_candidate normalizes it for the router.
    SPILL_PROBE_RC="$rc"
    rm -f "$probe_err"
    return 1
  fi
  SPILL_REMOTE_LOAD="$(sed -nE 's/.*load averages?:[[:space:]]*([0-9.]+).*/\1/p' <<<"$output" | head -1)"
  SPILL_REMOTE_ACTIVE="$(python3 -c 'import json,re,sys; s=sys.stdin.read(); m=re.search(r"\{.*\}",s,re.S); d=json.loads(m.group(0)); a=d.get("result",d).get("agents",[]); print(sum(x.get("agent_status")=="working" for x in a))' <<<"$output" 2>/dev/null || true)"
  capacity="$(spillover_value "hosts.$host" capacity 2>/dev/null || true)"
  [[ "$capacity" =~ ^[1-9][0-9]*$ ]] || capacity=1
  if [[ "$SPILL_REMOTE_ACTIVE" =~ ^[0-9]+$ && "$SPILL_REMOTE_ACTIVE" -lt "$capacity" ]]; then
    SPILL_PROBE_REASON="remote-active=${SPILL_REMOTE_ACTIVE}<${capacity}"
    rm -f "$probe_err"
    return 0
  fi
  SPILL_PROBE_REASON="remote-full active=${SPILL_REMOTE_ACTIVE:-unknown} capacity=${capacity} load5=${SPILL_REMOTE_LOAD:-unknown}"
  SPILL_PROBE_DETAIL="active ${SPILL_REMOTE_ACTIVE:-unknown} capacity ${capacity}"
  # A probe that connected but could not produce a parseable agent list usually
  # left its reason on the remote stderr (herdr missing from the
  # non-interactive PATH is the classic case) — keep it for the caller.
  SPILL_PROBE_ERR="$(cat "$probe_err" 2>/dev/null)"
  rm -f "$probe_err"
  return 1
}

# #1239: deferred panewire wake. A wake-capable host is never woken on first
# sight — spawn_router_cmd finishes the candidate round first, then calls
# this once it knows no other placement is possible. The request itself
# carries the OPERATOR credential: [hub] operator_token_env (the same file
# the hub-spawn path uses) with hub_token_env as the fallback only — never a
# requirement, because hub_token_env is also the hub quota gate opt-in
# (#1138) and a quota_gate = "local" host deliberately leaves it unset.
# `panewire burst request` waits hub-side for the node's connection up to
# --timeout (server cap 10 minutes); a granted hold, or cooldown_active
# (someone else's wake is already in flight — waiting on it instead of
# stacking a second request is the concurrency story), then waits on the
# probe loop below for the ssh side to come up, bounded by the hosts.toml
# [hosts.<host>] wake_wait seconds (default 300). On refusal, CLI failure or
# timeout the reason is left in SPILL_WAKE_ERR and the caller answers with
# WRK_EXIT_WAKE_FAILED — never a local pane.
spillover_wake_request() {
  local host="$1" wake hub_url token_env cf_env hold wait_s panewire cli_timeout
  local out rc reason cli_err deadline poll_s wait_note burst_err
  wake="$(spillover_value "hosts.$host" wake 2>/dev/null || true)"
  if [[ "$wake" != panewire ]]; then
    SPILL_WAKE_ERR="remote host '$host' has no wake = \"panewire\" setting"
    return 1
  fi
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  # The burst operator client wants an HTTPS/HTTP base — reuse the same
  # wss:// -> https:// conversion the other hub paths apply.
  if [[ -n "$hub_url" ]]; then
    hub_url="$(spillover_hub_http_base "$hub_url" 2>/dev/null || true)"
  fi
  token_env="$(spillover_value hub operator_token_env 2>/dev/null || true)"
  if [[ -z "$token_env" ]]; then
    token_env="$(spillover_value hub hub_token_env 2>/dev/null || true)"
  fi
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  if [[ -z "$hub_url" || -z "$token_env" ]]; then
    SPILL_WAKE_ERR="remote host '$host' wake skipped ([hub] needs hub_url plus an operator credential: operator_token_env, else hub_token_env)"
    return 1
  fi
  # wake_hold/wake_wait follow the other numeric hosts.toml keys: a missing
  # or malformed value falls back to the default, never a refusal.
  hold="$(spillover_value "hosts.$host" wake_hold 2>/dev/null || true)"
  if [[ ! "$hold" =~ ^[1-9][0-9]*$ ]]; then hold="${WRK_WAKE_HOLD_MINUTES:-10}"; fi
  if [[ ! "$hold" =~ ^[1-9][0-9]*$ ]]; then hold=10; fi
  wait_s="$(spillover_value "hosts.$host" wake_wait 2>/dev/null || true)"
  if [[ ! "$wait_s" =~ ^[1-9][0-9]*$ ]]; then wait_s=300; fi
  # The hub caps a request's confirm timeout at 10 minutes; a longer
  # wake_wait is honored by the re-probe loop below.
  cli_timeout="$wait_s"
  if (( cli_timeout > 600 )); then cli_timeout=600; fi
  panewire="${PANEWIRE_BIN:-panewire}"
  echo "wrk: waking remote host '$host' via panewire burst (hold ${hold}m, wait ${wait_s}s)" >&2
  burst_err="$(mktemp)"
  set +e
  out="$("$panewire" burst request --target "$host" --hold "${hold}m" --timeout "${cli_timeout}s" \
    --reason "wrk spill-over: every candidate at capacity" \
    --hub-url "$hub_url" --hub-token-env "$token_env" ${cf_env:+--hub-cf-env "$cf_env"} 2>"$burst_err")"
  rc=$?
  set -e
  cli_err="$(tail -n 1 "$burst_err" 2>/dev/null || true)"
  rm -f "$burst_err"
  reason=""
  if [[ "$rc" -eq 3 ]]; then
    reason="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("reason",""))' <<<"$out" 2>/dev/null || true)"
  fi
  wait_note="burst hold requested, node not connected"
  case "$rc:$reason" in
    0:*)
      : ;;  # hold granted — the hub already saw the node connect
    3:cooldown_active)
      wait_note="cooldown_active: a wake is already in progress, node not connected" ;;
    3:target_timeout)
      SPILL_WAKE_ERR="remote host '$host' wake timed out after ${wait_s}s ($wait_note)"
      return 1 ;;
    3:*)
      if [[ -n "$reason" ]]; then
        SPILL_WAKE_ERR="remote host '$host' wake refused ($reason)"
      else
        SPILL_WAKE_ERR="remote host '$host' wake failed (${cli_err:-panewire burst request unavailable})"
      fi
      return 1 ;;
    *)
      SPILL_WAKE_ERR="remote host '$host' wake failed (panewire burst request exited $rc${cli_err:+: $cli_err})"
      return 1 ;;
  esac
  # Bounded re-probe: a granted hold means the node reached the hub, but its
  # sshd can lag a few seconds; the cooldown arm waits out the full budget.
  poll_s="${WRK_WAKE_POLL_S:-5}"
  deadline=$((SECONDS + wait_s))
  while :; do
    spillover_probe_host "$host" || true
    if [[ "$SPILL_PROBE_REASON" != ssh-unreachable ]]; then return 0; fi
    if (( SECONDS >= deadline )); then break; fi
    sleep "$poll_s"
  done
  SPILL_WAKE_ERR="remote host '$host' wake timed out after ${wait_s}s ($wait_note)"
  return 1
}

# A value-taking spawn option must not silently swallow the next option token:
# `--operator-request --requested-by` used to store "--requested-by" as the
# REF, skipping the missing-value rc=2 and forwarding the mangled pair
# downstream. Only spellings wrk itself recognizes count — "-operator" is not
# a flag and remains a perfectly valid --requested-by value.
wrk_option_token() {
  case "$1" in
    -c|-m|-p|-w|-l|-L|--effort|--job|--t|--owner|--role|--lane|--parent|--report|--operator-request|--round-ext|--requested-by|--purpose|--task|--parent-job|--takeover-from|--task-hk-bypass|--job-dup-ok|--landing-strict|--keep|--host|-h|--help) return 0 ;;
    *) return 1 ;;
  esac
}

# The hub endpoint accepts only spawn metadata. In particular, the local cwd
# and brief path are translated to cwd_key and brief.inline, and duplicate-job
# overrides are deliberately not representable on this boundary.
spillover_hub_args() {
  SPILL_HUB_ARGS=()
  local arg i=0 args=("$@")
  while [[ "$i" -lt "${#args[@]}" ]]; do
    arg="${args[$i]}"
    case "$arg" in
      -c|-p)
        i=$((i + 1))
        { [[ "$i" -lt "${#args[@]}" ]] && ! wrk_option_token "${args[$i]:-}"; } ||
          { echo "wrk: $arg requires a value" >&2; return 2; }
        ;;
      --job-dup-ok)
        echo "wrk: --job-dup-ok is not permitted for a hub spawn" >&2; return 2 ;;
      -m|-w|-l|--t|--effort|--job|--owner|--report|--role|--lane|--parent|-L|--operator-request|--round-ext|--requested-by|--purpose|--task|--parent-job|--takeover-from)
        i=$((i + 1))
        { [[ "$i" -lt "${#args[@]}" && -n "${args[$i]}" ]] && ! wrk_option_token "${args[$i]}"; } ||
          { echo "wrk: $arg requires a value" >&2; return 2; }
        SPILL_HUB_ARGS+=("$arg" "${args[$i]}")
        ;;
      --task-hk-bypass)
        SPILL_HUB_ARGS+=("$arg") ;;
      *)
        echo "wrk: option '$arg' is not permitted for a hub spawn" >&2; return 2 ;;
    esac
    i=$((i + 1))
  done
}

spillover_hub_emit_ok() {
  local host="$1" pane="$2" job_id="$3" status="$4" landed="$5"; shift 5
  local model=unknown label=unknown role=worker arg i=0 args=("$@")
  while [[ "$i" -lt "${#args[@]}" ]]; do
    arg="${args[$i]}"
    case "$arg" in
      -m) model="${args[$((i + 1))]:-unknown}" ;;
      -l) label="${args[$((i + 1))]:-unknown}" ;;
      --role) role="${args[$((i + 1))]:-worker}" ;;
    esac
    i=$((i + 1))
  done
  [[ "$role" == captain ]] && role=builder
  # #1397: a builder's OK line ALWAYS states its lane outcome. The via=hub
  # transport carries no lane-confirmation channel — the remote wrk's own
  # registration result never reaches this line — so the honest field is
  # UNREGISTERED, not a silent omission that looks like a worker.
  local lane_field=""
  [[ "$role" == builder ]] && lane_field=" lane=UNREGISTERED"
  printf 'OK pane=%s host=%s model=%s label=%s status=%s landed=%s job=%s%s\n' \
    "$pane" "$host" "$model" "$label" "$status" "$landed" "$job_id" "$lane_field"
  # #1397/S1-r2: WRK_LANE_STRICT means the same on every transport — a
  # builder's UNREGISTERED marker answers 82 AFTER the OK line prints, so
  # automation can tell "spawned but unrouted" from a clean spawn here too.
  # Workers and non-strict runs are untouched.
  if [[ "$role" == builder && "${WRK_LANE_STRICT:-0}" == 1 ]]; then
    warn "spawn succeeded but the builder lane is UNREGISTERED; the pane on host '$host' remains valid; strict_exit=$WRK_EXIT_LANE_UNREGISTERED"
    return "$WRK_EXIT_LANE_UNREGISTERED"
  fi
}

spillover_hub_curl_run() {
  local method="$1" url="$2" request_body="$3" operator_token="$4" cf_client_id="$5" cf_client_secret="$6" response_file="$7"
  local curl_bin headers_file request_file=""

  (
    umask 077
    headers_file="$(mktemp)" || exit 1
    trap 'rm -f "$headers_file" "$request_file"' EXIT HUP INT TERM
    if ! {
      printf 'Authorization: Bearer %s\n' "$operator_token"
      printf 'CF-Access-Client-Id: %s\n' "$cf_client_id"
      printf 'CF-Access-Client-Secret: %s\n' "$cf_client_secret"
      printf '%s\n' 'Content-Type: application/json'
    } >"$headers_file"; then
      exit 1
    fi
    curl_bin="${WRK_CURL_BIN:-curl}"
    if [[ "$method" == POST ]]; then
      request_file="$(mktemp)" || exit 1
      printf '%s' "$request_body" >"$request_file" || exit 1
      "$curl_bin" --silent --show-error --output "$response_file" --write-out '%{http_code}' \
        --request POST "$url" --header "@$headers_file" --data-binary "@$request_file"
    else
      "$curl_bin" --silent --show-error --output "$response_file" --write-out '%{http_code}' \
        --request GET "$url" --header "@$headers_file"
    fi
  )
}

spillover_hub_http_request() {
  local method="$1" url="$2" request_body="$3" operator_token="$4" cf_client_id="$5" cf_client_secret="$6"
  local response_file old_umask curl_rc

  old_umask="$(umask)"
  umask 077
  response_file="$(mktemp)" || { umask "$old_umask"; return 1; }
  umask "$old_umask"
  set +e
  SPILL_HUB_HTTP_CODE="$(spillover_hub_curl_run "$method" "$url" "$request_body" "$operator_token" "$cf_client_id" "$cf_client_secret" "$response_file")"
  curl_rc=$?
  set -e
  if [[ -r "$response_file" ]]; then
    SPILL_HUB_HTTP_BODY="$(<"$response_file")"
  else
    SPILL_HUB_HTTP_BODY=""
  fi
  rm -f "$response_file" || true
  [[ "$curl_rc" -eq 0 && "$SPILL_HUB_HTTP_CODE" =~ ^[0-9]{3}$ ]]
}

spillover_hub_response_state() {
  local body="$1" request_id="$2"
  python3 -c '
import json, sys
request_id = sys.argv[1]
d = json.load(sys.stdin)
if d.get("request_id") != request_id:
    raise SystemExit(1)
state = d.get("status")
if not isinstance(state, str):
    raise SystemExit(1)
print(state)
' "$request_id" <<<"$body"
}

spillover_hub_result() {
  local body="$1" request_id="$2" host="$3"
  python3 -c '
import json, sys
request_id, host = sys.argv[1:]
d = json.load(sys.stdin)
if d.get("request_id") != request_id or d.get("machine") != host or d.get("rc") != 0:
    raise SystemExit(1)
pane, job_id = d.get("pane"), d.get("job_id")
if not isinstance(pane, str) or not pane or not isinstance(job_id, str) or not job_id:
    raise SystemExit(1)
status, landed = "unknown", "no"
tail = d.get("stdout_tail")
if isinstance(tail, str):
    ok_lines = [line for line in tail.splitlines() if line.startswith("OK pane=")]
    if ok_lines:
        fields = dict(part.split("=", 1) for part in ok_lines[-1].split() if "=" in part)
        status = fields.get("status", status)
        landed = fields.get("landed", landed)
print(pane)
print(job_id)
print(status)
print(landed)
' "$request_id" "$host" <<<"$body"
}

spillover_hub_http_error() {
  local host="$1" status="$2"
  case "$status" in
    400) echo "wrk: hub spawn rejected for host '$host' (400 invalid request)" >&2 ;;
    401) echo "wrk: hub spawn authentication failed for host '$host' (401)" >&2 ;;
    409) echo "wrk: hub spawn conflicts with an existing request for host '$host' (409)" >&2 ;;
    503) echo "wrk: hub spawn unavailable for host '$host' (503); $(spillover_local_advice "retry")" >&2 ;;
    *) echo "wrk: hub spawn returned unexpected HTTP status $status for host '$host'" >&2 ;;
  esac
}

spillover_hub_poll() {
  local base="$1" request_id="$2" host="$3" operator_token="$4" cf_client_id="$5" cf_client_secret="$6"; shift 6
  local limit interval elapsed=0 state parsed
  limit="${WRK_HUB_POLL_MAX_SECONDS:-3600}"
  interval="${WRK_HUB_POLL_INTERVAL_SECONDS:-2}"
  [[ "$limit" =~ ^[1-9][0-9]*$ && "$interval" =~ ^[1-9][0-9]*$ ]] || {
    echo "wrk: invalid hub polling limit or interval" >&2; return 2;
  }
  while [[ "$elapsed" -lt "$limit" ]]; do
    if ! spillover_hub_http_request GET "${base%/}/v1/spawn/$request_id" '' "$operator_token" "$cf_client_id" "$cf_client_secret"; then
      echo "wrk: hub spawn poll failed for host '$host'; no local fallback" >&2
      return 1
    fi
    case "$SPILL_HUB_HTTP_CODE" in
      200)
        state="$(spillover_hub_response_state "$SPILL_HUB_HTTP_BODY" "$request_id" 2>/dev/null || true)"
        if [[ "$state" == lost ]]; then
          echo "wrk: hub spawn lost for host '$host'; no local fallback" >&2
          return 1
        fi
        if parsed="$(spillover_hub_result "$SPILL_HUB_HTTP_BODY" "$request_id" "$host" 2>/dev/null)"; then
          local pane job_id status landed
          pane="$(sed -n '1p' <<<"$parsed")"; job_id="$(sed -n '2p' <<<"$parsed")"
          status="$(sed -n '3p' <<<"$parsed")"; landed="$(sed -n '4p' <<<"$parsed")"
          spillover_hub_emit_ok "$host" "$pane" "$job_id" "$status" "$landed" "$@"
          return
        fi
        [[ "$state" == pending ]] || { echo "wrk: hub spawn returned an invalid poll response for host '$host'" >&2; return 1; }
        ;;
      504)
        state="$(spillover_hub_response_state "$SPILL_HUB_HTTP_BODY" "$request_id" 2>/dev/null || true)"
        [[ "$state" == pending ]] || { echo "wrk: hub spawn returned an invalid pending response for host '$host'" >&2; return 1; }
        ;;
      *) spillover_hub_http_error "$host" "$SPILL_HUB_HTTP_CODE"; return 1 ;;
    esac
    sleep_for "$interval"
    elapsed=$((elapsed + interval))
  done
  echo "wrk: hub spawn poll timed out for host '$host'; no local fallback" >&2
  return 1
}

spillover_hub_spawn() {
  local host="$1" cwd="$2" prompt="$3"; shift 3
  local cwd_key operator_env cf_env operator_token cf_client_id cf_client_secret hub_url base request_id request_body state parsed
  # /v1/spawn carries the allowed argv but has no child-environment field.
  # Do not send an inherited --parent-job request that the target cannot
  # resolve; SSH delegation carries the same value through HK_TASK_ID instead.
  if [[ -n "${SPILL_REMOTE_HK_TASK:-}" ]]; then
    echo "wrk: via=hub cannot forward an inherited task: /v1/spawn carries argv but no child environment; use SSH transport for --parent-job inheritance" >&2
    return 2
  fi
  if ! cwd_key="$(spillover_cwd_key "$host" "$cwd")"; then
    echo "wrk: remote host '$host' has no cwd_keys entry for '$cwd'; $(spillover_local_advice "configure hosts.toml")" >&2
    return 2
  fi
  local hub_args_rc
  if spillover_hub_args "$@"; then :; else
    hub_args_rc=$?
    return "$hub_args_rc"
  fi
  [[ -r "$prompt" ]] || { echo "wrk: hub spawn brief is not readable: $prompt" >&2; return 2; }
  [[ "$(wc -c <"$prompt")" -le 65536 ]] || { echo "wrk: hub spawn brief exceeds 65536 UTF-8 bytes" >&2; return 2; }
  operator_env="$(spillover_value hub operator_token_env 2>/dev/null || true)"
  [[ -n "$operator_env" ]] || { echo "wrk: hub spawn requires hub.operator_token_env; $(spillover_local_advice "configure hosts.toml")" >&2; return 2; }
  if ! operator_token="$(spillover_env_key "$operator_env" PANEWIRE_OPERATOR_TOKEN 2>/dev/null)"; then
    echo "wrk: hub spawn operator token is unavailable; $(spillover_local_advice "configure hosts.toml")" >&2
    return 2
  fi
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  if ! cf_client_id="$(spillover_env_key "$cf_env" CF_ACCESS_CLIENT_ID 2>/dev/null)" ||
     ! cf_client_secret="$(spillover_env_key "$cf_env" CF_ACCESS_CLIENT_SECRET 2>/dev/null)"; then
    echo "wrk: hub spawn CF service token is unavailable; $(spillover_local_advice "configure hosts.toml")" >&2
    return 2
  fi
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  if ! base="$(spillover_hub_http_base "$hub_url")"; then
    echo "wrk: hub spawn has an invalid hub_url; $(spillover_local_advice "configure hosts.toml")" >&2
    return 2
  fi
  request_id="$(python3 -c 'import uuid; print(uuid.uuid4())')"
  if ! request_body="$(python3 - "$request_id" "$host" "$cwd_key" "$prompt" "${SPILL_HUB_ARGS[@]}" <<'PY'
import json, sys
request_id, machine, cwd_key, prompt, *args = sys.argv[1:]
with open(prompt, "rb") as brief_file:
    brief = brief_file.read()
if len(brief) > 65536:
    raise SystemExit(1)
inline = brief.decode("utf-8")
print(json.dumps({
    "request_id": request_id,
    "machine": machine,
    "cwd_key": cwd_key,
    "brief": {"inline": inline},
    "args": args,
    "wait_seconds": 120,
}, ensure_ascii=False, separators=(",", ":")))
PY
)"; then
    echo "wrk: hub spawn brief must be UTF-8 and at most 65536 bytes" >&2
    return 2
  fi
  if ! spillover_hub_http_request POST "${base%/}/v1/spawn" "$request_body" "$operator_token" "$cf_client_id" "$cf_client_secret"; then
    echo "wrk: hub spawn request failed for host '$host'; no local fallback" >&2
    return 1
  fi
  case "$SPILL_HUB_HTTP_CODE" in
    200)
      if ! parsed="$(spillover_hub_result "$SPILL_HUB_HTTP_BODY" "$request_id" "$host" 2>/dev/null)"; then
        echo "wrk: hub spawn returned an invalid success response for host '$host'" >&2
        return 1
      fi
      local pane job_id status landed
      pane="$(sed -n '1p' <<<"$parsed")"; job_id="$(sed -n '2p' <<<"$parsed")"
      status="$(sed -n '3p' <<<"$parsed")"; landed="$(sed -n '4p' <<<"$parsed")"
      spillover_hub_emit_ok "$host" "$pane" "$job_id" "$status" "$landed" "${SPILL_HUB_ARGS[@]}"
      ;;
    504)
      state="$(spillover_hub_response_state "$SPILL_HUB_HTTP_BODY" "$request_id" 2>/dev/null || true)"
      [[ "$state" == pending ]] || { echo "wrk: hub spawn returned an invalid pending response for host '$host'" >&2; return 1; }
      spillover_hub_poll "$base" "$request_id" "$host" "$operator_token" "$cf_client_id" "$cf_client_secret" "${SPILL_HUB_ARGS[@]}"
      ;;
    *) spillover_hub_http_error "$host" "$SPILL_HUB_HTTP_CODE"; return 1 ;;
  esac
}


spillover_emit_host() {
  local host="$1" file="$2" remote_rc="${3:-0}"
  # The OK pane line is the success contract: it stays on stdout even when the
  # remote leg failed after printing it.  On failure every other captured line
  # is diagnostic and belongs on stderr, never on the OK line's stream.
  awk -v host="$host" -v failed="$remote_rc" '
    /^OK pane=/ { sub(/ host=[^ ]+/, ""); sub(/^OK pane=[^ ]+/, "& host=" host); print; next }
    failed != 0 { print > "/dev/stderr"; next }
    { print }
  ' "$file"
}

# A delegated leg captures the remote stderr separately so transport noise
# (ssh banners, remote shell errors) and the remote wrk's own die lines reach
# the operator verbatim instead of dying inside a temp file or /dev/null.
spillover_relay_remote_err() {
  local err_file="$1"
  if [[ -s "$err_file" ]]; then cat "$err_file" >&2; fi
}

# Transport legs (probe, prepare, mktemp, scp) must never answer the router
# with an admission code: 2/74/75 belong to the remote wrk and the cwd map,
# 70 to the remote wrk's own config refusal, and 82 to its builder-lane
# strict answer (#1397) — fail-closed answers that stop auto failover.  A
# transport exit landing in that set is remapped to 1 so failover proceeds
# exactly as it did when every leg returned a flat 1; it also means a 70 or
# 82 the router sees can only be the remote wrk's own answer from the
# delegated-spawn leg, which is never normalized (#1154).
spillover_transport_rc() {
  case "$1" in
    2|"$WRK_EXIT_ACTIVE_JOB_DUPLICATE"|"$WRK_EXIT_JOB_STATE_UNREADABLE"|"$WRK_EXIT_CONFIG_REFUSED"|"$WRK_EXIT_LANE_UNREGISTERED") printf '1' ;;
    *) printf '%s' "$1" ;;
  esac
}

# Name the remote leg before starting it and emit the last reached step to the
# caller. Under --host auto this stderr is held with the candidate diagnostics.
spillover_remote_step() {
  local host="$1" step="$2" now elapsed
  SPILL_REMOTE_STEP="$step"
  # Bash's counter avoids extra date calls on local spawns, which can affect
  # callers that provide a controlled date clock.
  now="$SECONDS"
  if [[ ! "${SPILL_REMOTE_STARTED_AT:-}" =~ ^[0-9]+$ ]]; then
    SPILL_REMOTE_STARTED_AT="$now"
  fi
  elapsed=$((now - SPILL_REMOTE_STARTED_AT))
  (( elapsed < 0 )) && elapsed=0
  printf "wrk: remote host '%s' step %s elapsed=%ss\n" "$host" "$step" "$elapsed" >&2
}

# The progress lines are useful when an auto round fails, but a successful
# auto placement must keep its existing quiet-stderr contract. Other stderr
# from the winning remote wrk (for example a quota warning) still passes.
spillover_replay_success_stderr() {
  local err_file="$1"
  grep -avE "^wrk: remote host '[^']+' step (probe|cwd-map|prepare|mktemp|scp|remote wrk|lane) elapsed=[0-9]+s$" "$err_file" >&2 || true
}

# Creates the derived remote worktree on the selected host.  Local-only
# branches and commits that origin does not have are terminal: the remote
# side can only check out what its own origin fetch can see, so spawning
# anyway would silently run different code.
spillover_remote_worktree_create() {
  local host="$1" ssh_name="$2" cwd="$3" remote_cwd="$4" remote_base="$5" branch="$6" sha="$7"
  if [[ -n "$branch" ]]; then
    if ! git -C "$cwd" rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null; then
      echo "wrk: local branch '$branch' is not pushed to origin; push it before spawning on '$host'" >&2
      return 2
    fi
    if [[ "$(git -C "$cwd" rev-parse "origin/$branch")" != "$sha" ]]; then
      echo "wrk: local HEAD of '$branch' differs from origin/$branch; push or pull before spawning on '$host'" >&2
      return 2
    fi
  elif ! git -C "$cwd" branch -r --contains "$sha" 2>/dev/null | grep -q 'origin/'; then
    echo "wrk: detached HEAD $sha of '$cwd' is not reachable from origin; push it before spawning on '$host'" >&2
    return 2
  fi
  local out rc
  set +e
  out="$("${WRK_SSH_BIN:-ssh}" -o BatchMode=yes "$ssh_name" \
    "BASE=$(printf '%q' "$remote_base") TARGET=$(printf '%q' "$remote_cwd") BRANCH=$(printf '%q' "$branch") SHA=$(printf '%q' "$sha") sh -s" <<'PREP' 2>&1
git -C "$BASE" rev-parse --git-dir >/dev/null 2>&1 || { echo "no git repo at $BASE" >&2; exit 3; }
created_branch=0
if [ -n "$BRANCH" ]; then
  git -C "$BASE" fetch origin "$BRANCH" || exit 4
  if git -C "$BASE" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    cur=$(git -C "$BASE" rev-parse "refs/heads/$BRANCH")
    [ "$cur" = "$SHA" ] || { echo "remote branch $BRANCH is at $cur" >&2; exit 5; }
    git -C "$BASE" worktree add "$TARGET" "$BRANCH" || exit 6
  else
    git -C "$BASE" worktree add -b "$BRANCH" "$TARGET" "origin/$BRANCH" || exit 6
    created_branch=1
  fi
else
  git -C "$BASE" fetch origin || exit 4
  git -C "$BASE" worktree add --detach "$TARGET" "$SHA" || exit 6
fi
s=$(git -C "$TARGET" rev-parse HEAD 2>/dev/null) || { git -C "$BASE" worktree remove --force "$TARGET" 2>/dev/null; [ "$created_branch" = 1 ] && git -C "$BASE" branch -D "$BRANCH" >/dev/null 2>&1; exit 7; }
[ "$s" = "$SHA" ] || { git -C "$BASE" worktree remove --force "$TARGET"; [ "$created_branch" = 1 ] && git -C "$BASE" branch -D "$BRANCH" >/dev/null 2>&1; echo "created worktree HEAD $s" >&2; exit 8; }
PREP
)"
  rc=$?
  set -e
  case "$rc" in
    0) return 0 ;;
    3) echo "wrk: remote repo '$remote_base' on '$host' is missing or not a git repo; create it first" >&2 ;;
    *) echo "wrk: remote worktree preparation failed on '$host' (rc=$rc): $(tail -n 1 <<<"$out")" >&2 ;;
  esac
  return 2
}

# A derived remote path (sibling-worktree or subpath mapping) must name the
# same commit as the local cwd before the spawn is delegated.  Missing
# worktrees are created remotely; an existing directory whose branch or HEAD
# disagrees is terminal — never overwrite or force a remote checkout.  Exact
# repo-root mappings keep the historical pass-through contract.
spillover_remote_prepare() {
  local host="$1" ssh_name="$2" cwd="$3" remote_cwd="$4" remote_base="$5" kind="$6"
  [[ "$kind" == exact ]] && return 0
  local branch="" sha="" has_git=0
  if branch="$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null)" &&
     sha="$(git -C "$cwd" rev-parse HEAD 2>/dev/null)"; then
    has_git=1
    [[ "$branch" == HEAD ]] && branch=""
  fi
  local out rc prep_err
  prep_err="$(mktemp)"
  set +e
  out="$("${WRK_SSH_BIN:-ssh}" -o BatchMode=yes "$ssh_name" \
    "TARGET=$(printf '%q' "$remote_cwd") sh -s" <<'PREP' 2>"$prep_err"
if [ -d "$TARGET" ]; then
  b=$(git -C "$TARGET" rev-parse --abbrev-ref HEAD 2>/dev/null) &&
    s=$(git -C "$TARGET" rev-parse HEAD 2>/dev/null) &&
    printf 'EXISTS\n%s\n%s\n' "$b" "$s" || echo NOTGIT
else
  echo MISSING
fi
PREP
)"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    spillover_relay_remote_err "$prep_err"
    echo "wrk: remote host '$host' is unreachable during worktree check (prepare rc=$rc); retry when it is available" >&2
    rm -f "$prep_err"
    return "$(spillover_transport_rc "$rc")"
  fi
  rm -f "$prep_err"
  case "$out" in
    MISSING)
      if [[ "$has_git" -eq 0 ]]; then
        echo "wrk: remote path '$remote_cwd' is missing on '$host' and '$cwd' is not a git worktree; create it first" >&2
        return 2
      fi
      [[ "$kind" == suffix ]] || {
        echo "wrk: remote path '$remote_cwd' is missing on '$host'; sync the remote repository first" >&2
        return 2
      }
      spillover_remote_worktree_create "$host" "$ssh_name" "$cwd" "$remote_cwd" "$remote_base" "$branch" "$sha"
      ;;
    NOTGIT)
      [[ "$has_git" -eq 0 ]] && return 0
      echo "wrk: remote path '$remote_cwd' on '$host' is not a git worktree; refusing to use it" >&2
      return 2
      ;;
    EXISTS*)
      [[ "$has_git" -eq 1 ]] || return 0
      local remote_branch remote_sha
      remote_branch="$(sed -n '2p' <<<"$out")"
      remote_sha="$(sed -n '3p' <<<"$out")"
      if [[ "$remote_branch" != "${branch:-HEAD}" || "$remote_sha" != "$sha" ]]; then
        echo "wrk: remote path '$remote_cwd' on '$host' is at ${remote_branch}@${remote_sha} but local '$cwd' is at ${branch:-HEAD}@${sha}; refusing to overwrite — align or remove it" >&2
        return 2
      fi
      return 0
      ;;
    *)
      echo "wrk: remote worktree check on '$host' returned an unexpected result" >&2
      return 1
      ;;
  esac
}

spillover_remote_spawn() {
  local host="$1" cwd="$2" prompt="$3"; shift 3
  local ssh_name session remote_prompt remote_cwd workspace remote_cmd rc out remote_err
  ssh_name="$(spillover_value "hosts.$host" ssh 2>/dev/null || true)"; [[ -n "$ssh_name" ]] || ssh_name="$host"
  session="$(spillover_value "hosts.$host" herdr_session 2>/dev/null || true)"; [[ -n "$session" ]] || session=worker
  workspace="$(spillover_value "hosts.$host" workspace 2>/dev/null || true)"; [[ -n "$workspace" ]] || workspace=worker
  spillover_remote_step "$host" cwd-map
  if ! spillover_cwd_map "$host" "$cwd"; then
    echo "wrk: remote host '$host' has no cwd_map entry for '$cwd'; $(spillover_local_advice "configure hosts.toml")" >&2
    return 2
  fi
  remote_cwd="$SPILL_CWD_REMOTE"
  [[ "$SPILL_CWD_KIND" == exact ]] || spillover_remote_step "$host" prepare
  spillover_remote_prepare "$host" "$ssh_name" "$cwd" "$remote_cwd" "$SPILL_CWD_BASE" "$SPILL_CWD_KIND" || return
  remote_err="$(mktemp)"
  spillover_remote_step "$host" mktemp
  set +e
  # shellcheck disable=SC2016 # ${TMPDIR} must expand on the selected remote host.
  remote_prompt="$("${WRK_SSH_BIN:-ssh}" -o BatchMode=yes "$ssh_name" 'umask 077; mktemp "${TMPDIR:-/tmp}/wrk-spillover.XXXXXX.md"' 2>"$remote_err")"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    spillover_relay_remote_err "$remote_err"
    echo "wrk: remote host '$host' is unreachable or its mktemp failed (mktemp rc=$rc); $(spillover_local_advice "retry after it is available")" >&2
    rm -f "$remote_err"
    return "$(spillover_transport_rc "$rc")"
  fi
  rm -f "$remote_err"
  spillover_remote_step "$host" scp
  set +e
  "${WRK_SCP_BIN:-scp}" "$prompt" "$ssh_name:$remote_prompt"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    echo "wrk: failed to copy brief to remote host '$host' (scp rc=$rc)" >&2
    return "$(spillover_transport_rc "$rc")"
  fi
  # #1397/(a): the lane a remote BUILDER spawn leaves is registered by THIS
  # host, not the execution host — the delegated wrk gets --lane-defer <host
  # key> so it records hub_lane/hub_lane_machine in its job.spawned receipt
  # without calling panewire, and this host runs `lanes add` itself after the
  # remote answers rc 0 (machine = the hosts.toml key, the host's hub
  # machine id). hk 1446 exception: when the remote's own lanes token names
  # that same machine id it registers the lane itself and answers
  # lane_registered=self on its OK pane= line — the add below is then
  # skipped. A remote WORKER gets neither the flag nor the add: it keeps
  # the #965 contract — the execution host checks its own
  # session_machine_ids and registers there, or stays unregistered — because
  # a fleet worker must never land on the hub as a global lane named after
  # the initiating host's key.
  # The lane name/parent come from the forwarded args: a builder registers
  # --lane under --parent.
  local remote_lane_role=worker remote_lane_name="" remote_lane_owner="" remote_lane_builder="" remote_lane_parent="" remote_label=""
  local arg saw_workspace=0 i=0 args=("$@")
  while [[ "$i" -lt "${#args[@]}" ]]; do
    arg="${args[$i]}"
    case "$arg" in
      --role) remote_lane_role="${args[$((i + 1))]:-worker}"; ((i+=1)) ;;
      --lane) remote_lane_builder="${args[$((i + 1))]:-}"; ((i+=1)) ;;
      --parent) remote_lane_parent="${args[$((i + 1))]:-}"; ((i+=1)) ;;
      --owner) remote_lane_owner="${args[$((i + 1))]:-}"; ((i+=1)) ;;
      -l) remote_label="${args[$((i + 1))]:-}"; ((i+=1)) ;;
    esac
    ((i+=1))
  done
  # captain is the legacy builder alias — the remote wrk normalizes it before
  # its own defer check, so this side must read --lane/--parent for it too.
  [[ "$remote_lane_role" == captain ]] && remote_lane_role=builder
  local remote_lane_name remote_lane_route_parent
  if [[ "$remote_lane_role" == builder ]]; then
    remote_lane_name="$remote_lane_builder" remote_lane_route_parent="$remote_lane_parent"
  else
    remote_lane_name="$remote_label" remote_lane_route_parent="$remote_lane_owner"
  fi
  local remote_args=(env "HERDR_SESSION=$session")
  [[ -n "${SPILL_REMOTE_HK_TASK:-}" ]] && remote_args+=("HK_TASK_ID=$SPILL_REMOTE_HK_TASK")
  remote_args+=(wrk spawn -c "$remote_cwd" -p "$remote_prompt" --host local)
  # Builders only — forwarding the flag to a worker would mute the execution
  # host's own session-machine_ids check while this host then named the
  # worker's lane on machine=<host key>.
  [[ "$remote_lane_role" == builder ]] && remote_args+=("--lane-defer" "$host")
  i=0
  while [[ "$i" -lt "${#args[@]}" ]]; do
    arg="${args[$i]}"
    case "$arg" in
      -c|-p|--host)
        # The remote path and copied brief above are authoritative.  Removing
        # both their values prevents a duplicate option from overriding them.
        ((i+=1))
        { [[ "$i" -lt "${#args[@]}" ]] && ! wrk_option_token "${args[$i]:-}"; } ||
          die "$arg requires a value"
        ;;
      -w)
        ((i+=1))
        { [[ "$i" -lt "${#args[@]}" ]] && ! wrk_option_token "${args[$i]:-}"; } ||
          die "-w requires a value"
        remote_args+=(-w "${args[$i]}")
        saw_workspace=1
        ;;
      *) remote_args+=("$arg") ;;
    esac
    ((i+=1))
  done
  # The normal argument loop preserves an explicit -w; remote defaults come
  # from hosts.toml when callers omit it.
  if [[ "$saw_workspace" -eq 0 ]]; then remote_args+=(-w "$workspace"); fi
  printf -v remote_cmd '%q ' "${remote_args[@]}"
  out="$(mktemp)"
  remote_err="$(mktemp)"
  spillover_remote_step "$host" 'remote wrk'
  set +e
  "${WRK_SSH_BIN:-ssh}" -o BatchMode=yes "$ssh_name" "$remote_cmd; rc=\$?; rm -f -- $(printf '%q' "$remote_prompt"); exit \$rc" >"$out" 2>"$remote_err"
  rc=$?
  set -e
  # A failed remote spawn must answer with the remote's own words: stderr is
  # relayed verbatim and non-OK stdout follows it onto the local stderr.
  spillover_relay_remote_err "$remote_err"
  # #1397/(a): whenever the remote printed an OK pane= line, a pane exists —
  # settle the builder lane whatever the remote's rc. A pane-remains-valid
  # answer (0, or 76 = landing unconfirmed with the pane left up) runs the
  # initiator-side `lanes add` from THIS host (machine = the hosts.toml key,
  # i.e. the host's hub machine id); every other answer — or a skipped or
  # failed add — rewrites the field to lane=UNREGISTERED. A remote lane=L@M
  # the initiator never confirmed must never pass through: it would name a
  # lane nobody added while the receipt claims one exists. A remote worker
  # never enters this block — its own lane= field (or its absence) passes
  # through untouched.
  if [[ "$remote_lane_role" == builder && -n "$remote_lane_name" ]]; then
    local remote_pane="" remote_selfreg="" lane_field="" lane_out
    remote_pane="$(awk '/^OK pane=/{ for (i = 1; i <= NF; i++) if (substr($i, 1, 5) == "pane=") { print substr($i, 6); exit } }' "$out")"
    # hk 1446: only a lane_registered=self field on the OK pane= line itself
    # counts — the same marker inside a label value, a warning line or any
    # other output is not the remote's own registration proof.
    remote_selfreg="$(awk '/^OK pane=/{ for (i = 1; i <= NF; i++) if ($i == "lane_registered=self") { print "yes"; exit } }' "$out")"
    if [[ -n "$remote_pane" ]]; then
      spillover_remote_step "$host" lane
      HUB_REMOTE_LANE=""
      if [[ "$remote_selfreg" == yes ]]; then
        # The execution host already added the row with its own lanes
        # token — adding it again would be a harmless idempotent update,
        # but skipping it keeps the hub traffic honest.
        HUB_REMOTE_LANE="$remote_lane_name"
      else
        case "$rc" in
          0|"$WRK_EXIT_LANDING_UNCONFIRMED")
            hub_lane_register_remote "$host" "$remote_pane" "$remote_lane_name" "$remote_lane_route_parent" ;;
        esac
      fi
      if [[ -n "$HUB_REMOTE_LANE" ]]; then
        lane_field="lane=$remote_lane_name@$host"
      else
        lane_field="lane=UNREGISTERED"
      fi
      lane_out="$(mktemp)"
      # The consumed self-registration marker never reaches the operator's
      # line — it was the remote's word to this host, not lane metadata.
      if awk -v lf="$lane_field" '
        /^OK pane=/ { sub(/ lane=[^ ]*/, ""); sub(/ lane_registered=self/, ""); if (lf != "") $0 = $0 " " lf; print; next }
        { print }
      ' "$out" >"$lane_out"; then
        mv "$lane_out" "$out"
      else
        rm -f "$lane_out"
      fi
    fi
  fi
  spillover_emit_host "$host" "$out" "$rc"
  rm -f "$out" "$remote_err"
  # A strict builder answer is the remote spawn's own: it returns 82 so an
  # auto round treats the leg like the other admission stops (2/70/74/75) —
  # the pane exists on that host, so re-placing would double-spawn the job.
  if [[ "$rc" -eq 0 && -n "$remote_lane_name" && "$remote_lane_role" == builder && -z "${HUB_REMOTE_LANE:-}" && "${WRK_LANE_STRICT:-0}" == 1 ]]; then
    warn "spawn succeeded but the builder lane is UNREGISTERED; the pane on remote host '$host' remains valid; strict_exit=$WRK_EXIT_LANE_UNREGISTERED"
    rc="$WRK_EXIT_LANE_UNREGISTERED"
  fi
  return "$rc"
}

# One remote candidate end to end: probe, then the delegated spawn.  Every
# per-candidate diagnostic is written to this function's stderr.  Under
# --host auto the router runs it in a subshell (so even a die() inside the
# remote legs is survivable) with stderr captured per candidate; the captured
# block is replayed only if no candidate produced a spawn, so a skipped host
# stays silent on success.  hold_diag=1 makes a failure end with one
# attributed "failed (rc=N) at step 'S'" line inside the captured block.
spillover_try_candidate() {
  local hold_diag="$1" candidate="$2" cwd="$3" prompt="$4"; shift 4
  local rc
  spillover_remote_step "$candidate" probe
  SPILL_PROBE_ERR=""; SPILL_PROBE_RC=1; SPILL_PROBE_DETAIL=""
  if ! spillover_probe_host "$candidate"; then
    # #1239: a wake-capable host is NOT woken here, on first sight — the
    # router finishes the candidate round and decides. It learns the verdict
    # through this one-token class file because the auto loop ran this
    # function in a subshell: remote-full / ssh-unreachable / refused
    # (anything else — probe noise, a refused remote admission, ...).
    if [[ -n "${SPILL_CANDIDATE_CLASS_FILE:-}" ]]; then
      case "$SPILL_PROBE_REASON" in
        remote-full*) printf 'remote-full\n' ;;
        ssh-unreachable) printf 'ssh-unreachable\n' ;;
        *) printf 'refused\n' ;;
      esac >"$SPILL_CANDIDATE_CLASS_FILE"
    fi
    # The remote's own words first (banner noise, missing herdr), then the
    # attribution line: a refused host is "skipped", a dead one "failed".
    [[ -n "$SPILL_PROBE_ERR" ]] && printf '%s\n' "$SPILL_PROBE_ERR" >&2
    if [[ "$SPILL_PROBE_REASON" == remote-full* ]]; then
      echo "wrk: remote host '$candidate' skipped: remote-full (${SPILL_PROBE_DETAIL:-$SPILL_PROBE_REASON})" >&2
    else
      echo "wrk: remote host '$candidate' probe failed (${SPILL_PROBE_REASON}, rc=$SPILL_PROBE_RC)" >&2
    fi
    # The probe is a transport leg: report the real ssh rc above, return a
    # normalized rc so 2/74/75 cannot collide with the router's fail-closed
    # admission codes.
    rc="$(spillover_transport_rc "$SPILL_PROBE_RC")"
  else
    if spillover_remote_spawn "$candidate" "$cwd" "$prompt" "$@"; then rc=0; else rc=$?; fi
    if [[ "$rc" -ne 0 && -n "${SPILL_CANDIDATE_CLASS_FILE:-}" ]]; then
      printf 'refused\n' >"$SPILL_CANDIDATE_CLASS_FILE"
    fi
  fi
  if [[ "$rc" -ne 0 && "$hold_diag" == 1 ]]; then
    echo "wrk: remote host '$candidate' failed (rc=$rc) at step '${SPILL_REMOTE_STEP:-unknown}'" >&2
  fi
  return "$rc"
}

spawn_router_cmd() {
  SPILL_REMOTE_STARTED_AT="$SECONDS"
  local requested=auto cwd="" prompt="" selected="" router_profile="" arg next=0 out rc host
  for arg in "$@"; do
    if [[ "$next" -eq 1 ]]; then cwd="$arg"; next=0; continue; fi
    if [[ "$next" -eq 2 ]]; then prompt="$arg"; next=0; continue; fi
    if [[ "$next" -eq 3 ]]; then router_profile="$arg"; next=0; continue; fi
    case "$arg" in
      -c) next=1 ;; -p) next=2 ;; -m|--profile) next=3 ;;
    esac
  done
  local filtered=() i=0 args=("$@")
  while [[ "$i" -lt "${#args[@]}" ]]; do
    arg="${args[$i]}"
    if [[ "$arg" == --host ]]; then
      ((i+=1))
      { [[ "$i" -lt "${#args[@]}" ]] && ! wrk_option_token "${args[$i]:-}"; } ||
        die "--host requires a value"
      requested="${args[$i]}"
    else
      filtered+=("$arg")
    fi
    ((i+=1))
  done
  # #1163 N1: help wins over config resolution — on a malformed [local] the
  # resolve below is a refusal, but `wrk spawn --help`/-h must still print
  # rc 0. The scan is value-aware (skips option arguments) so `-c --help`
  # still dies in spawn_cmd as a usage error; an unknown or non-option token
  # ends the scan — spawn_cmd dies on it before reaching any later --help.
  for ((i = 0; i < ${#args[@]}; i++)); do
    case "${args[$i]}" in
      -h|--help) spawn_help; return 0 ;;
      -c|-m|--profile|-p|-w|-l|-L|--effort|--job|--t|--owner|--role|--lane|--parent|--report|--operator-request|--round-ext|--requested-by|--purpose|--task|--parent-job|--takeover-from|--host|--lane-defer) ((i += 1)) ;;
      --task-hk-bypass|--job-dup-ok|--landing-strict|--keep) ;;
      *) break ;;
    esac
  done
  # Barred spellings stop before local host resolution, arbiter preflight,
  # spillover telemetry or a hub placement request.
  [[ -z "$router_profile" ]] || refuse_known_terra_spelling "$router_profile"
  # #1155: this host's own [local] spawn = false forbids local spawns here.
  # Resolve once, before any admission work: a malformed value is a config
  # error (70) on every placement, and --host local refuses before any pane,
  # arbiter or hk side effect. A delegated ssh spawn arrives on the
  # execution host as this same --host local, so the refusal is also what
  # closes a remote host to ssh-delegated spawns. A via=hub delegated spawn
  # is different — the hub runs `wrk spawn` on the target without --host,
  # which is this auto path: a closed target lands no local pane, but the
  # round may still place on that target's own remotes.
  local_spawn_resolve || return
  if [[ "$LOCAL_SPAWN_ALLOWED" -eq 0 && "$requested" == local ]]; then
    echo "wrk: local spawns are disabled on this host ([local] spawn = false); refusing --host local" >&2
    return "$WRK_EXIT_LOCAL_SPAWN_DISABLED"
  fi
  # #872: explicit remote mock placement cannot become an unguarded delegation
  # or an admission-error local fallback. Auto placement is checked again after
  # its final host decision below.
  local requested_lane=""
  for ((i=0; i<${#filtered[@]}; i++)); do
    [[ "${filtered[$i]}" != -L ]] || requested_lane="${filtered[$((i + 1))]:-}"
  done
  if [[ "$requested" != auto && "$requested" != local && "$requested_lane" == mock ]]; then
    echo "wrk: mock MCP isolation refused: remote execution host guard/config cannot be attested; use execution-host local spawn" >&2
    return "$WRK_EXIT_MOCK_MCP_REFUSED"
  fi
  # Classification and an active durable duplicate are admission invariants,
  # not placement work. Preserve their fail-closed boundary before asking
  # hub/local telemetry anything.
  local has_t=0 t_value="" job_id="" label="" job_dup_ok=0
  for ((i=0; i<${#filtered[@]}; i++)); do
    case "${filtered[$i]}" in
      --t) has_t=1; t_value="${filtered[$((i + 1))]:-}" ;;
      --job) job_id="${filtered[$((i + 1))]:-}" ;;
      -l) label="${filtered[$((i + 1))]:-}" ;;
      --job-dup-ok) job_dup_ok=1 ;;
    esac
  done
  if [[ "$has_t" -eq 0 || ! "$t_value" =~ ^T[0-3]$ ]]; then
    spawn_cmd "${filtered[@]}"
    return $?
  fi
  [[ -n "$job_id" ]] || job_id="$label"
  if arbiter_preflight_active_duplicate "$job_id" "$job_dup_ok"; then
    :
  else
    rc=$?
    # A router must never use an unavailable placement-admission lookup to
    # launch remotely. Let the local spawn own the final admission outcome.
    [[ "$rc" -eq "$WRK_EXIT_ACTIVE_JOB_DUPLICATE" ]] && return "$rc"
    out="$(mktemp)"
    set +e
    ( set -e; spawn_cmd "${filtered[@]}" ) >"$out"
    rc=$?
    set -e
    spillover_emit_host local "$out"
    rm -f "$out"
    return "$rc"
  fi
  # Without spill-over configuration, retain the ordinary local spawn path.
  # Besides avoiding pointless telemetry, this keeps spawn_cmd's quota gate as
  # the first side-effecting boundary for installations that have not opted in.
  if [[ "$requested" == auto && ! -r "$(spillover_config)" ]]; then
    spawn_cmd "${filtered[@]}"
    return $?
  fi
  case "$requested" in
    local)
      spillover_local_measure; selected=local; SPILL_REASON=forced-local; SPILL_DECISION_SOURCE=forced
      ;;
    auto)
      if spillover_hub_placement "$cwd"; then
        SPILL_DECISION_SOURCE=hub
        selected="$SPILL_HUB_HOST"
        SPILL_REASON="${SPILL_HUB_REASON:-hub-decision}"
        # A valid placement reply may deliberately contain no eligible
        # candidates (for example every machine is disconnected or
        # not_accepting).  That is safe to fail open only to this local spawn.
        if [[ -z "$selected" ]]; then
          selected=local
          SPILL_REASON="${SPILL_REASON};no-eligible-candidates"
        fi
        [[ "$selected" == local ]] || grep -qx "$selected" <<<"$(spillover_hosts)" || {
          spillover_log none "hub-unconfigured-host=${selected};${SPILL_REASON}"
          if [[ "$LOCAL_SPAWN_ALLOWED" -eq 1 ]]; then
            echo "wrk: hub selected unconfigured host '$selected'; configure hosts.toml or use --host local" >&2
          else
            echo "wrk: hub selected unconfigured host '$selected'; configure hosts.toml (local spawns are disabled on this host: [local] spawn = false)" >&2
          fi
          return 2
        }
        if [[ "$selected" == local && "$LOCAL_SPAWN_ALLOWED" -eq 0 ]]; then
          # #1155: the hub may still pick this host, but local spawns are
          # refused — the round runs the reply's remaining eligible
          # candidates instead. Defense in depth only: spillover_hub_placement
          # answers the first eligible candidate, so decision=local arrives
          # here as 'local' solely when the reply lists local itself as an
          # eligible candidate — the tested replies never do.
          SPILL_REASON="${SPILL_REASON};local-spawn-disabled"
          selected="${SPILL_HUB_CANDIDATES[0]:-}"
          if [[ -z "$selected" ]]; then
            spillover_log none "${SPILL_REASON};no-remote-candidate"
            echo "wrk: local spawns are disabled on this host ([local] spawn = false); no remote candidate completed." >&2
            return "$WRK_EXIT_LOCAL_SPAWN_DISABLED"
          fi
        fi
      elif [[ "$SPILL_HUB_STATUS" == invalid ]]; then
        spillover_local_measure
        SPILL_DECISION_SOURCE=hub
        spillover_log none "hub-invalid-response"
        echo "wrk: panewire placement response is invalid; refusing local fallback" >&2
        return 2
      else
        SPILL_DECISION_SOURCE=local-fallback
        if [[ "$LOCAL_SPAWN_ALLOWED" -eq 1 ]] && ! spillover_local_is_pressured; then
          selected=local
        else
          if [[ "${LOCAL_SPAWN_ALLOWED:-1}" -eq 0 ]]; then
            # #1155: a disabled local is not a candidate — this arm behaves as
            # if spill-over were required whatever the measured pressure is.
            spillover_local_measure
            SPILL_REASON=local-spawn-disabled
          fi
          SPILL_HUB_CANDIDATES=()
          while IFS= read -r candidate; do
            [[ -z "$candidate" ]] || SPILL_HUB_CANDIDATES+=("$candidate")
          done < <(spillover_hosts)
          selected="${SPILL_HUB_CANDIDATES[0]:-}"
          if [[ -z "$selected" ]]; then
            spillover_log none "${SPILL_REASON};no-remote-capacity"
            if [[ "$LOCAL_SPAWN_ALLOWED" -eq 1 ]]; then
              echo "wrk: spill-over required (${SPILL_REASON}) but no configured remote host has capacity; use --host local to override" >&2
              return 1
            fi
            echo "wrk: local spawns are disabled on this host ([local] spawn = false); no remote candidate completed." >&2
            return "$WRK_EXIT_LOCAL_SPAWN_DISABLED"
          fi
        fi
      fi
      ;;
    *)
      if ! spillover_value "hosts.$requested" ssh >/dev/null 2>&1 && ! grep -qx "$requested" <<<"$(spillover_hosts)"; then
        die "unknown spill-over host '$requested'; use wrk hosts"
      fi
      spillover_local_measure; selected="$requested"; SPILL_REASON=forced-remote; SPILL_DECISION_SOURCE=forced
      ;;
  esac
  # #872: neither the current hub contract nor ssh delegation attests which
  # guard/config version the execution host will load. Refuse before copying
  # a brief, probing/waking a host, or submitting a spawn. Never silently drop
  # the descriptor or downgrade the mock lane on spill-over.
  local execution_lane=""
  for ((i=0; i<${#filtered[@]}; i++)); do
    [[ "${filtered[$i]}" != -L ]] || execution_lane="${filtered[$((i + 1))]:-}"
  done
  if [[ "$selected" != local && "$execution_lane" == mock ]]; then
    echo "wrk: mock MCP isolation refused: remote execution host guard/config cannot be attested; use execution-host local spawn" >&2
    return "$WRK_EXIT_MOCK_MCP_REFUSED"
  fi
  if [[ "$selected" != local && "$(spillover_host_via "$selected" 2>/dev/null || true)" == hub ]]; then
    spillover_log "$selected" "${SPILL_REASON};via=hub"
  else
    spillover_log "$selected" "$SPILL_REASON"
  fi
  if [[ "$selected" == local ]]; then
    out="$(mktemp)"
    # Keep spawn_cmd's errexit semantics (notably a blocked quota gate) in an
    # isolated shell, while retaining strict landing's exit 76 and its emitted
    # OK pane line for host annotation.
    set +e
    ( set -e; spawn_cmd "${filtered[@]}" ) >"$out"
    rc=$?
    set -e
    spillover_emit_host local "$out"
    rm -f "$out"
    return "$rc"
  fi
  [[ -n "$cwd" && -n "$prompt" ]] || die "-c CWD and -p PROMPT_FILE are required"
  # Validate task inheritance before the probe, prepare, mktemp, or scp SSH
  # legs. A failed lookup must be a local refusal with no remote side effect.
  spillover_resolve_remote_task "${filtered[@]}"
  local candidates=("$selected") candidate candidate_via last_rc=1 seen_candidates=""
  local cand_err auto_diag="" cand_class
  # #1239 deferred-wake bookkeeping: wake_pending collects the wake-capable
  # candidates that probed ssh-unreachable (round order), and
  # remote_full_seen latches the positive capacity evidence the post-round
  # wake requires — a round with no remote-full answer never wakes.
  local wake_pending="" remote_full_seen=0 wake_target=""
  # --host auto holds every per-candidate diagnostic until the round settles:
  # a successful spawn must print nothing about the hosts it skipped, while an
  # all-fail round owes the operator one attributed line per host plus whatever
  # the remote legs said.  An explicit --host keeps the live stream.
  [[ "$requested" == auto ]] && auto_diag="$(mktemp)"
  if [[ "$requested" == auto ]]; then candidates+=("${SPILL_HUB_CANDIDATES[@]:-}"); fi
  for candidate in "${candidates[@]}"; do
    [[ " $seen_candidates " == *" $candidate "* ]] && continue
    seen_candidates+=" $candidate"
    if ! candidate_via="$(spillover_host_via "$candidate")"; then
      [[ -s "$auto_diag" ]] && cat "$auto_diag" >&2
      echo "wrk: remote host '$candidate' has invalid via setting; use ssh or hub" >&2
      rm -f "$auto_diag"
      return 2
    fi
    if [[ "$candidate_via" == hub ]]; then
      [[ "$candidate" == "$selected" ]] || spillover_log "$candidate" "${SPILL_REASON};via=hub"
      # The spawn helpers toggle set -e internally, so the return code must be
      # read in an if-context: a plain-command call would abort on the rc.
      if spillover_hub_spawn "$candidate" "$cwd" "$prompt" "${filtered[@]}"; then
        last_rc=0
      else
        last_rc=$?
      fi
      if [[ "$last_rc" -ne 0 && -s "$auto_diag" ]]; then cat "$auto_diag" >&2; fi
      rm -f "$auto_diag"
      return "$last_rc"
    fi
    if [[ -n "$auto_diag" ]]; then
      # #1239: under --host auto a candidate with no cwd_map entry for this
      # cwd can never accept the job — its remote would refuse rc 2 at the
      # cwd-map step, which sits in the stop set below and would end the
      # round before the post-round wake. The candidate is skipped BEFORE
      # the probe: silent when a later candidate lands, one held
      # diagnostic line on an all-fail round, and neutral for the wake
      # decision — it neither ends the round nor counts as remote-full
      # evidence. The skip applies only to the hosts.toml-order round
      # (local-fallback): a hub-selected round keeps the fail-closed
      # cwd-map rc 2 contract — the placement decision is authoritative,
      # and quietly moving past it would hide a broken config. An
      # explicit --host NAME keeps the cwd-map rc 2 too.
      if [[ "$SPILL_DECISION_SOURCE" == local-fallback ]] &&
         ! spillover_cwd_map "$candidate" "$cwd"; then
        printf "wrk: remote host '%s' skipped: no cwd_map entry for '%s'\n" "$candidate" "$cwd" >>"$auto_diag"
        continue
      fi
      cand_err="$(mktemp)"
      cand_class="$(mktemp)"
      # A subshell keeps a die() inside the remote legs survivable, and the
      # if-context keeps the callee's internal set -e toggles from arming
      # errexit on its nonzero return.
      if ( SPILL_CANDIDATE_CLASS_FILE="$cand_class" spillover_try_candidate 1 "$candidate" "$cwd" "$prompt" "${filtered[@]}" ) 2>"$cand_err"; then
        # Only the skipped candidates' diagnostics are dropped: the winner's
        # own stderr (remote wrk warnings, scp chatter) replays verbatim, as
        # it streamed live on main.
        spillover_replay_success_stderr "$cand_err"
        rm -f "$cand_err" "$cand_class" "$auto_diag"
        return 0
      else
        last_rc=$?
      fi
      case "$(cat "$cand_class" 2>/dev/null || true)" in
        remote-full) remote_full_seen=1 ;;
        ssh-unreachable)
          if [[ "$(spillover_value "hosts.$candidate" wake 2>/dev/null || true)" == panewire ]]; then
            wake_pending+="$candidate "
          fi ;;
      esac
      cat "$cand_err" >>"$auto_diag"
      rm -f "$cand_err" "$cand_class"
    else
      if spillover_try_candidate 0 "$candidate" "$cwd" "$prompt" "${filtered[@]}"; then
        return 0
      else
        last_rc=$?
      fi
    fi
    # Admission refusals and cwd mapping stay fail-closed: transport legs are
    # normalized away from this set, so a 2/74/75 here is the remote wrk's own
    # answer or a config refusal — stop instead of trying the next host. #1397:
    # a remote 82 (builder lane strict) belongs here too — the pane already
    # exists on that host, so moving the round would double-spawn the job.
    case "$last_rc" in
      2|"$WRK_EXIT_ACTIVE_JOB_DUPLICATE"|"$WRK_EXIT_JOB_STATE_UNREADABLE"|"$WRK_EXIT_LANE_UNREGISTERED")
        [[ -s "$auto_diag" ]] && cat "$auto_diag" >&2
        rm -f "$auto_diag"
        return "$last_rc" ;;
      "$WRK_EXIT_CONFIG_REFUSED")
        # #1154: a remote wrk's config refusal (its own quota gate answering
        # 70) stops the auto round like the admission refusals above — the
        # round must never reach the local fallback, which could land the job
        # on a host closed to spawns. Transport legs cannot produce 70
        # (spillover_transport_rc maps it to 1), so this rc is always the
        # remote wrk's own answer. An explicit --host NAME keeps its contract:
        # it falls through to the named-host failure line below.
        if [[ "$requested" == auto ]]; then
          [[ -s "$auto_diag" ]] && cat "$auto_diag" >&2
          echo "wrk: remote host '$candidate' refused the spawn with a config error (rc=$last_rc); not falling back to local" >&2
          rm -f "$auto_diag"
          return "$last_rc"
        fi ;;
    esac
  done
  # #1239: the deferred wake decision, made only once the candidate round is
  # over. Under --host auto a wake-capable candidate that probed
  # ssh-unreachable is owed a wake when (a) local cannot take the job
  # ([local] spawn = false, or the same measured pressure that started this
  # round still holds), (b) no candidate landed the job — reaching here
  # proves it, (c) the round was not ended by a stop-set answer — a
  # reachable remote wrk answering 2, 70, 74 or 75 returns inside the loop
  # and never gets here — and (d) at least one candidate answered
  # remote-full, the positive capacity evidence that the fleet really is
  # short. Unmapped candidates were skipped before probing, and transport
  # failures or remote rc 80/81 answers no longer suppress the wake. An
  # explicit --host NAME is the operator forcing that host, so an
  # unreachable wake-capable target wakes unconditionally — wake =
  # "panewire" on that hosts.toml entry is itself the opt-in.
  if [[ "$requested" == auto ]]; then
    if [[ -n "$wake_pending" && "$remote_full_seen" -eq 1 ]] &&
       { [[ "$LOCAL_SPAWN_ALLOWED" -eq 0 ]] || spillover_local_is_pressured; }; then
      wake_target="${wake_pending%% *}"
    fi
  elif [[ "${SPILL_PROBE_REASON:-}" == ssh-unreachable ]] &&
       [[ "$(spillover_value "hosts.$requested" wake 2>/dev/null || true)" == panewire ]]; then
    wake_target="$requested"
  fi
  if [[ -n "$wake_target" ]]; then
    if spillover_wake_request "$wake_target"; then
      # The node answered: place the job through the same legs as any other
      # candidate. A spawn that still fails propagates that rc — the wake
      # already committed this round to the remote answer.
      if [[ -n "$auto_diag" ]]; then
        cand_err="$(mktemp)"
        if ( spillover_try_candidate 1 "$wake_target" "$cwd" "$prompt" "${filtered[@]}" ) 2>"$cand_err"; then
          spillover_replay_success_stderr "$cand_err"
          rm -f "$cand_err" "$auto_diag"
          return 0
        else
          last_rc=$?
        fi
        cat "$cand_err" >>"$auto_diag"
        rm -f "$cand_err"
      elif spillover_try_candidate 0 "$wake_target" "$cwd" "$prompt" "${filtered[@]}"; then
        return 0
      else
        last_rc=$?
      fi
      [[ -n "$auto_diag" && -s "$auto_diag" ]] && cat "$auto_diag" >&2
      [[ -n "$auto_diag" ]] && rm -f "$auto_diag"
      echo "wrk: remote host '$wake_target' answered its wake but the spawn still failed (rc=$last_rc); not falling back to local" >&2
      return "$last_rc"
    fi
    [[ -n "$auto_diag" && -s "$auto_diag" ]] && cat "$auto_diag" >&2
    [[ -n "$auto_diag" ]] && rm -f "$auto_diag"
    echo "wrk: $SPILL_WAKE_ERR; not falling back to local" >&2
    return "$WRK_EXIT_WAKE_FAILED"
  fi
  # An explicit --host NAME is an operator forcing one remote: propagate the
  # remote exit instead of quietly landing the pane locally (#571).  The local
  # fallback below exists for --host auto only.
  if [[ "$requested" != auto ]]; then
    if [[ "$LOCAL_SPAWN_ALLOWED" -eq 1 ]]; then
      echo "wrk: remote spawn on explicit host '$requested' failed (rc=$last_rc) at step '${SPILL_REMOTE_STEP:-unknown}'; no local fallback — fix the remote or use --host local" >&2
    else
      echo "wrk: remote spawn on explicit host '$requested' failed (rc=$last_rc) at step '${SPILL_REMOTE_STEP:-unknown}'; no local fallback — fix the remote (local spawns are disabled on this host: [local] spawn = false)" >&2
    fi
    return "$last_rc"
  fi
  [[ -s "$auto_diag" ]] && cat "$auto_diag" >&2
  rm -f "$auto_diag"
  if [[ "$LOCAL_SPAWN_ALLOWED" -eq 0 ]]; then
    echo "wrk: local spawns are disabled on this host ([local] spawn = false); no remote candidate completed." >&2
    return "$WRK_EXIT_LOCAL_SPAWN_DISABLED"
  fi
  warn "no remote spill-over candidate completed; falling back to local"
  out="$(mktemp)"
  set +e
  ( set -e; spawn_cmd "${filtered[@]}" ) >"$out"
  rc=$?
  set -e
  spillover_emit_host local "$out"
  rm -f "$out"
  return "$rc"
}

# #1155: this host's own [local] spawn key decides whether local spawns may
# run here at all. Sets LOCAL_SPAWN_ALLOWED (1 allowed, 0 forbidden). Absent
# or `spawn = true` is the historical behavior and byte-identical to before;
# `spawn = false` forbids every local spawn path — --host auto treats local
# as an unavailable candidate, --host local refuses, and a delegated ssh
# spawn (which arrives as --host local on the execution host) refuses too.
# Accepted values are the bare TOML booleans true/false — a quoted spelling
# such as "false" is a string, not a boolean, so it refuses like any other
# value (fail-closed, the same boundary quota_gate uses).
#
# #1163: the resolution is fail-closed — a safety switch that reads
# "allowed" on a typo is worse than none. local_spawn_scan refuses (rc 70,
# reason in LOCAL_SPAWN_ERROR as "<config> line N: ...") when the [local]
# surface is not in the one accepted shape:
#   - a header that names the local table but is not exactly '[local]' on
#     its own line: '[local] # note', '[ local ]', '["local"]', '[[local]]',
#     a truncated '[local', or '[local]' with trailing text;
#   - a second [local] table header;
#   - inside [local], a second spawn key whatever its value, or a line
#     starting a would-be spawn key that is not 'spawn = <value>' (bare
#     'spawn', 'spawn: false', 'spawn == false', a quoted "spawn" key);
#   - a spawn value other than bare true/false after stripping a trailing
#     '#' comment and whitespace;
#   - any content before the first table header — the root table must be
#     empty, so 'local.spawn = false', '"local".spawn = false' or
#     'local = { spawn = false }' there are root keys, not the flag;
#   - a UTF-8 BOM at any line start (including line 1).
# A hosts.toml that exists but is not a readable regular file also refuses,
# and so does a path whose existence cannot be determined because a parent
# directory is not searchable (stat EACCES) — a truly absent file stays
# allowed. Everything else — no [local], [local] without spawn, one clean
# spawn = true/false, every other key and every other section (a
# 'local.spawn' under [hosts.x] is hosts.x.local.spawn and is ignored) —
# behaves exactly as before; other readers keep going through
# spillover_value, whose behavior this does not change.
#
# #1241: the same accepted [local] shape carries a second strict boolean —
# 'heavy_load_wait = true|false' gates wrk heavy's post-slot load5/ncpu
# wait. It is scanned here with the spawn rules verbatim (one clean
# bare-boolean assignment; every would-be spelling, duplicate or other
# value refuses), exported as LOCAL_HEAVY_LOAD_WAIT (1 = wait, absent/true;
# 0 = skip) and LOCAL_HEAVY_LOAD_WAIT_SRC for the status lines. The refusal
# is shared: a malformed heavy_load_wait also fails spawn placement and
# vice versa — one [local] surface, one grammar.
# #1492: shell_ready_timeout_ms is the third strict [local] key. It accepts
# one bare integer from 30000 through 300000 and is used as a floor for each
# kind's existing shell readiness window. An absent key leaves each default
# unchanged; a malformed or out-of-range assignment refuses before spawn.
local_spawn_table_name() {
  # Canonical name a bracketed line would give its table: trim, drop one
  # bracket layer ('[[x]]' arrives as inner '[x'), then one quoting layer
  # ('"local"'/'\'local\'' -> local). Callers compare against 'local'.
  local name
  name="$(spillover_trim "$1")"
  name="${name#\[}"
  name="${name%\]}"
  name="$(spillover_trim "$name")"
  if [[ "${#name}" -ge 2 ]] &&
    { [[ "$name" == \"*\" && "$name" == *\" ]] ||
      [[ "$name" == \'* && "$name" == *\' ]]; }; then
    name="${name:1:${#name}-2}"
  fi
  printf '%s' "$name"
}

local_spawn_scan() {
  LOCAL_SPAWN_ALLOWED=1
  LOCAL_HEAVY_LOAD_WAIT=1
  LOCAL_HEAVY_LOAD_WAIT_SRC=default
  LOCAL_SHELL_READY_TIMEOUT_MS=0
  LOCAL_SHELL_READY_TIMEOUT_SRC=default
  LOCAL_SPAWN_ERROR=""
  local config line="" current="" inner rest name value
  local n=0 local_seen=0 spawn_seen=0 heavy_load_wait_seen=0 shell_ready_timeout_seen=0
  config="$(spillover_config)"
  if [[ ! -e "$config" && ! -L "$config" ]]; then
    # The stat failed: a real ENOENT means no flag, but an unsearchable
    # parent (EACCES) makes "absent" unprovable. Walk up to the nearest
    # ancestor that stats; refuse unless it is a searchable directory —
    # anything shallower under it cannot hide a config either way.
    local dir
    dir="$(dirname -- "$config")"
    while [[ ! -e "$dir" && ! -L "$dir" && "$dir" != / && "$dir" != . ]]; do
      dir="$(dirname -- "$dir")"
    done
    if [[ -d "$dir" && ! -x "$dir" ]]; then
      LOCAL_SPAWN_ERROR="$config: existence cannot be determined (a parent directory is not searchable)"
      return "$WRK_EXIT_CONFIG_REFUSED"
    fi
    return 0
  fi
  if [[ ! -f "$config" || ! -r "$config" ]]; then
    LOCAL_SPAWN_ERROR="$config: exists but is not a readable regular file"
    return "$WRK_EXIT_CONFIG_REFUSED"
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    if [[ "$line" == $'\xef\xbb\xbf'* ]]; then
      LOCAL_SPAWN_ERROR="$config line $n: UTF-8 BOM at a line start is not valid hosts.toml"
      return "$WRK_EXIT_CONFIG_REFUSED"
    fi
    line="$(spillover_trim "$line")"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == \[* ]]; then
      if [[ "$line" =~ ^\[([^]]*)\](.*)$ ]]; then
        inner="${BASH_REMATCH[1]}" rest="${BASH_REMATCH[2]}"
      else
        # No ']' anywhere — e.g. a truncated '[local'.
        inner="${line#\[}" rest=unterminated
      fi
      name="$(local_spawn_table_name "$inner")"
      if [[ "$name" == local && "$line" == '[local]' ]]; then
        local_seen=$((local_seen + 1))
        if [[ "$local_seen" -gt 1 ]]; then
          LOCAL_SPAWN_ERROR="$config line $n: duplicate [local] table header"
          return "$WRK_EXIT_CONFIG_REFUSED"
        fi
        current=local
      elif [[ "$name" == local ]]; then
        LOCAL_SPAWN_ERROR="$config line $n: [local] table header must be exactly '[local]' on its own line"
        return "$WRK_EXIT_CONFIG_REFUSED"
      elif [[ -z "$rest" ]]; then
        current="$inner"
      elif [[ -z "$current" ]]; then
        # A bracketed line that names no local table and is not a clean
        # header ('[x] junk', an unclosed '[x') cannot end the root table —
        # as root content it violates the empty-root rule below. Under a
        # table it keeps the same ignore spillover_value gives it.
        LOCAL_SPAWN_ERROR="$config line $n: root table must be empty in hosts.toml (keys belong under a [table] header)"
        return "$WRK_EXIT_CONFIG_REFUSED"
      fi
      continue
    fi
    if [[ -z "$current" ]]; then
      # The root table must be empty: every line before the first table
      # header that is not blank or a comment — 'local.spawn = false',
      # '"local".spawn = false', 'local = { spawn = false }', any other key
      # or stray text — is refused rather than read or ignored.
      LOCAL_SPAWN_ERROR="$config line $n: root table must be empty in hosts.toml (keys belong under a [table] header)"
      return "$WRK_EXIT_CONFIG_REFUSED"
    fi
    [[ "$current" == local ]] || continue
    # #1492: a bare integer, with the same one-key, one-clean-assignment
    # grammar as the other strict [local] settings. Check the decimal length
    # before arithmetic so an arbitrarily large integer cannot wrap in bash.
    case "$line" in
      shell_ready_timeout_ms[A-Za-z0-9_-]*) ;;   # a different bare key
      shell_ready_timeout_ms* | '"shell_ready_timeout_ms"'* | "'shell_ready_timeout_ms'"*)
        if [[ "$line" =~ ^shell_ready_timeout_ms[[:space:]]*=[[:space:]]*(.*)$ ]] && [[ "${BASH_REMATCH[1]}" != =* ]]; then
          value="${BASH_REMATCH[1]}"
        else
          LOCAL_SPAWN_ERROR="$config line $n: malformed shell_ready_timeout_ms assignment in [local] (expected 'shell_ready_timeout_ms = integer')"
          return "$WRK_EXIT_CONFIG_REFUSED"
        fi
        value="${value%%#*}"
        value="$(spillover_trim "$value")"
        shell_ready_timeout_seen=$((shell_ready_timeout_seen + 1))
        if [[ "$shell_ready_timeout_seen" -gt 1 ]]; then
          LOCAL_SPAWN_ERROR="$config line $n: duplicate shell_ready_timeout_ms key in [local]"
          return "$WRK_EXIT_CONFIG_REFUSED"
        fi
        if [[ ! "$value" =~ ^(0|[1-9][0-9]*)$ ]]; then
          LOCAL_SPAWN_ERROR="$config line $n: [local] shell_ready_timeout_ms must be a bare integer from 30000 to 300000 (got '$value')"
          return "$WRK_EXIT_CONFIG_REFUSED"
        fi
        if (( ${#value} > 6 )) || (( 10#$value < 30000 || 10#$value > 300000 )); then
          LOCAL_SPAWN_ERROR="$config line $n: [local] shell_ready_timeout_ms must be from 30000 to 300000 (got '$value')"
          return "$WRK_EXIT_CONFIG_REFUSED"
        fi
        LOCAL_SHELL_READY_TIMEOUT_MS="$value"
        LOCAL_SHELL_READY_TIMEOUT_SRC="$config [local] shell_ready_timeout_ms"
        continue ;;
    esac
    # #1241: 'heavy_load_wait' is the second strict [local] boolean — same
    # accepted shape as spawn below (bare 'heavy_load_wait = true|false');
    # every would-be spelling refuses, and a bare key it merely prefixes
    # ('heavy_load_wait_extra') is somebody else's and ignored.
    case "$line" in
      heavy_load_wait[A-Za-z0-9_-]*) ;;   # a different bare key
      heavy_load_wait* | '"heavy_load_wait"'* | "'heavy_load_wait'"*)
        if [[ "$line" =~ ^heavy_load_wait[[:space:]]*=[[:space:]]*(.*)$ ]] && [[ "${BASH_REMATCH[1]}" != =* ]]; then
          value="${BASH_REMATCH[1]}"
        else
          LOCAL_SPAWN_ERROR="$config line $n: malformed heavy_load_wait assignment in [local] (expected 'heavy_load_wait = true|false')"
          return "$WRK_EXIT_CONFIG_REFUSED"
        fi
        value="${value%%#*}"
        value="$(spillover_trim "$value")"
        heavy_load_wait_seen=$((heavy_load_wait_seen + 1))
        if [[ "$heavy_load_wait_seen" -gt 1 ]]; then
          LOCAL_SPAWN_ERROR="$config line $n: duplicate heavy_load_wait key in [local]"
          return "$WRK_EXIT_CONFIG_REFUSED"
        fi
        case "$value" in
          true) ;;
          false) LOCAL_HEAVY_LOAD_WAIT=0 ;;
          *) LOCAL_SPAWN_ERROR="$config line $n: [local] heavy_load_wait accepts only the bare TOML booleans true or false (got '$value')"
             return "$WRK_EXIT_CONFIG_REFUSED" ;;
        esac
        LOCAL_HEAVY_LOAD_WAIT_SRC="$config [local] heavy_load_wait"
        continue ;;
    esac
    case "$line" in
      spawn[A-Za-z0-9_-]*) continue ;;   # a different bare key
      spawn* | '"spawn"'* | "'spawn'"*) ;;   # a would-be spawn key
      *) continue ;;
    esac
    if [[ "$line" =~ ^spawn[[:space:]]*=[[:space:]]*(.*)$ ]] && [[ "${BASH_REMATCH[1]}" != =* ]]; then
      value="${BASH_REMATCH[1]}"
    else
      LOCAL_SPAWN_ERROR="$config line $n: malformed spawn assignment in [local] (expected 'spawn = true|false')"
      return "$WRK_EXIT_CONFIG_REFUSED"
    fi
    value="${value%%#*}"
    value="$(spillover_trim "$value")"
    spawn_seen=$((spawn_seen + 1))
    if [[ "$spawn_seen" -gt 1 ]]; then
      LOCAL_SPAWN_ERROR="$config line $n: duplicate spawn key in [local]"
      return "$WRK_EXIT_CONFIG_REFUSED"
    fi
    case "$value" in
      true) ;;
      false) LOCAL_SPAWN_ALLOWED=0 ;;
      *) LOCAL_SPAWN_ERROR="$config line $n: [local] spawn accepts only the bare TOML booleans true or false (got '$value')"
         return "$WRK_EXIT_CONFIG_REFUSED" ;;
    esac
  done <"$config" || {
    # -f/-r passed but the open still failed (vanished, ACL) — fail closed.
    LOCAL_SPAWN_ERROR="$config: exists but is not a readable regular file"
    return "$WRK_EXIT_CONFIG_REFUSED"
  }
  return 0
}

local_spawn_resolve() {
  local rc=0
  local_spawn_scan || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "wrk: ${LOCAL_SPAWN_ERROR}; refusing spawn" >&2
    return "$rc"
  fi
}

# The "use --host local" tail on failure lines is only advice while this host
# accepts local spawns; with [local] spawn = false the tail names the flag
# instead of an override that would be refused. $1 is the non-local
# alternative the line also suggests (configure hosts.toml, retry, ...).
spillover_local_advice() {
  if [[ "${LOCAL_SPAWN_ALLOWED:-1}" -eq 0 ]]; then
    printf 'local spawns are disabled on this host ([local] spawn = false)%s' "${1:+; }$1"
  else
    printf 'use --host local%s' "${1:+ or }$1"
  fi
}

hosts_help() {
  cat <<'USAGE'
Usage: wrk hosts

Print the resolved hosts.toml path, this host's [local] spawn flag state
(local spawn=allowed|disabled|error — an error means the file refuses
spawns with rc 70; hosts is a reporting command and stays rc 0) and its
[local] heavy_load_wait state (local heavy_load_wait=true|false|error —
one strict scan covers the whole [local] surface, so a scan error shows on
both lines; wrk heavy --help documents the switch), this host's measured
load (load5/ncpu ratio and active spawn count), then probe
every configured spill-over host and print a status table (available, or
the probe failure reason, with the remote load/active counts when
reachable).

  -h, --help   show this usage
USAGE
}

hosts_cmd() {
  local host config
  if [[ $# -gt 0 ]]; then
    if [[ "$1" == "-h" || "$1" == "--help" ]]; then
      [[ $# -eq 1 ]] || die "unexpected argument '$2'"
      hosts_help
      return 0
    fi
    die "unexpected argument '$1'"
  fi
  config="$(spillover_config)"
  spillover_local_measure
  printf 'config=%s\n' "$config"
  # #1163: surface the [local] spawn switch so a mistyped closure is visible
  # on the reporting path. hosts is read-only — a config error shows as
  # `error (...)` here and must not change this command's exit code.
  local_spawn_scan || true
  if [[ -n "${LOCAL_SPAWN_ERROR:-}" ]]; then
    printf 'local spawn=error (%s)\n' "$LOCAL_SPAWN_ERROR"
  elif [[ "${LOCAL_SPAWN_ALLOWED:-1}" -eq 0 ]]; then
    printf 'local spawn=disabled\n'
  else
    printf 'local spawn=allowed\n'
  fi
  # #1241: the second strict [local] switch rides the same scan — one error
  # covers the whole surface, so it is echoed on this line too.
  if [[ -n "${LOCAL_SPAWN_ERROR:-}" ]]; then
    printf 'local heavy_load_wait=error (%s)\n' "$LOCAL_SPAWN_ERROR"
  elif [[ "${LOCAL_HEAVY_LOAD_WAIT:-1}" -eq 0 ]]; then
    printf 'local heavy_load_wait=false\n'
  else
    printf 'local heavy_load_wait=true\n'
  fi
  printf 'local load5=%s ncpu=%s ratio=%s active=%s\n' "${SPILL_LOAD:-unknown}" "${SPILL_NCPU:-unknown}" "${SPILL_RATIO:-unknown}" "${SPILL_ACTIVE:-unknown}"
  printf 'host\tstatus\tload5\tactive\n'
  for host in $(spillover_hosts); do
    if spillover_probe_host "$host"; then
      printf '%s\tavailable\t%s\t%s\n' "$host" "${SPILL_REMOTE_LOAD:-unknown}" "${SPILL_REMOTE_ACTIVE:-unknown}"
    else
      printf '%s\t%s\t%s\t%s\n' "$host" "$SPILL_PROBE_REASON" "${SPILL_REMOTE_LOAD:-unknown}" "${SPILL_REMOTE_ACTIVE:-unknown}"
    fi
  done
}


# ---------------------------------------------------------------- hk task link
# #768 / hk:doc decision/2026-09-27/task-job-linkage item 1: every spawned job
# is bound to a handoffkeep task. --task names the task the new job owns;
# tester/advisory (child) spawns inherit the parent task instead — explicit
# --parent-job, else the calling session's ARBITER_JOB claim, else HK_TASK_ID
# env. The hk write is a single `tasks claim <id> --by <label> --job-id <job>`
# on the success path only; a failed spawn must leave hk untouched, so the
# probe below is read-only and the claim is the last side effect before the
# OK line. Deployed hk predating claim+job_id support drops --job-id silently:
# the post-claim verify turns that into a loud spawn failure instead of a
# record that looks linked but is not (never two calls — see the report).

HK_CMD_TIMEOUT="${HK_CMD_TIMEOUT:-15}"

hk_bin() {
  command -v "${HANDOFFKEEP_BIN:-handoffkeep}" 2>/dev/null || true
}

# A wedged handoffkeep must not stall a spawn. `timeout` is GNU coreutils and
# a stock macOS has neither it nor gtimeout, so python3 — already a hard
# dependency — carries the same guard there (same pattern as the panewire
# guard above).
hk_cmd() {
  local bin="$1"; shift
  run_bounded "$HK_CMD_TIMEOUT" "$bin" "$@"
}

# Ordinary implicit counsel shapes predate explicit worker-seat restrictions.
# Round-extension spawns still require the caller to choose an explicit role.
normalize_implicit_counsel_role() {
  [[ "${ROLE_EXPLICIT:-1}" == 0 && "$ROLE" == worker && -z "$ROUND_EXT_REF" ]] || return 0
  [[ "$MODEL" == codex-astra || "$MODEL" == fable ]] || return 0
  local normalized
  normalized="$(printf '%s' "$PURPOSE" | python3 -c 'import sys; print(sys.stdin.read().strip().casefold())')"
  [[ "$normalized" != round-extension ]] || return 0
  case "$MODEL" in
    codex-astra)
      case "$normalized" in ""|architect|director|operator-request) ROLE=counsel ;; esac ;;
    fable)
      [[ -z "$OPERATOR_REQUEST" ]] || ROLE=counsel ;;
  esac
  return 0
}

# hk 1632: fail closed before catalog/gate calls. Exact parent-job ownership
# is deliberately narrower than accepting any label attached to the same task.
round_ext_validate() {
  if [[ "${MODEL:-}" == builder-astra || "${MODEL:-}" == captain-astra ]]; then
    if [[ "${ROLE:-}" == builder ]]; then
      die "--role builder rejects astra profile '$MODEL': astra is limited to director judgment, architect counsel and operator-requested advice (hk:doc decision/2026-09-21/astra-allowed-purposes-approved)"
    fi
    die "profile '$MODEL' was removed: astra is limited to director judgment, architect counsel and operator-requested advice (hk:doc decision/2026-09-21/astra-allowed-purposes-approved); use codex-astra"
  fi
  if [[ "${MODEL:-}" == codex-astra || "${MODEL:-}" == fable ]] && [[ "${ROLE:-}" == worker ]]; then
    die "astra/fable worker role forbidden; round-extension does not authorize workers"
  fi
  if [[ "${MODEL:-}" == codex-astra || "${MODEL:-}" == fable ]] &&
     [[ "${ROLE:-}" == builder || "${ROLE:-}" == tester || "${ROLE:-}" == reviewer ]]; then
    [[ "$PURPOSE" == round-extension && -n "$ROUND_EXT_REF" ]] ||
      die "astra/fable builder/tester/reviewer requires --purpose round-extension and verified --round-ext REF (role condition, not quota)"
  fi
  [[ -n "$PURPOSE" || -n "$ROUND_EXT_REF" ]] || return 0
  local normalized
  # Match scopefuel's Unicode strip/casefold before deciding whether the
  # paired flags are required; ASCII-only normalization leaves another path.
  normalized="$(printf '%s' "$PURPOSE" | python3 -c 'import sys; print(sys.stdin.read().strip().casefold())')"
  [[ "$normalized" == round-extension || -n "$ROUND_EXT_REF" ]] || return 0
  [[ "$PURPOSE" == round-extension && -n "$ROUND_EXT_REF" ]] ||
    die "--purpose round-extension and --round-ext REF require each other"
  case "$ROLE" in
    builder|tester|reviewer|counsel) ;;
    *) die "round-extension requires --role builder, tester, reviewer or counsel; worker forbidden" ;;
  esac
  case "$MODEL" in
    codex-astra)
      [[ -z "$EFFORT" || "$EFFORT" == xhigh ]] || die "round-extension codex-astra requires effort xhigh"
      EFFORT=xhigh ;;
    fable) ;;
    *) die "round-extension supports only codex-astra or fable" ;;
  esac
  local pattern='^hk:doc/(round-extension|round-ext|[a-z0-9][a-z0-9-]*/round-ext)/[a-z0-9][a-z0-9._-]*$'
  if [[ ${#ROUND_EXT_REF} -gt 128 ]] || ! ascii_re "$ROUND_EXT_REF" "$pattern"; then
    die "--round-ext requires JOB [a-z0-9][a-z0-9._-]* (lowercase JOB starting with a letter/digit), REF at most 128 characters"
  fi
  if [[ "$ROLE" == builder ]]; then
    [[ -n "$TASK_ID" && "${ROUND_EXT_REF##*/}" == "$JOB_ID" ]] ||
      die "--round-ext ownership denied: builder document JOB must equal spawn JOB currently bound to explicit --task"
  else
    [[ -n "$PARENT_JOB" && "${ROUND_EXT_REF##*/}" == "$PARENT_JOB" ]] ||
      die "--round-ext ownership denied: document JOB must equal explicit --parent-job (JOB [a-z0-9][a-z0-9._-]*)"
  fi
  [[ -z "$OPERATOR_REQUEST" || "$OPERATOR_REQUEST" == "$ROUND_EXT_REF" ]] ||
    die "--round-ext conflicts with --operator-request"
  OPERATOR_REQUEST="$ROUND_EXT_REF"
}

round_ext_precheck() {
  [[ -n "$ROUND_EXT_REF" ]] || return 0
  local handoffkeep out grant_job="$PARENT_JOB"
  [[ "$ROLE" != builder ]] || grant_job="$JOB_ID"
  # hk 1894: the grant document and the parent lane come from the canonical
  # binary and inbox, not from HANDOFFKEEP_BIN, PATH or ARBITER_INBOX_ROOT.
  wrk_trust_guard hk
  handoffkeep="$WRK_TRUST_HK"
  [[ -n "$handoffkeep" && -x "$handoffkeep" ]] || die "--round-ext: handoffkeep unavailable"
  out="$(hk_cmd "$handoffkeep" doc get "${ROUND_EXT_REF#hk:doc/}" 2>/dev/null)" ||
    die "--round-ext: document missing or handoffkeep unreachable"
  # A successful transport with an error/empty/malformed body is not existence.
  ROUND_EXT_ISSUER="$(printf '%s' "$out" | wrk_py -c '
import json, os, sys
from pathlib import Path
exec(os.environ["WRK_EVENTS_PY"])

def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON key")
        result[key] = value
    return result

try:
    doc = json.load(sys.stdin, object_pairs_hook=unique_object)
    if (not isinstance(doc, dict) or doc.get("key") != sys.argv[1]
        or not isinstance(doc.get("body"), str) or not doc["body"].strip() or doc.get("error")):
        raise ValueError("not a document")
    issuer = doc["created_by"]
    allowed = set(sys.argv[2].split())
    if issuer not in allowed or sys.argv[5] == "builder":
        events = Path(sys.argv[4])
        claims = [name for name, _, _ in wrk_events_ordered(str(events))
                  if name.endswith(("claim.json", "reclaim.json"))]
        if not claims:
            raise ValueError("issuer requires recorded parent lane")
        record = json.loads((events / claims[-1]).read_text(), object_pairs_hook=unique_object)
        payload = record.get("payload", record)
        parent = payload.get("parent_lane")
        if sys.argv[5] == "builder" and str(payload.get("task_id")) != sys.argv[6]:
            raise ValueError("newest job claim belongs to another task")
        if issuer not in allowed and (issuer not in set(sys.argv[3].split()) or issuer != parent):
            raise ValueError("created_by is not an authorized issuer for this parent job")
    print(issuer)
except (OSError, ValueError, TypeError, AttributeError, KeyError) as error:
    print("--round-ext: document/issuer verification failed: " + str(error), file=sys.stderr)
    raise SystemExit(1)
' "${ROUND_EXT_REF#hk:doc/}" "$ROUND_CAP_OPERATORS" "$ROUND_CAP_PARENT_ISSUERS" \
    "${WRK_TRUST_JOBS_ROOT:?trust guard did not run}/$grant_job/events" "$ROLE" "$TASK_ID")" || die "--round-ext: document missing, unreadable or issuer denied"
}

# Fresh server reads at each builder launch/handoff boundary; never a takeover.
round_ext_builder_recheck() {
  [[ "${ROLE:-}" == builder && -n "${ROUND_EXT_REF:-}" ]] || return 0
  round_ext_precheck
  hk_task_precheck
}

# task_resolve_parent — TASK_INHERITED_FROM is set by the caller to a parent
# job id; fill TASK_ID from its newest claim/reclaim payload. Local read only:
# the job registry under wrk_jobs_root is the same one the claim landed in.
# The newest claim/reclaim event is authoritative: an unreadable one dies
# rather than letting a stale older task_id through (tester finding).
task_resolve_parent() {
  local parent="$1" dir rc
  dir="$(wrk_jobs_root)/$parent/events"
  if TASK_ID="$(wrk_py - "$dir" <<'PY'
import json, os, sys
exec(os.environ["WRK_EVENTS_PY"])
names = [name for name, _, _ in wrk_events_ordered(sys.argv[1])
         if name.endswith(("claim.json", "reclaim.json"))]
if not names:
    raise SystemExit(0)
# The newest claim/reclaim by (event time, mtime, name) is authoritative.
try:
    o = json.load(open(os.path.join(sys.argv[1], names[-1]), encoding="utf-8"))
except (OSError, json.JSONDecodeError):
    raise SystemExit(2)
p = o.get("payload", o)
v = p.get("task_id")
print(v if isinstance(v, int) else (v if isinstance(v, str) else ""))
PY
)"; then
    :
  else
    rc=$?
    if [[ "$rc" -eq 2 ]]; then
      die "parent job '$parent' newest claim/reclaim event is unreadable — refusing to guess the task from older events$(task_remote_hint)"
    fi
    TASK_ID=""
  fi
}

# Remote SSH delegation runs this same inheritance check on the initiator,
# before its first SSH leg. Name the machine where the refusal happened so a
# caller can distinguish an initiator-side failure from the target's answer.
task_remote_hint() {
  [[ "${TASK_REMOTE_INITIATOR:-0}" == 1 ]] || return 0
  local host
  host="$(hostname -s 2>/dev/null || true)"
  [[ -n "$host" ]] || host=local
  printf '; for a remote spawn the initiator must know the task; pass --task (resolution failed on host %s)' "$host"
}

# task_validate — usage-error stage: resolve TASK_ID or die before any side
# effect (gates, pane, hk writes all come later). Sets TASK_LINK_MODE to
# owner (--task) or inherited (tester/advisory path) and TASK_INHERITED_FROM.
task_validate() {
  TASK_LINK_MODE="" TASK_INHERITED_FROM=""
  if [[ -n "$TASK_ID" && ! "$TASK_ID" =~ ^[0-9]+$ ]]; then
    die "--task must be a positive handoffkeep task id (got '$TASK_ID')"
  fi
  if [[ -n "$TASK_ID" ]] && (( 10#$TASK_ID < 1 )); then
    die "--task must be a positive handoffkeep task id (got '$TASK_ID')"
  fi
  if [[ -n "$PARENT_JOB" ]] && ! ascii_re "$PARENT_JOB" '^[A-Za-z0-9._-]+$'; then
    die "--parent-job must be a job id (got '$(scrub_id "$PARENT_JOB")')"
  fi
  if [[ -n "${TAKEOVER_FROM:-}" ]]; then
    ascii_re "$TAKEOVER_FROM" '^[A-Za-z0-9._-]+$' ||
      die "--takeover-from must be a job id (got '$(scrub_id "$TAKEOVER_FROM")')"
    [[ "$ROLE" == builder ]] || die "--takeover-from is builder-only; worker and tester roles cannot take over a task"
    [[ -z "$PARENT_JOB" ]] || die "--takeover-from cannot be combined with --parent-job"
    [[ "$TASK_HK_BYPASS" -eq 0 ]] || die "--takeover-from forbids --task-hk-bypass"
    [[ -z "$ROUND_EXT_REF" ]] || die "--takeover-from cannot be combined with --round-ext"
    [[ "$TAKEOVER_FROM" != "$JOB_ID" ]] || die "--takeover-from must name a different job from --job"
  fi
  if [[ "$ROLE" == builder ]]; then
    [[ -z "$PARENT_JOB" ]] ||
      die "--role builder links its own task with --task; --parent-job is the tester/advisory inheritance path"
    [[ -n "$TASK_ID" ]] ||
      die "--role builder requires --task <hk task id> (decision/2026-09-27/task-job-linkage: every job binds its task)"
    TASK_LINK_MODE="owner"
    return 0
  fi
  if [[ -n "$TASK_ID" && -n "$PARENT_JOB" ]]; then
    die "--task and --parent-job are alternatives — a worker names either its own task or the parent job it inherits from, not both"
  fi
  if [[ -n "$TASK_ID" ]]; then
    TASK_LINK_MODE="owner"
    return 0
  fi
  # Worker/tester/advisory inheritance: the task comes from the parent job's
  # recorded meta, never guessed. Explicit --parent-job first, then the
  # calling session's own arbiter job (spawned panes carry ARBITER_JOB), then
  # the propagated HK_TASK_ID env. SSH delegation resolves these same sources
  # on its initiator before transport and forwards the value as HK_TASK_ID; the
  # via=hub request has no environment field and refuses inherited tasks.
  local env_task=""
  if [[ -z "$PARENT_JOB" && -n "${ARBITER_JOB:-}" ]]; then
    PARENT_JOB="$ARBITER_JOB"
  fi
  if [[ -n "${HK_TASK_ID:-}" ]]; then
    env_task="$HK_TASK_ID"
  fi
  if [[ -n "$PARENT_JOB" ]]; then
    task_resolve_parent "$PARENT_JOB"
    if [[ -z "$TASK_ID" && -n "$env_task" ]]; then
      TASK_ID="$env_task"
      TASK_INHERITED_FROM="env:HK_TASK_ID"
    elif [[ -n "$TASK_ID" && -n "$env_task" && "$TASK_ID" != "$env_task" ]]; then
      die "parent job '$PARENT_JOB' recorded task_id=$TASK_ID but HK_TASK_ID=$env_task — refusing to guess; pass --task explicitly"
    else
      TASK_INHERITED_FROM="$PARENT_JOB"
    fi
    [[ -n "$TASK_ID" ]] ||
      die "parent job '$PARENT_JOB' has no task_id in its claim/reclaim meta — pass --task explicitly or re-register the parent with --task$(task_remote_hint)"
    { [[ "$TASK_ID" =~ ^[0-9]+$ ]] && (( 10#$TASK_ID >= 1 )); } ||
      die "task id '$TASK_ID' resolved from parent job '$PARENT_JOB' is not a positive task id — pass --task explicitly$(task_remote_hint)"
    TASK_LINK_MODE="inherited"
    return 0
  fi
  if [[ -n "$env_task" ]]; then
    { [[ "$env_task" =~ ^[0-9]+$ ]] && (( 10#$env_task >= 1 )); } ||
      die "HK_TASK_ID env is not a positive task id ('$env_task') — pass --task explicitly$(task_remote_hint)"
    TASK_ID="$env_task"
    TASK_LINK_MODE="inherited"
    TASK_INHERITED_FROM="env:HK_TASK_ID"
    return 0
  fi
  die "--task <hk task id> is required for --role worker (decision/2026-09-27/task-job-linkage). Tester/advisory spawns may instead inherit the parent task: pass --parent-job <job>, or spawn from a registered job's pane where ARBITER_JOB/HK_TASK_ID is set$(task_remote_hint)"
}

# Resolve inheritance on the initiating host before remote placement probes.
# Explicit --task and builder spawns keep their existing argv unchanged; an
# inherited worker task is forwarded by the SSH transport as one env argv item.
spillover_resolve_remote_task() {
  SPILL_REMOTE_HK_TASK=""
  local role=worker explicit_task=0 parent_job="" arg i=0 args=("$@")
  while [[ "$i" -lt "${#args[@]}" ]]; do
    arg="${args[$i]}"
    case "$arg" in
      --role|--task|--parent-job)
        ((i+=1))
        # Malformed options remain the target wrk's usage error; only valid
        # inheritance requests need an initiator-side lookup here.
        [[ "$i" -lt "${#args[@]}" ]] || return 0
        case "$arg" in
          --role) role="${args[$i]}" ;;
          --task) explicit_task=1 ;;
          --parent-job) parent_job="${args[$i]}" ;;
        esac
        ;;
    esac
    ((i+=1))
  done
  [[ "$role" != builder && "$role" != captain && "$explicit_task" -eq 0 ]] || return 0

  local saved_role="${ROLE:-}" saved_task="${TASK_ID:-}" saved_parent="${PARENT_JOB:-}"
  local saved_link_mode="${TASK_LINK_MODE:-}" saved_inherited_from="${TASK_INHERITED_FROM:-}"
  local TASK_REMOTE_INITIATOR=1
  ROLE="$role" TASK_ID="" PARENT_JOB="$parent_job"
  task_validate
  SPILL_REMOTE_HK_TASK="$TASK_ID"
  ROLE="$saved_role" TASK_ID="$saved_task" PARENT_JOB="$saved_parent"
  TASK_LINK_MODE="$saved_link_mode" TASK_INHERITED_FROM="$saved_inherited_from"
}

# hk_task_gate_failure — the hk-unreachable/undecidable funnel. The override
# flag converts refusal into a recorded bypass; without it the spawn dies
# here, before gates and pane: no job without its task link (AC3).
hk_task_gate_failure() {
  local reason="$1"
  if [[ "$TASK_HK_BYPASS" -eq 1 ]]; then
    warn "hk task precheck unavailable ($reason) — --task-hk-bypass override engaged; spawn proceeds, the link write will be retried after landing and the override recorded in job meta"
    TASK_LINK_STATUS="bypassed:precheck"
    return 0
  fi
  die "hk task precheck failed ($reason) — spawn refused: no job without its task link (pass --task-hk-bypass to override, recorded in job meta)"
}

# hk_task_precheck — read-only `tasks show` classification. Sets
# TASK_LINK_STATUS: link (owner, needs the claim write), already_linked
# (refs.job_id already this job — idempotent re-spawn), inherited (child job:
# meta link only, the owner's claim stands), or bypassed:<reason> under the
# override. Every refusal is a die before any side effect.
hk_task_precheck() {
  TASK_LINK_STATUS=""
  [[ -n "$TASK_ID" ]] || die "internal: task_validate must run before hk_task_precheck"
  local handoffkeep out rc=0 fields t_state="" t_claimed="" t_job=""
  if [[ -n "${ROUND_EXT_REF:-}" ]]; then
    # hk 1894: with a round-extension ref the task binding below (project,
    # refs.job_id) is grant evidence too, so it is read through the guarded
    # handoffkeep, not HANDOFFKEEP_BIN or a PATH lookup.
    wrk_trust_guard hk
    handoffkeep=""
    [[ ! -x "$WRK_TRUST_HK" ]] || handoffkeep="$WRK_TRUST_HK"
  else
    handoffkeep="$(hk_bin)"
  fi
  if [[ -z "$handoffkeep" ]]; then
    hk_task_gate_failure "handoffkeep binary not found (set HANDOFFKEEP_BIN)"
    return 0
  fi
  set +e
  out="$(hk_cmd "$handoffkeep" tasks show "$TASK_ID" 2>&1)"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    if grep -q "not_found" <<<"$out"; then
      die "hk task $TASK_ID does not exist (not_found) — a job binds only an existing task"
    fi
    hk_task_gate_failure "handoffkeep tasks show rc=$rc: ${out:0:200}"
    return 0
  fi
  if [[ -n "${ROUND_EXT_REF:-}" ]]; then
    # The grant needs an unambiguous server binding. Do not transport task
    # fields through shell IFS: empty fields and embedded TABs shift columns.
    local grant_job="$PARENT_JOB" grant_state
    [[ "$ROLE" != builder ]] || grant_job="$JOB_ID"
    grant_state="$(printf '%s' "$out" | python3 -c '
import json, sys, unicodedata

def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON key")
        result[key] = value
    return result

def invalid_constant(value):
    raise ValueError("non-JSON constant")

def controls(value):
    if isinstance(value, str):
        return any(unicodedata.category(char) in {"Cc", "Cf", "Zl", "Zp"} for char in value)
    if isinstance(value, dict):
        return any(controls(key) or controls(item) for key, item in value.items())
    if isinstance(value, list):
        return any(controls(item) for item in value)
    return False

try:
    task = json.load(sys.stdin, object_pairs_hook=unique_object, parse_constant=invalid_constant)
    if not isinstance(task, dict) or not {"state", "claimed_by", "refs"} <= task.keys():
        raise ValueError("missing task fields")
    if (not isinstance(task["state"], str) or not task["state"]
        or not isinstance(task["claimed_by"], str) or not isinstance(task["refs"], dict)):
        raise ValueError("invalid task field types")
    if any(controls(task[key]) for key in ("state", "claimed_by", "refs")):
        raise ValueError("control character in task binding fields")
    job = task["refs"].get("job_id")
    if not isinstance(job, str) or not job:
        raise ValueError("missing refs.job_id binding")
    if job != sys.argv[1]:
        raise ValueError("task is not bound to parent job")
    if "id" in task and str(task["id"]) != sys.argv[3]:
        raise ValueError("reply belongs to another task")
    key = sys.argv[4].removeprefix("hk:doc/")
    if sys.argv[5] == "builder" and key.count("/") == 2 and (not isinstance(task.get("project"), str)
                               or task["project"].casefold() != key.split("/")[0]):
        raise ValueError("document belongs to another project")
    if sys.argv[2] == "pa-integrator" and task.get("project") != "ParkingArcade":
        raise ValueError("pa-integrator issuer requires a ParkingArcade task")
    print(task["state"])
except (ValueError, TypeError) as error:
    print("--round-ext: invalid hk task reply: " + str(error), file=sys.stderr)
    raise SystemExit(1)
' "$grant_job" "$ROUND_EXT_ISSUER" "$TASK_ID" "$ROUND_EXT_REF" "$ROLE")" || die "--round-ext ownership denied: ambiguous or unreadable hk task binding"
    if [[ "$ROLE" == builder ]]; then
      [[ "$TASK_LINK_MODE" == owner ]] || die "--round-ext builder requires explicit --task"
      case "$grant_state" in
        merged|dropped|needs_decision|hold) die "--round-ext builder task is unavailable (state=$grant_state)" ;;
      esac
      TASK_LINK_STATUS="already_linked"
    else
      [[ "$TASK_LINK_MODE" == inherited ]] || die "--round-ext requires inherited task binding"
      TASK_LINK_STATUS="inherited"
    fi
    return 0
  fi
  set +e
  # One tab-separated line: per-line prints would lose trailing empty fields
  # to command-substitution stripping and the third `read` would hit EOF.
  fields="$(printf '%s' "$out" | python3 -c '
import json, sys
try: d = json.loads(sys.stdin.read())
except ValueError: raise SystemExit(1)
refs = d.get("refs") or {}
print("\t".join([d.get("state") or "", d.get("claimed_by") or "",
                 refs.get("job_id") or ""]))')"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    hk_task_gate_failure "handoffkeep tasks show returned unreadable JSON"
    return 0
  fi
  IFS=$'\t' read -r t_state t_claimed t_job <<<"$fields"
  if [[ "$TASK_LINK_MODE" == inherited ]]; then
    # Child jobs never claim: the owner's record stands. Existence is the
    # only requirement; state is observational.
    TASK_LINK_STATUS="inherited"
    return 0
  fi
  case "$t_state" in
    merged|dropped)
      die "hk task $TASK_ID is '$t_state' — a closed task is not a spawn target" ;;
    needs_decision)
      die "hk task $TASK_ID awaits an operator decision (needs_decision) — resolve it before spawning" ;;
    hold)
      die "hk task $TASK_ID is on hold — release it before spawning" ;;
  esac
  if [[ -n "$t_job" && "$t_job" != "$JOB_ID" ]]; then
    die "hk task $TASK_ID is already bound to job '$t_job' (state=$t_state claimed_by=${t_claimed:-none}) — a task linked to another job cannot be re-spawned (fail-closed)"
  fi
  if [[ "$t_job" == "$JOB_ID" ]]; then
    TASK_LINK_STATUS="already_linked"
    return 0
  fi
  # Unbound. A claim recorded under a different label is a half-record wrk
  # must not merge into; the same label is the repair path (a claim that
  # landed without job_id, e.g. a bypassed spawn being re-run).
  if [[ -n "$t_claimed" && "$t_claimed" != "$LABEL" ]]; then
    die "hk task $TASK_ID is claimed by '$t_claimed' but bound to no job — a half-record; refusing to merge into another lane's claim"
  fi
  TASK_LINK_STATUS="link"
  return 0
}

# A takeover is permitted only when the shared event-time order says the old
# job has a work-terminal record newer than its newest revive. This read-only
# check runs before admission side effects and is repeated immediately before
# handoffkeep rebinds the task.
takeover_old_job_check() {
  local old="$1" events scan ended
  # hk 1894: the inherited round count is read from the canonical inbox only.
  wrk_trust_guard
  events="${WRK_TRUST_JOBS_ROOT:?trust guard did not run}/$old/events"
  [[ -d "$events" ]] || die "takeover refused: old job '$old' has no event history"
  scan="$(job_events_scan "$events")" || die "takeover refused: cannot inspect old job '$old'"
  IFS=$'\t' read -r _ ended _ _ <<<"$scan"
  [[ "$ended" == 1 ]] ||
    die "takeover refused: old job '$old' is still live; no work-terminal follows its newest revive"
  TAKEOVER_ROUNDS_USED="$(round_scan "$old" | sed -n 's/^rounds=\([0-9][0-9]*\)[[:space:]].*/\1/p')"
  [[ "$TAKEOVER_ROUNDS_USED" =~ ^[0-9]+$ ]] ||
    die "takeover refused: cannot read old job '$old' round count"
}

# Read-only task check. The sole non-OLD row accepted is the same-NEW/same-
# label replay; the API remains the authority that checks its matching audit
# event before treating that request as a no-op.
hk_task_takeover_precheck() {
  [[ -n "$TASK_ID" && -n "$TAKEOVER_FROM" ]] ||
    die "internal: task_validate must run before takeover precheck"
  takeover_old_job_check "$TAKEOVER_FROM"
  local handoffkeep out rc=0 parsed
  handoffkeep="$(hk_bin)"
  [[ -n "$handoffkeep" ]] || die "takeover refused: handoffkeep binary not found (set HANDOFFKEEP_BIN)"
  set +e
  out="$(hk_cmd "$handoffkeep" tasks show "$TASK_ID" 2>&1)"
  rc=$?
  set -e
  [[ "$rc" -eq 0 ]] || die "takeover refused: handoffkeep tasks show failed: ${out:0:200}"
  parsed="$(printf '%s' "$out" | python3 -c '
import json, sys
try:
    task = json.load(sys.stdin)
    if not isinstance(task, dict): raise ValueError("task is not an object")
    state, claimant = task.get("state"), task.get("claimed_by")
    refs = task.get("refs")
    if not isinstance(state, str) or not isinstance(claimant, str) or not isinstance(refs, dict):
        raise ValueError("missing task binding fields")
    job = refs.get("job_id")
    events = task.get("events") or []
    replay = any(isinstance(event, dict) and isinstance(event.get("rebind"), dict)
                 and event["rebind"].get("from_job") == sys.argv[1]
                 and event["rebind"].get("to_job") == sys.argv[2]
                 and event["rebind"].get("by") == sys.argv[3]
                 for event in events)
    if state not in ("claimed", "in_progress"):
        raise ValueError("task state is not claimed or in_progress (state=%s)" % state)
    if not ((job == sys.argv[1]) or (job == sys.argv[2] and claimant == sys.argv[3] and replay)):
        raise ValueError("task is bound to current job %s (claimed_by=%s)" % (job or "(none)", claimant or "(none)"))
    print("ok")
except (ValueError, TypeError, AttributeError) as error:
    print(str(error), file=sys.stderr)
    raise SystemExit(1)
' "$TAKEOVER_FROM" "$JOB_ID" "$LABEL" 2>&1)" ||
    die "takeover refused: task $TASK_ID binding check failed: $parsed"
  [[ "$parsed" == ok ]] || die "takeover refused: task $TASK_ID binding check failed: $parsed"
  TASK_LINK_STATUS="takeover"
}

# The task rebind must land before any pane is created. Only a successful,
# verified response is followed by the paired local audit records.
hk_task_takeover_rebind() {
  [[ -n "$TAKEOVER_FROM" ]] || return 0
  hk_task_takeover_precheck
  local handoffkeep out rc=0 verify release_rc=0
  handoffkeep="$(hk_bin)"
  [[ -n "$handoffkeep" ]] || die "takeover refused: handoffkeep binary not found (set HANDOFFKEEP_BIN)"
  set +e
  out="$(hk_cmd "$handoffkeep" tasks rebind "$TASK_ID" --from-job "$TAKEOVER_FROM" \
    --to-job "$JOB_ID" --by "$LABEL" --reason "builder takeover from $TAKEOVER_FROM" 2>&1)"
  rc=$?
  set -e
  [[ "$rc" -eq 0 ]] || die "takeover refused: handoffkeep tasks rebind failed: ${out:0:300}"
  verify="$(printf '%s' "$out" | python3 -c '
import json, sys
try:
    task = json.load(sys.stdin)
    if (not isinstance(task, dict) or task.get("state") not in ("claimed", "in_progress")
        or task.get("claimed_by") != sys.argv[1]
        or not isinstance(task.get("refs"), dict)
        or task["refs"].get("job_id") != sys.argv[2]):
        raise ValueError("task response did not confirm the new binding")
except (ValueError, TypeError, AttributeError, KeyError) as error:
    print(str(error), file=sys.stderr)
    raise SystemExit(1)
print("ok")
' "$LABEL" "$JOB_ID" 2>&1)" || die "takeover refused: invalid task rebind response: $verify"
  [[ "$verify" == ok ]] || die "takeover refused: invalid task rebind response: $verify"
  takeover_event_pair_commit
  # hk1798: job.handed_off is the old job's last work-terminal — hand back
  # every quota_pool record it still holds; a re-recorded or never-released
  # pool survives the hand-off otherwise.
  release_job_quota_pool "$TAKEOVER_FROM" || release_rc=$? # hk1813-takeover-release-best-effort
  if (( release_rc != 0 && release_rc != 2 )); then
    warn "takeover quota cleanup skipped for $TAKEOVER_FROM (rc=$release_rc)"
  fi
  return 0
}

# Commit both local audit records under their event locks. A rebind that the
# server refuses reaches neither call nor event directory.
takeover_event_pair_commit() {
  local old_events new_events
  old_events="$(wrk_jobs_root)/$TAKEOVER_FROM/events"
  new_events="$(wrk_jobs_root)/$JOB_ID/events"
  wrk_py - "$old_events" "$new_events" "$TAKEOVER_FROM" "$JOB_ID" \
    "$TASK_ID" "$TAKEOVER_ROUNDS_USED" "$LABEL" "$BUILDER_LANE" "$PARENT_LANE" <<'PY'
import json, os, sys
exec(os.environ["WRK_EVENTS_PY"])
old_events, new_events, old_job, new_job, task, rounds, label, lane, parent = sys.argv[1:]
rounds = int(rounds)
for directory in (old_events, new_events):
    os.makedirs(directory, exist_ok=True)
locks = [wrk_events_locked(path) for path in sorted((old_events, new_events))]
new_record = {"kind": "job.takeover", "job_id": new_job, "from_job": old_job,
              "task_id": int(task), "rounds_used": rounds, "label": label,
              "owner_lane": lane, "parent_lane": parent, "role": "builder", "epoch": 1}
old_record = {"kind": "job.handed_off", "job_id": old_job, "to_job": new_job,
              "task_id": int(task), "rounds_used": rounds, "label": label,
              "owner_lane": lane, "parent_lane": parent, "role": "builder", "epoch": 1}
def matching(directory, kind, fields):
    matches = []
    for _, document, _ in wrk_events_ordered(directory):
        if document is None or document.get("kind") != kind:
            continue
        payload = document.get("payload", document)
        if isinstance(payload, dict) and all(payload.get(key) == value for key, value in fields.items()):
            matches.append(payload)
    return matches

new_match = matching(new_events, "job.takeover", {
    "job_id": new_job, "from_job": old_job, "task_id": int(task), "rounds_used": rounds})
old_match = matching(old_events, "job.handed_off", {
    "job_id": old_job, "to_job": new_job, "task_id": int(task), "rounds_used": rounds})
if not new_match:
    wrk_event_commit(new_events, "job.takeover", new_record)
if not old_match:
    wrk_event_commit(old_events, "job.handed_off", old_record)
for lock in reversed(locks):
    lock.close()
PY
}

# hk_task_link_event — durable link outcome in the job's own events, next to
# claim/reclaim. Best-effort: the claim payload already carries task_id; this
# record answers "did the hk side land" from files alone.
hk_task_link_event() {
  local status="$1" detail="${2:-}"
  [[ "${ARBITER_JOB_REGISTERED:-0}" -eq 1 && -n "${ARBITER:-}" && -x "${ARBITER:-}" ]] || return 0
  local payload
  payload="$(python3 - "$TASK_ID" "$status" "$LABEL" "$JOB_ID" "$TASK_LINK_MODE" "$TASK_INHERITED_FROM" "$detail" <<'PY'
import json, sys
task_id, status, label, job, mode, inherited, detail = sys.argv[1:]
x = {"task_id": int(task_id) if task_id.isdigit() else task_id,
     "status": status, "claimed_by": label, "job_id": job, "mode": mode}
if inherited: x["inherited_from"] = inherited
if detail: x["detail"] = detail[:200]
print(json.dumps(x, separators=(",", ":")))
PY
)" || return 0
  "$ARBITER" event --job "$JOB_ID" --kind job.task_link --payload-json "$payload" >/dev/null 2>&1 ||
    warn "arbiter job.task_link event failed (job=$JOB_ID task=$TASK_ID status=$status)"
  return 0
}

# hk_task_link — the only hk write in the spawn path, and deliberately the
# last side effect before the OK line: a failed spawn changes nothing in hk.
# One `tasks claim` call must land claimed_by=<spawned label> AND
# refs.job_id=<job> together; the response verify turns a hk that drops
# job_id (predates claim+job_id support) into a loud refusal rather than a
# silently half-written record. claim's own conflict keeps a concurrent
# winner: the losing spawn dies here and its pane is cleaned by the EXIT trap.
hk_task_link() {
  [[ -n "$TASK_ID" ]] || return 0
  # A claim that attempted and failed runs under the installation-transition
  # contract: the spawn continued without registration, so bind the task
  # through hk anyway — it is the durable record — and say so loudly rather
  # than silently leaving the bind unevidenced in the arbiter events.
  if [[ "${ARBITER_CLAIM_FAILED:-0}" -eq 1 ]]; then
    warn "arbiter claim failed for job $JOB_ID; binding task $TASK_ID via hk as the durable record — the job events will not carry a task_link entry (unregistered job)"
  fi
  # Inherited children never claim: the owner's record stands. Even when a
  # bypass flag degraded the precheck to bypassed:*, the link write stays
  # owner-only — the outcome is recorded, the task is untouched.
  if [[ "$TASK_LINK_MODE" == "inherited" ]]; then
    local st="$TASK_LINK_STATUS"
    [[ "$st" == bypassed:* ]] || st="inherited"
    hk_task_link_event "$st" ""
    return 0
  fi
  case "$TASK_LINK_STATUS" in
    link|bypassed:*) ;;
    already_linked|inherited|takeover) hk_task_link_event "$TASK_LINK_STATUS" ""; return 0 ;;
    *) warn "hk task link skipped: unknown status '$TASK_LINK_STATUS'"; return 0 ;;
  esac
  local handoffkeep out rc=0
  handoffkeep="$(hk_bin)"
  if [[ -n "$handoffkeep" ]]; then
    set +e
    out="$(hk_cmd "$handoffkeep" tasks claim "$TASK_ID" --by "$LABEL" --job-id "$JOB_ID" 2>&1)"
    rc=$?
    set -e
  else
    rc=127 out="handoffkeep binary not found (set HANDOFFKEEP_BIN)"
  fi
  if [[ "$rc" -eq 0 ]] &&
    printf '%s' "$out" | python3 -c '
import json, sys
try: d = json.loads(sys.stdin.read())
except ValueError: raise SystemExit(1)
refs = d.get("refs") or {}
ok = d.get("claimed_by") == sys.argv[1] and refs.get("job_id") == sys.argv[2]
raise SystemExit(0 if ok else 1)' "$LABEL" "$JOB_ID"; then
    hk_task_link_event "linked" ""
    return 0
  fi
  # The bypass covers only what it was declared for: hk unreachable at
  # precheck (bypassed:*) plus a nonzero claim rc. A reachable refusal and a
  # response that drops refs.job_id stay fail-closed — they are half-record
  # evidence, not unavailability.
  if [[ "$rc" -ne 0 && "$TASK_HK_BYPASS" -eq 1 && "$TASK_LINK_STATUS" == bypassed:* ]]; then
    warn "hk task link write failed (rc=$rc) but --task-hk-bypass was given — job $JOB_ID proceeds without the hk link; override recorded in job meta"
    hk_task_link_event "bypassed:link_write_failed" "$out"
    return 0
  fi
  die "hk task link failed for task $TASK_ID job $JOB_ID (rc=$rc: ${out:0:300}) — spawn refused after landing; pane and quota record are being released. The claim must set claimed_by and refs.job_id in one call; on an hk predating claim+job_id the task may be left claimed without job_id — repair with 'handoffkeep tasks transition $TASK_ID --to in_progress --job-id $JOB_ID'"
}


# #872: this helper is part of this wrk checkout, never a PATH-selected guard.
# Artifacts live outside the worktree. No guard override or bypass is offered.
mock_mcp_prepare() {
  [[ "$LANE" == mock ]] || return 0
  MOCK_MCP_HELPER="$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve().parent / "wrk-mock-mcp")' "$0")"
  [[ -x "$MOCK_MCP_HELPER" ]] || { echo "wrk: mock MCP isolation helper missing" >&2; return "$WRK_EXIT_MOCK_MCP_REFUSED"; }
  local rc=0
  MOCK_MCP_PLAN="$("$MOCK_MCP_HELPER" prepare --kind "$PROFILE_KIND" --cwd "$CWD" \
    --profile "${MOCK_MCP_PROFILE:-}" --config "${WRK_MOCK_MCP_CONFIG:-}" -- "${ARGS[@]}")" || rc=$?
  [[ "$rc" -eq 0 ]] || return "$WRK_EXIT_MOCK_MCP_REFUSED"
  CWD="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["cwd"])' "$MOCK_MCP_PLAN")"
  ARGS=()
  while IFS= read -r -d '' value; do ARGS+=("$value"); done < <(
    python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.stdout.buffer.write(b"".join(x.encode()+b"\0" for x in d["argv"]))' "$MOCK_MCP_PLAN")
  while IFS= read -r -d '' value; do TAB_ENV+=(--env "$value"); done < <(
    python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.stdout.buffer.write(b"".join((k+"="+v).encode()+b"\0" for k,v in d["env"].items()))' "$MOCK_MCP_PLAN")
  mock_mcp_verify
}

mock_mcp_verify() {
  [[ "$LANE" == mock ]] || return 0
  [[ -n "${MOCK_MCP_PLAN:-}" ]] || { echo "wrk: mock MCP connection was not prepared" >&2; return "$WRK_EXIT_MOCK_MCP_REFUSED"; }
  local verify_args=(verify --plan "$MOCK_MCP_PLAN" --cwd "$CWD")
  [[ "${1:-}" != --require-attached ]] || verify_args+=(--require-attached)
  "$MOCK_MCP_HELPER" "${verify_args[@]}" -- "${ARGS[@]}" --wrk-pane-env "${TAB_ENV[@]}" ||
    return "$WRK_EXIT_MOCK_MCP_REFUSED"
}

mock_mcp_cleanup() {
  if [[ "${SPAWN_MOCK_MCP_RETAIN:-0}" != 1 && -n "${MOCK_MCP_PLAN:-}" ]]; then
    "$MOCK_MCP_HELPER" stop --plan "$MOCK_MCP_PLAN" >/dev/null 2>&1 || true
  fi
}

refuse_barred_model_id() {
  local model_id="${1:-}" profile="${2:-$MODEL}"
  case "$model_id" in
    # The bar is on the model, not the spelling: any resolved model id carrying
    # a -terra segment refuses, so a future alias or catalog row serving a new
    # terra id (e.g. gpt-9.9-terra) cannot slip past the gpt-5.6-terra literal.
    terra|*-terra|*-terra-*)
      die "profile $profile refused: $model_id is barred, operator 2026-10-12 noterra; use codex-sol or codex-luna" ;;
  esac
}

# Every channel a resolved model id can ride into the launcher argv must face
# the same bar: codex/kiro put it in PROFILE_MODEL, grok in PROFILE_MODEL_ARG,
# and apply_catalog can write it straight into ARGS as --model <id> (fable).
refuse_barred_launcher_model() {
  local i
  refuse_barred_model_id "$PROFILE_MODEL" "$MODEL"
  refuse_barred_model_id "$PROFILE_MODEL_ARG" "$MODEL"
  for ((i = 0; i < ${#ARGS[@]} - 1; i++)); do
    case "${ARGS[$i]}" in
      -m|--model) refuse_barred_model_id "${ARGS[$((i + 1))]}" "$MODEL" ;;
    esac
  done
}

refuse_known_terra_spelling() {
  local profile="${1:-$MODEL}"
  case "$profile" in
    codex-terra|codex-terra-max|codex-med|builder-terra-high|builder-terra-xhigh|builder-terra-max)
      # This early known-alias check also gives a named refusal when the caller
      # supplies a role those spellings cannot take. The resolved model-id check
      # below remains the policy boundary for every profile that reaches resolve_profile.
      refuse_barred_model_id gpt-5.6-terra "$profile" ;;
  esac
}

spawn_cmd() {
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { spawn_help; return 0; }
  CWD="" MODEL="" PROMPT="" WS="" LABEL="" LANE="" EFFORT="" JOB_ID="" JOB_T="" OWNER="" ROLE="worker" ROLE_EXPLICIT=0 BUILDER_LANE="" PARENT_LANE="" REPORT_PATH="" JOB_DUP_OK=0 LANDING_STRICT=0 LANDING_NO_DETAIL="" KEEP=0
  OPERATOR_REQUEST="" ROUND_EXT_REF="" REQUESTED_BY="" PURPOSE="" TASK_ID="" PARENT_JOB="" TAKEOVER_FROM="" TAKEOVER_ROUNDS_USED=0 TASK_HK_BYPASS=0 TASK_LINK_MODE="" TASK_INHERITED_FROM="" TASK_LINK_STATUS="" ARBITER_CLAIM_FAILED=0 LANE_DEFER=""
  ARBITER_HELD=0 ARBITER_RESOURCE="" ARBITER_PROFILE="" ARBITER_STARTED_AT="" GATE_OUTPUT="" GATE_READY=0 ARBITER_JOB_REGISTERED=0 HUB_QUOTA_GATE_WARNED=0
  TAB_CREATE_JSON="" TAB_ID=""
  MOCK_MCP_PLAN="" MOCK_MCP_HELPER="" SPAWN_MOCK_MCP_RETAIN=0
  # Armed once for the whole spawn: both cleanup actions are guarded (pane
  # only when SPAWN_PANE_OPEN/PANE are set, quota release only when
  # ARBITER_HELD=1), so a die anywhere after the pane opens cannot leak it —
  # including the no-lease path where the arbiter claim or record failed.
  trap 'spawn_pane_cleanup; arbiter_release_held; mock_mcp_cleanup' EXIT
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) spawn_help; return 0 ;;
      -c|-m|--profile|-p|-w|-l|-L|--effort|--job|--t|--owner|--role|--lane|--parent|--report|--operator-request|--round-ext|--requested-by|--purpose|--task|--parent-job|--takeover-from|--lane-defer)
        { [[ $# -ge 2 && -n "$2" ]] && ! wrk_option_token "$2"; } || die "$1 requires a value"
        case "$1" in
          -c) CWD="$2" ;; -m|--profile) MODEL="$2" ;; -p) PROMPT="$2" ;; -w) WS="$2" ;;
          -l) LABEL="$2" ;; -L) LANE="$2" ;; --effort) EFFORT="$2" ;;
          --job) JOB_ID="$2" ;; --t) JOB_T="$2" ;; --owner) OWNER="$2" ;;
          --role) ROLE="$2"; ROLE_EXPLICIT=1 ;; --lane) BUILDER_LANE="$2" ;; --parent) PARENT_LANE="$2" ;;
          --report) REPORT_PATH="$2" ;;
          --operator-request) OPERATOR_REQUEST="$2" ;; --requested-by) REQUESTED_BY="$2" ;;
          --round-ext) ROUND_EXT_REF="$2" ;;
          --purpose) PURPOSE="$2" ;; --task) TASK_ID="$2" ;; --parent-job) PARENT_JOB="$2" ;; --takeover-from) TAKEOVER_FROM="$2" ;;
          --lane-defer) LANE_DEFER="$2" ;;
        esac
        shift 2 ;;
      --task-hk-bypass) TASK_HK_BYPASS=1; shift ;;
      --job-dup-ok) JOB_DUP_OK=1; shift ;;
      --landing-strict) LANDING_STRICT=1; shift ;;
      --keep) KEEP=1; shift ;;
      -*) die "unknown option '$1'" ;;
      *) die "unexpected argument '$1'" ;;
    esac
  done
  # Refuse known Terra spellings as soon as arguments are parsed, before host
  # routing or any spawn preparation. The resolved-model check below covers
  # future aliases too.
  refuse_known_terra_spelling
  # #1155: several router paths reach spawn_cmd directly (an unclassified
  # spawn, an unreadable arbiter, a hosts.toml-less auto). The flag gate
  # repeats here so no local spawn path runs on a host whose own [local]
  # spawn = false — before any usage check, gate, claim or pane.
  local_spawn_resolve || return
  if [[ "${LOCAL_SPAWN_ALLOWED:-1}" -eq 0 ]]; then
    echo "wrk: local spawns are disabled on this host ([local] spawn = false); refusing spawn" >&2
    return "$WRK_EXIT_LOCAL_SPAWN_DISABLED"
  fi
  [[ -n "$CWD" ]] || die "-c CWD is required"
  [[ -n "$MODEL" ]] || die "-m MODEL is required"
  [[ -n "$PROMPT" ]] || die "-p PROMPT_FILE is required"
  [[ -n "$WS" ]] || die "-w WORKSPACE is required"
  [[ -n "$LABEL" ]] || die "-l LABEL is required"
  # ROB-1215 (herdr 0.8 bundled skill): agent names must match [a-z][a-z0-9_-]{0,31}
  # — lowercase, ≤32 chars, unique among live agents. herdr rejects violations late
  # and cryptically; retries then mutate the label (2026-08-03: legA-alpha-live vs
  # lega-alpha — one job forked into two ids over the uppercase 'A'). Fail early.
  ascii_re "$LABEL" '^[a-z][a-z0-9_-]{0,31}$' || die "invalid label '$(scrub_id "$LABEL")' — herdr agent names must match [a-z][a-z0-9_-]{0,31} (lowercase, ≤32 chars)"
  [[ -r "$PROMPT" ]] || die "prompt file is not readable: $PROMPT"

  [[ -n "$JOB_ID" ]] || JOB_ID="$LABEL"

  normalize_implicit_counsel_role
  case "$ROLE" in
    worker|builder|tester|reviewer|counsel) ;;
    captain)
      [[ "$MODEL" != codex-astra && "$MODEL" != fable ]] ||
        die "astra/fable captain role forbidden; use the explicit verified builder seat"
      warn "--role captain is deprecated; use --role builder"
      ROLE="builder"
      ;;
    *) die "--role accepts worker, builder, tester, reviewer or counsel (legacy alias: captain)" ;;
  esac
  round_ext_validate
  # #1397: --lane-defer exists solely for the delegated remote-builder path —
  # the initiator adds the lane it names. A worker handed the flag would
  # print a lane= it never registered, so it is refused outright; the value
  # is a hosts.toml host key (the target's hub machine id), so it answers to
  # the same charset as [hub] machine_id.
  if [[ -n "$LANE_DEFER" ]]; then
    [[ "$ROLE" == builder ]] || die "--lane-defer requires --role builder (it defers a builder lane's hub registration to the --host initiator)"
    ascii_re "$LANE_DEFER" '^[A-Za-z0-9._-]{1,64}$' || die "--lane-defer expects a machine id matching [A-Za-z0-9._-]{1,64}"
  fi
  case "$BUILDER_LANE" in
    director-*|admiral-*) die "--lane '$BUILDER_LANE' is reserved for director lanes; --role builder/worker cannot claim it" ;;
  esac
  if [[ "$ROLE" == builder ]]; then
    [[ -n "$BUILDER_LANE" ]] || die "--role builder requires --lane BUILDER_LANE (legacy alias: captain)"
    [[ -n "$PARENT_LANE" ]] || die "--role builder requires --parent PARENT_LANE (legacy alias: captain)"
    [[ -z "$OWNER" ]] || die "--role builder uses --lane; do not combine it with --owner"
    [[ "$BUILDER_LANE" != "$PARENT_LANE" ]] || die "--role builder forbids --lane and --parent being the same (self parent)"
    case "$MODEL" in
      builder-astra|captain-astra)
        die "--role builder rejects astra profile '$MODEL': astra is limited to director judgment, architect counsel and operator-requested advice (hk:doc decision/2026-09-21/astra-allowed-purposes-approved)" ;;
      codex-astra|fable) ;; # Paired round-extension flags verified before catalog.
      devin-fusion-opus55|devin-fusion-sonnet55)
        die "--role builder rejects '$MODEL': the devin fusion spellings are worker/tester-only — fusion builder use is decided after hk 1382 (hk 1380, operator decision 2026-10-10)" ;;
      devin-fusion-sol61|devin-fusion-sol61-xhigh)
        die "--role builder rejects '$MODEL': Fusion-Sol is worker/tester-only until the hk 1729 reps are reviewed" ;;
      devin-argon|devin-argon-medium|devin-argon-low)
        die "--role builder rejects '$MODEL': the devin Argon trial spellings are worker/tester-only — phase 1 is spawn plumbing, no builder seat (hk 1620, operator decision 2026-10-18)" ;;
      builder-opus|builder-sol|builder-sol6|builder-devin|builder-devin-medium|builder-devin-max|builder-ds41|builder-ds41-max|builder-grok|builder-kimi|builder-luna|builder-sonnet|builder-opus-low|builder-opus-medium|builder-sonnet-xhigh|builder-sonnet-max|builder-sol-high|builder-sol-max|builder-sol-medium|builder-luna-max|builder-kimi-high|builder-kimi-max|builder-grok-low|builder-grok-medium|builder-grok-xhigh|builder-sonnet-medium|builder-haiku-low|builder-luna-low|builder-luna-medium|builder-sol-low|builder-haiku-high|builder-haiku-xhigh|builder-haiku-max|builder-sonnet-low|devin-swe2|devin-swe2-medium|devin-swe2-max|grok|grok-hi|kimi-k3|captain-opus|captain-sol) ;;
      *) die "--role builder accepts only builder-opus, builder-sol, builder-sol6 (#1026 rollback), builder-devin, builder-devin-medium, builder-devin-max, builder-ds41, builder-ds41-max, builder-grok, builder-kimi, builder-luna, builder-sonnet or the E6 rungs builder-opus-low, builder-opus-medium, builder-sonnet-xhigh, builder-sonnet-max, builder-sol-high, builder-sol-max, builder-luna-max, builder-kimi-high, builder-kimi-max (#704), builder-grok-low, builder-grok-medium, builder-grok-xhigh, builder-sol-medium (#737), builder-sonnet-medium, builder-haiku-low, builder-luna-low, builder-luna-medium (#1796), builder-sol-low, builder-haiku-high, builder-haiku-xhigh, builder-haiku-max, builder-sonnet-low (hk 1863) (pilot worker spellings devin-swe2, devin-swe2-medium, devin-swe2-max, grok/grok-hi, kimi-k3 and legacy captain-* aliases accepted; codex-astra xhigh/fable only with verified --purpose round-extension --round-ext REF bound to explicit --task; builder-astra/captain-astra stay removed; Terra spellings refused by operator 2026-10-12 noterra; the worker codex-luna spellings and devin-glm52/devin-swe17/devin-ds41/devin-ds41-max are worker-only — the ds41 builder path is builder-ds41/builder-ds41-max; devin-fusion-opus55/devin-fusion-sonnet55 are worker/tester-only (fusion builder use is decided after hk 1382); devin-argon/devin-argon-medium/devin-argon-low are worker/tester-only (hk 1620 phase 1, no builder seat); the max-rung E6 spellings are admitted with their exact SCOPEFUEL_E6_ARM marker since hk 1863 removed the builder-seat no-max rule (operator decision hk 1864, 2026-10-23); ultra stays refused)" ;;
    esac
    case "$MODEL" in
      builder-opus|captain-opus)
        [[ -z "$EFFORT" || "$EFFORT" == high ]] || die "builder-opus (legacy captain-opus alias) requires effort high"
        ;;
      # #633: the catalog grades codex-luna per effort (medium=B, max=A+). The
      # E3 sample is defined at xhigh only — a lower or higher --effort would
      # move the rung the ceiling was rated at, so the guard reuses the
      # builder-opus pin and refuses rather than silently relaunch.
      builder-luna)
        [[ -z "$EFFORT" || "$EFFORT" == xhigh ]] || die "builder-luna requires effort xhigh (#594 E3 sample profile)"
        ;;
      # #921: the Sonnet 5.5 experiment seat takes a closed effort set —
      # high|xhigh|max (default xhigh). low/medium/ultra die here (max is no
      # longer special to this spelling since hk 1863).
      builder-sonnet)
        case "${EFFORT:-xhigh}" in
          high|xhigh|max) ;;
          *) die "builder-sonnet accepts only --effort high|xhigh|max (default xhigh; #921)" ;;
        esac
        ;;
      # #704: the E6 rungs pin their effort in the name's last segment.
      # resolve_profile repeats the check against GATE_EFFORT_PIN and enforces
      # the SCOPEFUEL_E6_ARM marker; refusing here too keeps the failure on the
      # same die path the other pinned builders use.
      builder-opus-low|builder-opus-medium|builder-sonnet-xhigh|builder-sonnet-max|builder-sol-high|builder-sol-max|builder-sol-medium|builder-luna-max|builder-terra-high|builder-terra-xhigh|builder-terra-max|builder-grok-low|builder-grok-medium|builder-grok-xhigh|builder-sonnet-medium|builder-haiku-low|builder-luna-low|builder-luna-medium|builder-sol-low|builder-haiku-high|builder-haiku-xhigh|builder-haiku-max|builder-sonnet-low)
        [[ -z "$EFFORT" || "$EFFORT" == "${MODEL##*-}" ]] || die "$MODEL is pinned to effort ${MODEL##*-} (#594 E6 rung)"
        ;;
    esac
  else
    [[ -z "$BUILDER_LANE" && -z "$PARENT_LANE" ]] || die "--lane/--parent require --role builder (legacy alias: captain)"
    case "$MODEL" in
      builder-opus|builder-sol|builder-sol6|builder-devin|builder-devin-medium|builder-devin-max|builder-ds41|builder-ds41-max|builder-grok|builder-kimi|builder-luna|builder-sonnet|builder-opus-low|builder-opus-medium|builder-sonnet-xhigh|builder-sonnet-max|builder-sol-high|builder-sol-max|builder-sol-medium|builder-luna-max|builder-kimi-high|builder-kimi-max|builder-grok-low|builder-grok-medium|builder-grok-xhigh|builder-sonnet-medium|builder-haiku-low|builder-luna-low|builder-luna-medium|builder-sol-low|builder-haiku-high|builder-haiku-xhigh|builder-haiku-max|builder-sonnet-low|captain-opus|captain-sol)
        die "builder profiles (legacy captain-* aliases accepted) require --role builder"
        ;;
    esac
  fi

  # #768: task binding is decided here, still before any side effect — a
  # missing/unresolvable task id is a usage error, never a partial spawn.
  task_validate
  if [[ -n "$TAKEOVER_FROM" ]]; then
    hk_task_takeover_precheck
  fi
  round_ext_precheck
  # Round-extension ownership cannot use the task availability bypass.
  if [[ -n "$ROUND_EXT_REF" ]]; then
    [[ "$TASK_HK_BYPASS" -eq 0 ]] || die "--round-ext forbids --task-hk-bypass"
    hk_task_precheck
  fi

  resolve_profile
  # Refuse by the resolved launcher model id, not by the spelling list. Keep
  # this before gate work, quota/arbiter admission, worktree or pane creation.
  refuse_barred_launcher_model
  configure_landing_check "$PROFILE_KIND"
  LANE_ENV=()
  if [[ -n "$LANE" ]]; then
    case "$LANE" in
      live|mock)
        if [[ -d "$CWD/$LANE" ]]; then CWD="$CWD/$LANE";
        else warn "-L $LANE: $CWD/$LANE absent; cwd unchanged"; fi ;;
      *) die "-L accepts only live or mock" ;;
    esac
    if [[ "$LANE" == mock ]]; then
      LANE_ENV+=(--env "MCP_PROFILE=${MOCK_MCP_PROFILE:-}")
    fi
  fi
  # ROB-1206: arbiter owner_lane is *who spawned this*, not the execution lane.
  # Conflating them made every record `default` (or `mock`), so an orch could not
  # query `arbiter status --lane <itself>` to find and reclaim its own workers.
  # -L live|mock stays the execution lane; --owner names the spawning session.
  JOB_LANE="${BUILDER_LANE:-${OWNER:-default}}"
  ARBITER_CLAIM_ROLE_ARGS=(--role "$ROLE")
  # Arbiter roles describe lease topology; these are all leaf seats.
  case "$ROLE" in tester|reviewer|counsel) ARBITER_CLAIM_ROLE_ARGS=(--role worker) ;; esac
  if [[ "$ROLE" == builder ]]; then
    ARBITER_CLAIM_ROLE_ARGS+=(--parent-lane "$PARENT_LANE")
  fi

  # ROB-1198 §③ / ROB-1199 claim contract: an unclassified job is not spawned.
  # There is no default T — a blank one would be recorded as fact by arbiter.
  # Checked before the quota gate, so nothing is measured, claimed or spawned.
  [[ -n "$JOB_T" ]] ||
    die "NEEDS_CLASSIFICATION: --t T0..T3 is required (job '$JOB_ID'); classify it, do not guess"
  case "$JOB_T" in T0|T1|T2|T3) ;; *) die "--t accepts only T0, T1, T2 or T3" ;; esac

  # #768: read-only hk task probe — fail closed before the quota gate measures
  # anything, before any pane, before any hk write. Sets TASK_LINK_STATUS.
  if [[ -n "$TAKEOVER_FROM" ]]; then
    hk_task_takeover_precheck
  else
    hk_task_precheck
  fi

  # #768: the job's own meta carries the task binding (job.claim/job.reclaim
  # payload); the override marker is recorded only when the flag was passed —
  # declared use is auditable even when the bypass turned out unnecessary.
  ARBITER_CLAIM_TASK_ARGS=(--task-id "$TASK_ID")
  if [[ "$TASK_HK_BYPASS" -eq 1 ]]; then
    if [[ "$TASK_LINK_STATUS" == bypassed:* ]]; then
      ARBITER_CLAIM_TASK_ARGS+=(--task-link-override "hk_unreachable")
    else
      ARBITER_CLAIM_TASK_ARGS+=(--task-link-override "declared")
    fi
  fi
  if [[ "$TASK_LINK_MODE" == inherited ]]; then
    ARBITER_CLAIM_TASK_ARGS+=(--task-inherited-from "$TASK_INHERITED_FROM")
  fi

  # Advisory only (never fails spawn). After -L may have rewritten CWD.
  warn_if_canonical_off_default "$CWD"

  quota_gate
  # The catalog's own refusal, held back so the quota gate could speak first.
  [[ "${CATALOG_REFUSED:-0}" -ne 1 ]] ||
    die "scopefuel policy launch refused profile '$MODEL' (catalog profile '$CATALOG_PROFILE'): ${CATALOG_REFUSE_REASON:-no reason reported}"
  # A takeover route refusal must precede the arbiter claim as well as pane
  # creation, so no failed rebind can leave partial local job records.
  hk_task_takeover_rebind
  arbiter_admit
  quota_hub_policy_gate
  [[ -x "$HERDR" ]] || die "herdr unavailable: $HERDR"

  if [[ "$PROFILE_KIND" == kimi ]]; then
    if ! CWD="$(cd -- "$CWD" 2>/dev/null && pwd -P)"; then
      die "cannot resolve Kimi CWD to an absolute path: $CWD"
    fi
    kimi_seed_workspace_trust "$CWD" "$KIMI_TRUST_HOME"
  fi

  # #912: devin enforces workspace trust on the TUI path (the
  # --respect-workspace-trust false argv covers --print only), so the resolved
  # spawn cwd must be in its store before pane run — fail closed otherwise.
  # Remote spawns re-enter this same function on the execution host, so the
  # store seeded is always the host devin actually runs on.
  if [[ "$PROFILE_KIND" == devin ]]; then
    devin_seed_workspace_trust "$CWD"
  fi

  # #951: unattended claude-kind spawns block on Claude Code's folder-trust
  # dialog for an unrecorded cwd — --dangerously-skip-permissions does not
  # bypass it. Record the accepted-trust flag in claude's own config ahead of
  # the pane; fail-open like the kimi seed. Remote spawns re-enter this same
  # function on the execution host, so the seeded config is the host claude
  # actually runs on.
  if [[ "$PROFILE_KIND" == claude ]]; then
    claude_seed_folder_trust "$CWD"
  fi

  # Codex uses $CODEX_HOME/config.toml when set (otherwise $HOME/.codex).
  # Remote spawns re-enter spawn_cmd on the execution host, so this writes the
  # config Codex will read on that host rather than the initiating machine.
  if [[ "$PROFILE_KIND" == codex ]]; then
    codex_seed_project_trust "$CWD"
  fi

  # #637: persist what the pane would otherwise lose on a herdr reboot restore
  # (bare `claude --resume <id>`): the prompt-suggestion-off env, in the worker
  # worktree's .claude/settings.local.json. The permission mode is not
  # persisted — local-file bypassPermissions cannot take effect (settings-ref)
  # and would force Manual on every flagless launch in the worktree. Runs after
  # every gate and before tab create, so a malformed or tracked existing file
  # fails the spawn closed with no pane left behind. Same resident carve-out
  # as the pane env: --purpose director is left as is.
  if [[ "$PROFILE_KIND" == claude && "${PURPOSE:-}" != director ]]; then
    write_claude_local_settings "$CWD" ||
      die "claude worker local settings not written for $CWD; spawn aborted before any pane (nothing was clobbered)"
    ensure_settings_local_ignored "$CWD"
  fi

  TAB_ENV=()
  if [[ "${#LANE_ENV[@]}" -gt 0 ]]; then TAB_ENV+=("${LANE_ENV[@]}"); fi
  if [[ "${#PROFILE_ENV[@]}" -gt 0 ]]; then TAB_ENV+=("${PROFILE_ENV[@]}"); fi
  if [[ "$ARBITER_HELD" -eq 1 ]]; then
    # The worker needs its own record identity to release or prove it later.
    TAB_ENV+=(--env "ARBITER_JOB=$JOB_ID" --env "ARBITER_RESOURCE=$ARBITER_RESOURCE"
              --env "ARBITER_KIND=quota_pool" --env "ARBITER_PROFILE=$ARBITER_PROFILE"
              --env "ARBITER_STARTED_AT=$ARBITER_STARTED_AT")
  fi
  # #768: the pane carries its task identity so a tester/advisory spawn made
  # from inside it inherits the task via HK_TASK_ID even without --parent-job.
  TAB_ENV+=(--env "HK_TASK_ID=$TASK_ID")
  # Final kind/cwd/host and generated TAB_ENV are authoritative here. No pane
  # exists and no brief has been injected if catalog/config verification fails.
  mock_mcp_prepare || return "$WRK_EXIT_MOCK_MCP_REFUSED"
  # hk 1672: admission can race a task reclaim or a new recorded parent.
  # Re-read server ownership and issuer at the last point before pane creation.
  round_ext_builder_recheck
  if [[ "${#TAB_ENV[@]}" -gt 0 ]]; then
    TAB_CREATE_JSON=$("$HERDR" tab create --workspace "$WS" --cwd "$CWD" --label "$LABEL" --no-focus "${TAB_ENV[@]}")
  else
    TAB_CREATE_JSON=$("$HERDR" tab create --workspace "$WS" --cwd "$CWD" --label "$LABEL" --no-focus)
  fi
  PANE=$(printf '%s' "$TAB_CREATE_JSON" |
    python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["root_pane"]["pane_id"])')
  # tab_id is what `wrk reap` later closes. It is recorded as evidence, never as
  # a requirement: an older herdr that omits it leaves reap to resolve the tab
  # from `agent get` instead.
  TAB_ID=$(printf '%s' "$TAB_CREATE_JSON" | python3 -c '
import json, sys
try:
    result = json.load(sys.stdin).get("result", {})
except (ValueError, AttributeError):
    raise SystemExit(0)
pane = result.get("root_pane") if isinstance(result.get("root_pane"), dict) else {}
tab = result.get("tab") if isinstance(result.get("tab"), dict) else {}
value = result.get("tab_id") or tab.get("tab_id") or pane.get("tab_id") or ""
print(value if isinstance(value, str) else "")
' 2>/dev/null || true)
  SPAWN_PANE_OPEN=1   # ROB-1214: disarmed only at the success line
  sleep_for 5
  START_TIMEOUT=30000; BOOT_SETTLE=12
  START_TIMEOUT_SOURCE="$PROFILE_KIND kind default"
  [[ "$PROFILE_KIND" == kiro ]] && START_TIMEOUT=120000 && BOOT_SETTLE=25
  [[ "$PROFILE_KIND" == kimi ]] && START_TIMEOUT=90000 && BOOT_SETTLE=20
  [[ "$PROFILE_KIND" == codex ]] && START_TIMEOUT=120000 && BOOT_SETTLE=20
  if [[ "$PROFILE_KIND" == kimi || "$PROFILE_KIND" == codex ]]; then
    START_TIMEOUT_SOURCE="$PROFILE_KIND kind default"
  fi
  if (( ${LOCAL_SHELL_READY_TIMEOUT_MS:-0} >= START_TIMEOUT )); then
    START_TIMEOUT="$LOCAL_SHELL_READY_TIMEOUT_MS"
    START_TIMEOUT_SOURCE="$LOCAL_SHELL_READY_TIMEOUT_SRC"
  fi

  mock_mcp_verify || return "$WRK_EXIT_MOCK_MCP_REFUSED"

  if [[ "$PROFILE_KIND" == devin ]]; then
    devin_start_in_pane
  else
    agent_start_in_pane
  fi
  sleep_for "$BOOT_SETTLE"
  # #609: no prompt reaches the pane until the agent itself is observed in the
  # foreground — an accepted start whose binary never ran (command not found)
  # must close the pane, not receive a brief at the shell.
  if ! agent_wait_foreground; then
    spawn_pane_cleanup
    return 1
  fi
  if [[ "$PROFILE_KIND" == kimi ]]; then
    VISIBLE_SCREEN=""
    VISIBLE_SCREEN="$($HERDR agent read "$PANE" --lines 40 --source visible 2>/dev/null || true)"
    if grep -Fq "Trust this folder?" <<<"$VISIBLE_SCREEN"; then
      warn "KIMI TRUST WARNING: workspace trust seeding may have been neutralized — format change suspected; 'Trust this folder?' remains visible. Spawn continues."
    fi
  fi
  if [[ "$PROFILE_KIND" == kiro ]]; then
    "$HERDR" agent prompt "$PANE" "/effort $EFFECTIVE_EFFORT" >/dev/null 2>&1
    sleep_for 2
  fi
  # #498: injection happens only here — after every gate above, tab create and
  # agent start (or Devin's temporary run/wait/rename branch). Nothing about it
  # may move ahead of quota_gate/arbiter_admit.
  mock_mcp_verify --require-attached || return "$WRK_EXIT_MOCK_MCP_REFUSED"
  round_ext_builder_recheck
  spawn_deliver_brief
  STATUS="unknown"
  if STATUS="$(agent_status_for_pane "$PANE")"; then :; else STATUS=unknown; fi
  # An older herdr may not report the tab in `tab create`; the agent knows it.
  if [[ -z "$TAB_ID" ]]; then
    IFS=$'\t' read -r _ _ TAB_ID <<<"$(herdr_agent_probe "$PANE")" || TAB_ID=""
  fi
  # #768: the hk task claim+link — the single hk write of the spawn, placed on
  # the success side only (pane landed, prompt delivered) so a failed spawn
  # never touches hk. A refusal here dies before the success receipt and while
  # SPAWN_PANE_OPEN is still armed: the EXIT trap closes the pane and releases
  # the quota record — no job without its task link.
  hk_task_link
  # #965/#1397: with the pane provably up and the spawn committed to its OK
  # line, register the lane on the daemon serving this herdr session —
  # worker label under --owner, builder --lane under --parent — before the
  # spawn receipt so hub_lane/hub_lane_machine land in the same job meta as
  # task_id/keep. Warn-only inside: never fails the spawn; the OK line turns
  # a builder's miss into lane=UNREGISTERED below.
  hub_lane_register
  # The spawn stands; the execution record now belongs to the worker, not to this process.
  arbiter_record_spawn_receipt
  # A sentinel requires the durable claim/spawn metadata it later reads. During
  # an installation transition the old fail-open spawn contract remains intact.
  if [[ "$ARBITER_JOB_REGISTERED" -eq 1 ]]; then
    OBSERVED_DEVIN_RUNG=""
    [[ "$PROFILE_KIND" != devin ]] || OBSERVED_DEVIN_RUNG="$MODEL"
    start_completion_sentinel "$(wrk_jobs_root)/$JOB_ID/completion-sentinel.pid" "$JOB_ID" "$JOB_LANE" "$LABEL" "$PANE" "$REPORT_PATH" "$ARBITER_RESOURCE" "$PROFILE_KIND" "$OBSERVED_DEVIN_RUNG" "$SCOPEFUEL"
  fi
  SPAWN_PANE_OPEN=0
  SPAWN_MOCK_MCP_RETAIN=1
  refresh_quota_pool
  # #770: optional periodic prune, off by default until director-1 enables it
  # (WRK_PRUNE_ON_SPAWN=1). Detached so the spawn path never waits on it; it
  # runs the same `wrk prune --apply` an operator would.
  if [[ "${WRK_PRUNE_ON_SPAWN:-0}" == 1 ]]; then
    ( nohup "$0" prune --apply >>"$(wrk_jobs_root)/prune.log" 2>&1 & ) || true
  fi
  ARBITER_HELD=0
  if [[ -n "$ARBITER_RESOURCE" ]]; then
    OK_LINE="OK pane=$PANE model=$MODEL label=$LABEL status=$STATUS landed=$LANDING job=$JOB_ID quota_record=$ARBITER_RESOURCE/quota_pool"
  else
    OK_LINE="OK pane=$PANE model=$MODEL label=$LABEL status=$STATUS landed=$LANDING"
  fi
  # Appended, never inserted: OK-line parsers read key=value pairs.
  [[ "$SPAWN_VIA" != herdr-fallback ]] || OK_LINE="$OK_LINE via=herdr-fallback"
  # #1397: a builder spawn always states its lane outcome — the registered
  # lane@machine, or the loud lane=UNREGISTERED marker when registration
  # warned and skipped. Workers keep the #965 contract: lane= appears only
  # on a confirmed registration.
  if [[ -n "${HUB_LANE:-}" ]]; then
    OK_LINE="$OK_LINE lane=$HUB_LANE@$HUB_LANE_MACHINE"
  elif [[ "$ROLE" == builder ]]; then
    OK_LINE="$OK_LINE lane=UNREGISTERED"
  fi
  # hk 1446: a deferred builder lane this host registered itself tells the
  # ssh initiator — through this one field on the OK pane= line — to skip
  # its own lanes add. Only the remote's own registration sets it, so a
  # deferred (unconfirmed) lane never carries the marker.
  [[ -z "${HUB_LANE_SELF:-}" ]] || OK_LINE="$OK_LINE lane_registered=self"
  echo "$OK_LINE"
  if [[ "$LANDING" == no ]]; then
    # Grok's echo can arrive 1-2 minutes after injection — past even its
    # extended window — so an unproven landing is not proof of non-delivery.
    [[ "$PROFILE_KIND" == grok ]] &&
      LANDING_NO_DETAIL="$LANDING_NO_DETAIL hint=\"re-check the pane after 2 minutes\""
    if [[ "$LANDING_STRICT" -eq 1 ]]; then
      warn "spawn succeeded but brief landed=no; pane=$PANE remains valid; $LANDING_NO_DETAIL strict_exit=$WRK_EXIT_LANDING_UNCONFIRMED"
      return "$WRK_EXIT_LANDING_UNCONFIRMED"
    fi
    warn "spawn succeeded but brief landed=no; pane=$PANE remains valid; $LANDING_NO_DETAIL"
  fi
  # #1397: WRK_LANE_STRICT=1 turns the builder's lane=UNREGISTERED marker into
  # a nonzero answer AFTER the pane is up and the OK line has printed — the
  # warn-only default stays because the pane exists and a failed spawn would
  # orphan it silently. On a remote --host leg the delegated wrk produces this
  # line (and this exit) on the target, so the marker propagates verbatim.
  if [[ "$ROLE" == builder && -z "${HUB_LANE:-}" && "${WRK_LANE_STRICT:-0}" == 1 ]]; then
    warn "spawn succeeded but the builder lane is UNREGISTERED; pane=$PANE remains valid; strict_exit=$WRK_EXIT_LANE_UNREGISTERED"
    return "$WRK_EXIT_LANE_UNREGISTERED"
  fi
}

reap_help() {
  cat <<'USAGE'
Usage: wrk reap [--lane LANE] [--job JOB[,JOB...]] [--grace DURATION] [--apply] [--include-builders|--include-captains]

Close the herdr tabs of jobs that already reported a terminal event, so that
finished worker/tester panes stop accumulating on the herdr server.

A job is a candidate only when all of these hold:
  · it has a terminal event (job.completed, job.joined or job.revoked)
  · no job.claim, job.reclaim, job.spawned or job.reprompted follows that
    terminal event (a job picked up again after it finished is live work;
    skip reason=reclaimed-after-terminal)
  · that terminal event is older than --grace (default 10m)
  · the pane of its newest job.spawned receipt still exists in herdr and its
    status is idle or done (pane and tab come from that one receipt as a unit;
    a malformed newest receipt is skipped, never patched from older ones)
  · the tab herdr reports for that pane is the recorded tab
    (skip reason=tab-mismatch otherwise)
  · herdr tab list, read again right before the close, confirms its tab holds
    exactly one pane. A failed or unparsable tab list, a tab missing from it,
    or a pane_count that is not an integer is treated as possibly shared
    (skip reason=tab-count-unknown)
  · it has not been reaped before (no job.reaped event)
  · it is not protected: no claim, reclaim or job.spawned receipt carries
    "keep": true (`wrk spawn --keep`; skip reason=protected)

working/blocked panes, jobs without a terminal event and jobs whose pane herdr
cannot resolve are never touched. Builder panes (claim role=builder, or legacy
role=captain) are excluded unless --include-builders is given.

Options:
  --lane LANE        only jobs whose claim owner_lane is LANE
  --job JOB          only jobs whose id exactly matches JOB; repeatable or comma-separated.
                     Unnamed jobs are omitted, including their skip lines.
  --grace DURATION   minimum age of the terminal event (10m, 600s, 2h, 600)
  --apply            actually close the tabs; without it reap only lists them.
                     Requires --lane: a lane-less --apply is refused (nonzero,
                     nothing closed). Reap one lane at a time.
  --include-builders also reap builder panes (canonical)
  --include-captains legacy alias for --include-builders
  -h, --help         show this usage

The default is a dry run: nothing is closed and no event is written. Each
closed job records a flat job.reaped event (pane_id, tab_id, at).

A job whose newest job.spawned receipt records a hub lane (hub_lane; spawned
under a session mapped in hosts.toml's [hub] session_machine_ids, #965) is
additionally deregistered on --apply: `panewire lanes rm LANE` with the [hub]
lane credentials resolved by the lane's role — the lane_role that receipt
records, not the job's claim role (#1438); a receipt without lane_role is a
worker lane — a worker lane uses
lanes_token_env when set, else hub_token_env (operator_token_env is never
read for it, the pre-#1397 contract); a builder lane inserts
operator_token_env between the two — once the tab close is confirmed — and only while
`panewire lanes ls` still shows the row bound to the recorded machine+pane (a reused label's newer row is
never removed). A removal failure warns and the close still stands;
`panewire lanes-audit` lists any leftover rows.
USAGE
}

# 10m / 600s / 2h / 600 → 초. 알 수 없는 형식은 실패한다(조용히 0 으로 떨어지면
# grace 없는 회수가 되어버린다).
parse_duration_s() {
  local value="$1"
  python3 - "$value" <<'PY'
import re, sys
text = sys.argv[1].strip()
match = re.fullmatch(r"(\d+)([smhd]?)", text)
if not match:
    raise SystemExit(1)
scale = {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[match.group(2)]
print(int(match.group(1)) * scale)
PY
}

# 회수 후보를 "job<TAB>owner<TAB>pane<TAB>tab<TAB>age_s<TAB>skip_reason" 로 출력한다
# (skip_reason 이 "-" 가 아니면 그 잡은 후보가 아니고 이유만 알린다). herdr 는
# 여기서 묻지 않는다 — 인박스만 읽는 순수 판정이다.
#
# 🔴 빈 필드는 자리표시자 "-" 로 낸다. 탭은 IFS 공백류라서 `IFS=$'\t' read` 가 연속
# 구분자를 하나로 접고, 그러면 뒤 필드가 앞으로 당겨진다. tab_id 없는 잡(이 PR 이전
# 스폰 전량)에서 age(초)가 tab_id 자리에 들어가 `herdr tab close <초>` 가 될 뻔했다
# (2026-09-05 검증 실증: `would-close … tab=1928`).
reap_candidates() {
  local root="$1" lane="$2" grace="$3" include_builders="$4"
  wrk_py - "$root" "$lane" "$grace" "$include_builders" <<'PY'
import json, os, sys, time
exec(os.environ["WRK_EVENTS_PY"])

root, lane, grace, include_builders = sys.argv[1:5]
grace = int(grace)
include_builders = include_builders == "1"
TERMINAL = {"job.completed", "job.joined", "job.revoked", "job.handed_off"}
# 종료 뒤에 이 중 하나가 오면 그 잡은 다시 살아난 것이다(완료 → 재클레임 → 작업 중
# 잠깐 idle). 상태 검사(idle|done)는 긴 턴 중 오표시가 실측돼 있어 마지막 방어선이
# 못 된다 — 판정은 인박스 순서로 한다. job.lost·job.recovered·quota_pool.* 는
# 되살림이 아니다 (넣으면 completed → lost 인 정상 종결 잡이 영구히 빠지고,
# 회복 한 건이 끝난 잡을 다시 연다). job.reprompted 는 아직
# 없는 종류지만(#113 ①) 생기면 같은 뜻이다.
# The order is the shared (event time, mtime, name) key: two writers number
# this directory independently, so the newest job.spawned must win by time —
# a respawned job whose spawned receipt has a lower prefix than its terminal
# is never a candidate (#1750).
REVIVE = {"job.claim", "job.reclaim", "job.spawned", "job.reprompted"}
NEUTRAL = {"job.lost", "job.recovered"}
if NEUTRAL & (TERMINAL | REVIVE):
    raise SystemExit("neutral event kind is also terminal or revive")
now = time.time()


try:
    jobs = sorted(os.listdir(root))
except OSError:
    raise SystemExit(0)

for job in jobs:
    events_dir = os.path.join(root, job, "events")
    if not os.path.isdir(events_dir):
        continue
    owner = pane = tab = role = ""
    spawned_pane = spawned_tab = spawned_hub_lane = spawned_hub_lane_machine = ""
    spawned_lane_role = ""
    saw_spawn = False
    terminal_at = None
    revived = False
    reaped = False
    keep = False
    for name, document, mtime in wrk_events_ordered(events_dir):
        if document is None:
            continue
        payload = document.get("payload", document)
        if not isinstance(payload, dict):
            payload = {}
        kind = document.get("kind")
        if kind in ("job.claim", "job.reclaim"):
            # 소유는 최신 claim 이 정한다(released 된 잡을 다른 레인이 다시 잡는다).
            owner = payload.get("owner_lane") if isinstance(payload.get("owner_lane"), str) else ""
            # 역할은 누적이다: `--role` 없는 reclaim 은 기본값 worker 를 payload 에
            # 남기므로, 덮어쓰면 재클레임 한 번에 빌더 표식이 지워진다. 디스크에
            # 남은 legacy captain claim도 동일한 builder 급 pane으로 보호한다.
            if payload.get("role") in ("builder", "captain"):
                role = "builder"
        for key in ("pane_id", "tab_id"):
            value = payload.get(key)
            if isinstance(value, str) and value:
                if key == "pane_id":
                    pane = value
                else:
                    tab = value
        if kind == "job.spawned":
            # 가장 늦은 스폰 영수증이 pane·tab 을 **한 벌로** 정한다. 필드별로 마지막
            # 값을 남기면 재스폰 영수증(tab_id 없음)의 pane 과 이전 스폰의 tab 이 섞여
            # 엉뚱한 탭을 닫는다(#508 tester 실증: pane=w1:p9 인데 tab close w1:t1).
            saw_spawn = True
            spawned_pane = payload.get("pane_id") if isinstance(payload.get("pane_id"), str) else ""
            spawned_tab = payload.get("tab_id") if isinstance(payload.get("tab_id"), str) else ""
            # #965: the hub lane travels in the same one receipt as pane/tab —
            # a lane an older spawn registered is not this pane's to remove.
            # #994: its machine too — `lanes rm` fires only while the daemon's
            # row still matches the recorded machine+pane pair.
            spawned_hub_lane = payload.get("hub_lane") if isinstance(payload.get("hub_lane"), str) else ""
            spawned_hub_lane_machine = payload.get("hub_lane_machine") if isinstance(payload.get("hub_lane_machine"), str) else ""
            # #1438: the role that registered that lane rides in the same
            # receipt, so the credential chain follows the lane's own spawn —
            # never the cumulative claim role (a job id first claimed as a
            # builder and reused by a worker spawn would otherwise remove the
            # worker lane with the operator credential). Only the exact
            # builder literal selects the builder chain; an absent (legacy
            # receipt) or unknown value is the narrower worker chain.
            spawned_lane_role = "builder" if payload.get("lane_role") == "builder" else "worker"
        if kind == "job.reaped":
            reaped = True
        # 보호 표시(`wrk spawn --keep`, #603)는 누적이다: claim·reclaim·spawn 영수증 중
        # 하나라도 JSON true 를 남겼으면 그 잡의 pane 은 닫지 않는다.
        if kind in ("job.claim", "job.reclaim", "job.spawned") and payload.get("keep") is True:
            keep = True
        if kind in REVIVE and terminal_at is not None:
            terminal_at = None
            revived = True
        if kind in TERMINAL:
            revived = False
            terminal_at = wrk_event_time(document, mtime if mtime else now)
    # 스폰 영수증이 pane/tab 의 정본이다. 완료 이벤트의 pane_id 를 그대로 믿으면
    # be4dad1 이전 `wrk done` 이 남긴 오염 레코드("w1:p1\t\tworker")를 집는다 —
    # 실 인박스에 23건 남아 있다.
    # 영수증이 하나라도 있으면 가장 늦은 영수증만 믿는다 — 그 영수증이 깨졌으면 앞선
    # 영수증이나 완료 이벤트의 값으로 되돌아가지 않고 malformed 로 건너뛴다.
    malformed_receipt = False
    if saw_spawn:
        pane, tab = spawned_pane, spawned_tab
        malformed_receipt = not pane
    if reaped or (not pane and not malformed_receipt):
        continue
    if lane and owner != lane:
        continue
    if role == "builder" and not include_builders:
        continue
    if terminal_at is None:
        # 종료 뒤에 되살아난 잡은 이유를 남기고 건너뛴다. 종료가 아예 없던 잡은
        # 지금처럼 출력하지 않는다.
        if revived and not any(c.isspace() for c in job):
            print(job, "-", "-", "-", "-", "reclaimed-after-terminal", sep="\t")
        continue
    age = int(now - terminal_at)
    if age < grace:
        continue
    # 보호된 잡은 유예를 넘겨 원래라면 닫혔을 때만 이유를 남기고 건너뛴다. 유예 안이거나
    # 종료 전인 잡은 위에서 지금처럼 조용히 빠진다.
    if keep:
        print(job.split()[0] if job.split() else job, "-", "-", "-", age, "protected", sep="\t")
        continue
    # 어떤 필드에도 공백이 있어서는 안 된다. 있으면 그 잡의 증거가 깨진 것이고,
    # 회수는 추측하지 않는다 — pane 을 자리표시자로 내보내 skip 으로 남긴다.
    if malformed_receipt or any(any(c.isspace() for c in value) for value in (job, owner, pane, tab)):
        print(job.split()[0] if job.split() else job, "-", "-", "-", age, "-", sep="\t")
        continue
    # #965: a lane id carrying whitespace is corrupt evidence — never an rm
    # target. The pane itself still closes; the row is left for lanes-audit.
    # Same for its recorded machine (#994): a blanked machine can never match
    # a live row, so the removal is skipped rather than aimed.
    if any(c.isspace() for c in spawned_hub_lane):
        spawned_hub_lane = ""
    if any(c.isspace() for c in spawned_hub_lane_machine):
        spawned_hub_lane_machine = ""
    # #1397: the lane's role travels too — hub_lane_remove resolves the lane's
    # credential chain per role (a worker lane never reads operator_token_env;
    # a builder lane may). #1438: that role is the newest spawn receipt's
    # lane_role, not the cumulative claim role above (which only filters
    # --include-builders). Lane and role come from the one receipt that owns
    # the live lane; with no lane the field is unused and prints "-".
    print(job, owner or "-", pane, tab or "-", age, "-", spawned_hub_lane or "-", spawned_hub_lane_machine or "-", spawned_lane_role if spawned_hub_lane else "-", sep="\t")
PY
}

# Keep the selector at the output/close boundary: this suppresses every row for
# unnamed jobs, including candidates with skip reasons, and protects --apply.
reap_job_selected() {
  local filter="$1" job="$2" candidate
  local -a selected=()
  [[ -n "$filter" ]] || return 0
  IFS=',' read -r -a selected <<<"$filter"
  for candidate in "${selected[@]}"; do
    [[ "$candidate" == "$job" ]] && return 0
  done
  return 1
}

# "tab_id<TAB>pane_count" 목록. 회수는 잡의 탭만 닫아야 하고, pane 이 분할된 탭을
# 닫으면 옆 pane 이 함께 죽는다(2026-07-20 실사고: 수동 스폰한 캡틴 pane 동반 사망).
#
# 🔴 fail-closed 다. 조회 실패·JSON 파손이면 아무 줄도 내지 않고(→ 모든 탭이
# "모름"), pane_count 가 정수가 아니면(부재·문자열·bool) "?" 를 낸다. 예전에는 둘 다
# "공유 아님" 으로 통과해 조회가 실패하는 날 조용히 닫았다. 판정은 reap_tab_verdict.
reap_tab_pane_counts() {
  local out
  out="$("$HERDR" tab list 2>/dev/null)" || return 0
  python3 -c '
import json, sys
try:
    tabs = json.loads(sys.argv[1])["result"]["tabs"]
except (ValueError, KeyError, TypeError):
    raise SystemExit(0)
if not isinstance(tabs, list):
    raise SystemExit(0)
for tab in tabs:
    if isinstance(tab, dict) and isinstance(tab.get("tab_id"), str):
        count = tab.get("pane_count")
        ok = isinstance(count, int) and not isinstance(count, bool)
        print(tab["tab_id"], count if ok else "?", sep="\t")
' "$out" 2>/dev/null || true
}

# 탭 하나의 판정: single(정확히 pane 1개로 확인됨) / shared:N / unknown.
# 닫아도 되는 것은 single 뿐이다 — 목록에 없거나, 같은 tab_id 가 두 번 나오거나,
# 값이 1 이상의 정수가 아니면 unknown 이다.
reap_tab_verdict() {
  local tab="$1" counts="$2" rows
  rows="$(awk -v want="$tab" -F'\t' '$1==want{print $2}' <<<"$counts")"
  if [[ -z "$rows" || "$rows" == *$'\n'* || ! "$rows" =~ ^[0-9]+$ ]]; then
    echo unknown
  elif [[ "$rows" == 1 ]]; then
    echo single
  elif (( 10#$rows > 1 )); then
    echo "shared:$((10#$rows))"
  else
    echo unknown
  fi
}

reap_event() {
  local job="$1" owner="$2" pane="$3" tab="$4"
  local events
  events="$(wrk_jobs_root)/$job/events"
  mkdir -p "$events"
  wrk_py - "$events" "$job" "$owner" "$pane" "$tab" "${HOSTNAME:-unknown}" <<'PY'
import json, os, sys, tempfile
exec(os.environ["WRK_EVENTS_PY"])
events, job, owner, pane, tab, host = sys.argv[1:]
lock = wrk_events_locked(events)
record = {"kind": "job.reaped", "job_id": job, "owner_lane": owner,
          "pane_id": pane, "tab_id": tab, "host": host, "epoch": 1}
wrk_event_commit(events, "job.reaped", record)
PY
}

reap_cmd() {
  local lane="" grace="10m" apply=0 include_builders=0 job_filter="" job_value
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) reap_help; return 0 ;;
      --lane) [[ $# -ge 2 && -n "$2" ]] || die "--lane requires a value"; lane="$2"; shift 2 ;;
      --job)
        [[ $# -ge 2 && -n "$2" ]] || die "--job requires a non-empty value"
        job_value="$2"
        [[ ",$job_value," != *",,"* ]] || die "--job contains an empty job id"
        if [[ -n "$job_filter" ]]; then job_filter+=","; fi
        job_filter+="$job_value"
        shift 2 ;;
      --grace) [[ $# -ge 2 && -n "$2" ]] || die "--grace requires a value"; grace="$2"; shift 2 ;;
      --apply) apply=1; shift ;;
      --include-builders|--include-captains) include_builders=1; shift ;;
      -*) die "unknown reap option '$1'" ;;
      *) die "unexpected argument '$1'" ;;
    esac
  done
  # 전역 --apply 는 거부한다(#113 ④). 인박스·herdr 를 보기 전에, 즉 아무것도 닫기
  # 전에 끝낸다 — 루프 안에서 검사하면 부분 회수가 난다.
  if [[ "$apply" -eq 1 && -z "$lane" ]]; then
    die "reap --apply requires --lane LANE (a lane-less --apply would close every lane's tabs); run it once per lane"
  fi
  local grace_s jobs_root candidates
  grace_s="$(parse_duration_s "$grace")" || die "invalid --grace '$grace' (use 600, 600s, 10m, 2h or 1d)"
  jobs_root="$(wrk_jobs_root)"
  if [[ ! -d "$jobs_root" ]]; then
    echo "reap: no job inbox at $jobs_root"
    return 0
  fi
  [[ -x "$HERDR" ]] || die "herdr unavailable: $HERDR"
  candidates="$(reap_candidates "$jobs_root" "$lane" "$grace_s" "$include_builders")"
  local tab_counts
  local job owner pane tab age note hub_lane hub_lane_machine lane_role probe class token probe_tab verdict acted=0 release_rc=0
  local -a selected_jobs=()
  if [[ -n "$job_filter" && "$apply" -eq 1 ]]; then
    local selected_job selected_seen
    IFS=',' read -r -a selected_jobs <<<"$job_filter"
    for selected_job in "${selected_jobs[@]}"; do
      selected_seen=0
      while IFS=$'\t' read -r job _; do
        [[ "$job" == "$selected_job" ]] && selected_seen=1
      done <<<"$candidates"
      [[ "$selected_seen" -eq 1 ]] || echo "skip job=$selected_job reason=not-candidate"
    done
  fi
  while IFS=$'\t' read -r job owner pane tab age note hub_lane hub_lane_machine lane_role; do
    [[ -n "$job" ]] || continue
    if [[ "$apply" -eq 1 ]]; then
      if ! reap_job_selected "$job_filter" "$job"; then continue; fi # hk1823-apply-job-filter
    else
      if ! reap_job_selected "$job_filter" "$job"; then continue; fi
    fi
    if [[ -n "$note" && "$note" != - ]]; then
      echo "skip job=$job reason=$note"
      continue
    fi
    # 자리표시자를 되돌린다(위 reap_candidates 주석 참고).
    [[ "$owner" != - ]] || owner=""
    [[ "$tab" != - ]] || tab=""
    [[ "$hub_lane" != - ]] || hub_lane=""
    [[ "$hub_lane_machine" != - ]] || hub_lane_machine=""
    [[ "$lane_role" != - ]] || lane_role=""
    if [[ "$pane" == - ]]; then
      echo "skip job=$job reason=malformed-record"
      continue
    fi
    probe="$(herdr_agent_probe "$pane")"
    IFS=$'\t' read -r class token probe_tab <<<"$probe"
    if [[ "$class" != ok ]]; then
      # An unresolvable pane is not a reapable pane: it may be a paused socket
      # rather than a closed tab, and closing a tab id nobody confirmed is worse
      # than leaving it. `wrk reap` never guesses.
      echo "skip job=$job pane=$pane reason=pane-unresolved($token)"
      continue
    fi
    case "$token" in
      idle|done) ;;
      *)
        if [[ -n "$job_filter" && "$apply" -eq 1 ]]; then
          echo "skip job=$job reason=not-candidate"
        else
          echo "skip job=$job pane=$pane reason=status=$token"
        fi
        continue ;;
    esac
    [[ -n "$tab" ]] || tab="$probe_tab"
    if [[ -z "$tab" ]]; then
      echo "skip job=$job pane=$pane reason=tab-unresolved"
      continue
    fi
    # 기록된 탭과 herdr 가 지금 말하는 pane 의 탭이 다르면(pane 이동·tab id 재사용)
    # 기록된 탭은 이 pane 의 탭이 아니다. 어느 쪽도 닫지 않는다.
    if [[ -n "$probe_tab" && "$probe_tab" != "$tab" ]]; then
      echo "skip job=$job pane=$pane tab=$tab reason=tab-mismatch(pane-in=$probe_tab)"
      continue
    fi
    # 탭 목록은 후보마다, pane 상태를 본 **뒤** close 직전에 새로 읽는다. 루프 앞에서
    # 한 번 찍은 스냅숏은 그 사이 합류한 pane 을 못 본다(#508 tester 실증: snapshot=1
    # → 합류 → tab close). herdr 에 조건부 close 가 없어 창을 0 으로 만들지는 못한다.
    tab_counts="$(reap_tab_pane_counts)"
    verdict="$(reap_tab_verdict "$tab" "$tab_counts")"
    case "$verdict" in
      single) ;;
      shared:*)
        echo "skip job=$job pane=$pane tab=$tab reason=tab-shared(panes=${verdict#shared:})"
        continue ;;
      *)
        echo "skip job=$job pane=$pane tab=$tab reason=tab-count-unknown"
        continue ;;
    esac
    if [[ "$apply" -eq 1 ]]; then
      # hk1798: release the job's remaining quota_pool records before the tab
      # close — the job already carries a work-terminal, so the records are
      # owed whether or not the close below lands.
      release_rc=0
      release_job_quota_pool "$job" "$pane" || release_rc=$? # hk1798-reap-preclose-release
      if [[ "$release_rc" == 2 ]]; then
        # The candidate was revived after reap_candidates took its snapshot.
        # No tab close or follow-up end action belongs to that prior round.
        continue # hk1813-reap-release-time-check
      fi
      if "$HERDR" tab close "$tab" >/dev/null 2>&1; then
        reap_event "$job" "$owner" "$pane" "$tab"
        # #770: a reaped job is ended — declare it to the hub (job.reaped is a
        # work terminal but not one the hub ends on), release quota, and stop
        # + wait on the completion sentinel before moving on.
        job_end_housekeeping "$job" "$owner" abandoned "pane reaped" "wrk reap" "$pane"
        # #965: the lane this pane's spawn registered goes with it — only the
        # recorded lane, only on a confirmed close, and (#994) only while the
        # daemon still shows that row bound to the recorded machine+pane.
        # Failure warns; the pane stays closed and lanes-audit lists what is
        # left behind.
        [[ -z "$hub_lane" ]] || hub_lane_remove "$hub_lane" "$hub_lane_machine" "$pane" "${lane_role:-worker}"
        echo "closed job=$job pane=$pane tab=$tab status=$token age=${age}s"
        acted=$(( acted + 1 ))
      else
        echo "skip job=$job pane=$pane tab=$tab reason=tab-close-failed"
      fi
    else
      echo "would-close job=$job pane=$pane tab=$tab status=$token age=${age}s"
      acted=$(( acted + 1 ))
    fi
  done <<<"$candidates"
  if [[ "$apply" -eq 1 ]]; then
    echo "reap: closed $acted tab(s)"
  else
    echo "reap: $acted candidate(s) (dry-run; re-run with --apply to close)"
  fi
}

lanes_missing_help() {
  cat <<'USAGE'
Usage: wrk lanes-missing

Read-only audit (#1397): list OPEN jobs under the jobs root whose owner
(builder) lane — or that lane's parent — is absent from `panewire lanes ls`.
A job's owner lane is where its job.* events route, and a builder's
job.escalate/job.joined route to that lane's parent, so a missing row is
exactly how completions get lost. "Open" means a claim or spawn exists and
no terminal event (job.completed/job.joined/job.revoked) or job.reaped
follows it — the same terminal/revive reading `wrk reap` uses.

The command makes exactly one `panewire lanes ls` call with the [hub] lane
credentials (lanes_token_env, else operator_token_env, else hub_token_env;
hub_cf_env when set) and otherwise only reads the jobs inbox — nothing is
added, removed or closed. It exits nonzero when the listing itself is
unavailable (hub config missing, panewire failing or unparsable output) —
an audit that cannot see the lanes file cannot say nothing is missing.

Output: one `missing job=JOB lane=LANE [parent=P] absent=lane|parent role=R`
line per finding, then a `lanes-missing: audited N open job(s), M missing`
summary. rc 0 whether or not findings exist.

  -h, --help   show this usage
USAGE
}

lanes_missing_cmd() {
  if [[ $# -gt 0 ]]; then
    if [[ "$1" == "-h" || "$1" == "--help" ]]; then
      [[ $# -eq 1 ]] || die "unexpected argument '$2'"
      lanes_missing_help
      return 0
    fi
    die "unexpected argument '$1'"
  fi
  local jobs_root hub_url token_env cf_env panewire listing rc=0
  local args=()
  jobs_root="$(wrk_jobs_root)"
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  # The audit reads lanes of every role, so it resolves the full builder
  # chain — a read-only `lanes ls`, never a worker's registration contract.
  token_env="$(hub_lanes_credential builder 2>/dev/null || true)"
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  if [[ -z "$hub_url" || -z "$token_env" ]]; then
    die "lanes-missing cannot audit: [hub] needs hub_url plus a lanes credential (lanes_token_env, else operator_token_env, else hub_token_env)"
  fi
  panewire="${PANEWIRE_BIN:-panewire}"
  if [[ "$panewire" == */* ]]; then
    [[ -x "$panewire" ]] || die "lanes-missing cannot audit: panewire unavailable: $panewire"
  elif ! command -v "$panewire" >/dev/null 2>&1; then
    die "lanes-missing cannot audit: panewire unavailable"
  fi
  args=(lanes ls --hub-url "$hub_url" --hub-token-env "$token_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  set +e
  listing="$("$panewire" "${args[@]}" 2>/dev/null)"
  rc=$?
  set -e
  [[ "$rc" -eq 0 ]] || die "lanes-missing cannot audit: panewire lanes ls exited $rc"
  # Open-job reading mirrors reap_candidates: a claim/reclaim records
  # owner_lane/parent_lane/role, terminal kinds close the job, claim/
  # reclaim/spawned/reprompted reopen it, job.reaped closes it for good.
  # job.lost and job.recovered are neutral: they neither close nor reopen.
  # Findings print as key=value lines; the summary is the last line.
  wrk_py - "$jobs_root" "$listing" <<'PY'
import json, os, sys
exec(os.environ["WRK_EVENTS_PY"])

root, raw = sys.argv[1], sys.argv[2]
try:
    doc = json.loads(raw)
except ValueError:
    print("wrk: lanes-missing cannot audit: panewire lanes ls output was not parseable", file=sys.stderr)
    sys.exit(2)
rows = doc.get("lanes") if isinstance(doc, dict) else None
if not isinstance(rows, list):
    print("wrk: lanes-missing cannot audit: panewire lanes ls output was not parseable", file=sys.stderr)
    sys.exit(2)
lanes = {}
for row in rows:
    if isinstance(row, dict) and isinstance(row.get("lane"), str):
        parent = row.get("parent")
        lanes[row["lane"]] = parent if isinstance(parent, str) else ""

TERMINAL = {"job.completed", "job.joined", "job.revoked", "job.handed_off"}
REVIVE = {"job.claim", "job.reclaim", "job.spawned", "job.reprompted"}
NEUTRAL = {"job.lost", "job.recovered"}
if NEUTRAL & (TERMINAL | REVIVE):
    raise SystemExit("neutral event kind is also terminal or revive")
try:
    jobs = sorted(os.listdir(root))
except OSError:
    jobs = []

open_jobs = []
for job in jobs:
    events_dir = os.path.join(root, job, "events")
    if not os.path.isdir(events_dir):
        continue
    owner = parent = role = ""
    is_open = False
    # Same event-time order as reap_candidates: terminal/revive are decided by
    # the shared key, never by which writer numbered the file.
    for name, record, _ in wrk_events_ordered(events_dir):
        if record is None:
            continue
        payload = record.get("payload", record)
        if not isinstance(payload, dict):
            payload = {}
        kind = record.get("kind")
        if kind in ("job.claim", "job.reclaim"):
            value = payload.get("owner_lane")
            owner = value if isinstance(value, str) else ""
            value = payload.get("parent_lane")
            parent = value if isinstance(value, str) else ""
            value = payload.get("role")
            role = value if isinstance(value, str) else ""
        if kind in REVIVE:
            is_open = True
        elif kind in TERMINAL or kind == "job.reaped":
            is_open = False
    if is_open and owner:
        open_jobs.append((job, owner, parent, role))

missing = 0
for job, owner, parent, role in open_jobs:
    tag = role or "-"
    if owner not in lanes:
        print("missing job=%s lane=%s absent=lane role=%s" % (job, owner, tag))
        missing += 1
        continue
    effective_parent = parent or lanes.get(owner, "")
    if effective_parent and effective_parent not in lanes:
        print("missing job=%s lane=%s parent=%s absent=parent role=%s"
              % (job, owner, effective_parent, tag))
        missing += 1
print("lanes-missing: audited %d open job(s), %d missing" % (len(open_jobs), missing))
PY
}

# ── #770: wrk prune — report-only-by-default cleanup of what ended jobs
# leave behind: orphan completion sentinels, stale jobs and detached
# quota-refresh supervisors.
#
# The hard rule mirrors wrk reap: nothing is stopped on ambiguous evidence.
# A pid is only ever signalled when its argv is verified to be this job's
# `wrk sentinel JOB …` (pid reuse guard), and a live sentinel is only ever
# stopped when the job's own records prove it ended or its pane is provably
# gone — never on "looks old".

# job_has_live_completion_sentinel JOB — true only when the pidfile proves a
# live sentinel with its recorded start, or the exact process sweep finds one.
job_has_live_completion_sentinel() {
  local job="$1" pidfile pid started
  pidfile="$(wrk_jobs_root)/$job/completion-sentinel.pid"
  if [[ -s "$pidfile" ]]; then
    IFS=$'\t' read -r pid started <<<"$(sentinel_pidfile_fields "$pidfile")"
    if [[ "$pid" =~ ^[0-9]+$ ]] && sentinel_pid_matches "$pid" "$job" &&
       sentinel_start_matches "$pid" "$started"; then
      return 0
    fi
  fi
  sentinel_sweep | awk -F '\t' -v j="$job" '$2==j {found=1} END {exit(found ? 0 : 1)}'
}

# proc_elapsed_s PID — process age in seconds from ps etime (macOS has no
# etimes); empty output or an unparseable field fails the call.
proc_elapsed_s() {
  local pid="$1" etime
  etime="$(ps -p "$pid" -o etime= 2>/dev/null | tr -d ' ')" || return 1
  [[ -n "$etime" ]] || return 1
  python3 - "$etime" <<'PY'
import re, sys
match = re.fullmatch(r"(?:(\d+)-)?(?:(\d+):)?(\d+):(\d+)", sys.argv[1])
if not match:
    raise SystemExit(1)
days, hours, minutes, seconds = (int(g) if g else 0 for g in match.groups())
print(days * 86400 + hours * 3600 + minutes * 60 + seconds)
PY
}

# refresh_supervisor_argv_matches PID PIDFILE — the refresh supervisor's real
# argv is `python3 - <scopefuel> <pool> <timeout> THIS-PIDFILE <job>`: the
# pidfile path it babysits sits at argv[5]. A bare `python` substring match is
# not identity — a plain `python3 -c 'sleep forever'` never carries this job's
# pidfile path there, and that is the difference between pruning a leftover
# and killing an unrelated process whose pid was recycled.
refresh_supervisor_argv_matches() {
  local pid="$1" pidfile="$2" args
  args="$(ps -p "$pid" -o args= 2>/dev/null)" || return 1
  [[ -n "$args" ]] || return 1
  python3 - "$args" "$pidfile" <<'PY'
import shlex, sys
args, pidfile = sys.argv[1], sys.argv[2]
try:
    toks = shlex.split(args)
except ValueError:
    toks = args.split()
ok = (len(toks) >= 6 and "python" in toks[0].rsplit("/", 1)[-1].lower()
      and toks[1] == "-" and toks[5] == pidfile)
sys.exit(0 if ok else 1)
PY
}

prune_help() {
  cat <<'USAGE'
Usage: wrk prune [--apply] [--stale-age AGE] [--job JOB] [--lane LANE]

Report — and with --apply, remove — what ended or stale jobs leave behind:
  * orphan completion sentinels (pidfile or a live `wrk sentinel JOB`
    process whose job ended, or whose pane is provably gone)
  * quota_pool rows for already-ended jobs with no live sentinel (dry-run
    reports would-release; --apply releases the arbiter's current rows)
  * stale jobs (events silent past --stale-age AND pane absent; records are
    never deleted — --apply appends a job.revoked end declaration so the
    hub stops counting them)
  * quota-refresh supervisor leftovers (quota-refresh.pid pointing at a
    dead/reused pid, or a live supervisor past its recorded deadline or
    whose job already ended)

Dry-run is the default and prints one line per item with job id, pid, age,
pane state and the exact reason it is or is not an orphan. --apply stops
only verified orphans: a sentinel whose job is still active (pane alive, or
job not ended, or pane state unverifiable) is never stopped, and a stale
pidfile pointing at an unrelated process only loses the file, never the
process.

Options:
  --apply          actually stop orphans / mark stale jobs / reap leftovers
  --stale-age AGE  stale threshold, e.g. 86400, 12h, 1d (default 24h)
  --job JOB        restrict every pass to one job id
  --lane LANE      restrict every pass to jobs owned by LANE
  -h, --help       show this usage

Periodic hook: WRK_PRUNE_ON_SPAWN=1 runs this same --apply pass detached at
the end of every `wrk spawn`. Off by default; enable only after director-1
approves. Output appends to <jobs-root>/prune.log.
USAGE
}

# prune_sentinel_row JOB PID PIDFILE ARGV_PANE ARGV_OWNER STARTED — classify
# one completion sentinel (pidfile-sourced or process-sweep-sourced) and print
# exactly one verdict line. STARTED is the pidfile's recorded spawn time;
# sweep rows pass "" (argv alone proves those). Uses PRUNE_APPLY, PRUNE_LANE
# and the precomputed PRUNE_SCAN table; bumps PRUNE_ORPHANS on verified
# orphans.
prune_sentinel_row() {
  local job="$1" pid="$2" pidfile="$3" argv_pane="${4:-}" argv_owner="${5:-}" started="${6:-}"
  local row ended="" terminal="" owner="" j_pane=""
  [[ -z "$PRUNE_LANE" ]] || {
    owner="$(awk -v j="$job" -F'\t' '$1==j {print $8; exit}' <<<"$PRUNE_SCAN")"
    [[ "${owner:--}" == "$PRUNE_LANE" || "$argv_owner" == "$PRUNE_LANE" ]] || return 0
  }
  row="$(awk -v j="$job" -F'\t' '$1==j {print; exit}' <<<"$PRUNE_SCAN")"
  if [[ -n "$row" ]]; then
    IFS=$'\t' read -r _ ended _ terminal _ _ _ owner _ j_pane _ <<<"$row"
  fi
  local live=0 pidkind="absent" age="-" release_rc=0
  if [[ "$pid" =~ ^[0-9]+$ ]]; then
    if sentinel_pid_matches "$pid" "$job" && sentinel_start_matches "$pid" "$started"; then
      live=1; pidkind="live"; age="$(proc_elapsed_s "$pid" 2>/dev/null || echo '?')"
    elif kill -0 "$pid" 2>/dev/null; then
      pidkind="reused"
      # argv proved this pid is our sentinel but the recorded start disagrees
      # with its real age — the pidfile was stale, not the process.
      if sentinel_pid_matches "$pid" "$job"; then
        pidkind="start-mismatch"
      fi
    else
      pidkind="dead"
    fi
  else
    pidkind="invalid"
  fi
  if [[ "$live" -eq 0 ]]; then
    # No live sentinel — only a pidfile can be stale here.
    [[ "$pidfile" != - ]] || return 0
    echo "sentinel job=$job pid=${pid:-?} pidfile=$pidfile stale=yes reason=pid-$pidkind"
    if [[ "$PRUNE_APPLY" -eq 1 ]]; then
      rm -f "$pidfile" && echo "  action=removed-pidfile"
    fi
    return 0
  fi
  if [[ ! -d "$PRUNE_ROOT/$job" ]]; then
    # Outside the jobs root there is no event stream to prove anything with —
    # list it, never touch it.
    echo "sentinel job=$job pid=$pid age=${age}s state=protected reason=outside-jobs-root"
    return 0
  fi
  if [[ "$ended" == 1 ]]; then
    PRUNE_ORPHANS=$(( PRUNE_ORPHANS + 1 ))
    echo "sentinel job=$job pid=$pid age=${age}s orphan=yes reason=job-ended($terminal)"
    if [[ "$PRUNE_APPLY" -eq 1 ]]; then
      # hk1798: the job already ended — hand back any quota record its own
      # end path leaked (idempotent: a clean job has no rows to release).
      release_job_quota_pool "$job" "$j_pane" || release_rc=$? # hk1798-prune-orphan-release
      [[ "$release_rc" != 2 ]] || return 0 # hk1813-prune-orphan-release-current
      stop_completion_sentinel "$job" "$pid" && echo "  action=stopped"
    fi
    return 0
  fi
  # The pane this sentinel watches is evidence in its own argv; the scan's
  # j_pane is the job's NEWEST spawn, which a terminal-less revive moves past
  # a stale watcher. Probe the watched pane, not the job's.
  local pane="${argv_pane:-}"
  # A space inside the owner lane shifts the space-joined argv columns; a
  # non-pane token is never evidence — drop it and re-derive from the pid's
  # argv with the known owner before trusting the scan's newest pane.
  [[ -z "$pane" || "$pane" == *:* ]] || pane=""
  if [[ -z "$pane" && "$live" -eq 1 ]]; then
    pane="$(sentinel_argv_pane "$pid" "$job" "$owner")"
  fi
  [[ -n "$pane" ]] || pane="$j_pane"
  local probe pclass ptoken
  if [[ -z "$pane" || "$pane" == - ]]; then
    echo "sentinel job=$job pid=$pid age=${age}s state=protected reason=no-pane-evidence"
    return 0
  fi
  probe="$(herdr_agent_probe "$pane")"
  IFS=$'\t' read -r pclass ptoken _ <<<"$probe"
  case "$pclass" in
    gone)
      PRUNE_ORPHANS=$(( PRUNE_ORPHANS + 1 ))
      echo "sentinel job=$job pid=$pid age=${age}s pane=$pane orphan=yes reason=pane-gone($ptoken)"
      if [[ "$PRUNE_APPLY" -eq 1 ]]; then
        if ! job_watch_current "$PRUNE_ROOT/$job/events" "$pane"; then # hk1798-pane-gone-superseded
          # hk1798: the watched pane is not the job's newest job.spawned pane
          # — a terminal-less revive superseded this sentinel, so ending or
          # releasing here would hit the live round's records.
          stop_completion_sentinel "$job" "$pid" && echo "  action=stopped-superseded"
        else
          local _end_out=""
          _end_out="$(job_end_record "$job" "$owner" abandoned "pane gone; sentinel orphaned" "wrk prune" 2>/dev/null)" || true
          # The pane observation can be stale after a revive; only release if
          # job_end_record confirms that this path actually ended the job.
          if [[ "$_end_out" == created || "$_end_out" == already-ended ]]; then # hk1798-pane-gone-end-gate
            release_job_quota_pool "$job" "$pane" || release_rc=$? # hk1798-pane-gone-release
            [[ "$release_rc" != 2 ]] || return 0 # hk1813-pane-gone-release-current
            stop_completion_sentinel "$job" "$pid" && echo "  action=stopped+ended"
          else
            stop_completion_sentinel "$job" "$pid" && echo "  action=stopped"
          fi
        fi
      fi ;;
    ok)
      echo "sentinel job=$job pid=$pid age=${age}s pane=$pane state=protected reason=pane-alive($ptoken)" ;;
    *)
      echo "sentinel job=$job pid=$pid age=${age}s pane=$pane state=protected reason=pane-unverifiable($ptoken)" ;;
  esac
}

prune_cmd() {
  local apply=0 stale_age="${WRK_PRUNE_STALE_AGE:-24h}" lane="" only_job=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) prune_help; return 0 ;;
      --apply) apply=1; shift ;;
      --stale-age) [[ $# -ge 2 && -n "$2" ]] || die "--stale-age requires a value"; stale_age="$2"; shift 2 ;;
      --lane) [[ $# -ge 2 && -n "$2" ]] || die "--lane requires a value"; lane="$2"; shift 2 ;;
      --job) [[ $# -ge 2 && -n "$2" ]] || die "--job requires a value"; only_job="$2"; shift 2 ;;
      -*) die "unknown prune option '$1'" ;;
      *) die "unexpected argument '$1'" ;;
    esac
  done
  local stale_s jobs_root
  stale_s="$(parse_duration_s "$stale_age")" || die "invalid --stale-age '$stale_age' (use 86400, 24h or 1d)"
  jobs_root="$(wrk_jobs_root)"
  if [[ ! -d "$jobs_root" ]]; then
    echo "prune: no job inbox at $jobs_root"
    return 0
  fi
  [[ -x "$HERDR" ]] || die "herdr unavailable: $HERDR"
  PRUNE_APPLY="$apply" PRUNE_LANE="$lane" PRUNE_ROOT="$jobs_root" PRUNE_ORPHANS=0

  # One python pass over every job's event stream — ended/hub_ended, newest
  # terminal, silence age and the spawned pane — shared by all three passes.
  local scan_dirs=() _d
  for _d in "$jobs_root"/*/; do
    [[ -d "$_d" ]] || continue
    scan_dirs+=("${_d%/}/events")
  done
  PRUNE_SCAN=""
  (( ${#scan_dirs[@]} )) && PRUNE_SCAN="$(job_events_scan "${scan_dirs[@]}")"

  local _mode="dry-run" pf job pid jdir
  (( apply )) && _mode="apply"
  echo "prune ($_mode) root=$jobs_root stale_age=${stale_age}$( [[ -n "$lane" ]] && printf ' lane=%s' "$lane" )"

  # Pass 1 — pidfile-sourced sentinels.
  while IFS= read -r pf; do
    [[ -n "$pf" ]] || continue
    jdir="${pf%/completion-sentinel.pid}"; job="${jdir##*/}"
    [[ -z "$only_job" || "$job" == "$only_job" ]] || continue
    pid=""; started=""
    IFS=$'\t' read -r pid started <<<"$(sentinel_pidfile_fields "$pf")"
    prune_sentinel_row "$job" "$pid" "$pf" "" "" "$started"
  done < <(find "$jobs_root" -maxdepth 2 -name completion-sentinel.pid -type f 2>/dev/null | sort)

  # Pass 2 — process sweep: live `wrk sentinel JOB …` processes, including
  # ones that never had (or lost) a pidfile. A pidfile pass already covers
  # the pair when its pid matches; a different live pid for the same job is
  # a second sentinel and is judged on its own.
  # hk1860: the one sentinel sweep of this run; pass 4 reads the same snapshot.
  PRUNE_SWEEP="$(sentinel_sweep 2>/dev/null || true)"
  local _pid _job _owner _label _pane _report _pfpid
  while IFS=$'\t' read -r _pid _job _owner _label _pane _report; do
    [[ -n "$_job" ]] || continue
    [[ -z "$only_job" || "$_job" == "$only_job" ]] || continue
    if [[ -f "$jobs_root/$_job/completion-sentinel.pid" ]]; then
      read -r _pfpid <"$jobs_root/$_job/completion-sentinel.pid" 2>/dev/null || _pfpid=""
      [[ "$_pfpid" == "$_pid" ]] && continue
    fi
    prune_sentinel_row "$_job" "$_pid" - "$_pane" "$_owner"
  done <<<"$PRUNE_SWEEP"

  # Pass 3 — stale jobs: silent past --stale-age AND pane absent. Records are
  # kept; --apply only appends the hub-visible end declaration.
  local stale_n=0 _ended _hub _term _age _last _comp _label _tab _pstate _end_pane _release_rc
  while IFS=$'\t' read -r job _ended _hub _term _age _last _comp _owner _label _pane _tab; do
    [[ -n "$job" ]] || continue
    [[ -z "$only_job" || "$job" == "$only_job" ]] || continue
    [[ -z "$lane" || "$_owner" == "$lane" ]] || continue
    [[ "$_ended" == 0 && "$_age" =~ ^[0-9]+$ && "$_age" -ge "$stale_s" ]] || continue
    _pstate="no-pane-recorded"
    if [[ "$_pane" != - ]]; then
      local _probe _pclass _ptoken
      _probe="$(herdr_agent_probe "$_pane")"
      IFS=$'\t' read -r _pclass _ptoken _ <<<"$_probe"
      [[ "$_pclass" == gone ]] || continue
      _pstate="gone:$_ptoken"
    fi
    stale_n=$(( stale_n + 1 ))
    echo "job $job stale=yes last_event_age=${_age}s owner=$_owner pane=$_pane pane_state=$_pstate"
    if (( apply )); then
      local _end_out=""
      _end_pane="$_pane"
      [[ "$_end_pane" == - ]] && _end_pane=""
      _end_out="$(job_end_record "$job" "$_owner" abandoned "stale: silent ${_age}s, pane absent" "wrk prune" "$_end_pane" 1 2>/dev/null)" || true
      if [[ "$_end_out" == created || "$_end_out" == already-ended ]]; then
        echo "  action=end-declaration"
        # hk1798: the end declaration landed (or the job had already ended) —
        # return whatever quota records the dead pane's lease left behind.
        _release_rc=0
        release_job_quota_pool "$job" "$_end_pane" || _release_rc=$? # hk1798-prune-stale-release
        [[ "$_release_rc" != 2 ]] || continue
      else
        echo "  action=end-declaration-failed"
      fi
    fi
  done <<<"$PRUNE_SCAN"

  # Pass 4 — quota_pool records on jobs whose newest terminal is still newer
  # than every revive, and that have no live completion sentinel. The arbiter
  # table is authoritative for rows: an earlier release event may be followed
  # by a new record for the same job and pool.
  # hk1860: the run takes ONE unscoped arbiter status. Its rows are keyed by
  # job_id; each ended job reads its pools from that map, and its liveness from
  # the pass-2 sweep. The release still rechecks the round and the sentinel
  # right before each release, so a sentinel that starts after the sweep is
  # still refused there.
  local quota_releases=0 _quota_arb="${ARBITER:-}" _quota_status="" _quota_map="" _quota_rc=0
  local _quota_pools _quota_csv _quota_pane _quota_rc2 _live_jobs _probe _pclass _ptoken _qj _qp
  if [[ -z "$_quota_arb" || ! -x "$_quota_arb" ]]; then
    _quota_arb="$(command -v arbiter 2>/dev/null || true)"
  fi
  # hk1860 round 3: the status document is read from stdin by this script. It
  # is never an argv word, since Linux caps one argument at 128 KiB. A parse
  # failure exits 3 and an exec failure exits with its own rc; both take the
  # status-failed skip path below.
  local _quota_map_py='
import json, sys
try:
    doc = json.load(sys.stdin)
except ValueError:
    raise SystemExit(3)
if not isinstance(doc, dict):
    raise SystemExit(3)
for row in doc.get("quota_pool_records") or []:
    if (isinstance(row, dict) and isinstance(row.get("job_id"), str) and row["job_id"]
            and isinstance(row.get("pool"), str) and row["pool"]):
        print(row["job_id"] + "\t" + row["pool"])
'
  if [[ -n "$_quota_arb" && -x "$_quota_arb" ]]; then
    _quota_status="$("$_quota_arb" status --json 2>/dev/null)" || _quota_rc=$?
    if (( _quota_rc == 0 )); then
      _quota_map="$(printf '%s' "$_quota_status" | python3 -c "$_quota_map_py")" || _quota_rc=$?
    fi
  fi
  _live_jobs="$(awk -F '\t' 'NF >= 2 {print $2}' <<<"$PRUNE_SWEEP")"
  while IFS=$'\t' read -r job _ended _hub _term _age _last _comp _owner _label _pane _tab; do
    [[ -n "$job" ]] || continue
    [[ -z "$only_job" || "$job" == "$only_job" ]] || continue
    [[ -z "$lane" || "$_owner" == "$lane" ]] || continue
    [[ "$_ended" == 1 ]] || continue # hk1813-ended-quota-release-pass
    [[ $'\n'"$_live_jobs"$'\n' != *$'\n'"$job"$'\n'* ]] || continue
    if [[ -z "$_quota_arb" || ! -x "$_quota_arb" ]]; then
      if (( apply )); then quota_release_log "$job" "-" "rc=- reason=arbiter-unavailable"; fi
      echo "skip job=$job reason=arbiter-unavailable"
      continue
    fi
    if (( _quota_rc != 0 )); then
      if (( apply )); then quota_release_log "$job" "-" "rc=$_quota_rc reason=status-failed"; fi
      echo "skip job=$job reason=status-failed"
      continue
    fi
    _quota_pools=""
    while IFS=$'\t' read -r _qj _qp; do
      [[ "$_qj" == "$job" && -n "$_qp" ]] || continue
      _quota_pools+="$_qp"$'\n'
    done <<<"$_quota_map"
    [[ -n "$_quota_pools" ]] || continue
    _quota_csv="$(printf '%s' "$_quota_pools" | sort -u | paste -sd, -)"
    _quota_pane="$_pane"
    [[ "$_quota_pane" == - ]] && _quota_pane=""
    # hk1860: the newest job.spawned pane must not be alive. The probe classes
    # match prune pass 2; an unverifiable probe skips too (fail safe).
    if [[ -n "$_quota_pane" ]]; then
      _probe="$(herdr_agent_probe "$_quota_pane")"
      IFS=$'\t' read -r _pclass _ptoken _ <<<"$_probe"
      case "$_pclass" in
        gone) ;;
        ok) echo "skip job=$job reason=pane-alive"; continue ;;
        *) echo "skip job=$job reason=pane-unverified($_ptoken)"; continue ;;
      esac
    fi
    if (( apply )); then
      _quota_rc2=0
      release_job_quota_pool "$job" "$_quota_pane" ended-no-sentinel || _quota_rc2=$? # hk1813-ended-quota-release-call
      [[ "$_quota_rc2" != 2 ]] || continue
      quota_releases=$(( quota_releases + 1 ))
      echo "release-attempted job=$job pools=$_quota_csv"
    else
      _quota_rc2=0
      quota_release_round_current "$job" "$_quota_pane" ended-no-sentinel || _quota_rc2=$?
      [[ "$_quota_rc2" != 2 ]] || continue
      quota_releases=$(( quota_releases + 1 ))
      echo "would-release job=$job pools=$_quota_csv"
    fi
  done <<<"$PRUNE_SCAN"

  # Pass 5 — quota-refresh supervisors (quota-refresh.pid written by
  # refresh_quota_pool). A live pid is only a leftover when it verifies
  # (start time matches the record within the pid-reuse window) AND the job
  # ended or the recorded deadline passed.
  local left_n=0 _rpf _rjob _rpid="" _rdeadline=0 _rstarted=0 _rpool="" _rfields _kv _elapsed _row _rended
  while IFS= read -r _rpf; do
    [[ -n "$_rpf" ]] || continue
    jdir="${_rpf%/quota-refresh.pid}"; _rjob="${jdir##*/}"
    [[ -z "$only_job" || "$_rjob" == "$only_job" ]] || continue
    _rpid=""; _rdeadline=0; _rstarted=0; _rpool=""
    _rfields="$(cat "$_rpf" 2>/dev/null || true)"
    local -a _farr=()
    read -r -a _farr <<<"$_rfields"
    for _kv in "${_farr[@]}"; do
      case "$_kv" in
        pid=*) _rpid="${_kv#pid=}" ;;
        deadline=*) _rdeadline="${_kv#deadline=}" ;;
        started=*) _rstarted="${_kv#started=}" ;;
        pool=*) _rpool="${_kv#pool=}" ;;
      esac
    done
    if [[ ! "$_rpid" =~ ^[0-9]+$ ]] || ! kill -0 "$_rpid" 2>/dev/null; then
      left_n=$(( left_n + 1 ))
      echo "refresh job=$_rjob pid=${_rpid:-?} pool=${_rpool:--} leftover=yes reason=pid-stale"
      (( apply )) && { rm -f "$_rpf" && echo "  action=removed-pidfile"; }
      continue
    fi
    # Live pid: prove it is our supervisor — recorded start vs real elapsed
    # must agree AND the argv must be the supervisor command itself carrying
    # THIS pidfile path (a reused pid, or a bare `python3 -c …` that merely
    # greps as "python", points at an unrelated process and is never
    # signalled).
    _elapsed="$(proc_elapsed_s "$_rpid" 2>/dev/null || echo "")"
    if [[ -z "$_elapsed" || "$_rstarted" =~ [^0-9] || -z "$_rstarted" ]] ||
       (( ( $(date +%s) - _rstarted - _elapsed ) > 120 || ( $(date +%s) - _rstarted - _elapsed ) < -120 )) ||
       ! refresh_supervisor_argv_matches "$_rpid" "$_rpf"; then
      echo "refresh job=$_rjob pid=$_rpid pool=${_rpool:--} state=protected reason=pid-unverified"
      continue
    fi
    _row="$(awk -v j="$_rjob" -F'\t' '$1==j {print $2; exit}' <<<"$PRUNE_SCAN")"
    _rended="${_row:-0}"
    if [[ "$_rended" == 1 ]] || (( $(date +%s) > _rdeadline + 60 )); then
      left_n=$(( left_n + 1 ))
      echo "refresh job=$_rjob pid=$_rpid pool=${_rpool:--} leftover=yes reason=deadline-passed-or-job-ended"
      if (( apply )); then
        # Supervisor did setsid: its pgid equals its pid, and the group owns
        # the scopefuel refresh child too.
        kill -- "-$_rpid" 2>/dev/null || kill "$_rpid" 2>/dev/null || true
        rm -f "$_rpf"
        echo "  action=killed-group"
      fi
    else
      echo "refresh job=$_rjob pid=$_rpid pool=${_rpool:--} state=alive deadline=${_rdeadline}"
    fi
  done < <(find "$jobs_root" -maxdepth 2 -name quota-refresh.pid -type f 2>/dev/null | sort)

  echo "prune: orphans=$PRUNE_ORPHANS stale_jobs=$stale_n quota_release_jobs=$quota_releases refresh_leftovers=$left_n ($_mode)"
}

find_cmd() {
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { find_help; return 0; }
  local target="" pane_only=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) find_help; return 0 ;;
      --pane-only) pane_only=1 ;;
      -*) die "unknown option '$1'" ;;
      *) [[ -z "$target" ]] || die "find accepts exactly one target"; target="$1" ;;
    esac
    shift
  done
  [[ -n "$target" ]] || die "find requires a name or label"
  [[ -x "$HERDR" ]] || die "herdr unavailable: $HERDR"
  local af tf rc
  af="$(mktemp)"; tf="$(mktemp)"
  "$HERDR" agent list >"$af"
  "$HERDR" tab list >"$tf"
  set +e
  python3 - "$target" "$pane_only" "$HERDR" "$af" "$tf" <<'PY'
import json, subprocess, sys
target, pane_only, herdr, af, tf = sys.argv[1:]
def load(path, key):
    with open(path, encoding="utf-8") as f:
        p = json.load(f)
    r = p.get("result", p)
    v = r.get(key) if isinstance(r, dict) else None
    if not isinstance(v, list):
        raise ValueError("invalid herdr JSON: " + key)
    return v
agents, tabs = load(af, "agents"), load(tf, "tabs")
labels = {t.get("tab_id"): t.get("label") for t in tabs}
def unique(items):
    out, seen = [], set()
    for item in items:
        pane = item.get("pane_id")
        if pane and pane not in seen:
            out.append(item); seen.add(pane)
    return out
matches = unique([a for a in agents if a.get("name") == target])
kind = "name"
if not matches:
    ids = {t.get("tab_id") for t in tabs if t.get("label") == target}
    matches = unique([a for a in agents if a.get("tab_id") in ids])
    kind = "label"
if not matches:
    print("wrk find: no exact name or label match: " + target, file=sys.stderr)
    raise SystemExit(1)
def desc(a):
    return ("pane_id=" + a.get("pane_id","?") + " name=" + (a.get("name") or "-") +
            " label=" + (labels.get(a.get("tab_id")) or "-") +
            " agent=" + a.get("agent","-") + " status=" + a.get("agent_status","-"))
if pane_only == "1":
    if len(matches) != 1:
        print("wrk find: ambiguous " + str(len(matches)) + " " + kind + " matches", file=sys.stderr)
        raise SystemExit(1)
    print(matches[0].get("pane_id",""))
    raise SystemExit(0)
print("match=" + kind + " target=" + repr(target) + " candidates=" + str(len(matches)))
read_failed = False
for a in matches:
    print(desc(a))
    p = subprocess.run([herdr, "pane", "read", a["pane_id"], "--source", "recent",
                        "--lines", "5", "--format", "text"], capture_output=True, text=True)
    lines = p.stdout.rstrip("\n").splitlines()[-5:] if p.returncode == 0 else ["(pane read failed)"]
    for line in lines or ["(no screen output)"]:
        print("  " + line)
    read_failed = read_failed or p.returncode != 0
if len(matches) != 1:
    print("wrk find: multiple panes matched; refusing automatic selection", file=sys.stderr)
    raise SystemExit(1)
raise SystemExit(1 if read_failed else 0)
PY
  rc=$?
  set -e
  rm -f "$af" "$tf"
  return "$rc"
}

name_sync_cmd() {
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { name_sync_help; return 0; }
  local mode=preview labels=() arg
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "$arg" in
      -h|--help) name_sync_help; return 0 ;;
      --apply) mode=apply ;;
      --*) die "unknown option '$arg'" ;;
      *) mode=apply; labels+=("$arg") ;;
    esac
    shift
  done
  HERDR_BIN="$HERDR" python3 - "$mode" "${labels[@]:-}" <<'PY'
import json, os, subprocess, sys
H = os.environ["HERDR_BIN"]
mode = sys.argv[1]
want = [x for x in sys.argv[2:] if x]
def run(*args):
    return json.loads(subprocess.run([H, *args], capture_output=True, text=True).stdout)["result"]
labels = {}
for ws in run("workspace", "list").get("workspaces", []):
    for t in run("tab", "list", "--workspace", ws["workspace_id"]).get("tabs", []):
        if t.get("label"): labels[t["tab_id"]] = t["label"]
agents = run("agent", "list")["agents"]
taken = {a["name"] for a in agents if a.get("name")}
by_tab = {}
for a in agents: by_tab.setdefault(a.get("tab_id"), []).append(a)
acted = skipped = 0
for tab, label in sorted(labels.items()):
    if want and label not in want: continue
    members = by_tab.get(tab, [])
    unnamed = [a for a in members if not a.get("name")]
    if not unnamed: continue
    if len(members) > 1:
        print(f"  △ SKIP  {tab} '{label}' — 탭에 agent {len(members)}개(모호). 수동: herdr agent rename <pane> <이름>")
        skipped += 1; continue
    a = unnamed[0]
    if label in taken:
        print(f"  △ SKIP  {tab} '{label}' — 이름 이미 사용 중(agent_name_taken)")
        skipped += 1; continue
    if not want and (label.isdigit() or len(label) < 3):
        print(f"  △ SKIP  {tab} '{label}' — 잡라벨 추정(숫자/3자 미만). 원하면 라벨 명시 지정으로")
        skipped += 1; continue
    if mode == "apply":
        r = subprocess.run([H, "agent", "rename", a["pane_id"], label], capture_output=True, text=True)
        ok = '"agent_info"' in r.stdout or "agent_info" in r.stdout
        print(f"  {'✓' if ok else '✗'} {a['pane_id']} ({a['agent']}) → name '{label}'")
        taken.add(label); acted += 1
    else:
        print(f"  · 후보  {a['pane_id']} ({a['agent']}, 이름 없음) → '{label}'")
        acted += 1
if mode == "preview":
    print(f"\n후보 {acted}건, 스킵 {skipped}건 — 적용: herdr-name-sync --apply (또는 라벨 지정)")
else:
    print(f"\n적용 {acted}건, 스킵 {skipped}건")
PY
}

heavy_help() {
  cat <<'USAGE'
Usage: wrk heavy [--queue-key KEY] -- <command> [args...]
       wrk heavy status

Serialize heavy (>1 minute) local test/build runs: up to `heavy_max` holders
per host (default 1) via fcntl.flock on per-host slot files (works the same
on macOS and Linux — macOS has no `flock` command, and flock releases a dead
holder's slot automatically, unlike shlock pid-files). Slot 0 is the lock
file itself; slots 1..N-1 are <lock>.slot<i>. The command runs under
`nice -n 10` and, while the load wait is on (see heavy_load_wait below),
only starts once load5/ncpu < 1.0. Total wait (slot + load) defaults to a cap of
20 minutes; on expiry the command is NOT run and wrk exits 75
(EX_TEMPFAIL). The command inherits the slot fd (nested detection
needs it — see WRK_HEAVY_HELD_FD), so an orphaned child keeps the slot while
it lives; the kernel frees the slot when the whole holder tree is gone.

The limit comes from hosts.toml `[local] heavy_max` (WRK_HOSTS_CONFIG or
~/.config/wrk/hosts.toml): unset = 1, 0 = refuse every heavy run on this
host with rc 78 (EX_CONFIG) and a message naming the host and pointing at
desktop, N>1 = N concurrent holders. `WRK_HEAVY_MAX` overrides the
configured value for one invocation. A non-integer or negative limit also
refuses rc 78 — a config typo must not silently allow runs. Lowering the
limit does not kill extra holders minted under a larger one; they drain.

`[local] heavy_load_wait` is this host's switch for the load5/ncpu < 1.0
wait (#1241), read through the same strict [local] scanner as `spawn`:
bare TOML true/false only, written once under a clean '[local]' — absent
or `true` keeps the wait exactly as above; `false` skips ONLY the load
wait (the heavy_max slot, its lock, `nice -n 10` and the cap are
unchanged — the slot wait still counts toward the cap and expires rc 75).
A malformed [local] surface — bad value, quoted spelling, duplicate key,
bad header — refuses the run rc 70 naming the file line, before any slot
is taken. `wrk hosts` prints it as `local heavy_load_wait=true|false|
error (...)`.

Priority class (hk 1533): `WRK_HEAVY_CLASS=ci` marks a run as CI work; unset,
empty or `lane` is the default lane class, and any other value refuses rc 78.
While a live ci waiter is queued on the lock, a lane waiter does not take any
slot that ci waiter could take (a slot index below the limit the ci waiter
itself runs under) — the next slot to free goes to the ci waiter instead of
whoever polls first. It is a queue order only, never preemption: a running
holder is not signalled, displaced or shortened, and a ci waiter never
defers. Slots above every live ci waiter's limit stay open to lanes, so a ci
waiter confined to slot 0 (WRK_HEAVY_MAX=1) never leaves slot 1 idle. A ci
waiter whose pid is gone or whose start identity differs reserves nothing;
EPERM still requires a matching identity, and unreadable identity keeps the
record. macOS uses the exact `ps -o lstart=` text at one-second resolution;
reuse within that same second is indistinguishable and reads as alive, while a
different-second reuse is detected. Linux uses `/proc` start ticks plus boot
id. Starvation
guard: a lane waiter that has spent WRK_HEAVY_CI_DEFER_MAX seconds in total
deferring to live ci waiters (default 1800; 0 = never defer) stops deferring
for the rest of its wait. Only time with a live ci waiter counts: the clock
runs while a ci waiter could take a slot and pauses while none is queued, so
a ci waiter that arrives late never finds the guard already spent. The total
wait cap still applies, so with the default 1200 s cap the guard only matters
under a larger WRK_HEAVY_WAIT_CAP.

Exactly what the ordering promises (it is a queue order read from the
waiters dir, not a lock): a ci waiter is queued from the moment its record is
visible there. The record is written under a dot name and renamed into place
before the waiter's first slot attempt, so a lane pass reads a whole record
or none. Every lane pass that starts after that rename skips the slots the ci
waiter could take; the next slot to free goes to the ci waiter. Not
promised: a ci waiter is not queued while wrk and its python half are still
starting up (before the record exists), and a lane pass that had already
read the records when the rename happened (one pass, no re-read before its
slot attempts) can still take a slot that frees in that same pass. Neither
is preempted afterwards. Waiters from before hk 1533 ignore classes entirely.

Lane FIFO (hk 1407): each published waiter carries a wall-clock enqueue
ticket, with pid breaking equal-time ties. A lane skips any slot that an
older live lane ticket could take (index below that waiter's own limit).
WRK_HEAVY_LANE_DEFER_MAX (default 1800 seconds, 0 = never defer) bounds how
long this waiter defers to older lane waiters, measured on its monotonic
clock. When it expires, it stops deferring for the rest of its wait. CI
reservation and its starvation guard above are unchanged; spending either
guard never waives the other reservation. A provably dead or reused owner
and a ticketless lane record reserve nothing. Pre-identity records keep the
reservation behaviour they have today: ticketed lane records and CI records
still count, while a ticketless lane record does not. CI reservation does
not depend on tickets: live CI waiters with or without a ticket keep
reserving exactly as above. Older lane waiters do not honor tickets, so
mixed versions can still race. Tickets order visible records, not process
start times: the same starting-up window and pass that already scanned
described above apply to lanes too. A clock step can change wall-clock
order; wait caps and both defer guards use monotonic time. No holder is
preempted.

Use --queue-key KEY (or WRK_HEAVY_QUEUE_KEY) to keep a place across a wait-cap
exit (75). KEY is ASCII [A-Za-z0-9._-]{1,64}; the option overrides the env.
The position stores the original ticket until now + WRK_HEAVY_REQUEUE_GRACE
(default 600 seconds). A retry before expiry reuses it; at expiry or later
it is ignored. Acquisition consumes the position. Positions alone reserve
no slots, and unkeyed retries always get a fresh ticket. Same-key concurrent
retries can share a ticket; no order between equal tickets is promised.
Position files use the same directory trust checks as waiters, and must be
regular files owned by this uid, without symlinks or hardlinks. A same-uid
process can write a position for any key, so a forged key can at most give
that process the original ticket within the grace. This narrows; it does
not bound. Owned per-key guards coordinate position publication and removal:
this is a same-uid cooperation convention, not a security boundary. Status
skips stale-position cleanup while a guard is busy, rather than waiting.
Long runs (Unity) should pass a larger WRK_HEAVY_WAIT_CAP together
with --queue-key to keep their place. The cap remains one per-run value.

`wrk heavy status` prints the lock path, this host, the effective limit,
the load-wait switch (`load_wait true|false|error (...)`), one `holder`
line per occupied slot, and queued waiters (holder pids are the
wrk heavy python processes; killing one frees its slot once the command
tree that inherited the slot fd is also gone). Every holder and waiter line
carries `class=ci|lane` (and the limit it queued under). status never
creates slot files and is never refused. Live waiter tickets print in order;
live positions print their key, ticket and expiry. Stale records are cleaned.

Every acquisition appends one JSON record to the heavy log (default
~/.local/state/wrk/heavy.log): ts, kind=run, host, job (ARBITER_JOB or -),
task (HK_TASK_ID or -), pid, class (ci|lane), slot, limit, cmd, wait_s,
wait_lock_s, wait_load_s, hold_s, rc. Nested runs are logged as kind=nested,
refusals as kind=refused and wait-cap expiries as kind=wait_cap, so wait
times stay aggregable and no execution path evades the log. A lane waiter
that was held back behind a ci waiter also writes one kind=defer row when the
hold-back ends: the same class field as every row, wait_s, defer_s and
reason (guard, acquired, cap, interrupt or exit).

Notes: the command's own exit 75 is indistinguishable from a wait-cap 75 —
check stderr. stdin is not forwarded (the command sees EOF). A nested
`wrk heavy` on the same lock is detected and run directly under nice — the
outer invocation already holds a slot, so nesting never deadlocks. Because
the command inherits the slot descriptor, the slot stays held for as long
as any inheriting descendant lives: a crashed wrapper's slot is reclaimed
by the kernel only once the whole holder process tree is gone.

Environment:
  WRK_HEAVY_HELD        <lock path>:<holder pid>, set by wrk heavy for its
                        command; informational only — nested detection uses
                        WRK_HEAVY_HELD_FD
  WRK_HEAVY_HELD_FD     <fd>:<slot path>, set by wrk heavy for its command
                        so a nested wrk heavy is detected; honored only when
                        the fd is an inherited descriptor of the open file
                        description that owns that slot's flock right now,
                        and the slot is acquirable under the current limit —
                        forged env values and rewritten slot text cannot pass
  WRK_HEAVY_LOCK        lock file path
                        (default /tmp/wrk-heavy-<hostname>.lock)
  WRK_HEAVY_MAX         override the hosts.toml heavy_max for this run
  WRK_HEAVY_CLASS       ci | lane (unset = lane): ci waiters get the next
                        free slot before any lane waiter, without preempting
  WRK_HEAVY_CI_DEFER_MAX
                        seconds a lane waiter defers to a live ci waiter
                        before it stops (default 1800, 0 = never defer)
  WRK_HEAVY_LANE_DEFER_MAX
                        seconds a lane waiter defers to older lane waiters
                        before it stops (default 1800, 0 = never defer)
  WRK_HEAVY_WAIT_CAP    total wait cap in seconds (default 1200)
  WRK_HEAVY_QUEUE_KEY   durable re-queue key (overridden by --queue-key)
  WRK_HEAVY_REQUEUE_GRACE
                        seconds a capped keyed ticket survives (default 600)
  WRK_HEAVY_LOAD_FILE   file re-read each poll whose first field is used as
                        load5/ncpu (default: os.getloadavg()[1]/cpu_count)
  WRK_HEAVY_LOG         acquisition log path
                        (default ~/.local/state/wrk/heavy.log)
  -h, --help            show this usage
USAGE
}

heavy_cmd() {
  case "${1:-}" in
    -h|--help) heavy_help; return 0 ;;
  esac
  # #1241: the strict [local] scan owns heavy_load_wait (and spawn). A
  # malformed [local] surface refuses a run rc 70 here — before the python
  # half can take a slot or run anything (this check precedes heavy_max's
  # own rc 78: one grammar error on the [local] surface outranks a bad
  # value inside it). status is a reporting command: the error text is
  # carried through for display instead.
  local heavy_load_wait=1 heavy_load_wait_src=default heavy_load_wait_err=""
  if local_spawn_scan; then
    heavy_load_wait="$LOCAL_HEAVY_LOAD_WAIT"
    heavy_load_wait_src="$LOCAL_HEAVY_LOAD_WAIT_SRC"
  else
    heavy_load_wait_err="$LOCAL_SPAWN_ERROR"
    if [[ "${1:-}" != status ]]; then
      echo "wrk: ${LOCAL_SPAWN_ERROR}; refusing heavy run" >&2
      return "$WRK_EXIT_CONFIG_REFUSED"
    fi
  fi
  # Per-host heavy concurrency limit (#772): WRK_HEAVY_MAX wins for one
  # invocation, then hosts.toml [local] heavy_max via the same
  # spillover_value reader that owns the documented TOML surface, else 1.
  # The python half validates and enforces it.
  local heavy_limit heavy_limit_src
  if [[ -n "${WRK_HEAVY_MAX:-}" ]]; then
    heavy_limit="$WRK_HEAVY_MAX"
    heavy_limit_src="WRK_HEAVY_MAX"
  elif heavy_limit="$(spillover_value local heavy_max 2>/dev/null)"; then
    heavy_limit_src="$(spillover_config) [local] heavy_max"
  else
    heavy_limit=1
    heavy_limit_src="default"
  fi
  WRK_HEAVY_LIMIT="$heavy_limit" WRK_HEAVY_LIMIT_SRC="$heavy_limit_src" \
    WRK_HEAVY_LOAD_WAIT="$heavy_load_wait" \
    WRK_HEAVY_LOAD_WAIT_SRC="$heavy_load_wait_src" \
    WRK_HEAVY_LOAD_WAIT_ERR="$heavy_load_wait_err" \
    python3 - "$@" <<'PY'
import base64, datetime, errno, fcntl, glob, json, math, os, re, signal, socket, stat, subprocess, sys, tempfile, time

EXIT_WAIT_CAP = 75  # EX_TEMPFAIL: transient, worth reporting and retrying later
EXIT_REFUSED = 78   # EX_CONFIG: this host's configuration forbids the run


def fail(msg, rc):
    print("wrk heavy: " + msg, file=sys.stderr)
    raise SystemExit(rc)


def alive(pid):
    # Pre-identity records keep the exact old rule: every error except ESRCH
    # is treated as alive. New records use owner_alive below.
    live, _ = kill_probe(pid)
    return live is not False


def kill_probe(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False, "dead"
    except PermissionError:
        return True, "eperm"
    except OSError as exc:
        if exc.errno == errno.ESRCH:
            return False, "dead"
        if exc.errno == errno.EPERM:
            return True, "eperm"
        return None, "kill-unknown"
    return True, "same"


def process_start_identity(pid):
    """Return a stable, whitespace-free process start identity or None."""
    if sys.platform == "darwin":
        try:
            ps = subprocess.run(
                ["/bin/ps", "-o", "lstart=", "-p", str(pid)],
                capture_output=True, text=True, check=False, timeout=1,
                env={"LC_ALL": "C", "TZ": "UTC"},
            )
        except (OSError, subprocess.SubprocessError):
            return None
        # macOS ps reports lstart at one-second resolution. Compare its exact
        # displayed text, encoded losslessly into this one-token record field.
        # PID reuse within that same second is indistinguishable and therefore
        # reads as alive (fail-safe); reuse in a different second is detected.
        lstart = ps.stdout
        if lstart.endswith("\r\n"):
            lstart = lstart[:-2]
        elif lstart.endswith("\n"):
            lstart = lstart[:-1]
        if ps.returncode != 0 or not lstart.strip():
            return None
        encoded = base64.urlsafe_b64encode(lstart.encode("utf-8")).decode("ascii")
        return "darwin:" + encoded.rstrip("=")
    elif sys.platform.startswith("linux"):
        try:
            with open("/proc/%d/stat" % pid, encoding="ascii") as f:
                stat_line = f.read()
            # comm is parenthesized and may itself contain spaces or ')'.
            close = stat_line.rfind(")")
            if close < 0:
                return None
            fields = stat_line[close + 1:].split()
            start_ticks = fields[19]  # field 22; fields[0] is field 3 (state)
            with open("/proc/sys/kernel/random/boot_id", encoding="ascii") as f:
                boot_id = f.read().strip()
            if not re.fullmatch(r"[0-9a-fA-F-]{16,64}", boot_id):
                return None
            if not start_ticks.isdecimal():
                return None
        except (OSError, IndexError, UnicodeError):
            return None
        return "linux:%s:%s" % (boot_id.lower(), start_ticks)
    else:
        return None


owner_identity_unknown_logged = False


def log_owner_identity_unknown(pid, record, reason):
    global owner_identity_unknown_logged
    if owner_identity_unknown_logged:
        return
    owner_identity_unknown_logged = True
    log_event({"kind": "owner_identity_unknown", "record": record,
               "owner_pid": pid, "reason": reason})


def owner_identity_status(pid, start, record="?"):
    # hk1991-owner-alive
    # Double probes keep a PID exit/reuse race from turning one stale read
    # into proof that the new process owns the record.
    if start == "unknown":
        log_owner_identity_unknown(pid, record, "start-read-unknown")
        return None, "identity-unknown"
    if not isinstance(start, str) or not re.fullmatch(r"[A-Za-z0-9:_-]{1,192}", start):
        log_owner_identity_unknown(pid, record, "missing-or-malformed-start")
        return None, "identity-unknown"

    present, reason = kill_probe(pid)
    if present is not True:
        if present is None:
            log_owner_identity_unknown(pid, record, reason)
        return present, reason
    first = process_start_identity(pid)
    if first is None:
        log_owner_identity_unknown(pid, record, "start-read-unknown")
        return None, "identity-unknown"
    if first != start:
        return False, "start-mismatch"
    present, reason = kill_probe(pid)
    if present is not True:
        if present is None:
            log_owner_identity_unknown(pid, record, reason)
        return present, reason
    second = process_start_identity(pid)
    if second is None:
        log_owner_identity_unknown(pid, record, "start-reread-unknown")
        return None, "identity-unknown"
    if second != start:
        return False, "start-mismatch"
    return True, "same"


def owner_alive(pid, start, record="?"):
    live, _ = owner_identity_status(pid, start, record)
    return live


def record_owner_status(pid, start, record):
    if start is None:
        # Director ruling: preserve each legacy record type's existing
        # reservation behaviour when it predates start identity.
        live = alive(pid)
        return live, ("legacy" if live else "dead")
    return owner_identity_status(pid, start, record)


def reservation_owner_alive(pid, start, record):
    if start is None:
        return alive(pid)
    return owner_alive(pid, start, record)


def read_text(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def record_head(text):
    # (pid, start, class, limit) from the fixed head. Token five is start;
    # tokens one through four keep the original pid/class/limit/ticket layout
    # readable by an older wrk. Free-text cmd fields cannot forge head values.
    pid, start, cls, lim = -1, None, "lane", None
    toks = text.split(None, 5)[:5]
    for tok in toks:
        if tok.startswith("pid="):
            try:
                pid = int(tok[4:])
            except ValueError:
                pass
        elif tok.startswith("start="):
            start = tok[6:]
        elif tok.startswith("class=") and tok[6:] in ("ci", "lane"):
            cls = tok[6:]
        elif tok.startswith("limit="):
            try:
                lim = int(tok[6:])
            except ValueError:
                pass
    return pid, start, cls, lim


def with_class(text):
    # status prints the class of every record; one an older wrk wrote carries
    # none, so it is shown as the lane it behaves as.
    toks = text.split(None, 4)[:4]
    if not toks or not toks[0].startswith("pid="):
        return text
    if any(t.startswith("class=") for t in toks[1:]):
        return text
    return toks[0] + " class=lane" + text[len(toks[0]):]


def record_ticket(text):
    # Both old and new records keep ticket in token four. Never scan cmd text.
    fields = text.split(None, 4)
    if len(fields) >= 4:
        match = re.fullmatch(r"ticket=([0-9]{1,20}):([0-9]{1,20})", fields[3])
        if match:
            ticket = tuple(map(int, match.groups()))
            if all(n > 0 for n in ticket):
                return ticket
    return None


args = sys.argv[1:]
if not args:
    fail("usage: wrk heavy -- <command> [args...] | wrk heavy status", 2)

host = socket.gethostname()
lock_path = os.environ.get("WRK_HEAVY_LOCK") or (
    "/tmp/wrk-heavy-%s.lock" % host)
waiters_dir = lock_path + ".waiters"
positions_dir = lock_path + ".positions"

# The bash half resolves the limit from WRK_HEAVY_MAX or hosts.toml [local]
# heavy_max. Invalid (non-integer or negative) refuses the run rc 78; status
# stays tolerant so a broken config can still be inspected.
limit_raw = os.environ.get("WRK_HEAVY_LIMIT", "1")
limit_src = os.environ.get("WRK_HEAVY_LIMIT_SRC", "default")
try:
    limit = int(limit_raw)
    limit_ok = limit >= 0
except ValueError:
    limit, limit_ok = -1, False

# #1241: hosts.toml [local] heavy_load_wait — resolved by the strict
# [local] scan in the bash half — switches the post-slot load5/ncpu < 1.0
# wait off per host. "0" skips only that wait; a scan error already
# refused runs rc 70 before this process, so the error text only reaches
# here for `status`, which prints it instead of a value.
load_wait = os.environ.get("WRK_HEAVY_LOAD_WAIT", "1") != "0"
load_wait_src = os.environ.get("WRK_HEAVY_LOAD_WAIT_SRC", "default")
load_wait_err = os.environ.get("WRK_HEAVY_LOAD_WAIT_ERR", "")

# hk 1533: WRK_HEAVY_CLASS=ci puts this run ahead of lane waiters on the
# host's lock; unset or empty is the lane class. Any other spelling refuses
# the run rc 78 below (status stays tolerant and just reports records).
hclass_raw = os.environ.get("WRK_HEAVY_CLASS", "")
hclass = hclass_raw or "lane"
hclass_ok = hclass in ("ci", "lane")

slot_re = re.compile(re.escape(lock_path) + r"\.slot(\d+)$")


def slot_index(path):
    if path == lock_path:
        return 0
    return int(slot_re.match(path).group(1))


def limit_slots():
    # Acquirable slots under the current limit. The base lock file stays
    # slot 0 so a limit-1 host keeps byte-identical semantics (and stays
    # mutually exclusive with older wrk versions that only know that file).
    if not limit_ok:
        return [lock_path]
    return [lock_path] + [
        "%s.slot%d" % (lock_path, i) for i in range(1, limit)]


def known_slots():
    # Slots a status/nested-holder probe must inspect: acquirable ones plus
    # files minted under an earlier larger limit — their holders still
    # serialize even though new runs may not take them.
    paths = list(limit_slots())
    extras = [p for p in glob.glob(lock_path + ".slot*")
              if slot_re.match(p) and p not in paths]
    return paths + sorted(extras, key=slot_index)


log_path = os.environ.get("WRK_HEAVY_LOG") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "wrk", "heavy.log")


def log_event(rec):
    # One JSONL record per event the director aggregates: runs (with
    # wait/hold seconds), refusals and wait-cap expiries. Best-effort — a
    # lost record must not fail the run.
    rec.update({
        "ts": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
        "host": host,
        "job": os.environ.get("ARBITER_JOB") or "-",
        "task": os.environ.get("HK_TASK_ID") or "-",
        "pid": os.getpid(),
        "class": hclass,
    })
    try:
        os.makedirs(os.path.dirname(log_path), exist_ok=True)
        with open(log_path, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, sort_keys=True) + "\n")
    except OSError as e:
        print("wrk heavy: cannot write heavy log %s: %s" % (log_path, e),
              file=sys.stderr)


def owner_trusted(st):
    # The caller's own objects, and root's (hk 1545 r3): an unprivileged
    # local user cannot create a root-owned file or dir at a predictable
    # name, so uid 0 is as trusted as our own — operator-installed shared
    # locks on desktop are root-owned on purpose, with the runner granted
    # access by ACL. A hardlink to a root file still fails the nlink
    # check, and mode rules below apply to any owner.
    return st.st_uid in (os.getuid(), 0)


def slot_probe(path):
    # NB flock probe: an open fd iff the path is a conforming slot inode —
    # a plain file, one link, owned by this uid — that another process
    # holds flocked right now; the caller may then read the holder record
    # through the returned fd (no second open to race a swap) and must
    # close it. Never mints the slot — a missing file cannot be held.
    # O_NOFOLLOW refuses a planted symlink; the fstat refuses a planted
    # hardlink or a foreign inode at the same predictable name — a file
    # another local user linked in is not a slot (hk 1545).
    try:
        fd = os.open(path, os.O_RDWR | os.O_NOFOLLOW)
    except OSError:
        return None
    held = False
    try:
        st = os.fstat(fd)
        if (stat.S_ISREG(st.st_mode) and st.st_nlink == 1 and
                owner_trusted(st)):
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                held = True
    except OSError:
        pass
    if not held:
        os.close(fd)  # close also releases a probe that did acquire
        return None
    return fd


def flock_held(path):
    fd = slot_probe(path)
    if fd is None:
        return False
    os.close(fd)
    return True


def waiters_dir_fd(path=None):
    # Open the waiters dir itself, never through a link: O_DIRECTORY pins
    # the object to a real directory and O_NOFOLLOW refuses a symlink at
    # the waiters name — a repointable link is exactly the foreign-party-
    # controls-names case the run path refuses outright (hk 1545 r2).
    # Callers that then listdir/open/rename/remove through this fd cannot
    # have their operations redirected by a same-name path swap either.
    try:
        return os.open(waiters_dir if path is None else path,
                       os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError:
        return None


def read_waiter_record(dirfd, name):
    # A record entry is opened through the dir fd with O_NOFOLLOW and
    # O_NONBLOCK: a link swapped in after the regular-file check is refused
    # outright and a fifo swapped in can never block the read (hk 1545).
    # "" means the entry is not a readable record.
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                     dir_fd=dirfd)
    except OSError:
        return ""
    try:
        with os.fdopen(fd, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


def waiters_dir_open(path=None):
    # Pin a trusted directory; all subsequent operations use its fd. Shared
    # root-owned sticky dirs remain usable, as on the desktop waiters path.
    fd = waiters_dir_fd(path)
    if fd is None:
        return -1
    try:
        st = os.fstat(fd)
        trusted = (owner_trusted(st) and
                   not (st.st_mode & 0o022 and
                        not st.st_mode & stat.S_ISVTX))
    except OSError:
        trusted = False
    if not trusted:
        os.close(fd)
        return -1
    return fd


key_re = re.compile(r"[A-Za-z0-9._-]{1,64}", re.ASCII)


def position_name(key):
    # ASCII hex preserves case-distinct keys on case-insensitive filesystems;
    # the prefix also keeps valid dot keys ordinary filenames.
    return "key-" + key.encode("ascii").hex() + ".json"


def read_position(dirfd, name):
    # Check the opened inode, not a path that could be swapped after stat.
    # Nonblocking open prevents even a racing fifo from hanging the queue.
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                     dir_fd=dirfd)
    except OSError:
        return None
    try:
        with os.fdopen(fd, encoding="utf-8") as f:
            st = os.fstat(f.fileno())
            if not (stat.S_ISREG(st.st_mode) and st.st_nlink == 1
                    and st.st_uid == os.getuid() and st.st_size <= 8192):
                return None
            record = json.loads(f.read(8193))
        if not isinstance(record, dict):
            return None
        key, ticket, expiry = (record.get(k) for k in ("key", "ticket", "expiry"))
        if (not isinstance(key, str) or not key_re.fullmatch(key)
                or name != position_name(key)
                or not isinstance(ticket, list) or len(ticket) != 2
                or any(type(n) is not int or not 0 < n < 10**20 for n in ticket)
                or type(expiry) not in (int, float) or not math.isfinite(expiry)):
            return None
        return record, st
    except (OSError, ValueError, UnicodeError, OverflowError, RecursionError):
        return None


def position_guard_open(dirfd, key):
    # A directory flock would also be available to other uids in an allowed
    # root-owned sticky directory. Use a persistent, private owned inode.
    name = ".guard-" + key.encode("ascii").hex()
    flags = os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK
    try:
        try:
            fd = os.open(name, flags | os.O_CREAT, 0o600, dir_fd=dirfd)
        except FileNotFoundError:
            # macOS can report ENOENT when a peer creates the same guard.
            # Try that existing inode once, without creating or following
            # anything; the same fstat checks below still own acceptance.
            fd = os.open(name, flags, dir_fd=dirfd)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if (stat.S_ISREG(st.st_mode) and st.st_uid == os.getuid()
                and st.st_nlink == 1 and not st.st_mode & 0o077):
            return fd
    except OSError:
        pass
    os.close(fd)
    return None


def position_guard_lock(fd, *, blocking=True):
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
        return True
    except OSError:
        return False


def position_guard_unlock(fd):
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass


def remove_position_locked(dirfd, name, st):
    # The guard spans stat/unlink, so a cooperating cap publisher cannot
    # replace the observed inode in between. Keep replacements from before
    # we acquired the guard (e.g. a renewed expiry seen by status).
    try:
        current = os.stat(name, dir_fd=dirfd, follow_symlinks=False)
        if (current.st_dev, current.st_ino) == (st.st_dev, st.st_ino):
            os.remove(name, dir_fd=dirfd)
    except OSError:
        pass


def remove_position(dirfd, name, st, *, key, blocking=True):
    guardfd = position_guard_open(dirfd, key)
    if guardfd is None:
        return
    try:
        if not position_guard_lock(guardfd, blocking=blocking):
            return
        try:
            current = read_position(dirfd, name)
            if current is not None:
                _, observed = current
                if (observed.st_dev, observed.st_ino) == (st.st_dev, st.st_ino):
                    remove_position_locked(dirfd, name, observed)
        finally:
            position_guard_unlock(guardfd)
    finally:
        os.close(guardfd)


if args[0] == "status":
    if len(args) != 1:
        fail("status takes no arguments", 2)
    print("lock " + lock_path)
    print("host " + host)
    if limit_ok:
        print("limit %d (%s)" % (limit, limit_src))
    else:
        print("limit %s (invalid, %s)" % (limit_raw, limit_src))
    if load_wait_err:
        print("load_wait error (%s)" % load_wait_err)
    elif load_wait:
        print("load_wait true (%s)" % load_wait_src)
    else:
        print("load_wait false (%s)" % load_wait_src)
    paths = known_slots()
    holders = []
    for p in paths:
        sfd = slot_probe(p)
        if sfd is not None:
            try:
                info = os.pread(sfd, 8192, 0).decode("utf-8", "replace")
            except OSError:
                info = ""
            os.close(sfd)
            holders.append((slot_index(p),
                            info.strip() or "(info unreadable)"))
    for i, hinfo in holders:
        print("holder " + (("slot=%d " % i) if len(paths) > 1 else "")
              + with_class(hinfo))
    if not holders:
        print("holder none")
    waiters = []
    # O_DIRECTORY|O_NOFOLLOW on the dir itself: a link planted at the
    # waiters name is not followed into another user's dir, and listing
    # through the fd cannot be redirected by a same-name swap after open.
    wfd = waiters_dir_fd()
    names = []
    if wfd is not None:
        try:
            names = sorted(os.listdir(wfd))
        except OSError:
            names = []
    for name in names:
        if name.startswith("."):
            continue  # a record being published (see publish_record)
        try:
            # A planted symlink or fifo is never opened as a record: in a
            # shared (sticky) waiters dir another user can still create
            # entries, and a record read must not follow one elsewhere.
            if not stat.S_ISREG(os.stat(name, dir_fd=wfd,
                                        follow_symlinks=False).st_mode):
                continue
        except OSError:
            continue
        info = read_waiter_record(wfd, name)
        # The fixed head carries pid and optional start identity; free text
        # after it cannot make a live waiter look dead or forge ownership.
        pid, start, _, _ = record_head(info)
        if pid > 0:
            live, reason = record_owner_status(pid, start, name)
        else:
            live, reason = True, "unparsed"
        if pid > 0 and live is False:
            retired = False
            try:
                os.remove(name, dir_fd=wfd)
                retired = True
            except OSError:
                pass
            if retired:
                log_event({"kind": "waiter_retired", "record": name,
                           "owner_pid": pid, "reason": reason})
            continue
        waiters.append((record_ticket(info), with_class(info) if info else name))
    if wfd is not None:
        os.close(wfd)
    for _, w in sorted(waiters, key=lambda item: (item[0] is None, item[0] or (0, 0), item[1])):
        print("waiter " + w)
    if not waiters:
        print("waiters none")
    pfd = waiters_dir_open(positions_dir)
    positions = []
    if pfd >= 0:
        try:
            try:
                names = os.listdir(pfd)
            except OSError:
                names = []
            for name in names:
                result = read_position(pfd, name)
                if result is None:
                    continue
                record, st = result
                if record["expiry"] <= time.time():
                    remove_position(pfd, name, st, key=record["key"], blocking=False)
                else:
                    positions.append(record)
        finally:
            os.close(pfd)
    for record in sorted(positions, key=lambda r: (r["ticket"], r["key"])):
        print("position key=%s ticket=%d:%d expiry=%s" %
              (record["key"], *record["ticket"], record["expiry"]))
    raise SystemExit(0)

queue_key = os.environ.get("WRK_HEAVY_QUEUE_KEY") or None
if args[0] == "--queue-key":
    if len(args) < 2:
        fail("--queue-key requires KEY", 2)
    queue_key = args[1]
    args = args[2:]
if queue_key is not None and not key_re.fullmatch(queue_key):
    fail("invalid queue key (want ASCII [A-Za-z0-9._-]{1,64})", EXIT_REFUSED)
try:
    requeue_grace = float(os.environ.get("WRK_HEAVY_REQUEUE_GRACE", "600"))
except ValueError:
    requeue_grace = -1
if not math.isfinite(requeue_grace) or requeue_grace < 0:
    fail("WRK_HEAVY_REQUEUE_GRACE is not a finite non-negative number", 2)

if not args or args[0] != "--":
    fail("expected '--' before the command (see 'wrk heavy --help')", 2)
cmd = args[1:]
if not cmd:
    fail("no command after '--'", 2)

try:
    cap = float(os.environ.get("WRK_HEAVY_WAIT_CAP", "1200"))
except ValueError:
    fail("WRK_HEAVY_WAIT_CAP is not a number", 2)
deadline = time.monotonic() + cap
# hk 1533 anti-starvation guard: seconds a lane waiter keeps deferring to a
# live ci waiter before it stops. 0 turns the deferral off for this run.
try:
    defer_max = float(os.environ.get("WRK_HEAVY_CI_DEFER_MAX", "1800"))
except ValueError:
    defer_max = -1.0
if not defer_max >= 0:
    fail("WRK_HEAVY_CI_DEFER_MAX is not a non-negative number", 2)
try:
    lane_defer_max = float(os.environ.get("WRK_HEAVY_LANE_DEFER_MAX", "1800"))
except ValueError:
    lane_defer_max = -1.0
if not lane_defer_max >= 0:
    fail("WRK_HEAVY_LANE_DEFER_MAX is not a non-negative number", 2)
cmd_summary = " ".join(cmd)
# Token five is the owner's start identity; the first four tokens retain the
# pid/class/limit/ticket positions read by 1a9ded3.
owner_start = process_start_identity(os.getpid()) or "unknown"
info = "pid=%d class=%s limit=%d since=%s job=%s cmd=%s" % (
    os.getpid(), hclass, limit,
    datetime.datetime.now().isoformat(timespec="seconds"),
    os.environ.get("ARBITER_JOB") or "-", cmd_summary)
started_at = time.monotonic()

if not limit_ok:
    fail("invalid heavy limit '%s' from %s (want an integer >= 0)"
         % (limit_raw, limit_src), EXIT_REFUSED)
if not hclass_ok:
    fail("invalid WRK_HEAVY_CLASS '%s' (want ci or lane; unset = lane)"
         % hclass_raw, EXIT_REFUSED)
if limit == 0:
    log_event({"kind": "refused", "cmd": cmd_summary[:200],
               "limit": 0, "limit_src": limit_src})
    fail("host '%s' is configured heavy_max=0 (%s) -- refusing; run heavy "
         "commands on desktop instead" % (host, limit_src), EXIT_REFUSED)


def load_ratio():
    load_file = os.environ.get("WRK_HEAVY_LOAD_FILE")
    if load_file:
        try:
            return float(read_text(load_file).split()[0])
        except (ValueError, IndexError):
            return None
    try:
        return os.getloadavg()[1] / (os.cpu_count() or 1)
    except OSError:
        return None


def ci_reserved():
    # hk 1533: how many leading slots (index < N) a live ci waiter other
    # than this process could take; 0 when none is queued. Liveness is the
    # rule status uses for stale waiter files (pid alive) — a dead ci
    # waiter's leftover record never reserves anything. Read-only: status
    # owns the cleanup of stale files. A ci record with no usable limit
    # reserves nothing — priority degrades to the old free-for-all, it never
    # idles a slot on a record that cannot say which slots it wants.
    try:
        names = os.listdir(waiters_fd)
    except OSError:
        return 0
    reserved = 0
    for name in names:
        if name.startswith("."):
            continue  # a record being published (see publish_record)
        try:
            if not stat.S_ISREG(os.stat(name, dir_fd=waiters_fd,
                                        follow_symlinks=False).st_mode):
                continue  # a planted link or fifo is not a record
        except OSError:
            continue
        pid, start, cls, lim = record_head(read_waiter_record(waiters_fd, name))
        if cls != "ci" or pid <= 0 or pid == os.getpid():
            continue
        if lim is None or lim < 1:
            continue
        if reservation_owner_alive(pid, start, name) is False:
            continue
        reserved = max(reserved, lim)
    return reserved


def lane_reserved():
    # Shape of ci_reserved, but only strictly older live lane tickets count.
    # A mixed-version record lacking a ticket can never leave a slot idle.
    try:
        names = os.listdir(waiters_fd)
    except OSError:
        return 0
    reserved = 0
    for name in names:
        if name.startswith("."):
            continue
        try:
            if not stat.S_ISREG(os.stat(name, dir_fd=waiters_fd,
                                        follow_symlinks=False).st_mode):
                continue
        except OSError:
            continue
        text = read_waiter_record(waiters_fd, name)
        pid, start, cls, lim = record_head(text)
        older = record_ticket(text)
        if cls != "lane" or pid <= 0 or pid == os.getpid():
            continue
        if older is None or older >= ticket or lim is None or lim < 1:
            continue
        if reservation_owner_alive(pid, start, name) is False:
            continue
        reserved = max(reserved, lim)
    return reserved


def fd_is_open(fd):
    try:
        os.fstat(fd)
    except OSError:
        return False
    return True


slot_env_re = re.compile(
    re.escape(os.path.realpath(lock_path)) + r"\.slot(\d+)$")


def nested_held_fd(fd_s, env_path):
    # WRK_HEAVY_HELD_FD=<fd>:<slot path> is honored only when every kernel
    # check lines up: fd is an open descriptor on a slot acquirable under the
    # current limit, that file is flock-held right now, AND fd belongs to the
    # open file description that owns the lock (relocking an inherited
    # descriptor of the held OFD succeeds; a fresh open on a file held by
    # another fails). The proof object is the slot itself — no env text,
    # slot text, pid, side file, or PATH helper is trusted, because anything
    # a same-uid caller can name or rewrite it can also fake (#772 tester
    # rounds 1-3). A `.slotN` outside the current limit is just a caller-made
    # file — honoring it would let a self-flocked phantom slot forge nesting.
    rp = os.path.realpath(env_path)
    if rp != os.path.realpath(lock_path):
        m = slot_env_re.match(rp)
        if m is None or not 0 < int(m.group(1)) < limit:
            return None
    try:
        env_fd = int(fd_s)
        fst = os.fstat(env_fd)
        lst = os.stat(env_path)
    except (OSError, ValueError):
        return None
    if (fst.st_dev, fst.st_ino) != (lst.st_dev, lst.st_ino):
        return None
    if not flock_held(env_path):
        return None  # the slot it claims is free — stale or forged
    try:
        fcntl.flock(env_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return None  # a different OFD than the holder's
    return env_fd


held_fd = None
held_path = None
nested_fd = None
nested_path = None


def run_command():
    try:
        env = dict(os.environ)
        env["WRK_HEAVY_HELD"] = "%s:%d" % (
            os.path.abspath(lock_path), os.getpid())
        hfd = held_fd if held_fd is not None else nested_fd
        hpath = held_path if held_fd is not None else nested_path
        if hfd is not None and hpath and fd_is_open(hfd):
            # hand the slot fd down so a nested wrk heavy can prove it is
            # inside this holder's process tree (see nested_held_fd)
            env["WRK_HEAVY_HELD_FD"] = "%d:%s" % (hfd, hpath)
            pfds = {hfd}
        else:
            env.pop("WRK_HEAVY_HELD_FD", None)
            pfds = ()
        rc = subprocess.call(["nice", "-n", "10"] + cmd, env=env,
                             pass_fds=pfds)
        if rc < 0:
            rc = 128 - rc
        return rc
    except FileNotFoundError as e:
        fail("cannot run command: %s" % e, 127)
    except KeyboardInterrupt:
        return 130


# A nested `wrk heavy` on the same lock would deadlock against itself for the
# full cap — the outer invocation already holds a slot on this host, so run
# the inner command directly (still under nice) and log it as a nested run.
# Detection is by inherited slot fd, not the pid env: the holder hands its
# slot descriptor to the command, and only a process that actually received
# that descriptor can relock it.
held_fd_env = os.environ.get("WRK_HEAVY_HELD_FD", "")
held_fd_s, sep, held_fd_path = held_fd_env.partition(":")
if sep and held_fd_s.isdigit():
    nested_fd = nested_held_fd(held_fd_s, held_fd_path)
    if nested_fd is not None:
        nested_path = os.path.realpath(held_fd_path)
if nested_fd is not None:
    print("wrk heavy: already holding %s in this process tree -- "
          "running nested command without re-locking" % lock_path,
          file=sys.stderr)
    nested_at = time.monotonic()
    nrc = run_command()
    log_event({"kind": "nested", "cmd": cmd_summary[:200], "limit": limit,
               "wait_s": 0.0, "hold_s": round(time.monotonic() - nested_at, 3),
               "rc": nrc})
    raise SystemExit(nrc)

try:
    # mode=0o700: a liberal umask (002) must not mint a group-writable dir
    # this same run then refuses (hk 1545 r3); an existing dir is untouched
    os.makedirs(waiters_dir, mode=0o700, exist_ok=True)
except OSError as e:
    fail("cannot create waiters dir %s: %s" % (waiters_dir, e), EXIT_REFUSED)
waiters_fd = waiters_dir_open()
if waiters_fd < 0:
    fail("refusing untrusted waiters dir %s (must be owned by uid %d or "
         "root and not be a symlink; a group/other-writable dir must "
         "carry the sticky bit)" % (waiters_dir, os.getuid()),
         EXIT_REFUSED)
positions_fd = -1
position_guard_fd = -1
ticket = (time.time_ns(), os.getpid())
if queue_key is not None:
    try:
        os.makedirs(positions_dir, mode=0o700, exist_ok=True)
    except OSError as e:
        fail("cannot create positions dir %s: %s" % (positions_dir, e), EXIT_REFUSED)
    positions_fd = waiters_dir_open(positions_dir)
    if positions_fd < 0:
        fail("refusing untrusted positions dir %s (same trust rules as waiters dir)"
             % positions_dir, EXIT_REFUSED)
    position_guard_fd = position_guard_open(positions_fd, queue_key)
    if position_guard_fd is None:
        fail("refusing unsafe queue position guard for key %s" % queue_key, EXIT_REFUSED)
    previous = read_position(positions_fd, position_name(queue_key))
    if previous is not None:
        record, st = previous
        if record["expiry"] > time.time():
            ticket = tuple(record["ticket"])
        else:
            remove_position(positions_fd, position_name(queue_key), st, key=queue_key)
# Keep the original pid/class/limit/ticket tokens byte-compatible; start is
# the fifth fixed token so an older reader sees every field it reads today.
info = info.replace(" since=", " ticket=%d:%d start=%s since=" %
                    (ticket[0], ticket[1], owner_start), 1)
me_name = str(os.getpid())
held_slot = -1
acquired_at = None
run_at = None
rc = None
# Seconds this waiter actually spent deferring to a live ci waiter: closed
# intervals in defer_total, the open one (started the pass reserved first
# went above 0, closed the pass it drops back to 0) from defer_mark. Time
# with no live ci waiter never counts, so a ci waiter that shows up late
# cannot find the guard already spent.
defer_total = 0.0
defer_mark = None
defer_seen = False   # held back at least once: a defer row is owed
defer_over = False   # guard fired: no more deferral for the rest of the wait
defer_logged = False
lane_defer_total = 0.0
lane_defer_mark = None
lane_defer_seen = False
lane_defer_over = lane_defer_max == 0
lane_defer_logged = False
record_tmp = None    # mkstemp path mid-publish; every exit path drops it


def save_position():
    if positions_fd < 0:
        return
    record = {"key": queue_key, "ticket": ticket,
              "expiry": time.time() + requeue_grace}
    tmp = ".position-" + os.urandom(16).hex()
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                     0o600, dir_fd=positions_fd)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(record, f)
            f.flush()
            os.fsync(f.fileno())
        if not position_guard_lock(position_guard_fd):
            raise OSError("cannot lock queue position guard")
        try:
            os.replace(tmp, position_name(queue_key),
                       src_dir_fd=positions_fd, dst_dir_fd=positions_fd)
        finally:
            position_guard_unlock(position_guard_fd)
        # Some filesystems do not support directory fsync; atomic rename
        # still ensures readers see a complete record after a process crash.
        try:
            os.fsync(positions_fd)
        except OSError:
            pass
    except OSError as e:
        print("wrk heavy: cannot save queue position: %s" % e, file=sys.stderr)
    finally:
        try:
            os.remove(tmp, dir_fd=positions_fd)
        except OSError:
            pass


def consume_position():
    if positions_fd < 0:
        return
    if not position_guard_lock(position_guard_fd):
        fail("cannot lock queue position guard", EXIT_REFUSED)
    try:
        previous = read_position(positions_fd, position_name(queue_key))
        if previous is not None:
            _, st = previous
            remove_position_locked(positions_fd, position_name(queue_key), st)
    finally:
        position_guard_unlock(position_guard_fd)


def end_defer(reason):
    # One kind=defer row per lane waiter that was held back behind a ci
    # waiter, written when the hold-back ends: reason guard
    # (WRK_HEAVY_CI_DEFER_MAX of deferred time spent), acquired, cap,
    # interrupt or exit. defer_s is the time actually spent deferring.
    global defer_logged
    if not defer_seen or defer_logged:
        return
    defer_logged = True
    now = time.monotonic()
    spent = defer_total + ((now - defer_mark) if defer_mark is not None else 0)
    log_event({"kind": "defer", "cmd": cmd_summary[:200], "limit": limit,
               "wait_s": round(now - started_at, 3),
               "defer_s": round(spent, 3),
               "reason": reason})


def end_lane_defer(reason):
    global lane_defer_logged
    if not lane_defer_seen or lane_defer_logged:
        return
    lane_defer_logged = True
    now = time.monotonic()
    spent = lane_defer_total + ((now - lane_defer_mark)
                                if lane_defer_mark is not None else 0)
    log_event({"kind": "lane_defer", "cmd": cmd_summary[:200], "limit": limit,
               "wait_s": round(now - started_at, 3),
               "defer_s": round(spent, 3), "reason": reason})


def publish_record():
    # The waiter record is published atomically: written under a dot name
    # that status and the ci scan skip, then renamed into place, so a lane
    # pass reads a whole record or none (never the empty file an open-then-
    # write leaves for a moment). mkstemp picks that dot name (hk 1545):
    # O_EXCL on an unpredictable name, already open, so a symlink another
    # local user pre-planted at the old .<pid>.tmp is never followed. The
    # rename and the cleanup unlink run through waiters_fd (hk 1545 r2):
    # they land in the exact dir the trust check opened, never in whatever
    # the waiters path might be repointed to. This precedes this waiter's
    # first slot attempt. A ci waiter counts as queued from the rename on.
    global record_tmp
    fd, tmp = tempfile.mkstemp(dir=waiters_dir, prefix=".")
    record_tmp = os.path.basename(tmp)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(info)
        os.replace(record_tmp, me_name,
                   src_dir_fd=waiters_fd, dst_dir_fd=waiters_fd)
        record_tmp = None
    finally:
        if record_tmp is not None:
            try:
                os.remove(record_tmp, dir_fd=waiters_fd)
            except OSError:
                pass
            record_tmp = None


# PEP 446: os.open returns non-inheritable fds; the acquired slot fd is
# re-inherited into the command only via run_command's pass_fds so nested
# runs can prove they are inside the holder's tree (nested_held_fd). A slot
# therefore stays held for as long as any inheriting descendant lives — the
# lock's lifetime is the holder's process tree, not just this wrapper.
slot_paths = limit_slots()
# The slot files are predictable names under /tmp too: O_NOFOLLOW refuses
# a pre-planted symlink, and the fstat refuses the rest of that attack
# class (hk 1545 r2): a planted hardlink or a foreign file would still
# open, then be flocked, truncated and rewritten through the victim's
# inode — a slot must be a plain file, one link, owned by this uid or
# root (operator-installed shared locks are root-owned on desktop); a
# fifo or device at the name is refused cleanly here instead of dying on
# the flock below.
slot_fds = []
for _sp in slot_paths:
    try:
        _fd = os.open(_sp, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    except OSError as e:
        fail("cannot open heavy slot %s: %s" % (_sp, e), EXIT_REFUSED)
    try:
        _st = os.fstat(_fd)
    except OSError as e:
        os.close(_fd)
        fail("cannot stat heavy slot %s: %s" % (_sp, e), EXIT_REFUSED)
    if not (stat.S_ISREG(_st.st_mode) and _st.st_nlink == 1 and
            owner_trusted(_st)):
        os.close(_fd)
        fail("refusing untrusted heavy slot %s (must be a plain file "
             "with one link owned by uid %d or root)" % (_sp, os.getuid()),
             EXIT_REFUSED)
    slot_fds.append(_fd)
try:
    def wait_signal_handler(signum, frame):
        end_defer("signal")
        end_lane_defer("signal")
        try:
            os.remove(me_name, dir_fd=waiters_fd)
        except OSError:
            pass
        raise SystemExit(128 + signum)

    signal.signal(signal.SIGHUP, wait_signal_handler)
    signal.signal(signal.SIGTERM, wait_signal_handler)
    publish_record()
    while True:
        try:
            # hk 1533 priority: while a live ci waiter is queued, a lane
            # waiter does not take any slot that waiter could take (index
            # below its limit) — the next slot to free goes to the ci waiter.
            # Slots above every live ci waiter's limit stay open, so a ci
            # waiter that only ever uses slot 0 never leaves slot 1 idle.
            # Nothing is preempted: only free slots are contested, and a ci
            # waiter itself never defers. This is a queue order read from the
            # waiters dir, not a lock: the records are scanned once per pass
            # and not re-read before the slot attempts, so a pass already
            # past its scan when a ci record is renamed into place may still
            # take a slot that frees in that pass, and a ci waiter is not
            # queued before its record is visible (see wrk heavy --help).
            reserved = 0
            if hclass != "ci" and defer_max > 0 and not defer_over:
                reserved = ci_reserved()
                now = time.monotonic()
                if reserved:
                    if defer_mark is None:
                        defer_mark = now
                        defer_seen = True
                    if defer_total + (now - defer_mark) >= defer_max:
                        defer_total += now - defer_mark
                        defer_mark = None
                        defer_over = True
                        reserved = 0
                        end_defer("guard")
                elif defer_mark is not None:
                    defer_total += now - defer_mark
                    defer_mark = None
            # CI keeps its existing guard and log clock; lane FIFO is a
            # separate reservation and is never waived by spending it.
            lane_limit = 0
            if hclass == "lane" and lane_defer_max > 0 and not lane_defer_over:
                lane_limit = lane_reserved()
                now = time.monotonic()
                if lane_limit:
                    if lane_defer_mark is None:
                        lane_defer_mark = now
                        lane_defer_seen = True
                    if lane_defer_total + (now - lane_defer_mark) >= lane_defer_max:
                        lane_defer_total += now - lane_defer_mark
                        lane_defer_mark = None
                        lane_defer_over = True
                        lane_limit = 0
                        end_lane_defer("guard")
                elif lane_defer_mark is not None:
                    lane_defer_total += now - lane_defer_mark
                    lane_defer_mark = None
            for i, sfd in enumerate(slot_fds):
                if i < reserved:
                    continue
                if i < lane_limit:
                    continue
                try:
                    fcntl.flock(sfd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    held_fd, held_slot, held_path = sfd, i, slot_paths[i]
                    break
                except BlockingIOError:
                    pass
            if held_fd is not None:
                break
            if time.monotonic() >= deadline:
                end_defer("cap")
                end_lane_defer("cap")
                save_position()
                log_event({"kind": "wait_cap", "phase": "slot",
                           "cmd": cmd_summary[:200], "limit": limit,
                           "wait_s": round(time.monotonic() - started_at, 3)})
                fail("wait cap %.0fs exceeded waiting for a heavy slot on %s "
                     "-- command not run" % (cap, lock_path), EXIT_WAIT_CAP)
            time.sleep(0.5)
        except KeyboardInterrupt:
            end_defer("interrupt")
            end_lane_defer("interrupt")
            fail("interrupted while waiting for a heavy slot on %s "
                 "-- command not run" % lock_path, 130)
    acquired_at = time.monotonic()
    consume_position()
    end_defer("acquired")
    end_lane_defer("acquired")
    try:
        os.remove(me_name, dir_fd=waiters_fd)
    except OSError:
        pass
    os.ftruncate(held_fd, 0)
    os.write(held_fd, (info + "\n").encode())
    # #1241 r2: the load loop below doubles as the post-acquire cap gate —
    # a pass that wins the flock skips the slot loop's own deadline check,
    # so a slot granted after the cap is caught only when the load wait
    # runs. With the wait off there is no second gate: refuse the late slot
    # exactly like a slot-wait expiry (same message, same wait_cap event).
    if not load_wait and acquired_at >= deadline:
        save_position()
        log_event({"kind": "wait_cap", "phase": "slot",
                   "cmd": cmd_summary[:200], "limit": limit,
                   "wait_s": round(time.monotonic() - started_at, 3)})
        fail("wait cap %.0fs exceeded waiting for a heavy slot on %s "
             "-- command not run" % (cap, lock_path), EXIT_WAIT_CAP)
    # heavy_load_wait = false skips only this wait — the slot above is
    # held, its wait counted toward the cap, and nice -n 10 is unchanged.
    while load_wait:
        try:
            ratio = load_ratio()
            if ratio is None or ratio < 1.0:
                break
            if time.monotonic() >= deadline:
                save_position()
                log_event({"kind": "wait_cap", "phase": "load",
                           "cmd": cmd_summary[:200], "limit": limit,
                           "wait_s": round(time.monotonic() - started_at, 3)})
                fail("wait cap %.0fs exceeded waiting for load5/ncpu %.2f "
                     "< 1.0 -- command not run" % (cap, ratio), EXIT_WAIT_CAP)
            time.sleep(1)
        except KeyboardInterrupt:
            fail("interrupted while waiting for load to drop "
                 "-- command not run", 130)
    signal.signal(signal.SIGHUP, signal.SIG_DFL)
    signal.signal(signal.SIGTERM, signal.SIG_DFL)
    run_at = time.monotonic()
    try:
        rc = run_command()
    except SystemExit as e:
        rc = e.code if isinstance(e.code, int) else 1
        raise
    raise SystemExit(rc)
finally:
    end_defer("exit")
    end_lane_defer("exit")
    for leftover in (me_name, record_tmp,
                     ".%d.tmp" % os.getpid()):
        if leftover is None:
            continue
        try:
            os.remove(leftover, dir_fd=waiters_fd)
        except OSError:
            pass
    os.close(waiters_fd)
    if positions_fd >= 0:
        os.close(positions_fd)
    if position_guard_fd >= 0:
        os.close(position_guard_fd)
    if held_fd is not None:
        if run_at is not None:
            log_event({"kind": "run", "cmd": cmd_summary[:200],
                       "slot": held_slot, "limit": limit,
                       "wait_s": round(run_at - started_at, 3),
                       "wait_lock_s": round(acquired_at - started_at, 3),
                       "wait_load_s": round(run_at - acquired_at, 3),
                       "hold_s": round(time.monotonic() - acquired_at, 3),
                       "rc": rc})
        os.ftruncate(held_fd, 0)
    for sfd in slot_fds:
        os.close(sfd)
PY
}

case "${1:-}" in
  -h|--help) usage ;;
  spawn) shift; spawn_router_cmd "$@" ;;
  done) shift; done_cmd "$@" ;;
  escalate) shift; escalate_cmd "$@" ;;
  joined) shift; joined_cmd "$@" ;;
  round) shift; round_cmd "$@" ;;
  sentinel) shift; sentinel_cmd "$@" ;;
  reap) shift; reap_cmd "$@" ;;
  lanes-missing) shift; lanes_missing_cmd "$@" ;;
  prune) shift; prune_cmd "$@" ;;
  find) shift; find_cmd "$@" ;;
  name-sync) shift; name_sync_cmd "$@" ;;
  profiles) shift; profiles_cmd "$@" ;;
  hosts) shift; hosts_cmd "$@" ;;
  heavy) shift; heavy_cmd "$@" ;;
  "") usage >&2; exit 2 ;;
  *) die "unknown command '$1' (see 'wrk --help')" ;;
esac
