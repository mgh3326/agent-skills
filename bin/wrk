    # effort xhigh — the same kind/argv the generic grok wiring emits.
    builder-grok) PROFILE_KIND=grok; DEFAULT_EFFORT=xhigh; EFFORT_SUPPORTED=1 ;;
    # #737 (decision 4088): the E6 grok measurement rungs — the same grok
    # kind/argv the generic wiring emits, each pinned to the rung in its last
    # segment and marker-gated via GATE_EFFORT_PIN below.
    builder-grok-low|builder-grok-medium|builder-grok-xhigh) PROFILE_KIND=grok; DEFAULT_EFFORT="${MODEL##*-}"; EFFORT_SUPPORTED=1 ;;

    # ROB-1222: agy-flash는 은퇴 목록에서 제외 — agy 네이티브로 실행.
    # 멘리: effort는 모델명에 인코딩(-high). --dangerously-skip-permissions 필수.
    # ROB-1251: AA v1.3 실측 57(opencode)로 A+ 배치 완료 — 기본을 3.7로 전환.
    # agy-flash36은 즉시 롤백용 명시 별칭, agy-flash37은 동의어로 유지(이미 3.7).
