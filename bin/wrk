#!/usr/bin/env bash
# wrk — herdr spawn/find/name-sync entrypoint.
set -euo pipefail

HERDR="${HERDR_BIN:-$HOME/.local/bin/herdr}"
SCOPEFUEL="${SCOPEFUEL_BIN:-}"
ARBITER="${ARBITER_BIN:-}"
# A live duplicate is an exact-once violation, distinct from generic CLI
# misuse (2) and the arbiter's own duplicate result (4).  75 means that an
# arbiter duplicate was observed but its state could not be proven safely.
WRK_EXIT_ACTIVE_JOB_DUPLICATE=74
WRK_EXIT_JOB_STATE_UNREADABLE=75
# A pane may be valid even when the submitted brief cannot be positively
# observed. Automation opts into 76 to distinguish that outcome from the
# ROB-1326 duplicate-job contracts above.
WRK_EXIT_LANDING_UNCONFIRMED=76
# kimi-k3-low: KIMI_CODE_HOME for the low-thinking-effort clone maintained by
# bin/kimi-clone-home (config.toml [thinking] effort=low; real ~/.kimi-code
# untouched). Scoped to only this profile below, not kimi-k3/kimi-k27.
KIMI_CODE_LOW_HOME="${KIMI_CODE_LOW_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/kimi-code-low}"
# ROB-1252: cc-qwen38/cc-glm route the Claude Code CLI itself through the
# CLIProxyAPI instance at 127.0.0.1:8317 (openai-compatibility provider
# "cline-pass" registered in ~/.cli-proxy-api/config.yaml, aliases
# cc-qwen38/cc-glm), which translates to Cline's OpenAI-compat chat/completions
# upstream and re-serves native Anthropic /v1/messages — no ClinePass Anthropic
# ingress exists (verified: /anthropic, /api/v1/messages, /v1/messages all 404).
# The gate API key lives only in this file, read fresh at spawn time and passed
# solely into the spawned pane's env — never into ~/.claude/ config.
CLINEPASS_GATE_URL="http://127.0.0.1:8317"
CLINEPASS_GATE_KEY_FILE="${CLINEPASS_GATE_KEY_FILE:-$HOME/.config/cliproxyapi-key.txt}"

# 프로필 이름 전체 목록(resolve_profile 의 case 문과 동기화 유지) — `wrk profiles` 출력 및
# scopefuel 교차검증(추천 프로필 ⊆ wrk 가 띄울 수 있는 프로필)의 근거.
ALL_PROFILES=(
  opus sonnet sonnet-med haiku fable captain-opus
  codex-terra codex-med codex-terra-max codex-luna codex-luna-hi codex-luna-max
  codex codex-sol codex-max captain-sol
  kiro kiro-opus kiro-sonnet kiro-sol kiro-luna kiro-cheap kiro-glm kiro-deepseek
  kiro-minimax kiro-minimax21 kiro-haiku kiro-opus-xhigh kiro-opus-max
  kiro-sol-xhigh kiro-sol-max
  kimi-k3 kimi-k27 kimi-k3-low
  oc-kimi-code oc-glm oc-kimi-k3 oc-dsflash oc-sonnet46 oc-oss oc-omni
  oc-qwen37-max oc-minimax-m3
  agy-flash agy-flash36 agy-flash37
  grok grok-hi grok-med grok45 grok45-med grok46 grok46-med
  cc-qwen38 cc-glm cc-dsflash cc-dspro cc-glm53
)

profiles_help() {
  cat <<'USAGE'
Usage: wrk profiles

Print every model profile name resolve_profile() accepts, one per line
(machine-readable; excludes retired agy-* aliases). Used for
scopefuel-vs-wrk cross-validation (every scopefuel-recommended profile
must be spawnable here).
  -h, --help   show this usage
USAGE
}

profiles_cmd() {
  if [[ $# -gt 0 ]]; then
    if [[ "$1" == "-h" || "$1" == "--help" ]]; then
      [[ $# -eq 1 ]] || die "unexpected argument '$2'"
      profiles_help
      return 0
    fi
    die "unexpected argument '$1'"
  fi
  printf '%s\n' "${ALL_PROFILES[@]}"
}

usage() {
  cat <<'USAGE'
Usage: wrk <spawn|done|escalate|joined|find|name-sync|profiles|hosts> [options]

  wrk spawn -c CWD -m MODEL -p PROMPT_FILE -w WORKSPACE -l LABEL --t T0..T3
            [-L live|mock] [--effort LEVEL] [--job ID] [--report PATH] [--job-dup-ok] [--landing-strict]
  wrk done JOB [--report PATH]
  wrk escalate JOB --question TEXT
  wrk joined JOB --pr URL --head SHA --report PATH
  wrk find <name-or-label> [--pane-only]
  wrk name-sync [--apply|<label>...]
  wrk profiles

Run 'wrk <command> --help' for command-specific usage.
USAGE
}

spawn_help() {
  cat <<'USAGE'
Usage: wrk spawn -c CWD -m MODEL -p PROMPT_FILE -w WORKSPACE -l LABEL --t T0..T3
                 [-L live|mock] [--effort LEVEL] [--job ID] [--owner NAME] [--report PATH] [--job-dup-ok]
                 [--landing-strict] [--role captain --lane CAPTAIN_LANE --parent PARENT_LANE] [--host auto|local|NAME]

Options:
  -c CWD, -m MODEL, -p PROMPT_FILE, -w WORKSPACE, -l LABEL
  --t T0..T3         job scale; required — an unclassified job is not spawned
  -L live|mock       select lane; mock requires MOCK_MCP_PROFILE
  --effort LEVEL     override codex/Kiro/Grok/Claude(opus,sonnet) profile effort
  --job ID           arbiter job id (default: LABEL)
  --owner NAME       spawning session name, recorded as the arbiter owner_lane
                     (default: default). Lets that session later run
                     `arbiter status --lane NAME` to find and reclaim its workers.
  --role worker|captain
                     captain requires --lane and --parent, and accepts only
                     captain-opus or captain-sol profiles.
  --lane NAME        captain's own lane; recorded as the claim owner_lane.
                     (The execution lane remains -L live|mock.)
  --parent NAME      parent lane for a captain; completion/escalation events
                     are routed to this lane.
  --report PATH      report acceptance-criterion path watched by the completion sentinel
  --job-dup-ok       explicit operator override: permit an active duplicate job
                     after an auditable warning. Automation/panewire must not use it.
  --landing-strict   automation opt-in: preserve the OK line, then exit 76 if
                     no marker/Pasted-text landing evidence appears. Without it,
                     landed=no remains a successful spawn with a warning.
  -h, --help         show this usage

Admission control (ROB-1199): after the scopefuel quota gate passes, wrk claims
the job and records its quota-pool execution in arbiter. arbiter resolves the
pool from scopefuel's own output — wrk holds no pool mapping. A quota-pool
claim/record or preparation failure is warned and does not deny the spawn; a
failed spawn releases a successfully created record. The scopefuel gate remains
fail-closed, while exclusive arbiter leases retain their own fail-closed rules.

Canonical codex profiles: codex-terra, codex-luna, codex-sol.
Existing codex aliases remain valid: codex, codex-med, codex-luna-hi,
codex-luna-max, codex-max, codex-terra-max.
Claude effort wiring (ROB-1191/ROB-1193): opus default=xhigh, sonnet/sonnet-med default=high,
haiku default=low; all support an explicit --effort override.
Captain profiles: captain-opus = Claude Opus at effort high; captain-sol = codex-sol.
Kimi profiles: kimi-k3 uses `kimi --auto -m kimi-for-coding/k3`; kimi-k27 uses
`kimi --auto -m kimi-for-coding/kimi-for-coding`; the CLI has no --effort option.
kimi-k3-low uses the same argv as kimi-k3 but injects KIMI_CODE_HOME pointing at
the low-thinking-effort clone home from `bin/kimi-clone-home` ([thinking]
effort="low" in that clone's config.toml — kimi has no CLI --effort flag, so this
is the only way to change its thinking effort). Refresh the clone with
`bin/kimi-clone-home` any time the real ~/.kimi-code credentials rotate.
fable does not accept --effort in this scope.
Retired TUI agy profiles are rejected. Emergency headless backup:
  agy -p "$(cat PROMPT_FILE)"
USAGE
}

find_help() {
  cat <<'USAGE'
Usage: wrk find <name-or-label> [--pane-only]

Name is matched exactly first. If absent, the exact tab label is used.
Candidates include pane_id and the last five screen lines.
  --pane-only  print pane_id only when exactly one candidate matches
  -h, --help   show this usage
USAGE
}

name_sync_help() {
  cat <<'USAGE'
Usage: wrk name-sync [--apply|<label>...]

No arguments preview safe matches. --apply applies all safe matches.
Labels apply only the named labels; numeric/short labels stay guarded.
USAGE
}

die() { echo "wrk: $*" >&2; exit 2; }
warn() { echo "wrk: warning: $*" >&2; }
sleep_for() { [[ -n "${WRK_NO_SLEEP:-}" ]] || sleep "$1"; }

# Landing is a bounded positive-evidence observation, not a second boot wait.
# The prompt command already owns its normal wait when supported. A 30-second
# window covers the normal hand-off; codex gets 60 seconds because its cold
# boot is explicitly allowed to settle for 20 seconds above and may still take
# tens of seconds before the submitted transcript is readable. Sampling backs
# off from 0.5 to 2 seconds and stops immediately on evidence.
LANDING_CHECK_DEFAULT_WINDOW_SECONDS=30
LANDING_CHECK_CODEX_WINDOW_SECONDS=60
LANDING_CHECK_INITIAL_DELAY_SECONDS=0.5
LANDING_CHECK_SECOND_DELAY_SECONDS=1
LANDING_CHECK_MAX_DELAY_SECONDS=2

configure_landing_check() {
  local profile_kind="$1"
  LANDING_CHECK_WINDOW_SECONDS="$LANDING_CHECK_DEFAULT_WINDOW_SECONDS"
  # 18 samples: 0.5 + 1 + (14 * 2) + 0.5 = 30 seconds.
  LANDING_CHECK_TIMEOUT_TICKS=18
  if [[ "$profile_kind" == codex ]]; then
    LANDING_CHECK_WINDOW_SECONDS="$LANDING_CHECK_CODEX_WINDOW_SECONDS"
    # 33 samples: 0.5 + 1 + (29 * 2) + 0.5 = 60 seconds.
    LANDING_CHECK_TIMEOUT_TICKS=33
  fi
}

landing_check_delay() {
  local tick="$1"
  if (( tick == 0 || tick == LANDING_CHECK_TIMEOUT_TICKS - 2 )); then
    printf '%s' "$LANDING_CHECK_INITIAL_DELAY_SECONDS"
  elif (( tick == 1 )); then
    printf '%s' "$LANDING_CHECK_SECOND_DELAY_SECONDS"
  else
    printf '%s' "$LANDING_CHECK_MAX_DELAY_SECONDS"
  fi
}

landing_check_detail() {
  printf 'window=%ss checks=%s last_evidence=%s last_status=%s reason=%s' \
    "$LANDING_CHECK_WINDOW_SECONDS" "$LANDING_CHECK_ATTEMPTS" \
    "$LANDING_CHECK_LAST_EVIDENCE" "$LANDING_CHECK_LAST_STATUS" \
    "$LANDING_CHECK_LAST_REASON"
}

prompt_marker() {
  local prompt_file="$1" line
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "${line//[[:space:]]/}" ]] || continue
    printf '%s' "${line:0:40}"
    return 0
  done <"$prompt_file"
  return 0
}

agent_status_for_pane() {
  local pane="$1"
  "$HERDR" agent list 2>/dev/null |
    python3 -c 'import json,sys; p=sys.argv[1]; a=json.load(sys.stdin)["result"]["agents"]; print(next((x.get("agent_status","unknown") for x in a if x.get("pane_id")==p),"unknown"))' "$pane" \
    2>/dev/null
}

landing_check_once() {
  local pane="$1" marker="$2" recent visible status
  LANDING_CHECK_LAST_EVIDENCE=none
  if ! recent="$("$HERDR" agent read "$pane" --source recent-unwrapped --lines 200 2>/dev/null)"; then
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_STATUS=unknown
    LANDING_CHECK_LAST_REASON="recent-unwrapped-read-failed"
    return 1
  fi

  # The prompt transcript is the source of truth. Unlike the 40-line visible
  # screen, recent-unwrapped survives subsequent output scrolling the marker
  # away. `working` below is deliberately not evidence: a cold codex boot
  # reports working before the composer has received the payload.
  if [[ -n "$marker" ]] && grep -Fq -- "$marker" <<<"$recent"; then
    LANDING_CHECK_LAST_EVIDENCE=marker
    LANDING_CHECK_LAST_REASON="marker-in-recent-unwrapped"
    return 0
  fi
  if ! visible="$("$HERDR" agent read "$pane" --source visible --lines 40 2>/dev/null)"; then
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_STATUS=unknown
    LANDING_CHECK_LAST_REASON="visible-read-failed"
    return 1
  fi

  # The UI chip is an independent positive observation that the payload is
  # queued; keep it as the fallback for prompts whose transcript is delayed.
  if grep -Fq -- "Pasted text" <<<"$visible"; then
    LANDING_CHECK_LAST_EVIDENCE=pasted
    LANDING_CHECK_LAST_REASON=pasted-text-chip
    return 0
  fi
  if ! status="$(agent_status_for_pane "$pane")"; then
    LANDING_CHECK_AMBIGUOUS=1
    LANDING_CHECK_LAST_STATUS=unknown
    LANDING_CHECK_LAST_REASON="status-read-failed"
    return 1
  fi
  LANDING_CHECK_LAST_STATUS="$status"
  if [[ "$status" == working ]]; then
    LANDING_CHECK_LAST_REASON=working-without-positive-evidence
  else
    LANDING_CHECK_LAST_REASON="status-${status}-without-positive-evidence"
  fi
  return 1
}

landing_check() {
  local pane="$1" marker="$2" tick delay
  LANDING_CHECK_CONFIRMED=0
  LANDING_CHECK_AMBIGUOUS=0
  LANDING_CHECK_ATTEMPTS=0
  LANDING_CHECK_LAST_EVIDENCE=none
  LANDING_CHECK_LAST_STATUS=unknown
  LANDING_CHECK_LAST_REASON=not-observed
  for ((tick=0; tick<LANDING_CHECK_TIMEOUT_TICKS; tick++)); do
    LANDING_CHECK_ATTEMPTS=$((tick + 1))
    if landing_check_once "$pane" "$marker"; then return 0; fi
    [[ "$LANDING_CHECK_AMBIGUOUS" -eq 0 ]] && LANDING_CHECK_CONFIRMED=1
    if [[ "$tick" -lt $((LANDING_CHECK_TIMEOUT_TICKS - 1)) ]]; then
      delay="$(landing_check_delay "$tick")"
      sleep_for "$delay"
    fi
  done
  return 1
}

# Kimi opens a folder-trust modal for an unregistered CWD. Seed only the
# workspace-trust entry it needs, before the agent starts. This is deliberately
# fail-open: trust seeding is a convenience and must never deny a Kimi spawn.
kimi_seed_workspace_trust() {
  local cwd="$1" kimi_home="$2" abs_cwd basename_path digest trust_dir trust_file trust_json

  if ! abs_cwd="$(cd -- "$cwd" 2>/dev/null && pwd -P)"; then
    warn "Kimi workspace trust seed skipped: cannot resolve absolute CWD: $cwd"
    return 0
  fi
  basename_path="${abs_cwd##*/}"
  # ROB-1307: kimi(0.37.2 실측 2건으로 역공학)는 trust 파일명을
  # wd_<sanitized>_<sha256(abs)[:12]> 로 조회하며, sanitized = basename 소문자화
  # → 앞 40자 절단 → 꼬리의 비영숫자 제거(절단이 '-' 등 구분자에서 끊긴 경우).
  # 원형 basename 으로 시딩하면 대문자/40자 초과 이름에서 미신뢰 판정 → Trust
  # 다이얼로그(기본 Don't trust=종료)가 브리프 주입 Enter 에 눌려 스폰이 죽는다.
  # (미지 문자 처리 규칙은 미관측 — worktree 이름은 [A-Za-z0-9._-] 라 이 범위로 충분)
  basename_path="$(printf '%s' "$basename_path" | tr '[:upper:]' '[:lower:]')"
  basename_path="${basename_path:0:40}"
  while [[ -n "$basename_path" && ! "${basename_path: -1}" =~ [a-z0-9] ]]; do
    basename_path="${basename_path%?}"
  done
  if ! digest="$(printf '%s' "$abs_cwd" | shasum -a 256 2>/dev/null | awk '{print $1}')" || [[ ${#digest} -lt 12 ]]; then
    warn "Kimi workspace trust seed skipped: cannot hash absolute CWD: $abs_cwd"
    return 0
  fi

  trust_dir="$kimi_home/workspace-trust"
  trust_file="$trust_dir/wd_${basename_path}_${digest:0:12}"
  if [[ -e "$trust_file" ]]; then
    echo "wrk: Kimi workspace trust exists: $trust_file" >&2
    return 0
  fi
  if ! mkdir -p -- "$trust_dir" 2>/dev/null; then
    warn "Kimi workspace trust seed skipped: cannot create $trust_dir"
    return 0
  fi
  if ! trust_json="$(python3 - "$abs_cwd" <<'PY'
import json
import sys
import time

print(json.dumps({"root": sys.argv[1], "trustedAt": int(time.time() * 1000)}, separators=(",", ":")))
PY
)"; then
    warn "Kimi workspace trust seed skipped: cannot encode $trust_file"
    return 0
  fi

  # noclobber keeps an existing entry immutable even if another spawn races
  # between the existence check and this write.
  if ! (umask 077; set -C; printf '%s\n' "$trust_json" >"$trust_file") 2>/dev/null; then
    if [[ -e "$trust_file" ]]; then
      echo "wrk: Kimi workspace trust exists: $trust_file" >&2
    else
      warn "Kimi workspace trust seed skipped: cannot write $trust_file"
    fi
    return 0
  fi
  echo "wrk: Kimi workspace trust seeded: $trust_file" >&2
}

# Pre-spawn advisory: if -c points at a *canonical* checkout (not a linked worktree)
# that is off its remote default branch, warn. Does not fail the spawn — operators
# sometimes work on canonical on purpose. Worktrees and non-git paths stay silent.
# Default branch is never hard-coded: origin/HEAD; if unresolved, skip (false positives
# would drown real warnings).
warn_if_canonical_off_default() {
  local path="$1"
  [[ -n "$path" && -d "$path" ]] || return 0

  local git_dir common_dir
  # path-format=absolute: relative .git vs absolute common-dir would false-positive.
  if ! git_dir="$(git -C "$path" rev-parse --path-format=absolute --git-dir 2>/dev/null)"; then
    return 0
  fi
  if ! common_dir="$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
    return 0
  fi
  # Linked worktree: git-dir is .../.git/worktrees/<name>, common-dir is the main .git.
  # Canonical main checkout: both resolve to the same directory.
  [[ "$git_dir" == "$common_dir" ]] || return 0

  local origin_head default_branch current_branch
  if ! origin_head="$(git -C "$path" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null)"; then
    return 0
  fi
  default_branch="${origin_head#refs/remotes/origin/}"
  [[ -n "$default_branch" && "$default_branch" != "$origin_head" ]] || return 0

  current_branch="$(git -C "$path" branch --show-current 2>/dev/null || true)"
  # Detached HEAD or empty name: treat as off-default so the operator sees it.
  if [[ -n "$current_branch" && "$current_branch" == "$default_branch" ]]; then
    return 0
  fi

  local shown="${current_branch:-DETACHED}"
  warn "canonical checkout is not on default branch: path=$path current=$shown default=$default_branch — recover: git -C $(printf '%q' "$path") switch $(printf '%q' "$default_branch")"
}

quota_gate() {
  GATE_OUTPUT=""
  GATE_READY=0
  if [[ -z "$SCOPEFUEL" ]]; then
    SCOPEFUEL="$(command -v scopefuel 2>/dev/null || true)"
  fi
  if [[ -z "$SCOPEFUEL" || ! -e "$SCOPEFUEL" ]]; then
    warn "scopefuel unavailable; quota gate skipped during installation transition"
    return 0
  fi
  if [[ ! -x "$SCOPEFUEL" ]]; then
    echo "wrk: scopefuel exists but is not executable: $SCOPEFUEL" >&2
    return 126
  fi
  local probe probe_rc
  set +e
  probe="$("$SCOPEFUEL" gate --help 2>&1)"
  probe_rc=$?
  set -e
  if [[ "$probe_rc" -ne 0 ]]; then
    if grep -Eiq "(unknown (command|subcommand).*gate|invalid choice.*gate|no such command.*gate|unrecognized.*gate|not a valid command.*gate)" <<<"$probe"; then
      warn "installed scopefuel has no gate subcommand; quota gate skipped during installation transition"
      return 0
    fi
    [[ -z "$probe" ]] || printf '%s\n' "$probe" >&2
    return "$probe_rc"
  fi
  # stdout is captured (not swallowed) so arbiter can read the pool that scopefuel
  # itself resolved for this profile. It is re-printed verbatim; stderr is untouched.
  local out rc
  set +e
  out="$("$SCOPEFUEL" gate -m "$GATE_PROFILE")"
  rc=$?
  set -e
  [[ -z "$out" ]] || printf '%s\n' "$out"
  case "$rc" in
    0) GATE_OUTPUT="$out"; GATE_READY=1; return 0 ;;
    3|4) exit "$rc" ;;
    *) echo "wrk: scopefuel gate failed (exit $rc)" >&2; return "$rc" ;;
  esac
}

# ROB-1199: admission control. The quota gate answers "how much is left"; arbiter
# answers "who holds it". fail-closed everywhere except a genuinely absent tool.
# ROB-1214: a failed spawn must not leave its tab behind. Every retry used to
# stack another dead tab in the workspace (measured 2026-08-05: 11 shell-only
# panes in w16, krb0-v alone retried into 3 tabs) — invisible to agent-list
# based sweeps because the agent process is gone. Armed after tab create,
# disarmed at the success line alongside ARBITER_HELD=0.
spawn_pane_cleanup() {
  [[ "${SPAWN_PANE_OPEN:-0}" -eq 1 && -n "${PANE:-}" ]] || return 0
  SPAWN_PANE_OPEN=0
  "$HERDR" pane close "$PANE" >/dev/null 2>&1     && echo "wrk: closed leftover pane $PANE after spawn failure" >&2     || echo "wrk: failed to close leftover pane $PANE — close it manually" >&2
}

arbiter_release_held() {
  [[ "${ARBITER_HELD:-0}" -eq 1 ]] || return 0
  ARBITER_HELD=0
  local rc
  set +e
  "$ARBITER" release --job "$JOB_ID" --resource "$ARBITER_RESOURCE" --kind quota_pool >/dev/null 2>&1
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    echo "wrk: arbiter quota-pool record release failed (exit $rc): $ARBITER_RESOURCE job=$JOB_ID" >&2
  else
    echo "wrk: arbiter quota-pool record released after spawn failure: $ARBITER_RESOURCE job=$JOB_ID" >&2
  fi
}

arbiter_get_duplicate_state() {
  # Query the durable receipt surface rather than parsing localized stderr from
  # claim.  The parser rejects malformed/non-string fields, because accepting
  # an ambiguous state would recreate the exact-once failure we are fixing.
  local lookup lookup_rc parsed parse_rc lookup_job lookup_state lookup_owner lookup_created
  set +e
  lookup="$("$ARBITER" job-get --job "$JOB_ID" --json 2>/dev/null)"
  lookup_rc=$?
  set -e
  [[ "$lookup_rc" -eq 0 ]] || return 1
  set +e
  parsed="$(printf '%s' "$lookup" | python3 -c '
import json, sys
d = json.load(sys.stdin)
keys = ("job_id", "state", "owner_lane", "created_at")
values = []
for key in keys:
    value = d.get(key)
    if not isinstance(value, str) or not value or "\t" in value or "\n" in value:
        raise ValueError("invalid job-get field: " + key)
    values.append(value)
print("\t".join(values))
')"
  parse_rc=$?
  set -e
  [[ "$parse_rc" -eq 0 ]] || return 1
  IFS=$'\t' read -r lookup_job lookup_state lookup_owner lookup_created <<<"$parsed"
  [[ "$lookup_job" == "$JOB_ID" && -n "$lookup_state" && -n "$lookup_owner" && -n "$lookup_created" ]] || return 1
  ARBITER_DUP_STATE="$lookup_state"
  ARBITER_DUP_OWNER_LANE="$lookup_owner"
  ARBITER_DUP_CREATED_AT="$lookup_created"
  return 0
}

arbiter_handle_duplicate_claim() {
  # $1 is set only for the one state re-check allowed after a reclaim race.
  # A second released observation is not a license to spin/retry indefinitely.
  local after_reclaim_race="${1:-0}" reclaim_rc
  if ! arbiter_get_duplicate_state; then
    warn "arbiter duplicate job state lookup failed; refusing spawn (fail-closed): job_id=$JOB_ID"
    return "$WRK_EXIT_JOB_STATE_UNREADABLE"
  fi
  case "$ARBITER_DUP_STATE" in
    claimed|leased)
      if [[ "${JOB_DUP_OK:-0}" -eq 1 ]]; then
        warn "active arbiter job duplicate proceeding only because --job-dup-ok override was supplied: job_id=$JOB_ID state=$ARBITER_DUP_STATE owner_lane=$ARBITER_DUP_OWNER_LANE created_at=$ARBITER_DUP_CREATED_AT"
        # The row belongs to this exact job id already, so a later successful
        # spawn receipt can still be written even if its quota record is old.
        ARBITER_JOB_REGISTERED=1
        return 0
      fi
      warn "active arbiter job duplicate refused (fail-closed): job_id=$JOB_ID state=$ARBITER_DUP_STATE owner_lane=$ARBITER_DUP_OWNER_LANE created_at=$ARBITER_DUP_CREATED_AT"
      return "$WRK_EXIT_ACTIVE_JOB_DUPLICATE"
      ;;
    released)
      if [[ "$after_reclaim_race" -eq 1 ]]; then
        warn "arbiter duplicate job changed during released reclaim; refusing spawn (fail-closed): job_id=$JOB_ID state=$ARBITER_DUP_STATE owner_lane=$ARBITER_DUP_OWNER_LANE created_at=$ARBITER_DUP_CREATED_AT"
        return "$WRK_EXIT_JOB_STATE_UNREADABLE"
      fi
      set +e
      "$ARBITER" claim --reclaim-released --job "$JOB_ID" --agent-label "$LABEL" --lane "$JOB_LANE" --t "$JOB_T" "${ARBITER_CLAIM_ROLE_ARGS[@]}" >/dev/null
      reclaim_rc=$?
      set -e
      case "$reclaim_rc" in
        0)
          ARBITER_JOB_REGISTERED=1
          warn "arbiter released job reclaimed: job_id=$JOB_ID owner_lane=$JOB_LANE"
          return 0
          ;;
        4)
          # Another recovery caller may have won between our read and update.
          # Re-observe once; it will fail-closed unless an explicit override is
          # present for the now-active owner.
          arbiter_handle_duplicate_claim 1
          return $?
          ;;
        *)
          warn "arbiter released job reclaim failed (exit $reclaim_rc); refusing spawn (fail-closed): job_id=$JOB_ID"
          return "$WRK_EXIT_JOB_STATE_UNREADABLE"
          ;;
      esac
      ;;
    *)
      warn "arbiter duplicate job has unsupported state; refusing spawn (fail-closed): job_id=$JOB_ID state=$ARBITER_DUP_STATE owner_lane=$ARBITER_DUP_OWNER_LANE created_at=$ARBITER_DUP_CREATED_AT"
      return "$WRK_EXIT_JOB_STATE_UNREADABLE"
      ;;
  esac
}

arbiter_record_spawn_receipt() {
  # A pane cannot be rolled back once its agent start/prompt succeeded.  This
  # evidence write is therefore deliberately warning-only; job-get renders its
  # absence explicitly for downstream recovery rather than pretending success.
  [[ "${ARBITER_JOB_REGISTERED:-0}" -eq 1 ]] || return 0
  local payload receipt_rc
  if ! payload="$(python3 - "$PANE" "$LABEL" "$MODEL" "$WS" <<'PY'
import json, sys
pane_id, label, profile, workspace = sys.argv[1:]
print(json.dumps({
    "pane_id": pane_id,
    "label": label,
    "profile": profile,
    "workspace": workspace,
}, ensure_ascii=False, separators=(",", ":")))
PY
)"; then
    warn "arbiter job.spawned receipt preparation failed; spawn remains successful: job_id=$JOB_ID pane_id=$PANE"
    return 0
  fi
  set +e
  "$ARBITER" event --job "$JOB_ID" --kind job.spawned --payload-json "$payload" >/dev/null
  receipt_rc=$?
  set -e
  if [[ "$receipt_rc" -ne 0 ]]; then
    warn "arbiter job.spawned receipt failed (exit $receipt_rc); spawn remains successful: job_id=$JOB_ID pane_id=$PANE"
  fi
}

arbiter_admit() {
  if [[ -z "$ARBITER" ]]; then
    ARBITER="$(command -v arbiter 2>/dev/null || true)"
  fi
  if [[ -z "$ARBITER" || ! -e "$ARBITER" ]]; then
    warn "arbiter unavailable; admission control skipped during installation transition"
    return 0
  fi
  if [[ ! -x "$ARBITER" ]]; then
    warn "arbiter quota-pool record unavailable (not executable: $ARBITER); continuing spawn"
    return 0
  fi
  local probe probe_rc job_get_probe job_get_probe_rc
  set +e
  probe="$("$ARBITER" lease --help 2>&1)"
  probe_rc=$?
  set -e
  if [[ "$probe_rc" -ne 0 ]]; then
    if grep -Eiq "(unknown (command|subcommand).*lease|invalid choice.*lease|no such command.*lease|unrecognized.*lease|not a valid command.*lease)" <<<"$probe"; then
      warn "installed arbiter has no lease subcommand; admission control skipped during installation transition"
      return 0
    fi
    warn "arbiter quota-pool record probe failed (exit $probe_rc); continuing spawn"
    return 0
  fi
  # An arbiter predating the durable lookup is an installation-transition
  # version. Preserve the existing warn+continue contract rather than treating
  # it as a current arbiter that reported an uninspectable duplicate.
  set +e
  job_get_probe="$("$ARBITER" job-get --help 2>&1)"
  job_get_probe_rc=$?
  set -e
  if [[ "$job_get_probe_rc" -ne 0 ]]; then
    if grep -Eiq "(unknown (command|subcommand).*job-get|invalid choice.*job-get|no such command.*job-get|unrecognized.*job-get|not a valid command.*job-get)" <<<"$job_get_probe"; then
      warn "installed arbiter has no job-get subcommand; admission control skipped during installation transition"
      return 0
    fi
    # Keep the pre-existing no-duplicate path observational, but do not skip
    # claim: if this live arbiter subsequently reports a duplicate, the actual
    # lookup failure below must remain fail-closed.
    warn "arbiter job-get probe failed (exit $job_get_probe_rc); duplicate state will fail-closed if observed"
  fi
  if [[ "$GATE_READY" -ne 1 ]]; then
    # No scopefuel result means no authoritative pool. Leasing a guessed pool would
    # be worse than not leasing — the same installation-transition exception applies.
    warn "scopefuel gate did not run; arbiter quota-pool record skipped during installation transition"
    return 0
  fi

  local claim_rc duplicate_rc
  set +e
  "$ARBITER" claim --job "$JOB_ID" --agent-label "$LABEL" --lane "$JOB_LANE" --t "$JOB_T" "${ARBITER_CLAIM_ROLE_ARGS[@]}" >/dev/null
  claim_rc=$?
  set -e
  case "$claim_rc" in
    0) ARBITER_JOB_REGISTERED=1 ;;
    4)
      set +e
      arbiter_handle_duplicate_claim
      duplicate_rc=$?
      set -e
      [[ "$duplicate_rc" -eq 0 ]] || return "$duplicate_rc"
      ;;
    *) warn "arbiter quota-pool claim failed (exit $claim_rc); continuing spawn"; return 0 ;;
  esac

  local gate_file gate_rc record_json record_rc parsed rc
  set +e
  gate_file="$(mktemp)"
  gate_rc=$?
  set -e
  if [[ "$gate_rc" -ne 0 || -z "$gate_file" ]]; then
    warn "arbiter quota-pool record preparation failed (temporary file); continuing spawn"
    return 0
  fi
  if ! printf '%s\n' "$GATE_OUTPUT" >"$gate_file"; then
    rm -f "$gate_file" || true
    warn "arbiter quota-pool record preparation failed (gate output); continuing spawn"
    return 0
  fi
  set +e
  # ROB-1213: --profile stays the gate-normalized name — arbiter cross-checks it
  # against the gate output (fail-closed, keep). The *actual* launch goes in
  # --launch-profile: GATE_PROFILE collapses effort variants (codex-luna|-hi|-max
  # all gate as codex-luna-max), and recording only that made the ledger lie —
  # 2026-08-04: T3 jobs ran gpt-5.6-luna at *medium* (B, 42) while every record
  # claimed codex-luna-max (A+, 59). Only `ps` told the truth; finished jobs
  # became unauditable.
  local launch_profile="$MODEL${EFFECTIVE_EFFORT:+@$EFFECTIVE_EFFORT}"
  record_json="$(SCOPEFUEL_BIN="$SCOPEFUEL" "$ARBITER" lease --job "$JOB_ID" --kind quota_pool \
    --profile "$GATE_PROFILE" --launch-profile "$launch_profile" --gate-output "$gate_file" --json)"
  record_rc=$?
  set -e
  rm -f "$gate_file" || true
  if [[ "$record_rc" -ne 0 ]]; then
    warn "arbiter quota-pool record failed (exit $record_rc); continuing spawn"
    return 0
  fi
  set +e
  parsed="$(printf '%s' "$record_json" |
    python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["pool"]); print(d["profile"]); print(d["started_at"])')"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    warn "arbiter quota-pool record output unreadable; continuing spawn"
    return 0
  fi
  {
    IFS= read -r ARBITER_RESOURCE
    IFS= read -r ARBITER_PROFILE
    IFS= read -r ARBITER_STARTED_AT
  } <<<"$parsed"
  if [[ -z "$ARBITER_RESOURCE" || -z "$ARBITER_PROFILE" || -z "$ARBITER_STARTED_AT" ]]; then
    warn "arbiter quota-pool record returned incomplete fields; continuing spawn"
    return 0
  fi
  ARBITER_HELD=1
  trap 'spawn_pane_cleanup; arbiter_release_held' EXIT
  echo "wrk: arbiter quota-pool record pool=$ARBITER_RESOURCE profile=$ARBITER_PROFILE job=$JOB_ID" >&2
}

# ROB-1227: a successful spawn is a quota-use event. The pool is already
# authoritative in arbiter's record, or in the scopefuel gate output when
# arbiter is unavailable; wrk deliberately owns no provider mapping.
refresh_quota_pool() {
  local pool="${ARBITER_RESOURCE:-}"
  if [[ -z "$pool" && "${GATE_READY:-0}" -eq 1 ]]; then
    pool="${GATE_OUTPUT#* pool=}"
    pool="${pool%% *}"
  fi
  if [[ -z "$pool" ]]; then
    warn "scopefuel refresh skipped; gate/arbiter did not provide a pool"
    return 0
  fi
  if [[ -z "${SCOPEFUEL:-}" || ! -x "$SCOPEFUEL" ]]; then
    warn "scopefuel refresh skipped; executable unavailable"
    return 0
  fi

  # The CLI's --background contract is itself non-blocking. Start a tiny
  # supervisor detached from wrk; it owns both the refresh child and timeout
  # cleanup in one dedicated process group. Its stderr stays attached so a
  # refresh failure/timeout is user-visible while spawn remains fail-open.
  (
    python3 - "$SCOPEFUEL" "$pool" "${WRK_REFRESH_TIMEOUT_S:-5}" <<'PY'
import os
import signal
import subprocess
import sys
import time


if os.fork():
    os._exit(0)
os.setsid()
scopefuel, pool, timeout_arg = sys.argv[1:]
try:
    timeout = max(0.01, float(timeout_arg))
except ValueError:
    timeout = 5.0

proc = subprocess.Popen(
    [scopefuel, "refresh", pool, "--background"],
    stdin=subprocess.DEVNULL,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
    close_fds=True,
)
try:
    refresh_rc = proc.wait(timeout=timeout)
except subprocess.TimeoutExpired:
    print(
        f"wrk: warning: scopefuel refresh timed out for pool={pool}; spawn already succeeded",
        file=sys.stderr,
        flush=True,
    )
    pgid = os.getpgrp()
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    os.killpg(pgid, signal.SIGTERM)
    time.sleep(0.2)
    os.killpg(pgid, signal.SIGKILL)
    os._exit(124)

if refresh_rc != 0:
    print(
        f"wrk: warning: scopefuel refresh failed for pool={pool}; spawn already succeeded",
        file=sys.stderr,
    )
PY
  ) </dev/null >/dev/null &
}

resolve_profile() {
  PROFILE_KIND=""
  PROFILE_MODEL=""
  DEFAULT_EFFORT=""
  EFFORT_SUPPORTED=0
  ARGS=()
  PROFILE_ENV=()
  KIMI_TRUST_HOME=""
  PROFILE_MODEL_ARG=""

  case "$MODEL" in
    # ROB-1191 ⑥: opus/sonnet only — CLI --effort argv (never mutate settings.json).
    # Defaults align with scopefuel Profile.benchmark_effort (opus=xhigh, sonnet=high).
    opus) PROFILE_KIND=claude; DEFAULT_EFFORT=xhigh; EFFORT_SUPPORTED=1; ARGS=(--model opus --dangerously-skip-permissions) ;;
    captain-opus) PROFILE_KIND=claude; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1; ARGS=(--model opus --dangerously-skip-permissions) ;;
    sonnet|sonnet-med) PROFILE_KIND=claude; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1; ARGS=(--model sonnet --dangerously-skip-permissions) ;;
    haiku) PROFILE_KIND=claude; DEFAULT_EFFORT=low; EFFORT_SUPPORTED=1; ARGS=(--model haiku --dangerously-skip-permissions) ;;
    fable) PROFILE_KIND=claude; ARGS=(--model claude-fable-5 --dangerously-skip-permissions) ;;

    # cc-qwen38/cc-glm/cc-dsflash/cc-dspro/cc-glm53: Claude Code CLI harness,
    # model traffic redirected via env to CLIProxyAPI(127.0.0.1:8317) -> ClinePass.
    # See CLINEPASS_GATE_* comment above for the wiring rationale (ROB-1252/ROB-1253).
    #
    # 실험 지정 별칭 — reps 축적 전까지 급표 미등재. cc-dspro=V4-Pro 0813(TB 87.9·AA int max 53.2,
    # 단 TB 는 벤더 자체보고), cc-glm53=GLM-5.3(TB 88.2 벤더 자체보고, GLM-5.2 베이스 상방 후보).
    # cc-dsflash=oc-dsflash 의 하네스 A/B 짝.
    cc-qwen38|cc-glm|cc-dsflash|cc-dspro|cc-glm53)
      PROFILE_KIND=claude; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1
      [[ -r "$CLINEPASS_GATE_KEY_FILE" ]] || die "clinepass gate key file not found/readable: $CLINEPASS_GATE_KEY_FILE"
      CLINEPASS_GATE_KEY="$(<"$CLINEPASS_GATE_KEY_FILE")"
      CLINEPASS_GATE_KEY="${CLINEPASS_GATE_KEY//$'\n'/}"
      [[ -n "$CLINEPASS_GATE_KEY" ]] || die "clinepass gate key file is empty: $CLINEPASS_GATE_KEY_FILE"
      ARGS=(--model "$MODEL" --dangerously-skip-permissions)
      # Claude Code 는 이 별칭들을 모르는 모델로 보고 컨텍스트 창을 200k 로 가정한다
      # (경고: "not a model this version of Claude Code recognizes"). 1M 짜리 모델이면
      # 200k 에서 auto-compact 가 돌아 창의 80% 를 버린다.
      #
      # 🔴 값은 **프로필별**로 둔다 — 일괄 1M 금지(ROB-1254 정정). 근거 등급이 다르다:
      #   - models.dev 에 **cline-pass 전용 항목**이 있는 3종만 확정값을 준다:
      #     cline-pass/{deepseek-v4-flash,deepseek-v4-pro,glm-5.2} = 1,000,000.
      #   - qwen3.8-max·glm-5.3 은 cline-pass 항목이 **없다**. 타 제공자 값은 서로 어긋나고
      #     (alibaba 1,000,000 / nano-gpt·aihubmix 991,000 / digitalocean 262,144),
      #     ClinePass 는 qwen 을 자체 배포본 `private/qwen3p8-max-wave` 로 서빙하므로
      #     원 제공자의 창이 그대로일 보장이 없다 → **미설정(Claude Code 기본 200k)**.
      # 🔴 비대칭: 과소가정은 조기 compact 뿐이지만 **과대가정은 작업 중 API 에러**다.
      # 해제 조건: models.dev 에 cline-pass 항목이 생기거나 실측 이분탐색으로 하한 확인.
      # (2026-08-15 초과 프로브로 확인된 별개 한도: `private/*-wave` 배포본은 요청 본문
      #  **6,291,456 바이트** 상한, max_tokens 상한은 5종 모두 131,072.)
      CC_CONTEXT_TOKENS=""
      case "$MODEL" in
        cc-dsflash|cc-dspro|cc-glm) CC_CONTEXT_TOKENS=1000000 ;;
      esac
      PROFILE_ENV=(
        --env "ANTHROPIC_BASE_URL=$CLINEPASS_GATE_URL"
        --env "ANTHROPIC_AUTH_TOKEN=$CLINEPASS_GATE_KEY"
      )
      if [[ -n "$CC_CONTEXT_TOKENS" ]]; then
        PROFILE_ENV+=(--env "CLAUDE_CODE_MAX_CONTEXT_TOKENS=$CC_CONTEXT_TOKENS")
      fi
      ;;

    codex-terra|codex-med) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-terra; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    codex-terra-max) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-terra; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    codex-luna) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-luna; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    codex-luna-hi) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-luna; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    codex-luna-max) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-luna; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    codex) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-sol; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    codex-sol) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-sol; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    codex-max) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-sol; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    captain-sol) PROFILE_KIND=codex; PROFILE_MODEL=gpt-5.6-sol; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;

    kiro) PROFILE_KIND=kiro; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    kiro-opus) PROFILE_KIND=kiro; PROFILE_MODEL=claude-opus-5; DEFAULT_EFFORT=xhigh; EFFORT_SUPPORTED=1 ;;
    kiro-sonnet) PROFILE_KIND=kiro; PROFILE_MODEL=claude-sonnet-5; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    kiro-sol) PROFILE_KIND=kiro; PROFILE_MODEL=gpt-5.6-sol; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    kiro-luna) PROFILE_KIND=kiro; PROFILE_MODEL=gpt-5.6-luna; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    kiro-cheap) PROFILE_KIND=kiro; PROFILE_MODEL=qwen3-coder-next; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    kiro-glm) PROFILE_KIND=kiro; PROFILE_MODEL=glm-5; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    kiro-deepseek) PROFILE_KIND=kiro; PROFILE_MODEL=deepseek-v3.2; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    kiro-minimax) PROFILE_KIND=kiro; PROFILE_MODEL=minimax-m2.5; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    kiro-minimax21) PROFILE_KIND=kiro; PROFILE_MODEL=minimax-m2.1; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    kiro-haiku) PROFILE_KIND=kiro; PROFILE_MODEL=claude-haiku-4.5; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    kiro-opus-xhigh) PROFILE_KIND=kiro; PROFILE_MODEL=claude-opus-5; DEFAULT_EFFORT=xhigh; EFFORT_SUPPORTED=1 ;;
    kiro-opus-max) PROFILE_KIND=kiro; PROFILE_MODEL=claude-opus-5; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    kiro-sol-xhigh) PROFILE_KIND=kiro; PROFILE_MODEL=gpt-5.6-sol; DEFAULT_EFFORT=xhigh; EFFORT_SUPPORTED=1 ;;
    kiro-sol-max) PROFILE_KIND=kiro; PROFILE_MODEL=gpt-5.6-sol; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;

    # EFFORT_SUPPORTED=0 for every kimi-* profile: the kimi CLI takes no --effort
    # argv. Thinking effort is config-file-only ([thinking] effort in config.toml,
    # see bin/kimi-clone-home) — do not confuse this with the codex/Kiro/Claude
    # CLI --effort wiring above (ROB-1213 covered those; kimi is a different path).
    kimi-k3) PROFILE_KIND=kimi; KIMI_TRUST_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"; EFFORT_SUPPORTED=0; ARGS=(--auto -m kimi-for-coding/k3) ;;
    kimi-k27) PROFILE_KIND=kimi; KIMI_TRUST_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"; EFFORT_SUPPORTED=0; ARGS=(--auto -m kimi-for-coding/kimi-for-coding) ;;
    # kimi-k3-low: same model argv as kimi-k3 — the differentiator is KIMI_CODE_HOME
    # (below), pointed at the low-thinking-effort clone home, not the CLI model arg.
    kimi-k3-low)
      PROFILE_KIND=kimi; KIMI_TRUST_HOME="$KIMI_CODE_LOW_HOME"; EFFORT_SUPPORTED=0; ARGS=(--auto -m kimi-for-coding/k3)
      PROFILE_ENV=(--env "KIMI_CODE_HOME=$KIMI_CODE_LOW_HOME") ;;

    oc-kimi-code) PROFILE_KIND=opencode; ARGS=(--auto --model cline-pass/cline-pass/kimi-k2.7-code) ;;
    oc-glm) PROFILE_KIND=opencode; ARGS=(--auto --model cline-pass/cline-pass/glm-5.2) ;;
    oc-kimi-k3) PROFILE_KIND=opencode; ARGS=(--auto --model cline-pass/cline-pass/kimi-k3) ;;
    oc-dsflash) PROFILE_KIND=opencode; ARGS=(--auto --model cline-pass/cline-pass/deepseek-v4-flash) ;;
    oc-gflash) PROFILE_KIND=opencode; ARGS=(--auto --model cliproxy/gemini-3.6-flash-high) ;;
    oc-sonnet46) PROFILE_KIND=opencode; ARGS=(--auto --model cliproxy/claude-sonnet-4-6) ;;
    oc-oss) PROFILE_KIND=opencode; ARGS=(--auto --model cliproxy/gpt-oss-120b-medium) ;;
    oc-omni) PROFILE_KIND=opencode; ARGS=(--auto --model omniroute/auto/coding) ;;
    # ox-alpha(ROB-1313/1314)는 2026-08-27 무료 프로모 종료와 함께 양 인그레스가 소멸
    # (OpenRouter 목록 제거·Zen 에러 실측). 정체 = GLM-5.3-Flash(Zhipu, 08-26 공개).
    # 별칭은 죽은 pane 양산을 막기 위해 제거 — reps(oc-ox/oc-oxz)는 GLM-5.3-Flash 실적으로
    # 잔존하며, 정식 서빙(ClinePass 등)이 생기면 새 이름으로 재배선한다. 상세=메모리 ox-alpha-lane.
    oc-qwen37-max) PROFILE_KIND=opencode; ARGS=(--auto --model cline-pass/cline-pass/qwen3.7-max) ;;
    oc-minimax-m3) PROFILE_KIND=opencode; ARGS=(--auto --model cline-pass/cline-pass/minimax-m3) ;;

    grok|grok-hi) PROFILE_KIND=grok; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    grok-med) PROFILE_KIND=grok; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    # ROB-1244: 성능 비교(무결점 동률 + 벤치 우세 + 하네스 무이상) 후 기본을 4.6 으로 전환.
    # grok45* 는 즉시 롤백용 명시 별칭, grok46* 는 기본과 동의어로 유지(기존 브리프 호환).
    grok45) PROFILE_KIND=grok; PROFILE_MODEL_ARG=grok-4.5; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    grok45-med) PROFILE_KIND=grok; PROFILE_MODEL_ARG=grok-4.5; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;
    grok46) PROFILE_KIND=grok; PROFILE_MODEL_ARG=grok-4.6; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    grok46-med) PROFILE_KIND=grok; PROFILE_MODEL_ARG=grok-4.6; DEFAULT_EFFORT=medium; EFFORT_SUPPORTED=1 ;;

    # ROB-1222: agy-flash는 은퇴 목록에서 제외 — agy 네이티브로 실행.
    # 멘리: effort는 모델명에 인코딩(-high). --dangerously-skip-permissions 필수.
    # ROB-1251: AA v1.3 실측 57(opencode)로 A+ 배치 완료 — 기본을 3.7로 전환.
    # agy-flash36은 즉시 롤백용 명시 별칭, agy-flash37은 동의어로 유지(이미 3.7).
    agy-flash) PROFILE_KIND=agy; ARGS=(--model gemini-3.7-flash-high --dangerously-skip-permissions) ;;
    agy-flash36) PROFILE_KIND=agy; ARGS=(--model gemini-3.6-flash-high --dangerously-skip-permissions) ;;
    agy-flash37) PROFILE_KIND=agy; ARGS=(--model gemini-3.7-flash-high --dangerously-skip-permissions) ;;

    agy|agy-flash-med|agy-pro|agy-sonnet|agy-opus|agy-oss)
      die "profile '$MODEL' is retired" ;;
    *) die "unknown model profile '$MODEL'; see 'wrk spawn --help'" ;;
  esac

  # GATE_PROFILE is only scopefuel's accepted profile spelling. Pool/class/
  # usage policy remains solely in scopefuel; runtime MODEL and effort stay
  # exactly as requested.
  case "$MODEL" in
    opus|captain-opus) GATE_PROFILE=opus ;;
    sonnet|sonnet-med) GATE_PROFILE=sonnet ;;
    haiku) GATE_PROFILE=haiku ;;
    fable) GATE_PROFILE=fable ;;
    codex|codex-sol|codex-max|captain-sol) GATE_PROFILE=codex-max ;;
    codex-terra|codex-med|codex-terra-max) GATE_PROFILE=codex-terra-max ;;
    codex-luna|codex-luna-hi|codex-luna-max) GATE_PROFILE=codex-luna-max ;;
    kiro-opus|kiro-opus-xhigh|kiro-opus-max) GATE_PROFILE=kiro-opus ;;
    kiro-sonnet) GATE_PROFILE=kiro-sonnet ;;
    kiro-cheap) GATE_PROFILE=kiro-cheap ;;
    kiro-haiku) GATE_PROFILE=kiro-haiku ;;
    kiro|kiro-sol|kiro-luna|kiro-glm|kiro-deepseek|kiro-minimax|kiro-minimax21|kiro-sol-xhigh|kiro-sol-max)
      GATE_PROFILE=kiro-sol ;;
    kimi-k3|kimi-k27|kimi-k3-low) GATE_PROFILE="$MODEL" ;;
    oc-kimi-code|oc-glm|oc-kimi-k3|oc-dsflash|oc-gflash|oc-sonnet46|oc-oss|oc-omni|oc-qwen37-max|oc-minimax-m3)
      GATE_PROFILE="$MODEL" ;;
    agy-flash|agy-flash36|agy-flash37) GATE_PROFILE="agy-flash" ;;
    grok|grok-hi|grok-med|grok45|grok45-med|grok46|grok46-med) GATE_PROFILE=grok-hi ;;
    # ROB-1252 / ROB-1253: clinepass 쿼타 풀로 귀속 — PROFILE_KIND=claude(구독 OAuth) 풀과
    # 완전 분리해야 admission/쿼타 집계가 섞이지 않는다.
    # 실험 지정 별칭(cc-dsflash/cc-dspro/cc-glm53)은 reps 축적 전까지 급표 미등재이므로
    # 동일 clinepass 풀의 대표 프로필(cc-qwen38)로 게이트 매핑.
    cc-qwen38|cc-glm) GATE_PROFILE="$MODEL" ;;
    cc-dsflash|cc-dspro|cc-glm53) GATE_PROFILE="cc-qwen38" ;;
  esac

  if [[ -n "$EFFORT" ]]; then
    case "$EFFORT" in low|medium|high|xhigh|max|ultra) ;; *) die "unknown effort '$EFFORT'" ;; esac
    [[ "$PROFILE_KIND" != kiro || "$EFFORT" != ultra ]] || die "Kiro does not support --effort ultra"
    [[ "$EFFORT_SUPPORTED" -eq 1 ]] || die "--effort is unsupported for profile '$MODEL'"
    EFFECTIVE_EFFORT="$EFFORT"
  else
    EFFECTIVE_EFFORT="$DEFAULT_EFFORT"
  fi

  case "$PROFILE_KIND" in
    codex) ARGS=(--yolo -m "$PROFILE_MODEL" -c "model_reasoning_effort=$EFFECTIVE_EFFORT") ;;
    kiro)
      ARGS=(chat --v3 --trust-all-tools --require-mcp-startup)
      [[ -z "$PROFILE_MODEL" ]] || ARGS+=(--model "$PROFILE_MODEL")
      ARGS+=(--effort "$EFFECTIVE_EFFORT")
      ;;
    grok) ARGS=(--always-approve -m "${PROFILE_MODEL_ARG:-grok-4.6}" --effort "$EFFECTIVE_EFFORT") ;;
    claude)
      # Append only for effort-capable Claude profiles (opus/sonnet). fable stays bare.
      if [[ "$EFFORT_SUPPORTED" -eq 1 && -n "$EFFECTIVE_EFFORT" ]]; then
        ARGS+=(--effort "$EFFECTIVE_EFFORT")
      fi
      ;;
  esac
}

completion_event() {
  local job="$1" owner="$2" label="$3" pane="$4" report="$5" kind="${6:-job.completed}"
  local events host last
  events="$(wrk_jobs_root)/$job/events"
  host="${HOSTNAME:-unknown}"
  mkdir -p "$events"
  if [[ -n "$report" && -f "$report" ]]; then
    last="$(tail -n 1 "$report" 2>/dev/null | tr '\r\n' ' ' | cut -c1-240)"
  else
    last=""
  fi
  python3 - "$events" "$job" "$owner" "$label" "$pane" "$host" "$report" "$last" "$kind" <<'PY'
import json, os, sys, tempfile, time
events, job, owner, label, pane, host, report, last, kind = sys.argv[1:]
highest = 0
for name in os.listdir(events):
    try: highest = max(highest, int(name.split('-', 1)[0]))
    except (ValueError, IndexError): pass
record = {"kind": kind, "job_id": job, "owner_lane": owner, "label": label,
          "pane_id": pane, "host": host, "report_path": report,
          "report_last_line": last, "epoch": 1}
fd, temporary = tempfile.mkstemp(prefix='.completion-', dir=events)
try:
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        json.dump(record, f, separators=(',', ':'))
        f.write('\n')
    os.chmod(temporary, 0o600)
    os.replace(temporary, os.path.join(events, f'{highest + 1:05d}-{kind}.json'))
finally:
    if os.path.exists(temporary): os.unlink(temporary)
PY
}

# Keep this exactly aligned with arbiter.inbox_root(): ARBITER_INBOX_ROOT is
# the jobs directory, rather than its parent.
wrk_jobs_root() {
  printf '%s\n' "${ARBITER_INBOX_ROOT:-$HOME/work/herdr-inbox/jobs}"
}

completion_metadata() {
  local job="$1"
  python3 - "$(wrk_jobs_root)/$job/events" <<'PY'
import json, os, sys
owner=label=pane=parent=role=''
try: names=sorted(os.listdir(sys.argv[1]))
except OSError: raise SystemExit(1)
for name in names:
    try: o=json.load(open(os.path.join(sys.argv[1],name), encoding='utf-8'))
    except (OSError,json.JSONDecodeError): continue
    p=o.get('payload',o)
    # Claim/reclaim establishes ownership.  Keep the newest one: a released
    # job can be reclaimed by a different captain and parent.
    if o.get('kind') in ('job.claim', 'job.reclaim'):
        owner=p.get('owner_lane') if isinstance(p.get('owner_lane'), str) else ''
        candidate=p.get('label', p.get('agent_label'))
        label=candidate if isinstance(candidate, str) else ''
        parent=p.get('parent_lane') if isinstance(p.get('parent_lane'), str) else ''
        role=p.get('role') if isinstance(p.get('role'), str) else ''
    pane=p.get('pane_id') if isinstance(p.get('pane_id'), str) else pane
if owner and label and pane: print(owner, label, pane, parent, role, sep='\t')
else: raise SystemExit(1)
PY
}

# Python is already a hard dependency for durable event creation above. Use it
# for report discovery and identity so this works on both GNU and BSD userlands
# (find -printf and stat -c are GNU-only). The identity includes nanosecond
# mtime and size, so an updated report at the same path is a new observation.
find_latest_report() {
  local directory="$1"
  python3 - "$directory" <<'PY'
import glob, os, sys
paths = []
try:
    for path in glob.glob(os.path.join(sys.argv[1], "report*.md")):
        if os.path.isfile(path):
            paths.append(path)
except OSError:
    pass
if paths:
    print(max(paths, key=os.path.getmtime))
PY
}

report_observation_key() {
  local report="$1"
  python3 - "$report" <<'PY'
import os, sys
try:
    info = os.stat(sys.argv[1])
except OSError:
    raise SystemExit(1)
print(f"{info.st_dev}:{info.st_ino}:{info.st_mtime_ns}:{info.st_size}")
PY
}

done_cmd() {
  local job="${1:-}" report=""
  [[ -n "$job" && "$job" != -* ]] || die "done requires a job id"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --report) [[ $# -ge 2 && -n "$2" ]] || die "--report requires a path"; report="$2"; shift 2 ;;
      *) die "unknown done option '$1'" ;;
    esac
  done
  local metadata owner label pane jobs_root
  metadata="$(completion_metadata "$job")" || die "done cannot find job.claim/job.spawned metadata: $job"
  IFS=$'\t' read -r owner label pane <<<"$metadata"
  jobs_root="$(wrk_jobs_root)"
  if [[ -z "$report" ]]; then
    report="$(find_latest_report "$jobs_root/$job")"
  fi
  [[ -n "$report" && -f "$report" ]] || die "done requires an existing --report or report*.md in the job directory"
  completion_event "$job" "$owner" "$label" "$pane" "$report"
  echo "OK job=$job report=$report"
}

captain_flat_event() {
  local job="$1" owner="$2" label="$3" pane="$4" parent="$5" kind="$6" report="$7" reason="$8" question="$9" pr="${10}" head="${11}"
  local events host="${HOSTNAME:-unknown}" last
  events="$(wrk_jobs_root)/$job/events"
  mkdir -p "$events"
  if [[ -n "$report" && -f "$report" ]]; then
    last="$(tail -n 1 "$report" 2>/dev/null | tr '\r\n' ' ' | cut -c1-240)"
  else
    last=""
  fi
  python3 - "$events" "$job" "$owner" "$label" "$pane" "$parent" "$host" "$report" "$last" "$kind" "$reason" "$question" "$pr" "$head" <<'PY'
import json, os, sys, tempfile
events, job, owner, label, pane, parent, host, report, last, kind, reason, question, pr, head = sys.argv[1:]
highest = 0
for name in os.listdir(events):
    try: highest = max(highest, int(name.split('-', 1)[0]))
    except (ValueError, IndexError): pass
record = {"kind": kind, "job_id": job, "owner_lane": owner, "label": label,
          "pane_id": pane, "host": host, "report_path": report,
          "report_last_line": last, "reason": reason, "parent_lane": parent, "epoch": 1}
if question: record["question"] = question
if pr: record["pr"] = pr
if head: record["head"] = head
fd, temporary = tempfile.mkstemp(prefix='.completion-', dir=events)
try:
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        json.dump(record, f, separators=(',', ':'))
        f.write('\n')
    os.chmod(temporary, 0o600)
    os.replace(temporary, os.path.join(events, f'{highest + 1:05d}-{kind}.json'))
finally:
    if os.path.exists(temporary): os.unlink(temporary)
PY
}

captain_metadata() {
  local job="$1" metadata owner label pane parent role
  metadata="$(completion_metadata "$job")" || die "cannot find job.claim/job.spawned metadata: $job"
  IFS=$'\t' read -r owner label pane parent role <<<"$metadata"
  [[ "$role" == captain && -n "$parent" ]] || die "$job is not a captain claim with a parent lane"
  # owner_lane is the captain's own lane. parent_lane is informational only;
  # panewire resolves the parent relationship from lanes.json.
  printf '%s\t%s\t%s\t%s\n' "$owner" "$label" "$pane" "$parent"
}

escalate_cmd() {
  local job="${1:-}" question="" metadata owner label pane parent
  [[ -n "$job" && "$job" != -* ]] || die "escalate requires a job id"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --question) [[ $# -ge 2 && -n "$2" ]] || die "--question requires text"; question="$2"; shift 2 ;;
      *) die "unknown escalate option '$1'" ;;
    esac
  done
  [[ -n "$question" ]] || die "escalate requires --question"
  metadata="$(captain_metadata "$job")"
  IFS=$'\t' read -r owner label pane parent <<<"$metadata"
  captain_flat_event "$job" "$owner" "$label" "$pane" "$parent" job.escalate "" "captain escalation" "$question" "" ""
  echo "OK job=$job owner_lane=$owner kind=job.escalate"
}

joined_cmd() {
  local job="${1:-}" pr="" head="" report="" metadata owner label pane parent
  [[ -n "$job" && "$job" != -* ]] || die "joined requires a job id"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pr) [[ $# -ge 2 && -n "$2" ]] || die "--pr requires a URL"; pr="$2"; shift 2 ;;
      --head) [[ $# -ge 2 && -n "$2" ]] || die "--head requires a SHA"; head="$2"; shift 2 ;;
      --report) [[ $# -ge 2 && -n "$2" ]] || die "--report requires a path"; report="$2"; shift 2 ;;
      *) die "unknown joined option '$1'" ;;
    esac
  done
  [[ -n "$pr" && -n "$head" && -n "$report" && -f "$report" ]] || die "joined requires --pr, --head and an existing --report"
  metadata="$(captain_metadata "$job")"
  IFS=$'\t' read -r owner label pane parent <<<"$metadata"
  captain_flat_event "$job" "$owner" "$label" "$pane" "$parent" job.joined "$report" "captain joined PR" "" "$pr" "$head"
  echo "OK job=$job owner_lane=$owner kind=job.joined pr=$pr head=$head report=$report"
}

sentinel_cmd() {
  local job="${1:-}" owner="${2:-}" label="${3:-}" pane="${4:-}" report="${5:-}" resource="${6:-}" timeout="${WRK_COMPLETION_TIMEOUT_S:-21600}"
  [[ -n "$job" && -n "$owner" && -n "$label" && -n "$pane" ]] || exit 2
  local started seen
  started="$(date +%s)"
  seen=""
  while :; do
    local now status candidate key
    now="$(date +%s)"
    if (( now - started >= timeout )); then
      completion_event "$job" "$owner" "$label" "$pane" "${report:-/dev/null}" job.lost
      exit 0
    fi
    status="$($HERDR agent get "$pane" 2>/dev/null | python3 -c 'import json,sys; o=json.load(sys.stdin); print(o.get("result",o).get("agent_status", ""))' 2>/dev/null || true)"
    if [[ -z "$status" ]]; then
      completion_event "$job" "$owner" "$label" "$pane" "${report:-/dev/null}" job.lost
      exit 0
    fi
    candidate="$report"
    if [[ -z "$candidate" || ! -f "$candidate" ]]; then
      candidate="$(find_latest_report "$(wrk_jobs_root)/$job")"
    fi
    key="$(report_observation_key "$candidate" 2>/dev/null || true)"
    if [[ ( "$status" == "done" || "$status" == "idle" ) && -f "$candidate" && -n "$key" && "$key" != "$seen" ]]; then
      completion_event "$job" "$owner" "$label" "$pane" "$candidate"
      seen="$key"
      [[ -z "$resource" || ! -x "$ARBITER" ]] || "$ARBITER" release --job "$job" --resource "$resource" --kind quota_pool >/dev/null 2>&1 || true
    fi
    sleep "${WRK_COMPLETION_INTERVAL_S:-30}"
  done
}

start_completion_sentinel() {
  local pidfile="$1"; shift
  mkdir -p "$(dirname "$pidfile")"
  local existing=""
  if [[ -s "$pidfile" ]]; then
    read -r existing <"$pidfile" || existing=""
    if [[ "$existing" =~ ^[0-9]+$ ]] && kill -0 "$existing" 2>/dev/null; then
      return 0
    fi
  fi
  rm -f "$pidfile"
  ( nohup "$0" sentinel "$@" >>"${pidfile%.pid}.log" 2>&1 & echo $! >"$pidfile" )
}

# Spill-over placement is intentionally implemented outside spawn_cmd(): once a
# remote host is selected, its own wrk instance owns quota admission, pane
# creation, and landing verification. Keeping that boundary avoids duplicating
# the scopefuel/arbiter protocol across machines.
spillover_config() {
  printf '%s' "${WRK_HOSTS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/wrk/hosts.toml}"
}

spillover_trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

# This deliberately supports the small, documented hosts.toml surface rather
# than pretending to be a general TOML interpreter. Unknown keys remain future
# compatible and quoted values keep paths/SSH aliases free of shell evaluation.
spillover_value() {
  local section="$1" key="$2" config line current="" value=""
  config="$(spillover_config)"
  [[ -r "$config" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(spillover_trim "$line")"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" =~ ^\[([^]]+)\]$ ]]; then
      current="${BASH_REMATCH[1]}"
      continue
    fi
    [[ "$current" == "$section" && "$line" =~ ^${key}[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
    value="${BASH_REMATCH[1]}"
    value="${value%%#*}"
    value="$(spillover_trim "$value")"
    if [[ "$value" == \"*\" && "$value" == *\" ]]; then value="${value:1:${#value}-2}"; fi
    printf '%s' "$value"
    return 0
  done <"$config"
  return 1
}

spillover_hosts() {
  local config line
  config="$(spillover_config)"
  [[ -r "$config" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(spillover_trim "$line")"
    if [[ "$line" =~ ^\[hosts\.([A-Za-z0-9_-]+)\]$ ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
    fi
  done <"$config"
}

spillover_cwd_map() {
  local host="$1" cwd="$2" raw mapped
  raw="$(spillover_value "hosts.$host" cwd_map 2>/dev/null || true)"
  [[ -n "$raw" ]] || return 1
  mapped="$(python3 - "$cwd" "$raw" <<'PY'
import re, sys
cwd, raw = sys.argv[1:]
for local, remote in re.findall(r'"([^"\\]*(?:\\.[^"\\]*)*)"\s*=\s*"([^"\\]*(?:\\.[^"\\]*)*)"', raw):
    if local.replace(r'\\"', '"').replace(r'\\\\', '\\') == cwd:
        print(remote.replace(r'\\"', '"').replace(r'\\\\', '\\'))
        break
PY
)"
  [[ -n "$mapped" ]] || return 1
  printf '%s' "$mapped"
}

spillover_load5() {
  local proc="${WRK_PROC_LOADAVG:-/proc/loadavg}" load
  if [[ -r "$proc" ]]; then
    awk '{print $2}' "$proc"
    return 0
  fi
  if command -v sysctl >/dev/null 2>&1; then
    load="$(sysctl -n vm.loadavg 2>/dev/null || true)"
    awk '{gsub(/[{}]/, ""); print $2}' <<<"$load"
    return 0
  fi
  return 1
}

spillover_ncpu() {
  if [[ -n "${WRK_TEST_NCPU:-}" ]]; then printf '%s' "$WRK_TEST_NCPU"; return 0; fi
  if [[ -r /proc/cpuinfo ]]; then
    getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || true
  else
    sysctl -n hw.ncpu 2>/dev/null || true
  fi
}

spillover_active_workers() {
  local output
  if ! output="$("$HERDR" agent list 2>/dev/null)"; then return 1; fi
  python3 -c 'import json,sys; d=json.load(sys.stdin); a=d.get("result",d).get("agents",[]); print(sum(x.get("agent_status")=="working" for x in a))' <<<"$output" 2>/dev/null
}

spillover_throttled() {
  local therm limit
  if [[ -n "${WRK_TEST_THROTTLED:-}" ]]; then
    [[ "$WRK_TEST_THROTTLED" == 1 ]]
    return
  fi
  command -v pmset >/dev/null 2>&1 || return 1
  therm="$(pmset -g therm 2>/dev/null || true)"
  limit="$(sed -nE 's/.*CPU_Speed_Limit[[:space:]]*=[[:space:]]*([0-9]+).*/\1/p' <<<"$therm" | head -1)"
  [[ "$limit" =~ ^[0-9]+$ && "$limit" -lt 100 ]]
}

spillover_local_measure() {
  SPILL_LOAD="$(spillover_load5 2>/dev/null || true)"
  SPILL_NCPU="$(spillover_ncpu 2>/dev/null || true)"
  SPILL_ACTIVE="$(spillover_active_workers 2>/dev/null || true)"
  SPILL_RATIO="unknown"
  if [[ "$SPILL_LOAD" =~ ^[0-9]+([.][0-9]+)?$ && "$SPILL_NCPU" =~ ^[1-9][0-9]*$ ]]; then
    SPILL_RATIO="$(awk -v l="$SPILL_LOAD" -v n="$SPILL_NCPU" 'BEGIN { printf "%.3f", l/n }')"
  fi
}

spillover_local_is_pressured() {
  local max_ratio max_active
  spillover_local_measure
  SPILL_REASON="local-healthy"
  max_ratio="$(spillover_value local max_load_ratio 2>/dev/null || true)"
  max_active="$(spillover_value local max_active 2>/dev/null || true)"
  if [[ "$max_ratio" =~ ^[0-9]+([.][0-9]+)?$ && "$SPILL_RATIO" != unknown ]] &&
    awk -v actual="$SPILL_RATIO" -v max="$max_ratio" 'BEGIN { exit !(actual >= max) }'; then
    SPILL_REASON="load-ratio=${SPILL_RATIO}>=${max_ratio}"
    return 0
  fi
  if [[ "$max_active" =~ ^[0-9]+$ && "$SPILL_ACTIVE" =~ ^[0-9]+$ && "$SPILL_ACTIVE" -ge "$max_active" ]]; then
    SPILL_REASON="active=${SPILL_ACTIVE}>=${max_active}"
    return 0
  fi
  if spillover_throttled; then
    SPILL_REASON="cpu-throttled"
    return 0
  fi
  return 1
}

spillover_log() {
  local host="$1" reason="$2" log
  log="${WRK_SPILLOVER_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/wrk/spillover.log}"
  mkdir -p "$(dirname "$log")" 2>/dev/null || { warn "spill-over log directory unavailable: $log"; return 0; }
  printf '%s source=%s load5=%s ncpu=%s ratio=%s active=%s host=%s reason=%s\n' \
    "$(date -Iseconds)" "${SPILL_DECISION_SOURCE:-unknown}" "${SPILL_LOAD:-unknown}" "${SPILL_NCPU:-unknown}" \
    "${SPILL_RATIO:-unknown}" "${SPILL_ACTIVE:-unknown}" "$host" "$reason" >>"$log" 2>/dev/null ||
    warn "spill-over log unavailable: $log"
}

# The hub owns placement policy. This adapter is deliberately narrow because
# its contract lives with panewire: wrk consumes only decision/candidates/reason
# from `panewire place`, then performs the selected spawn. No URL, token, IP,
# or machine name is embedded in this public CLI.
spillover_hub_placement() {
  local reply parsed panewire hub_url token_env cf_env args
  SPILL_HUB_STATUS=unavailable
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"
  token_env="$(spillover_value hub hub_token_env 2>/dev/null || true)"
  cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  [[ -n "$hub_url" && -n "$token_env" ]] || return 1
  panewire="${PANEWIRE_BIN:-panewire}"
  args=(place --class worker --cwd "$1" --hub-url "$hub_url" --hub-token-env "$token_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  if ! reply="$("$panewire" "${args[@]}" 2>/dev/null)"; then
    return 1
  fi
  if ! parsed="$(python3 -c '
import json, sys
d = json.load(sys.stdin)
decision = d.get("decision")
reason = d.get("reason", "")
decision_host = decision if isinstance(decision, str) else (
    decision.get("machine") or decision.get("host") or decision.get("target") or ""
    if isinstance(decision, dict) else "")
if isinstance(decision, dict): reason = decision.get("reason", reason)
eligible = []
for candidate in d.get("candidates", []):
    if isinstance(candidate, str):
        value, candidate_reason, connected = candidate, "", True
    elif isinstance(candidate, dict):
        # PlacementCandidate canonical key is machine.  host/target remain
        # accepted only for backward-compatible hub fixtures/responses.
        value = candidate.get("machine") or candidate.get("host") or candidate.get("target") or ""
        candidate_reason = candidate.get("reason", "")
        connected = candidate.get("connected", True)
    else:
        continue
    if not isinstance(value, str) or not value or connected is False or "not_accepting" in str(candidate_reason):
        continue
    if value not in eligible: eligible.append(value)
if isinstance(decision_host, str) and decision_host and decision_host in eligible:
    eligible.remove(decision_host)
    eligible.insert(0, decision_host)
print(eligible[0] if eligible else "")
print(str(reason).replace("\n", " "))
print(*eligible[1:], sep="\n")
' <<<"$reply")"; then
    SPILL_HUB_STATUS=invalid
    return 1
  fi
  {
    IFS= read -r SPILL_HUB_HOST
    IFS= read -r SPILL_HUB_REASON || true
  } <<<"$parsed"
  SPILL_HUB_CANDIDATES=()
  while IFS= read -r candidate; do [[ -z "$candidate" ]] || SPILL_HUB_CANDIDATES+=("$candidate"); done < <(tail -n +3 <<<"$parsed")
  # Fixture-only observability: lets the contract test assert the exact hub
  # ordering after eligibility filtering without contacting a live hub.
  if [[ -n "${WRK_SPILLOVER_CANDIDATES_LOG:-}" ]]; then
    printf '%s\n' "$SPILL_HUB_HOST" "${SPILL_HUB_CANDIDATES[@]}" >"$WRK_SPILLOVER_CANDIDATES_LOG"
  fi
  SPILL_HUB_STATUS=ok
  return 0
}

spillover_probe_host() {
  local host="$1" ssh_name output capacity load
  ssh_name="$(spillover_value "hosts.$host" ssh 2>/dev/null || true)"
  [[ -n "$ssh_name" ]] || ssh_name="$host"
  if ! output="$("${WRK_SSH_BIN:-ssh}" -o BatchMode=yes "$ssh_name" 'uptime; herdr agent list' 2>/dev/null)"; then
    SPILL_PROBE_REASON="ssh-unreachable"
    return 1
  fi
  SPILL_REMOTE_LOAD="$(sed -nE 's/.*load averages?:[[:space:]]*([0-9.]+).*/\1/p' <<<"$output" | head -1)"
  SPILL_REMOTE_ACTIVE="$(python3 -c 'import json,re,sys; s=sys.stdin.read(); m=re.search(r"\{.*\}",s,re.S); d=json.loads(m.group(0)); a=d.get("result",d).get("agents",[]); print(sum(x.get("agent_status")=="working" for x in a))' <<<"$output" 2>/dev/null || true)"
  capacity="$(spillover_value "hosts.$host" capacity 2>/dev/null || true)"
  [[ "$capacity" =~ ^[1-9][0-9]*$ ]] || capacity=1
  if [[ "$SPILL_REMOTE_ACTIVE" =~ ^[0-9]+$ && "$SPILL_REMOTE_ACTIVE" -lt "$capacity" ]]; then
    SPILL_PROBE_REASON="remote-active=${SPILL_REMOTE_ACTIVE}<${capacity}"
    return 0
  fi
  SPILL_PROBE_REASON="remote-full active=${SPILL_REMOTE_ACTIVE:-unknown} capacity=${capacity} load5=${SPILL_REMOTE_LOAD:-unknown}"
  return 1
}

spillover_wake() {
  local host="$1" wake hold panewire hub_url token_env cf_env args
  wake="$(spillover_value "hosts.$host" wake 2>/dev/null || true)"
  [[ "$wake" == panewire ]] || return 0
  hub_url="$(spillover_value hub hub_url 2>/dev/null || true)"; token_env="$(spillover_value hub hub_token_env 2>/dev/null || true)"; cf_env="$(spillover_value hub hub_cf_env 2>/dev/null || true)"
  [[ -n "$hub_url" && -n "$token_env" ]] || { warn "spill-over wake skipped host=$host: hub config is unset"; return 0; }
  hold="${WRK_WAKE_HOLD_MINUTES:-10}"
  [[ "$hold" =~ ^[1-9][0-9]*$ ]] || { warn "spill-over wake skipped host=$host: invalid hold"; return 0; }
  panewire="${PANEWIRE_BIN:-panewire}"
  args=(burst request --target "$host" --hold "${hold}m" --reason "wrk spill-over remote unavailable" --hub-url "$hub_url" --hub-token-env "$token_env")
  [[ -z "$cf_env" ]] || args+=(--hub-cf-env "$cf_env")
  if ! "$panewire" "${args[@]}" >/dev/null 2>&1; then
    warn "spill-over wake skipped host=$host: panewire request failed"
  fi
}

spillover_emit_host() {
  local host="$1" file="$2"
  awk -v host="$host" '/^OK pane=/ { sub(/ host=[^ ]+/, ""); sub(/^OK pane=[^ ]+/, "& host=" host) } { print }' "$file"
}

spillover_remote_spawn() {
  local host="$1" cwd="$2" prompt="$3"; shift 3
  local ssh_name session remote_prompt remote_cwd workspace remote_cmd rc out
  ssh_name="$(spillover_value "hosts.$host" ssh 2>/dev/null || true)"; [[ -n "$ssh_name" ]] || ssh_name="$host"
  session="$(spillover_value "hosts.$host" herdr_session 2>/dev/null || true)"; [[ -n "$session" ]] || session=worker
  workspace="$(spillover_value "hosts.$host" workspace 2>/dev/null || true)"; [[ -n "$workspace" ]] || workspace=worker
  if ! remote_cwd="$(spillover_cwd_map "$host" "$cwd")"; then
    echo "wrk: remote host '$host' has no cwd_map entry for '$cwd'; use --host local or configure hosts.toml" >&2
    return 2
  fi
  # shellcheck disable=SC2016 # ${TMPDIR} must expand on the selected remote host.
  if ! remote_prompt="$("${WRK_SSH_BIN:-ssh}" -o BatchMode=yes "$ssh_name" 'umask 077; mktemp "${TMPDIR:-/tmp}/wrk-spillover.XXXXXX.md"' 2>/dev/null)"; then
    echo "wrk: remote host '$host' is unreachable; use --host local or retry after it is available" >&2
    return 1
  fi
  if ! "${WRK_SCP_BIN:-scp}" "$prompt" "$ssh_name:$remote_prompt"; then
    echo "wrk: failed to copy brief to remote host '$host'" >&2
    return 1
  fi
  local remote_args=(env "HERDR_SESSION=$session" wrk spawn -c "$remote_cwd" -p "$remote_prompt" --host local)
  local arg saw_workspace=0 i=0 args=("$@")
  while [[ "$i" -lt "${#args[@]}" ]]; do
    arg="${args[$i]}"
    case "$arg" in
      -c|-p|--host)
        # The remote path and copied brief above are authoritative.  Removing
        # both their values prevents a duplicate option from overriding them.
        ((i+=1))
        ;;
      -w)
        ((i+=1))
        [[ "$i" -lt "${#args[@]}" ]] || die "-w requires a value"
        remote_args+=(-w "${args[$i]}")
        saw_workspace=1
        ;;
      *) remote_args+=("$arg") ;;
    esac
    ((i+=1))
  done
  # The normal argument loop preserves an explicit -w; remote defaults come
  # from hosts.toml when callers omit it.
  if [[ "$saw_workspace" -eq 0 ]]; then remote_args+=(-w "$workspace"); fi
  printf -v remote_cmd '%q ' "${remote_args[@]}"
  out="$(mktemp)"
  set +e
  "${WRK_SSH_BIN:-ssh}" -o BatchMode=yes "$ssh_name" "$remote_cmd; rc=\$?; rm -f -- $(printf '%q' "$remote_prompt"); exit \$rc" >"$out"
  rc=$?
  set -e
  spillover_emit_host "$host" "$out"
  rm -f "$out"
  return "$rc"
}

spawn_router_cmd() {
  local requested=auto cwd="" prompt="" selected="" arg next=0 out rc host
  for arg in "$@"; do
    if [[ "$next" -eq 1 ]]; then cwd="$arg"; next=0; continue; fi
    if [[ "$next" -eq 2 ]]; then prompt="$arg"; next=0; continue; fi
    case "$arg" in
      -c) next=1 ;; -p) next=2 ;;
    esac
  done
  local filtered=() i=0 args=("$@")
  while [[ "$i" -lt "${#args[@]}" ]]; do
    arg="${args[$i]}"
    if [[ "$arg" == --host ]]; then
      ((i+=1)); [[ "$i" -lt "${#args[@]}" ]] || die "--host requires a value"
      requested="${args[$i]}"
    else
      filtered+=("$arg")
    fi
    ((i+=1))
  done
  # Classification is an admission invariant, not placement work. Preserve the
  # existing fail-closed boundary before asking hub/local telemetry anything.
  local has_t=0 t_value=""
  for ((i=0; i<${#filtered[@]}; i++)); do
    if [[ "${filtered[$i]}" == --t ]]; then
      has_t=1
      t_value="${filtered[$((i + 1))]:-}"
      break
    fi
  done
  if [[ "$has_t" -eq 0 || ! "$t_value" =~ ^T[0-3]$ ]]; then
    spawn_cmd "${filtered[@]}"
    return $?
  fi
  case "$requested" in
    local)
      spillover_local_measure; selected=local; SPILL_REASON=forced-local; SPILL_DECISION_SOURCE=forced
      ;;
    auto)
      if spillover_hub_placement "$cwd"; then
        SPILL_DECISION_SOURCE=hub
        selected="$SPILL_HUB_HOST"
        SPILL_REASON="${SPILL_HUB_REASON:-hub-decision}"
        # A valid placement reply may deliberately contain no eligible
        # candidates (for example every machine is disconnected or
        # not_accepting).  That is safe to fail open only to this local spawn.
        if [[ -z "$selected" ]]; then
          selected=local
          SPILL_REASON="${SPILL_REASON};no-eligible-candidates"
        fi
        [[ "$selected" == local ]] || grep -qx "$selected" <<<"$(spillover_hosts)" || {
          spillover_log none "hub-unconfigured-host=${selected};${SPILL_REASON}"
          echo "wrk: hub selected unconfigured host '$selected'; configure hosts.toml or use --host local" >&2
          return 2
        }
      elif [[ "$SPILL_HUB_STATUS" == invalid ]]; then
        spillover_local_measure
        SPILL_DECISION_SOURCE=hub
        spillover_log none "hub-invalid-response"
        echo "wrk: panewire placement response is invalid; refusing local fallback" >&2
        return 2
      else
        SPILL_DECISION_SOURCE=local-fallback
        if spillover_local_is_pressured; then
          SPILL_HUB_CANDIDATES=()
          while IFS= read -r candidate; do
            [[ -z "$candidate" ]] || SPILL_HUB_CANDIDATES+=("$candidate")
          done < <(spillover_hosts)
          selected="${SPILL_HUB_CANDIDATES[0]:-}"
          [[ -n "$selected" ]] || { spillover_log none "${SPILL_REASON};no-remote-capacity"; echo "wrk: spill-over required (${SPILL_REASON}) but no configured remote host has capacity; use --host local to override" >&2; return 1; }
        else
          selected=local
        fi
      fi
      ;;
    *)
      if ! spillover_value "hosts.$requested" ssh >/dev/null 2>&1 && ! grep -qx "$requested" <<<"$(spillover_hosts)"; then
        die "unknown spill-over host '$requested'; use wrk hosts"
      fi
      spillover_local_measure; selected="$requested"; SPILL_REASON=forced-remote; SPILL_DECISION_SOURCE=forced
      ;;
  esac
  spillover_log "$selected" "$SPILL_REASON"
  if [[ "$selected" == local ]]; then
    out="$(mktemp)"
    # Keep spawn_cmd's errexit semantics (notably a blocked quota gate) in an
    # isolated shell, while retaining strict landing's exit 76 and its emitted
    # OK pane line for host annotation.
    set +e
    ( set -e; spawn_cmd "${filtered[@]}" ) >"$out"
    rc=$?
    set -e
    spillover_emit_host local "$out"
    rm -f "$out"
    return "$rc"
  fi
  [[ -n "$cwd" && -n "$prompt" ]] || die "-c CWD and -p PROMPT_FILE are required"
  local candidates=("$selected") candidate last_rc=1 seen_candidates=""
  if [[ "$requested" == auto ]]; then candidates+=("${SPILL_HUB_CANDIDATES[@]:-}"); fi
  for candidate in "${candidates[@]}"; do
    [[ " $seen_candidates " == *" $candidate "* ]] && continue
    seen_candidates+=" $candidate"
    if ! spillover_probe_host "$candidate"; then
      [[ "$SPILL_PROBE_REASON" == ssh-unreachable ]] && spillover_wake "$candidate"
      continue
    fi
    if spillover_remote_spawn "$candidate" "$cwd" "$prompt" "${filtered[@]}"; then return 0; else last_rc=$?; fi
    [[ "$last_rc" -ne 2 ]] || return 2  # cwd mapping is fail-closed, never spill elsewhere.
    warn "spill-over remote spawn failed host=$candidate exit=$last_rc; trying next candidate"
  done
  warn "no remote spill-over candidate completed; falling back to local"
  out="$(mktemp)"
  set +e
  ( set -e; spawn_cmd "${filtered[@]}" ) >"$out"
  rc=$?
  set -e
  spillover_emit_host local "$out"
  rm -f "$out"
  return "$rc"
}

hosts_cmd() {
  local host config
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { hosts_help; return 0; }
  [[ $# -eq 0 ]] || die "hosts accepts no arguments"
  config="$(spillover_config)"
  spillover_local_measure
  printf 'config=%s\n' "$config"
  printf 'local load5=%s ncpu=%s ratio=%s active=%s\n' "${SPILL_LOAD:-unknown}" "${SPILL_NCPU:-unknown}" "${SPILL_RATIO:-unknown}" "${SPILL_ACTIVE:-unknown}"
  printf 'host\tstatus\tload5\tactive\n'
  for host in $(spillover_hosts); do
    if spillover_probe_host "$host"; then
      printf '%s\tavailable\t%s\t%s\n' "$host" "${SPILL_REMOTE_LOAD:-unknown}" "${SPILL_REMOTE_ACTIVE:-unknown}"
    else
      printf '%s\t%s\t%s\t%s\n' "$host" "$SPILL_PROBE_REASON" "${SPILL_REMOTE_LOAD:-unknown}" "${SPILL_REMOTE_ACTIVE:-unknown}"
    fi
  done
}


spawn_cmd() {
  local landing_detail="" retry_skip_reason=""
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { spawn_help; return 0; }
  CWD="" MODEL="" PROMPT="" WS="" LABEL="" LANE="" EFFORT="" JOB_ID="" JOB_T="" OWNER="" ROLE="worker" CAPTAIN_LANE="" PARENT_LANE="" REPORT_PATH="" JOB_DUP_OK=0 LANDING_STRICT=0 LANDING_NO_DETAIL=""
  ARBITER_HELD=0 ARBITER_RESOURCE="" ARBITER_PROFILE="" ARBITER_STARTED_AT="" GATE_OUTPUT="" GATE_READY=0 ARBITER_JOB_REGISTERED=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) spawn_help; return 0 ;;
      -c|-m|-p|-w|-l|-L|--effort|--job|--t|--owner|--role|--lane|--parent|--report)
        [[ $# -ge 2 && -n "$2" ]] || die "$1 requires a value"
        case "$1" in
          -c) CWD="$2" ;; -m) MODEL="$2" ;; -p) PROMPT="$2" ;; -w) WS="$2" ;;
          -l) LABEL="$2" ;; -L) LANE="$2" ;; --effort) EFFORT="$2" ;;
          --job) JOB_ID="$2" ;; --t) JOB_T="$2" ;; --owner) OWNER="$2" ;;
          --role) ROLE="$2" ;; --lane) CAPTAIN_LANE="$2" ;; --parent) PARENT_LANE="$2" ;;
          --report) REPORT_PATH="$2" ;;
        esac
        shift 2 ;;
      --job-dup-ok) JOB_DUP_OK=1; shift ;;
      --landing-strict) LANDING_STRICT=1; shift ;;
      -*) die "unknown option '$1'" ;;
      *) die "unexpected argument '$1'" ;;
    esac
  done
  [[ -n "$CWD" ]] || die "-c CWD is required"
  [[ -n "$MODEL" ]] || die "-m MODEL is required"
  [[ -n "$PROMPT" ]] || die "-p PROMPT_FILE is required"
  [[ -n "$WS" ]] || die "-w WORKSPACE is required"
  [[ -n "$LABEL" ]] || die "-l LABEL is required"
  # ROB-1215 (herdr 0.8 bundled skill): agent names must match [a-z][a-z0-9_-]{0,31}
  # — lowercase, ≤32 chars, unique among live agents. herdr rejects violations late
  # and cryptically; retries then mutate the label (2026-08-03: legA-alpha-live vs
  # lega-alpha — one job forked into two ids over the uppercase 'A'). Fail early.
  [[ "$LABEL" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "invalid label '$LABEL' — herdr agent names must match [a-z][a-z0-9_-]{0,31} (lowercase, ≤32 chars)"
  [[ -r "$PROMPT" ]] || die "prompt file is not readable: $PROMPT"

  [[ -n "$JOB_ID" ]] || JOB_ID="$LABEL"

  case "$ROLE" in worker|captain) ;; *) die "--role accepts only worker or captain" ;; esac
  if [[ "$ROLE" == captain ]]; then
    [[ -n "$CAPTAIN_LANE" ]] || die "--role captain requires --lane CAPTAIN_LANE"
    [[ -n "$PARENT_LANE" ]] || die "--role captain requires --parent PARENT_LANE"
    [[ -z "$OWNER" ]] || die "--role captain uses --lane; do not combine it with --owner"
    case "$MODEL" in captain-opus|captain-sol) ;; *) die "--role captain accepts only captain-opus or captain-sol (terra/luna are worker-only)" ;; esac
    [[ "$MODEL" != captain-opus || -z "$EFFORT" || "$EFFORT" == high ]] || die "captain-opus requires effort high"
  else
    [[ -z "$CAPTAIN_LANE" && -z "$PARENT_LANE" ]] || die "--lane/--parent require --role captain"
    case "$MODEL" in captain-opus|captain-sol) die "captain profiles require --role captain" ;; esac
  fi

  resolve_profile
  configure_landing_check "$PROFILE_KIND"
  LANE_ENV=()
  if [[ -n "$LANE" ]]; then
    case "$LANE" in
      live|mock)
        if [[ -d "$CWD/$LANE" ]]; then CWD="$CWD/$LANE";
        else warn "-L $LANE: $CWD/$LANE absent; cwd unchanged"; fi ;;
      *) die "-L accepts only live or mock" ;;
    esac
    if [[ "$LANE" == mock ]]; then
      [[ -n "${MOCK_MCP_PROFILE:-}" ]] || die "-L mock requires MOCK_MCP_PROFILE"
      LANE_ENV+=(--env "MCP_PROFILE=$MOCK_MCP_PROFILE")
    fi
  fi
  # ROB-1206: arbiter owner_lane is *who spawned this*, not the execution lane.
  # Conflating them made every record `default` (or `mock`), so an orch could not
  # query `arbiter status --lane <itself>` to find and reclaim its own workers.
  # -L live|mock stays the execution lane; --owner names the spawning session.
  JOB_LANE="${CAPTAIN_LANE:-${OWNER:-default}}"
  ARBITER_CLAIM_ROLE_ARGS=(--role "$ROLE")
  if [[ "$ROLE" == captain ]]; then
    ARBITER_CLAIM_ROLE_ARGS+=(--parent-lane "$PARENT_LANE")
  fi

  # ROB-1198 §③ / ROB-1199 claim contract: an unclassified job is not spawned.
  # There is no default T — a blank one would be recorded as fact by arbiter.
  # Checked before the quota gate, so nothing is measured, claimed or spawned.
  [[ -n "$JOB_T" ]] ||
    die "NEEDS_CLASSIFICATION: --t T0..T3 is required (job '$JOB_ID'); classify it, do not guess"
  case "$JOB_T" in T0|T1|T2|T3) ;; *) die "--t accepts only T0, T1, T2 or T3" ;; esac

  # Advisory only (never fails spawn). After -L may have rewritten CWD.
  warn_if_canonical_off_default "$CWD"

  quota_gate
  arbiter_admit
  [[ -x "$HERDR" ]] || die "herdr unavailable: $HERDR"

  if [[ "$PROFILE_KIND" == kimi ]]; then
    if ! CWD="$(cd -- "$CWD" 2>/dev/null && pwd -P)"; then
      die "cannot resolve Kimi CWD to an absolute path: $CWD"
    fi
    kimi_seed_workspace_trust "$CWD" "$KIMI_TRUST_HOME"
  fi

  TAB_ENV=()
  if [[ "${#LANE_ENV[@]}" -gt 0 ]]; then TAB_ENV+=("${LANE_ENV[@]}"); fi
  if [[ "${#PROFILE_ENV[@]}" -gt 0 ]]; then TAB_ENV+=("${PROFILE_ENV[@]}"); fi
  if [[ "$ARBITER_HELD" -eq 1 ]]; then
    # The worker needs its own record identity to release or prove it later.
    TAB_ENV+=(--env "ARBITER_JOB=$JOB_ID" --env "ARBITER_RESOURCE=$ARBITER_RESOURCE"
              --env "ARBITER_KIND=quota_pool" --env "ARBITER_PROFILE=$ARBITER_PROFILE"
              --env "ARBITER_STARTED_AT=$ARBITER_STARTED_AT")
  fi
  if [[ "${#TAB_ENV[@]}" -gt 0 ]]; then
    PANE=$("$HERDR" tab create --workspace "$WS" --cwd "$CWD" --label "$LABEL" --no-focus "${TAB_ENV[@]}" |
      python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["root_pane"]["pane_id"])')
  else
    PANE=$("$HERDR" tab create --workspace "$WS" --cwd "$CWD" --label "$LABEL" --no-focus |
      python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["root_pane"]["pane_id"])')
  fi
  SPAWN_PANE_OPEN=1   # ROB-1214: disarmed only at the success line
  sleep_for 5
  START_TIMEOUT=30000; BOOT_SETTLE=12
  [[ "$PROFILE_KIND" == kiro ]] && START_TIMEOUT=120000 && BOOT_SETTLE=25
  [[ "$PROFILE_KIND" == kimi ]] && START_TIMEOUT=90000 && BOOT_SETTLE=20
  [[ "$PROFILE_KIND" == codex ]] && START_TIMEOUT=120000 && BOOT_SETTLE=20

  "$HERDR" agent start "$LABEL" --kind "$PROFILE_KIND" --pane "$PANE" --timeout "$START_TIMEOUT" -- "${ARGS[@]}" >/dev/null
  sleep_for "$BOOT_SETTLE"
  if [[ "$PROFILE_KIND" == kimi ]]; then
    VISIBLE_SCREEN=""
    VISIBLE_SCREEN="$($HERDR agent read "$PANE" --lines 40 --source visible 2>/dev/null || true)"
    if grep -Fq "Trust this folder?" <<<"$VISIBLE_SCREEN"; then
      warn "KIMI TRUST WARNING: workspace trust seeding may have been neutralized — format change suspected; 'Trust this folder?' remains visible. Spawn continues."
    fi
  fi
  if [[ "$PROFILE_KIND" == kiro ]]; then
    "$HERDR" agent prompt "$PANE" "/effort $EFFECTIVE_EFFORT" >/dev/null 2>&1
    sleep_for 2
  fi
  PROMPT_PAYLOAD="$(<"$PROMPT")"
  PROMPT_MARKER="$(prompt_marker "$PROMPT")"
  PROMPT_SUBMITTED=0
  LANDING="no"
  if [[ "$PROFILE_KIND" == opencode ]]; then
    "$HERDR" agent prompt "$PANE" "$PROMPT_PAYLOAD" >/dev/null 2>&1
    PROMPT_SUBMITTED=1
    sleep_for 2
    "$HERDR" agent send-keys "$PANE" return >/dev/null 2>&1
  else
    if ! "$HERDR" agent prompt "$PANE" "$PROMPT_PAYLOAD" --wait \
      --until working --until idle --until "done" --until blocked --timeout 40000 >/dev/null 2>&1; then
      # The payload was already submitted. A return may settle a still-open
      # composer, but the payload must never be sent again after an ambiguous
      # wait result. A later screen/status observation is different: only a
      # successful prompt command followed by confirmed non-landing may use
      # the one retry below. This preserves ROB-1186's at-most-once rule while
      # making the safety boundary at-most-once landing.
      "$HERDR" agent send-keys "$PANE" return >/dev/null 2>&1 || true
    else
      PROMPT_SUBMITTED=1
    fi
  fi
  if landing_check "$PANE" "$PROMPT_MARKER"; then
    LANDING=yes
  else
    landing_detail="$(landing_check_detail)"
    if [[ "$PROMPT_SUBMITTED" -eq 1 && "$LANDING_CHECK_CONFIRMED" -eq 1 && "$LANDING_CHECK_AMBIGUOUS" -eq 0 ]]; then
      # The first submission completed, and the entire evidence window found
      # no marker or queued-chip. This is confirmed non-landing, so exactly
      # one re-injection is allowed; no status value can add another retry.
      warn "landing window expired; pane=$PANE phase=initial $landing_detail action=reinject-once"
      if [[ "$PROFILE_KIND" == opencode ]]; then
        "$HERDR" agent prompt "$PANE" "$PROMPT_PAYLOAD" >/dev/null 2>&1
        sleep_for 2
        "$HERDR" agent send-keys "$PANE" return >/dev/null 2>&1
      elif "$HERDR" agent prompt "$PANE" "$PROMPT_PAYLOAD" --wait \
        --until working --until idle --until "done" --until blocked --timeout 40000 >/dev/null 2>&1; then
        :
      else
        # The retry itself is also at most once; do not turn its ambiguous wait
        # result into another payload submission.
        "$HERDR" agent send-keys "$PANE" return >/dev/null 2>&1 || true
      fi
      if landing_check "$PANE" "$PROMPT_MARKER"; then
        LANDING=retry
      else
        landing_detail="$(landing_check_detail)"
        LANDING_NO_DETAIL="phase=retry $landing_detail action=landed-no"
      fi
    else
      if [[ "$PROMPT_SUBMITTED" -ne 1 ]]; then
        retry_skip_reason=prompt-submission-unconfirmed
      elif [[ "$LANDING_CHECK_AMBIGUOUS" -ne 0 ]]; then
        retry_skip_reason=ambiguous-observation
      else
        retry_skip_reason=non-landing-not-confirmed
      fi
      LANDING_NO_DETAIL="phase=initial $landing_detail action=landed-no retry=skipped reason=$retry_skip_reason"
    fi
  fi
  STATUS="unknown"
  if STATUS="$(agent_status_for_pane "$PANE")"; then :; else STATUS=unknown; fi
  # The spawn stands; the execution record now belongs to the worker, not to this process.
  arbiter_record_spawn_receipt
  # A sentinel requires the durable claim/spawn metadata it later reads. During
  # an installation transition the old fail-open spawn contract remains intact.
  if [[ "$ARBITER_JOB_REGISTERED" -eq 1 ]]; then
    start_completion_sentinel "$(wrk_jobs_root)/$JOB_ID/completion-sentinel.pid" "$JOB_ID" "$JOB_LANE" "$LABEL" "$PANE" "$REPORT_PATH" "$ARBITER_RESOURCE"
  fi
  SPAWN_PANE_OPEN=0
  refresh_quota_pool
  ARBITER_HELD=0
  if [[ -n "$ARBITER_RESOURCE" ]]; then
    echo "OK pane=$PANE model=$MODEL label=$LABEL status=$STATUS landed=$LANDING job=$JOB_ID quota_record=$ARBITER_RESOURCE/quota_pool"
  else
    echo "OK pane=$PANE model=$MODEL label=$LABEL status=$STATUS landed=$LANDING"
  fi
  if [[ "$LANDING" == no ]]; then
    if [[ "$LANDING_STRICT" -eq 1 ]]; then
      warn "spawn succeeded but brief landed=no; pane=$PANE remains valid; $LANDING_NO_DETAIL strict_exit=$WRK_EXIT_LANDING_UNCONFIRMED"
      return "$WRK_EXIT_LANDING_UNCONFIRMED"
    fi
    warn "spawn succeeded but brief landed=no; pane=$PANE remains valid; $LANDING_NO_DETAIL"
  fi
}

find_cmd() {
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { find_help; return 0; }
  local target="" pane_only=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) find_help; return 0 ;;
      --pane-only) pane_only=1 ;;
      -*) die "unknown option '$1'" ;;
      *) [[ -z "$target" ]] || die "find accepts exactly one target"; target="$1" ;;
    esac
    shift
  done
  [[ -n "$target" ]] || die "find requires a name or label"
  [[ -x "$HERDR" ]] || die "herdr unavailable: $HERDR"
  local af tf rc
  af="$(mktemp)"; tf="$(mktemp)"
  "$HERDR" agent list >"$af"
  "$HERDR" tab list >"$tf"
  set +e
  python3 - "$target" "$pane_only" "$HERDR" "$af" "$tf" <<'PY'
import json, subprocess, sys
target, pane_only, herdr, af, tf = sys.argv[1:]
def load(path, key):
    with open(path, encoding="utf-8") as f:
        p = json.load(f)
    r = p.get("result", p)
    v = r.get(key) if isinstance(r, dict) else None
    if not isinstance(v, list):
        raise ValueError("invalid herdr JSON: " + key)
    return v
agents, tabs = load(af, "agents"), load(tf, "tabs")
labels = {t.get("tab_id"): t.get("label") for t in tabs}
def unique(items):
    out, seen = [], set()
    for item in items:
        pane = item.get("pane_id")
        if pane and pane not in seen:
            out.append(item); seen.add(pane)
    return out
matches = unique([a for a in agents if a.get("name") == target])
kind = "name"
if not matches:
    ids = {t.get("tab_id") for t in tabs if t.get("label") == target}
    matches = unique([a for a in agents if a.get("tab_id") in ids])
    kind = "label"
if not matches:
    print("wrk find: no exact name or label match: " + target, file=sys.stderr)
    raise SystemExit(1)
def desc(a):
    return ("pane_id=" + a.get("pane_id","?") + " name=" + (a.get("name") or "-") +
            " label=" + (labels.get(a.get("tab_id")) or "-") +
            " agent=" + a.get("agent","-") + " status=" + a.get("agent_status","-"))
if pane_only == "1":
    if len(matches) != 1:
        print("wrk find: ambiguous " + str(len(matches)) + " " + kind + " matches", file=sys.stderr)
        raise SystemExit(1)
    print(matches[0].get("pane_id",""))
    raise SystemExit(0)
print("match=" + kind + " target=" + repr(target) + " candidates=" + str(len(matches)))
read_failed = False
for a in matches:
    print(desc(a))
    p = subprocess.run([herdr, "pane", "read", a["pane_id"], "--source", "recent",
                        "--lines", "5", "--format", "text"], capture_output=True, text=True)
    lines = p.stdout.rstrip("\n").splitlines()[-5:] if p.returncode == 0 else ["(pane read failed)"]
    for line in lines or ["(no screen output)"]:
        print("  " + line)
    read_failed = read_failed or p.returncode != 0
if len(matches) != 1:
    print("wrk find: multiple panes matched; refusing automatic selection", file=sys.stderr)
    raise SystemExit(1)
raise SystemExit(1 if read_failed else 0)
PY
  rc=$?
  set -e
  rm -f "$af" "$tf"
  return "$rc"
}

name_sync_cmd() {
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { name_sync_help; return 0; }
  local mode=preview labels=() arg
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "$arg" in
      -h|--help) name_sync_help; return 0 ;;
      --apply) mode=apply ;;
      --*) die "unknown option '$arg'" ;;
      *) mode=apply; labels+=("$arg") ;;
    esac
    shift
  done
  HERDR_BIN="$HERDR" python3 - "$mode" "${labels[@]:-}" <<'PY'
import json, os, subprocess, sys
H = os.environ["HERDR_BIN"]
mode = sys.argv[1]
want = [x for x in sys.argv[2:] if x]
def run(*args):
    return json.loads(subprocess.run([H, *args], capture_output=True, text=True).stdout)["result"]
labels = {}
for ws in run("workspace", "list").get("workspaces", []):
    for t in run("tab", "list", "--workspace", ws["workspace_id"]).get("tabs", []):
        if t.get("label"): labels[t["tab_id"]] = t["label"]
agents = run("agent", "list")["agents"]
taken = {a["name"] for a in agents if a.get("name")}
by_tab = {}
for a in agents: by_tab.setdefault(a.get("tab_id"), []).append(a)
acted = skipped = 0
for tab, label in sorted(labels.items()):
    if want and label not in want: continue
    members = by_tab.get(tab, [])
    unnamed = [a for a in members if not a.get("name")]
    if not unnamed: continue
    if len(members) > 1:
        print(f"  △ SKIP  {tab} '{label}' — 탭에 agent {len(members)}개(모호). 수동: herdr agent rename <pane> <이름>")
        skipped += 1; continue
    a = unnamed[0]
    if label in taken:
        print(f"  △ SKIP  {tab} '{label}' — 이름 이미 사용 중(agent_name_taken)")
        skipped += 1; continue
    if not want and (label.isdigit() or len(label) < 3):
        print(f"  △ SKIP  {tab} '{label}' — 잡라벨 추정(숫자/3자 미만). 원하면 라벨 명시 지정으로")
        skipped += 1; continue
    if mode == "apply":
        r = subprocess.run([H, "agent", "rename", a["pane_id"], label], capture_output=True, text=True)
        ok = '"agent_info"' in r.stdout or "agent_info" in r.stdout
        print(f"  {'✓' if ok else '✗'} {a['pane_id']} ({a['agent']}) → name '{label}'")
        taken.add(label); acted += 1
    else:
        print(f"  · 후보  {a['pane_id']} ({a['agent']}, 이름 없음) → '{label}'")
        acted += 1
if mode == "preview":
    print(f"\n후보 {acted}건, 스킵 {skipped}건 — 적용: herdr-name-sync --apply (또는 라벨 지정)")
else:
    print(f"\n적용 {acted}건, 스킵 {skipped}건")
PY
}

case "${1:-}" in
  -h|--help) usage ;;
  spawn) shift; spawn_router_cmd "$@" ;;
  done) shift; done_cmd "$@" ;;
  escalate) shift; escalate_cmd "$@" ;;
  joined) shift; joined_cmd "$@" ;;
  sentinel) shift; sentinel_cmd "$@" ;;
  find) shift; find_cmd "$@" ;;
  name-sync) shift; name_sync_cmd "$@" ;;
  profiles) shift; profiles_cmd "$@" ;;
  hosts) shift; hosts_cmd "$@" ;;
  "") usage >&2; exit 2 ;;
  *) die "unknown command '$1' (see 'wrk --help')" ;;
esac
