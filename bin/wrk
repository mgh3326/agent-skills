    # CATALOG_KEEP_MODEL keeps this literal model id.
    codex-sol6) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6-sol; DEFAULT_EFFORT=max; EFFORT_SUPPORTED=1 ;;
    builder-sol6) PROFILE_KIND=codex; PROFILE_MODEL=gpt-6-sol; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
    # builder-astra/captain-astra removed (task #526): astra is limited to
    # director judgment, architect counsel and operator-requested advice, so the
    # builder spellings have no legal role left.
    builder-astra|captain-astra)
      die "profile '$MODEL' was removed: astra is limited to director judgment, architect counsel and operator-requested advice (hk:doc decision/2026-09-21/astra-allowed-purposes-approved); use codex-astra" ;;

    kiro) PROFILE_KIND=kiro; DEFAULT_EFFORT=high; EFFORT_SUPPORTED=1 ;;
