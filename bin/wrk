#!/usr/bin/env bash
# wrk — herdr spawn/find/name-sync entrypoint.
set -euo pipefail

HERDR="${HERDR_BIN:-$HOME/.local/bin/herdr}"
SCOPEFUEL="${SCOPEFUEL_BIN:-}"
ARBITER="${ARBITER_BIN:-}"
# #609: one wrk process is one spawn attempt; fixture herdr keys its pane
# foreground state on this so process-info does not depend on a call log.
# Real herdr never reads it.
export WRK_RUN_ID="${WRK_RUN_ID:-$$}"
# A live duplicate is an exact-once violation, distinct from generic CLI
# misuse (2) and the arbiter's own duplicate result (4).  75 means that an
# arbiter duplicate was observed but its state could not be proven safely.
WRK_EXIT_ACTIVE_JOB_DUPLICATE=74
WRK_EXIT_JOB_STATE_UNREADABLE=75
# A pane may be valid even when the submitted brief cannot be positively
# observed. Automation opts into 76 to distinguish that outcome from the
# ROB-1326 duplicate-job contracts above.
WRK_EXIT_LANDING_UNCONFIRMED=76
# #758: a refused tester-round open at the cap. Distinct from generic misuse
# (2) so a builder loop can tell "stop and wait" apart from a bad invocation.
WRK_EXIT_ROUND_CAP=78
# #872: distinguish physical mock MCP isolation refusal from quota/usage errors.
WRK_EXIT_MOCK_MCP_REFUSED=79
# The hub quota gate's fail-closed refusals (a bad [hub] quota_gate value, a
# contradictory or incomplete gate config, a rejected policy response) and,
# since #1163, a malformed [local] table — the spawn flag must never read
# "allowed" on a typo.  A remote wrk answers its delegated spawn with 70,
# and under --host auto that must stop the candidate round (#1154) — never
# fall back to a local spawn.
WRK_EXIT_CONFIG_REFUSED=70
# #1155: this host's own hosts.toml [local] spawn = false forbids local spawns.
# --host local and every local fallback answer 80; a remote wrk answers its
# delegated spawn with it too, and under --host auto that answer must NOT stop
# the round — the next remote candidate is tried.
WRK_EXIT_LOCAL_SPAWN_DISABLED=80
# #1239: a wake attempt on a wake-capable host that was refused, timed out, or
# left the host unreachable ends the spawn with 81 and never falls back to a
# local pane. A remote wrk answering 81 is a capacity-adjacent answer (its own
# wake failed), not an admission refusal — under --host auto it is not in the
# stop set, so the round moves on to the next candidate.
WRK_EXIT_WAKE_FAILED=81
# #1397: a --role builder spawn whose hub lane could not be registered answers
# 82 when the caller opted into strict lane reporting (WRK_LANE_STRICT=1).
# The pane is up and the OK line already carries lane=UNREGISTERED — the code
# exists so automation can tell "spawned but unrouted" apart from a clean
# spawn. It joins the remote stop set with 2/70/74/75: the pane exists, so
# moving the round to another host would double-spawn the job.
WRK_EXIT_LANE_UNREGISTERED=82
# kimi-k3-low: KIMI_CODE_HOME for the low-thinking-effort clone maintained by
# bin/kimi-clone-home (config.toml [thinking] effort=low; real ~/.kimi-code
# untouched). Scoped to only this profile below, not kimi-k3/kimi-k27.
KIMI_CODE_LOW_HOME="${KIMI_CODE_LOW_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/kimi-code-low}"
# #704 (#594 E6): the kimi builder rungs take their effort from pinned clone
# homes the same way (bin/kimi-clone-home --effort high|max) — the kimi CLI
# has no --effort flag, so the clone's [thinking] effort is the only lever.
KIMI_CODE_HIGH_HOME="${KIMI_CODE_HIGH_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/kimi-code-high}"
KIMI_CODE_MAX_HOME="${KIMI_CODE_MAX_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/kimi-code-max}"
# ROB-1252: cc-qwen38/cc-glm route the Claude Code CLI itself through the
# CLIProxyAPI instance at 127.0.0.1:8317 (openai-compatibility provider
# "cline-pass" registered in ~/.cli-proxy-api/config.yaml, aliases
# cc-qwen38/cc-glm), which translates to Cline's OpenAI-compat chat/completions
# upstream and re-serves native Anthropic /v1/messages — no ClinePass Anthropic
# ingress exists (verified: /anthropic, /api/v1/messages, /v1/messages all 404).
# The gate API key lives only in this file, read fresh at spawn time and passed
# solely into the spawned pane's env — never into ~/.claude/ config.
CLINEPASS_GATE_URL="http://127.0.0.1:8317"
CLINEPASS_GATE_KEY_FILE="${CLINEPASS_GATE_KEY_FILE:-$HOME/.config/cliproxyapi-key.txt}"

# 활성 프로필 목록 — `wrk profiles` 출력 및 scopefuel 교차검증의 근거.
# Barred spellings remain in resolve_profile solely so spawn can name their refusal.
ALL_PROFILES=(
  opus sonnet sonnet-med haiku fable builder-opus captain-opus builder-sonnet
  devin-swe2 devin-swe2-medium devin-swe2-max builder-devin
  builder-devin-medium builder-devin-max
  devin-glm52 devin-swe17 devin-ds41 devin-ds41-max
  devin-fusion-opus55 devin-fusion-sonnet55
  devin-fusion-sol61 devin-fusion-sol61-xhigh
  devin-argon devin-argon-medium devin-argon-low
  builder-ds41 builder-ds41-max
  codex-luna codex-luna-hi codex-luna-max
  codex codex-sol codex-max builder-sol builder-luna captain-sol codex-astra
  codex-sol56 codex-luna56 codex-sol6 builder-sol6
  builder-opus-low builder-opus-medium builder-sonnet-xhigh builder-sonnet-max
  builder-sol-high builder-sol-max builder-sol-medium builder-luna-max
  builder-sonnet-medium builder-haiku-low builder-luna-low builder-luna-medium
  builder-sol-low builder-haiku-high builder-haiku-xhigh builder-haiku-max builder-sonnet-low
  kiro kiro-opus kiro-sonnet kiro-sol kiro-luna kiro-cheap kiro-glm kiro-deepseek
  kiro-minimax kiro-minimax21 kiro-haiku kiro-opus-xhigh kiro-opus-max
  kiro-sol-xhigh kiro-sol-max
  kimi-k3 kimi-k27 kimi-k27-code kimi-k3-low builder-kimi
  builder-kimi-high builder-kimi-max
  oc-kimi-code oc-glm oc-kimi-k3 oc-dsflash oc-sonnet46 oc-oss oc-omni
  oc-qwen37-max oc-minimax-m3 oc-solar4
  agy-flash agy-flash36 agy-flash37
  grok grok-hi grok-med grok45 grok45-med grok46 grok46-med builder-grok
  builder-grok-low builder-grok-medium builder-grok-xhigh
  cc-qwen38 cc-glm cc-dsflash cc-dspro cc-glm53
)

profiles_help() {
  cat <<'USAGE'
Usage: wrk profiles

Print active model profile names, one per line (machine-readable; excludes
retired agy-* aliases and barred Terra profiles). Terra spellings are still
recognized so spawn can refuse them with the operator decision.
Barred: codex-terra, codex-terra-max, codex-med, builder-terra-high,
builder-terra-xhigh and builder-terra-max — operator 2026-10-12 noterra.
  -h, --help   show this usage
USAGE
}

profiles_cmd() {
  if [[ $# -gt 0 ]]; then
    if [[ "$1" == "-h" || "$1" == "--help" ]]; then
      [[ $# -eq 1 ]] || die "unexpected argument '$2'"
      profiles_help
      return 0
    fi
    die "unexpected argument '$1'"
  fi
  local profile
  for profile in "${ALL_PROFILES[@]}"; do
    case "$profile" in
      codex-terra|codex-terra-max|codex-med|builder-terra-high|builder-terra-xhigh|builder-terra-max)
        continue ;;
    esac
    printf '%s\n' "$profile"
  done
}

usage() {
  cat <<'USAGE'
Usage: wrk <spawn|done|escalate|joined|round|reap|lanes-missing|find|name-sync|profiles|hosts|heavy> [options]

  wrk spawn -c CWD -m MODEL -p PROMPT_FILE -w WORKSPACE -l LABEL --t T0..T3
            [-L live|mock] [--effort LEVEL] [--job ID] [--report PATH] [--job-dup-ok] [--landing-strict]
            [--operator-request REF] [--requested-by NAME] [--purpose PURPOSE] [--round-ext REF] [--keep]
  wrk done JOB [--report PATH]
  wrk escalate JOB --question TEXT [--report PATH]
  wrk joined JOB --pr URL --head SHA --report PATH [--rounds-waived REF]
  wrk round open JOB --head SHA [--extend REF] [--repo PATH]
  wrk round verdict JOB --file PATH
  wrk round void JOB N --by REF [--reason TEXT]
  wrk round status JOB
  wrk round audit [--lane LANE]
  wrk reap [--lane LANE] [--job JOB[,JOB...]] [--grace 10m] [--apply] [--include-builders|--include-captains]
  wrk lanes-missing
  wrk prune [--apply] [--stale-age AGE] [--job JOB] [--lane LANE]
  wrk find <name-or-label> [--pane-only]
  wrk name-sync [--apply|<label>...]
  wrk profiles
  wrk heavy -- <command> [args...]
  wrk heavy status

Run 'wrk <command> --help' for command-specific usage.
USAGE
}

done_help() {
  cat <<'USAGE'
Usage: wrk done JOB [--report PATH]

Write a job.completed record for JOB, upload the report as a handoffkeep
document, and emit the relay event to the owner lane.

Options:
  --report PATH      existing report file (default: newest report*.md in the
                     job directory). A re-completion with unchanged content is
                     suppressed as a duplicate. When the content changed but
                     PATH already names an earlier completed round, the
                     current content is snapshot to <stem>-r<N>.md (N = 1 +
                     earlier completed rounds) and the record, upload, emit
                     and OK line all name that new path — the relay key stays
                     unique and the original file is untouched.
                     If the emit returns non-zero the OK line ends with
                     relay=file-only.
                     A builder or captain done still completes, and warns once
                     when wrk joined would refuse for zero non-voided rounds
                     or an unmatched tester verdict file.
  -h, --help         show this usage
USAGE
}

escalate_help() {
  cat <<'USAGE'
Usage: wrk escalate JOB --question TEXT [--report PATH]

Write a builder escalation record and relay it to the parent lane.

Options:
  --question TEXT    required escalation question
  --report PATH      optional existing report to attach and upload as a document
  -h, --help         show this usage
USAGE
}

joined_help() {
  cat <<'USAGE'
Usage: wrk joined JOB --pr URL --head SHA --report PATH [--rounds-waived REF]

Record job.joined for a builder job. The join is refused when the job has
zero non-voided recorded rounds, or when the job directory holds a regular
file whose first line is a VERDICT line and no job.verdict matches that
file by path or content sha256. A later line does not count. Both
refusals are waived only by --rounds-waived REF, where REF is hk:doc/<key>
or hk:task/<digits>. REF is fetched from handoffkeep and must hold the line
  join-waiver: job=<job> by=<issuer>
for this job, one exact line with single spaces and nothing after it. The
issuer must be the parent lane or an operator and must equal the created_by of
the doc or the author of the task comment that holds the line. A pa-integrator
grant also needs the job's server task to be project ParkingArcade with
refs.job_id equal to the job. The ref and the issuer are stored on the
job.joined record as rounds_waived and rounds_waived_issuer. An end
declaration newer than the newest revive is refused and cannot be waived.
The end record and the rounds are rechecked under the events lock just before
wrk writes job.joined; a verified waiver's claim facts (parent lane, task id
and the newest claim/reclaim event) are rechecked there too, and a delegated
join is checked just before the hand-off only.
USAGE
}

spawn_help() {
  cat <<'USAGE'
Usage: wrk spawn -c CWD -m|--profile MODEL -p PROMPT_FILE -w WORKSPACE -l LABEL --t T0..T3
                 [-L live|mock] [--effort LEVEL] [--job ID] [--owner NAME] [--report PATH] [--job-dup-ok]
                 [--landing-strict] [--role builder --lane BUILDER_LANE --parent PARENT_LANE] [--host auto|local|NAME]
                 [--operator-request REF] [--requested-by NAME] [--purpose PURPOSE] [--round-ext REF] [--keep]
                 [--task HK_TASK_ID | --parent-job JOB_ID] [--takeover-from OLD_JOB] [--task-hk-bypass]

Options:
  -c CWD, -m|--profile MODEL, -p PROMPT_FILE, -w WORKSPACE, -l LABEL
  --t T0..T3         job scale; required — an unclassified job is not spawned
  -L live|mock       select lane; mock requires MOCK_MCP_PROFILE and
                    WRK_MOCK_MCP_CONFIG (reviewed stdio connection descriptor).
                    Unsupported harnesses and remote mock placement refuse (79).
  --effort LEVEL     override codex/Kiro/Grok/Claude(opus,sonnet) profile effort
  --job ID           arbiter job id (default: LABEL)
  --owner NAME       spawning session name, recorded as the arbiter owner_lane
                     (default: default). Lets that session later run
                     `arbiter status --lane NAME` to find and reclaim its workers,
                     and (--role worker only) is where that worker's own
                     job.completed is delivered directly. It is reclaim/direct-
                     completion only — it does NOT route job.escalate or
                     job.joined; see --parent for that, and note --role builder
                     rejects --owner outright (use --lane instead).
  --role worker|builder|tester|reviewer|counsel (legacy alias: captain)
                     tester/reviewer/counsel use worker lease topology.
                     builder requires --lane and --parent, and accepts only
                     builder-opus, builder-sol, builder-sol6, builder-devin,
                     builder-devin-medium, builder-devin-max, builder-ds41,
                     builder-ds41-max, builder-grok, builder-kimi,
                     builder-luna, builder-sonnet, builder-opus-low,
                     builder-opus-medium, builder-sonnet-xhigh,
                     builder-sonnet-max, builder-sol-high,

                     builder-sol-max, builder-sol-medium, builder-luna-max,
                     builder-kimi-high, builder-kimi-max, builder-grok-low,
                     builder-grok-medium, builder-grok-xhigh,
                     builder-sonnet-medium, builder-haiku-low,
                     builder-luna-low, builder-luna-medium, builder-sol-low,
                     builder-haiku-high, builder-haiku-xhigh, builder-haiku-max
                     or builder-sonnet-low profiles; legacy
                     captain-opus and captain-sol aliases and the pilot worker
                     spellings devin-swe2, devin-swe2-medium, devin-swe2-max,
                     grok/grok-hi and kimi-k3 remain accepted. The max-rung E6 spellings
                     (builder-sonnet-max, builder-sol-max, builder-luna-max,
                     builder-kimi-max, builder-haiku-max) are open builder
                     seats since hk 1863 (the 2026-09-26 no-max refusal is
                     removed) and need their exact SCOPEFUEL_E6_ARM marker;
                     under --role builder a resolved ultra rung is still
                     refused before the marker check.
                     The devin fusion spellings devin-fusion-opus55 and
                     devin-fusion-sonnet55 are worker/tester-only — --role
                     builder refuses them pending hk 1382. Fusion-Sol
                     spellings devin-fusion-sol61 and devin-fusion-sol61-xhigh
                     are worker/tester-only until hk 1729 reps are reviewed.
                     The devin Argon trial spellings devin-argon, devin-argon-medium and
                     devin-argon-low are likewise worker/tester-only (hk 1620
                     phase 1) — --role builder refuses all three.
                     All codex-terra, codex-terra-max, codex-med and
                     builder-terra-* spellings are refused: gpt-5.6-terra is
                     barred by operator 2026-10-12 noterra; use codex-sol or
                     codex-luna.
  --lane NAME        builder's own lane; recorded as the claim owner_lane.
                     (The execution lane remains -L live|mock.)
  --parent NAME      required for --role builder (spawn dies without it).
                     A builder's job.escalate and job.joined (PR-submitted)
                     events are routed to this lane, and ONLY this lane — not
                     --owner, which builders cannot even set. If a builder's
                     parent lane isn't registered when the event fires, the
                     notice has nowhere to go and the parent is never told;
                     see also the idle-wake suppression reasons in panewire
                     (parentless_lane, unknown_owner) for the same failure
                     mode on the idle-detection path.
  --lane-defer NAME  internal to the remote --host builder path: the
                     delegated wrk records lane+machine in its job.spawned
                     receipt without calling panewire, and the initiating
                     host performs the `lanes add` — unless the execution
                     host's own lanes_token_env names NAME in its
                     HUB_MACHINE_ID, in which case the delegated wrk
                     registers the lane itself and the initiator's add is
                     skipped. Builder-only — a worker
                     given the flag is refused, because its lane must stay
                     on its own session_machine_ids contract. NAME is the
                     hosts.toml key of the target host (its hub machine id)
                     and must match [A-Za-z0-9._-]{1,64}.
  --task ID          handoffkeep task this job owns (#768 decision
                     doc decision/2026-09-27/task-job-linkage, item 1; new
                     spawns only, no backfill). Required for --role builder
                     and for any worker/tester spawn that cannot inherit —
                     missing it is a usage error before any side effect. On a
                     successful spawn the task is claimed by the spawned label
                     and refs.job_id is set to the job id in one `tasks claim
                     --by --job-id` call (verified from the response; an hk
                     that drops job_id is a loud failure, never a silent
                     half-record). A task already bound to another job is
                     fail-closed, as are closed (merged/dropped), held and
                     needs_decision tasks; hk unreachable refuses the spawn
                     (no job without its task link) unless --task-hk-bypass.
  --parent-job JOB   tester/advisory inheritance: take the task id from the
                     parent job's recorded claim meta instead of --task.
                     Mutually exclusive with --task. When neither is given, a
                     worker spawn tries the calling pane's ARBITER_JOB meta
                     and then the HK_TASK_ID env (propagated into every
                     spawned pane) before the usage error. SSH remote spawns
                     resolve that task on the initiator and forward HK_TASK_ID;
                     via=hub cannot carry an inherited environment and refuses
                     before sending a request. The inherited task is recorded
                     in job meta (task_id + task_inherited_from) and the child
                     never re-claims it — the owning job's hk record stands.
  --takeover-from OLD_JOB
                    builder-only task takeover. Requires --task and an ended
                    old job; rebinds through handoffkeep and carries its round
                    count into the new job. Workers and testers cannot use it.
  --task-hk-bypass   explicit operator override: spawn without a confirmed
                     hk task link when handoffkeep is unreachable. Recorded
                     in the job's claim payload as task_link_override so the
                     audit trail shows exactly which jobs lack the link and
                     why. Never a silent skip: a reachable hk that refuses
                     the claim still fails the spawn.
  --report PATH      report acceptance-criterion path watched by the completion sentinel
                     When the watch window (WRK_COMPLETION_TIMEOUT_S) expires with
                     the agent still present, the sentinel logs action=watch-expired
                     and exits; the job stays live, no job.lost, no quota release.
                     A report first seen after the deadline gets one confirmation poll (action=pending late=1).
  --keep             protection marker: record "keep": true on the job.spawned
                     receipt so no session cleanup ever closes this pane — use it
                     for resident, director, installer and consult sessions.
                     `wrk reap` skips a kept job (reason=protected) and the
                     panewire session-reap report never lists it as a candidate.
                     Without --keep the receipt is byte-identical to before.
                     Local and ssh spawns only; a hub spill-over refuses it.
  --job-dup-ok       explicit operator override: permit an active duplicate job
                     after an auditable warning. Automation/panewire must not use it.
  --landing-strict   automation opt-in: preserve the OK line, then exit 76 if
                     no landing evidence appears (panewire prompt proof, else a
                     read-only marker/Pasted-text/devin-status observation).
                     Without it, landed=no remains a successful spawn with a
                     warning.

The brief is delivered with `panewire prompt` (no uptake; first line
`expect: name=LABEL cwd=CWD`). Only when panewire cannot reach its daemon
(rc 4) or is not installed does wrk inject once directly through herdr; the OK
line then ends with via=herdr-fallback.
  --round-ext REF   Verified round-extension document, hk:doc/round-extension/JOB,
                     hk:doc/round-ext/JOB or hk:doc/PROJECT/round-ext/JOB.
                     Requires --purpose round-extension; tester|reviewer|counsel
                     uses explicit --parent-job JOB. Builder uses --task ID and
                     the same JOB currently bound in refs.job_id. Only codex-astra (xhigh)
                     or fable; document and parent task ownership must be readable.
  --operator-request REF
                     operator request reference passed verbatim to
                     `scopefuel gate` (the gate accepts only hk:doc/<key>
                     or hk:task/<int>, and only on escalation or
                     consult_only profiles — fable needs it to spawn at
                     all). wrk never validates the REF itself — acceptance,
                     format refusal and the not-applicable refusal are all
                     the gate's own fail-closed decisions, and its rc is
                     propagated.
  --requested-by NAME
                     self-reported requester name accompanying
                     --operator-request, passed verbatim to `scopefuel gate`.
  --purpose PURPOSE  caller-declared spawn purpose passed verbatim to
                     `scopefuel gate` (task #527). For the astra profiles the
                     gate role-denies (gate exit 5; wrk exits 77) unless
                     PURPOSE is director, architect or operator-request; for
                     every other profile it is audit metadata only and never
                     changes the decision.
                     Claude profiles spawn with prompt suggestions off
                     (CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=false in the pane
                     env, #626); PURPOSE director leaves them as configured.
                     This is a purpose axis, distinct from the
                     --operator-request REF format gate above.
  --host auto|local|NAME
                     spawn placement. auto (the default) asks the hub first;
                     when the hub cannot answer, local pressure decides and
                     each configured remote host is tried in order. A remote
                     candidate whose own wrk refuses the spawn with a config
                     error (rc 70 — e.g. a malformed [hub] quota_gate on that
                     host) stops the round immediately: the spawn fails
                     closed with rc 70 and never falls back to local (#1154).
                     A remote wrk answering rc 2, 74 or 75 (usage error,
                     active-job duplicate, unreadable job state) also ends the
                     round, as does a cwd_map miss in a hub-selected round
                     and a via=hub candidate's own outcome. Transport-leg failures (probe, prepare,
                     mktemp, scp — normalized off the admission codes) and
                     every other remote answer move on to the next candidate,
                     and only when every candidate fails does auto fall back
                     to a local spawn. local forces a local spawn; NAME
                     forces one remote host and propagates its exit code with
                     no local fallback.

                     hosts.toml [local] also carries this host's own keys:
                     max_load_ratio/max_active/heavy_max gate the fallback
                     pressure measure and `wrk heavy`, and `spawn = false`
                     (#1155, set by the operator per host) forbids local
                     spawns outright — auto then treats local as unavailable
                     and only tries the remote candidates (an all-fail round
                     exits 80 with one attributed line per host instead of
                     the local fallback), local refuses with rc 80 before any
                     side effect, and a delegated ssh spawn — which arrives
                     as --host local on the execution host — is refused the
                     same way. A via=hub delegated spawn is different: the
                     hub's wrkgate runs `wrk spawn` on the target WITHOUT
                     --host, so a closed via=hub target runs the auto round —
                     it lands no local pane, but it may still place the job
                     on one of that target's own remotes. A remote answering
                     80 does not stop the auto round.

                     The flag is fail-closed (#1163): the only accepted form
                     is '[local]' on its own line with 'spawn = false' (or
                     'spawn = true') written once. Anything else that names
                     the local table or its spawn key — a header like
                     '[local] # comment', '[ local ]' or '["local"]', a
                     second [local] table, a second spawn key, a spawn line
                     that is not a 'spawn = value' assignment ('spawn',
                     'spawn: false', 'spawn == false'), or a value that is
                     not a bare true/false (a quoted spelling is a string,
                     not a boolean) — is a config error refusing every
                     placement with rc 70, naming the file line and reason.
                     So is any content before the first table header (the
                     root table must be empty — 'local.spawn = false' or
                     'local = { spawn = false }' there are root keys, not
                     the flag), a UTF-8 BOM at any line start, a hosts.toml
                     that exists but is unreadable, or a path whose
                     existence cannot be determined because a parent
                     directory is not searchable. No [local] section, a
                     [local] without spawn,
                     or one clean assignment keep the unchanged behavior.
                     The same surface carries 'heavy_load_wait' (#1241,
                     wrk heavy's load-wait switch — 'wrk heavy --help'):
                     one clean 'heavy_load_wait = true|false' under
                     '[local]', same refusal rules — a malformed
                     heavy_load_wait refuses placements too, and vice
                     versa. `shell_ready_timeout_ms = N` (30000..300000)
                     lengthens this host's shell readiness window for every
                     kind and cannot shorten its kind default; a remote
                     spawn uses the target host's own [local] value. `wrk hosts` reports the resolved state as
                     'local spawn=allowed|disabled|error'.

                     hosts.toml [hosts.NAME] may opt a default-off remote
                     into wake-on-demand with wake = "panewire" (#1239).
                     In the hosts.toml-order auto round a candidate with
                     no cwd_map entry for the cwd is skipped before it is
                     probed (a hub-selected round keeps the fail-closed
                     rc 2), and an
                     unreachable wake host is NOT woken on first sight —
                     the round finishes over the other candidates first.
                     The wake runs only when local cannot take the job
                     (pressured, or spawn = false), no candidate landed,
                     the round was not ended by a stop-set answer (a
                     reachable remote wrk answering 2, 70, 74 or 75), and
                     at least one candidate answered remote-full —
                     positive capacity evidence. It is
                     `panewire burst request --target NAME --hold
                     <wake_hold>m --timeout <min(wake_wait,600)>s` using
                     the operator credential — [hub] operator_token_env,
                     falling back to hub_token_env only when unset;
                     hub_token_env is never required because it is also
                     the hub quota gate opt-in (#1138) that a
                     quota_gate = "local" host deliberately leaves off.
                     hub_cf_env stays optional. wake_hold is the burst
                     hold in minutes (default 10 — a configured
                     wake_hold wins; WRK_WAKE_HOLD_MINUTES exists only
                     as a test seam over the default) and wake_wait
                     bounds the wait for the node in seconds (default
                     300) — a granted hold or a cooldown_active (a
                     concurrent spawn's wake already in flight, waited
                     on instead of stacking a second request) re-probes
                     the host until the deadline. A refused wake, a
                     burst error, a timeout, or a host still unreachable
                     after the wait exits 81 naming host, step and
                     reason plus the held per-candidate diagnostics —
                     never a local fallback, whatever [local] spawn says.
                     An explicit --host NAME on an unreachable wake host
                     wakes it the same way; the hosts.toml key is the
                     opt-in.
  -h, --help         show this usage

Hub lane registration (#965, extended to builders by #1397): a --role worker
or --role builder spawn registers a lane row on the hub so the pane's events
have somewhere to route —
`panewire lanes add NAME --machine ID --pane PANE --parent PARENT` with the
[hub] credentials: hub_url plus a lanes credential resolved per role — a
WORKER lane keeps the pre-#1397 chain of lanes_token_env when set, else
hub_token_env (operator_token_env is never read for it); a BUILDER lane
inserts operator_token_env between the two (hub_cf_env optional). The
values are file paths panewire opens; wrk scans a lanes token file for the
HUB_MACHINE_ID value only — to skip a registration the hub would refuse when
it differs from the target machine — and never prints file contents (a
malformed id warns once without the value). lanes_token_env (#1037) is a
node-scoped token that may reach only the lanes routes: this registration,
reap's `lanes rm`, the `lanes ls` confirmation, and `wrk lanes-missing`.
No other hub path (quota gate, placement, spill-over wake, hub spawn) reads
it, and a [hub] section with hub_url and lanes_token_env but no
hub_token_env does not opt into the hub quota gate — only a configured
hub_token_env switches that on. That skipped gate is never silent: every
spawn warns once that only the local scopefuel gate applies unless
quota_gate = "local" is set, the deliberate opt-out a lanes-only host uses
instead (any other quota_gate value — and "local" combined with
hub_token_env — is a config error that refuses the spawn).

What gets registered differs by role. A worker registers NAME=label on the
machine its effective herdr session (WRK_SENTINEL_HERDR_SESSION, else
HERDR_SESSION, else the herdr default) maps to in hosts.toml's [hub]
session_machine_ids, parented on --owner. A builder (#1397) registers
NAME=--lane parented on --parent — the route job.escalate and job.joined
take — on the machine the same map gives when the session is mapped, else
the host's own [hub] machine_id, this host's hub machine id (the id a
remote spawner names the host by in its hosts.toml). The machine_id
fallback is builder-only: an unmapped worker still warns once and spawns
unregistered, because a fleet worker must never become a global lane.

The job.spawned meta records hub_lane/hub_lane_machine plus lane_role (the
role the lane registered under: builder, or worker for worker, tester,
reviewer and counsel seats), and `wrk reap --apply` removes the lane with
`panewire lanes rm`, resolving the credential chain from that lane_role,
only when `lanes ls` still shows the same machine and pane. For a remote --host NAME BUILDER
spawn the ssh-delegated wrk on the target usually cannot reach the hub —
PUT /v1/lanes wants the operator credential, which stays on the
initiating host — so the
delegation passes --lane-defer NAME and the remote wrk only RECORDS
lane+machine in its receipt; the initiating host performs `lanes add`
itself whenever the remote printed an OK pane= line and answered a
pane-remains-valid rc (0, or 76 landing-unconfirmed — the pane exists, so
the lane must exist), with machine = the hosts.toml key it reached the
target by (the key IS the target's hub machine id). The exception (hk
1446): when the execution host's own lanes_token_env file carries
HUB_MACHINE_ID equal to NAME, the delegated wrk registers the lane itself
with that node token and marks its OK line lane_registered=self; the
initiator reads the marker off the OK pane= line only, skips its own add,
and keeps lane=NAME@HOST. Any other remote
answer — or a skipped or failed add — rewrites the line's field to
lane=UNREGISTERED; a remote lane=L@M is never passed through without a
confirmed add. A remote worker gets no flag and no initiator-side add —
the execution host runs the ordinary worker lookup against its own
session_machine_ids. The receipt lives with the job on the execution host
— the only place `wrk reap` can verify the pane — and reap there removes
the lane through the same machine+pane check, provided that host holds a
lanes credential;
`lanes rm` being a hub call, any operator-credentialed host can also
remove the row.

A worker's OK line ends with lane=LABEL@ID on a confirmed registration and
otherwise omits lane=, the pre-#965 contract. A builder's OK line ALWAYS
states its lane outcome: lane=LANE@ID on a confirmed registration, else
lane=UNREGISTERED — plus one warning naming the reason (unmapped session
and no machine_id, missing --parent, missing hub_url or credential,
malformed machine id or lane name, panewire failure). Over the via=hub
transport there is no registration-confirmation channel, so a builder's
emitted line always ends lane=UNREGISTERED. The default stays warn-only
because the pane is up; WRK_LANE_STRICT=1 exits 82 after the OK
line — on every transport, via=hub included — so automation can tell
"spawned but unrouted" from a clean spawn —
and on a remote leg that 82 stops the auto round instead of re-placing
the job on the next host. `wrk lanes-missing` is the matching audit: a
read-only listing of open jobs whose owner lane or its parent is absent
from `panewire lanes ls`.

The lane name is validated against panewire's own rule ^[a-z0-9-]{1,32}$
before it may reach argv: a worker label or builder --lane containing an
underscore is a valid wrk name but not a valid lane name, so such a spawn
warns once and lands unregistered (#1010). `panewire lanes-audit` lists
any leftover rows.

session_machine_ids is for NON-fleet herdr sessions only — for example M1's
default session, served by its own panewire daemon. Mapping a fleet session
is not a supported use: it registers every fleet worker as a global lane for
no benefit. A builder whose session is the fleet default relies on [hub]
machine_id instead.

Admission control (ROB-1199): after the scopefuel quota gate passes, wrk claims
the job and records its quota-pool execution in arbiter. arbiter resolves the
pool from scopefuel's own output — wrk holds no pool mapping. A quota-pool
claim/record or preparation failure is warned and does not deny the spawn; a
failed spawn releases a successfully created record. The scopefuel gate remains
fail-closed, while exclusive arbiter leases retain their own fail-closed rules.

