#!/usr/bin/env bash
# Stand-in for `panewire` so the suite never reaches a real socket, daemon or
# hub. Silent and successful by default; the R20 cases opt into capture and
# failure through the environment.
#
#   WRK_PANEWIRE_LOG    append one argv element per line, then a `--` separator
#   WRK_PANEWIRE_RC     exit code to return (default 0)
#   WRK_PANEWIRE_SLEEP  seconds to stall before returning, to exercise timeouts
#   WRK_PANEWIRE_REQUIRE_INBOX_ROOT  exit 2 when argv lacks --inbox-root,
#                       reproducing the real emit's missing-root failure
set -euo pipefail

# `panewire prompt` (#498 spawn brief delivery) models the real daemon closely
# enough for wrk's rc handling: prompt.go parses the expect line, refuses a
# name/cwd mismatch before sending (rc 5), sends through herdr (here: the
# herdr fixture, so its log counts the injection exactly like a direct
# `agent prompt`), and proves submission only for claude/codex by finding the
# first 24 characters of the body in the transcript; otherwise rc 6.
#
#   WRK_PANEWIRE_PROMPT       comma list, one mode per call (last repeats):
#                             classify (default) | ok | unproven | composer |
#                             rejected | rejected-unsent | daemon-down |
#                             expect-fail | timeout
#   WRK_PANEWIRE_PROMPT_LOG   one line per call: from/to/file/timeout/uptake;
#                             the file as received is copied to LOG.<n>
#   WRK_PANEWIRE_PANE_CWD     herdr's cwd for the pane; when set, expect cwd
#                             must equal it byte for byte (as prompt.go does)
#   WRK_PANEWIRE_STRICT_EXPECT  when 1, reject expect tokens outside the real
#                             parser's field set (name/label/cwd/title~/recent~)
#                             with rc 5 — parsePromptFile does the same, and a
#                             stray field there means the brief is never sent
#                             (#667: wrk once put `catalog=stale` on that line)
fixture_prompt() {
  local from="" to="" file="" timeout="" uptake="" calls mode body first name="" cwd="" token
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from) from="$2"; shift 2 ;;
      --to) to="$2"; shift 2 ;;
      --file) file="$2"; shift 2 ;;
      --timeout) timeout="$2"; shift 2 ;;
      --uptake) uptake="$2"; shift 2 ;;
      *) echo "fixture panewire: unknown prompt flag $1" >&2; exit 2 ;;
    esac
  done
  calls=1
  if [[ -n "${WRK_PANEWIRE_PROMPT_LOG:-}" ]]; then
    printf 'prompt from=%s to=%s file=%s timeout=%s uptake=%s\n' "$from" "$to" "$file" "$timeout" "$uptake" >>"$WRK_PANEWIRE_PROMPT_LOG"
    calls="$(grep -c '^prompt ' "$WRK_PANEWIRE_PROMPT_LOG")"
    cp "$file" "$WRK_PANEWIRE_PROMPT_LOG.$calls" 2>/dev/null || true
  fi
  IFS=, read -r -a modes <<<"${WRK_PANEWIRE_PROMPT:-classify}"
  if (( calls > ${#modes[@]} )); then mode="${modes[${#modes[@]}-1]}"; else mode="${modes[$((calls-1))]}"; fi
  if [[ "$mode" == daemon-down ]]; then
    echo "panewired unavailable: /fixture/panewire.sock" >&2
    exit 4
  fi
  [[ -n "$from" && -n "$to" && "$file" == /* && -r "$file" && -n "$timeout" ]] || exit 5
  [[ "$uptake" == "" || "$uptake" == tool || "$uptake" == status-transition ]] || exit 5
  first="$(grep -m1 -v '^[[:space:]]*$' "$file" || true)"
  [[ "$first" == expect:* ]] || { echo "prompt file must begin with expect metadata" >&2; exit 5; }
  for token in ${first#expect:}; do
    case "$token" in
      name=*) name="${token#name=}" ;;
      cwd=*) cwd="${token#cwd=}" ;;
      label=*|title~=*|recent~=*) ;;
      *) if [[ "${WRK_PANEWIRE_STRICT_EXPECT:-0}" == 1 ]]; then
           echo "unknown expect field: ${token%%=*}" >&2
           exit 5
         fi ;;
    esac
  done
  body="$(awk 'found { print; next } /^expect:/ { found = 1 }' "$file" | sed '/./,$!d')"
  if [[ "$mode" == expect-fail || "$name" != "$to" ||
        ( -n "${WRK_PANEWIRE_PANE_CWD:-}" && "$cwd" != "$WRK_PANEWIRE_PANE_CWD" ) ]]; then
    echo "recipient identity does not match expect" >&2
    exit 5
  fi
  if [[ "$mode" == timeout ]]; then
    echo "timeout resolving target" >&2
    exit 3
  fi
  if [[ "$uptake" != "" ]] && "$HERDR_BIN" agent list 2>/dev/null | grep -q '"agent_status":"working"'; then
    echo "uptake_unproven: target is already working" >&2
    exit 6
  fi
  if [[ "$mode" == rejected-unsent ]]; then
    echo "herdr prompt rejected: fixture" >&2
    exit 6
  fi
  "$HERDR_BIN" agent prompt w:p1 "$body" >/dev/null 2>&1 || true
  case "$mode" in
    ok) exit 0 ;;
    unproven) echo "submission evidence unproven" >&2; exit 6 ;;
    composer) echo "prompt remains in composer" >&2; exit 6 ;;
    rejected) echo "herdr prompt rejected: fixture" >&2; exit 6 ;;
  esac
  local harness screen marker
  harness="$("$HERDR_BIN" agent list 2>/dev/null | python3 -c 'import json,sys; a=json.load(sys.stdin)["result"]["agents"]; print(next((x.get("agent","") for x in a if x.get("pane_id")=="w:p1"),""))' 2>/dev/null || true)"
  screen="$("$HERDR_BIN" agent read w:p1 --source recent-unwrapped --lines 200 2>/dev/null || true)"
  marker="$(printf '%s' "$body" | python3 -c 'import sys; print(sys.stdin.read().strip()[:24], end="")')"
  if [[ "$harness" == claude || "$harness" == codex ]] && [[ -n "$marker" ]] && grep -Fq -- "$marker" <<<"$screen"; then
    exit 0
  fi
  echo "submission evidence unproven" >&2
  exit 6
}

if [[ "${1:-}" == prompt ]]; then
  shift
  fixture_prompt "$@"
fi

# `panewire job` (#499). By default this fixture is a panewire older than the
# job command: the real binary answers an unknown subcommand with rc 2 and no
# output, which is what wrk must read as "keep your own path". Handled before
# WRK_PANEWIRE_LOG so the emit log of every other case stays exactly as it was.
#
#   WRK_PANEWIRE_JOB      absent (default) | present | garbage | hang
#   WRK_PANEWIRE_JOB_LOG  one line per delegated call: HOSTNAME, then argv
#   WRK_PANEWIRE_JOB_RC   exit code of a delegated call (default 0)
if [[ "${1:-}" == job ]]; then
  shift
  case "${WRK_PANEWIRE_JOB:-absent}" in
    absent) exit 2 ;;
    garbage) [[ "${1:-}" != probe ]] || echo "panewire-job/2"; exit 0 ;;
    hang) sleep 30; exit 0 ;;
  esac
  if [[ "${1:-}" == probe ]]; then
    echo "panewire-job/1"
    exit 0
  fi
  if [[ -n "${WRK_PANEWIRE_JOB_LOG:-}" ]]; then
    { printf 'HOSTNAME=%s' "${HOSTNAME-<unset>}"; printf ' [%s]' "$@"; printf '\n'; } >>"$WRK_PANEWIRE_JOB_LOG"
  fi
  echo "fixture job $*"
  exit "${WRK_PANEWIRE_JOB_RC:-0}"
fi

if [[ -n "${WRK_PANEWIRE_LOG:-}" ]]; then
  {
    for argument in "$@"; do printf '%s\n' "$argument"; done
    printf -- '--\n'
  } >>"$WRK_PANEWIRE_LOG"
fi

if [[ -n "${WRK_PANEWIRE_REQUIRE_INBOX_ROOT:-}" ]]; then
  has_inbox_root=0
  for argument in "$@"; do
    if [[ "$argument" == "--inbox-root" ]]; then
      has_inbox_root=1
      break
    fi
  done
  if [[ "$has_inbox_root" -eq 0 ]]; then
    exit 2
  fi
fi

[[ -z "${WRK_PANEWIRE_SLEEP:-}" ]] || sleep "$WRK_PANEWIRE_SLEEP"

exit "${WRK_PANEWIRE_RC:-0}"
