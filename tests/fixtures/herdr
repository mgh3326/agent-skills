#!/usr/bin/env bash
set -euo pipefail

scenario="${WRK_FIXTURE_SCENARIO:-spawn}"
if [[ -n "${WRK_FIXTURE_LOG:-}" ]]; then
  printf '%s\n' "$*" >>"$WRK_FIXTURE_LOG"
fi

# #609: which executable holds the pane foreground is the fixture's own
# state, not a function of the diagnostic call log — real herdr answers
# `pane process-info` from the pane whether or not a log exists, and
# plenty of spawn call sites set no WRK_FIXTURE_LOG. `agent start` and
# `pane run` record the foregrounded kind here; `pane process-info`
# reports it. Keyed by WRK_RUN_ID (one wrk process = one spawn attempt).
fixture_foreground_file="${TMPDIR:-/tmp}/wrk-fixture-fg-${WRK_RUN_ID:-standalone}"
fixture_set_foreground() { printf '%s\n' "$1" >"$fixture_foreground_file"; }
fixture_foreground() { cat "$fixture_foreground_file" 2>/dev/null || true; }

fixture_prompt_count() {
  [[ -n "${WRK_FIXTURE_LOG:-}" && -f "$WRK_FIXTURE_LOG" ]] || { printf '0\n'; return; }
  grep -c '^agent prompt ' "$WRK_FIXTURE_LOG" 2>/dev/null || true
}

fixture_recent_read_count() {
  [[ -n "${WRK_FIXTURE_LOG:-}" && -f "$WRK_FIXTURE_LOG" ]] || { printf '0\n'; return; }
  grep -c -- '--source recent-unwrapped' "$WRK_FIXTURE_LOG" 2>/dev/null || true
}

# The sentinel resolves herdr through the environment wrk pinned into it; record
# what actually arrived so a test can assert the forwarding rather than the
# spawner's intention.
fixture_log_env() {
  [[ -n "${WRK_FIXTURE_ENV_LOG:-}" ]] || return 0
  printf 'HERDR_SESSION=%s HERDR_SOCKET_PATH=%s\n' \
    "${HERDR_SESSION:-}" "${HERDR_SOCKET_PATH:-}" >>"$WRK_FIXTURE_ENV_LOG"
}

fixture_tab_of_pane() {
  printf '%s\n' "${1//:p/:t}"
}

# 실 herdr 응답 모양 그대로: 상태와 tab_id 는 result.agent 아래에 있다
# (2026-09-05 실측 — 옛 픽스처는 result 바로 아래에 뒀고, 그래서 잘못된 파서가
# 테스트를 통과한 채 프로덕션에서 항상 빈 상태를 봤다).
fixture_agent_get_result() {
  local pane="$1" status="$2"
  printf '{"id":"cli:agent:get","result":{"agent":{"agent":"codex","agent_status":"%s","pane_id":"%s","tab_id":"%s","workspace_id":"w"},"type":"agent_info"}}\n' \
    "$status" "$pane" "$(fixture_tab_of_pane "$pane")"
}

# 에러 봉투는 stderr 로 나가고 종료 코드는 1 이다 — 실 herdr 와 같다.
fixture_agent_get_error() {
  printf '{"error":{"code":"%s","message":"fixture %s"},"id":"cli:agent:get"}\n' "$1" "$1" >&2
  exit 1
}

# WRK_FIXTURE_GET_SEQUENCE 는 `agent get` 응답을 호출 순서대로 적은 파일이다.
# 한 줄에 하나: empty | exit1 | socket | not-found | garbage | <상태이름>.
# 줄이 소진되면 마지막 줄을 계속 반환한다.
fixture_get_sequence_step() {
  local pane="$1" calls index total token
  calls="${WRK_FIXTURE_GET_SEQUENCE}.calls"
  printf 'get\n' >>"$calls"
  index="$(awk 'END{print NR}' "$calls")"
  total="$(awk 'END{print NR}' "$WRK_FIXTURE_GET_SEQUENCE")"
  if [[ "$total" -eq 0 ]]; then return 0; fi
  if [[ "$index" -gt "$total" ]]; then index="$total"; fi
  token="$(awk -v n="$index" 'NR==n{print; exit}' "$WRK_FIXTURE_GET_SEQUENCE")"
  case "$token" in
    empty) : ;;
    exit1) exit 1 ;;
    socket) fixture_agent_get_error transport_unavailable ;;
    not-found) fixture_agent_get_error agent_not_found ;;
    garbage) printf '%s\n' 'fixture herdr: not json at all' ;;
    *) fixture_agent_get_result "$pane" "$token" ;;
  esac
}

fixture_is_recent_unwrapped_read() {
  [[ " $* " == *" --source recent-unwrapped "* ]]
}

fixture_prompt_injected() {
  (( $(fixture_prompt_count) >= 1 ))
}

fixture_visible_read_count() {
  [[ -n "${WRK_FIXTURE_LOG:-}" && -f "$WRK_FIXTURE_LOG" ]] || { printf '0\n'; return; }
  grep -c -- '--source visible' "$WRK_FIXTURE_LOG" 2>/dev/null || true
}

# grok landing scenarios: the pre-injection screen (no `agent prompt` in the
# log yet) and the post-injection screen are modeled separately, because the
# false positives a queued footer can cause all depend on that difference —
# the pane is shared, so a chip cannot be attributed to this injection.
# Returns 1 for non-grok scenarios so the generic chain continues.
fixture_grok_visible_screen() {
  case "$scenario" in
    grok-queued|grok-stale|grok-echo|grok-or-count|grok-toctou|grok-transient|grok-zero|grok-marker) ;;
    *) return 1 ;;
  esac
  if ! fixture_prompt_injected; then
    case "$scenario" in
      # Footer mid-repaint: a pre-existing queue is waiting but the `N queued`
      # suffix has not been painted into this read.
      grok-stale) printf '○ 1 command still running\n' ;;
      # Another sender's payload was already waiting, five deep on one line.
      grok-or-count) printf '○ 1 command still running · 5 queued, Enter to send now\n' ;;
      *) printf 'fixture welcome screen\n' ;;
    esac
  else
    case "$scenario" in
      # Self-echo: the pane renders whatever THIS injection actually
      # delivered, recorded from the `agent prompt` argument. The screen is a
      # function of the payload, never a canned string.
      grok-echo) printf 'echo of injection: %s\n' "$(cat "${WRK_FIXTURE_LOG}.payload" 2>/dev/null || true)" ;;
      # The queue actually shrank (5 → 1) yet chip lines grew 1 → 2.
      grok-or-count) printf '○ 1 queued, Enter to send now\n○ 1 queued, Enter to send now\n' ;;
      # The chip shows only on the first post-prompt visible read; later
      # reads render the same footer without the queued suffix.
      grok-transient)
        if (( $(fixture_visible_read_count) == 1 )); then
          printf '○ 1 command still running · 1 queued, Enter to send now\n'
        else
          printf '○ 1 command still running\n'
        fi ;;
      grok-zero) printf '○ 1 command still running · 0 queued, Enter to send now\n' ;;
      # grok-toctou: a different sender queued between the pre-prompt screen
      # and this injection — observably identical to our own queued chip.
      *) printf '○ 1 command still running · 1 queued, Enter to send now\n' ;;
    esac
  fi
}

fixture_brief_landed() {
  local prompts recent_reads
  prompts="$(fixture_prompt_count)"
  recent_reads="$(fixture_recent_read_count)"
  case "$scenario" in
    spawn|landing-marker|prompt-wait-fails|grok-marker|shell-busy|agent-late-foreground) return 0 ;;
    landing-retry|opencode-retry)
      if (( prompts >= 2 )); then return 0; fi
      ;;
    landing-delayed-marker)
      if (( recent_reads >= 3 )); then return 0; fi
      ;;
  esac
  return 1
}

# WRK_FIXTURE_AGENT_CWD adds herdr's `cwd` to every agent in `agent list`, in
# whatever spelling the test gives (logical or physical), as real herdr does.
if [[ "${1:-} ${2:-}" == "agent list" && -n "${WRK_FIXTURE_AGENT_CWD:-}" && -z "${WRK_FIXTURE_CWD_PASS:-}" ]]; then
  WRK_FIXTURE_CWD_PASS=1 WRK_FIXTURE_LOG="" "$0" "$@" |
    python3 -c 'import json,sys,os; d=json.load(sys.stdin); [a.__setitem__("cwd", os.environ["WRK_FIXTURE_AGENT_CWD"]) for a in d["result"]["agents"]]; print(json.dumps(d))'
  exit 0
fi

# Task 577 FIX: herdr has not yet detected a freshly `pane run` Devin as an
# agent, so get/wait/explain all answer agent_not_found (real envelope from
# devin-spawn-probe2 spawn.out and the 2026-09-22 disposable-pane poll).
# devin-late-detect detects the pane after WRK_FIXTURE_DEVIN_NOT_FOUND_COUNT
# (default 3) `agent get` calls; devin-never-detect never does.
if [[ "${1:-}" == agent && "${2:-}" =~ ^(get|wait|explain)$ &&
      "$scenario" =~ ^devin-(late|never)-detect$ ]]; then
  devin_gets=0
  if [[ -n "${WRK_FIXTURE_LOG:-}" && -f "$WRK_FIXTURE_LOG" ]]; then
    devin_gets="$(grep -c '^agent get ' "$WRK_FIXTURE_LOG" || true)"
  fi
  if [[ "$scenario" == devin-never-detect ||
        "$devin_gets" -le "${WRK_FIXTURE_DEVIN_NOT_FOUND_COUNT:-3}" ]]; then
    printf '{"error":{"code":"agent_not_found","message":"agent target %s not found"},"id":"cli:agent:%s"}\n' "${3:-}" "$2" >&2
    exit 1
  fi
fi

case "${1:-}" in
  agent)
    case "${2:-}" in
      list)
        case "$scenario" in
          find-name)
            printf '%s\n' '{"result":{"agents":[{"agent":"codex","agent_status":"working","name":"orch","pane_id":"w:p1","tab_id":"w:t1","workspace_id":"w"},{"agent":"kiro","agent_status":"idle","name":"","pane_id":"w:p2","tab_id":"w:t2","workspace_id":"w"}]}}'
            ;;
          name-priority)
            printf '%s\n' '{"result":{"agents":[{"agent":"codex","agent_status":"working","name":"target","pane_id":"w:p1","tab_id":"w:t1","workspace_id":"w"},{"agent":"kiro","agent_status":"idle","name":"","pane_id":"w:p2","tab_id":"w:t2","workspace_id":"w"}]}}'
            ;;
          find-label)
            printf '%s\n' '{"result":{"agents":[{"agent":"codex","agent_status":"idle","name":"other","pane_id":"w:p2","tab_id":"w:t2","workspace_id":"w"}]}}'
            ;;
          find-multi)
            printf '%s\n' '{"result":{"agents":[{"agent":"codex","agent_status":"idle","name":"","pane_id":"w:p2","tab_id":"w:t2","workspace_id":"w"},{"agent":"kiro","agent_status":"working","name":"","pane_id":"w:p3","tab_id":"w:t3","workspace_id":"w"}]}}'
            ;;
          name-sync)
            printf '%s\n' '{"result":{"agents":[{"agent":"codex","agent_status":"idle","name":"orch","pane_id":"w:p1","tab_id":"w:t1","workspace_id":"w"},{"agent":"codex","agent_status":"idle","name":"","pane_id":"w:p2","tab_id":"w:t2","workspace_id":"w"},{"agent":"codex","agent_status":"idle","name":"","pane_id":"w:p3","tab_id":"w:t3","workspace_id":"w"}]}}'
            ;;
          landing-marker|landing-retry|landing-no|landing-pasted|landing-observation-fails|opencode-retry|opencode-no|generic-idle-no-marker)
            printf '%s\n' '{"result":{"agents":[{"agent":"codex","agent_status":"idle","name":"fixture","pane_id":"w:p1","tab_id":"w:t1","workspace_id":"w"}]}}'
            ;;
          devin-idle|devin-wrong-rule|devin-wait-timeout|devin-late-detect|devin-shell-busy|devin-shell-busy-m1b|devin-shell-never-ready-m1b|devin-explain-no-rule|devin-explain-empty|devin-trust-screen|devin-read-fail|devin-explain-starting|devin-explain-starting-stuck|devin-explain-unknown)
            printf '%s\n' '{"result":{"agents":[{"agent":"devin","agent_status":"idle","name":"fixture","pane_id":"w:p1","tab_id":"w:t1","workspace_id":"w"}]}}'
            ;;
          # #568 incident shape: the brief landed and devin is working on it,
          # but panewire's classifier cannot prove devin submissions (rc 6).
          devin-working-no-marker|devin-queued)
            printf '%s\n' '{"result":{"agents":[{"agent":"devin","agent_status":"working","name":"fixture","pane_id":"w:p1","tab_id":"w:t1","workspace_id":"w"}]}}'
            ;;
          # #568 negative direction: the pane is absent from agent list, so
          # its status reads unknown — no positive evidence of any kind.
          # devin-wrapped-marker and devin-fold-collision share it so the
          # marker tests can only land via the marker itself, never via the
          # devin-status branch.
          devin-no-landing|devin-wrapped-marker|devin-fold-collision)
            printf '%s\n' '{"result":{"agents":[]}}'
            ;;
          devin-wrong-agent)
            printf '%s\n' '{"result":{"agents":[{"agent":"codex","agent_status":"idle","name":"","pane_id":"w:p1","tab_id":"w:t1","workspace_id":"w"}]}}'
            ;;
          devin-done)
            printf '%s\n' '{"result":{"agents":[{"agent":"devin","agent_status":"done","name":"fixture","pane_id":"w:p1","tab_id":"w:t1","workspace_id":"w"}]}}'
            ;;
          landing-working-no-marker|landing-delayed-marker|landing-scrollback-marker|grok-queued|grok-stale|grok-echo|grok-or-count|grok-toctou|grok-transient|grok-zero|grok-marker)
            printf '%s\n' '{"result":{"agents":[{"agent":"codex","agent_status":"working","name":"fixture","pane_id":"w:p1","tab_id":"w:t1","workspace_id":"w"}]}}'
            ;;
          *)
            printf '%s\n' '{"result":{"agents":[{"agent":"codex","agent_status":"working","name":"fixture","pane_id":"w:p1","tab_id":"w:t1","workspace_id":"w"}]}}'
            ;;
        esac
        ;;
      get)
        fixture_log_env
        if [[ "$scenario" == devin-get-error ]]; then
          fixture_agent_get_error transport_unavailable
        fi
        if [[ -n "${WRK_FIXTURE_GET_SEQUENCE:-}" && -f "${WRK_FIXTURE_GET_SEQUENCE}" ]]; then
          fixture_get_sequence_step "${3:-w:p1}"
          exit 0
        fi
        case "$scenario" in
          sentinel-working) fixture_agent_get_result "${3:-w:p1}" working ;;
          sentinel-idle) fixture_agent_get_result "${3:-w:p1}" idle ;;
          sentinel-done) fixture_agent_get_result "${3:-w:p1}" "done" ;;
          reap)
            # w:p2 는 아직 일하는 pane 이다. 나머지는 회수 가능한 상태.
            case "${3:-}" in
              w1:p2) fixture_agent_get_result "${3:-}" working ;;
              w1:p9) fixture_agent_get_error transport_unavailable ;;
              *) fixture_agent_get_result "${3:-w1:p1}" idle ;;
            esac
            ;;
          *) fixture_agent_get_result "${3:-w:p1}" working ;;
        esac
        ;;
      read)
        if [[ "$scenario" == landing-observation-fails ]]; then
          echo 'fixture: visible read unavailable' >&2
          exit 9
        fi
        # #568: the incident transcript — devin rendered the brief folded
        # across a line break, so a raw substring search never matches it.
        if [[ "$scenario" == devin-wrapped-marker ]]; then
          if fixture_is_recent_unwrapped_read "$@"; then
            printf '❭ fixture\n    prompt\n'
          else
            printf 'devin composer\n'
          fi
        # #568 adversarial: the marker's words in unrelated UI text — a line
        # break without indent mid-line, the same break at a line start, a UI
        # tab on one line, and an indented break mid-line. None reproduce
        # devin's submitted-prompt wrap shape (`❭ <text>` + indented
        # continuation at line start). Order matters: the old leftmost-match
        # matcher must hit a break-bearing variant first, or it returns before
        # ever evaluating the variants that distinguish it.
        elif [[ "$scenario" == devin-fold-collision ]]; then
          if fixture_is_recent_unwrapped_read "$@"; then
            printf 'more UI: fixture\nprompt settings\nfixture\nprompt settings\nfixture\tprompt settings\nlast UI: fixture\n    prompt settings\n'
          else
            printf 'devin composer\n'
          fi
        elif [[ "$scenario" == devin-queued ]]; then
          if fixture_is_recent_unwrapped_read "$@"; then
            printf 'devin transcript without the brief\n'
          else
            printf '── 1 queued ── ↑ edit · ↵ send now\n○ fixture brief body\n❭ Press Enter to send queued messages now\n'
          fi
        elif [[ "$scenario" == devin-working-no-marker || "$scenario" == devin-no-landing ]]; then
          printf 'devin working…\n'
        elif [[ "$scenario" == landing-scrollback-marker ]]; then
          if fixture_is_recent_unwrapped_read "$@"; then
            printf '%s\n' "${WRK_FIXTURE_MARKER:-fixture prompt}"
          else
            printf 'fixture output after prompt scrolled out\n'
          fi
        elif [[ "$scenario" == landing-pasted ]] && ! fixture_is_recent_unwrapped_read "$@"; then
          printf 'Pasted text\n'
        elif ! fixture_is_recent_unwrapped_read "$@" && fixture_grok_visible_screen; then
          :
        elif fixture_brief_landed; then
          printf '%s\n' "${WRK_FIXTURE_MARKER:-fixture prompt}"
        else
          printf 'fixture welcome screen\n'
        fi
        ;;
      rename)
        if [[ "$scenario" == devin-rename-fail ]]; then
          printf '%s\n' '{"error":{"code":"name_taken","message":"fixture rename failure"}}' >&2
          exit 6
        fi
        printf '%s\n' '{"result":{"agent_info":{"name":"renamed"}}}'
        ;;
      wait)
        if [[ "$scenario" == devin-wait-timeout ]]; then
          printf '%s\n' '{"error":{"code":"timeout","message":"fixture devin welcome timeout"}}' >&2
          exit 7
        fi
        fixture_agent_get_result "${3:-w:p1}" idle
        ;;
      explain)
        case "$scenario" in
          devin-explain-fail)
            printf '%s\n' '{"error":{"code":"transport_unavailable","message":"fixture explain failure"}}' >&2
            exit 4
            ;;
          devin-explain-garbage)
            printf '%s\n' 'not json at all'
            ;;
          # #604 (CodeRabbit #122): explain can exit 0 with EMPTY stdout — a
          # supplied failing response, not an absent one. The first call prints
          # nothing; if a preservation keyed on "nonempty" re-queries, the
          # second call answers a well-formed envelope so the overwrite shows
          # up in the artifact.
          devin-explain-empty)
            explains="$(grep -c '^agent explain ' "${WRK_FIXTURE_LOG:-/dev/null}" 2>/dev/null || true)"
            if [[ "$explains" -gt 1 ]]; then
              printf '%s\n' '{"agent":"devin","matched_rule":{"id":"welcome_prompt_footer","priority":120,"region":"bottom_non_empty_lines(8)","state":"idle"},"state":"idle"}'
            fi
            ;;
          # #604: the 2026-09-23 incident shape — a well-formed envelope whose
          # matched_rule is absent because no identity rule claimed the screen
          # (first-open trust prompt hypothesis). Since #649 this bare envelope
          # carries no evaluated_rules to prove the screen is just the command
          # line, so it classifies "unmatched" and is polled to the window.
          devin-explain-no-rule|devin-read-fail)
            printf '%s\n' '{"agent":"devin","matched_rule":null,"state":"idle"}'
            ;;
          # #649 (m1b): devin's TUI is still painting — every identity rule is
          # unmatched and the evaluated region holds only the typed command
          # line (the exact argv wrk runs for devin-swe2). The first
          # WRK_FIXTURE_DEVIN_STARTING_COUNT (default 3) explains answer that
          # shape, then the welcome footer appears.
          devin-explain-starting)
            explains="$(grep -c '^agent explain ' "${WRK_FIXTURE_LOG:-/dev/null}" 2>/dev/null || true)"
            if [[ "$explains" -le "${WRK_FIXTURE_DEVIN_STARTING_COUNT:-3}" ]]; then
              printf '%s\n' '{"agent":"devin","matched_rule":null,"state":"idle","evaluated_rules":[{"id":"welcome_prompt_footer","matched":false,"priority":120,"region":"bottom_non_empty_lines(8)","state":"idle","evidence":{"region_bytes":110,"region_preview":"~ % devin --model swe-2 --permission-mode dangerous --respect-workspace-trust false"}}]}'
            else
              printf '%s\n' '{"agent":"devin","matched_rule":{"id":"welcome_prompt_footer","priority":120,"region":"bottom_non_empty_lines(8)","state":"idle"},"state":"idle"}'
            fi
            ;;
          # The same command-line-only screen, but it never resolves — the
          # window must close and the spawn must fail closed.
          devin-explain-starting-stuck)
            printf '%s\n' '{"agent":"devin","matched_rule":null,"state":"idle","evaluated_rules":[{"id":"welcome_prompt_footer","matched":false,"priority":120,"region":"bottom_non_empty_lines(8)","state":"idle","evidence":{"region_bytes":110,"region_preview":"~ % devin --model swe-2 --permission-mode dangerous --respect-workspace-trust false"}}]}'
            ;;
          # Unmatched rules AND the evaluated region is not the command line —
          # a genuinely unexpected pane. Also polled to the window, then fails.
          devin-explain-unknown)
            printf '%s\n' '{"agent":"devin","matched_rule":null,"state":"idle","evaluated_rules":[{"id":"welcome_prompt_footer","matched":false,"priority":120,"region":"bottom_non_empty_lines(8)","state":"idle","evidence":{"region_bytes":512,"region_preview":"some unexpected screen the rules do not know"}}]}'
            ;;
          # #604 hypothesis variant: a rule did match — the trust prompt — so
          # the identity check fails on the rule id, and only the preserved
          # screen shows what the pane was actually asking.
          devin-trust-screen)
            printf '%s\n' '{"agent":"devin","matched_rule":{"id":"trust_directory","priority":130,"region":"bottom_non_empty_lines(8)","state":"idle"},"state":"idle"}'
            ;;
          devin-wrong-agent)
            printf '%s\n' '{"agent":"codex","matched_rule":{"id":"welcome_prompt_footer","priority":120,"region":"bottom_non_empty_lines(8)","state":"idle"},"state":"idle"}'
            ;;
          devin-wrong-rule)
            printf '%s\n' '{"agent":"devin","matched_rule":{"id":"live_prompt_footer","priority":100,"region":"bottom_non_empty_lines(6)","state":"idle"},"state":"idle"}'
            ;;
          *)
            # Real `herdr agent explain <pane> --format json` envelope shape,
            # sampled from a live Devin 3000.11.1 welcome screen on 2026-09-22.
            printf '%s\n' '{"agent":"devin","matched_rule":{"id":"welcome_prompt_footer","priority":120,"region":"bottom_non_empty_lines(8)","state":"idle"},"state":"idle"}'
            ;;
        esac
        ;;
      start)
        # #606: real herdr 0.9.0 envelope on stderr, rc=1 (captured 2026-09-23
        # from `agent start` against a pane whose foreground was not the shell).
        # shell-busy answers agent_pane_busy for the first
        # WRK_FIXTURE_SHELL_BUSY_COUNT (default 3) starts; shell-never-ready always.
        case "$scenario" in
          shell-busy|shell-never-ready)
            shell_starts="$(grep -c '^agent start ' "${WRK_FIXTURE_LOG:-/dev/null}" || true)"
            if [[ "$scenario" == shell-never-ready ||
                  "$shell_starts" -le "${WRK_FIXTURE_SHELL_BUSY_COUNT:-3}" ]]; then
              printf '{"error":{"code":"agent_pane_busy","message":"agent target pane %s is not an available shell"},"id":"cli:agent:start"}\n' "${7:-w:p1}" >&2
              exit 1
            fi
            ;;
          start-not-ready)
            printf '%s\n' '{"error":{"code":"agent_not_ready","message":"agent fixture is blocked during startup"},"id":"cli:agent:start"}' >&2
            exit 1
            ;;
          start-pane-unavailable)
            printf '%s\n' '{"error":{"code":"agent_pane_unavailable","message":"fixture pane unavailable"},"id":"cli:agent:start"}' >&2
            exit 3
            ;;
        esac
        # A successful start foregrounds the agent's own executable — the
        # canonical --kind (herdr's kind IS the binary name).
        start_kind="$(sed -n 's/.* --kind \([^ ]*\).*/\1/p' <<<" $*")"
        [[ -z "$start_kind" ]] || fixture_set_foreground "$start_kind"
        printf '%s\n' '{"result":{"agent_info":{"agent_status":"working"}}}'
        ;;
      send-keys)
        printf '%s\n' '{"result":{"agent_info":{"agent_status":"working"}}}'
        ;;
      prompt)
        printf '%s\n' '{"result":{"agent_info":{"agent_status":"working"}}}'
        # Record the delivered payload ($4: after `agent prompt <pane>`) so a
        # scenario can render the pane's self-echo of THIS injection.
        [[ -z "${WRK_FIXTURE_LOG:-}" ]] || printf '%s' "${4:-}" >"${WRK_FIXTURE_LOG}.payload" 2>/dev/null || true
        if [[ "$scenario" == prompt-wait-fails && "${5:-}" == --wait ]]; then
          exit 7
        fi
        ;;
      *) printf '%s\n' '{"result":{}}' ;;
    esac
    ;;
  tab)
    case "${2:-}" in
      create)
        if [[ "$scenario" == tab-create-fails ]]; then
          echo 'fixture herdr: tab create failed' >&2
          exit 9
        fi
        # A fresh tab holds a fresh shell — clear any foreground state a
        # same-PID predecessor run left behind.
        rm -f "$fixture_foreground_file"
        printf '%s\n' '{"result":{"tab_id":"w:t1","root_pane":{"pane_id":"w:p1"}}}'
        ;;
      close)
        rm -f "$fixture_foreground_file"
        printf '%s\n' '{"result":{"closed":"'"${3:-}"'"}}'
        ;;
      list)
        case "$scenario" in
          find-name)
            printf '%s\n' '{"result":{"tabs":[{"tab_id":"w:t1","label":"different","workspace_id":"w"},{"tab_id":"w:t2","label":"other","workspace_id":"w"}]}}'
            ;;
          find-label)
            printf '%s\n' '{"result":{"tabs":[{"tab_id":"w:t2","label":"target","workspace_id":"w"}]}}'
            ;;
          find-multi)
            printf '%s\n' '{"result":{"tabs":[{"tab_id":"w:t2","label":"target","workspace_id":"w"},{"tab_id":"w:t3","label":"target","workspace_id":"w"}]}}'
            ;;
          name-priority)
            printf '%s\n' '{"result":{"tabs":[{"tab_id":"w:t1","label":"other","workspace_id":"w"},{"tab_id":"w:t2","label":"target","workspace_id":"w"}]}}'
            ;;
          name-sync)
            printf '%s\n' '{"result":{"tabs":[{"tab_id":"w:t1","label":"orch","workspace_id":"w"},{"tab_id":"w:t2","label":"2","workspace_id":"w"},{"tab_id":"w:t3","label":"build","workspace_id":"w"}]}}'
            ;;
          reap)
            # WRK_FIXTURE_REAP_TABS 는 탭 목록이 믿을 수 없는 날을 흉내 낸다. 어느 경우든
            # reap 은 "공유일 수 있음" 으로 보고 닫지 않아야 한다(fail-closed).
            case "${WRK_FIXTURE_REAP_TABS:-}" in
              fail) echo '{"error":{"code":"transport_unavailable","message":"fixture tab list"}}' >&2; exit 1 ;;
              garbage) printf 'not json at all\n'; exit 0 ;;
              no-result) printf '%s\n' '{"error":null}'; exit 0 ;;
              missing) printf '%s\n' '{"result":{"tabs":[{"tab_id":"w1:t4","pane_count":2,"workspace_id":"w1"}]}}'; exit 0 ;;
              no-count) printf '%s\n' '{"result":{"tabs":[{"tab_id":"w1:t1","workspace_id":"w1"}]}}'; exit 0 ;;
              string-count) printf '%s\n' '{"result":{"tabs":[{"tab_id":"w1:t1","pane_count":"1","workspace_id":"w1"}]}}'; exit 0 ;;
              bool-count) printf '%s\n' '{"result":{"tabs":[{"tab_id":"w1:t1","pane_count":true,"workspace_id":"w1"}]}}'; exit 0 ;;
              zero-count) printf '%s\n' '{"result":{"tabs":[{"tab_id":"w1:t1","pane_count":0,"workspace_id":"w1"}]}}'; exit 0 ;;
              duplicate) printf '%s\n' '{"result":{"tabs":[{"tab_id":"w1:t1","pane_count":1,"workspace_id":"w1"},{"tab_id":"w1:t1","pane_count":2,"workspace_id":"w1"}]}}'; exit 0 ;;
              race)
                # 다른 pane 이 reap 의 `agent get w1:p18` 과 close 사이에 w1:t18 로 합류한다.
                # 그 전에 찍은 목록은 1, 그 뒤에 읽은 목록은 2 다.
                count=1
                if [[ -n "${WRK_FIXTURE_LOG:-}" ]] && grep -q '^agent get w1:p18$' "$WRK_FIXTURE_LOG"; then
                  count=2
                fi
                printf '{"result":{"tabs":[{"tab_id":"w1:t18","label":"reap-race","pane_count":%s,"workspace_id":"w1"}]}}\n' "$count"
                exit 0 ;;
            esac
            # w1:t4 는 pane 이 분할된 탭이다 — 닫으면 옆 pane 이 함께 죽는다.
            printf '%s\n' '{"result":{"tabs":[{"tab_id":"w1:t10","label":"reap-revived","pane_count":1,"workspace_id":"w1"},{"tab_id":"w1:t11","label":"reap-revived-spawn","pane_count":1,"workspace_id":"w1"},{"tab_id":"w1:t12","label":"reap-revived-done","pane_count":1,"workspace_id":"w1"},{"tab_id":"w1:t13","label":"reap-b505-shape","pane_count":1,"workspace_id":"w1"},{"tab_id":"w1:t14","label":"reap-mixed-old","pane_count":1,"workspace_id":"w1"},{"tab_id":"w1:t15","label":"reap-mixed-new","pane_count":1,"workspace_id":"w1"},{"tab_id":"w1:t16","label":"reap-moved-actual","pane_count":1,"workspace_id":"w1"},{"tab_id":"w1:t17","label":"reap-moved-recorded","pane_count":1,"workspace_id":"w1"},{"tab_id":"w1:t1","label":"reap-ready","pane_count":1,"workspace_id":"w1"},{"tab_id":"w1:t2","label":"reap-working","pane_count":1,"workspace_id":"w1"},{"tab_id":"w1:t4","label":"reap-shared","pane_count":2,"workspace_id":"w1"},{"tab_id":"w1:t5","label":"reap-no-tab","pane_count":1,"workspace_id":"w1"},{"tab_id":"w1:t6","label":"reap-lost-only","pane_count":1,"workspace_id":"w1"},{"tab_id":"w1:t7","label":"reap-captain-reclaimed","pane_count":1,"workspace_id":"w1"},{"tab_id":"w1:t8","label":"reap-poisoned","pane_count":1,"workspace_id":"w1"}]}}'
            ;;
          *) printf '%s\n' '{"result":{"tabs":[]}}' ;;
        esac
        ;;
    esac
    ;;
  workspace)
    printf '%s\n' '{"result":{"workspaces":[{"workspace_id":"w"}]}}'
    ;;
  pane)
    # #606: real `pane process-info` envelope shape (herdr 0.9.0, 2026-09-23
    # disposable pane). By default the shell holds the foreground alone.
    # devin-shell-busy shows an rc subprocess in the foreground for the first
    # WRK_FIXTURE_SHELL_BUSY_COUNT (default 3) calls; devin-shell-never-ready
    # always does.
    # #609: once this spawn's own `pane run`/`agent start` was accepted, the
    # pane foreground is the agent (real 0.9.1 shape measured 2026-09-24:
    # argv0 is the canonical executable, the group leader is the agent pid).
    # agent-never-foreground keeps answering shell-alone after an accepted
    # start (the m1b "zsh: command not found: codex" shape); agent-late-
    # foreground answers shell-alone for WRK_FIXTURE_FOREGROUND_DELAY (2)
    # calls first; agent-foreground-other keeps an unrelated process in the
    # foreground.
    if [[ "${2:-}" == process-info ]]; then
      case "$scenario" in
        devin-process-info-fail|agent-foreground-info-fail)
          printf '%s\n' '{"error":{"code":"pane_not_found","message":"fixture process-info failure"},"id":"cli:pane:process_info"}' >&2
          exit 3
          ;;
        devin-process-info-garbage|agent-foreground-garbage)
          printf '%s\n' '{"id":"cli:pane:process_info","result":{"process_info":{"pane_id":"w:p1","shell_pid":"4242"}}}'
          exit 0
          ;;
        agent-never-foreground)
          printf '%s\n' '{"id":"cli:pane:process_info","result":{"process_info":{"foreground_process_group_id":4242,"foreground_processes":[{"argv":["-zsh"],"argv0":"-zsh","cmdline":"-zsh","cwd":"/tmp","name":"zsh","pid":4242}],"pane_id":"w:p1","shell_pid":4242},"type":"pane_process_info"}}'
          exit 0
          ;;
        agent-foreground-other)
          printf '%s\n' '{"id":"cli:pane:process_info","result":{"process_info":{"foreground_process_group_id":4300,"foreground_processes":[{"argv":["vim","notes.txt"],"argv0":"vim","cmdline":"vim notes.txt","cwd":"/tmp","name":"vim","pid":4300}],"pane_id":"w:p1","shell_pid":4242},"type":"pane_process_info"}}'
          exit 0
          ;;
      esac
      infos="$(grep -c '^pane process-info ' "${WRK_FIXTURE_LOG:-/dev/null}" 2>/dev/null || true)"
      if [[ "$scenario" == agent-late-foreground &&
            "$infos" -le "${WRK_FIXTURE_FOREGROUND_DELAY:-2}" ]]; then
        printf '%s\n' '{"id":"cli:pane:process_info","result":{"process_info":{"foreground_process_group_id":4242,"foreground_processes":[{"argv":["-zsh"],"argv0":"-zsh","cmdline":"-zsh","cwd":"/tmp","name":"zsh","pid":4242}],"pane_id":"w:p1","shell_pid":4242},"type":"pane_process_info"}}'
        exit 0
      fi
      busy=0
      case "$scenario" in
        devin-shell-never-ready|devin-shell-never-ready-m1b) busy=1 ;;
        devin-shell-busy|devin-shell-busy-m1b)
          [[ "$infos" -le "${WRK_FIXTURE_SHELL_BUSY_COUNT:-3}" ]] && busy=1 ;;
      esac
      agent_kind="$(fixture_foreground)"
      if [[ -n "$agent_kind" ]]; then
        # name is the agent's version string on a real pane (live 0.9.1:
        # claude -> name "2.1.281"), never the kind — so a matcher that
        # reads name instead of argv0/cmdline is caught by the tests.
        printf '{"id":"cli:pane:process_info","result":{"process_info":{"foreground_process_group_id":4300,"foreground_processes":[{"argv":["%s"],"argv0":"%s","cmdline":"%s","cwd":"/tmp","name":"9.9.9","pid":4300}],"pane_id":"w:p1","shell_pid":4242},"type":"pane_process_info"}}\n' \
          "$agent_kind" "$agent_kind" "$agent_kind"
        exit 0
      fi
      if [[ "$scenario" == *-m1b ]]; then
        # #604/m1b (hk:doc evidence/2026-09-24/task604-m1b-repro): the m1b
        # herdr 0.9.0 reply has no "result" wrapper and no
        # foreground_process_group_id — but still names shell_pid and the
        # foreground list. While the foreground is an rc-file subprocess
        # (oh-my-zsh compinit's .zcompdump grep) the shell is not ready.
        if [[ "$busy" -eq 1 ]]; then
          printf '%s\n' '{"process_info":{"foreground_processes":[{"argv":["grep","-q","-Fx","#omz fpath: /Users/operator/.zcompdump"],"argv0":"grep","cmdline":"grep -q -Fx #omz fpath: /Users/operator/.zcompdump","cwd":"/Users/operator","name":"grep","pid":4250}],"shell_pid":4242}}'
        else
          printf '%s\n' '{"process_info":{"foreground_processes":[{"argv":["-zsh"],"argv0":"-zsh","cmdline":"-zsh","cwd":"/Users/operator","name":"zsh","pid":4242}],"shell_pid":4242}}'
        fi
      elif [[ "$busy" -eq 1 ]]; then
        printf '%s\n' '{"id":"cli:pane:process_info","result":{"process_info":{"foreground_process_group_id":4250,"foreground_processes":[{"argv":["git","rev-parse","--show-toplevel"],"argv0":"git","cmdline":"git rev-parse --show-toplevel","cwd":"/tmp","name":"git","pid":4250}],"pane_id":"w:p1","shell_pid":4242},"type":"pane_process_info"}}'
      else
        printf '%s\n' '{"id":"cli:pane:process_info","result":{"process_info":{"foreground_process_group_id":4242,"foreground_processes":[{"argv":["-zsh"],"argv0":"-zsh","cmdline":"-zsh","cwd":"/tmp","name":"zsh","pid":4242}],"pane_id":"w:p1","shell_pid":4242},"type":"pane_process_info"}}'
      fi
      exit 0
    fi
    if [[ "${2:-}" == close ]]; then
      rm -f "$fixture_foreground_file"
    fi
    if [[ "${2:-}" == read ]]; then
      if [[ "$scenario" == devin-read-fail ]]; then
        printf 'fixture: pane read unavailable\n' >&2
        exit 9
      fi
      case "$scenario" in
        devin-trust-screen) printf 'Do you trust the contents of this directory?\n' ;;
        *) printf 'fixture welcome screen\n' ;;
      esac
      printf 'ACTUAL SCREEN LAST LINE\n'
      exit 0
    fi
    if [[ "${2:-}" == run && "$scenario" == devin-run-fail ]]; then
      printf '%s\n' '{"error":{"code":"pane_not_found","message":"fixture pane run failure"}}' >&2
      exit 5
    fi
    # A successful `pane run` is how the devin agent reaches the pane — it
    # foregrounds the devin executable.
    if [[ "${2:-}" == run ]]; then fixture_set_foreground devin; fi
    printf 'fixture pane %s\nACTUAL SCREEN LAST LINE\n' "${3:-unknown}"
    ;;
esac
