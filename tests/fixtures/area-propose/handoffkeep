#!/usr/bin/env python3
# hk 1941 test fixture: a stub handoffkeep binary serving the read/write
# slice director/bin/area-propose uses — `tasks areas` (vocabulary),
# `tasks list --state S [--limit N]` (per-state task reads; truncates at 20
# rows without --limit, like the real CLI), `tasks show <id>` (per-task
# re-read before apply writes) and `tasks set-area <id> <area> [--note N]`
# (the single write). State lives in one JSON file per test (HK_STATE);
# every invocation appends one `call <argv>` line to HK_LOG and every
# set-area mutation runs under an flock on the state file.
#
#   WRK_TEST_MODE      required: must be "1" or every call dies rc 2 — the
#                      stub must never answer in a real context
#   HK_STATE           required: JSON db {"areas": [...], "tasks": {"<id>": {fields}}}
#   HK_LOG             optional: append `call <argv>` for every invocation
#   HK_MODE            ok (default)
#                      down     every call: 'handoffkeep: connection refused' rc1
#
# `show` mirrors the real CLI: task JSON to stdout, or 'handoffkeep:
# not_found' on stderr rc1, 'handoffkeep: task id must be positive' for a
# bad id. `set-area` validates against the db's own `areas` list: an
# unknown value is 'handoffkeep: invalid_request' rc1, the real server's
# answer for a value outside the closed vocabulary.
import fcntl
import json
import os
import sys

ERR = "handoffkeep: "


def die(msg, rc=1):
    print(ERR + msg, file=sys.stderr)
    sys.exit(rc)


def load(state_path):
    try:
        with open(state_path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return {"tasks": {}}
    except (OSError, json.JSONDecodeError):
        die("fixture state unreadable", 2)


def save(state_path, db):
    tmp = state_path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(db, f, separators=(",", ":"))
    os.replace(tmp, state_path)


def task_or_not_found(db, tid):
    t = db.get("tasks", {}).get(tid)
    if t is None:
        die("not_found")
    return t


def task_id_arg(argv, i):
    if i >= len(argv):
        die("task command requires id", 2)
    tid = argv[i]
    if not tid.isdigit() or int(tid) < 1:
        die("task id must be positive")
    return tid


MODE = os.environ.get("HK_MODE", "ok")
STATE = os.environ.get("HK_STATE")
LOG = os.environ.get("HK_LOG")

if os.environ.get("WRK_TEST_MODE") != "1":
    die("fixture refuses to run outside WRK_TEST_MODE", 2)
if MODE == "down":
    die("connection refused")
if not STATE:
    die("fixture HK_STATE unset", 2)


def log_call(argv):
    if LOG:
        with open(LOG, "a", encoding="utf-8") as f:
            f.write("call " + " ".join(argv) + "\n")


def main():
    argv = sys.argv[1:]
    log_call(argv)
    if len(argv) < 2 or argv[0] != "tasks":
        die("invalid_context", 2)
    cmd = argv[1]

    if cmd == "areas":
        print(json.dumps({"areas": load(STATE).get("areas", [])},
                         separators=(",", ":")))
        return

    if cmd == "list":
        state_filter = None
        limit = 20
        i = 2
        while i < len(argv):
            a = argv[i]
            if i + 1 >= len(argv):
                die(f"flag needs an argument: {a}", 2)
            if a == "--state":
                state_filter = argv[i + 1]
            elif a == "--limit":
                try:
                    limit = int(argv[i + 1])
                except ValueError:
                    die("invalid limit", 2)
            else:
                die(f"flag provided but not defined: {a.lstrip('-')}", 2)
            i += 2
        db = load(STATE)
        tasks = [t for _, t in sorted(db.get("tasks", {}).items(),
                                      key=lambda kv: int(kv[0]))]
        if state_filter is not None:
            known = {"backlog", "claimed", "in_progress", "verifying",
                     "join", "hold", "needs_decision", "merged", "dropped"}
            if state_filter not in known:
                die("invalid_context")
            tasks = [t for t in tasks if t.get("state") == state_filter]
        print(json.dumps({"tasks": tasks[:limit]}, separators=(",", ":")))
        return

    if cmd == "show":
        tid = task_id_arg(argv, 2)
        print(json.dumps(task_or_not_found(load(STATE), tid),
                         separators=(",", ":")))
        return

    if cmd == "set-area":
        # set-area <id> <area> [--note <reason>] | set-area <id> --clear [--note <reason>]
        tid = task_id_arg(argv, 2)
        area = None
        clear = False
        note = ""
        i = 3
        while i < len(argv):
            a = argv[i]
            if a == "--note":
                if i + 1 >= len(argv):
                    die("flag needs an argument: --note", 2)
                note = argv[i + 1]
                i += 2
            elif a == "--clear":
                clear = True
                i += 1
            elif a.startswith("-"):
                die(f"flag provided but not defined: {a.lstrip('-')}", 2)
            elif area is None:
                area = a
                i += 1
            else:
                die("unexpected argument", 2)
        if clear == (area is not None):
            die("usage: tasks set-area <id> <area> [--note <reason>] | tasks set-area <id> --clear [--note <reason>]", 2)
        lock_path = STATE + ".lock"
        with open(lock_path, "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            db = load(STATE)
            t = task_or_not_found(db, tid)
            if not clear and area not in db.get("areas", []):
                die("invalid_request")
            old = t.get("area")
            new = None if clear else area
            if old != new:
                t["area"] = new
                t.setdefault("events", []).append(
                    {"kind": "set-area", "from": old, "to": new,
                     "note": note})
                save(STATE, db)
        print(json.dumps(t, separators=(",", ":")))
        return

    die(f"unknown tasks command {cmd}", 2)


if __name__ == "__main__":
    main()
