#!/usr/bin/env python3
# hk 1941 test fixture: a stub `gh` answering `gh pr view <ref> --json
# files` from a canned map. GH_STUB_JSON names a JSON file
# {"<pr ref>": {"files": [{"path": ..., "additions": n, "deletions": n}]}}
# — the ref key is the exact argv string the tool passes. An unknown ref
# exits rc 1 with a stderr line like the real CLI's lookup failure. Every
# invocation appends one `call <argv>` line to GH_LOG.
import json
import os
import sys

if os.environ.get("WRK_TEST_MODE") != "1":
    print("gh fixture refuses to run outside WRK_TEST_MODE", file=sys.stderr)
    sys.exit(2)

LOG = os.environ.get("GH_LOG")
if LOG:
    with open(LOG, "a", encoding="utf-8") as f:
        f.write("call " + " ".join(sys.argv[1:]) + "\n")

stub_path = os.environ.get("GH_STUB_JSON")
if not stub_path:
    print("gh fixture GH_STUB_JSON unset", file=sys.stderr)
    sys.exit(2)

argv = sys.argv[1:]
if len(argv) >= 4 and argv[0] == "pr" and argv[1] == "view" and argv[3] == "--json" and argv[4:] == ["files"]:
    with open(stub_path, encoding="utf-8") as f:
        table = json.load(f)
    ref = argv[2]
    if ref not in table:
        print(f"no pull requests found for {ref}", file=sys.stderr)
        sys.exit(1)
    print(json.dumps(table[ref], separators=(",", ":")))
    sys.exit(0)

print("gh fixture: unsupported argv", file=sys.stderr)
sys.exit(2)
