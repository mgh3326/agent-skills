#!/usr/bin/env bash
# Fake handoffkeep binary. `version --json` exists only when hk-mode allows it;
# any other mode (or argv) fails like the older binary's usage error. The JSON
# mirrors the real #958 output: EVERY field is a JSON string, including
# modified ("true"/"false").
#
#   $HOME/.fleet-rev/hk-mode      json    -> answer version --json (string fields)
#                                 badjson -> print malformed JSON, still rc 0
#                                 anything else -> usage error rc 1
#   $HOME/.fleet-rev/hk-rev       rev field for the JSON answer
#   $HOME/.fleet-rev/hk-modified  modified field, as a string (default "false")
set -euo pipefail

mode="$(cat "$HOME/.fleet-rev/hk-mode" 2>/dev/null || printf 'old')"
if [[ "${1:-}" == "version" && "${2:-}" == "--json" ]]; then
  case "$mode" in
    json)
      rev="$(cat "$HOME/.fleet-rev/hk-rev")"
      mod="$(cat "$HOME/.fleet-rev/hk-modified" 2>/dev/null || printf 'false')"
      printf '{"rev":"%s","time":"2026-09-29T09:42:21Z","modified":"%s","module":"v0.0.0-20260929094221-3a98be047c52","go":"go1.27.1"}\n' "$rev" "$mod"
      exit 0
      ;;
    badjson)
      printf '{not-json rev="%s" modified=%s\n' "$(cat "$HOME/.fleet-rev/hk-rev" 2>/dev/null || echo x)" "$mode"
      exit 0
      ;;
  esac
fi
echo "handoffkeep: usage: handoffkeep serve|mcp|ctx|memory|doc|attach|r2usage|tasks|decisions|linear|fleet-metrics" >&2
exit 1
