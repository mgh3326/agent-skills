#!/usr/bin/env bash
# Fake gh for fleet-rev tests. Answers the two `gh api` shapes fleet-rev uses
# from fixture files under FLEET_REV_FAKE_GH_DIR:
#
#   <repo>.main      one line: the sha `commits/main` should return
#   <repo>.compare   lines: "<installed> <status> <ahead_by>"; '*' matches any
#                    installed sha; no match -> 'gh: Not Found (HTTP 404)' rc1
#
#   FLEET_REV_GH_LOG         append one argv line per call (default /dev/null)
set -euo pipefail

printf '%s\n' "$*" >>"${FLEET_REV_GH_LOG:-/dev/null}"
dir="${FLEET_REV_FAKE_GH_DIR:?}"
[[ "${1:-}" == "api" ]] || { echo "fake gh: expected 'api'" >&2; exit 3; }
endpoint="${2:?fake gh: missing endpoint}"

case "$endpoint" in
  repos/mgh3326/*/commits/main)
    repo="${endpoint#repos/mgh3326/}"
    repo="${repo%/commits/main}"
    f="$dir/$repo.main"
    [[ -f "$f" ]] || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
    cat "$f"
    ;;
  repos/mgh3326/*/compare/*...main)
    rest="${endpoint#repos/mgh3326/}"
    repo="${rest%%/compare/*}"
    base="${endpoint##*/compare/}"
    base="${base%...main}"
    f="$dir/$repo.compare"
    if [[ -f "$f" ]]; then
      while read -r b s n _; do
        [[ -z "${b:-}" || "$b" == \#* ]] && continue
        if [[ "$b" == "$base" || "$b" == "*" ]]; then
          printf '%s %s\n' "$s" "${n:-0}"
          exit 0
        fi
      done <"$f"
    fi
    echo "gh: Not Found (HTTP 404)" >&2
    exit 1
    ;;
  *)
    echo "fake gh: unsupported endpoint: $endpoint" >&2
    exit 3
    ;;
esac
