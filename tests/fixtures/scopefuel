#!/usr/bin/env bash
set -euo pipefail

# ROB-1199: pool 정본. 실제 scopefuel 의 recommend.profile_pool() 과 같은 갈래만 흉내낸다
# (fixture 전용 — 프로덕션 매핑은 scopefuel 하나가 소유한다).
pool_for() {
  case "$1" in
    opus|sonnet|fable|haiku) echo claude ;;
    codex*) echo codex ;;
    oc-gflash|oc-sonnet46|oc-oss) echo agy ;;
    oc-omni) echo omniroute ;;
    oc-*) echo clinepass ;;
    grok|grok-hi|grok-med) echo grok ;;
    *) echo "" ;;
  esac
}

if [[ "${1:-}" == --json ]]; then
  json_rc=0
  schema_value=scopefuel.v1
  providers='[{"id":"claude"},{"id":"codex"},{"id":"agy"},{"id":"clinepass"},{"id":"grok"},{"id":"omniroute"}]'
  case "${WRK_SCOPEFUEL_JSON_MODE:-ok}" in
    broken) echo 'scopefuel: json fetch failed' >&2; exit 7 ;;
    garbage) echo 'not json at all'; exit 0 ;;
    degraded) json_rc=1 ;;
    drift) providers='[{"id":"claude"}]' ;;
    empty) providers='[]' ;;
    schema) schema_value=scopefuel.v0 ;;
    *) : ;;
  esac
  printf '{"schema":"%s","generated_at":"2026-08-01T00:00:00+00:00","summary":{"mark":"ok","usage_mark":"ok"},"providers":%s}\n' "$schema_value" "$providers"
  exit "$json_rc"
fi

if [[ "${1:-}" == gate && "${2:-}" == --help ]]; then
  case "${WRK_GATE_MODE:-ok}" in
    unsupported) echo 'error: unknown command: gate' >&2; exit 2 ;;
    broken) echo 'scopefuel: internal probe failure' >&2; exit 7 ;;
    *) echo 'usage: scopefuel gate -m PROFILE'; exit 0 ;;
  esac
fi

if [[ "${1:-}" == refresh ]]; then
  pool="${2:-}"
  [[ "${3:-}" == --background ]] || { echo 'fixture scopefuel: refresh requires --background' >&2; exit 2; }
  case "${WRK_REFRESH_MODE:-ok}" in
    fail)
      echo "fixture scopefuel: refresh failed for pool=$pool" >&2
      exit 23
      ;;
    hang)
      if [[ -n "${WRK_REFRESH_PID_LOG:-}" ]]; then
        printf '%s\n' "$$" >>"$WRK_REFRESH_PID_LOG"
      fi
      exec sleep "${WRK_REFRESH_DELAY:-2}"
      ;;
  esac
  if [[ -n "${WRK_REFRESH_LOG:-}" ]]; then
    printf 'refresh %s %s\n' "$pool" "$3" >>"$WRK_REFRESH_LOG"
  fi
  exit 0
fi

if [[ "${1:-}" != gate || "${2:-}" != -m ]]; then
  echo 'fixture scopefuel: unexpected arguments' >&2
  exit 2
fi
profile="${3:-}"
if [[ -n "${WRK_SCOPEFUEL_LOG:-}" ]]; then
  printf '%s\n' "$profile" >>"$WRK_SCOPEFUEL_LOG"
fi
case "${WRK_GATE_MODE:-ok}" in
  3) echo "gate blocked profile=$profile alternative=fixture-alt" >&2; exit 3 ;;
  4) echo "gate measurement unavailable profile=$profile alternative=fixture-alt" >&2; exit 4 ;;
  9) echo "gate internal failure profile=$profile" >&2; exit 9 ;;
esac
pool="$(pool_for "$profile")"
if [[ "${WRK_GATE_POOL_MODE:-ok}" == missing ]]; then
  echo "gate allowed profile=$profile"
  exit 0
fi
echo "profile=$profile pool=$pool used_pct=12.5 class=preserve"
echo "gate allowed profile=$profile"
