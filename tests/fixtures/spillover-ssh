#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >>"${WRK_SSH_LOG:?}"
if [[ -n "${WRK_SSH_CALL_COUNT_FILE:-}" ]]; then
  call=0
  [[ ! -f "$WRK_SSH_CALL_COUNT_FILE" ]] || call="$(cat "$WRK_SSH_CALL_COUNT_FILE")"
  call=$((call + 1))
  printf '%s\n' "$call" >"$WRK_SSH_CALL_COUNT_FILE"
  if [[ ",${WRK_SSH_FAIL_CALLS:-}," == *",$call,"* ]]; then exit "${WRK_SSH_FAIL_CODE:-42}"; fi
fi
remote="${*: -1}"
host=""
for arg in "$@"; do
  [[ "$arg" == desktop || "$arg" == mac-work ]] && host="$arg"
done
# Per-host override (WRK_SSH_SCENARIO_DESKTOP, WRK_SSH_SCENARIO_MAC_WORK)
# wins over the shared WRK_SSH_SCENARIO so multi-host auto tests can give
# each candidate its own failure mode.
scenario="${WRK_SSH_SCENARIO:-ok}"
if [[ -n "$host" ]]; then
  host_key="$(printf '%s' "$host" | tr '[:lower:]-' '[:upper:]_')"
  scenario_var="WRK_SSH_SCENARIO_${host_key}"
  [[ -z "${!scenario_var:-}" ]] || scenario="${!scenario_var}"
fi
if [[ "$remote" == *'uptime; herdr agent list'* ]]; then
  if [[ "$host" == desktop && "$scenario" == desktop-down ]]; then exit 255; fi
  if [[ "$host" == mac-work && "$scenario" == backup-down ]]; then exit 255; fi
  if [[ "$scenario" == probe-unreachable ]]; then
    printf '%s\n' "ssh: connect to host $host port 22: Operation timed out" >&2
    exit 255
  fi
  if [[ "$scenario" == probe-exit2 ]]; then
    # An ssh transport exit landing in the router's fail-closed admission set
    # (2/74/75): the probe line must still report the real rc.
    printf '%s\n' "ssh: connect to host $host port 22: remote-side refused (exit 2)" >&2
    exit 2
  fi
  if [[ "$scenario" == probe-herdr-missing ]]; then
    printf '%s\n' ' 10:00 up 1 day,  load average: 0.10, 0.10, 0.10'
    printf '%s\n' 'sh: herdr: command not found' >&2
    exit 0
  fi
  printf '%s\n' ' 10:00 up 1 day,  load average: 0.10, 0.10, 0.10'
  printf '%s\n' '{"result":{"agents":[]}}'
  exit 0
fi
if [[ "$remote" == *mktemp* ]]; then
  if [[ "$scenario" == mktemp-fails ]]; then
    printf '%s\n' "mktemp: failed to create file via template '${TMPDIR:-/tmp}/wrk-spillover.XXXXXX.md': No space left on device" >&2
    exit 1
  fi
  printf '%s\n' "/tmp/${host}-brief.md"
  exit 0
fi
# Remote worktree preparation arrives as "VAR=<remote-path> ... sh -s" with the
# script on stdin.  With WRK_FAKE_REMOTE set, replay it against a local fake
# root so tests exercise real git worktree semantics without touching a host.
if [[ "$remote" == *'sh -s'* ]]; then
  if [[ "$scenario" == prepare-fails ]]; then
    printf '%s\n' "ssh: connect to host $host port 22: Connection refused" >&2
    exit 255
  fi
  [[ -n "${WRK_FAKE_REMOTE:-}" ]] || { echo "fixture: sh -s without WRK_FAKE_REMOTE" >&2; exit 3; }
  eval "${remote% sh -s*}"
  [[ -z "${BASE:-}" ]] || BASE="${WRK_FAKE_REMOTE}${BASE}"
  [[ -z "${TARGET:-}" ]] || TARGET="${WRK_FAKE_REMOTE}${TARGET}"
  script="$(cat)"
  env BASE="${BASE:-}" TARGET="${TARGET:-}" BRANCH="${BRANCH:-}" SHA="${SHA:-}" bash -c "$script"
  exit $?
fi
if [[ "$host" == desktop && "$scenario" == desktop-spawn-fails ]]; then exit 42; fi
# The delegated spawn leg arrives as "env HERDR_SESSION=... wrk spawn ...;
# rc=$?; rm -f brief; exit $rc".  These scenarios make the remote wrk fail the
# way a real one does: a die line on stderr, a refusal printed on stdout, or
# both — so tests can assert which channel reaches the operator.
if [[ "$remote" == *'wrk spawn'* ]]; then
  case "$scenario" in
    remote-die-stderr)
      printf '%s\n' "${WRK_REMOTE_STDERR_LINE:-wrk: hk task 1037 is already bound to job 'other-job' (state=claimed claimed_by=w-other) — a task linked to another job cannot be re-spawned (fail-closed)}" >&2
      exit "${WRK_REMOTE_RC:-1}"
      ;;
    remote-die-stdout)
      printf '%s\n' "${WRK_REMOTE_STDOUT_LINE:-wrk: hk task 1037 is already bound to job 'other-job' (state=claimed claimed_by=w-other) — a task linked to another job cannot be re-spawned (fail-closed)}"
      exit "${WRK_REMOTE_RC:-1}"
      ;;
    remote-die-mixed)
      printf '%s\n' "wrk: remote stdout detail for task 1037"
      printf '%s\n' "${WRK_REMOTE_STDERR_LINE:-wrk: hk task 1037 is already bound to job 'other-job' — a task linked to another job cannot be re-spawned (fail-closed)}" >&2
      exit "${WRK_REMOTE_RC:-1}"
      ;;
    remote-config-refused)
      # #1154: the remote wrk's own fail-closed answer — its hub quota gate
      # refusing a malformed [hub] config on the execution host (rc 70).
      printf '%s\n' "${WRK_REMOTE_STDERR_LINE:-wrk: [hub] quota_gate accepts only \"local\"; refusing spawn}" >&2
      exit 70
      ;;
    remote-warn-ok)
      # A winning remote wrk may still talk on stderr (quota notes, warnings);
      # on main that text streamed live even when the spawn succeeded.
      printf '%s\n' "wrk: note: remote herdr quota nearly full on $host" >&2
      ;;
  esac
fi
printf '%s\n' "OK pane=${host}:p7 host=local model=codex-terra label=fixture status=working landed=yes"
