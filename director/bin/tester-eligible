#!/usr/bin/env python3
"""Shadow tester eligibility check. Reads repository/evidence; writes one receipt."""

from __future__ import annotations

import argparse
import fnmatch
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from gate_common import (  # noqa: E402
    DEFAULT_POLICY, DEFAULT_RECEIPTS, GRADES, iso_time,
    load_policy, model_family, new_action_id, overall, parse_time, read_ci_attempt, resolve_profile, result, run_git,
    sha256_file, utc_now, write_receipt,
)

SHA = re.compile(r"^[0-9a-f]{40}$")
VERDICT = re.compile(r"^VERDICT: (PASS|BLOCKER) @([0-9a-f]{40})$")
STAGES = ("pre-spawn", "post-landing", "pre-merge")
TOOL_VERSION = "tester-eligible/1.5"
_IDENTIFIER = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
_REMOVED_DEF = re.compile(r"^-\s*(?:async\s+def|def|class)\s+([A-Za-z_][A-Za-z0-9_]*)")
_REMOVED_NAME = re.compile(r"^-([A-Za-z_][A-Za-z0-9_]*)\s*=[^=]")
_IMPORT_LINE = re.compile(r"^\s*(?:from|import)\s+([A-Za-z_][A-Za-z0-9_.]*)")
_FROM_IMPORT = re.compile(r"^\s*from\s+(\.*[A-Za-z_][A-Za-z0-9_.]*|\.+)\s+import\s+(.+)$")
_FROM_ITEM = re.compile(r"([A-Za-z_][A-Za-z0-9_]*)(?:\s+as\s+([A-Za-z_][A-Za-z0-9_]*))?")
_IMPORT_ALIAS = re.compile(r"^import\s+([A-Za-z_][A-Za-z0-9_.]*)\s+as\s+([A-Za-z_][A-Za-z0-9_]*)")
_DYNAMIC_CALL = re.compile(r"\b(?:exec|eval|compile|__import__|globals|vars|importlib)\s*\(|\bimportlib\b")
_ATTR_CALL = re.compile(r"\b(?:getattr|setattr|delattr)\s*\(")
_ATTR_LITERAL = re.compile(r"(?:getattr|setattr|delattr)\s*\([^,]+,\s*(['\"])[A-Za-z_][A-Za-z0-9_.]*\1\s*[,)]")


def _digest(value: object) -> str:
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def diff_surface(evidence: dict, policy: dict) -> tuple[dict | None, dict]:
    repo = Path(evidence.get("repo_path", ""))
    head, base = evidence.get("head", ""), evidence.get("base", "")
    if not repo.is_dir() or not SHA.fullmatch(head) or not SHA.fullmatch(base):
        return None, result("UNVERIFIED", "DIFF_INPUT_MISSING", "spawn-worker:2-1")
    top = run_git(repo, "rev-parse", "--show-toplevel")
    if top.returncode or Path(top.stdout.strip()).resolve() != repo.resolve():
        return None, result("UNVERIFIED", "REPO_UNVERIFIED", "spawn-worker:2-1")
    remote = run_git(repo, "remote", "get-url", "origin")
    declared_repo = str(evidence.get("repo", "")).split("/")[-1]
    actual_repo = Path(remote.stdout.strip().rstrip("/")).name.removesuffix(".git") if remote.returncode == 0 else ""
    if not declared_repo or not actual_repo:
        return None, result("UNVERIFIED", "REPO_REMOTE_UNKNOWN", "spawn-worker:2-1")
    if declared_repo != actual_repo:
        return None, result("UNVERIFIED", "REPO_ID_MISMATCH", "spawn-worker:2-1")
    for ref in (base, head):
        if run_git(repo, "cat-file", "-e", f"{ref}^{{commit}}").returncode:
            return None, result("UNVERIFIED", "DIFF_REF_MISSING", "spawn-worker:2-1")
    names = run_git(repo, "diff", "--no-ext-diff", "--no-renames", "--name-only", "-z", base, head)
    nums = run_git(repo, "diff", "--no-ext-diff", "--no-renames", "--numstat", "-z", base, head)
    if names.returncode or nums.returncode:
        return None, result("UNVERIFIED", "DIFF_READ_FAILED", "spawn-worker:2-1")
    if not names.stdout:
        return None, result("UNVERIFIED", "DIFF_EMPTY", "spawn-worker:2-1")
    if not names.stdout.endswith("\0") or not nums.stdout.endswith("\0"):
        return None, result("UNVERIFIED", "DIFF_UNCLASSIFIABLE", "spawn-worker:2-1")
    paths = names.stdout[:-1].split("\0")
    if any(not path or any(ord(char) < 32 for char in path) or path.startswith("-") for path in paths):
        return None, result("UNVERIFIED", "DIFF_UNCLASSIFIABLE", "spawn-worker:2-1")
    lines = 0
    numstat_paths = []
    for row in nums.stdout[:-1].split("\0"):
        fields = row.split("\t", 2)
        if len(fields) != 3 or not fields[0].isdigit() or not fields[1].isdigit():
            return None, result("UNVERIFIED", "DIFF_UNCLASSIFIABLE", "spawn-worker:2-1")
        lines += int(fields[0]) + int(fields[1])
        numstat_paths.append(fields[2])
    if paths != numstat_paths:
        return None, result("UNVERIFIED", "DIFF_UNCLASSIFIABLE", "spawn-worker:2-1")
    rules = policy["surface_rules"]
    names_lower = [name.lower() for name in paths]
    t3 = any(any(path.startswith(prefix.lower()) or f"/{prefix.lower()}" in path
                 for prefix in rules["t3_paths"]) or
             any(fnmatch.fnmatch(path, pattern.lower()) or fnmatch.fnmatch(Path(path).name, pattern.lower())
                 for pattern in rules["t3_names"]) or
             re.search(r"(^|[/_-])(safety|guards?|broker|orders?|trading|execution|live|deploy(?:ment|ments|er|ers)?)([/_.-]|$)", path)
             for path in names_lower)
    flags = sorted({"gate_or_delivery" for path in names_lower
                    if any(path.startswith(prefix.lower()) for prefix in rules["gate_paths"])})
    if t3:
        flags.append("live_deploy_safety")
    if t3:
        floor = 3
    elif declared_repo in rules["auto_trader_repos"]:
        if not all(any(path.startswith(prefix.lower()) for prefix in rules["auto_trader_nontrading_paths"])
                   for path in names_lower):
            return None, result("UNVERIFIED", "DIFF_UNCLASSIFIABLE", "spawn-worker:2-1",
                                paths=paths, flags=flags)
        floor = 2
    elif declared_repo in rules["tool_repos"]:
        floor = 1
    elif evidence.get("local_only") is True and lines <= 30 and all(Path(path).suffix in {".py", ".sh", ".json", ".toml", ".yaml", ".yml"}
                               for path in paths):
        floor = 0
    else:
        return None, result("UNVERIFIED", "DIFF_UNCLASSIFIABLE", "spawn-worker:2-1",
                            paths=paths, flags=flags)
    surface = {"floor": f"T{floor}", "paths": paths, "changed_lines": lines,
               "flags": flags, "diff_sha256": _digest({"names": names.stdout, "numstat": nums.stdout})}
    return surface, result("PASS", "SURFACE_CLASSIFIED", "spawn-worker:2-1", **surface)


def _read_previous(path_text: str | None, required_stage: str, evidence: dict,
                   policy_revision: str, policy_sha256: str) -> tuple[dict | None, dict]:
    if not path_text:
        return None, result("UNVERIFIED", "PREVIOUS_RECEIPT_MISSING", "decision:3231")
    path = Path(path_text)
    try:
        previous = json.loads(path.read_text())
        if (previous["stage"] != required_stage or previous["overall"] != "PASS" or
            previous.get("kind") != "spawn"):
            return None, result("UNVERIFIED", "PREVIOUS_RECEIPT_INVALID", "decision:3231")
        for key in ("task", "contract_revision", "job", "repo", "repo_path", "issuer",
                    "head", "base", "diff_sha256", "contributors_digest", "declared_t",
                    "required_grade", "implementation_grade", "split"):
            if previous.get(key) != evidence.get(key):
                reason = "HEAD_CHANGED" if key == "head" else "BASE_CHANGED" if key == "base" else "EVIDENCE_CHANGED"
                return None, result("UNVERIFIED", reason, "decision:3231", field=key)
        if previous.get("pr") is not None and previous["pr"] != evidence.get("pr"):
            return None, result("UNVERIFIED", "EVIDENCE_CHANGED", "decision:3231", field="pr")
        if (previous.get("trial_merge_tree") is not None and
            previous["trial_merge_tree"] != evidence.get("trial_merge_tree")):
            return None, result("UNVERIFIED", "MERGE_TREE_CHANGED", "decision:3231")
        tester = evidence.get("tester") or {}
        if (previous.get("planned_tester_profile") != tester.get("planned_profile") or
            previous.get("planned_tester_effort") != tester.get("planned_effort")):
            return None, result("UNVERIFIED", "TESTER_PLAN_CHANGED", "decision:3231")
        if required_stage == "post-landing" and any(previous.get(key) != tester.get(field)
            for key, field in (("actual_tester_profile", "actual_profile"),
                               ("actual_model", "actual_model"), ("actual_effort", "actual_effort"))):
            return None, result("UNVERIFIED", "ACTUAL_PROFILE_CHANGED", "decision:3231")
        if required_stage == "post-landing" and any(previous.get(key) != tester.get(field)
            for key, field in (("actual_tester_session", "session"),
                               ("actual_tester_worktree", "worktree"),
                               ("actual_tester_pane", "pane"))):
            return None, result("UNVERIFIED", "ACTUAL_TESTER_CHANGED", "decision:3231")
        if ((previous.get("policy") or {}).get("revision") != policy_revision or
            (previous.get("policy") or {}).get("sha256") != policy_sha256):
            return None, result("UNVERIFIED", "POLICY_CHANGED", "decision:3231")
        return previous, result("PASS", "PREVIOUS_RECEIPT_BOUND", "decision:3231",
                                path=str(path), sha256=sha256_file(path), action_id=previous["action_id"])
    except (OSError, ValueError, KeyError, TypeError):
        return None, result("UNVERIFIED", "PREVIOUS_RECEIPT_INVALID", "decision:3231")


def _current_pr(evidence: dict) -> dict:
    if not evidence.get("pr"):
        return result("UNVERIFIED", "PR_MISSING", "decision:3231")
    repo = Path(evidence["repo_path"])
    try:
        proc = subprocess.run(["gh", "pr", "view", str(evidence["pr"]), "--json", "headRefOid,baseRefName"],
                              cwd=repo, text=True, capture_output=True, check=False, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return result("UNVERIFIED", "PR_LOOKUP_FAILED", "checker:G2")
    if proc.returncode:
        return result("UNVERIFIED", "PR_LOOKUP_FAILED", "checker:G2")
    try:
        pr = json.loads(proc.stdout)
        if pr["headRefOid"] != evidence["head"]:
            return result("UNVERIFIED", "HEAD_CHANGED", "checker:G2")
        base_name = pr["baseRefName"]
        remote = run_git(repo, "ls-remote", "origin", f"refs/heads/{base_name}")
        if remote.returncode or not remote.stdout.strip():
            return result("UNVERIFIED", "BASE_LOOKUP_FAILED", "checker:G4")
        remote_base = remote.stdout.split()[0]
        if remote_base != evidence["base"]:
            return result("UNVERIFIED", "BASE_CHANGED", "checker:G4")
        return result("PASS", "PR_REFS_CURRENT", "checker:G2+G4", head=pr["headRefOid"], base=remote_base)
    except (ValueError, KeyError, IndexError, OSError, UnicodeError):
        return result("UNVERIFIED", "PR_LOOKUP_FAILED", "checker:G2")


def _report(evidence: dict) -> dict:
    tester = evidence.get("tester", {})
    path_text = tester.get("report_path")
    expected_hash = tester.get("report_sha256")
    if not path_text or not expected_hash:
        return result("UNVERIFIED", "REPORT_MISSING", "checker:G1")
    path = Path(path_text)
    try:
        actual_hash = sha256_file(path)
        if actual_hash != expected_hash:
            return result("UNVERIFIED", "REPORT_HASH_MISMATCH", "checker:G1", path=str(path), sha256=actual_hash)
        lines = path.read_text().splitlines()
        fence_char = None
        fence_width = 0
        last = ""
        last_inside_fence = False
        for line in lines:
            marker = re.match(r"^ {0,3}(`{3,}|~{3,})(.*)$", line)
            if marker:
                run, tail = marker.groups()
                if fence_char is None:
                    fence_char, fence_width = run[0], len(run)
                elif run[0] == fence_char and len(run) >= fence_width and not tail.strip():
                    fence_char, fence_width = None, 0
            if line.strip():
                last = line
                last_inside_fence = fence_char is not None
        if last_inside_fence:
            return result("UNVERIFIED", "VERDICT_QUOTED", "checker:G1", path=str(path), sha256=actual_hash)
        found = VERDICT.fullmatch(last)
        if not found:
            return result("UNVERIFIED", "VERDICT_MISSING", "checker:G1", path=str(path), sha256=actual_hash)
        if found.group(2) != evidence.get("head"):
            return result("UNVERIFIED", "VERDICT_HEAD_STALE", "checker:G1", path=str(path), sha256=actual_hash)
        if found.group(1) != "PASS":
            return result("FAIL", "TESTER_BLOCKER", "checker:G1", path=str(path), sha256=actual_hash)
        expected_lines = {f"TASK: {evidence.get('task')}", f"JOB: {evidence.get('job')}",
                          f"REPO: {evidence.get('repo')}", f"TESTED_HEAD: {evidence.get('head')}",
                          f"TESTER_SESSION: {tester.get('session')}"}
        if not expected_lines.issubset(set(lines)):
            return result("UNVERIFIED", "REPORT_IDENTITY_MISSING", "checker:G1", path=str(path), sha256=actual_hash)
        return result("PASS", "EXACT_HEAD_PASS", "checker:G1", path=str(path), sha256=actual_hash)
    except (OSError, UnicodeError):
        return result("UNVERIFIED", "REPORT_UNREADABLE", "checker:G1")


def _ci_binding(evidence: dict, policy: dict | None = None) -> dict:
    ci = evidence.get("ci")
    if not isinstance(ci, dict) or not ci.get("run_id") or not ci.get("attempt"):
        return result("UNVERIFIED", "CI_JOB_MISSING", "task:723")
    if ci.get("status") == "skipped":
        return result("UNVERIFIED", "CI_JOB_SKIPPED", "task:723")
    if ci.get("status") != "success":
        return result("UNVERIFIED", "CI_NOT_GREEN", "task:723")
    if ci.get("head") != evidence.get("head"):
        return result("UNVERIFIED", "CI_HEAD_STALE", "task:723")
    if ci.get("base") != evidence.get("base"):
        return result("UNVERIFIED", "CI_BASE_STALE", "task:723")
    merge_tree = evidence.get("trial_merge_tree")
    if not merge_tree or not SHA.fullmatch(str(merge_tree)):
        return result("UNVERIFIED", "CI_MERGE_TREE_MISSING", "task:723")
    try:
        actual_tree = run_git(Path(evidence["repo_path"]), "merge-tree", "--write-tree",
                              evidence["base"], evidence["head"])
    except (OSError, UnicodeError):
        return result("UNVERIFIED", "CI_MERGE_TREE_STALE", "task:723")
    if actual_tree.returncode or actual_tree.stdout.strip() != merge_tree:
        return result("UNVERIFIED", "CI_MERGE_TREE_STALE", "task:723")
    if ci.get("trial_merge_tree") != merge_tree:
        return result("UNVERIFIED", "CI_MERGE_TREE_STALE", "task:723")
    run, jobs, lookup = read_ci_attempt(Path(evidence["repo_path"]), ci["run_id"], ci["attempt"])
    if lookup["status"] != "PASS":
        return lookup
    if (run.get("id") != ci["run_id"] or run.get("run_attempt") != ci["attempt"] or
        run.get("event") != "pull_request"):
        return result("UNVERIFIED", "CI_ATTEMPT_MISMATCH", "task:723")
    if run.get("head_sha") != evidence["head"]:
        return result("UNVERIFIED", "CI_HEAD_STALE", "task:723")
    pulls = run.get("pull_requests") or []
    if not any(pr.get("number") == evidence.get("pr") and
               (pr.get("head") or {}).get("sha") == evidence["head"] and
               (pr.get("base") or {}).get("sha") == evidence["base"] for pr in pulls if isinstance(pr, dict)):
        return result("UNVERIFIED", "CI_BASE_STALE", "task:723")
    if run.get("status") != "completed" or run.get("conclusion") != "success":
        return result("UNVERIFIED", "CI_NOT_GREEN", "task:723")
    repo_name = str(evidence.get("repo", "")).rsplit("/", 1)[-1]
    required_jobs = (policy or {}).get("required_ci_jobs_by_repo", {}).get(repo_name)
    if not isinstance(required_jobs, list) or not required_jobs:
        return result("UNVERIFIED", "CI_POLICY_UNKNOWN", "task:723")
    by_name = {job.get("name"): job for job in jobs["jobs"] if isinstance(job, dict)}
    if any(name not in by_name for name in required_jobs):
        return result("UNVERIFIED", "CI_JOB_MISSING", "task:723")
    if any(by_name[name].get("conclusion") == "skipped" for name in required_jobs):
        return result("UNVERIFIED", "CI_JOB_SKIPPED", "task:723")
    if any(by_name[name].get("status") != "completed" or by_name[name].get("conclusion") != "success"
           for name in required_jobs):
        return result("UNVERIFIED", "CI_NOT_GREEN", "task:723")
    return result("PASS", "CI_BOUND", "task:723", run_id=ci["run_id"], attempt=ci["attempt"])


def _read_pane(pane: str) -> str | None:
    try:
        proc = subprocess.run(["herdr", "agent", "read", pane, "--source", "visible", "--lines", "15"],
                              text=True, capture_output=True, check=False, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return proc.stdout if proc.returncode == 0 else None


def _pane_model_matches(snapshot: str, model: str, effort: str) -> bool:
    display = {
        "grok-4.7": "Grok 4.7", "gpt-6-sol": "GPT-6-Sol", "gpt-6-luna": "GPT-6-Luna",
        "gpt-5.6-terra": "GPT-5.6-Terra", "claude-opus-5-5": "Opus 5.5",
        "claude-sonnet-5": "Sonnet 5",
    }.get(model, model)
    suffix = rf"\s*(?:\(\s*{re.escape(effort)}\s*\)|{re.escape(effort)})\s*·" if effort else r"\s*·"
    pattern = re.compile(rf"^\s*[│┃╭╰─\s]*{re.escape(display)}{suffix}", re.IGNORECASE)
    footer_lines = [line for line in snapshot.splitlines()[-5:]
                    if " · " in line and re.match(
                        r"^\s*[│┃╭╰─\s]*(?:Grok|GPT-|Opus|Sonnet|Haiku|Kimi|Devin|Deepseek)",
                        line, re.IGNORECASE)]
    return bool(footer_lines) and bool(pattern.search(footer_lines[-1]))


def _actual_observation(evidence: dict, policy: dict, tester_profile: dict | None) -> dict:
    """Bind actual profile/effort to wrk events and model to a pane observation."""
    tester = evidence.get("tester") or {}
    record_dir = tester.get("job_record_dir")
    observation_path = tester.get("model_observation_path")
    observation_sha = tester.get("model_observation_sha256")
    pane = tester.get("pane")
    if not record_dir or not pane or not observation_path or not observation_sha:
        return result("UNVERIFIED", "ACTUAL_SOURCE_MISSING", "decision:3231")
    try:
        events = Path(record_dir) / "events"
        spawn_paths = sorted(events.glob("*job.spawned.json"))
        quota_paths = sorted(events.glob("*quota_pool.record.json"))
        if not spawn_paths or not quota_paths:
            return result("UNVERIFIED", "ACTUAL_SOURCE_MISSING", "bin/wrk:job-record")
        spawned = json.loads(spawn_paths[-1].read_text())
        quota = json.loads(quota_paths[-1].read_text())
        if (spawned.get("kind") != "job.spawned" or quota.get("kind") != "quota_pool.record" or
            spawned.get("job_id") != evidence.get("job") or quota.get("job_id") != evidence.get("job") or
            spawned["payload"].get("profile") != tester.get("actual_profile") or
            spawned["payload"].get("pane_id") != pane):
            return result("UNVERIFIED", "JOB_RECORD_MISMATCH", "bin/wrk:job-record")
        launch = quota["payload"].get("launch_profile", "")
        launch_prefix, observed_effort = launch.rsplit("@", 1) if "@" in launch else ("", "")
        launch_spec = policy.get("profiles", {}).get(launch_prefix)
        if not tester_profile or not isinstance(launch_spec, dict):
            return result("UNVERIFIED", "ACTUAL_LAUNCH_UNKNOWN", "bin/wrk:quota_pool.record")
        if (launch_spec.get("family") != tester_profile["family"] or
            model_family(str(launch_spec.get("model", ""))) != tester_profile["family"]):
            return result("UNVERIFIED", "ACTUAL_LAUNCH_FAMILY_MISMATCH", "bin/wrk:quota_pool.record")
        if launch_spec.get("model") != tester_profile["model"]:
            return result("UNVERIFIED", "ACTUAL_LAUNCH_MODEL_MISMATCH", "bin/wrk:quota_pool.record")
        if "tester" not in launch_spec.get("roles", []) or evidence.get("declared_t") not in launch_spec.get("surfaces", []):
            return result("UNVERIFIED", "ACTUAL_LAUNCH_PROFILE_DENIED", "bin/wrk:quota_pool.record")
        if observed_effort != tester.get("actual_effort"):
            return result("UNVERIFIED", "ACTUAL_EFFORT_MISMATCH", "bin/wrk:quota_pool.record")
        resolved_launch, launch_check = resolve_profile(
            launch_prefix, policy, actual_model=tester_profile["model"],
            actual_effort=observed_effort, role="tester")
        if launch_check["status"] != "PASS" or resolved_launch is None:
            return result("UNVERIFIED", "ACTUAL_LAUNCH_PROFILE_UNVERIFIED", "bin/wrk+policy:profiles")
        if resolved_launch["grade"] != tester_profile["grade"]:
            return result("UNVERIFIED", "ACTUAL_LAUNCH_PROFILE_CHANGED", "bin/wrk+policy:profiles")
        path = Path(observation_path)
        if sha256_file(path) != observation_sha:
            return result("UNVERIFIED", "MODEL_OBSERVATION_HASH_MISMATCH", "decision:3231")
        observed = json.loads(path.read_text())
        if (observed.get("source") != "pane" or observed.get("pane") != pane or
            observed.get("job") != evidence.get("job") or observed.get("model") != tester.get("actual_model") or
            observed.get("effort") != tester.get("actual_effort")):
            return result("UNVERIFIED", "MODEL_OBSERVATION_MISMATCH", "decision:3231")
        snapshot = _read_pane(pane)
        if snapshot is None:
            return result("UNVERIFIED", "PANE_UNREADABLE", "decision:3231")
        if not _pane_model_matches(snapshot, tester["actual_model"], tester["actual_effort"]):
            return result("UNVERIFIED", "PANE_MODEL_UNVERIFIED", "decision:3231")
        return result("PASS", "ACTUAL_PROFILE_OBSERVED", "bin/wrk+pane",
                      job_record_dir=str(record_dir), pane=pane, model_observation_path=str(path),
                      model_observation_sha256=observation_sha,
                      pane_snapshot_sha256=hashlib.sha256(snapshot.encode()).hexdigest())
    except (OSError, ValueError, KeyError, TypeError):
        return result("UNVERIFIED", "ACTUAL_SOURCE_UNREADABLE", "bin/wrk+pane")


def _leaf(symbol: str) -> str | None:
    """Trailing identifier of a boundary symbol (orders.release -> release)."""
    tokens = _IDENTIFIER.findall(str(symbol))
    return tokens[-1] if tokens else None


def _normalize_path(path: object) -> str | None:
    """Canonical repo-relative path: collapses ./ and //; rejects .., /, \\."""
    if not isinstance(path, str):
        return None
    text = path.strip()
    if not text or text.startswith("/") or "\\" in text or any(ord(char) < 32 for char in text):
        return None
    parts = []
    for segment in text.split("/"):
        if segment in {"", "."}:
            continue
        if segment == "..":
            return None
        parts.append(segment)
    return "/".join(parts) if parts else None


def _normalize_boundary(raw: object) -> dict | None:
    if not isinstance(raw, dict):
        return None
    paths, symbols = raw.get("paths"), raw.get("symbols")
    if not isinstance(paths, list) or not isinstance(symbols, list):
        return None
    normalized = [_normalize_path(path) for path in paths]
    if any(path is None for path in normalized):
        return None
    if any(not isinstance(symbol, str) or not symbol.strip() or _leaf(symbol) is None
           for symbol in symbols):
        return None
    if not normalized and not symbols:
        return None
    return {"paths": sorted(set(normalized)), "symbols": sorted({symbol.strip() for symbol in symbols})}


def _path_in_boundary(path: str, boundary: dict, contract_path: str | None) -> str | None:
    if contract_path and path == contract_path:
        return "contract"
    for entry in boundary["paths"]:
        if path == entry or path.startswith(entry.rstrip("/") + "/") or \
                fnmatch.fnmatch(path, entry) or fnmatch.fnmatch(Path(path).name, entry):
            return "path"
    return None


def _boundary_modules(boundary: dict) -> set[str]:
    modules = set()
    for entry in boundary["paths"]:
        name = entry.rstrip("/")
        if not name or any(char in name for char in "*?[]"):
            continue
        if name.endswith(".py"):
            name = name[:-3]
        elif "." in Path(name).name:
            continue
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_./]*", name):
            modules.add(name.replace("/", "."))
    return modules


def _resolve_module(module: str, file_path: str) -> str:
    """Resolve leading-dot relative imports against the importing file's package."""
    if not module.startswith("."):
        return module
    package = file_path.rsplit("/", 1)[0].split("/") if "/" in file_path else []
    dots = len(module) - len(module.lstrip("."))
    rest = module.lstrip(".")
    keep = max(len(package) - (dots - 1), 0)
    base = ".".join(package[:keep])
    return ".".join(part for part in (base, rest) if part)


def _from_clauses(content: str):
    """Yield (module, items) for each from-import, joining parenthesized and
    backslash-continued items."""
    lines = content.splitlines()
    index = 0
    while index < len(lines):
        found = _FROM_IMPORT.match(lines[index].strip())
        if not found:
            index += 1
            continue
        module, items = found.group(1), found.group(2)
        while index + 1 < len(lines) and (
                ("(" in items and ")" not in items) or items.rstrip().endswith("\\")):
            index += 1
            items += lines[index].strip()
        index += 1
        yield module, items.replace("\\", " ").strip("() \t\n")


def _import_modules(content: str, file_path: str = "") -> set[str]:
    names = set()
    found = _FROM_IMPORT.match(content)
    if found:
        module = _resolve_module(found.group(1), file_path)
        names.add(module)
        for item in found.group(2).split(","):
            leaf = _IDENTIFIER.match(item.strip())
            if leaf:
                names.add(module + "." + leaf.group(0))
        return names
    inline = _IMPORT_LINE.match(content)
    if inline:
        names.add(_resolve_module(inline.group(1), file_path))
    return names


def _module_in(module: str, modules: set[str]) -> bool:
    return any(module == item or module.startswith(item + ".") for item in modules)


def _module_file(repo: Path, head: str, module: str) -> tuple[str, str] | str | None:
    """Map a module name to a file at head: (path, content), "unreadable", or None.

    None means no such path exists in the tree (an external package);
    "unreadable" means a blob exists but is a symlink, gitlink, or binary.
    A package directory wins over a sibling module file, matching Python."""
    stem = module.replace(".", "/")
    for candidate in (stem + "/__init__.py", stem + ".py"):
        tree = run_git(repo, "ls-tree", head, "--", candidate)
        if tree.returncode or not tree.stdout.strip():
            continue
        mode = tree.stdout.split()[0]
        if mode not in {"100644", "100755"}:
            return "unreadable"
        try:
            show = run_git(repo, "show", f"{head}:{candidate}")
        except UnicodeDecodeError:
            return "unreadable"
        if show.returncode:
            return "unreadable"
        return candidate, show.stdout
    return None


def _module_names(repo: Path | None, head: str | None, resolved: str,
                  leaves: set[str], modules: set[str], memo: dict,
                  depth: int, visited: frozenset[str]) -> object:
    """Bound-name entry for a resolved module, memoized.

    Returns a _bound_names tuple for a readable file, "unreadable" for a
    present-but-unreadable source, "unexpanded" when the file exists but the
    recursion cap stops expansion, or None when the module is absent."""
    if resolved in memo:
        return memo[resolved]
    if not repo or not head:
        entry: object = "unexpanded"
    else:
        ref = _module_file(repo, head, resolved)
        if isinstance(ref, tuple):
            if depth >= 3 or resolved in visited:
                entry = "unexpanded"
            else:
                entry = _bound_names(ref[1], leaves, modules, repo, head,
                                     ref[0], depth + 1, visited | {resolved},
                                     memo)[:4]
        else:
            entry = ref
    memo[resolved] = entry
    return entry


def _attr_class(chain: str, attr: str, handles: dict, call_suspect: set[str],
                leaves: set[str], modules: set[str], repo: Path | None,
                head: str | None, file_path: str, memo: dict) -> str | None:
    """Classify a `chain.attr` reference: "bound" when the attribute provably
    reaches the core boundary, "suspect" when it cannot be resolved
    (unreadable/unexpanded module, uninspecatable external chain, unproven
    attribute of a core-deriving handle), or None."""
    handle = handles.get(chain)
    if handle is not None:
        if attr in handle[1]:
            return "bound"
        return "suspect"
    resolved = _resolve_module(chain, file_path) if repo and head else chain
    root = handles.get(chain.split(".", 1)[0])
    if root is not None and "." in chain:
        alt = root[0] + "." + chain.split(".", 1)[1]
        if _module_file(repo, head, alt) is not None:
            resolved = alt
    if _module_in(resolved, modules):
        return "bound" if attr in leaves else None
    entry = _module_names(repo, head, resolved, leaves, modules,
                          memo, 0, frozenset())
    if isinstance(entry, tuple):
        if attr in entry[0]:
            return "bound"
        if attr in entry[1] or attr in entry[2]:
            return "suspect"
        return None
    if entry in ("unreadable", "unexpanded"):
        return "suspect"
    if chain in call_suspect or chain.split(".", 1)[0] in call_suspect:
        return "suspect"
    if "." in chain:
        return "suspect"
    return None


_BIND_TARGETS = re.compile(r"[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*")
_BIND_STMT = re.compile(r"^\s*([\w.,:()\[\]'\"*\s]+?)\s*(?:[+\-*/%&|^@]|:)?=(?!=)(.*)$")
_FOR_STMT = re.compile(r"^for\s+(.+?)\s+in\s+(.+?)(?::\s*(.*))?$")
_WITH_AS = re.compile(r"(?:^|,)\s*(.+?)\s+as\s+([A-Za-z_][A-Za-z0-9_.]*)")
_CTRL_HEAD = re.compile(
    r"^(?:if|elif|else|while|try|finally|except|match|case)\b"
    r"(?::(?!=)|[^:])*:(?!\s*=)\s*")
_MODULE_REF = re.compile(r"^[A-Za-z_][A-Za-z0-9_.]*$")
_PLAIN_IMPORT = re.compile(r"^import\s+([A-Za-z_][A-Za-z0-9_.,\s]*)$")
_DOTTED_CALL = re.compile(
    r"([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*)\.([A-Za-z_][A-Za-z0-9_]*)\s*\(")
_BARE_CALL = re.compile(r"(?<![.\w])([A-Za-z_][A-Za-z0-9_]*)\s*\(")
_DOTTED_REF = re.compile(
    r"([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*)\.([A-Za-z_][A-Za-z0-9_]*)")
_STRING_LITERAL = re.compile(r"'(?:[^'\\]|\\.)*'|\"(?:[^\"\\]|\\.)*\"")
_PY_KEYWORDS = {
    "and", "as", "assert", "async", "await", "break", "class", "continue",
    "def", "del", "elif", "else", "except", "finally", "for", "from",
    "global", "if", "import", "in", "is", "lambda", "nonlocal", "not",
    "or", "pass", "raise", "return", "try", "while", "with", "yield",
    "match", "case", "type", "None", "True", "False", "NotImplemented",
    "Ellipsis", "self", "cls",
}


def _bind_targets(lhs: str) -> set[str]:
    """Leaf names bound by an assignment target: tuple items, attribute
    subscripts and annotations collapse to their bound identifiers."""
    lhs = lhs.split(":", 1)[0]
    return {_leaf(match.group(0)) for match in _BIND_TARGETS.finditer(lhs)} \
        - {""} - _PY_KEYWORDS


def _stmt_segments(text: str) -> list[str]:
    """Simple statements in a line: strip async/one-line control heads and
    split semicolons so `if c: fn = x` and `a(); b = y` expose their bodies."""
    text = re.sub(r"^async\s+", "", text)
    head = _CTRL_HEAD.match(text)
    while head:
        text = text[head.end():].strip()
        text = re.sub(r"^async\s+", "", text)
        head = _CTRL_HEAD.match(text)
    return [seg.strip() for seg in text.split(";") if seg.strip()]


def _strip_comment(line: str) -> str:
    """Remove a trailing # comment outside string literals."""
    quote = None
    index = 0
    while index < len(line):
        char = line[index]
        if quote:
            if char == "\\":
                index += 2
                continue
            if char == quote:
                quote = None
        elif char in "'\"":
            quote = char
        elif char == "#":
            return line[:index]
        index += 1
    return line


def _logical_lines(content: str) -> list[str]:
    """Statements as lines: join backslash continuations, drop comments, and
    split semicolons/control heads so import and binding forms always appear
    at the start of a scanned line."""
    lines: list[str] = []
    buf = ""
    for raw in content.splitlines():
        if raw.rstrip().endswith("\\"):
            buf += raw.rstrip()[:-1] + " "
            continue
        lines.extend(_stmt_segments(_strip_comment(buf + raw)))
        buf = ""
    if buf.strip():
        lines.extend(_stmt_segments(_strip_comment(buf)))
    return lines


def _bound_names(content: str, leaves: set[str], modules: set[str],
                 repo: Path | None = None, head: str | None = None,
                 file_path: str = "", depth: int = 0,
                 visited: frozenset[str] = frozenset(),
                 memo: dict | None = None) \
        -> tuple[set[str], set[str], set[str], bool, dict]:
    """Bound, suspect, call_suspect, unresolved, and module-handle bindings.

    bound: names bound to a boundary module or symbol (import aliases,
    assignments mentioning boundary names, names re-exported from repo files
    that bind them). suspect: names bound to an unresolvable dynamic
    expression (non-literal getattr/setattr/delattr, exec/eval, importlib,
    globals), to a suspect name, or re-exported through a module whose names
    could not be fully expanded — a changed reference to one cannot be
    classified. call_suspect: names bound to a value that cannot be proven
    non-core (unproven right-hand side, absent-module imports) — a changed
    CALL through one cannot be classified. unresolved: an `import *` that
    cannot be fully expanded, or a name-binding fixpoint that did not
    converge. handles: names bound to a repository module, each mapped to
    (module path, bound attrs, suspect attrs), used to classify dotted calls
    like `bridge.cleanup(...)`."""
    if memo is None:
        memo = {}
    bound: set[str] = set()
    suspect: set[str] = set()
    call_suspect: set[str] = set()
    handles: dict[str, tuple[str, set[str], set[str]]] = {}
    unresolved = False
    converged = False
    normalized = _logical_lines(content)
    normalized_content = "\n".join(normalized)
    for _ in range(12):
        grown = False
        for module, items_text in _from_clauses(normalized_content):
            resolved = _resolve_module(module, file_path)
            items = [item.strip().strip("()").strip() for item in items_text.split(",")]
            star = items_text.strip() == "*"
            if _module_in(resolved, modules):
                if star:
                    unresolved = True
                    continue
                for item in items:
                    bind = _FROM_ITEM.match(item)
                    if bind:
                        name = bind.group(2) or bind.group(1)
                        if name not in bound:
                            bound.add(name)
                            grown = True
                continue
            if star:
                entry = _module_names(repo, head, resolved, leaves, modules,
                                      memo, depth, visited)
                if not isinstance(entry, tuple):
                    unresolved = True
                    continue
                sub_bound, sub_suspect, sub_cs, sub_unres = entry
                unresolved |= sub_unres
                for name in (sub_bound - bound) | (sub_suspect - suspect) \
                        | (sub_cs - call_suspect):
                    grown = True
                bound |= sub_bound
                suspect |= sub_suspect
                call_suspect |= sub_cs
                continue
            entry: object = None
            entry_ready = False
            for item in items:
                bind = _FROM_ITEM.match(item)
                if not bind:
                    continue
                imported, alias = bind.group(1), bind.group(2) or bind.group(1)
                # `from pkg.ui import bridge` may name a submodule pkg.ui.bridge.
                submodule = resolved + "." + imported
                sub_entry = _module_names(repo, head, submodule,
                                          leaves, modules, memo, depth, visited)
                if isinstance(sub_entry, tuple):
                    record = (submodule, sub_entry[0],
                              sub_entry[1] | sub_entry[2])
                    if handles.get(alias) != record:
                        handles[alias] = record
                        unresolved |= sub_entry[3]
                        grown = True
                    continue
                if sub_entry in ("unreadable", "unexpanded"):
                    if alias not in suspect:
                        suspect.add(alias)
                        grown = True
                    continue
                if not entry_ready:
                    entry = _module_names(repo, head, resolved, leaves, modules,
                                          memo, depth, visited)
                    entry_ready = True
                if not isinstance(entry, tuple):
                    if entry in ("unreadable", "unexpanded"):
                        if alias not in suspect:
                            suspect.add(alias)
                            grown = True
                    elif entry is None and alias not in call_suspect \
                            and alias not in bound:
                        # `from missing import f` — the source module cannot be
                        # inspected, so the imported value is unproven.
                        call_suspect.add(alias)
                        grown = True
                    continue
                sub_bound, sub_suspect, sub_cs, sub_unres = entry
                unresolved |= sub_unres
                if imported in sub_bound and alias not in bound:
                    bound.add(alias)
                    grown = True
                elif imported in sub_suspect and alias not in suspect:
                    suspect.add(alias)
                    grown = True
                elif imported in sub_cs and alias not in call_suspect:
                    call_suspect.add(alias)
                    grown = True
        for text in normalized:
            if not text or text.startswith(("#", "from ")):
                continue
            alias = _IMPORT_ALIAS.match(text)
            if alias:
                resolved = _resolve_module(alias.group(1), file_path)
                name = alias.group(2)
                if _module_in(resolved, modules):
                    if name not in bound:
                        bound.add(name)
                        grown = True
                else:
                    entry = _module_names(repo, head, resolved, leaves, modules,
                                          memo, depth, visited)
                    if isinstance(entry, tuple):
                        record = (resolved, entry[0], entry[1] | entry[2])
                        if handles.get(name) != record:
                            handles[name] = record
                            unresolved |= entry[3]
                            grown = True
                    elif entry in ("unreadable", "unexpanded"):
                        if name not in suspect:
                            suspect.add(name)
                            grown = True
                    elif entry is None and name not in call_suspect \
                            and name not in bound:
                        call_suspect.add(name)
                        grown = True
                continue
            plain = _PLAIN_IMPORT.match(text)
            if plain:
                for modname in re.split(r"[\s,]+", plain.group(1).strip()):
                    if not modname:
                        continue
                    top = _leaf(modname.split(".", 1)[0])
                    if not top:
                        continue
                    resolved = _resolve_module(top, file_path)
                    if _module_in(resolved, modules):
                        if top not in bound:
                            bound.add(top)
                            grown = True
                        continue
                    entry = _module_names(repo, head, resolved, leaves,
                                          modules, memo, depth, visited)
                    if isinstance(entry, tuple):
                        record = (resolved, entry[0], entry[1] | entry[2])
                        if handles.get(top) != record:
                            handles[top] = record
                            unresolved |= entry[3]
                            grown = True
                    elif entry in ("unreadable", "unexpanded"):
                        if top not in suspect:
                            suspect.add(top)
                            grown = True
                    elif entry is None and top not in call_suspect \
                            and top not in bound:
                        call_suspect.add(top)
                        grown = True
                continue
            pending = _stmt_segments(text)
            while pending:
                segment = pending.pop()
                body = None
                targets: set[str] = set()
                rhs = ""
                found = _FOR_STMT.match(segment)
                if found:
                    targets = _bind_targets(found.group(1))
                    rhs, body = found.group(2), found.group(3)
                elif segment.startswith("with "):
                    pairs = _WITH_AS.findall(segment[5:])
                    if not pairs:
                        continue
                    targets = {_leaf(t) for _, t in pairs}
                    rhs = " ".join(ctx for ctx, _ in pairs)
                    tail = pairs[-1][1]
                    after = segment[segment.rfind(tail) + len(tail):]
                    if after.lstrip().startswith(":"):
                        body = after.lstrip()[1:].strip() or None
                else:
                    bind = _BIND_STMT.match(segment)
                    if not bind:
                        continue
                    targets = _bind_targets(bind.group(1))
                    rhs = bind.group(2)
                if body:
                    pending.extend(_stmt_segments(body))
                targets -= {""}
                if not targets:
                    continue
                rhs_names = set(_IDENTIFIER.findall(rhs))
                rhs_text = rhs.strip()
                unproven = set(_IDENTIFIER.findall(
                    _STRING_LITERAL.sub("", rhs))) - _PY_KEYWORDS \
                    - bound - suspect - call_suspect - set(handles)
                ref_entry: object = None
                ref_ready = False
                if len(rhs_names) == 1 and next(iter(rhs_names)) in handles:
                    source = next(iter(rhs_names))
                    for target in targets:
                        if handles.get(target) != handles[source]:
                            handles[target] = handles[source]
                            grown = True
                if _MODULE_REF.match(rhs_text) and rhs_text not in bound \
                        and rhs_text not in suspect:
                    resolved = _resolve_module(rhs_text, file_path)
                    first = handles.get(rhs_text.split(".", 1)[0])
                    if first is not None and "." in rhs_text:
                        # `bridge.sub` resolves through bridge's recorded
                        # module, matching Python attribute access.
                        alt = first[0] + "." + rhs_text.split(".", 1)[1]
                        if _module_file(repo, head, alt) is not None:
                            resolved = alt
                    ref_entry = _module_names(repo, head, resolved, leaves,
                                              modules, memo, depth, visited)
                    ref_ready = True
                if ((_ATTR_CALL.search(rhs) and not _ATTR_LITERAL.search(rhs)) or
                    _DYNAMIC_CALL.search(rhs)) or rhs_names & suspect:
                    for target in targets - suspect:
                        suspect.add(target)
                        grown = True
                elif rhs_names & (leaves | bound):
                    for target in targets - bound:
                        bound.add(target)
                        grown = True
                elif ref_ready and isinstance(ref_entry, tuple):
                    record = (resolved, ref_entry[0], ref_entry[1] | ref_entry[2])
                    for target in targets:
                        if handles.get(target) != record:
                            handles[target] = record
                            unresolved |= ref_entry[3]
                            grown = True
                elif ref_ready and ref_entry in ("unreadable", "unexpanded"):
                    for target in targets - suspect:
                        suspect.add(target)
                        grown = True
                elif rhs_names & call_suspect:
                    for target in targets - call_suspect:
                        call_suspect.add(target)
                        grown = True
                else:
                    cls = None
                    resolved_idents: set[str] = set()
                    for ref in _DOTTED_REF.finditer(rhs_text):
                        found_cls = _attr_class(ref.group(1), ref.group(2),
                                                handles, call_suspect, leaves,
                                                modules, repo, head,
                                                file_path, memo)
                        if found_cls == "bound":
                            cls = "bound"
                            break
                        if found_cls == "suspect":
                            cls = "suspect"
                        else:
                            resolved_idents.update(_IDENTIFIER.findall(
                                ref.group(0)))
                    if cls == "bound":
                        for target in targets - bound:
                            bound.add(target)
                            grown = True
                    elif cls == "suspect":
                        for target in targets - suspect:
                            suspect.add(target)
                            grown = True
                    elif unproven - resolved_idents:
                        for target in targets - call_suspect - bound - suspect:
                            call_suspect.add(target)
                            grown = True
        if not grown:
            converged = True
            break
    return bound, suspect, call_suspect, unresolved or not converged, handles


def _leaf_hits(text: str, leaves: set[str]) -> list[str]:
    if not text or not leaves:
        return []
    return sorted(leaf for leaf in leaves if leaf in set(_IDENTIFIER.findall(text)))


def _changed_paths(repo: Path, base: str, head: str) -> tuple[list[str] | None, str | None]:
    names = run_git(repo, "diff", "--no-ext-diff", "--no-renames", "--name-only", "-z", base, head)
    if names.returncode or not names.stdout or not names.stdout.endswith("\0"):
        return None, "DIFF_READ_FAILED"
    paths = names.stdout[:-1].split("\0")
    if any(not path or any(ord(char) < 32 for char in path) or path.startswith("-") for path in paths):
        return None, "DIFF_UNCLASSIFIABLE"
    return paths, None


def _removed_names(patch: str) -> set[str]:
    names = set()
    for line in patch.splitlines():
        found = _REMOVED_DEF.match(line) or _REMOVED_NAME.match(line)
        if found:
            names.add(found.group(1))
    return names


def _referenced_from_boundary(repo: Path, head: str, name: str, boundary: dict) -> list[str] | None:
    proc = run_git(repo, "grep", "-w", "-l", name, head, "--")
    if proc.returncode not in (0, 1):
        return None
    hits = []
    for line in proc.stdout.splitlines():
        _, _, path = line.partition(":")
        if path and _path_in_boundary(path, boundary, None):
            hits.append(path)
    return sorted(hits)


def _split_stub(raw: object) -> dict:
    """Best-effort split_analysis fields for returns that precede validation."""
    stub = {"part": None, "parent_task": None, "paths_checked": None,
            "core_touches": [], "unverifiable": [], "boundary_sha256": None,
            "contract_path": None, "contract_sha256": None, "behaviour_checks": []}
    if isinstance(raw, dict):
        stub["part"] = raw.get("part")
        stub["parent_task"] = raw.get("parent_task")
    return stub


def _contract_blob(repo: Path, head: str, contract_path: str) -> tuple[str | None, str | None]:
    """(sha256, text) of the contract blob at head; (None, None) when absent or
    not a regular file (symlink/gitlink/unreadable)."""
    tree = run_git(repo, "ls-tree", head, "--", contract_path)
    if tree.returncode or not tree.stdout.strip():
        return None, None
    if tree.stdout.split()[0] not in {"100644", "100755"}:
        return None, None
    try:
        show = run_git(repo, "show", f"{head}:{contract_path}")
    except UnicodeDecodeError:
        return None, None
    if show.returncode:
        return None, None
    return hashlib.sha256(show.stdout.encode()).hexdigest(), show.stdout


def _split_check(evidence: dict) -> tuple[dict | None, dict]:
    """Mixed-grade T3 split: a peripheral part must not touch the core boundary."""
    raw = evidence.get("split")
    if raw is None:
        return None, result("N/A", "SPLIT_NOT_DECLARED", "task:746")
    if not isinstance(raw, dict):
        return _split_stub(raw), result("UNVERIFIED", "SPLIT_INVALID", "task:746")
    part, parent = raw.get("part"), raw.get("parent_task")
    info: dict = _split_stub(raw)
    if (not isinstance(part, str) or part not in {"core", "peripheral"} or
        not isinstance(parent, (str, int)) or isinstance(parent, bool) or
        str(parent) == str(evidence.get("task")) or
        ("parent_t" in raw and raw["parent_t"] != "T3")):
        return info, result("UNVERIFIED", "SPLIT_INVALID", "task:746")
    contract_path = None
    if raw.get("contract_path") is not None:
        contract_path = _normalize_path(raw.get("contract_path"))
        if contract_path is None:
            return info, result("UNVERIFIED", "SPLIT_INVALID", "task:746", field="contract_path")
    if part == "peripheral" and contract_path is None:
        return info, result("UNVERIFIED", "SPLIT_BOUNDARY_MISSING", "task:746",
                            field="contract_path")
    info["contract_path"] = contract_path
    behaviour = raw.get("behaviour_checks")
    seen = []
    if behaviour is not None:
        if not isinstance(behaviour, list):
            return info, result("UNVERIFIED", "NEEDS_CLASSIFICATION", "task:746", field="behaviour_checks")
        for entry in behaviour:
            if (not isinstance(entry, dict) or not isinstance(entry.get("id"), str) or
                not entry["id"].strip() or not isinstance(entry.get("result"), str) or
                entry["result"] not in {"pass", "fail"}):
                return info, result("UNVERIFIED", "NEEDS_CLASSIFICATION", "task:746",
                                    field="behaviour_checks")
            seen.append({"id": entry["id"].strip(), "result": entry["result"], "ref": entry.get("ref")})
        if any(entry["result"] == "fail" for entry in seen):
            return info, result("UNVERIFIED", "NEEDS_CLASSIFICATION", "task:746",
                                field="behaviour_checks")
    info["behaviour_checks"] = seen
    repo = Path(str(evidence.get("repo_path", "")))
    head, base = str(evidence.get("head", "")), str(evidence.get("base", ""))
    paths = None
    if part == "peripheral":
        if not repo.is_dir() or not SHA.fullmatch(head) or not SHA.fullmatch(base):
            return info, result("UNVERIFIED", "NEEDS_CLASSIFICATION", "task:746", field="diff")
        paths, error = _changed_paths(repo, base, head)
        if paths is None:
            return info, result("UNVERIFIED", "NEEDS_CLASSIFICATION", "task:746", detail=error)
        info["paths_checked"] = len(paths)
    boundary = _normalize_boundary(raw.get("boundary")) if "boundary" in raw else None
    contract_boundary = None
    if contract_path is not None:
        if not repo.is_dir() or not SHA.fullmatch(head):
            return info, result("UNVERIFIED", "NEEDS_CLASSIFICATION", "task:746", field="repo")
        info["contract_sha256"], contract_text = _contract_blob(repo, head, contract_path)
        if contract_text is not None:
            try:
                document = json.loads(contract_text)
            except ValueError:
                document = None
            contract_boundary = _normalize_boundary(
                (document or {}).get("boundary", document) if isinstance(document, dict) else None)
    if part == "peripheral" and contract_path in paths:
        info["core_touches"] = [{"path": contract_path, "kind": "contract"}]
        return info, result("FAIL", "PERIPHERAL_TOUCHES_CORE", "task:746",
                            touches=info["core_touches"], required_rerun="T3")
    if contract_path is not None:
        if contract_boundary is None:
            return info, result("UNVERIFIED", "SPLIT_BOUNDARY_MISSING", "task:746",
                                contract_path=contract_path)
        if boundary is not None and _digest(boundary) != _digest(contract_boundary):
            return info, result("UNVERIFIED", "SPLIT_BOUNDARY_CONFLICT", "task:746")
        boundary = boundary or contract_boundary
    info["boundary_sha256"] = _digest(boundary) if boundary else None
    if boundary is None:
        return info, result("UNVERIFIED", "SPLIT_BOUNDARY_MISSING", "task:746")
    if part == "core":
        return info, result("PASS", "SPLIT_CORE_DECLARED", "task:746",
                            boundary_sha256=info["boundary_sha256"])
    touched = [{"path": path, "kind": kind} for path in paths
               if (kind := _path_in_boundary(path, boundary, contract_path))]
    analyzed = [path for path in paths if not _path_in_boundary(path, boundary, contract_path)]
    if not touched:
        modules = _boundary_modules(boundary)
        leaves = {leaf for symbol in boundary["symbols"] if (leaf := _leaf(symbol))}
        leaves |= {item.rsplit(".", 1)[-1] for item in modules}
        unverifiable = []
        for path in analyzed:
            try:
                proc = run_git(repo, "diff", "--no-ext-diff", "--no-renames",
                               "-U0", base, head, "--", path)
                if proc.returncode:
                    unverifiable.append(path)
                    continue
                patch = proc.stdout
                if "Binary files" in patch or "GIT binary patch" in patch:
                    unverifiable.append(path)
                    continue
                file_leaves = set(leaves)
                suspect: set[str] = set()
                call_suspect: set[str] = set()
                handles: dict[str, tuple[str, set[str], set[str]]] = {}
                module_memo: dict = {}
                show = run_git(repo, "show", f"{head}:{path}")
                if show.returncode == 0:
                    bound, suspect, call_suspect, unresolved, handles = \
                        _bound_names(show.stdout, leaves, modules, repo, head,
                                     path, memo=module_memo)
                    file_leaves |= bound
                    if unresolved:
                        unverifiable.append(path)
            except UnicodeDecodeError:
                unverifiable.append(path)
                continue
            for line in patch.splitlines():
                if line.startswith("@@"):
                    context = "@@".join(line.split("@@")[2:])
                    touched.extend({"path": path, "kind": "enclosing", "symbol": leaf,
                                    "detail": context.strip()[:120]}
                                   for leaf in _leaf_hits(context, file_leaves))
                    if _leaf_hits(context, suspect):
                        unverifiable.append(path)
                elif line[:1] in {"+", "-"} and not line.startswith(("+++", "---")):
                    content = line[1:]
                    touched.extend({"path": path, "kind": "call" if re.search(
                                        r"\b" + re.escape(leaf) + r"\s*\(", content) else "symbol",
                                    "symbol": leaf, "detail": content.strip()[:120]}
                                   for leaf in _leaf_hits(content, file_leaves))
                    for module in _import_modules(content, path):
                        if _module_in(module, modules):
                            touched.append({"path": path, "kind": "import", "symbol": module,
                                            "detail": content.strip()[:120]})
                    # Calls through bound names: `x(...)`, `x.attr(...)` and
                    # `a.b.attr(...)` where the binding cannot be proven
                    # non-core is unverifiable; a proven core attr is a touch.
                    for match in _DOTTED_CALL.finditer(content):
                        cls = _attr_class(match.group(1), match.group(2),
                                          handles, call_suspect, leaves,
                                          modules, repo, head, path,
                                          module_memo)
                        if cls == "bound":
                            touched.append({"path": path, "kind": "call",
                                            "symbol": match.group(2),
                                            "detail": content.strip()[:120]})
                        elif cls == "suspect":
                            unverifiable.append(path)
                    for match in _BARE_CALL.finditer(content):
                        if match.group(1) in call_suspect:
                            unverifiable.append(path)
                            break
                    if (_leaf_hits(content, suspect) or
                        (_ATTR_CALL.search(content) and not _ATTR_LITERAL.search(content)) or
                        _DYNAMIC_CALL.search(content)):
                        unverifiable.append(path)
            for name in _removed_names(patch):
                hits = _referenced_from_boundary(repo, head, name, boundary)
                if hits is None:
                    unverifiable.append(path)
                elif hits:
                    touched.append({"path": path, "kind": "removed_ref", "symbol": name,
                                    "detail": ",".join(hits[:5])})
        info["unverifiable"] = sorted(set(unverifiable))
    info["core_touches"] = sorted(touched, key=lambda item: (item["path"], item.get("symbol") or ""))
    if info["core_touches"]:
        return info, result("FAIL", "PERIPHERAL_TOUCHES_CORE", "task:746",
                            touches=info["core_touches"][:25], required_rerun="T3")
    if info.get("unverifiable"):
        return info, result("UNVERIFIED", "NEEDS_CLASSIFICATION", "task:746",
                            unverifiable=info["unverifiable"])
    return info, result("PASS", "SPLIT_PERIPHERAL_CLEAN", "task:746",
                        boundary_sha256=info["boundary_sha256"], paths_checked=len(analyzed))


def evaluate(evidence: dict, stage: str, policy: dict, policy_check: dict,
             *, root: Path | None = None) -> tuple[dict, dict]:
    checks: dict[str, dict] = {"policy": policy_check}
    identity_keys = ("task", "contract_revision", "job", "repo", "repo_path", "issuer", "head", "base")
    checks["identity"] = (result("PASS", "IDENTITY_BOUND", "decision:3231")
                          if all(evidence.get(key) for key in identity_keys)
                          else result("UNVERIFIED", "IDENTITY_MISSING", "decision:3231"))
    surface = None
    if policy_check["status"] == "PASS":
        try:
            surface, checks["surface"] = diff_surface(evidence, policy)
        except UnicodeError:
            checks["surface"] = result("UNVERIFIED", "DIFF_UNCLASSIFIABLE", "spawn-worker:2-1")
        except OSError:
            checks["surface"] = result("UNVERIFIED", "DIFF_READ_FAILED", "spawn-worker:2-1")
        except (KeyError, TypeError):
            checks["surface"] = result("UNVERIFIED", "POLICY_CONFLICT", "policy:surface_rules")
    else:
        checks["surface"] = result("UNVERIFIED", "POLICY_UNAVAILABLE", "decision:3231")
    try:
        split_info, checks["split"] = _split_check(evidence)
    except Exception:
        split_info, checks["split"] = _split_stub(evidence.get("split")), result(
            "UNVERIFIED", "NEEDS_CLASSIFICATION", "task:746", detail="classifier_error")
    declared = evidence.get("declared_t")
    if not re.fullmatch(r"T[0-3]", str(declared)):
        checks["tier"] = result("UNVERIFIED", "T_MISSING", "spawn-worker:2-1")
    elif surface is None:
        checks["tier"] = result("UNVERIFIED", "T_FLOOR_UNKNOWN", "spawn-worker:2-1")
    else:
        floor_num = max(int(surface["floor"][1]),
                        3 if (split_info or {}).get("part") == "core" else 0)
        if int(declared[1]) < floor_num:
            checks["tier"] = result("FAIL", "T_BELOW_FLOOR", "spawn-worker:2-1",
                                    declared=declared, floor=f"T{floor_num}")
        else:
            checks["tier"] = result("PASS", "T_MEETS_FLOOR", "spawn-worker:2-1",
                                    declared=declared, floor=f"T{floor_num}")

    root = root or Path(__file__).resolve().parents[2]
    contributor_profiles = []
    contributors = evidence.get("contributors")
    if not isinstance(contributors, list) or not contributors:
        checks["contributors"] = result("UNVERIFIED", "CONTRIBUTORS_MISSING", "spawn-worker:2-4")
    else:
        failures = []
        for item in contributors:
            if (not isinstance(item, dict) or not item.get("session") or not item.get("worktree") or
                item.get("kind") not in {"initial", "fix", "prescription"}):
                failures.append("CONTRIBUTOR_PROVENANCE_MISSING")
                continue
            resolved, check = resolve_profile(item.get("profile", ""), policy, actual_model=item.get("model"),
                                              actual_effort=item.get("effort"), role=item.get("role", "builder"), root=root)
            if check["status"] != "PASS":
                failures.append(check["reason_code"])
            else:
                contributor_profiles.append(resolved)
        checks["contributors"] = (result("UNVERIFIED", failures[0], "spawn-worker:2-4") if failures else
                                  result("PASS", "CONTRIBUTOR_UNION_RESOLVED", "spawn-worker:2-4",
                                         families=sorted({p["family"] for p in contributor_profiles})))

    tester = evidence.get("tester") if isinstance(evidence.get("tester"), dict) else {}
    planned_alias = tester.get("planned_profile")
    planned_effort = tester.get("planned_effort")
    actual_alias = tester.get("actual_profile") if stage != "pre-spawn" else None
    if stage != "pre-spawn" and (not actual_alias or not tester.get("actual_model") or
                                  "actual_effort" not in tester or not tester.get("session") or not tester.get("worktree")):
        checks["tester"] = result("UNVERIFIED", "ACTUAL_TESTER_MISSING", "decision:3231")
        tester_profile = None
    elif not planned_alias or "planned_effort" not in tester:
        checks["tester"] = result("UNVERIFIED", "TESTER_PLAN_MISSING", "decision:3231")
        tester_profile = None
    else:
        alias = actual_alias or planned_alias
        effort = tester.get("actual_effort") if actual_alias else planned_effort
        tester_profile, checks["tester"] = resolve_profile(alias, policy,
            actual_model=tester.get("actual_model") if actual_alias else None,
            actual_effort=effort, role="tester", root=root)
        if actual_alias and (actual_alias != planned_alias or effort != planned_effort):
            checks["tester"] = result("FAIL", "ACTUAL_PROFILE_CHANGED", "decision:3231")
            tester_profile = None
    checks["actual_source"] = (result("N/A", "PRE_SPAWN_PLAN", "decision:3231") if stage == "pre-spawn"
                               else _actual_observation(evidence, policy, tester_profile))

    if tester_profile and declared and declared not in tester_profile["surfaces"]:
        checks["surface_permission"] = result("FAIL", "PROFILE_SURFACE_DENIED", "policy:profiles")
    elif tester_profile:
        checks["surface_permission"] = result("PASS", "PROFILE_SURFACE_ALLOWED", "policy:profiles")
    else:
        checks["surface_permission"] = result("UNVERIFIED", "PROFILE_UNRESOLVED", "policy:profiles")

    required = evidence.get("required_grade")
    assigned = evidence.get("implementation_grade")
    if required not in GRADES or assigned not in GRADES:
        checks["grade"] = result("UNVERIFIED", "GRADE_INPUT_MISSING", "spawn-worker:2-2")
    elif tester_profile is None or checks["contributors"]["status"] != "PASS":
        checks["grade"] = result("UNVERIFIED", "GRADE_UNRESOLVED", "spawn-worker:2-4")
    elif any(GRADES.index(p["grade"]) < GRADES.index(assigned) for p in contributor_profiles):
        checks["grade"] = result("FAIL", "IMPLEMENTER_GRADE_LOW", "spawn-worker:2-2")
    elif GRADES.index(tester_profile["grade"]) < max(GRADES.index(required), GRADES.index(assigned)):
        checks["grade"] = result("FAIL", "TESTER_GRADE_LOW", "spawn-worker:2-4",
                                 tester_grade=tester_profile["grade"], implementation_grade=assigned)
    else:
        checks["grade"] = result("PASS", "GRADE_SUFFICIENT", "spawn-worker:2-4",
                                 tester_grade=tester_profile["grade"], implementation_grade=assigned)

    families = {p["family"] for p in contributor_profiles}
    if not tester_profile or checks["contributors"]["status"] != "PASS":
        checks["independence"] = result("UNVERIFIED", "FAMILY_UNKNOWN", "spawn-worker:2-4")
    elif declared == "T3" and tester_profile["alias"] in {"devin-ds41", "devin-ds41-max"}:
        checks["independence"] = result("FAIL", "DS41_T3_SOLE_TESTER", "spawn-worker:2-4+task:726")
    elif tester_profile["family"] not in families:
        checks["independence"] = result("PASS", "CROSS_FAMILY", "spawn-worker:2-4", families=sorted(families))
    elif declared == "T3" or (surface and surface["floor"] == "T3"):
        checks["independence"] = result("FAIL", "SAME_FAMILY_T3", "spawn-worker:2-4")
    else:
        same = evidence.get("same_family") or {}
        prior_sessions = {item.get("session") for item in contributors if isinstance(item, dict)}
        prior_worktrees = {item.get("worktree") for item in contributors if isinstance(item, dict)}
        ci_status = same.get("ci_status")
        if surface and "gate_or_delivery" in surface["flags"]:
            checks["independence"] = result("FAIL", "SAME_FAMILY_EXCLUDED_SURFACE", "spawn-worker:2-4")
        elif same.get("excluded_surface") is True:
            checks["independence"] = result("FAIL", "SAME_FAMILY_EXCLUDED_SURFACE", "spawn-worker:2-4")
        elif required not in GRADES or assigned not in GRADES:
            checks["independence"] = result("UNVERIFIED", "GRADE_INPUT_MISSING", "spawn-worker:2-4")
        elif max(GRADES.index(required), GRADES.index(assigned)) > GRADES.index("A+"):
            checks["independence"] = result("FAIL", "SAME_FAMILY_GRADE_EXCLUDED", "spawn-worker:2-4")
        elif same.get("reversible") is False:
            checks["independence"] = result("FAIL", "SAME_FAMILY_NON_REVERSIBLE", "spawn-worker:2-4")
        elif tester.get("session") and tester["session"] in prior_sessions:
            checks["independence"] = result("FAIL", "SAME_TESTER_SESSION", "spawn-worker:2-4")
        elif tester.get("worktree") and tester["worktree"] in prior_worktrees:
            checks["independence"] = result("FAIL", "SAME_TESTER_WORKTREE", "spawn-worker:2-4")
        elif any(tester_profile["effort"] == p["effort"] and tester_profile["grade"] == p["grade"]
                 for p in contributor_profiles):
            checks["independence"] = result("FAIL", "SAME_GRADE_EFFORT", "spawn-worker:2-4")
        else:
            conditions = [
            required in GRADES and assigned in GRADES and
                max(GRADES.index(required), GRADES.index(assigned)) <= GRADES.index("A+"),
            same.get("reversible") is True and same.get("excluded_surface") is False,
            bool(tester.get("session")) and tester.get("session") not in prior_sessions,
            bool(tester.get("worktree")) and tester.get("worktree") not in prior_worktrees,
            all(tester_profile["effort"] != p["effort"] or tester_profile["grade"] != p["grade"] for p in contributor_profiles),
            bool(same.get("qualification_ref")) and GRADES.index(tester_profile["grade"]) >= GRADES.index("S+"),
            bool(same.get("directed_brief_ref")) and bool(same.get("independent_counterexample_ref")),
            bool(same.get("ci_run_id")) and bool(same.get("ci_attempt")) and ci_status == "success",
            bool(same.get("report_phrase")) and same["report_phrase"] in {"동일 계열 독립 세션 검증", "동일 계열 독립 세션 검증 (2차 대기)"},
            ]
            if not same.get("ci_run_id") or not same.get("ci_attempt"):
                reason = "CI_JOB_MISSING"
            elif ci_status == "skipped":
                reason = "CI_JOB_SKIPPED"
            else:
                reason = "SAME_FAMILY_PROOF_MISSING"
            checks["independence"] = (result("PASS", "SAME_FAMILY_EXCEPTION_PROVEN", "spawn-worker:2-4") if all(conditions)
                                      else result("UNVERIFIED", reason, "spawn-worker:2-4"))

    bound = {**evidence,
             "diff_sha256": surface["diff_sha256"] if surface else None,
             "contributors_digest": _digest(contributors),
             "split_analysis": split_info}
    if stage == "pre-spawn":
        checks["prior"] = result("N/A", "FIRST_CALL_POINT", "decision:3231")
        checks["report"] = result("N/A", "TESTER_NOT_SPAWNED", "decision:3231")
        checks["current_pr"] = result("N/A", "PRE_SPAWN", "decision:3231")
    else:
        required_stage = "pre-spawn" if stage == "post-landing" else "post-landing"
        _, checks["prior"] = _read_previous(evidence.get("previous_receipt"), required_stage, bound,
                                            policy.get("revision", ""), bound.get("policy_sha256", ""))
        checks["report"] = result("N/A", "TESTER_IN_PROGRESS", "decision:3231") if stage == "post-landing" else _report(evidence)
        checks["current_pr"] = result("N/A", "POST_LANDING", "decision:3231") if stage == "post-landing" else _current_pr(evidence)
    checks["ci_binding"] = (result("N/A", "BEFORE_CI", "decision:3231") if stage != "pre-merge"
                            else _ci_binding(evidence, policy))
    checks["artifact_hash"] = result("N/A", "POST_MERGE_ARTIFACT", "advice:astra-Q3")
    return checks, bound


def _audit_head_matches(receipt: dict, head: object) -> bool:
    return isinstance(head, str) and bool(SHA.fullmatch(head)) and receipt.get("head") == head


def audit(receipt_dir: Path, repos: list[str], jobs_dir: Path, since: str | None = None) -> int:
    receipts = []
    for path in receipt_dir.glob("*.json"):
        try:
            receipts.append(json.loads(path.read_text()))
        except (OSError, ValueError):
            continue
    actions = []
    for repo in repos:
        proc = subprocess.run(["gh", "pr", "list", "--repo", repo, "--state", "merged", "--limit", "1000",
                               "--json", "number,headRefOid,mergedAt,url"], text=True, capture_output=True, check=False)
        if proc.returncode:
            print(f"AUDIT UNVERIFIED repo={repo} gh lookup failed")
            return 2
        try:
            fetched = json.loads(proc.stdout)
            if len(fetched) == 1000:
                print(f"AUDIT UNVERIFIED repo={repo} merged PR window truncated")
                return 2
            for pr in fetched:
                actions.append(("merge", repo, str(pr["number"]), pr["mergedAt"], pr["headRefOid"]))
        except (ValueError, KeyError):
            print(f"AUDIT UNVERIFIED repo={repo} malformed ledger")
            return 2
    for path in jobs_dir.glob("*/events/*job.spawned.json"):
        try:
            record = json.loads(path.read_text())
            job = record.get("job_id") or path.parents[1].name
            at = record.get("created_at") or record.get("at")
            if at:
                repo = record.get("repo", "")
                head = record.get("head")
                if not repo or not head:
                    evidence_path = path.parents[1] / "eligibility-evidence.json"
                    try:
                        linked = json.loads(evidence_path.read_text())
                        if linked.get("job") == job:
                            repo = repo or linked.get("repo", "")
                            head = head or linked.get("head")
                    except (OSError, ValueError):
                        pass
                actions.append(("spawn", str(repo), str(job), at, head))
        except (OSError, ValueError):
            continue
    if since:
        try:
            cutoff = parse_time(since)
            actions = [row for row in actions if parse_time(row[3]) >= cutoff]
        except ValueError:
            print("AUDIT UNVERIFIED invalid time in ledger or --since")
            return 2
    missing = late = reused = 0
    used = {}
    repo_names = [repo.rsplit("/", 1)[-1] for repo in repos]
    def repo_matches(receipt_repo: object, action_repo: str) -> bool:
        if not isinstance(receipt_repo, str) or not receipt_repo or not action_repo:
            return False
        if receipt_repo == action_repo:
            return True
        return (action_repo in repos and "/" not in receipt_repo and
                receipt_repo == action_repo.rsplit("/", 1)[-1] and
                repo_names.count(receipt_repo) == 1)
    for kind, repo, key, when, head in actions:
        matches = [r for r in receipts if r.get("kind") == kind and
                   repo_matches(r.get("repo"), repo) and
                   str(r.get("job" if kind == "spawn" else "pr")) == key and
                   _audit_head_matches(r, head) and
                   r.get("stage") == ("pre-spawn" if kind == "spawn" else "pre-merge")]
        if not matches:
            missing += 1
            continue
        selected = min(matches, key=lambda r: r.get("time", ""))
        try:
            if parse_time(selected["time"]) > parse_time(when):
                late += 1
        except (KeyError, ValueError):
            late += 1
        used[selected.get("action_id")] = used.get(selected.get("action_id"), 0) + 1
    receipt_ids = {}
    for item in receipts:
        receipt_ids[item.get("action_id")] = receipt_ids.get(item.get("action_id"), 0) + 1
    reused = sum(max(used.get(action, 0), count) - 1 for action, count in receipt_ids.items()
                 if action and max(used.get(action, 0), count) > 1)
    print(f"AUDIT actions={len(actions)} missing={missing} late={late} reused={reused}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    check = sub.add_parser("check")
    check.add_argument("--stage", choices=STAGES, required=True)
    check.add_argument("--evidence", type=Path, required=True)
    check.add_argument("--policy", type=Path, default=DEFAULT_POLICY)
    check.add_argument("--receipt-dir", type=Path, default=DEFAULT_RECEIPTS)
    audit_parser = sub.add_parser("audit")
    audit_parser.add_argument("--repo", action="append", default=[])
    audit_parser.add_argument("--receipt-dir", type=Path, default=DEFAULT_RECEIPTS)
    audit_parser.add_argument("--jobs-dir", type=Path, default=Path.home() / "work/herdr-inbox/jobs")
    audit_parser.add_argument("--since", help="UTC timestamp starting the audited shadow window")
    args = parser.parse_args()
    if args.command == "audit":
        return audit(args.receipt_dir, args.repo, args.jobs_dir, args.since)
    try:
        evidence_bytes = args.evidence.read_bytes()
        evidence = json.loads(evidence_bytes)
    except (OSError, ValueError):
        evidence_bytes = b""
        evidence = {}
    policy, policy_check = load_policy(args.policy)
    evidence["policy_sha256"] = sha256_file(args.policy) if args.policy.is_file() else None
    checks, bound = evaluate(evidence, args.stage, policy or {}, policy_check)
    now = utc_now()
    receipt = {"schema": 1, "action_id": new_action_id(), "kind": "merge" if args.stage == "pre-merge" else "spawn",
               "stage": args.stage, "task": evidence.get("task"), "contract_revision": evidence.get("contract_revision"),
               "job": evidence.get("job"), "repo": evidence.get("repo"), "pr": evidence.get("pr"),
               "repo_path": evidence.get("repo_path"), "evidence_path": str(args.evidence),
               "evidence_sha256": hashlib.sha256(evidence_bytes).hexdigest() if evidence_bytes else None,
               "head": evidence.get("head"), "base": evidence.get("base"), "trial_merge_tree": evidence.get("trial_merge_tree"),
               "declared_t": evidence.get("declared_t"), "required_grade": evidence.get("required_grade"),
               "implementation_grade": evidence.get("implementation_grade"),
               "split": evidence.get("split"), "split_analysis": bound.get("split_analysis"),
               "diff_sha256": bound.get("diff_sha256"), "contributors_digest": bound.get("contributors_digest"),
               "planned_tester_profile": (evidence.get("tester") or {}).get("planned_profile"),
               "planned_tester_effort": (evidence.get("tester") or {}).get("planned_effort"),
               "actual_tester_profile": (evidence.get("tester") or {}).get("actual_profile"),
               "actual_model": (evidence.get("tester") or {}).get("actual_model"),
               "actual_effort": (evidence.get("tester") or {}).get("actual_effort"),
               "actual_tester_session": (evidence.get("tester") or {}).get("session"),
               "actual_tester_worktree": (evidence.get("tester") or {}).get("worktree"),
               "actual_tester_pane": (evidence.get("tester") or {}).get("pane"),
               "policy": {"path": str(args.policy), "revision": (policy or {}).get("revision"),
                          "sha256": sha256_file(args.policy) if args.policy.is_file() else None},
               "tool_version": TOOL_VERSION, "issuer": evidence.get("issuer"), "time": iso_time(now),
               "evidence_refs": {"report_path": (evidence.get("tester") or {}).get("report_path"),
                                 "report_sha256": (evidence.get("tester") or {}).get("report_sha256"),
                                 "ci_run_id": (evidence.get("ci") or {}).get("run_id"),
                                 "ci_attempt": (evidence.get("ci") or {}).get("attempt"),
                                 "job_record_dir": (evidence.get("tester") or {}).get("job_record_dir"),
                                 "model_observation_path": (evidence.get("tester") or {}).get("model_observation_path"),
                                 "model_observation_sha256": (evidence.get("tester") or {}).get("model_observation_sha256"),
                                 "previous_receipt": evidence.get("previous_receipt")},
               "checks": checks, "overall": overall(checks)}
    receipt["H"], receipt["B"], receipt["M"] = receipt["head"], receipt["base"], receipt["trial_merge_tree"]
    path = write_receipt(receipt, args.receipt_dir)
    reasons = ",".join(f"{name}:{item['reason_code']}" for name, item in checks.items() if item["status"] in {"FAIL", "UNVERIFIED"})
    print(f"TESTER_ELIGIBLE {receipt['overall']} stage={args.stage} task={receipt['task']} head={str(receipt['head'])[:12]} receipt={path} {reasons}")
    return 0 if receipt["overall"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
